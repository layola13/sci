// SLA-facing named constants for the sa_regex_compile cflags
// (sa_std/text/regex.sai).
//
// Why this file exists: sa_regex_compile takes its cflags as a
// bare i32, and the values are the host libc regcomp flags --
// src/runtime/sa_std.zig passes the argument straight to regcomp
// (sa_std.zig:1227) -- but no sa_std file named them, so SLA
// callers hard-coded glibc numbers. These consts are the SLA
// spelling of the glibc <regex.h> values, verified against that
// header when this file was written:
//   REG_EXTENDED = 1, REG_ICASE = 1<<1 = 2,
//   REG_NEWLINE = 1<<2 = 4, REG_NOSUB = 1<<3 = 8.
// Flags combine by addition (bitwise or). Note the numbering is
// the glibc one the runtime links; on the Windows mirror the same
// values are used for the bundled regex implementation. Pure
// declarations: no new externs, no ABI change.

@import "sa_std/text/regex.sai"

const SA_REGEX_EXTENDED: i32 = 1;
const SA_REGEX_ICASE: i32 = 2;
const SA_REGEX_NEWLINE: i32 = 4;
const SA_REGEX_NOSUB: i32 = 8;
