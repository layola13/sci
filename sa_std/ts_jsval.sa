// ts_jsval.sa -- tagged-JS-value ops for tsgosa mapping.
//
// Handle model (32 字节 jsval 结构, 与 tsgosa 装箱同模型):
//   +0: kind i32 (0 undefined, 1 string, 2 number, 3 boolean, 4 object,
//       5 array, 6 null, 7 function)
//   +8: payload ptr (string 数据指针; object/array/inst 句柄)
//   +16: payload i32/f64 (boolean/number 值; number 以 f64 存, 但真值
//       判定读低 32 位, 见 @ts_jsval_truthy quirk)
//   +24: 零指针 (装箱时清零, 保留位)
// 调用方传入借用句柄；truthy 纯读不分配、返 i32 值；box 系列分配 32 字节新柄，调用方持有，源句柄借用、不释放、不转移。
// 形状证据：移植 tsgosa `saJsValTruthy`
// （internal/transpile/sa_expr.go:8790-8872：0 柄守卫 + tag/载荷
// 比较 + 布尔合并；发射器原形以 8 字节槽 join 两臂，本移植以每臂
// return 代替槽 join，值语义完全相同）。

// @ts_jsval_truthy 求 jsval 真值（JS truthiness；0 柄、undefined、
// null 为 0；boolean/number 载荷非零为真；string 以数据指针非零为真
// （空串若数据指针非零仍为真，与发射器原形一致）；object/array/
// function 恒真）。
// Quirk（原样保留）：number 真值读 +16 低 32 位 i32（f64 小量如
// 1e-300 低字为 0 时误判 falsy）；string 真值不读长度，只判数据指针。
@ts_jsval_truthy(h: ptr) -> i32:
L_TJT_ENTRY:
    nz = ne h, 0
    br nz -> L_TJT_TAG, L_TJT_MISS
L_TJT_MISS:
    z = 0
    return z
L_TJT_TAG:
    tag = load h + 0 as i32
    payI32 = load h + 16 as i32
    payPtr = load h + 8 as ptr
    notUndef = ne tag, 0
    notNull = ne tag, 6
    base = and notUndef, notNull
    notBool = ne tag, 3
    boolOk = ne payI32, 0
    boolPass = or notBool, boolOk
    notNum = ne tag, 2
    numOk = ne payI32, 0
    numPass = or notNum, numOk
    notStr = ne tag, 1
    strOk = ne payPtr, 0
    strPass = or notStr, strOk
    r1 = and base, boolPass
    r2 = and r1, numPass
    res = and r2, strPass
    return res

// @ts_jsval_box_inst 求实例句柄的 jsval 装箱（JEV sa_std_branch_box 0.96）：
// 0 柄即 undefined 装箱（kind 0），非零柄即 object 装箱（kind 4，载荷即句柄）。
// 布局与归属与 tsgosa `saBoxJsVal` 同形（internal/transpile/sa_expr.go:8765：
// alloc 32，+0 kind i32，+8 载荷 ptr，+16 载荷 i32/f64，+24 0 ptr 侧车清零）。
// 分支语义为本函数新增（调用点原先对 inst 标识符恒 box kind 4、对 null/undefined
// 恒 box kind 0/6；可选实例域 0/柄两态需在同一调用点判定，故合成为分支 helper）。
// 调用方持有新柄（alloc 32）；源句柄为借用，不释放、不转移。
@ts_jsval_box_inst(h: ptr) -> ptr:
L_TJBI_ENTRY:
    nz = ne h, 0
    br nz -> L_TJBI_OBJ, L_TJBI_UNDEF
L_TJBI_UNDEF:
    u = alloc 32
    store u+0, 0 as i32
    store u+8, 0 as ptr
    store u+16, 0 as i32
    store u+24, 0 as ptr
    return u
L_TJBI_OBJ:
    o = alloc 32
    store o+0, 4 as i32
    store o+8, h as ptr
    store o+16, 0 as i32
    store o+24, 0 as ptr
    return o

// @ts_jsval_box_ptr 求 jsval 装箱（载荷为指针；kind 1 string / 4 object /
// 5 array / 0 undefined / 6 null，+16 载荷清零）。
// 形状证据：移植 tsgosa `saBoxJsVal`（internal/transpile/sa_expr.go:9085，
// payloadPtr 臂：kind 1/4/5 标识符与串/数组值、kind 0/6 空值皆经此臂，
// +16 存 i32 0，+24 存 0 ptr，本移植原样复制，不改写为 f64 零）。
// 调用方持有新柄（alloc 32）；源句柄为借用，不释放、不转移。
@ts_jsval_box_ptr(kind: i32, pay: ptr) -> ptr:
L_TJBP_ENTRY:
    h = alloc 32
    store h+0, kind as i32
    store h+8, pay as ptr
    store h+16, 0 as i32
    store h+24, 0 as ptr
    return h

// @ts_jsval_box_i32 求 jsval 装箱（载荷为 i32；kind 2 number-as-i32 / 3 boolean）。
// 形状证据：移植 tsgosa `saBoxJsVal`（internal/transpile/sa_expr.go:9085，
// payloadIsF64=false 臂：saEvalCallArg 经 saEvalI32 求值后的 i32 实参）。
// 调用方持有新柄（alloc 32）；+8 载荷指针清零，+24 侧车清零。
@ts_jsval_box_i32(kind: i32, val: i32) -> ptr:
L_TJBI32_ENTRY:
    h = alloc 32
    store h+0, kind as i32
    store h+8, 0 as ptr
    store h+16, val as i32
    store h+24, 0 as ptr
    return h

// @ts_jsval_box_f64 求 jsval 装箱（载荷为 f64；kind 2 number）。
// 形状证据：移植 tsgosa `saBoxJsVal`（internal/transpile/sa_expr.go:9085，
// payloadIsF64=true 臂：saEvalJsValOperand 的 f64 臂经 saEvalF64 求值）。
// 调用方持有新柄（alloc 32）；f64 恰占 +16..+23，+24 侧车不受影响、清零。
@ts_jsval_box_f64(kind: i32, val: f64) -> ptr:
L_TJBF64_ENTRY:
    h = alloc 32
    store h+0, kind as i32
    store h+8, 0 as ptr
    store h+16, val as f64
    store h+24, 0 as ptr
    return h
