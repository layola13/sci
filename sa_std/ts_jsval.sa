// ts_jsval.sa -- tagged-JS-value ops for tsgosa mapping.
//
// Handle model (32 字节 jsval 结构, 与 tsgosa 装箱同模型):
//   +0: kind i32 (0 undefined, 1 string, 2 number, 3 boolean, 4 object,
//       5 array, 6 null, 7 function)
//   +8: payload ptr (string 数据指针; object/array/inst 句柄)
//   +16: payload i32/f64 (boolean/number 值; number 以 f64 存, 但真值
//       判定读低 32 位, 见 @ts_jsval_truthy quirk)
//   +24: 零指针 (装箱时清零, 保留位)
// 调用方传入借用句柄；truthy 纯读不分配、返 i32 值；box 系列分配 32 字节新柄，调用方持有，源句柄借用、不释放、不转移。
// 形状证据：移植 tsgosa `saJsValTruthy`
// （internal/transpile/sa_expr.go:8790-8872：0 柄守卫 + tag/载荷
// 比较 + 布尔合并；发射器原形以 8 字节槽 join 两臂，本移植以每臂
// return 代替槽 join，值语义完全相同）。
// 依赖方向：ts_jsval -> ts_string（@ts_jsval_equals 串臂经
// @ts_str_equals 内容判等；与 ts_object -> ts_string 同向，不触
// ts_array 不反向依赖 ts_string 的禁律）。
@import "ts_string.sa"

// @ts_jsval_truthy 求 jsval 真值（JS truthiness；0 柄、undefined、
// null 为 0；boolean/number 载荷非零为真；string 以数据指针非零为真
// （空串若数据指针非零仍为真，与发射器原形一致）；object/array/
// function 恒真）。
// Quirk（原样保留）：number 真值读 +16 低 32 位 i32（f64 小量如
// 1e-300 低字为 0 时误判 falsy）；string 真值不读长度，只判数据指针。
@ts_jsval_truthy(h: ptr) -> i32:
L_TJT_ENTRY:
    nz = ne h, 0
    br nz -> L_TJT_TAG, L_TJT_MISS
L_TJT_MISS:
    z = 0
    return z
L_TJT_TAG:
    tag = load h + 0 as i32
    payI32 = load h + 16 as i32
    payPtr = load h + 8 as ptr
    notUndef = ne tag, 0
    notNull = ne tag, 6
    base = and notUndef, notNull
    notBool = ne tag, 3
    boolOk = ne payI32, 0
    boolPass = or notBool, boolOk
    notNum = ne tag, 2
    numOk = ne payI32, 0
    numPass = or notNum, numOk
    notStr = ne tag, 1
    strOk = ne payPtr, 0
    strPass = or notStr, strOk
    r1 = and base, boolPass
    r2 = and r1, numPass
    res = and r2, strPass
    return res

// @ts_jsval_box_inst 求实例句柄的 jsval 装箱（JEV sa_std_branch_box 0.96）：
// 0 柄即 undefined 装箱（kind 0），非零柄即 object 装箱（kind 4，载荷即句柄）。
// 布局与归属与 tsgosa `saBoxJsVal` 同形（internal/transpile/sa_expr.go:8765：
// alloc 32，+0 kind i32，+8 载荷 ptr，+16 载荷 i32/f64，+24 0 ptr 侧车清零）。
// 分支语义为本函数新增（调用点原先对 inst 标识符恒 box kind 4、对 null/undefined
// 恒 box kind 0/6；可选实例域 0/柄两态需在同一调用点判定，故合成为分支 helper）。
// 调用方持有新柄（alloc 32）；源句柄为借用，不释放、不转移。
@ts_jsval_box_inst(h: ptr) -> ptr:
L_TJBI_ENTRY:
    nz = ne h, 0
    br nz -> L_TJBI_OBJ, L_TJBI_UNDEF
L_TJBI_UNDEF:
    u = alloc 32
    store u+0, 0 as i32
    store u+8, 0 as ptr
    store u+16, 0 as i32
    store u+24, 0 as ptr
    return u
L_TJBI_OBJ:
    o = alloc 32
    store o+0, 4 as i32
    store o+8, h as ptr
    store o+16, 0 as i32
    store o+24, 0 as ptr
    return o

// @ts_jsval_box_ptr 求 jsval 装箱（载荷为指针；kind 1 string / 4 object /
// 5 array / 0 undefined / 6 null，+16 载荷清零）。
// 形状证据：移植 tsgosa `saBoxJsVal`（internal/transpile/sa_expr.go:9085，
// payloadPtr 臂：kind 1/4/5 标识符与串/数组值、kind 0/6 空值皆经此臂，
// +16 存 i32 0，+24 存 0 ptr，本移植原样复制，不改写为 f64 零）。
// 调用方持有新柄（alloc 32）；源句柄为借用，不释放、不转移。
@ts_jsval_box_ptr(kind: i32, pay: ptr) -> ptr:
L_TJBP_ENTRY:
    h = alloc 32
    store h+0, kind as i32
    store h+8, pay as ptr
    store h+16, 0 as i32
    store h+24, 0 as ptr
    return h

// @ts_jsval_box_i32 求 jsval 装箱（载荷为 i32；kind 2 number-as-i32 / 3 boolean）。
// 形状证据：移植 tsgosa `saBoxJsVal`（internal/transpile/sa_expr.go:9085，
// payloadIsF64=false 臂：saEvalCallArg 经 saEvalI32 求值后的 i32 实参）。
// 调用方持有新柄（alloc 32）；+8 载荷指针清零，+24 侧车清零。
@ts_jsval_box_i32(kind: i32, val: i32) -> ptr:
L_TJBI32_ENTRY:
    h = alloc 32
    store h+0, kind as i32
    store h+8, 0 as ptr
    store h+16, val as i32
    store h+24, 0 as ptr
    return h

// @ts_jsval_box_f64 求 jsval 装箱（载荷为 f64；kind 2 number）。
// 形状证据：移植 tsgosa `saBoxJsVal`（internal/transpile/sa_expr.go:9085，
// payloadIsF64=true 臂：saEvalJsValOperand 的 f64 臂经 saEvalF64 求值）。
// 调用方持有新柄（alloc 32）；f64 恰占 +16..+23，+24 侧车不受影响、清零。
@ts_jsval_box_f64(kind: i32, val: f64) -> ptr:
L_TJBF64_ENTRY:
    h = alloc 32
    store h+0, kind as i32
    store h+8, 0 as ptr
    store h+16, val as f64
    store h+24, 0 as ptr
    return h

// @ts_jsval_equals 求两 jsval 的 JS ===（严格相等；仅 ===/!== 用，
// loose ==/!= 另需 JEV：跨类型强制转换不在此处理）。
// 决策证据：JEV jsval_jsval_eq build_helper 1.0，scope field_and_named
// 0.30 LOW（近 tie all_jsval_exprs 0.47，未采纳）；机制证据：tsgosa
// 发射器通用尾对 jsval 域读发指针 eq，而 @ts_jsval_box_* 每次 alloc 32
// 新柄、无驻留，故等值原语分柄与同一对象两次装箱皆在指针 eq 下误判
// 不等——此 helper 以值语义代之（静默错译修正，非拒收解除）。
// 语义（32 字节 jsval 布局见文件头；调用方传入借用句柄；纯读不分配、
// 不转移归属，与 @ts_jsval_truthy 同纪律）：
//   0 柄计为 undefined（与既有 null-eq 臂 missing-as-undefined 同律）：
//   0 对 0 为 1；0 对装箱 undefined 为 1；0 对其他为 0。
//   tag 不同为 0（无强制转换）；tag 相同：undefined(0)/null(6) 为 1；
//   boolean(3) 比 +16 i32 载荷；number(2) 比 +16 f64 载荷（fcmp_eq，
//   IEEE 语义：NaN != NaN，+0 == -0，与 JS === 一致）；string(1) 比
//   +8 串柄内容（经 @ts_str_equals，永不指针直比——等值串分柄必相等，
//   此即 handle_eq 被否决的原因）；object(4)/array(5)/function(7)
//   比 +8 载荷指针同一性（JS 引用相等）。
// 分支皆 return，无跨臂 join（与 @ts_jsval_truthy/box 系列同形）。
@ts_jsval_equals(a: ptr, b: ptr) -> i32:
L_TJE_ENTRY:
    aNz = ne a, 0
    br aNz -> L_TJE_ANZ, L_TJE_AZ
L_TJE_AZ:
    bNz = ne b, 0
    br bNz -> L_TJE_AZ_BNZ, L_TJE_BOTH0
L_TJE_BOTH0:
    r0 = 1
    return r0
L_TJE_AZ_BNZ:
    tagB0 = load b + 0 as i32
    r1 = eq tagB0, 0
    return r1
L_TJE_ANZ:
    bNz2 = ne b, 0
    br bNz2 -> L_TJE_BOTHNZ, L_TJE_BNZ
L_TJE_BNZ:
    tagA0 = load a + 0 as i32
    r2 = eq tagA0, 0
    return r2
L_TJE_BOTHNZ:
    tagA = load a + 0 as i32
    tagB = load b + 0 as i32
    same = eq tagA, tagB
    br same -> L_TJE_SAMETAG, L_TJE_DIFF
L_TJE_DIFF:
    r3 = 0
    return r3
L_TJE_SAMETAG:
    isStr = eq tagA, 1
    br isStr -> L_TJE_STR, L_TJE_NOTSTR
L_TJE_NOTSTR:
    isNum = eq tagA, 2
    br isNum -> L_TJE_NUM, L_TJE_NOTNUM
L_TJE_NOTNUM:
    isBool = eq tagA, 3
    br isBool -> L_TJE_BOOL, L_TJE_NOTBOOL
L_TJE_NOTBOOL:
    isObj = eq tagA, 4
    isArr = eq tagA, 5
    isFn = eq tagA, 7
    objFam1 = or isObj, isArr
    objFam = or objFam1, isFn
    br objFam -> L_TJE_PTRID, L_TJE_UNDEFNULL
L_TJE_UNDEFNULL:
    r4 = 1
    return r4
L_TJE_PTRID:
    pa = load a + 8 as ptr
    pb = load b + 8 as ptr
    r5 = eq pa, pb
    return r5
L_TJE_BOOL:
    va = load a + 16 as i32
    vb = load b + 16 as i32
    r6 = eq va, vb
    return r6
L_TJE_NUM:
    fa = load a + 16 as f64
    fb = load b + 16 as f64
    r7 = fcmp_eq fa, fb
    return r7
L_TJE_STR:
    ha = load a + 8 as ptr
    hb = load b + 8 as ptr
    da = load ha + 0 as ptr
    la = load ha + 8 as u64
    db = load hb + 0 as ptr
    lb = load hb + 8 as u64
    r8 = call @ts_str_equals(da, la, db, lb)
    return r8
