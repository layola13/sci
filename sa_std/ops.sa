[MACRO] RANGE_INCLUSIVE_U64_TRY_GET_SLICE %out_ok, %out_slice, %base_slice, %range_ptr
    EXPAND RANGE_INCLUSIVE_U64_IS_EMPTY __range_inc_slice_empty_%out_ok, %range_ptr
    br __range_inc_slice_empty_%out_ok -> L_RANGE_INC_SLICE_EMPTY_%out_ok, L_RANGE_INC_SLICE_CHECK_%out_ok

L_RANGE_INC_SLICE_CHECK_%out_ok:
    __range_inc_slice_start_%out_ok = load %range_ptr+RangeInclusiveU64_start as u64
    __range_inc_slice_end_%out_ok = load %range_ptr+RangeInclusiveU64_end as u64
    __range_inc_slice_len_%out_ok = load %base_slice+Slice_len as u64
    __range_inc_slice_bound_%out_ok = ult __range_inc_slice_end_%out_ok, __range_inc_slice_len_%out_ok
    br __range_inc_slice_bound_%out_ok -> L_RANGE_INC_SLICE_HIT_%out_ok, L_RANGE_INC_SLICE_MISS_%out_ok

L_RANGE_INC_SLICE_HIT_%out_ok:
    __range_inc_slice_base_%out_ok = load %base_slice+Slice_ptr as ptr
    __range_inc_slice_byte_off_%out_ok = mul __range_inc_slice_start_%out_ok, 8
    __range_inc_slice_ptr_%out_ok = ptr_add __range_inc_slice_base_%out_ok, __range_inc_slice_byte_off_%out_ok
    __range_inc_slice_span_%out_ok = sub __range_inc_slice_end_%out_ok, __range_inc_slice_start_%out_ok
    __range_inc_slice_view_len_%out_ok = add __range_inc_slice_span_%out_ok, 1
    EXPAND SLICE_NEW %out_slice, __range_inc_slice_ptr_%out_ok, __range_inc_slice_view_len_%out_ok
    %out_ok = add 0, 1
    !__range_inc_slice_view_len_%out_ok
    !__range_inc_slice_span_%out_ok
    !__range_inc_slice_ptr_%out_ok
    !__range_inc_slice_byte_off_%out_ok
    !__range_inc_slice_base_%out_ok
    !__range_inc_slice_bound_%out_ok
    !__range_inc_slice_len_%out_ok
    !__range_inc_slice_end_%out_ok
    !__range_inc_slice_start_%out_ok
    !__range_inc_slice_empty_%out_ok
    jmp L_RANGE_INC_SLICE_END_%out_ok

L_RANGE_INC_SLICE_MISS_%out_ok:
    !__range_inc_slice_bound_%out_ok
    !__range_inc_slice_len_%out_ok
    !__range_inc_slice_end_%out_ok
    !__range_inc_slice_start_%out_ok
    jmp L_RANGE_INC_SLICE_EMPTY_%out_ok

L_RANGE_INC_SLICE_EMPTY_%out_ok:
    __range_inc_slice_null_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __range_inc_slice_null_%out_ok, 0
    %out_ok = add 0, 0
    !__range_inc_slice_null_%out_ok
    !__range_inc_slice_empty_%out_ok

L_RANGE_INC_SLICE_END_%out_ok:
