@import "ops.sal"
@import "core/slice.sal"
@import "core/slice.sa"

[MACRO] RANGE_U64_NEW %range_ptr, %start, %end
    store %range_ptr+RangeU64_start, %start as u64
    store %range_ptr+RangeU64_end, %end as u64
[END_MACRO]

[MACRO] CONTROL_FLOW_CONTINUE_U64 %control_flow_ptr, %value
    store %control_flow_ptr+ControlFlowU64_tag, CONTROL_FLOW_CONTINUE as u64
    store %control_flow_ptr+ControlFlowU64_value, %value as u64
[END_MACRO]

[MACRO] CONTROL_FLOW_BREAK_U64 %control_flow_ptr, %value
    store %control_flow_ptr+ControlFlowU64_tag, CONTROL_FLOW_BREAK as u64
    store %control_flow_ptr+ControlFlowU64_value, %value as u64
[END_MACRO]

[MACRO] CONTROL_FLOW_TAG %out_tag, %control_flow_ptr
    %out_tag = load %control_flow_ptr+ControlFlowU64_tag as u64
[END_MACRO]

[MACRO] CONTROL_FLOW_VALUE_U64 %out_value, %control_flow_ptr
    %out_value = load %control_flow_ptr+ControlFlowU64_value as u64
[END_MACRO]

[MACRO] CONTROL_FLOW_IS_CONTINUE %out_bool, %control_flow_ptr
    __control_flow_tag_%out_bool = load %control_flow_ptr+ControlFlowU64_tag as u64
    %out_bool = eq __control_flow_tag_%out_bool, CONTROL_FLOW_CONTINUE
    !__control_flow_tag_%out_bool
[END_MACRO]

[MACRO] CONTROL_FLOW_IS_BREAK %out_bool, %control_flow_ptr
    __control_flow_tag_%out_bool = load %control_flow_ptr+ControlFlowU64_tag as u64
    %out_bool = eq __control_flow_tag_%out_bool, CONTROL_FLOW_BREAK
    !__control_flow_tag_%out_bool
[END_MACRO]

[MACRO] RANGE_U64_START %out_start, %range_ptr
    %out_start = load %range_ptr+RangeU64_start as u64
[END_MACRO]

[MACRO] RANGE_U64_END %out_end, %range_ptr
    %out_end = load %range_ptr+RangeU64_end as u64
[END_MACRO]

[MACRO] RANGE_U64_CONTAINS %out_bool, %range_ptr, %item
    __range_start_%out_bool = load %range_ptr+RangeU64_start as u64
    __range_end_%out_bool = load %range_ptr+RangeU64_end as u64
    __range_ge_start_%out_bool = ule __range_start_%out_bool, %item
    __range_lt_end_%out_bool = ult %item, __range_end_%out_bool
    %out_bool = and __range_ge_start_%out_bool, __range_lt_end_%out_bool
    !__range_lt_end_%out_bool
    !__range_ge_start_%out_bool
    !__range_end_%out_bool
    !__range_start_%out_bool
[END_MACRO]

[MACRO] RANGE_U64_IS_EMPTY %out_bool, %range_ptr
    __range_empty_start_%out_bool = load %range_ptr+RangeU64_start as u64
    __range_empty_end_%out_bool = load %range_ptr+RangeU64_end as u64
    __range_not_empty_%out_bool = ult __range_empty_start_%out_bool, __range_empty_end_%out_bool
    %out_bool = eq __range_not_empty_%out_bool, 0
    !__range_not_empty_%out_bool
    !__range_empty_end_%out_bool
    !__range_empty_start_%out_bool
[END_MACRO]

[MACRO] RANGE_U64_LEN %out_len, %range_ptr
    EXPAND RANGE_U64_IS_EMPTY __range_len_empty_%out_len, %range_ptr
    br __range_len_empty_%out_len -> L_RANGE_U64_LEN_EMPTY_%out_len, L_RANGE_U64_LEN_NONEMPTY_%out_len

L_RANGE_U64_LEN_NONEMPTY_%out_len:
    __range_len_start_%out_len = load %range_ptr+RangeU64_start as u64
    __range_len_end_%out_len = load %range_ptr+RangeU64_end as u64
    %out_len = sub __range_len_end_%out_len, __range_len_start_%out_len
    !__range_len_end_%out_len
    !__range_len_start_%out_len
    !__range_len_empty_%out_len
    jmp L_RANGE_U64_LEN_END_%out_len

L_RANGE_U64_LEN_EMPTY_%out_len:
    %out_len = add 0, 0
    !__range_len_empty_%out_len

L_RANGE_U64_LEN_END_%out_len:
[END_MACRO]

[MACRO] RANGE_U64_NEXT %out_ok, %out_value, %range_ptr
    __range_next_start_%out_ok = load %range_ptr+RangeU64_start as u64
    __range_next_end_%out_ok = load %range_ptr+RangeU64_end as u64
    __range_next_has_%out_ok = ult __range_next_start_%out_ok, __range_next_end_%out_ok
    br __range_next_has_%out_ok -> L_RANGE_U64_NEXT_SOME_%out_ok, L_RANGE_U64_NEXT_NONE_%out_ok
L_RANGE_U64_NEXT_SOME_%out_ok:
    %out_value = add __range_next_start_%out_ok, 0
    __range_next_start2_%out_ok = add __range_next_start_%out_ok, 1
    store %range_ptr+RangeU64_start, __range_next_start2_%out_ok as u64
    %out_ok = add 0, 1
    !__range_next_start2_%out_ok
    !__range_next_has_%out_ok
    !__range_next_end_%out_ok
    !__range_next_start_%out_ok
    jmp L_RANGE_U64_NEXT_END_%out_ok
L_RANGE_U64_NEXT_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__range_next_has_%out_ok
    !__range_next_end_%out_ok
    !__range_next_start_%out_ok
L_RANGE_U64_NEXT_END_%out_ok:
[END_MACRO]

[MACRO] RANGE_U64_NEXT_BACK %out_ok, %out_value, %range_ptr
    __range_back_start_%out_ok = load %range_ptr+RangeU64_start as u64
    __range_back_end_%out_ok = load %range_ptr+RangeU64_end as u64
    __range_back_has_%out_ok = ult __range_back_start_%out_ok, __range_back_end_%out_ok
    br __range_back_has_%out_ok -> L_RANGE_U64_BACK_SOME_%out_ok, L_RANGE_U64_BACK_NONE_%out_ok
L_RANGE_U64_BACK_SOME_%out_ok:
    __range_back_end2_%out_ok = sub __range_back_end_%out_ok, 1
    store %range_ptr+RangeU64_end, __range_back_end2_%out_ok as u64
    %out_value = add __range_back_end2_%out_ok, 0
    %out_ok = add 0, 1
    !__range_back_end2_%out_ok
    !__range_back_has_%out_ok
    !__range_back_end_%out_ok
    !__range_back_start_%out_ok
    jmp L_RANGE_U64_BACK_END_%out_ok
L_RANGE_U64_BACK_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__range_back_has_%out_ok
    !__range_back_end_%out_ok
    !__range_back_start_%out_ok
L_RANGE_U64_BACK_END_%out_ok:
[END_MACRO]

[MACRO] RANGE_U64_NTH %out_ok, %out_value, %range_ptr, %nth
    EXPAND RANGE_U64_LEN __range_nth_len_%out_ok, %range_ptr
    __range_nth_has_%out_ok = ult %nth, __range_nth_len_%out_ok
    br __range_nth_has_%out_ok -> L_RANGE_U64_NTH_SOME_%out_ok, L_RANGE_U64_NTH_NONE_%out_ok
L_RANGE_U64_NTH_SOME_%out_ok:
    __range_nth_start_%out_ok = load %range_ptr+RangeU64_start as u64
    __range_nth_value_%out_ok = add __range_nth_start_%out_ok, %nth
    __range_nth_next_%out_ok = add __range_nth_value_%out_ok, 1
    store %range_ptr+RangeU64_start, __range_nth_next_%out_ok as u64
    %out_value = add __range_nth_value_%out_ok, 0
    %out_ok = add 0, 1
    !__range_nth_next_%out_ok
    !__range_nth_value_%out_ok
    !__range_nth_start_%out_ok
    !__range_nth_has_%out_ok
    !__range_nth_len_%out_ok
    jmp L_RANGE_U64_NTH_END_%out_ok
L_RANGE_U64_NTH_NONE_%out_ok:
    __range_nth_end_%out_ok = load %range_ptr+RangeU64_end as u64
    store %range_ptr+RangeU64_start, __range_nth_end_%out_ok as u64
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__range_nth_end_%out_ok
    !__range_nth_has_%out_ok
    !__range_nth_len_%out_ok
L_RANGE_U64_NTH_END_%out_ok:
[END_MACRO]

[MACRO] RANGE_U64_COUNT %out_count, %range_ptr
    EXPAND RANGE_U64_LEN %out_count, %range_ptr
    __range_count_end_%out_count = load %range_ptr+RangeU64_end as u64
    store %range_ptr+RangeU64_start, __range_count_end_%out_count as u64
    !__range_count_end_%out_count
[END_MACRO]

[MACRO] RANGE_U64_TRY_GET_SLICE %out_ok, %out_slice, %base_slice, %range_ptr
    __range_slice_start_%out_ok = load %range_ptr+RangeU64_start as u64
    __range_slice_end_%out_ok = load %range_ptr+RangeU64_end as u64
    __range_slice_len_%out_ok = load %base_slice+Slice_len as u64
    __range_slice_order_%out_ok = ule __range_slice_start_%out_ok, __range_slice_end_%out_ok
    __range_slice_bound_%out_ok = ule __range_slice_end_%out_ok, __range_slice_len_%out_ok
    __range_slice_valid_%out_ok = and __range_slice_order_%out_ok, __range_slice_bound_%out_ok
    br __range_slice_valid_%out_ok -> L_RANGE_U64_SLICE_HIT_%out_ok, L_RANGE_U64_SLICE_MISS_%out_ok

L_RANGE_U64_SLICE_HIT_%out_ok:
    __range_slice_base_%out_ok = load %base_slice+Slice_ptr as ptr
    __range_slice_byte_off_%out_ok = mul __range_slice_start_%out_ok, 8
    __range_slice_ptr_%out_ok = ptr_add __range_slice_base_%out_ok, __range_slice_byte_off_%out_ok
    __range_slice_view_len_%out_ok = sub __range_slice_end_%out_ok, __range_slice_start_%out_ok
    EXPAND SLICE_NEW %out_slice, __range_slice_ptr_%out_ok, __range_slice_view_len_%out_ok
    %out_ok = add 0, 1
    !__range_slice_view_len_%out_ok
    !__range_slice_ptr_%out_ok
    !__range_slice_byte_off_%out_ok
    !__range_slice_base_%out_ok
    !__range_slice_valid_%out_ok
    !__range_slice_bound_%out_ok
    !__range_slice_order_%out_ok
    !__range_slice_len_%out_ok
    !__range_slice_end_%out_ok
    !__range_slice_start_%out_ok
    jmp L_RANGE_U64_SLICE_END_%out_ok

L_RANGE_U64_SLICE_MISS_%out_ok:
    __range_slice_null_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __range_slice_null_%out_ok, 0
    %out_ok = add 0, 0
    !__range_slice_null_%out_ok
    !__range_slice_valid_%out_ok
    !__range_slice_bound_%out_ok
    !__range_slice_order_%out_ok
    !__range_slice_len_%out_ok
    !__range_slice_end_%out_ok
    !__range_slice_start_%out_ok

L_RANGE_U64_SLICE_END_%out_ok:
[END_MACRO]

[MACRO] RANGE_FROM_U64_NEW %range_ptr, %start
    store %range_ptr+RangeFromU64_start, %start as u64
[END_MACRO]

[MACRO] RANGE_FROM_U64_START %out_start, %range_ptr
    %out_start = load %range_ptr+RangeFromU64_start as u64
[END_MACRO]

[MACRO] RANGE_FROM_U64_CONTAINS %out_bool, %range_ptr, %item
    __range_from_start_%out_bool = load %range_ptr+RangeFromU64_start as u64
    %out_bool = ule __range_from_start_%out_bool, %item
    !__range_from_start_%out_bool
[END_MACRO]

[MACRO] RANGE_FROM_U64_TRY_GET_SLICE %out_ok, %out_slice, %base_slice, %range_ptr
    __range_from_start_%out_ok = load %range_ptr+RangeFromU64_start as u64
    __range_from_len_%out_ok = load %base_slice+Slice_len as u64
    __range_from_valid_%out_ok = ule __range_from_start_%out_ok, __range_from_len_%out_ok
    br __range_from_valid_%out_ok -> L_RANGE_FROM_SLICE_HIT_%out_ok, L_RANGE_FROM_SLICE_MISS_%out_ok

L_RANGE_FROM_SLICE_HIT_%out_ok:
    __range_from_base_%out_ok = load %base_slice+Slice_ptr as ptr
    __range_from_byte_off_%out_ok = mul __range_from_start_%out_ok, 8
    __range_from_ptr_%out_ok = ptr_add __range_from_base_%out_ok, __range_from_byte_off_%out_ok
    __range_from_view_len_%out_ok = sub __range_from_len_%out_ok, __range_from_start_%out_ok
    EXPAND SLICE_NEW %out_slice, __range_from_ptr_%out_ok, __range_from_view_len_%out_ok
    %out_ok = add 0, 1
    !__range_from_view_len_%out_ok
    !__range_from_ptr_%out_ok
    !__range_from_byte_off_%out_ok
    !__range_from_base_%out_ok
    !__range_from_valid_%out_ok
    !__range_from_len_%out_ok
    !__range_from_start_%out_ok
    jmp L_RANGE_FROM_SLICE_END_%out_ok

L_RANGE_FROM_SLICE_MISS_%out_ok:
    __range_from_null_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __range_from_null_%out_ok, 0
    %out_ok = add 0, 0
    !__range_from_null_%out_ok
    !__range_from_valid_%out_ok
    !__range_from_len_%out_ok
    !__range_from_start_%out_ok

L_RANGE_FROM_SLICE_END_%out_ok:
[END_MACRO]

[MACRO] RANGE_TO_U64_NEW %range_ptr, %end
    store %range_ptr+RangeToU64_end, %end as u64
[END_MACRO]

[MACRO] RANGE_TO_U64_END %out_end, %range_ptr
    %out_end = load %range_ptr+RangeToU64_end as u64
[END_MACRO]

[MACRO] RANGE_TO_U64_CONTAINS %out_bool, %range_ptr, %item
    __range_to_end_%out_bool = load %range_ptr+RangeToU64_end as u64
    %out_bool = ult %item, __range_to_end_%out_bool
    !__range_to_end_%out_bool
[END_MACRO]

[MACRO] RANGE_TO_U64_TRY_GET_SLICE %out_ok, %out_slice, %base_slice, %range_ptr
    __range_to_end_%out_ok = load %range_ptr+RangeToU64_end as u64
    __range_to_len_%out_ok = load %base_slice+Slice_len as u64
    __range_to_valid_%out_ok = ule __range_to_end_%out_ok, __range_to_len_%out_ok
    br __range_to_valid_%out_ok -> L_RANGE_TO_SLICE_HIT_%out_ok, L_RANGE_TO_SLICE_MISS_%out_ok

L_RANGE_TO_SLICE_HIT_%out_ok:
    __range_to_base_%out_ok = load %base_slice+Slice_ptr as ptr
    EXPAND SLICE_NEW %out_slice, __range_to_base_%out_ok, __range_to_end_%out_ok
    %out_ok = add 0, 1
    !__range_to_base_%out_ok
    !__range_to_valid_%out_ok
    !__range_to_len_%out_ok
    !__range_to_end_%out_ok
    jmp L_RANGE_TO_SLICE_END_%out_ok

L_RANGE_TO_SLICE_MISS_%out_ok:
    __range_to_null_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __range_to_null_%out_ok, 0
    %out_ok = add 0, 0
    !__range_to_null_%out_ok
    !__range_to_valid_%out_ok
    !__range_to_len_%out_ok
    !__range_to_end_%out_ok

L_RANGE_TO_SLICE_END_%out_ok:
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_NEW %range_ptr, %start, %end
    store %range_ptr+RangeInclusiveU64_start, %start as u64
    store %range_ptr+RangeInclusiveU64_end, %end as u64
    store %range_ptr+RangeInclusiveU64_exhausted, 0 as u64
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_SET_EXHAUSTED %range_ptr, %exhausted
    store %range_ptr+RangeInclusiveU64_exhausted, %exhausted as u64
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_START %out_start, %range_ptr
    %out_start = load %range_ptr+RangeInclusiveU64_start as u64
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_END %out_end, %range_ptr
    %out_end = load %range_ptr+RangeInclusiveU64_end as u64
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_CONTAINS %out_bool, %range_ptr, %item
    __range_inc_start_%out_bool = load %range_ptr+RangeInclusiveU64_start as u64
    __range_inc_end_%out_bool = load %range_ptr+RangeInclusiveU64_end as u64
    __range_inc_exhausted_%out_bool = load %range_ptr+RangeInclusiveU64_exhausted as u64
    __range_inc_not_exhausted_%out_bool = eq __range_inc_exhausted_%out_bool, 0
    __range_inc_ge_start_%out_bool = ule __range_inc_start_%out_bool, %item
    __range_inc_le_end_%out_bool = ule %item, __range_inc_end_%out_bool
    __range_inc_bounds_%out_bool = and __range_inc_ge_start_%out_bool, __range_inc_le_end_%out_bool
    %out_bool = and __range_inc_not_exhausted_%out_bool, __range_inc_bounds_%out_bool
    !__range_inc_bounds_%out_bool
    !__range_inc_le_end_%out_bool
    !__range_inc_ge_start_%out_bool
    !__range_inc_not_exhausted_%out_bool
    !__range_inc_exhausted_%out_bool
    !__range_inc_end_%out_bool
    !__range_inc_start_%out_bool
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_IS_EMPTY %out_bool, %range_ptr
    __range_inc_empty_start_%out_bool = load %range_ptr+RangeInclusiveU64_start as u64
    __range_inc_empty_end_%out_bool = load %range_ptr+RangeInclusiveU64_end as u64
    __range_inc_empty_exhausted_%out_bool = load %range_ptr+RangeInclusiveU64_exhausted as u64
    __range_inc_empty_order_%out_bool = ult __range_inc_empty_end_%out_bool, __range_inc_empty_start_%out_bool
    __range_inc_empty_exh_%out_bool = ne __range_inc_empty_exhausted_%out_bool, 0
    %out_bool = or __range_inc_empty_order_%out_bool, __range_inc_empty_exh_%out_bool
    !__range_inc_empty_exh_%out_bool
    !__range_inc_empty_order_%out_bool
    !__range_inc_empty_exhausted_%out_bool
    !__range_inc_empty_end_%out_bool
    !__range_inc_empty_start_%out_bool
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_LEN %out_len, %range_ptr
    EXPAND RANGE_INCLUSIVE_U64_IS_EMPTY __range_inc_len_empty_%out_len, %range_ptr
    br __range_inc_len_empty_%out_len -> L_RANGE_INC_LEN_EMPTY_%out_len, L_RANGE_INC_LEN_NONEMPTY_%out_len

L_RANGE_INC_LEN_NONEMPTY_%out_len:
    __range_inc_len_start_%out_len = load %range_ptr+RangeInclusiveU64_start as u64
    __range_inc_len_end_%out_len = load %range_ptr+RangeInclusiveU64_end as u64
    __range_inc_len_span_%out_len = sub __range_inc_len_end_%out_len, __range_inc_len_start_%out_len
    %out_len = add __range_inc_len_span_%out_len, 1
    !__range_inc_len_span_%out_len
    !__range_inc_len_end_%out_len
    !__range_inc_len_start_%out_len
    !__range_inc_len_empty_%out_len
    jmp L_RANGE_INC_LEN_END_%out_len

L_RANGE_INC_LEN_EMPTY_%out_len:
    %out_len = add 0, 0
    !__range_inc_len_empty_%out_len

L_RANGE_INC_LEN_END_%out_len:
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_NEXT %out_ok, %out_value, %range_ptr
    EXPAND RANGE_INCLUSIVE_U64_IS_EMPTY __range_inc_next_empty_%out_ok, %range_ptr
    br __range_inc_next_empty_%out_ok -> L_RANGE_INC_NEXT_NONE_%out_ok, L_RANGE_INC_NEXT_SOME_%out_ok
L_RANGE_INC_NEXT_SOME_%out_ok:
    __range_inc_next_start_%out_ok = load %range_ptr+RangeInclusiveU64_start as u64
    __range_inc_next_end_%out_ok = load %range_ptr+RangeInclusiveU64_end as u64
    %out_value = add __range_inc_next_start_%out_ok, 0
    __range_inc_next_last_%out_ok = eq __range_inc_next_start_%out_ok, __range_inc_next_end_%out_ok
    br __range_inc_next_last_%out_ok -> L_RANGE_INC_NEXT_EXHAUST_%out_ok, L_RANGE_INC_NEXT_ADVANCE_%out_ok
L_RANGE_INC_NEXT_ADVANCE_%out_ok:
    __range_inc_next_start2_%out_ok = add __range_inc_next_start_%out_ok, 1
    store %range_ptr+RangeInclusiveU64_start, __range_inc_next_start2_%out_ok as u64
    %out_ok = add 0, 1
    !__range_inc_next_start2_%out_ok
    !__range_inc_next_last_%out_ok
    !__range_inc_next_end_%out_ok
    !__range_inc_next_start_%out_ok
    !__range_inc_next_empty_%out_ok
    jmp L_RANGE_INC_NEXT_END_%out_ok
L_RANGE_INC_NEXT_EXHAUST_%out_ok:
    store %range_ptr+RangeInclusiveU64_exhausted, 1 as u64
    %out_ok = add 0, 1
    !__range_inc_next_last_%out_ok
    !__range_inc_next_end_%out_ok
    !__range_inc_next_start_%out_ok
    !__range_inc_next_empty_%out_ok
    jmp L_RANGE_INC_NEXT_END_%out_ok
L_RANGE_INC_NEXT_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__range_inc_next_empty_%out_ok
L_RANGE_INC_NEXT_END_%out_ok:
[END_MACRO]

[MACRO] RANGE_INCLUSIVE_U64_NEXT_BACK %out_ok, %out_value, %range_ptr
    EXPAND RANGE_INCLUSIVE_U64_IS_EMPTY __range_inc_back_empty_%out_ok, %range_ptr
    br __range_inc_back_empty_%out_ok -> L_RANGE_INC_BACK_NONE_%out_ok, L_RANGE_INC_BACK_SOME_%out_ok
L_RANGE_INC_BACK_SOME_%out_ok:
    __range_inc_back_start_%out_ok = load %range_ptr+RangeInclusiveU64_start as u64
    __range_inc_back_end_%out_ok = load %range_ptr+RangeInclusiveU64_end as u64
    %out_value = add __range_inc_back_end_%out_ok, 0
    __range_inc_back_last_%out_ok = eq __range_inc_back_start_%out_ok, __range_inc_back_end_%out_ok
    br __range_inc_back_last_%out_ok -> L_RANGE_INC_BACK_EXHAUST_%out_ok, L_RANGE_INC_BACK_ADVANCE_%out_ok
L_RANGE_INC_BACK_ADVANCE_%out_ok:
    __range_inc_back_end2_%out_ok = sub __range_inc_back_end_%out_ok, 1
    store %range_ptr+RangeInclusiveU64_end, __range_inc_back_end2_%out_ok as u64
    %out_ok = add 0, 1
    !__range_inc_back_end2_%out_ok
    !__range_inc_back_last_%out_ok
    !__range_inc_back_end_%out_ok
    !__range_inc_back_start_%out_ok
