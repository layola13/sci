[MACRO] NONZERO_UNSIGNED_WIDTH_REVERSE_BITS %out_value, %value, %bits, %mask
    __nonzero_rev_masked_%out_value = and %value, %mask
    EXPAND NUM_U64_REVERSE_BITS __nonzero_rev_u64_%out_value, __nonzero_rev_masked_%out_value
    __nonzero_rev_shift_%out_value = sub NUM_U64_BITS, %bits
    %out_value = lshr __nonzero_rev_u64_%out_value, __nonzero_rev_shift_%out_value
    !__nonzero_rev_shift_%out_value
    !__nonzero_rev_u64_%out_value
    !__nonzero_rev_masked_%out_value
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_WIDTH_ROTATE_LEFT %out_value, %value, %shift, %bits, %mask
    __nonzero_rotl_value_%out_value = and %value, %mask
    __nonzero_rotl_shift_%out_value = urem %shift, %bits
    __nonzero_rotl_zero_%out_value = eq __nonzero_rotl_shift_%out_value, 0
    br __nonzero_rotl_zero_%out_value -> L_NONZERO_UNSIGNED_WIDTH_ROTL_ZERO_%out_value, L_NONZERO_UNSIGNED_WIDTH_ROTL_BODY_%out_value
L_NONZERO_UNSIGNED_WIDTH_ROTL_BODY_%out_value:
    __nonzero_rotl_right_shift_%out_value = sub %bits, __nonzero_rotl_shift_%out_value
    __nonzero_rotl_left_raw_%out_value = shl __nonzero_rotl_value_%out_value, __nonzero_rotl_shift_%out_value
    __nonzero_rotl_left_%out_value = and __nonzero_rotl_left_raw_%out_value, %mask
    __nonzero_rotl_right_%out_value = lshr __nonzero_rotl_value_%out_value, __nonzero_rotl_right_shift_%out_value
    %out_value = or __nonzero_rotl_left_%out_value, __nonzero_rotl_right_%out_value
    !__nonzero_rotl_right_%out_value
    !__nonzero_rotl_left_%out_value
    !__nonzero_rotl_left_raw_%out_value
    !__nonzero_rotl_right_shift_%out_value
    !__nonzero_rotl_zero_%out_value
    !__nonzero_rotl_shift_%out_value
    !__nonzero_rotl_value_%out_value
    jmp L_NONZERO_UNSIGNED_WIDTH_ROTL_DONE_%out_value
L_NONZERO_UNSIGNED_WIDTH_ROTL_ZERO_%out_value:
    %out_value = add __nonzero_rotl_value_%out_value, 0
    !__nonzero_rotl_zero_%out_value
    !__nonzero_rotl_shift_%out_value
    !__nonzero_rotl_value_%out_value
L_NONZERO_UNSIGNED_WIDTH_ROTL_DONE_%out_value:
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_WIDTH_ROTATE_RIGHT %out_value, %value, %shift, %bits, %mask
    __nonzero_rotr_value_%out_value = and %value, %mask
    __nonzero_rotr_shift_%out_value = urem %shift, %bits
    __nonzero_rotr_zero_%out_value = eq __nonzero_rotr_shift_%out_value, 0
    br __nonzero_rotr_zero_%out_value -> L_NONZERO_UNSIGNED_WIDTH_ROTR_ZERO_%out_value, L_NONZERO_UNSIGNED_WIDTH_ROTR_BODY_%out_value
L_NONZERO_UNSIGNED_WIDTH_ROTR_BODY_%out_value:
    __nonzero_rotr_left_shift_%out_value = sub %bits, __nonzero_rotr_shift_%out_value
    __nonzero_rotr_right_%out_value = lshr __nonzero_rotr_value_%out_value, __nonzero_rotr_shift_%out_value
    __nonzero_rotr_left_raw_%out_value = shl __nonzero_rotr_value_%out_value, __nonzero_rotr_left_shift_%out_value
    __nonzero_rotr_left_%out_value = and __nonzero_rotr_left_raw_%out_value, %mask
    %out_value = or __nonzero_rotr_left_%out_value, __nonzero_rotr_right_%out_value
    !__nonzero_rotr_left_%out_value
    !__nonzero_rotr_left_raw_%out_value
    !__nonzero_rotr_right_%out_value
    !__nonzero_rotr_left_shift_%out_value
    !__nonzero_rotr_zero_%out_value
    !__nonzero_rotr_shift_%out_value
    !__nonzero_rotr_value_%out_value
    jmp L_NONZERO_UNSIGNED_WIDTH_ROTR_DONE_%out_value
L_NONZERO_UNSIGNED_WIDTH_ROTR_ZERO_%out_value:
    %out_value = add __nonzero_rotr_value_%out_value, 0
    !__nonzero_rotr_zero_%out_value
    !__nonzero_rotr_shift_%out_value
    !__nonzero_rotr_value_%out_value
L_NONZERO_UNSIGNED_WIDTH_ROTR_DONE_%out_value:
[END_MACRO]

