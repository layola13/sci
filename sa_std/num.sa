L_NUM_I32_SIGN_EXTEND_POS_%out_value:
    %out_value = add __num_i32_se_masked_%out_value, 0
    !__num_i32_se_negative_%out_value
    !__num_i32_se_masked_%out_value

L_NUM_I32_SIGN_EXTEND_END_%out_value:
[END_MACRO]

