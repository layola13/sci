    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_saturating_u64_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_SATURATING_U64 __random_state_hash_one_saturating_u64_hasher_%out_hash, %saturating
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_saturating_u64_hasher_%out_hash
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_SATURATING_I64 %hasher, %saturating
    __saturating_i64_hash_value_%hasher = load %saturating+SaturatingI64_value as i64
    EXPAND DEFAULT_HASHER_WRITE_I64 %hasher, __saturating_i64_hash_value_%hasher
    !__saturating_i64_hash_value_%hasher
[END_MACRO]

[MACRO] SATURATING_I64_HASH %out_hash, %saturating
    __saturating_i64_hash_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __saturating_i64_hash_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_SATURATING_I64 __saturating_i64_hash_hasher_%out_hash, %saturating
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __saturating_i64_hash_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_SATURATING_I64 %out_hash, %builder, %saturating
    __build_hash_one_saturating_i64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_saturating_i64_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_SATURATING_I64 __build_hash_one_saturating_i64_hasher_%out_hash, %saturating
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_saturating_i64_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_SATURATING_I64 %out_hash, %state, %saturating
    __random_state_hash_one_saturating_i64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_saturating_i64_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_SATURATING_I64 __random_state_hash_one_saturating_i64_hasher_%out_hash, %saturating
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_saturating_i64_hasher_%out_hash
[END_MACRO]

[MACRO] NUM_U64_CHECKED_ADD %out_ok, %out_value, %lhs, %rhs
    __num_add_sum_%out_ok = add %lhs, %rhs
    __num_add_overflow_%out_ok = ult __num_add_sum_%out_ok, %lhs
    br __num_add_overflow_%out_ok -> L_NUM_U64_ADD_OVERFLOW_%out_ok, L_NUM_U64_ADD_OK_%out_ok

L_NUM_U64_ADD_OK_%out_ok:
    %out_value = add __num_add_sum_%out_ok, 0
    %out_ok = add 0, 1
    !__num_add_overflow_%out_ok
    !__num_add_sum_%out_ok
    jmp L_NUM_U64_ADD_END_%out_ok

L_NUM_U64_ADD_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_add_overflow_%out_ok
    !__num_add_sum_%out_ok

L_NUM_U64_ADD_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_CHECKED_SUB %out_ok, %out_value, %lhs, %rhs
    __num_sub_ok_%out_ok = ule %rhs, %lhs
    br __num_sub_ok_%out_ok -> L_NUM_U64_SUB_OK_%out_ok, L_NUM_U64_SUB_UNDERFLOW_%out_ok

L_NUM_U64_SUB_OK_%out_ok:
    %out_value = sub %lhs, %rhs
    %out_ok = add 0, 1
    !__num_sub_ok_%out_ok
    jmp L_NUM_U64_SUB_END_%out_ok

L_NUM_U64_SUB_UNDERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_sub_ok_%out_ok

L_NUM_U64_SUB_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_CHECKED_MUL %out_ok, %out_value, %lhs, %rhs
    __num_mul_rhs_zero_%out_ok = eq %rhs, 0
    br __num_mul_rhs_zero_%out_ok -> L_NUM_U64_MUL_ZERO_%out_ok, L_NUM_U64_MUL_COMPUTE_%out_ok

L_NUM_U64_MUL_COMPUTE_%out_ok:
    __num_mul_product_%out_ok = mul %lhs, %rhs
    __num_mul_roundtrip_%out_ok = udiv __num_mul_product_%out_ok, %rhs
    __num_mul_ok_%out_ok = eq __num_mul_roundtrip_%out_ok, %lhs
    br __num_mul_ok_%out_ok -> L_NUM_U64_MUL_OK_%out_ok, L_NUM_U64_MUL_OVERFLOW_%out_ok

L_NUM_U64_MUL_OK_%out_ok:
    %out_value = add __num_mul_product_%out_ok, 0
    %out_ok = add 0, 1
    !__num_mul_ok_%out_ok
    !__num_mul_roundtrip_%out_ok
    !__num_mul_product_%out_ok
    !__num_mul_rhs_zero_%out_ok
    jmp L_NUM_U64_MUL_END_%out_ok

L_NUM_U64_MUL_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_mul_ok_%out_ok
    !__num_mul_roundtrip_%out_ok
    !__num_mul_product_%out_ok
    !__num_mul_rhs_zero_%out_ok
    jmp L_NUM_U64_MUL_END_%out_ok

L_NUM_U64_MUL_ZERO_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 1
    !__num_mul_rhs_zero_%out_ok

L_NUM_U64_MUL_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_CHECKED_DIV %out_ok, %out_value, %lhs, %rhs
    __num_div_zero_%out_ok = eq %rhs, 0
    br __num_div_zero_%out_ok -> L_NUM_U64_DIV_ZERO_%out_ok, L_NUM_U64_DIV_OK_%out_ok

L_NUM_U64_DIV_OK_%out_ok:
    %out_value = udiv %lhs, %rhs
    %out_ok = add 0, 1
    !__num_div_zero_%out_ok
    jmp L_NUM_U64_DIV_END_%out_ok

L_NUM_U64_DIV_ZERO_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_div_zero_%out_ok

L_NUM_U64_DIV_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_CHECKED_REM %out_ok, %out_value, %lhs, %rhs
    __num_rem_zero_%out_ok = eq %rhs, 0
    br __num_rem_zero_%out_ok -> L_NUM_U64_REM_ZERO_%out_ok, L_NUM_U64_REM_OK_%out_ok

L_NUM_U64_REM_OK_%out_ok:
    %out_value = urem %lhs, %rhs
    %out_ok = add 0, 1
    !__num_rem_zero_%out_ok
    jmp L_NUM_U64_REM_END_%out_ok

L_NUM_U64_REM_ZERO_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_rem_zero_%out_ok

L_NUM_U64_REM_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_SATURATING_ADD %out_value, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_ADD __num_sat_add_ok_%out_value, __num_sat_add_value_%out_value, %lhs, %rhs
    br __num_sat_add_ok_%out_value -> L_NUM_U64_SAT_ADD_OK_%out_value, L_NUM_U64_SAT_ADD_MAX_%out_value

L_NUM_U64_SAT_ADD_OK_%out_value:
    %out_value = add __num_sat_add_value_%out_value, 0
    !__num_sat_add_value_%out_value
    !__num_sat_add_ok_%out_value
    jmp L_NUM_U64_SAT_ADD_END_%out_value

L_NUM_U64_SAT_ADD_MAX_%out_value:
    %out_value = add 0, NUM_U64_MAX
    !__num_sat_add_value_%out_value
    !__num_sat_add_ok_%out_value

L_NUM_U64_SAT_ADD_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_SATURATING_SUB %out_value, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_SUB __num_sat_sub_ok_%out_value, __num_sat_sub_value_%out_value, %lhs, %rhs
    br __num_sat_sub_ok_%out_value -> L_NUM_U64_SAT_SUB_OK_%out_value, L_NUM_U64_SAT_SUB_ZERO_%out_value

L_NUM_U64_SAT_SUB_OK_%out_value:
    %out_value = add __num_sat_sub_value_%out_value, 0
    !__num_sat_sub_value_%out_value
    !__num_sat_sub_ok_%out_value
    jmp L_NUM_U64_SAT_SUB_END_%out_value

L_NUM_U64_SAT_SUB_ZERO_%out_value:
    %out_value = add 0, 0
    !__num_sat_sub_value_%out_value
    !__num_sat_sub_ok_%out_value

L_NUM_U64_SAT_SUB_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_SATURATING_MUL %out_value, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_MUL __num_sat_mul_ok_%out_value, __num_sat_mul_value_%out_value, %lhs, %rhs
    br __num_sat_mul_ok_%out_value -> L_NUM_U64_SAT_MUL_OK_%out_value, L_NUM_U64_SAT_MUL_MAX_%out_value

L_NUM_U64_SAT_MUL_OK_%out_value:
    %out_value = add __num_sat_mul_value_%out_value, 0
    !__num_sat_mul_value_%out_value
    !__num_sat_mul_ok_%out_value
    jmp L_NUM_U64_SAT_MUL_END_%out_value

L_NUM_U64_SAT_MUL_MAX_%out_value:
    %out_value = add 0, NUM_U64_MAX
    !__num_sat_mul_value_%out_value
    !__num_sat_mul_ok_%out_value

L_NUM_U64_SAT_MUL_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_SATURATING_DIV %out_value, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_DIV __num_sat_div_ok_%out_value, __num_sat_div_value_%out_value, %lhs, %rhs
    br __num_sat_div_ok_%out_value -> L_NUM_U64_SAT_DIV_OK_%out_value, L_NUM_U64_SAT_DIV_MAX_%out_value

L_NUM_U64_SAT_DIV_OK_%out_value:
    %out_value = add __num_sat_div_value_%out_value, 0
    !__num_sat_div_value_%out_value
    !__num_sat_div_ok_%out_value
    jmp L_NUM_U64_SAT_DIV_END_%out_value

L_NUM_U64_SAT_DIV_MAX_%out_value:
    %out_value = add 0, NUM_U64_MAX
    !__num_sat_div_value_%out_value
    !__num_sat_div_ok_%out_value

L_NUM_U64_SAT_DIV_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_ADD %out_value, %lhs, %rhs
    %out_value = add %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_SUB %out_value, %lhs, %rhs
    %out_value = sub %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_MUL %out_value, %lhs, %rhs
    %out_value = mul %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_DIV %out_value, %lhs, %rhs
    %out_value = udiv %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_REM %out_value, %lhs, %rhs
    %out_value = urem %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_CHECKED_SHL %out_ok, %out_value, %value, %shift
    __num_shl_ok_%out_ok = ult %shift, NUM_U64_BITS
    br __num_shl_ok_%out_ok -> L_NUM_U64_SHL_OK_%out_ok, L_NUM_U64_SHL_OVER_%out_ok

L_NUM_U64_SHL_OK_%out_ok:
    %out_value = shl %value, %shift
    %out_ok = add 0, 1
    !__num_shl_ok_%out_ok
    jmp L_NUM_U64_SHL_END_%out_ok

L_NUM_U64_SHL_OVER_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_shl_ok_%out_ok

L_NUM_U64_SHL_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_CHECKED_SHR %out_ok, %out_value, %value, %shift
    __num_shr_ok_%out_ok = ult %shift, NUM_U64_BITS
    br __num_shr_ok_%out_ok -> L_NUM_U64_SHR_OK_%out_ok, L_NUM_U64_SHR_OVER_%out_ok

L_NUM_U64_SHR_OK_%out_ok:
    %out_value = lshr %value, %shift
    %out_ok = add 0, 1
    !__num_shr_ok_%out_ok
    jmp L_NUM_U64_SHR_END_%out_ok

L_NUM_U64_SHR_OVER_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_shr_ok_%out_ok

L_NUM_U64_SHR_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_SHL %out_value, %value, %shift
    __num_wshl_shift_%out_value = urem %shift, NUM_U64_BITS
    %out_value = shl %value, __num_wshl_shift_%out_value
    !__num_wshl_shift_%out_value
[END_MACRO]

[MACRO] NUM_U64_WRAPPING_SHR %out_value, %value, %shift
    __num_wshr_shift_%out_value = urem %shift, NUM_U64_BITS
    %out_value = lshr %value, __num_wshr_shift_%out_value
    !__num_wshr_shift_%out_value
[END_MACRO]

[MACRO] NUM_U64_IS_POWER_OF_TWO %out_bool, %value
    __num_pow2_nonzero_%out_bool = ne %value, 0
    __num_pow2_prev_%out_bool = sub %value, 1
    __num_pow2_masked_%out_bool = and %value, __num_pow2_prev_%out_bool
    __num_pow2_single_%out_bool = eq __num_pow2_masked_%out_bool, 0
    %out_bool = and __num_pow2_nonzero_%out_bool, __num_pow2_single_%out_bool
    !__num_pow2_single_%out_bool
    !__num_pow2_masked_%out_bool
    !__num_pow2_prev_%out_bool
    !__num_pow2_nonzero_%out_bool
[END_MACRO]

[MACRO] NUM_U64_ABS_DIFF %out_value, %lhs, %rhs
    __num_absdiff_take_lhs_%out_value = uge %lhs, %rhs
    br __num_absdiff_take_lhs_%out_value -> L_NUM_U64_ABS_DIFF_LHS_%out_value, L_NUM_U64_ABS_DIFF_RHS_%out_value

L_NUM_U64_ABS_DIFF_LHS_%out_value:
    %out_value = sub %lhs, %rhs
    !__num_absdiff_take_lhs_%out_value
    jmp L_NUM_U64_ABS_DIFF_END_%out_value

L_NUM_U64_ABS_DIFF_RHS_%out_value:
    %out_value = sub %rhs, %lhs
    !__num_absdiff_take_lhs_%out_value

L_NUM_U64_ABS_DIFF_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_MIDPOINT %out_value, %lhs, %rhs
    __num_mid_and_%out_value = and %lhs, %rhs
    __num_mid_xor_%out_value = xor %lhs, %rhs
    __num_mid_half_%out_value = lshr __num_mid_xor_%out_value, 1
    %out_value = add __num_mid_and_%out_value, __num_mid_half_%out_value
    !__num_mid_half_%out_value
    !__num_mid_xor_%out_value
    !__num_mid_and_%out_value
[END_MACRO]

[MACRO] NUM_U64_ROTATE_LEFT %out_value, %value, %shift
    __num_rotl_shift_%out_value = urem %shift, NUM_U64_BITS
    __num_rotl_zero_%out_value = eq __num_rotl_shift_%out_value, 0
    br __num_rotl_zero_%out_value -> L_NUM_U64_ROTL_ZERO_%out_value, L_NUM_U64_ROTL_BODY_%out_value

L_NUM_U64_ROTL_BODY_%out_value:
    __num_rotl_right_%out_value = sub NUM_U64_BITS, __num_rotl_shift_%out_value
    __num_rotl_left_part_%out_value = shl %value, __num_rotl_shift_%out_value
    __num_rotl_right_part_%out_value = lshr %value, __num_rotl_right_%out_value
    %out_value = or __num_rotl_left_part_%out_value, __num_rotl_right_part_%out_value
    !__num_rotl_right_part_%out_value
    !__num_rotl_left_part_%out_value
    !__num_rotl_right_%out_value
    !__num_rotl_zero_%out_value
    !__num_rotl_shift_%out_value
    jmp L_NUM_U64_ROTL_END_%out_value

L_NUM_U64_ROTL_ZERO_%out_value:
    %out_value = add %value, 0
    !__num_rotl_zero_%out_value
    !__num_rotl_shift_%out_value

L_NUM_U64_ROTL_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_ROTATE_RIGHT %out_value, %value, %shift
    __num_rotr_shift_%out_value = urem %shift, NUM_U64_BITS
    __num_rotr_zero_%out_value = eq __num_rotr_shift_%out_value, 0
    br __num_rotr_zero_%out_value -> L_NUM_U64_ROTR_ZERO_%out_value, L_NUM_U64_ROTR_BODY_%out_value

L_NUM_U64_ROTR_BODY_%out_value:
    __num_rotr_left_%out_value = sub NUM_U64_BITS, __num_rotr_shift_%out_value
    __num_rotr_right_part_%out_value = lshr %value, __num_rotr_shift_%out_value
    __num_rotr_left_part_%out_value = shl %value, __num_rotr_left_%out_value
    %out_value = or __num_rotr_left_part_%out_value, __num_rotr_right_part_%out_value
    !__num_rotr_left_part_%out_value
    !__num_rotr_right_part_%out_value
    !__num_rotr_left_%out_value
    !__num_rotr_zero_%out_value
    !__num_rotr_shift_%out_value
    jmp L_NUM_U64_ROTR_END_%out_value

L_NUM_U64_ROTR_ZERO_%out_value:
    %out_value = add %value, 0
    !__num_rotr_zero_%out_value
    !__num_rotr_shift_%out_value

L_NUM_U64_ROTR_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_COUNT_ONES %out_count, %value
    __num_count_idx_slot_%out_count = stack_alloc 8
    __num_count_value_slot_%out_count = stack_alloc 8
    __num_count_count_slot_%out_count = stack_alloc 8
    store __num_count_idx_slot_%out_count+0, 0 as u64
    store __num_count_value_slot_%out_count+0, %value as u64
    store __num_count_count_slot_%out_count+0, 0 as u64
    jmp L_NUM_U64_COUNT_HEAD_%out_count

L_NUM_U64_COUNT_HEAD_%out_count:
    __num_count_idx_%out_count = load __num_count_idx_slot_%out_count+0 as u64
    __num_count_done_%out_count = eq __num_count_idx_%out_count, NUM_U64_BITS
    br __num_count_done_%out_count -> L_NUM_U64_COUNT_DONE_%out_count, L_NUM_U64_COUNT_BODY_%out_count

L_NUM_U64_COUNT_BODY_%out_count:
    __num_count_value_%out_count = load __num_count_value_slot_%out_count+0 as u64
    __num_count_acc_%out_count = load __num_count_count_slot_%out_count+0 as u64
    __num_count_bit_%out_count = and __num_count_value_%out_count, 1
    __num_count_next_acc_%out_count = add __num_count_acc_%out_count, __num_count_bit_%out_count
    __num_count_next_value_%out_count = lshr __num_count_value_%out_count, 1
    __num_count_next_idx_%out_count = add __num_count_idx_%out_count, 1
    store __num_count_count_slot_%out_count+0, __num_count_next_acc_%out_count as u64
    store __num_count_value_slot_%out_count+0, __num_count_next_value_%out_count as u64
    store __num_count_idx_slot_%out_count+0, __num_count_next_idx_%out_count as u64
    !__num_count_next_idx_%out_count
    !__num_count_next_value_%out_count
    !__num_count_next_acc_%out_count
    !__num_count_bit_%out_count
    !__num_count_acc_%out_count
    !__num_count_value_%out_count
    !__num_count_done_%out_count
    !__num_count_idx_%out_count
    jmp L_NUM_U64_COUNT_HEAD_%out_count

L_NUM_U64_COUNT_DONE_%out_count:
    %out_count = load __num_count_count_slot_%out_count+0 as u64
    !__num_count_done_%out_count
    !__num_count_idx_%out_count
[END_MACRO]

[MACRO] NUM_U64_COUNT_ZEROS %out_count, %value
    EXPAND NUM_U64_COUNT_ONES __num_count_ones_%out_count, %value
    %out_count = sub NUM_U64_BITS, __num_count_ones_%out_count
    !__num_count_ones_%out_count
[END_MACRO]

[MACRO] NUM_U64_POW %out_value, %base, %exp
    __num_pow_idx_slot_%out_value = stack_alloc 8
    __num_pow_acc_slot_%out_value = stack_alloc 8
    store __num_pow_idx_slot_%out_value+0, 0 as u64
    store __num_pow_acc_slot_%out_value+0, 1 as u64
    jmp L_NUM_U64_POW_HEAD_%out_value

L_NUM_U64_POW_HEAD_%out_value:
    __num_pow_idx_%out_value = load __num_pow_idx_slot_%out_value+0 as u64
    __num_pow_done_%out_value = eq __num_pow_idx_%out_value, %exp
    br __num_pow_done_%out_value -> L_NUM_U64_POW_DONE_%out_value, L_NUM_U64_POW_BODY_%out_value

L_NUM_U64_POW_BODY_%out_value:
    __num_pow_acc_%out_value = load __num_pow_acc_slot_%out_value+0 as u64
    __num_pow_next_acc_%out_value = mul __num_pow_acc_%out_value, %base
    __num_pow_next_idx_%out_value = add __num_pow_idx_%out_value, 1
    store __num_pow_acc_slot_%out_value+0, __num_pow_next_acc_%out_value as u64
    store __num_pow_idx_slot_%out_value+0, __num_pow_next_idx_%out_value as u64
    !__num_pow_next_idx_%out_value
    !__num_pow_next_acc_%out_value
    !__num_pow_acc_%out_value
    !__num_pow_done_%out_value
    !__num_pow_idx_%out_value
    jmp L_NUM_U64_POW_HEAD_%out_value

L_NUM_U64_POW_DONE_%out_value:
    %out_value = load __num_pow_acc_slot_%out_value+0 as u64
    !__num_pow_done_%out_value
    !__num_pow_idx_%out_value
[END_MACRO]

[MACRO] NUM_U64_LEADING_ZEROS %out_count, %value
    __num_lz_idx_slot_%out_count = stack_alloc 8
    store __num_lz_idx_slot_%out_count+0, 0 as u64
    jmp L_NUM_U64_LZ_HEAD_%out_count

L_NUM_U64_LZ_HEAD_%out_count:
    __num_lz_idx_%out_count = load __num_lz_idx_slot_%out_count+0 as u64
    __num_lz_done_%out_count = eq __num_lz_idx_%out_count, NUM_U64_BITS
    br __num_lz_done_%out_count -> L_NUM_U64_LZ_ALL_%out_count, L_NUM_U64_LZ_BODY_%out_count

L_NUM_U64_LZ_BODY_%out_count:
    __num_lz_bit_index_%out_count = sub 63, __num_lz_idx_%out_count
    __num_lz_mask_%out_count = shl 1, __num_lz_bit_index_%out_count
    __num_lz_masked_%out_count = and %value, __num_lz_mask_%out_count
    __num_lz_seen_one_%out_count = ne __num_lz_masked_%out_count, 0
    br __num_lz_seen_one_%out_count -> L_NUM_U64_LZ_FOUND_%out_count, L_NUM_U64_LZ_NEXT_%out_count

L_NUM_U64_LZ_NEXT_%out_count:
    __num_lz_next_%out_count = add __num_lz_idx_%out_count, 1
    store __num_lz_idx_slot_%out_count+0, __num_lz_next_%out_count as u64
    !__num_lz_next_%out_count
    !__num_lz_seen_one_%out_count
    !__num_lz_masked_%out_count
    !__num_lz_mask_%out_count
    !__num_lz_bit_index_%out_count
    !__num_lz_done_%out_count
    !__num_lz_idx_%out_count
    jmp L_NUM_U64_LZ_HEAD_%out_count

L_NUM_U64_LZ_FOUND_%out_count:
    %out_count = add __num_lz_idx_%out_count, 0
    !__num_lz_seen_one_%out_count
    !__num_lz_masked_%out_count
    !__num_lz_mask_%out_count
    !__num_lz_bit_index_%out_count
    !__num_lz_done_%out_count
    !__num_lz_idx_%out_count
    jmp L_NUM_U64_LZ_END_%out_count

L_NUM_U64_LZ_ALL_%out_count:
    %out_count = add 0, NUM_U64_BITS
    !__num_lz_done_%out_count
    !__num_lz_idx_%out_count

L_NUM_U64_LZ_END_%out_count:
[END_MACRO]

[MACRO] NUM_U64_TRAILING_ZEROS %out_count, %value
    __num_tz_idx_slot_%out_count = stack_alloc 8
    store __num_tz_idx_slot_%out_count+0, 0 as u64
    jmp L_NUM_U64_TZ_HEAD_%out_count

L_NUM_U64_TZ_HEAD_%out_count:
    __num_tz_idx_%out_count = load __num_tz_idx_slot_%out_count+0 as u64
    __num_tz_done_%out_count = eq __num_tz_idx_%out_count, NUM_U64_BITS
    br __num_tz_done_%out_count -> L_NUM_U64_TZ_ALL_%out_count, L_NUM_U64_TZ_BODY_%out_count

L_NUM_U64_TZ_BODY_%out_count:
    __num_tz_mask_%out_count = shl 1, __num_tz_idx_%out_count
    __num_tz_masked_%out_count = and %value, __num_tz_mask_%out_count
    __num_tz_seen_one_%out_count = ne __num_tz_masked_%out_count, 0
    br __num_tz_seen_one_%out_count -> L_NUM_U64_TZ_FOUND_%out_count, L_NUM_U64_TZ_NEXT_%out_count

L_NUM_U64_TZ_NEXT_%out_count:
    __num_tz_next_%out_count = add __num_tz_idx_%out_count, 1
    store __num_tz_idx_slot_%out_count+0, __num_tz_next_%out_count as u64
    !__num_tz_next_%out_count
    !__num_tz_seen_one_%out_count
    !__num_tz_masked_%out_count
    !__num_tz_mask_%out_count
    !__num_tz_done_%out_count
    !__num_tz_idx_%out_count
    jmp L_NUM_U64_TZ_HEAD_%out_count

L_NUM_U64_TZ_FOUND_%out_count:
    %out_count = add __num_tz_idx_%out_count, 0
    !__num_tz_seen_one_%out_count
    !__num_tz_masked_%out_count
    !__num_tz_mask_%out_count
    !__num_tz_done_%out_count
    !__num_tz_idx_%out_count
    jmp L_NUM_U64_TZ_END_%out_count

L_NUM_U64_TZ_ALL_%out_count:
    %out_count = add 0, NUM_U64_BITS
    !__num_tz_done_%out_count
    !__num_tz_idx_%out_count

L_NUM_U64_TZ_END_%out_count:
[END_MACRO]

[MACRO] NUM_U64_LEADING_ONES %out_count, %value
    __num_lo_inv_%out_count = xor %value, NUM_U64_MAX
    EXPAND NUM_U64_LEADING_ZEROS %out_count, __num_lo_inv_%out_count
    !__num_lo_inv_%out_count
[END_MACRO]

[MACRO] NUM_U64_TRAILING_ONES %out_count, %value
    __num_to_inv_%out_count = xor %value, NUM_U64_MAX
    EXPAND NUM_U64_TRAILING_ZEROS %out_count, __num_to_inv_%out_count
    !__num_to_inv_%out_count
[END_MACRO]

[MACRO] NUM_U64_BIT_WIDTH %out_width, %value
    EXPAND NUM_U64_LEADING_ZEROS __num_bit_width_lz_%out_width, %value
    %out_width = sub NUM_U64_BITS, __num_bit_width_lz_%out_width
    !__num_bit_width_lz_%out_width
[END_MACRO]

[MACRO] NUM_U64_ISOLATE_HIGHEST_ONE %out_value, %value
    __num_iso_high_zero_%out_value = eq %value, 0
    br __num_iso_high_zero_%out_value -> L_NUM_U64_ISO_HIGH_ZERO_%out_value, L_NUM_U64_ISO_HIGH_VALUE_%out_value

L_NUM_U64_ISO_HIGH_VALUE_%out_value:
    EXPAND NUM_U64_LEADING_ZEROS __num_iso_high_lz_%out_value, %value
    __num_iso_high_index_%out_value = sub 63, __num_iso_high_lz_%out_value
    %out_value = shl 1, __num_iso_high_index_%out_value
    !__num_iso_high_index_%out_value
    !__num_iso_high_lz_%out_value
    !__num_iso_high_zero_%out_value
    jmp L_NUM_U64_ISO_HIGH_END_%out_value

L_NUM_U64_ISO_HIGH_ZERO_%out_value:
    %out_value = add 0, 0
    !__num_iso_high_zero_%out_value

L_NUM_U64_ISO_HIGH_END_%out_value:
[END_MACRO]

[MACRO] NUM_U64_ISOLATE_LOWEST_ONE %out_value, %value
    __num_iso_low_neg_%out_value = sub 0, %value
    %out_value = and %value, __num_iso_low_neg_%out_value
    !__num_iso_low_neg_%out_value
[END_MACRO]

[MACRO] NUM_U64_HIGHEST_ONE %out_ok, %out_index, %value
    __num_high_one_zero_%out_ok = eq %value, 0
    br __num_high_one_zero_%out_ok -> L_NUM_U64_HIGH_ONE_NONE_%out_ok, L_NUM_U64_HIGH_ONE_SOME_%out_ok

L_NUM_U64_HIGH_ONE_SOME_%out_ok:
    EXPAND NUM_U64_LEADING_ZEROS __num_high_one_lz_%out_ok, %value
    %out_index = sub 63, __num_high_one_lz_%out_ok
    %out_ok = add 0, 1
    !__num_high_one_lz_%out_ok
    !__num_high_one_zero_%out_ok
    jmp L_NUM_U64_HIGH_ONE_END_%out_ok

L_NUM_U64_HIGH_ONE_NONE_%out_ok:
    %out_index = add 0, 0
    %out_ok = add 0, 0
    !__num_high_one_zero_%out_ok

L_NUM_U64_HIGH_ONE_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_LOWEST_ONE %out_ok, %out_index, %value
    __num_low_one_zero_%out_ok = eq %value, 0
    br __num_low_one_zero_%out_ok -> L_NUM_U64_LOW_ONE_NONE_%out_ok, L_NUM_U64_LOW_ONE_SOME_%out_ok

L_NUM_U64_LOW_ONE_SOME_%out_ok:
    EXPAND NUM_U64_TRAILING_ZEROS %out_index, %value
    %out_ok = add 0, 1
    !__num_low_one_zero_%out_ok
    jmp L_NUM_U64_LOW_ONE_END_%out_ok

L_NUM_U64_LOW_ONE_NONE_%out_ok:
    %out_index = add 0, 0
    %out_ok = add 0, 0
    !__num_low_one_zero_%out_ok

L_NUM_U64_LOW_ONE_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_REVERSE_BITS %out_value, %value
    __num_rev_idx_slot_%out_value = stack_alloc 8
    __num_rev_acc_slot_%out_value = stack_alloc 8
    __num_rev_value_slot_%out_value = stack_alloc 8
    store __num_rev_idx_slot_%out_value+0, 0 as u64
    store __num_rev_acc_slot_%out_value+0, 0 as u64
    store __num_rev_value_slot_%out_value+0, %value as u64
    jmp L_NUM_U64_REV_HEAD_%out_value

L_NUM_U64_REV_HEAD_%out_value:
    __num_rev_idx_%out_value = load __num_rev_idx_slot_%out_value+0 as u64
    __num_rev_done_%out_value = eq __num_rev_idx_%out_value, NUM_U64_BITS
    br __num_rev_done_%out_value -> L_NUM_U64_REV_DONE_%out_value, L_NUM_U64_REV_BODY_%out_value

L_NUM_U64_REV_BODY_%out_value:
    __num_rev_acc_%out_value = load __num_rev_acc_slot_%out_value+0 as u64
    __num_rev_value_%out_value = load __num_rev_value_slot_%out_value+0 as u64
    __num_rev_bit_%out_value = and __num_rev_value_%out_value, 1
    __num_rev_shifted_%out_value = shl __num_rev_acc_%out_value, 1
    __num_rev_next_acc_%out_value = or __num_rev_shifted_%out_value, __num_rev_bit_%out_value
    __num_rev_next_value_%out_value = lshr __num_rev_value_%out_value, 1
    __num_rev_next_idx_%out_value = add __num_rev_idx_%out_value, 1
    store __num_rev_acc_slot_%out_value+0, __num_rev_next_acc_%out_value as u64
    store __num_rev_value_slot_%out_value+0, __num_rev_next_value_%out_value as u64
    store __num_rev_idx_slot_%out_value+0, __num_rev_next_idx_%out_value as u64
    !__num_rev_next_idx_%out_value
    !__num_rev_next_value_%out_value
    !__num_rev_next_acc_%out_value
    !__num_rev_shifted_%out_value
    !__num_rev_bit_%out_value
    !__num_rev_value_%out_value
    !__num_rev_acc_%out_value
    !__num_rev_done_%out_value
    !__num_rev_idx_%out_value
    jmp L_NUM_U64_REV_HEAD_%out_value

L_NUM_U64_REV_DONE_%out_value:
    %out_value = load __num_rev_acc_slot_%out_value+0 as u64
    !__num_rev_done_%out_value
    !__num_rev_idx_%out_value
[END_MACRO]

[MACRO] NUM_U64_SWAP_BYTES %out_value, %value
    __num_swap_idx_slot_%out_value = stack_alloc 8
    __num_swap_acc_slot_%out_value = stack_alloc 8
    store __num_swap_idx_slot_%out_value+0, 0 as u64
    store __num_swap_acc_slot_%out_value+0, 0 as u64
    jmp L_NUM_U64_SWAP_HEAD_%out_value

L_NUM_U64_SWAP_HEAD_%out_value:
    __num_swap_idx_%out_value = load __num_swap_idx_slot_%out_value+0 as u64
    __num_swap_done_%out_value = eq __num_swap_idx_%out_value, 8
    br __num_swap_done_%out_value -> L_NUM_U64_SWAP_DONE_%out_value, L_NUM_U64_SWAP_BODY_%out_value

L_NUM_U64_SWAP_BODY_%out_value:
    __num_swap_acc_%out_value = load __num_swap_acc_slot_%out_value+0 as u64
    __num_swap_src_shift_%out_value = mul __num_swap_idx_%out_value, 8
    __num_swap_byte_raw_%out_value = lshr %value, __num_swap_src_shift_%out_value
    __num_swap_byte_%out_value = and __num_swap_byte_raw_%out_value, 255
    __num_swap_inv_idx_%out_value = sub 7, __num_swap_idx_%out_value
    __num_swap_dst_shift_%out_value = mul __num_swap_inv_idx_%out_value, 8
    __num_swap_shifted_%out_value = shl __num_swap_byte_%out_value, __num_swap_dst_shift_%out_value
    __num_swap_next_acc_%out_value = or __num_swap_acc_%out_value, __num_swap_shifted_%out_value
    __num_swap_next_idx_%out_value = add __num_swap_idx_%out_value, 1
    store __num_swap_acc_slot_%out_value+0, __num_swap_next_acc_%out_value as u64
    store __num_swap_idx_slot_%out_value+0, __num_swap_next_idx_%out_value as u64
    !__num_swap_next_idx_%out_value
    !__num_swap_next_acc_%out_value
    !__num_swap_shifted_%out_value
    !__num_swap_dst_shift_%out_value
    !__num_swap_inv_idx_%out_value
    !__num_swap_byte_%out_value
    !__num_swap_byte_raw_%out_value
    !__num_swap_src_shift_%out_value
    !__num_swap_acc_%out_value
    !__num_swap_done_%out_value
    !__num_swap_idx_%out_value
    jmp L_NUM_U64_SWAP_HEAD_%out_value

L_NUM_U64_SWAP_DONE_%out_value:
    %out_value = load __num_swap_acc_slot_%out_value+0 as u64
    !__num_swap_done_%out_value
    !__num_swap_idx_%out_value
[END_MACRO]

[MACRO] NUM_U64_TO_BE %out_value, %value
    EXPAND NUM_U64_SWAP_BYTES %out_value, %value
[END_MACRO]

[MACRO] NUM_U64_FROM_BE %out_value, %value
    EXPAND NUM_U64_SWAP_BYTES %out_value, %value
[END_MACRO]

[MACRO] NUM_U64_TO_LE %out_value, %value
    %out_value = add %value, 0
[END_MACRO]

[MACRO] NUM_U64_FROM_LE %out_value, %value
    %out_value = add %value, 0
[END_MACRO]

[MACRO] NUM_U64_WRITE_BE_BYTES %out_ok, %dst_ptr, %dst_len, %value
    __num_u64_be_fits_%out_ok = uge %dst_len, 8
    br __num_u64_be_fits_%out_ok -> L_NUM_U64_WRITE_BE_BYTES_OK_%out_ok, L_NUM_U64_WRITE_BE_BYTES_FAIL_%out_ok

L_NUM_U64_WRITE_BE_BYTES_OK_%out_ok:
    __num_u64_be_b0_%out_ok = lshr %value, 56
    __num_u64_be_b1_raw_%out_ok = lshr %value, 48
    __num_u64_be_b1_%out_ok = and __num_u64_be_b1_raw_%out_ok, 255
    __num_u64_be_b2_raw_%out_ok = lshr %value, 40
    __num_u64_be_b2_%out_ok = and __num_u64_be_b2_raw_%out_ok, 255
    __num_u64_be_b3_raw_%out_ok = lshr %value, 32
    __num_u64_be_b3_%out_ok = and __num_u64_be_b3_raw_%out_ok, 255
    __num_u64_be_b4_raw_%out_ok = lshr %value, 24
    __num_u64_be_b4_%out_ok = and __num_u64_be_b4_raw_%out_ok, 255
    __num_u64_be_b5_raw_%out_ok = lshr %value, 16
    __num_u64_be_b5_%out_ok = and __num_u64_be_b5_raw_%out_ok, 255
    __num_u64_be_b6_raw_%out_ok = lshr %value, 8
    __num_u64_be_b6_%out_ok = and __num_u64_be_b6_raw_%out_ok, 255
    __num_u64_be_b7_%out_ok = and %value, 255
    __num_u64_be_p1_%out_ok = ptr_add %dst_ptr, 1
    __num_u64_be_p2_%out_ok = ptr_add %dst_ptr, 2
    __num_u64_be_p3_%out_ok = ptr_add %dst_ptr, 3
    __num_u64_be_p4_%out_ok = ptr_add %dst_ptr, 4
    __num_u64_be_p5_%out_ok = ptr_add %dst_ptr, 5
    __num_u64_be_p6_%out_ok = ptr_add %dst_ptr, 6
    __num_u64_be_p7_%out_ok = ptr_add %dst_ptr, 7
    store %dst_ptr+0, __num_u64_be_b0_%out_ok as u8
    store __num_u64_be_p1_%out_ok+0, __num_u64_be_b1_%out_ok as u8
    store __num_u64_be_p2_%out_ok+0, __num_u64_be_b2_%out_ok as u8
    store __num_u64_be_p3_%out_ok+0, __num_u64_be_b3_%out_ok as u8
    store __num_u64_be_p4_%out_ok+0, __num_u64_be_b4_%out_ok as u8
    store __num_u64_be_p5_%out_ok+0, __num_u64_be_b5_%out_ok as u8
    store __num_u64_be_p6_%out_ok+0, __num_u64_be_b6_%out_ok as u8
    store __num_u64_be_p7_%out_ok+0, __num_u64_be_b7_%out_ok as u8
    %out_ok = add 0, 1
    !__num_u64_be_p7_%out_ok
    !__num_u64_be_p6_%out_ok
    !__num_u64_be_p5_%out_ok
    !__num_u64_be_p4_%out_ok
    !__num_u64_be_p3_%out_ok
    !__num_u64_be_p2_%out_ok
    !__num_u64_be_p1_%out_ok
    !__num_u64_be_b7_%out_ok
    !__num_u64_be_b6_%out_ok
    !__num_u64_be_b6_raw_%out_ok
    !__num_u64_be_b5_%out_ok
    !__num_u64_be_b5_raw_%out_ok
    !__num_u64_be_b4_%out_ok
    !__num_u64_be_b4_raw_%out_ok
    !__num_u64_be_b3_%out_ok
    !__num_u64_be_b3_raw_%out_ok
    !__num_u64_be_b2_%out_ok
    !__num_u64_be_b2_raw_%out_ok
    !__num_u64_be_b1_%out_ok
    !__num_u64_be_b1_raw_%out_ok
    !__num_u64_be_b0_%out_ok
    !__num_u64_be_fits_%out_ok
    jmp L_NUM_U64_WRITE_BE_BYTES_END_%out_ok

L_NUM_U64_WRITE_BE_BYTES_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__num_u64_be_fits_%out_ok

L_NUM_U64_WRITE_BE_BYTES_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_WRITE_LE_BYTES %out_ok, %dst_ptr, %dst_len, %value
    __num_u64_le_fits_%out_ok = uge %dst_len, 8
    br __num_u64_le_fits_%out_ok -> L_NUM_U64_WRITE_LE_BYTES_OK_%out_ok, L_NUM_U64_WRITE_LE_BYTES_FAIL_%out_ok

L_NUM_U64_WRITE_LE_BYTES_OK_%out_ok:
    __num_u64_le_b0_%out_ok = and %value, 255
    __num_u64_le_b1_raw_%out_ok = lshr %value, 8
    __num_u64_le_b1_%out_ok = and __num_u64_le_b1_raw_%out_ok, 255
    __num_u64_le_b2_raw_%out_ok = lshr %value, 16
    __num_u64_le_b2_%out_ok = and __num_u64_le_b2_raw_%out_ok, 255
    __num_u64_le_b3_raw_%out_ok = lshr %value, 24
    __num_u64_le_b3_%out_ok = and __num_u64_le_b3_raw_%out_ok, 255
    __num_u64_le_b4_raw_%out_ok = lshr %value, 32
    __num_u64_le_b4_%out_ok = and __num_u64_le_b4_raw_%out_ok, 255
    __num_u64_le_b5_raw_%out_ok = lshr %value, 40
    __num_u64_le_b5_%out_ok = and __num_u64_le_b5_raw_%out_ok, 255
    __num_u64_le_b6_raw_%out_ok = lshr %value, 48
    __num_u64_le_b6_%out_ok = and __num_u64_le_b6_raw_%out_ok, 255
    __num_u64_le_b7_%out_ok = lshr %value, 56
    __num_u64_le_p1_%out_ok = ptr_add %dst_ptr, 1
    __num_u64_le_p2_%out_ok = ptr_add %dst_ptr, 2
    __num_u64_le_p3_%out_ok = ptr_add %dst_ptr, 3
    __num_u64_le_p4_%out_ok = ptr_add %dst_ptr, 4
    __num_u64_le_p5_%out_ok = ptr_add %dst_ptr, 5
    __num_u64_le_p6_%out_ok = ptr_add %dst_ptr, 6
    __num_u64_le_p7_%out_ok = ptr_add %dst_ptr, 7
    store %dst_ptr+0, __num_u64_le_b0_%out_ok as u8
    store __num_u64_le_p1_%out_ok+0, __num_u64_le_b1_%out_ok as u8
    store __num_u64_le_p2_%out_ok+0, __num_u64_le_b2_%out_ok as u8
    store __num_u64_le_p3_%out_ok+0, __num_u64_le_b3_%out_ok as u8
