L_NUM_I64_SAT_ABS_END_%out_value:
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_NEG %out_value, %value
    %out_value = sub 0, %value
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_ABS %out_value, %value
    EXPAND NUM_I64_ABS %out_value, %value
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_ADD %out_value, %lhs, %rhs
    %out_value = add %lhs, %rhs
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_SUB %out_value, %lhs, %rhs
    %out_value = sub %lhs, %rhs
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_MUL %out_value, %lhs, %rhs
    %out_value = mul %lhs, %rhs
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_DIV %out_value, %lhs, %rhs
    __num_iwrap_div_lhs_min_%out_value = eq %lhs, NUM_I64_MIN
    __num_iwrap_div_rhs_neg_one_%out_value = eq %rhs, -1
    __num_iwrap_div_over_%out_value = and __num_iwrap_div_lhs_min_%out_value, __num_iwrap_div_rhs_neg_one_%out_value
    br __num_iwrap_div_over_%out_value -> L_NUM_I64_WRAP_DIV_MIN_%out_value, L_NUM_I64_WRAP_DIV_NORMAL_%out_value

L_NUM_I64_WRAP_DIV_NORMAL_%out_value:
    %out_value = sdiv %lhs, %rhs
    !__num_iwrap_div_over_%out_value
    !__num_iwrap_div_rhs_neg_one_%out_value
    !__num_iwrap_div_lhs_min_%out_value
    jmp L_NUM_I64_WRAP_DIV_END_%out_value

L_NUM_I64_WRAP_DIV_MIN_%out_value:
    %out_value = add 0, NUM_I64_MIN
    !__num_iwrap_div_over_%out_value
    !__num_iwrap_div_rhs_neg_one_%out_value
    !__num_iwrap_div_lhs_min_%out_value

L_NUM_I64_WRAP_DIV_END_%out_value:
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_REM %out_value, %lhs, %rhs
    __num_iwrap_rem_lhs_min_%out_value = eq %lhs, NUM_I64_MIN
    __num_iwrap_rem_rhs_neg_one_%out_value = eq %rhs, -1
    __num_iwrap_rem_over_%out_value = and __num_iwrap_rem_lhs_min_%out_value, __num_iwrap_rem_rhs_neg_one_%out_value
    br __num_iwrap_rem_over_%out_value -> L_NUM_I64_WRAP_REM_ZERO_%out_value, L_NUM_I64_WRAP_REM_NORMAL_%out_value

L_NUM_I64_WRAP_REM_NORMAL_%out_value:
    %out_value = srem %lhs, %rhs
    !__num_iwrap_rem_over_%out_value
    !__num_iwrap_rem_rhs_neg_one_%out_value
    !__num_iwrap_rem_lhs_min_%out_value
    jmp L_NUM_I64_WRAP_REM_END_%out_value

L_NUM_I64_WRAP_REM_ZERO_%out_value:
    %out_value = add 0, 0
    !__num_iwrap_rem_over_%out_value
    !__num_iwrap_rem_rhs_neg_one_%out_value
    !__num_iwrap_rem_lhs_min_%out_value

L_NUM_I64_WRAP_REM_END_%out_value:
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_SHL %out_value, %value, %shift
    __num_iwshl_shift_%out_value = urem %shift, NUM_I64_BITS
    %out_value = shl %value, __num_iwshl_shift_%out_value
    !__num_iwshl_shift_%out_value
[END_MACRO]

[MACRO] NUM_I64_WRAPPING_SHR %out_value, %value, %shift
    __num_iwshr_shift_%out_value = urem %shift, NUM_I64_BITS
    %out_value = ashr %value, __num_iwshr_shift_%out_value
    !__num_iwshr_shift_%out_value
[END_MACRO]

[MACRO] NUM_I64_CHECKED_DIV_EUCLID %out_ok, %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_DIV __num_idiv_euclid_ok_%out_ok, __num_idiv_euclid_q_%out_ok, %lhs, %rhs
    br __num_idiv_euclid_ok_%out_ok -> L_NUM_I64_DIV_EUCLID_COMPUTE_%out_ok, L_NUM_I64_DIV_EUCLID_FAIL_%out_ok

L_NUM_I64_DIV_EUCLID_COMPUTE_%out_ok:
    __num_idiv_euclid_r_%out_ok = srem %lhs, %rhs
    __num_idiv_euclid_r_neg_%out_ok = slt __num_idiv_euclid_r_%out_ok, 0
    br __num_idiv_euclid_r_neg_%out_ok -> L_NUM_I64_DIV_EUCLID_ADJUST_%out_ok, L_NUM_I64_DIV_EUCLID_OK_%out_ok

L_NUM_I64_DIV_EUCLID_ADJUST_%out_ok:
    __num_idiv_euclid_rhs_pos_%out_ok = sgt %rhs, 0
    br __num_idiv_euclid_rhs_pos_%out_ok -> L_NUM_I64_DIV_EUCLID_DEC_%out_ok, L_NUM_I64_DIV_EUCLID_INC_%out_ok

L_NUM_I64_DIV_EUCLID_DEC_%out_ok:
    %out_value = sub __num_idiv_euclid_q_%out_ok, 1
    %out_ok = add 0, 1
    !__num_idiv_euclid_rhs_pos_%out_ok
    !__num_idiv_euclid_r_neg_%out_ok
    !__num_idiv_euclid_r_%out_ok
    !__num_idiv_euclid_q_%out_ok
    !__num_idiv_euclid_ok_%out_ok
    jmp L_NUM_I64_DIV_EUCLID_END_%out_ok

L_NUM_I64_DIV_EUCLID_INC_%out_ok:
    %out_value = add __num_idiv_euclid_q_%out_ok, 1
    %out_ok = add 0, 1
    !__num_idiv_euclid_rhs_pos_%out_ok
    !__num_idiv_euclid_r_neg_%out_ok
    !__num_idiv_euclid_r_%out_ok
    !__num_idiv_euclid_q_%out_ok
    !__num_idiv_euclid_ok_%out_ok
    jmp L_NUM_I64_DIV_EUCLID_END_%out_ok

L_NUM_I64_DIV_EUCLID_OK_%out_ok:
    %out_value = add __num_idiv_euclid_q_%out_ok, 0
    %out_ok = add 0, 1
    !__num_idiv_euclid_r_neg_%out_ok
    !__num_idiv_euclid_r_%out_ok
    !__num_idiv_euclid_q_%out_ok
    !__num_idiv_euclid_ok_%out_ok
    jmp L_NUM_I64_DIV_EUCLID_END_%out_ok

L_NUM_I64_DIV_EUCLID_FAIL_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_idiv_euclid_q_%out_ok
    !__num_idiv_euclid_ok_%out_ok

L_NUM_I64_DIV_EUCLID_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_DIV_EUCLID %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_DIV_EUCLID __num_idiv_euclid_direct_ok_%out_value, %out_value, %lhs, %rhs
    !__num_idiv_euclid_direct_ok_%out_value
[END_MACRO]

[MACRO] NUM_I64_CHECKED_REM_EUCLID %out_ok, %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_REM __num_irem_euclid_ok_%out_ok, __num_irem_euclid_r_%out_ok, %lhs, %rhs
    br __num_irem_euclid_ok_%out_ok -> L_NUM_I64_REM_EUCLID_COMPUTE_%out_ok, L_NUM_I64_REM_EUCLID_FAIL_%out_ok

L_NUM_I64_REM_EUCLID_COMPUTE_%out_ok:
    __num_irem_euclid_r_neg_%out_ok = slt __num_irem_euclid_r_%out_ok, 0
    br __num_irem_euclid_r_neg_%out_ok -> L_NUM_I64_REM_EUCLID_ADJUST_%out_ok, L_NUM_I64_REM_EUCLID_OK_%out_ok

L_NUM_I64_REM_EUCLID_ADJUST_%out_ok:
    __num_irem_euclid_rhs_pos_%out_ok = sgt %rhs, 0
    br __num_irem_euclid_rhs_pos_%out_ok -> L_NUM_I64_REM_EUCLID_ADD_%out_ok, L_NUM_I64_REM_EUCLID_SUB_%out_ok

L_NUM_I64_REM_EUCLID_ADD_%out_ok:
    %out_value = add __num_irem_euclid_r_%out_ok, %rhs
    %out_ok = add 0, 1
    !__num_irem_euclid_rhs_pos_%out_ok
    !__num_irem_euclid_r_neg_%out_ok
    !__num_irem_euclid_r_%out_ok
    !__num_irem_euclid_ok_%out_ok
    jmp L_NUM_I64_REM_EUCLID_END_%out_ok

L_NUM_I64_REM_EUCLID_SUB_%out_ok:
    %out_value = sub __num_irem_euclid_r_%out_ok, %rhs
    %out_ok = add 0, 1
    !__num_irem_euclid_rhs_pos_%out_ok
    !__num_irem_euclid_r_neg_%out_ok
    !__num_irem_euclid_r_%out_ok
    !__num_irem_euclid_ok_%out_ok
    jmp L_NUM_I64_REM_EUCLID_END_%out_ok

L_NUM_I64_REM_EUCLID_OK_%out_ok:
    %out_value = add __num_irem_euclid_r_%out_ok, 0
    %out_ok = add 0, 1
    !__num_irem_euclid_r_neg_%out_ok
    !__num_irem_euclid_r_%out_ok
    !__num_irem_euclid_ok_%out_ok
    jmp L_NUM_I64_REM_EUCLID_END_%out_ok

L_NUM_I64_REM_EUCLID_FAIL_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_irem_euclid_r_%out_ok
    !__num_irem_euclid_ok_%out_ok

L_NUM_I64_REM_EUCLID_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_REM_EUCLID %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_REM_EUCLID __num_irem_euclid_direct_ok_%out_value, %out_value, %lhs, %rhs
    !__num_irem_euclid_direct_ok_%out_value
[END_MACRO]

[MACRO] NUM_I64_CHECKED_DIV_CEIL %out_ok, %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_DIV __num_idiv_ceil_ok_%out_ok, __num_idiv_ceil_q_%out_ok, %lhs, %rhs
    br __num_idiv_ceil_ok_%out_ok -> L_NUM_I64_DIV_CEIL_COMPUTE_%out_ok, L_NUM_I64_DIV_CEIL_FAIL_%out_ok

L_NUM_I64_DIV_CEIL_COMPUTE_%out_ok:
    __num_idiv_ceil_r_%out_ok = srem %lhs, %rhs
    __num_idiv_ceil_has_rem_%out_ok = ne __num_idiv_ceil_r_%out_ok, 0
    br __num_idiv_ceil_has_rem_%out_ok -> L_NUM_I64_DIV_CEIL_SIGN_%out_ok, L_NUM_I64_DIV_CEIL_NO_REM_%out_ok

L_NUM_I64_DIV_CEIL_SIGN_%out_ok:
    __num_idiv_ceil_lhs_neg_%out_ok = slt %lhs, 0
    __num_idiv_ceil_rhs_neg_%out_ok = slt %rhs, 0
    __num_idiv_ceil_same_sign_%out_ok = eq __num_idiv_ceil_lhs_neg_%out_ok, __num_idiv_ceil_rhs_neg_%out_ok
    br __num_idiv_ceil_same_sign_%out_ok -> L_NUM_I64_DIV_CEIL_INC_%out_ok, L_NUM_I64_DIV_CEIL_KEEP_%out_ok

L_NUM_I64_DIV_CEIL_INC_%out_ok:
    %out_value = add __num_idiv_ceil_q_%out_ok, 1
    %out_ok = add 0, 1
    !__num_idiv_ceil_same_sign_%out_ok
    !__num_idiv_ceil_rhs_neg_%out_ok
    !__num_idiv_ceil_lhs_neg_%out_ok
    !__num_idiv_ceil_has_rem_%out_ok
    !__num_idiv_ceil_r_%out_ok
    !__num_idiv_ceil_q_%out_ok
    !__num_idiv_ceil_ok_%out_ok
    jmp L_NUM_I64_DIV_CEIL_END_%out_ok

L_NUM_I64_DIV_CEIL_KEEP_%out_ok:
    %out_value = add __num_idiv_ceil_q_%out_ok, 0
    %out_ok = add 0, 1
    !__num_idiv_ceil_same_sign_%out_ok
    !__num_idiv_ceil_rhs_neg_%out_ok
    !__num_idiv_ceil_lhs_neg_%out_ok
    !__num_idiv_ceil_has_rem_%out_ok
    !__num_idiv_ceil_r_%out_ok
    !__num_idiv_ceil_q_%out_ok
    !__num_idiv_ceil_ok_%out_ok
    jmp L_NUM_I64_DIV_CEIL_END_%out_ok

L_NUM_I64_DIV_CEIL_NO_REM_%out_ok:
    %out_value = add __num_idiv_ceil_q_%out_ok, 0
    %out_ok = add 0, 1
    !__num_idiv_ceil_has_rem_%out_ok
    !__num_idiv_ceil_r_%out_ok
    !__num_idiv_ceil_q_%out_ok
    !__num_idiv_ceil_ok_%out_ok
    jmp L_NUM_I64_DIV_CEIL_END_%out_ok

L_NUM_I64_DIV_CEIL_FAIL_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_idiv_ceil_q_%out_ok
    !__num_idiv_ceil_ok_%out_ok

L_NUM_I64_DIV_CEIL_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_DIV_CEIL %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_DIV_CEIL __num_idiv_ceil_direct_ok_%out_value, %out_value, %lhs, %rhs
    !__num_idiv_ceil_direct_ok_%out_value
[END_MACRO]

[MACRO] NUM_I64_CHECKED_NEXT_MULTIPLE_OF %out_ok, %out_value, %value, %rhs
    __num_inext_mul_zero_rhs_%out_ok = eq %rhs, 0
    br __num_inext_mul_zero_rhs_%out_ok -> L_NUM_I64_NEXT_MUL_ZERO_RHS_%out_ok, L_NUM_I64_NEXT_MUL_ABS_%out_ok

L_NUM_I64_NEXT_MUL_ABS_%out_ok:
    EXPAND NUM_I64_CHECKED_ABS __num_inext_mul_abs_ok_%out_ok, __num_inext_mul_abs_rhs_%out_ok, %rhs
    br __num_inext_mul_abs_ok_%out_ok -> L_NUM_I64_NEXT_MUL_REM_%out_ok, L_NUM_I64_NEXT_MUL_MIN_RHS_%out_ok

L_NUM_I64_NEXT_MUL_REM_%out_ok:
    EXPAND NUM_I64_CHECKED_REM_EUCLID __num_inext_mul_rem_ok_%out_ok, __num_inext_mul_rem_%out_ok, %value, __num_inext_mul_abs_rhs_%out_ok
    __num_inext_mul_aligned_%out_ok = eq __num_inext_mul_rem_%out_ok, 0
    br __num_inext_mul_aligned_%out_ok -> L_NUM_I64_NEXT_MUL_ALIGNED_%out_ok, L_NUM_I64_NEXT_MUL_ADD_%out_ok

L_NUM_I64_NEXT_MUL_ADD_%out_ok:
    __num_inext_mul_delta_%out_ok = sub __num_inext_mul_abs_rhs_%out_ok, __num_inext_mul_rem_%out_ok
    EXPAND NUM_I64_CHECKED_ADD %out_ok, %out_value, %value, __num_inext_mul_delta_%out_ok
    !__num_inext_mul_delta_%out_ok
    !__num_inext_mul_aligned_%out_ok
    !__num_inext_mul_rem_%out_ok
    !__num_inext_mul_rem_ok_%out_ok
    !__num_inext_mul_abs_rhs_%out_ok
    !__num_inext_mul_abs_ok_%out_ok
    !__num_inext_mul_zero_rhs_%out_ok
    jmp L_NUM_I64_NEXT_MUL_END_%out_ok

L_NUM_I64_NEXT_MUL_ALIGNED_%out_ok:
    %out_value = add %value, 0
    %out_ok = add 0, 1
    !__num_inext_mul_aligned_%out_ok
    !__num_inext_mul_rem_%out_ok
    !__num_inext_mul_rem_ok_%out_ok
    !__num_inext_mul_abs_rhs_%out_ok
    !__num_inext_mul_abs_ok_%out_ok
    !__num_inext_mul_zero_rhs_%out_ok
    jmp L_NUM_I64_NEXT_MUL_END_%out_ok

L_NUM_I64_NEXT_MUL_MIN_RHS_%out_ok:
    __num_inext_mul_min_value_%out_ok = eq %value, NUM_I64_MIN
    br __num_inext_mul_min_value_%out_ok -> L_NUM_I64_NEXT_MUL_MIN_VALUE_%out_ok, L_NUM_I64_NEXT_MUL_MIN_TO_ZERO_CHECK_%out_ok

L_NUM_I64_NEXT_MUL_MIN_VALUE_%out_ok:
    %out_value = add 0, NUM_I64_MIN
    %out_ok = add 0, 1
    !__num_inext_mul_min_value_%out_ok
    !__num_inext_mul_abs_rhs_%out_ok
    !__num_inext_mul_abs_ok_%out_ok
    !__num_inext_mul_zero_rhs_%out_ok
    jmp L_NUM_I64_NEXT_MUL_END_%out_ok

L_NUM_I64_NEXT_MUL_MIN_TO_ZERO_CHECK_%out_ok:
    __num_inext_mul_min_nonpos_%out_ok = sle %value, 0
    br __num_inext_mul_min_nonpos_%out_ok -> L_NUM_I64_NEXT_MUL_MIN_TO_ZERO_%out_ok, L_NUM_I64_NEXT_MUL_OVERFLOW_%out_ok

L_NUM_I64_NEXT_MUL_MIN_TO_ZERO_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 1
    !__num_inext_mul_min_nonpos_%out_ok
    !__num_inext_mul_min_value_%out_ok
    !__num_inext_mul_abs_rhs_%out_ok
    !__num_inext_mul_abs_ok_%out_ok
    !__num_inext_mul_zero_rhs_%out_ok
    jmp L_NUM_I64_NEXT_MUL_END_%out_ok

L_NUM_I64_NEXT_MUL_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_inext_mul_min_nonpos_%out_ok
    !__num_inext_mul_min_value_%out_ok
    !__num_inext_mul_abs_rhs_%out_ok
    !__num_inext_mul_abs_ok_%out_ok
    !__num_inext_mul_zero_rhs_%out_ok
    jmp L_NUM_I64_NEXT_MUL_END_%out_ok

L_NUM_I64_NEXT_MUL_ZERO_RHS_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_inext_mul_zero_rhs_%out_ok

L_NUM_I64_NEXT_MUL_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_NEXT_MULTIPLE_OF %out_value, %value, %rhs
    EXPAND NUM_I64_CHECKED_NEXT_MULTIPLE_OF __num_inext_mul_direct_ok_%out_value, %out_value, %value, %rhs
