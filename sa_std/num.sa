[MACRO] NUM_U32_SWAP_BYTES %out_value, %value
    __num_u32_swap_b0_%out_value = and %value, 255
    __num_u32_swap_b1_raw_%out_value = lshr %value, 8
    __num_u32_swap_b1_%out_value = and __num_u32_swap_b1_raw_%out_value, 255
    __num_u32_swap_b2_raw_%out_value = lshr %value, 16
    __num_u32_swap_b2_%out_value = and __num_u32_swap_b2_raw_%out_value, 255
    __num_u32_swap_b3_raw_%out_value = lshr %value, 24
    __num_u32_swap_b3_%out_value = and __num_u32_swap_b3_raw_%out_value, 255
    __num_u32_swap_s0_%out_value = shl __num_u32_swap_b0_%out_value, 24
    __num_u32_swap_s1_%out_value = shl __num_u32_swap_b1_%out_value, 16
    __num_u32_swap_s2_%out_value = shl __num_u32_swap_b2_%out_value, 8
    __num_u32_swap_01_%out_value = or __num_u32_swap_s0_%out_value, __num_u32_swap_s1_%out_value
    __num_u32_swap_23_%out_value = or __num_u32_swap_s2_%out_value, __num_u32_swap_b3_%out_value
    %out_value = or __num_u32_swap_01_%out_value, __num_u32_swap_23_%out_value
    !__num_u32_swap_23_%out_value
    !__num_u32_swap_01_%out_value
    !__num_u32_swap_s2_%out_value
    !__num_u32_swap_s1_%out_value
    !__num_u32_swap_s0_%out_value
    !__num_u32_swap_b3_%out_value
    !__num_u32_swap_b3_raw_%out_value
    !__num_u32_swap_b2_%out_value
    !__num_u32_swap_b2_raw_%out_value
    !__num_u32_swap_b1_%out_value
    !__num_u32_swap_b1_raw_%out_value
    !__num_u32_swap_b0_%out_value
[END_MACRO]

