    !__num_irem_over_%out_ok
    !__num_irem_rhs_neg_one_%out_ok
    !__num_irem_lhs_min_%out_ok
    !__num_irem_zero_%out_ok
    jmp L_NUM_I64_REM_END_%out_ok

L_NUM_I64_REM_ZERO_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_irem_zero_%out_ok

L_NUM_I64_REM_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_CHECKED_MUL %out_ok, %out_value, %lhs, %rhs
    __num_imul_rhs_zero_%out_ok = eq %rhs, 0
    br __num_imul_rhs_zero_%out_ok -> L_NUM_I64_MUL_ZERO_%out_ok, L_NUM_I64_MUL_MIN_CHECK_%out_ok

L_NUM_I64_MUL_MIN_CHECK_%out_ok:
    __num_imul_lhs_min_%out_ok = eq %lhs, NUM_I64_MIN
    __num_imul_rhs_min_%out_ok = eq %rhs, NUM_I64_MIN
    __num_imul_lhs_neg_one_%out_ok = eq %lhs, -1
    __num_imul_rhs_neg_one_%out_ok = eq %rhs, -1
    __num_imul_lhs_min_rhs_neg_%out_ok = and __num_imul_lhs_min_%out_ok, __num_imul_rhs_neg_one_%out_ok
    __num_imul_rhs_min_lhs_neg_%out_ok = and __num_imul_rhs_min_%out_ok, __num_imul_lhs_neg_one_%out_ok
    __num_imul_min_over_%out_ok = or __num_imul_lhs_min_rhs_neg_%out_ok, __num_imul_rhs_min_lhs_neg_%out_ok
    br __num_imul_min_over_%out_ok -> L_NUM_I64_MUL_OVERFLOW_%out_ok, L_NUM_I64_MUL_COMPUTE_%out_ok

L_NUM_I64_MUL_COMPUTE_%out_ok:
    __num_imul_product_%out_ok = mul %lhs, %rhs
    __num_imul_roundtrip_%out_ok = sdiv __num_imul_product_%out_ok, %rhs
    __num_imul_ok_%out_ok = eq __num_imul_roundtrip_%out_ok, %lhs
    br __num_imul_ok_%out_ok -> L_NUM_I64_MUL_OK_%out_ok, L_NUM_I64_MUL_COMPUTE_OVERFLOW_%out_ok

L_NUM_I64_MUL_OK_%out_ok:
    %out_value = add __num_imul_product_%out_ok, 0
    %out_ok = add 0, 1
    !__num_imul_ok_%out_ok
    !__num_imul_roundtrip_%out_ok
    !__num_imul_product_%out_ok
    !__num_imul_min_over_%out_ok
    !__num_imul_rhs_min_lhs_neg_%out_ok
    !__num_imul_lhs_min_rhs_neg_%out_ok
    !__num_imul_rhs_neg_one_%out_ok
    !__num_imul_lhs_neg_one_%out_ok
    !__num_imul_rhs_min_%out_ok
    !__num_imul_lhs_min_%out_ok
    !__num_imul_rhs_zero_%out_ok
    jmp L_NUM_I64_MUL_END_%out_ok

L_NUM_I64_MUL_COMPUTE_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_imul_ok_%out_ok
    !__num_imul_roundtrip_%out_ok
    !__num_imul_product_%out_ok
    !__num_imul_min_over_%out_ok
    !__num_imul_rhs_min_lhs_neg_%out_ok
    !__num_imul_lhs_min_rhs_neg_%out_ok
    !__num_imul_rhs_neg_one_%out_ok
    !__num_imul_lhs_neg_one_%out_ok
    !__num_imul_rhs_min_%out_ok
    !__num_imul_lhs_min_%out_ok
    !__num_imul_rhs_zero_%out_ok
    jmp L_NUM_I64_MUL_END_%out_ok

L_NUM_I64_MUL_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_imul_min_over_%out_ok
    !__num_imul_rhs_min_lhs_neg_%out_ok
    !__num_imul_lhs_min_rhs_neg_%out_ok
    !__num_imul_rhs_neg_one_%out_ok
    !__num_imul_lhs_neg_one_%out_ok
    !__num_imul_rhs_min_%out_ok
    !__num_imul_lhs_min_%out_ok
    !__num_imul_rhs_zero_%out_ok
    jmp L_NUM_I64_MUL_END_%out_ok

L_NUM_I64_MUL_ZERO_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 1
    !__num_imul_rhs_zero_%out_ok

L_NUM_I64_MUL_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_CHECKED_SHL %out_ok, %out_value, %value, %shift
    __num_ishl_ok_%out_ok = ult %shift, NUM_I64_BITS
    br __num_ishl_ok_%out_ok -> L_NUM_I64_SHL_OK_%out_ok, L_NUM_I64_SHL_OVER_%out_ok

L_NUM_I64_SHL_OK_%out_ok:
    %out_value = shl %value, %shift
    %out_ok = add 0, 1
    !__num_ishl_ok_%out_ok
    jmp L_NUM_I64_SHL_END_%out_ok

L_NUM_I64_SHL_OVER_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
