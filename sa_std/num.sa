[MACRO] NONZERO_SIGNED_MIN_FIELD %out_nz, %left_nz, %right_nz, %field
    __nonzero_signed_min_left_%out_nz = load %left_nz+%field as i64
    __nonzero_signed_min_right_%out_nz = load %right_nz+%field as i64
    __nonzero_signed_min_take_left_%out_nz = sle __nonzero_signed_min_left_%out_nz, __nonzero_signed_min_right_%out_nz
    br __nonzero_signed_min_take_left_%out_nz -> L_NONZERO_SIGNED_MIN_LEFT_%out_nz, L_NONZERO_SIGNED_MIN_RIGHT_%out_nz
L_NONZERO_SIGNED_MIN_LEFT_%out_nz:
