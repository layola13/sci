    __num_iabs_min_%out_ok = eq %value, NUM_I64_MIN
    br __num_iabs_min_%out_ok -> L_NUM_I64_ABS_OVERFLOW_%out_ok, L_NUM_I64_ABS_OK_%out_ok

L_NUM_I64_ABS_OK_%out_ok:
    EXPAND NUM_I64_ABS %out_value, %value
    %out_ok = add 0, 1
    !__num_iabs_min_%out_ok
    jmp L_NUM_I64_ABS_CHECKED_END_%out_ok

L_NUM_I64_ABS_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_iabs_min_%out_ok

L_NUM_I64_ABS_CHECKED_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_SATURATING_ADD %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_ADD __num_isat_add_ok_%out_value, __num_isat_add_value_%out_value, %lhs, %rhs
    br __num_isat_add_ok_%out_value -> L_NUM_I64_SAT_ADD_OK_%out_value, L_NUM_I64_SAT_ADD_OVERFLOW_%out_value

L_NUM_I64_SAT_ADD_OK_%out_value:
    %out_value = add __num_isat_add_value_%out_value, 0
    !__num_isat_add_value_%out_value
    !__num_isat_add_ok_%out_value
    jmp L_NUM_I64_SAT_ADD_END_%out_value

L_NUM_I64_SAT_ADD_OVERFLOW_%out_value:
    __num_isat_add_rhs_pos_%out_value = sgt %rhs, 0
    br __num_isat_add_rhs_pos_%out_value -> L_NUM_I64_SAT_ADD_MAX_%out_value, L_NUM_I64_SAT_ADD_MIN_%out_value

L_NUM_I64_SAT_ADD_MAX_%out_value:
    %out_value = add 0, NUM_I64_MAX
    !__num_isat_add_rhs_pos_%out_value
    !__num_isat_add_value_%out_value
    !__num_isat_add_ok_%out_value
    jmp L_NUM_I64_SAT_ADD_END_%out_value

L_NUM_I64_SAT_ADD_MIN_%out_value:
    %out_value = add 0, NUM_I64_MIN
    !__num_isat_add_rhs_pos_%out_value
    !__num_isat_add_value_%out_value
    !__num_isat_add_ok_%out_value

L_NUM_I64_SAT_ADD_END_%out_value:
