[MACRO] NUM_I64_ABS_DIFF %out_value, %lhs, %rhs
    __num_iabsdiff_left_%out_value = sge %lhs, %rhs
    br __num_iabsdiff_left_%out_value -> L_NUM_I64_ABS_DIFF_LHS_%out_value, L_NUM_I64_ABS_DIFF_RHS_%out_value

L_NUM_I64_ABS_DIFF_LHS_%out_value:
    %out_value = sub %lhs, %rhs
    !__num_iabsdiff_left_%out_value
    jmp L_NUM_I64_ABS_DIFF_END_%out_value

L_NUM_I64_ABS_DIFF_RHS_%out_value:
    %out_value = sub %rhs, %lhs
    !__num_iabsdiff_left_%out_value

L_NUM_I64_ABS_DIFF_END_%out_value:
[END_MACRO]

[MACRO] NUM_I64_CHECKED_ADD %out_ok, %out_value, %lhs, %rhs
    __num_iadd_sum_%out_ok = add %lhs, %rhs
    __num_iadd_rhs_pos_%out_ok = sgt %rhs, 0
    __num_iadd_rhs_neg_%out_ok = slt %rhs, 0
    __num_iadd_sum_lt_lhs_%out_ok = slt __num_iadd_sum_%out_ok, %lhs
    __num_iadd_sum_gt_lhs_%out_ok = sgt __num_iadd_sum_%out_ok, %lhs
    __num_iadd_over_pos_%out_ok = and __num_iadd_rhs_pos_%out_ok, __num_iadd_sum_lt_lhs_%out_ok
    __num_iadd_over_neg_%out_ok = and __num_iadd_rhs_neg_%out_ok, __num_iadd_sum_gt_lhs_%out_ok
    __num_iadd_overflow_%out_ok = or __num_iadd_over_pos_%out_ok, __num_iadd_over_neg_%out_ok
    br __num_iadd_overflow_%out_ok -> L_NUM_I64_ADD_OVERFLOW_%out_ok, L_NUM_I64_ADD_OK_%out_ok

L_NUM_I64_ADD_OK_%out_ok:
    %out_value = add __num_iadd_sum_%out_ok, 0
    %out_ok = add 0, 1
    !__num_iadd_overflow_%out_ok
    !__num_iadd_over_neg_%out_ok
    !__num_iadd_over_pos_%out_ok
    !__num_iadd_sum_gt_lhs_%out_ok
    !__num_iadd_sum_lt_lhs_%out_ok
    !__num_iadd_rhs_neg_%out_ok
    !__num_iadd_rhs_pos_%out_ok
    !__num_iadd_sum_%out_ok
    jmp L_NUM_I64_ADD_END_%out_ok

L_NUM_I64_ADD_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_iadd_overflow_%out_ok
    !__num_iadd_over_neg_%out_ok
    !__num_iadd_over_pos_%out_ok
    !__num_iadd_sum_gt_lhs_%out_ok
    !__num_iadd_sum_lt_lhs_%out_ok
    !__num_iadd_rhs_neg_%out_ok
    !__num_iadd_rhs_pos_%out_ok
    !__num_iadd_sum_%out_ok

L_NUM_I64_ADD_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_CHECKED_SUB %out_ok, %out_value, %lhs, %rhs
    __num_isub_diff_%out_ok = sub %lhs, %rhs
    __num_isub_rhs_pos_%out_ok = sgt %rhs, 0
    __num_isub_rhs_neg_%out_ok = slt %rhs, 0
    __num_isub_diff_gt_lhs_%out_ok = sgt __num_isub_diff_%out_ok, %lhs
    __num_isub_diff_lt_lhs_%out_ok = slt __num_isub_diff_%out_ok, %lhs
    __num_isub_over_pos_%out_ok = and __num_isub_rhs_pos_%out_ok, __num_isub_diff_gt_lhs_%out_ok
    __num_isub_over_neg_%out_ok = and __num_isub_rhs_neg_%out_ok, __num_isub_diff_lt_lhs_%out_ok
    __num_isub_overflow_%out_ok = or __num_isub_over_pos_%out_ok, __num_isub_over_neg_%out_ok
    br __num_isub_overflow_%out_ok -> L_NUM_I64_SUB_OVERFLOW_%out_ok, L_NUM_I64_SUB_OK_%out_ok

L_NUM_I64_SUB_OK_%out_ok:
    %out_value = add __num_isub_diff_%out_ok, 0
    %out_ok = add 0, 1
    !__num_isub_overflow_%out_ok
    !__num_isub_over_neg_%out_ok
    !__num_isub_over_pos_%out_ok
    !__num_isub_diff_lt_lhs_%out_ok
    !__num_isub_diff_gt_lhs_%out_ok
    !__num_isub_rhs_neg_%out_ok
    !__num_isub_rhs_pos_%out_ok
    !__num_isub_diff_%out_ok
    jmp L_NUM_I64_SUB_END_%out_ok

L_NUM_I64_SUB_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_isub_overflow_%out_ok
    !__num_isub_over_neg_%out_ok
    !__num_isub_over_pos_%out_ok
    !__num_isub_diff_lt_lhs_%out_ok
    !__num_isub_diff_gt_lhs_%out_ok
    !__num_isub_rhs_neg_%out_ok
    !__num_isub_rhs_pos_%out_ok
    !__num_isub_diff_%out_ok

L_NUM_I64_SUB_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_CHECKED_DIV %out_ok, %out_value, %lhs, %rhs
    __num_idiv_zero_%out_ok = eq %rhs, 0
    br __num_idiv_zero_%out_ok -> L_NUM_I64_DIV_ZERO_%out_ok, L_NUM_I64_DIV_MIN_CHECK_%out_ok

L_NUM_I64_DIV_MIN_CHECK_%out_ok:
    __num_idiv_lhs_min_%out_ok = eq %lhs, NUM_I64_MIN
    __num_idiv_rhs_neg_one_%out_ok = eq %rhs, -1
    __num_idiv_over_%out_ok = and __num_idiv_lhs_min_%out_ok, __num_idiv_rhs_neg_one_%out_ok
    br __num_idiv_over_%out_ok -> L_NUM_I64_DIV_OVERFLOW_%out_ok, L_NUM_I64_DIV_OK_%out_ok

L_NUM_I64_DIV_OK_%out_ok:
    %out_value = sdiv %lhs, %rhs
    %out_ok = add 0, 1
    !__num_idiv_over_%out_ok
    !__num_idiv_rhs_neg_one_%out_ok
    !__num_idiv_lhs_min_%out_ok
    !__num_idiv_zero_%out_ok
    jmp L_NUM_I64_DIV_END_%out_ok

L_NUM_I64_DIV_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_idiv_over_%out_ok
    !__num_idiv_rhs_neg_one_%out_ok
    !__num_idiv_lhs_min_%out_ok
    !__num_idiv_zero_%out_ok
    jmp L_NUM_I64_DIV_END_%out_ok

L_NUM_I64_DIV_ZERO_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_idiv_zero_%out_ok

L_NUM_I64_DIV_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_CHECKED_REM %out_ok, %out_value, %lhs, %rhs
    __num_irem_zero_%out_ok = eq %rhs, 0
    br __num_irem_zero_%out_ok -> L_NUM_I64_REM_ZERO_%out_ok, L_NUM_I64_REM_MIN_CHECK_%out_ok

L_NUM_I64_REM_MIN_CHECK_%out_ok:
    __num_irem_lhs_min_%out_ok = eq %lhs, NUM_I64_MIN
    __num_irem_rhs_neg_one_%out_ok = eq %rhs, -1
    __num_irem_over_%out_ok = and __num_irem_lhs_min_%out_ok, __num_irem_rhs_neg_one_%out_ok
    br __num_irem_over_%out_ok -> L_NUM_I64_REM_OVERFLOW_%out_ok, L_NUM_I64_REM_OK_%out_ok

L_NUM_I64_REM_OK_%out_ok:
    %out_value = srem %lhs, %rhs
    %out_ok = add 0, 1
    !__num_irem_over_%out_ok
    !__num_irem_rhs_neg_one_%out_ok
    !__num_irem_lhs_min_%out_ok
    !__num_irem_zero_%out_ok
