[END_MACRO]

[MACRO] NUM_U64_CHECKED_NEXT_POWER_OF_TWO %out_ok, %out_value, %value
    __num_np_small_%out_ok = ule %value, 1
    br __num_np_small_%out_ok -> L_NUM_U64_NP_SMALL_%out_ok, L_NUM_U64_NP_INIT_%out_ok

L_NUM_U64_NP_SMALL_%out_ok:
    %out_value = add 0, 1
    %out_ok = add 0, 1
    !__num_np_small_%out_ok
    jmp L_NUM_U64_NP_END_%out_ok

L_NUM_U64_NP_INIT_%out_ok:
    __num_np_pow_slot_%out_ok = stack_alloc 8
    store __num_np_pow_slot_%out_ok+0, 1 as u64
    jmp L_NUM_U64_NP_HEAD_%out_ok

L_NUM_U64_NP_HEAD_%out_ok:
    __num_np_pow_%out_ok = load __num_np_pow_slot_%out_ok+0 as u64
    __num_np_reached_%out_ok = uge __num_np_pow_%out_ok, %value
    br __num_np_reached_%out_ok -> L_NUM_U64_NP_FOUND_%out_ok, L_NUM_U64_NP_SHIFT_CHECK_%out_ok

L_NUM_U64_NP_SHIFT_CHECK_%out_ok:
    __num_np_high_%out_ok = shl 1, 63
    __num_np_overflow_%out_ok = eq __num_np_pow_%out_ok, __num_np_high_%out_ok
    br __num_np_overflow_%out_ok -> L_NUM_U64_NP_OVERFLOW_%out_ok, L_NUM_U64_NP_SHIFT_%out_ok

L_NUM_U64_NP_SHIFT_%out_ok:
    __num_np_next_%out_ok = shl __num_np_pow_%out_ok, 1
    store __num_np_pow_slot_%out_ok+0, __num_np_next_%out_ok as u64
    !__num_np_next_%out_ok
    !__num_np_overflow_%out_ok
    !__num_np_high_%out_ok
    !__num_np_reached_%out_ok
    !__num_np_pow_%out_ok
    jmp L_NUM_U64_NP_HEAD_%out_ok

L_NUM_U64_NP_FOUND_%out_ok:
    %out_value = add __num_np_pow_%out_ok, 0
    %out_ok = add 0, 1
    !__num_np_reached_%out_ok
    !__num_np_pow_%out_ok
    !__num_np_small_%out_ok
    jmp L_NUM_U64_NP_END_%out_ok

L_NUM_U64_NP_OVERFLOW_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_np_overflow_%out_ok
    !__num_np_high_%out_ok
    !__num_np_reached_%out_ok
    !__num_np_pow_%out_ok
    !__num_np_small_%out_ok

L_NUM_U64_NP_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_NEXT_POWER_OF_TWO %out_value, %value
    EXPAND NUM_U64_CHECKED_NEXT_POWER_OF_TWO __num_np_ok_%out_value, %out_value, %value
    !__num_np_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_UNCHECKED_ADD %out_value, %lhs, %rhs
    %out_value = add %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_UNCHECKED_SUB %out_value, %lhs, %rhs
    %out_value = sub %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_UNCHECKED_MUL %out_value, %lhs, %rhs
    %out_value = mul %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_UNCHECKED_DIV %out_value, %lhs, %rhs
    %out_value = udiv %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_UNCHECKED_REM %out_value, %lhs, %rhs
    %out_value = urem %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_UNCHECKED_SHL %out_value, %value, %shift
    %out_value = shl %value, %shift
[END_MACRO]

[MACRO] NUM_U64_UNCHECKED_SHR %out_value, %value, %shift
    %out_value = lshr %value, %shift
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_ADD %out_value, %out_overflow, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_ADD __num_u64_ov_add_ok_%out_value, __num_u64_ov_add_value_%out_value, %lhs, %rhs
    EXPAND NUM_U64_WRAPPING_ADD %out_value, %lhs, %rhs
    %out_overflow = eq __num_u64_ov_add_ok_%out_value, 0
    !__num_u64_ov_add_value_%out_value
    !__num_u64_ov_add_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_SUB %out_value, %out_overflow, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_SUB __num_u64_ov_sub_ok_%out_value, __num_u64_ov_sub_value_%out_value, %lhs, %rhs
    EXPAND NUM_U64_WRAPPING_SUB %out_value, %lhs, %rhs
    %out_overflow = eq __num_u64_ov_sub_ok_%out_value, 0
    !__num_u64_ov_sub_value_%out_value
    !__num_u64_ov_sub_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_MUL %out_value, %out_overflow, %lhs, %rhs
    EXPAND NUM_U64_CHECKED_MUL __num_u64_ov_mul_ok_%out_value, __num_u64_ov_mul_value_%out_value, %lhs, %rhs
    EXPAND NUM_U64_WRAPPING_MUL %out_value, %lhs, %rhs
    %out_overflow = eq __num_u64_ov_mul_ok_%out_value, 0
    !__num_u64_ov_mul_value_%out_value
    !__num_u64_ov_mul_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_SHL %out_value, %out_overflow, %value, %shift
    EXPAND NUM_U64_WRAPPING_SHL %out_value, %value, %shift
    %out_overflow = uge %shift, NUM_U64_BITS
[END_MACRO]

[MACRO] NUM_U64_OVERFLOWING_SHR %out_value, %out_overflow, %value, %shift
    EXPAND NUM_U64_WRAPPING_SHR %out_value, %value, %shift
    %out_overflow = uge %shift, NUM_U64_BITS
[END_MACRO]

[MACRO] NUM_U64_CARRYING_ADD %out_value, %out_carry, %lhs, %rhs, %carry
    EXPAND NUM_U64_OVERFLOWING_ADD __num_u64_cadd_sum_%out_value, __num_u64_cadd_over1_%out_value, %lhs, %rhs
    __num_u64_cadd_carry_bit_%out_value = ne %carry, 0
    EXPAND NUM_U64_OVERFLOWING_ADD %out_value, __num_u64_cadd_over2_%out_value, __num_u64_cadd_sum_%out_value, __num_u64_cadd_carry_bit_%out_value
    %out_carry = or __num_u64_cadd_over1_%out_value, __num_u64_cadd_over2_%out_value
    !__num_u64_cadd_over2_%out_value
    !__num_u64_cadd_carry_bit_%out_value
    !__num_u64_cadd_over1_%out_value
    !__num_u64_cadd_sum_%out_value
[END_MACRO]

[MACRO] NUM_U64_BORROWING_SUB %out_value, %out_borrow, %lhs, %rhs, %borrow
    EXPAND NUM_U64_OVERFLOWING_SUB __num_u64_bsub_diff_%out_value, __num_u64_bsub_over1_%out_value, %lhs, %rhs
    __num_u64_bsub_borrow_bit_%out_value = ne %borrow, 0
    EXPAND NUM_U64_OVERFLOWING_SUB %out_value, __num_u64_bsub_over2_%out_value, __num_u64_bsub_diff_%out_value, __num_u64_bsub_borrow_bit_%out_value
    %out_borrow = or __num_u64_bsub_over1_%out_value, __num_u64_bsub_over2_%out_value
    !__num_u64_bsub_over2_%out_value
    !__num_u64_bsub_borrow_bit_%out_value
    !__num_u64_bsub_over1_%out_value
    !__num_u64_bsub_diff_%out_value
[END_MACRO]

[MACRO] NUM_U64_DIV_EUCLID %out_value, %lhs, %rhs
    %out_value = udiv %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_REM_EUCLID %out_value, %lhs, %rhs
    %out_value = urem %lhs, %rhs
[END_MACRO]

[MACRO] NUM_U64_IS_MULTIPLE_OF %out_bool, %value, %rhs
    __num_u64_multiple_zero_rhs_%out_bool = eq %rhs, 0
    br __num_u64_multiple_zero_rhs_%out_bool -> L_NUM_U64_MULTIPLE_ZERO_RHS_%out_bool, L_NUM_U64_MULTIPLE_DIV_%out_bool

L_NUM_U64_MULTIPLE_DIV_%out_bool:
    __num_u64_multiple_rem_%out_bool = urem %value, %rhs
    %out_bool = eq __num_u64_multiple_rem_%out_bool, 0
    !__num_u64_multiple_rem_%out_bool
    !__num_u64_multiple_zero_rhs_%out_bool
    jmp L_NUM_U64_MULTIPLE_END_%out_bool

L_NUM_U64_MULTIPLE_ZERO_RHS_%out_bool:
    %out_bool = eq %value, 0
    !__num_u64_multiple_zero_rhs_%out_bool

L_NUM_U64_MULTIPLE_END_%out_bool:
[END_MACRO]

[MACRO] NUM_U64_CHECKED_NEXT_MULTIPLE_OF %out_ok, %out_value, %value, %rhs
    __num_u64_next_mul_zero_rhs_%out_ok = eq %rhs, 0
    br __num_u64_next_mul_zero_rhs_%out_ok -> L_NUM_U64_NEXT_MUL_ZERO_RHS_%out_ok, L_NUM_U64_NEXT_MUL_REM_%out_ok

L_NUM_U64_NEXT_MUL_REM_%out_ok:
    __num_u64_next_mul_rem_%out_ok = urem %value, %rhs
    __num_u64_next_mul_aligned_%out_ok = eq __num_u64_next_mul_rem_%out_ok, 0
    br __num_u64_next_mul_aligned_%out_ok -> L_NUM_U64_NEXT_MUL_ALIGNED_%out_ok, L_NUM_U64_NEXT_MUL_ADD_%out_ok

L_NUM_U64_NEXT_MUL_ADD_%out_ok:
    __num_u64_next_mul_delta_%out_ok = sub %rhs, __num_u64_next_mul_rem_%out_ok
    EXPAND NUM_U64_CHECKED_ADD %out_ok, %out_value, %value, __num_u64_next_mul_delta_%out_ok
    !__num_u64_next_mul_delta_%out_ok
    !__num_u64_next_mul_aligned_%out_ok
    !__num_u64_next_mul_rem_%out_ok
    !__num_u64_next_mul_zero_rhs_%out_ok
    jmp L_NUM_U64_NEXT_MUL_END_%out_ok

L_NUM_U64_NEXT_MUL_ALIGNED_%out_ok:
    %out_value = add %value, 0
    %out_ok = add 0, 1
    !__num_u64_next_mul_aligned_%out_ok
    !__num_u64_next_mul_rem_%out_ok
    !__num_u64_next_mul_zero_rhs_%out_ok
    jmp L_NUM_U64_NEXT_MUL_END_%out_ok

L_NUM_U64_NEXT_MUL_ZERO_RHS_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_u64_next_mul_zero_rhs_%out_ok

L_NUM_U64_NEXT_MUL_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_NEXT_MULTIPLE_OF %out_value, %value, %rhs
    EXPAND NUM_U64_CHECKED_NEXT_MULTIPLE_OF __num_u64_next_mul_ok_%out_value, %out_value, %value, %rhs
    !__num_u64_next_mul_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_DIV_CEIL %out_value, %value, %rhs
    __num_u64_div_ceil_q_%out_value = udiv %value, %rhs
    __num_u64_div_ceil_r_%out_value = urem %value, %rhs
    __num_u64_div_ceil_has_rem_%out_value = ne __num_u64_div_ceil_r_%out_value, 0
    %out_value = add __num_u64_div_ceil_q_%out_value, __num_u64_div_ceil_has_rem_%out_value
    !__num_u64_div_ceil_has_rem_%out_value
    !__num_u64_div_ceil_r_%out_value
    !__num_u64_div_ceil_q_%out_value
[END_MACRO]

[MACRO] NUM_U64_CHECKED_ILOG2 %out_ok, %out_value, %value
    __num_u64_ilog2_zero_%out_ok = eq %value, 0
    br __num_u64_ilog2_zero_%out_ok -> L_NUM_U64_ILOG2_NONE_%out_ok, L_NUM_U64_ILOG2_SOME_%out_ok

L_NUM_U64_ILOG2_SOME_%out_ok:
    EXPAND NUM_U64_LEADING_ZEROS __num_u64_ilog2_lz_%out_ok, %value
    %out_value = sub 63, __num_u64_ilog2_lz_%out_ok
    %out_ok = add 0, 1
    !__num_u64_ilog2_lz_%out_ok
    !__num_u64_ilog2_zero_%out_ok
    jmp L_NUM_U64_ILOG2_END_%out_ok

L_NUM_U64_ILOG2_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_u64_ilog2_zero_%out_ok

L_NUM_U64_ILOG2_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_ILOG2 %out_value, %value
    EXPAND NUM_U64_CHECKED_ILOG2 __num_u64_ilog2_ok_%out_value, %out_value, %value
    !__num_u64_ilog2_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_CHECKED_ILOG %out_ok, %out_value, %value, %base
    __num_u64_ilog_value_zero_%out_ok = eq %value, 0
    __num_u64_ilog_base_small_%out_ok = ult %base, 2
    __num_u64_ilog_invalid_%out_ok = or __num_u64_ilog_value_zero_%out_ok, __num_u64_ilog_base_small_%out_ok
    br __num_u64_ilog_invalid_%out_ok -> L_NUM_U64_ILOG_NONE_%out_ok, L_NUM_U64_ILOG_INIT_%out_ok

L_NUM_U64_ILOG_INIT_%out_ok:
    __num_u64_ilog_work_slot_%out_ok = stack_alloc 8
    __num_u64_ilog_count_slot_%out_ok = stack_alloc 8
    store __num_u64_ilog_work_slot_%out_ok+0, %value as u64
    store __num_u64_ilog_count_slot_%out_ok+0, 0 as u64
    jmp L_NUM_U64_ILOG_HEAD_%out_ok

L_NUM_U64_ILOG_HEAD_%out_ok:
    __num_u64_ilog_work_%out_ok = load __num_u64_ilog_work_slot_%out_ok+0 as u64
    __num_u64_ilog_done_%out_ok = ult __num_u64_ilog_work_%out_ok, %base
    br __num_u64_ilog_done_%out_ok -> L_NUM_U64_ILOG_DONE_%out_ok, L_NUM_U64_ILOG_STEP_%out_ok

L_NUM_U64_ILOG_STEP_%out_ok:
    __num_u64_ilog_next_work_%out_ok = udiv __num_u64_ilog_work_%out_ok, %base
    __num_u64_ilog_count_%out_ok = load __num_u64_ilog_count_slot_%out_ok+0 as u64
    __num_u64_ilog_next_count_%out_ok = add __num_u64_ilog_count_%out_ok, 1
    store __num_u64_ilog_work_slot_%out_ok+0, __num_u64_ilog_next_work_%out_ok as u64
    store __num_u64_ilog_count_slot_%out_ok+0, __num_u64_ilog_next_count_%out_ok as u64
    !__num_u64_ilog_next_count_%out_ok
    !__num_u64_ilog_count_%out_ok
    !__num_u64_ilog_next_work_%out_ok
    !__num_u64_ilog_done_%out_ok
    !__num_u64_ilog_work_%out_ok
    jmp L_NUM_U64_ILOG_HEAD_%out_ok

L_NUM_U64_ILOG_DONE_%out_ok:
    %out_value = load __num_u64_ilog_count_slot_%out_ok+0 as u64
    %out_ok = add 0, 1
    !__num_u64_ilog_done_%out_ok
    !__num_u64_ilog_work_%out_ok
    !__num_u64_ilog_invalid_%out_ok
    !__num_u64_ilog_base_small_%out_ok
    !__num_u64_ilog_value_zero_%out_ok
    jmp L_NUM_U64_ILOG_END_%out_ok

L_NUM_U64_ILOG_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_u64_ilog_invalid_%out_ok
    !__num_u64_ilog_base_small_%out_ok
    !__num_u64_ilog_value_zero_%out_ok

L_NUM_U64_ILOG_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U64_ILOG %out_value, %value, %base
    EXPAND NUM_U64_CHECKED_ILOG __num_u64_ilog_ok_%out_value, %out_value, %value, %base
    !__num_u64_ilog_ok_%out_value
[END_MACRO]

[MACRO] NUM_U64_CHECKED_ILOG10 %out_ok, %out_value, %value
    EXPAND NUM_U64_CHECKED_ILOG %out_ok, %out_value, %value, 10
[END_MACRO]

[MACRO] NUM_U64_ILOG10 %out_value, %value
    EXPAND NUM_U64_ILOG %out_value, %value, 10
[END_MACRO]

[MACRO] NUM_I64_IS_POSITIVE %out_bool, %value
    %out_bool = sgt %value, 0
[END_MACRO]

[MACRO] NUM_I64_IS_NEGATIVE %out_bool, %value
