L_NUM_I64_ABS_NEG_%out_value:
    %out_value = sub 0, %value
    !__num_abs_neg_%out_value
    jmp L_NUM_I64_ABS_END_%out_value

L_NUM_I64_ABS_POS_%out_value:
    %out_value = add %value, 0
    !__num_abs_neg_%out_value

L_NUM_I64_ABS_END_%out_value:
[END_MACRO]

[MACRO] NUM_I64_UNSIGNED_ABS %out_value, %value
    __num_uabs_neg_%out_value = slt %value, 0
    br __num_uabs_neg_%out_value -> L_NUM_I64_UNSIGNED_ABS_NEG_%out_value, L_NUM_I64_UNSIGNED_ABS_POS_%out_value

L_NUM_I64_UNSIGNED_ABS_NEG_%out_value:
    %out_value = sub 0, %value
    !__num_uabs_neg_%out_value
