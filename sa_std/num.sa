L_NONZERO_UNSIGNED_MAX_DONE_%out_nz:
    !__nonzero_unsigned_max_right_%out_nz
    !__nonzero_unsigned_max_left_%out_nz
[END_MACRO]

[MACRO] NONZERO_SIGNED_EQ_FIELD %out_bool, %left_nz, %right_nz, %field
    __nonzero_signed_eq_left_%out_bool = load %left_nz+%field as i64
    __nonzero_signed_eq_right_%out_bool = load %right_nz+%field as i64
    %out_bool = eq __nonzero_signed_eq_left_%out_bool, __nonzero_signed_eq_right_%out_bool
    !__nonzero_signed_eq_right_%out_bool
    !__nonzero_signed_eq_left_%out_bool
[END_MACRO]

[MACRO] NONZERO_SIGNED_NE_FIELD %out_bool, %left_nz, %right_nz, %field
