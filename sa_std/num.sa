[END_MACRO]

[MACRO] NUM_I64_CHECKED_ILOG %out_ok, %out_value, %value, %base
    __num_iilog_value_pos_%out_ok = sgt %value, 0
    __num_iilog_base_gt_one_%out_ok = sgt %base, 1
    __num_iilog_valid_%out_ok = and __num_iilog_value_pos_%out_ok, __num_iilog_base_gt_one_%out_ok
    br __num_iilog_valid_%out_ok -> L_NUM_I64_ILOG_COMPUTE_%out_ok, L_NUM_I64_ILOG_NONE_%out_ok

L_NUM_I64_ILOG_COMPUTE_%out_ok:
    EXPAND NUM_U64_CHECKED_ILOG %out_ok, %out_value, %value, %base
    !__num_iilog_valid_%out_ok
    !__num_iilog_base_gt_one_%out_ok
    !__num_iilog_value_pos_%out_ok
    jmp L_NUM_I64_ILOG_END_%out_ok

L_NUM_I64_ILOG_NONE_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__num_iilog_valid_%out_ok
    !__num_iilog_base_gt_one_%out_ok
    !__num_iilog_value_pos_%out_ok

L_NUM_I64_ILOG_END_%out_ok:
[END_MACRO]

[MACRO] NUM_I64_ILOG %out_value, %value, %base
