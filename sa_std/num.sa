[MACRO] NUM_I64_CHECKED_SHR %out_ok, %out_value, %value, %shift
    __num_ishr_ok_%out_ok = ult %shift, NUM_I64_BITS
    br __num_ishr_ok_%out_ok -> L_NUM_I64_SHR_OK_%out_ok, L_NUM_I64_SHR_OVER_%out_ok

