    __num_u32_be_b0_%out_ok = lshr %value, 24
    __num_u32_be_b1_raw_%out_ok = lshr %value, 16
    __num_u32_be_b1_%out_ok = and __num_u32_be_b1_raw_%out_ok, 255
    __num_u32_be_b2_raw_%out_ok = lshr %value, 8
    __num_u32_be_b2_%out_ok = and __num_u32_be_b2_raw_%out_ok, 255
    __num_u32_be_b3_%out_ok = and %value, 255
    store %dst_ptr+0, __num_u32_be_b0_%out_ok as u8
    store %dst_ptr+1, __num_u32_be_b1_%out_ok as u8
    store %dst_ptr+2, __num_u32_be_b2_%out_ok as u8
    store %dst_ptr+3, __num_u32_be_b3_%out_ok as u8
    %out_ok = add 0, 1
    !__num_u32_be_b3_%out_ok
    !__num_u32_be_b2_%out_ok
    !__num_u32_be_b2_raw_%out_ok
    !__num_u32_be_b1_%out_ok
    !__num_u32_be_b1_raw_%out_ok
    !__num_u32_be_b0_%out_ok
    !__num_u32_be_fits_%out_ok
    jmp L_NUM_U32_WRITE_BE_BYTES_END_%out_ok

L_NUM_U32_WRITE_BE_BYTES_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__num_u32_be_fits_%out_ok

L_NUM_U32_WRITE_BE_BYTES_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U32_WRITE_LE_BYTES %out_ok, %dst_ptr, %dst_len, %value
    __num_u32_le_fits_%out_ok = uge %dst_len, 4
    br __num_u32_le_fits_%out_ok -> L_NUM_U32_WRITE_LE_BYTES_OK_%out_ok, L_NUM_U32_WRITE_LE_BYTES_FAIL_%out_ok

L_NUM_U32_WRITE_LE_BYTES_OK_%out_ok:
    __num_u32_le_b0_%out_ok = and %value, 255
    __num_u32_le_b1_raw_%out_ok = lshr %value, 8
    __num_u32_le_b1_%out_ok = and __num_u32_le_b1_raw_%out_ok, 255
    __num_u32_le_b2_raw_%out_ok = lshr %value, 16
    __num_u32_le_b2_%out_ok = and __num_u32_le_b2_raw_%out_ok, 255
    __num_u32_le_b3_%out_ok = lshr %value, 24
    store %dst_ptr+0, __num_u32_le_b0_%out_ok as u8
    store %dst_ptr+1, __num_u32_le_b1_%out_ok as u8
    store %dst_ptr+2, __num_u32_le_b2_%out_ok as u8
    store %dst_ptr+3, __num_u32_le_b3_%out_ok as u8
    %out_ok = add 0, 1
    !__num_u32_le_b3_%out_ok
    !__num_u32_le_b2_%out_ok
    !__num_u32_le_b2_raw_%out_ok
    !__num_u32_le_b1_%out_ok
    !__num_u32_le_b1_raw_%out_ok
    !__num_u32_le_b0_%out_ok
    !__num_u32_le_fits_%out_ok
    jmp L_NUM_U32_WRITE_LE_BYTES_END_%out_ok

L_NUM_U32_WRITE_LE_BYTES_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__num_u32_le_fits_%out_ok

L_NUM_U32_WRITE_LE_BYTES_END_%out_ok:
[END_MACRO]

[MACRO] NUM_U32_WRITE_NE_BYTES %out_ok, %dst_ptr, %dst_len, %value
    EXPAND NUM_U32_WRITE_LE_BYTES %out_ok, %dst_ptr, %dst_len, %value
[END_MACRO]

[MACRO] NUM_U32_FROM_BE_BYTES %out_value, %src_ptr
    __num_u32_be_b0_%out_value = load %src_ptr+0 as u8
    __num_u32_be_b1_%out_value = load %src_ptr+1 as u8
    __num_u32_be_b2_%out_value = load %src_ptr+2 as u8
    __num_u32_be_b3_%out_value = load %src_ptr+3 as u8
    __num_u32_be_s0_%out_value = shl __num_u32_be_b0_%out_value, 24
    __num_u32_be_s1_%out_value = shl __num_u32_be_b1_%out_value, 16
    __num_u32_be_s2_%out_value = shl __num_u32_be_b2_%out_value, 8
    __num_u32_be_01_%out_value = or __num_u32_be_s0_%out_value, __num_u32_be_s1_%out_value
    __num_u32_be_23_%out_value = or __num_u32_be_s2_%out_value, __num_u32_be_b3_%out_value
    %out_value = or __num_u32_be_01_%out_value, __num_u32_be_23_%out_value
    !__num_u32_be_23_%out_value
    !__num_u32_be_01_%out_value
    !__num_u32_be_s2_%out_value
    !__num_u32_be_s1_%out_value
    !__num_u32_be_s0_%out_value
    !__num_u32_be_b3_%out_value
    !__num_u32_be_b2_%out_value
    !__num_u32_be_b1_%out_value
    !__num_u32_be_b0_%out_value
[END_MACRO]

[MACRO] NUM_U32_FROM_LE_BYTES %out_value, %src_ptr
    __num_u32_le_b0_%out_value = load %src_ptr+0 as u8
    __num_u32_le_b1_%out_value = load %src_ptr+1 as u8
    __num_u32_le_b2_%out_value = load %src_ptr+2 as u8
    __num_u32_le_b3_%out_value = load %src_ptr+3 as u8
    __num_u32_le_s1_%out_value = shl __num_u32_le_b1_%out_value, 8
    __num_u32_le_s2_%out_value = shl __num_u32_le_b2_%out_value, 16
    __num_u32_le_s3_%out_value = shl __num_u32_le_b3_%out_value, 24
    __num_u32_le_01_%out_value = or __num_u32_le_b0_%out_value, __num_u32_le_s1_%out_value
    __num_u32_le_23_%out_value = or __num_u32_le_s2_%out_value, __num_u32_le_s3_%out_value
    %out_value = or __num_u32_le_01_%out_value, __num_u32_le_23_%out_value
    !__num_u32_le_23_%out_value
    !__num_u32_le_01_%out_value
    !__num_u32_le_s3_%out_value
    !__num_u32_le_s2_%out_value
    !__num_u32_le_s1_%out_value
    !__num_u32_le_b3_%out_value
    !__num_u32_le_b2_%out_value
    !__num_u32_le_b1_%out_value
    !__num_u32_le_b0_%out_value
[END_MACRO]

[MACRO] NUM_U32_FROM_NE_BYTES %out_value, %src_ptr
    EXPAND NUM_U32_FROM_LE_BYTES %out_value, %src_ptr
[END_MACRO]

[MACRO] NUM_I32_WRITE_BE_BYTES %out_ok, %dst_ptr, %dst_len, %value
    EXPAND NUM_U32_WRITE_BE_BYTES %out_ok, %dst_ptr, %dst_len, %value
[END_MACRO]

[MACRO] NUM_I32_WRITE_LE_BYTES %out_ok, %dst_ptr, %dst_len, %value
    EXPAND NUM_U32_WRITE_LE_BYTES %out_ok, %dst_ptr, %dst_len, %value
[END_MACRO]

