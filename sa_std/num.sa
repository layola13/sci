    EXPAND NUM_U32_FROM_LE_BYTES __num_i32_from_le_raw_%out_value, %src_ptr
    EXPAND NUM_I32_SIGN_EXTEND %out_value, __num_i32_from_le_raw_%out_value
    !__num_i32_from_le_raw_%out_value
[END_MACRO]

