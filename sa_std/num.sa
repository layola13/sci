[MACRO] WRAPPING_U32_COUNT_ONES %out_count, %src_ptr
    EXPAND WRAPPING_U32_GET __wrapping_u32_count_raw_%out_count, %src_ptr
    __wrapping_u32_count_value_%out_count = and __wrapping_u32_count_raw_%out_count, NUM_U32_MAX
    EXPAND NUM_U64_COUNT_ONES %out_count, __wrapping_u32_count_value_%out_count
    !__wrapping_u32_count_value_%out_count
    !__wrapping_u32_count_raw_%out_count
[END_MACRO]

[MACRO] WRAPPING_U32_COUNT_ZEROS %out_count, %src_ptr
    EXPAND WRAPPING_U32_COUNT_ONES __wrapping_u32_count_ones_%out_count, %src_ptr
    %out_count = sub NUM_U32_BITS, __wrapping_u32_count_ones_%out_count
    !__wrapping_u32_count_ones_%out_count
[END_MACRO]

[MACRO] WRAPPING_U32_LEADING_ZEROS %out_count, %src_ptr
    EXPAND WRAPPING_U32_GET __wrapping_u32_lz_raw_%out_count, %src_ptr
    __wrapping_u32_lz_value_%out_count = and __wrapping_u32_lz_raw_%out_count, NUM_U32_MAX
    EXPAND NUM_U64_LEADING_ZEROS __wrapping_u32_lz64_%out_count, __wrapping_u32_lz_value_%out_count
    %out_count = sub __wrapping_u32_lz64_%out_count, 32
    !__wrapping_u32_lz64_%out_count
    !__wrapping_u32_lz_value_%out_count
    !__wrapping_u32_lz_raw_%out_count
[END_MACRO]

[MACRO] WRAPPING_U32_TRAILING_ZEROS %out_count, %src_ptr
    EXPAND WRAPPING_U32_GET __wrapping_u32_tz_raw_%out_count, %src_ptr
    __wrapping_u32_tz_value_%out_count = and __wrapping_u32_tz_raw_%out_count, NUM_U32_MAX
    __wrapping_u32_tz_zero_%out_count = eq __wrapping_u32_tz_value_%out_count, 0
    br __wrapping_u32_tz_zero_%out_count -> L_WRAPPING_U32_TRAILING_ZEROS_ZERO_%out_count, L_WRAPPING_U32_TRAILING_ZEROS_BODY_%out_count

L_WRAPPING_U32_TRAILING_ZEROS_BODY_%out_count:
    EXPAND NUM_U64_TRAILING_ZEROS %out_count, __wrapping_u32_tz_value_%out_count
    !__wrapping_u32_tz_zero_%out_count
    !__wrapping_u32_tz_value_%out_count
    !__wrapping_u32_tz_raw_%out_count
    jmp L_WRAPPING_U32_TRAILING_ZEROS_END_%out_count

L_WRAPPING_U32_TRAILING_ZEROS_ZERO_%out_count:
    %out_count = add 0, NUM_U32_BITS
    !__wrapping_u32_tz_zero_%out_count
    !__wrapping_u32_tz_value_%out_count
    !__wrapping_u32_tz_raw_%out_count

L_WRAPPING_U32_TRAILING_ZEROS_END_%out_count:
[END_MACRO]

