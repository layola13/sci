[MACRO] NONZERO_UNSIGNED_CHECKED_POW_FIELD %out_ok, %out_nz, %nz, %exp, %field, %max
    __nonzero_unsigned_checked_pow_base_%out_ok = load %nz+%field as u64
    __nonzero_unsigned_checked_pow_acc_slot_%out_ok = stack_alloc 8
    __nonzero_unsigned_checked_pow_idx_slot_%out_ok = stack_alloc 8
    store __nonzero_unsigned_checked_pow_acc_slot_%out_ok+0, 1 as u64
    store __nonzero_unsigned_checked_pow_idx_slot_%out_ok+0, 0 as u64
    jmp L_NONZERO_UNSIGNED_CHECKED_POW_HEAD_%out_ok

L_NONZERO_UNSIGNED_CHECKED_POW_HEAD_%out_ok:
    __nonzero_unsigned_checked_pow_idx_%out_ok = load __nonzero_unsigned_checked_pow_idx_slot_%out_ok+0 as u64
    __nonzero_unsigned_checked_pow_done_%out_ok = eq __nonzero_unsigned_checked_pow_idx_%out_ok, %exp
    br __nonzero_unsigned_checked_pow_done_%out_ok -> L_NONZERO_UNSIGNED_CHECKED_POW_DONE_%out_ok, L_NONZERO_UNSIGNED_CHECKED_POW_BODY_%out_ok

L_NONZERO_UNSIGNED_CHECKED_POW_BODY_%out_ok:
    __nonzero_unsigned_checked_pow_acc_%out_ok = load __nonzero_unsigned_checked_pow_acc_slot_%out_ok+0 as u64
    EXPAND NUM_U64_CHECKED_MUL __nonzero_unsigned_checked_pow_mul_ok_%out_ok, __nonzero_unsigned_checked_pow_mul_value_%out_ok, __nonzero_unsigned_checked_pow_acc_%out_ok, __nonzero_unsigned_checked_pow_base_%out_ok
    __nonzero_unsigned_checked_pow_in_range_%out_ok = ule __nonzero_unsigned_checked_pow_mul_value_%out_ok, %max
    __nonzero_unsigned_checked_pow_step_ok_%out_ok = and __nonzero_unsigned_checked_pow_mul_ok_%out_ok, __nonzero_unsigned_checked_pow_in_range_%out_ok
    br __nonzero_unsigned_checked_pow_step_ok_%out_ok -> L_NONZERO_UNSIGNED_CHECKED_POW_STEP_OK_%out_ok, L_NONZERO_UNSIGNED_CHECKED_POW_OVERFLOW_%out_ok

L_NONZERO_UNSIGNED_CHECKED_POW_STEP_OK_%out_ok:
    __nonzero_unsigned_checked_pow_next_idx_%out_ok = add __nonzero_unsigned_checked_pow_idx_%out_ok, 1
    store __nonzero_unsigned_checked_pow_acc_slot_%out_ok+0, __nonzero_unsigned_checked_pow_mul_value_%out_ok as u64
    store __nonzero_unsigned_checked_pow_idx_slot_%out_ok+0, __nonzero_unsigned_checked_pow_next_idx_%out_ok as u64
    !__nonzero_unsigned_checked_pow_next_idx_%out_ok
    !__nonzero_unsigned_checked_pow_step_ok_%out_ok
    !__nonzero_unsigned_checked_pow_in_range_%out_ok
    !__nonzero_unsigned_checked_pow_mul_value_%out_ok
    !__nonzero_unsigned_checked_pow_mul_ok_%out_ok
    !__nonzero_unsigned_checked_pow_acc_%out_ok
    !__nonzero_unsigned_checked_pow_done_%out_ok
    !__nonzero_unsigned_checked_pow_idx_%out_ok
    jmp L_NONZERO_UNSIGNED_CHECKED_POW_HEAD_%out_ok

L_NONZERO_UNSIGNED_CHECKED_POW_OVERFLOW_%out_ok:
    store %out_nz+%field, 0 as u64
    %out_ok = add 0, 0
    !__nonzero_unsigned_checked_pow_step_ok_%out_ok
    !__nonzero_unsigned_checked_pow_in_range_%out_ok
    !__nonzero_unsigned_checked_pow_mul_value_%out_ok
    !__nonzero_unsigned_checked_pow_mul_ok_%out_ok
    !__nonzero_unsigned_checked_pow_acc_%out_ok
    !__nonzero_unsigned_checked_pow_done_%out_ok
    !__nonzero_unsigned_checked_pow_idx_%out_ok
    jmp L_NONZERO_UNSIGNED_CHECKED_POW_END_%out_ok

L_NONZERO_UNSIGNED_CHECKED_POW_DONE_%out_ok:
    __nonzero_unsigned_checked_pow_result_%out_ok = load __nonzero_unsigned_checked_pow_acc_slot_%out_ok+0 as u64
    store %out_nz+%field, __nonzero_unsigned_checked_pow_result_%out_ok as u64
    %out_ok = add 0, 1
    !__nonzero_unsigned_checked_pow_result_%out_ok
    !__nonzero_unsigned_checked_pow_done_%out_ok
    !__nonzero_unsigned_checked_pow_idx_%out_ok

L_NONZERO_UNSIGNED_CHECKED_POW_END_%out_ok:
    !__nonzero_unsigned_checked_pow_base_%out_ok
[END_MACRO]

[MACRO] NONZERO_UNSIGNED_SATURATING_POW_FIELD %out_nz, %nz, %exp, %field, %max
    __nonzero_unsigned_saturating_pow_base_%out_nz = load %nz+%field as u64
    __nonzero_unsigned_saturating_pow_acc_slot_%out_nz = stack_alloc 8
    __nonzero_unsigned_saturating_pow_idx_slot_%out_nz = stack_alloc 8
    store __nonzero_unsigned_saturating_pow_acc_slot_%out_nz+0, 1 as u64
    store __nonzero_unsigned_saturating_pow_idx_slot_%out_nz+0, 0 as u64
    jmp L_NONZERO_UNSIGNED_SATURATING_POW_HEAD_%out_nz

L_NONZERO_UNSIGNED_SATURATING_POW_HEAD_%out_nz:
    __nonzero_unsigned_saturating_pow_idx_%out_nz = load __nonzero_unsigned_saturating_pow_idx_slot_%out_nz+0 as u64
    __nonzero_unsigned_saturating_pow_done_%out_nz = eq __nonzero_unsigned_saturating_pow_idx_%out_nz, %exp
    br __nonzero_unsigned_saturating_pow_done_%out_nz -> L_NONZERO_UNSIGNED_SATURATING_POW_DONE_%out_nz, L_NONZERO_UNSIGNED_SATURATING_POW_BODY_%out_nz

L_NONZERO_UNSIGNED_SATURATING_POW_BODY_%out_nz:
    __nonzero_unsigned_saturating_pow_acc_%out_nz = load __nonzero_unsigned_saturating_pow_acc_slot_%out_nz+0 as u64
    EXPAND NUM_U64_CHECKED_MUL __nonzero_unsigned_saturating_pow_mul_ok_%out_nz, __nonzero_unsigned_saturating_pow_mul_value_%out_nz, __nonzero_unsigned_saturating_pow_acc_%out_nz, __nonzero_unsigned_saturating_pow_base_%out_nz
    __nonzero_unsigned_saturating_pow_in_range_%out_nz = ule __nonzero_unsigned_saturating_pow_mul_value_%out_nz, %max
    __nonzero_unsigned_saturating_pow_step_ok_%out_nz = and __nonzero_unsigned_saturating_pow_mul_ok_%out_nz, __nonzero_unsigned_saturating_pow_in_range_%out_nz
    br __nonzero_unsigned_saturating_pow_step_ok_%out_nz -> L_NONZERO_UNSIGNED_SATURATING_POW_VALUE_%out_nz, L_NONZERO_UNSIGNED_SATURATING_POW_MAX_%out_nz

L_NONZERO_UNSIGNED_SATURATING_POW_VALUE_%out_nz:
    __nonzero_unsigned_saturating_pow_next_value_%out_nz = add __nonzero_unsigned_saturating_pow_mul_value_%out_nz, 0
    jmp L_NONZERO_UNSIGNED_SATURATING_POW_STORE_%out_nz

L_NONZERO_UNSIGNED_SATURATING_POW_MAX_%out_nz:
    __nonzero_unsigned_saturating_pow_next_value_%out_nz = add 0, %max

L_NONZERO_UNSIGNED_SATURATING_POW_STORE_%out_nz:
    __nonzero_unsigned_saturating_pow_next_idx_%out_nz = add __nonzero_unsigned_saturating_pow_idx_%out_nz, 1
    store __nonzero_unsigned_saturating_pow_acc_slot_%out_nz+0, __nonzero_unsigned_saturating_pow_next_value_%out_nz as u64
    store __nonzero_unsigned_saturating_pow_idx_slot_%out_nz+0, __nonzero_unsigned_saturating_pow_next_idx_%out_nz as u64
    !__nonzero_unsigned_saturating_pow_next_idx_%out_nz
    !__nonzero_unsigned_saturating_pow_next_value_%out_nz
    !__nonzero_unsigned_saturating_pow_step_ok_%out_nz
    !__nonzero_unsigned_saturating_pow_in_range_%out_nz
    !__nonzero_unsigned_saturating_pow_mul_value_%out_nz
    !__nonzero_unsigned_saturating_pow_mul_ok_%out_nz
    !__nonzero_unsigned_saturating_pow_acc_%out_nz
    !__nonzero_unsigned_saturating_pow_done_%out_nz
    !__nonzero_unsigned_saturating_pow_idx_%out_nz
    jmp L_NONZERO_UNSIGNED_SATURATING_POW_HEAD_%out_nz

L_NONZERO_UNSIGNED_SATURATING_POW_DONE_%out_nz:
    __nonzero_unsigned_saturating_pow_result_%out_nz = load __nonzero_unsigned_saturating_pow_acc_slot_%out_nz+0 as u64
    store %out_nz+%field, __nonzero_unsigned_saturating_pow_result_%out_nz as u64
    !__nonzero_unsigned_saturating_pow_result_%out_nz
    !__nonzero_unsigned_saturating_pow_done_%out_nz
    !__nonzero_unsigned_saturating_pow_idx_%out_nz
    !__nonzero_unsigned_saturating_pow_base_%out_nz
[END_MACRO]

[MACRO] NONZERO_SIGNED_CHECKED_POW_FIELD %out_ok, %out_nz, %nz, %exp, %field, %min, %max
    __nonzero_signed_checked_pow_base_%out_ok = load %nz+%field as i64
    __nonzero_signed_checked_pow_acc_slot_%out_ok = stack_alloc 8
    __nonzero_signed_checked_pow_idx_slot_%out_ok = stack_alloc 8
