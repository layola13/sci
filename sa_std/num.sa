[MACRO] NUM_I64_SATURATING_MUL %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_MUL __num_isat_mul_ok_%out_value, __num_isat_mul_value_%out_value, %lhs, %rhs
    br __num_isat_mul_ok_%out_value -> L_NUM_I64_SAT_MUL_OK_%out_value, L_NUM_I64_SAT_MUL_OVERFLOW_%out_value

L_NUM_I64_SAT_MUL_OK_%out_value:
    %out_value = add __num_isat_mul_value_%out_value, 0
    !__num_isat_mul_value_%out_value
    !__num_isat_mul_ok_%out_value
    jmp L_NUM_I64_SAT_MUL_END_%out_value

L_NUM_I64_SAT_MUL_OVERFLOW_%out_value:
    __num_isat_mul_lhs_neg_%out_value = slt %lhs, 0
    __num_isat_mul_rhs_neg_%out_value = slt %rhs, 0
    __num_isat_mul_negative_%out_value = ne __num_isat_mul_lhs_neg_%out_value, __num_isat_mul_rhs_neg_%out_value
    br __num_isat_mul_negative_%out_value -> L_NUM_I64_SAT_MUL_MIN_%out_value, L_NUM_I64_SAT_MUL_MAX_%out_value

L_NUM_I64_SAT_MUL_MAX_%out_value:
    %out_value = add 0, NUM_I64_MAX
    !__num_isat_mul_negative_%out_value
    !__num_isat_mul_rhs_neg_%out_value
    !__num_isat_mul_lhs_neg_%out_value
    !__num_isat_mul_value_%out_value
    !__num_isat_mul_ok_%out_value
    jmp L_NUM_I64_SAT_MUL_END_%out_value

L_NUM_I64_SAT_MUL_MIN_%out_value:
    %out_value = add 0, NUM_I64_MIN
    !__num_isat_mul_negative_%out_value
    !__num_isat_mul_rhs_neg_%out_value
    !__num_isat_mul_lhs_neg_%out_value
    !__num_isat_mul_value_%out_value
    !__num_isat_mul_ok_%out_value

L_NUM_I64_SAT_MUL_END_%out_value:
[END_MACRO]

[MACRO] NUM_I64_SATURATING_NEG %out_value, %value
    __num_isat_neg_min_%out_value = eq %value, NUM_I64_MIN
