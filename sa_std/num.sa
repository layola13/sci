    EXPAND NUM_U32_WRITE_NE_BYTES %out_ok, %dst_ptr, %dst_len, %value
[END_MACRO]

[MACRO] NUM_I32_FROM_BE_BYTES %out_value, %src_ptr
    EXPAND NUM_U32_FROM_BE_BYTES __num_i32_from_be_raw_%out_value, %src_ptr
    EXPAND NUM_I32_SIGN_EXTEND %out_value, __num_i32_from_be_raw_%out_value
    !__num_i32_from_be_raw_%out_value
[END_MACRO]

