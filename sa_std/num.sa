[MACRO] NUM_I8_CHECKED_ADD %out_ok, %out_value, %lhs, %rhs
    __num_i8_add_sum_%out_ok = add %lhs, %rhs
    __num_i8_add_ge_min_%out_ok = sge __num_i8_add_sum_%out_ok, NUM_I8_MIN
    __num_i8_add_le_max_%out_ok = sle __num_i8_add_sum_%out_ok, NUM_I8_MAX
    %out_ok = and __num_i8_add_ge_min_%out_ok, __num_i8_add_le_max_%out_ok
