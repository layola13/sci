[MACRO] NUM_I64_SATURATING_SUB %out_value, %lhs, %rhs
    EXPAND NUM_I64_CHECKED_SUB __num_isat_sub_ok_%out_value, __num_isat_sub_value_%out_value, %lhs, %rhs
