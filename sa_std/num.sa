    br __num_i16_se_negative_%out_value -> L_NUM_I16_SIGN_EXTEND_NEG_%out_value, L_NUM_I16_SIGN_EXTEND_POS_%out_value

L_NUM_I16_SIGN_EXTEND_NEG_%out_value:
    %out_value = sub __num_i16_se_masked_%out_value, 65536
    !__num_i16_se_negative_%out_value
    !__num_i16_se_masked_%out_value
    jmp L_NUM_I16_SIGN_EXTEND_END_%out_value

L_NUM_I16_SIGN_EXTEND_POS_%out_value:
    %out_value = add __num_i16_se_masked_%out_value, 0
    !__num_i16_se_negative_%out_value
    !__num_i16_se_masked_%out_value

L_NUM_I16_SIGN_EXTEND_END_%out_value:
[END_MACRO]

[MACRO] NUM_I32_SIGN_EXTEND %out_value, %value
    __num_i32_se_masked_%out_value = and %value, NUM_U32_MAX
    __num_i32_se_negative_%out_value = uge __num_i32_se_masked_%out_value, 2147483648
    br __num_i32_se_negative_%out_value -> L_NUM_I32_SIGN_EXTEND_NEG_%out_value, L_NUM_I32_SIGN_EXTEND_POS_%out_value

L_NUM_I32_SIGN_EXTEND_NEG_%out_value:
    %out_value = sub __num_i32_se_masked_%out_value, 4294967296
