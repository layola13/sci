[MACRO] NUM_I64_CHECKED_NEG %out_ok, %out_value, %value
    __num_ineg_min_%out_ok = eq %value, NUM_I64_MIN
    br __num_ineg_min_%out_ok -> L_NUM_I64_NEG_OVERFLOW_%out_ok, L_NUM_I64_NEG_OK_%out_ok

L_NUM_I64_NEG_OK_%out_ok:
    %out_value = sub 0, %value
    %out_ok = add 0, 1
    !__num_ineg_min_%out_ok
