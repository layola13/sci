    %out_value = add __num_isat_sub_value_%out_value, 0
    !__num_isat_sub_value_%out_value
    !__num_isat_sub_ok_%out_value
    jmp L_NUM_I64_SAT_SUB_END_%out_value

L_NUM_I64_SAT_SUB_OVERFLOW_%out_value:
    __num_isat_sub_rhs_neg_%out_value = slt %rhs, 0
    br __num_isat_sub_rhs_neg_%out_value -> L_NUM_I64_SAT_SUB_MAX_%out_value, L_NUM_I64_SAT_SUB_MIN_%out_value

L_NUM_I64_SAT_SUB_MAX_%out_value:
    %out_value = add 0, NUM_I64_MAX
