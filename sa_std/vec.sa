[MACRO] VEC_TRY_SPLIT_AT_MUT_CHECKED_U64 %out_ok, %out_left, %out_right, %vec_reg, %mid
    EXPAND VEC_AS_MUT_SLICE __vec_split_mut_checked_slice_%out_ok, %vec_reg
