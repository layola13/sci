[END_MACRO]

[MACRO] VEC_PUSH_WITHIN_CAPACITY %out_ok, %vec_reg, %value, %elem_size
    __vec_pwc_view_%out_ok = & %vec_reg
    __vec_pwc_len_%out_ok = load __vec_pwc_view_%out_ok+Vec_len as u64
    __vec_pwc_cap_%out_ok = load __vec_pwc_view_%out_ok+Vec_cap as u64
    __vec_pwc_has_room_%out_ok = ult __vec_pwc_len_%out_ok, __vec_pwc_cap_%out_ok
    br __vec_pwc_has_room_%out_ok -> L_VEC_PWC_HIT_%out_ok, L_VEC_PWC_MISS_%out_ok

L_VEC_PWC_HIT_%out_ok:
    !__vec_pwc_view_%out_ok
    %vec_reg = call @sa_vec_push(^%vec_reg, %value, %elem_size)
    %out_ok = add 0, 1
    !__vec_pwc_has_room_%out_ok
    !__vec_pwc_cap_%out_ok
    !__vec_pwc_len_%out_ok
    jmp L_VEC_PWC_END_%out_ok

L_VEC_PWC_MISS_%out_ok:
    %out_ok = add 0, 0
    !__vec_pwc_has_room_%out_ok
    !__vec_pwc_cap_%out_ok
    !__vec_pwc_len_%out_ok
    !__vec_pwc_view_%out_ok

L_VEC_PWC_END_%out_ok:
[END_MACRO]

[MACRO] VEC_PUSH_WITHIN_CAPACITY_U64 %out_ok, %vec_reg, %value
    EXPAND VEC_PUSH_WITHIN_CAPACITY %out_ok, %vec_reg, %value, 8
[END_MACRO]

[MACRO] VEC_TRY_INSERT %out_ok, %vec_reg, %index, %value, %elem_size
    __vec_insert_view_%out_ok = & %vec_reg
    __vec_insert_len_%out_ok = load __vec_insert_view_%out_ok+Vec_len as u64
    __vec_insert_in_bounds_%out_ok = ule %index, __vec_insert_len_%out_ok
    br __vec_insert_in_bounds_%out_ok -> L_VEC_INSERT_PUSH_%out_ok, L_VEC_INSERT_MISS_%out_ok

L_VEC_INSERT_PUSH_%out_ok:
    !__vec_insert_view_%out_ok
    %vec_reg = call @sa_vec_push(^%vec_reg, 0, %elem_size)
    __vec_insert_view2_%out_ok = & %vec_reg
    __vec_insert_ptr_%out_ok = load __vec_insert_view2_%out_ok+Vec_ptr as ptr
    __vec_insert_pos_slot_%out_ok = stack_alloc 8
    store __vec_insert_pos_slot_%out_ok+0, __vec_insert_len_%out_ok as u64
    jmp L_VEC_INSERT_SHIFT_HEAD_%out_ok

L_VEC_INSERT_SHIFT_HEAD_%out_ok:
    __vec_insert_pos_%out_ok = load __vec_insert_pos_slot_%out_ok+0 as u64
    __vec_insert_more_%out_ok = ugt __vec_insert_pos_%out_ok, %index
    br __vec_insert_more_%out_ok -> L_VEC_INSERT_SHIFT_BODY_%out_ok, L_VEC_INSERT_STORE_%out_ok

L_VEC_INSERT_SHIFT_BODY_%out_ok:
    __vec_insert_prev_%out_ok = sub __vec_insert_pos_%out_ok, 1
    __vec_insert_prev_off_%out_ok = mul __vec_insert_prev_%out_ok, %elem_size
    __vec_insert_pos_off_%out_ok = mul __vec_insert_pos_%out_ok, %elem_size
    __vec_insert_prev_ptr_%out_ok = ptr_add __vec_insert_ptr_%out_ok, __vec_insert_prev_off_%out_ok
    __vec_insert_pos_ptr_%out_ok = ptr_add __vec_insert_ptr_%out_ok, __vec_insert_pos_off_%out_ok
    __vec_insert_move_value_%out_ok = load __vec_insert_prev_ptr_%out_ok+0 as u64
    store __vec_insert_pos_ptr_%out_ok+0, __vec_insert_move_value_%out_ok as u64
    store __vec_insert_pos_slot_%out_ok+0, __vec_insert_prev_%out_ok as u64
    !__vec_insert_move_value_%out_ok
    !__vec_insert_pos_ptr_%out_ok
    !__vec_insert_prev_ptr_%out_ok
    !__vec_insert_pos_off_%out_ok
    !__vec_insert_prev_off_%out_ok
    !__vec_insert_prev_%out_ok
    !__vec_insert_more_%out_ok
    !__vec_insert_pos_%out_ok
    jmp L_VEC_INSERT_SHIFT_HEAD_%out_ok

L_VEC_INSERT_STORE_%out_ok:
    __vec_insert_index_off_%out_ok = mul %index, %elem_size
    __vec_insert_index_ptr_%out_ok = ptr_add __vec_insert_ptr_%out_ok, __vec_insert_index_off_%out_ok
    store __vec_insert_index_ptr_%out_ok+0, %value as u64
    %out_ok = add 0, 1
    !__vec_insert_index_ptr_%out_ok
    !__vec_insert_index_off_%out_ok
    !__vec_insert_more_%out_ok
    !__vec_insert_pos_%out_ok
    !__vec_insert_ptr_%out_ok
    !__vec_insert_view2_%out_ok
    !__vec_insert_in_bounds_%out_ok
    !__vec_insert_len_%out_ok
    jmp L_VEC_INSERT_END_%out_ok

L_VEC_INSERT_MISS_%out_ok:
    %out_ok = add 0, 0
    !__vec_insert_in_bounds_%out_ok
    !__vec_insert_len_%out_ok
    !__vec_insert_view_%out_ok

L_VEC_INSERT_END_%out_ok:
[END_MACRO]

[MACRO] VEC_TRY_INSERT_U64 %out_ok, %vec_reg, %index, %value
    EXPAND VEC_TRY_INSERT %out_ok, %vec_reg, %index, %value, 8
[END_MACRO]

[MACRO] VEC_INSERT %out_ok, %vec_reg, %index, %value, %elem_size
    EXPAND VEC_TRY_INSERT %out_ok, %vec_reg, %index, %value, %elem_size
[END_MACRO]

[MACRO] VEC_INSERT_U64 %out_ok, %vec_reg, %index, %value
