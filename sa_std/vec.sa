    __vec_extract_take_%out_len = ne __vec_extract_pred_%out_len, 0
    br __vec_extract_take_%out_len -> L_VEC_EXTRACT_TAKE_%out_len, L_VEC_EXTRACT_KEEP_%out_len

L_VEC_EXTRACT_TAKE_%out_len:
    EXPAND VEC_PUSH_U64 %out_vec, __vec_extract_value_%out_len
    jmp L_VEC_EXTRACT_NEXT_%out_len

L_VEC_EXTRACT_KEEP_%out_len:
    __vec_extract_write_%out_len = load __vec_extract_write_slot_%out_len+0 as u64
    __vec_extract_write_off_%out_len = mul __vec_extract_write_%out_len, 8
    __vec_extract_write_ptr_%out_len = ptr_add __vec_extract_ptr_%out_len, __vec_extract_write_off_%out_len
    store __vec_extract_write_ptr_%out_len+0, __vec_extract_value_%out_len as u64
    __vec_extract_next_write_%out_len = add __vec_extract_write_%out_len, 1
    store __vec_extract_write_slot_%out_len+0, __vec_extract_next_write_%out_len as u64
    !__vec_extract_next_write_%out_len
    !__vec_extract_write_ptr_%out_len
    !__vec_extract_write_off_%out_len
    !__vec_extract_write_%out_len
    jmp L_VEC_EXTRACT_NEXT_%out_len

L_VEC_EXTRACT_NEXT_%out_len:
    __vec_extract_next_read_%out_len = add __vec_extract_read_%out_len, 1
    store __vec_extract_read_slot_%out_len+0, __vec_extract_next_read_%out_len as u64
    !__vec_extract_next_read_%out_len
    !__vec_extract_take_%out_len
    !__vec_extract_pred_%out_len
    !__vec_extract_value_%out_len
    !__vec_extract_read_ptr_%out_len
    !__vec_extract_read_off_%out_len
    !__vec_extract_done_%out_len
    !__vec_extract_read_%out_len
    jmp L_VEC_EXTRACT_HEAD_%out_len

L_VEC_EXTRACT_DONE_%out_len:
    %out_len = load __vec_extract_write_slot_%out_len+0 as u64
    store __vec_extract_view_%out_len+Vec_len, %out_len as u64
    !__vec_extract_done_%out_len
    !__vec_extract_read_%out_len
    !__vec_extract_len_%out_len
    !__vec_extract_ptr_%out_len
    !__vec_extract_view_%out_len
[END_MACRO]

[MACRO] VEC_DRAIN_U64 %out_ok, %out_vec, %vec_reg, %start, %length
    __vec_drain_view_%out_ok = & %vec_reg
    __vec_drain_ptr_%out_ok = load __vec_drain_view_%out_ok+Vec_ptr as ptr
    __vec_drain_len_%out_ok = load __vec_drain_view_%out_ok+Vec_len as u64
    __vec_drain_read_slot_%out_ok = stack_alloc 8
    __vec_drain_write_slot_%out_ok = stack_alloc 8
    __vec_drain_start_ok_%out_ok = ule %start, __vec_drain_len_%out_ok
    br __vec_drain_start_ok_%out_ok -> L_VEC_DRAIN_LEN_CHECK_%out_ok, L_VEC_DRAIN_MISS_START_%out_ok

L_VEC_DRAIN_LEN_CHECK_%out_ok:
    __vec_drain_remaining_%out_ok = sub __vec_drain_len_%out_ok, %start
    __vec_drain_len_ok_%out_ok = ule %length, __vec_drain_remaining_%out_ok
    br __vec_drain_len_ok_%out_ok -> L_VEC_DRAIN_INIT_%out_ok, L_VEC_DRAIN_MISS_LEN_%out_ok

L_VEC_DRAIN_INIT_%out_ok:
    EXPAND VEC_WITH_CAPACITY_U64 %out_vec, %length
    __vec_drain_end_%out_ok = add %start, %length
    store __vec_drain_read_slot_%out_ok+0, %start as u64
    store __vec_drain_write_slot_%out_ok+0, %start as u64
    !__vec_drain_len_ok_%out_ok
    !__vec_drain_remaining_%out_ok
    !__vec_drain_start_ok_%out_ok
    jmp L_VEC_DRAIN_HEAD_%out_ok

L_VEC_DRAIN_HEAD_%out_ok:
    __vec_drain_read_%out_ok = load __vec_drain_read_slot_%out_ok+0 as u64
    __vec_drain_done_%out_ok = eq __vec_drain_read_%out_ok, __vec_drain_len_%out_ok
    br __vec_drain_done_%out_ok -> L_VEC_DRAIN_DONE_%out_ok, L_VEC_DRAIN_BODY_%out_ok

L_VEC_DRAIN_BODY_%out_ok:
    __vec_drain_read_off_%out_ok = mul __vec_drain_read_%out_ok, 8
    __vec_drain_read_ptr_%out_ok = ptr_add __vec_drain_ptr_%out_ok, __vec_drain_read_off_%out_ok
    __vec_drain_value_%out_ok = load __vec_drain_read_ptr_%out_ok+0 as u64
    __vec_drain_take_%out_ok = ult __vec_drain_read_%out_ok, __vec_drain_end_%out_ok
    br __vec_drain_take_%out_ok -> L_VEC_DRAIN_TAKE_%out_ok, L_VEC_DRAIN_KEEP_%out_ok

L_VEC_DRAIN_TAKE_%out_ok:
    EXPAND VEC_PUSH_U64 %out_vec, __vec_drain_value_%out_ok
    jmp L_VEC_DRAIN_NEXT_%out_ok

L_VEC_DRAIN_KEEP_%out_ok:
    __vec_drain_write_%out_ok = load __vec_drain_write_slot_%out_ok+0 as u64
    __vec_drain_write_off_%out_ok = mul __vec_drain_write_%out_ok, 8
    __vec_drain_write_ptr_%out_ok = ptr_add __vec_drain_ptr_%out_ok, __vec_drain_write_off_%out_ok
    store __vec_drain_write_ptr_%out_ok+0, __vec_drain_value_%out_ok as u64
    __vec_drain_next_write_%out_ok = add __vec_drain_write_%out_ok, 1
    store __vec_drain_write_slot_%out_ok+0, __vec_drain_next_write_%out_ok as u64
    !__vec_drain_next_write_%out_ok
    !__vec_drain_write_ptr_%out_ok
    !__vec_drain_write_off_%out_ok
    !__vec_drain_write_%out_ok
    jmp L_VEC_DRAIN_NEXT_%out_ok

L_VEC_DRAIN_NEXT_%out_ok:
    __vec_drain_next_read_%out_ok = add __vec_drain_read_%out_ok, 1
    store __vec_drain_read_slot_%out_ok+0, __vec_drain_next_read_%out_ok as u64
    !__vec_drain_next_read_%out_ok
    !__vec_drain_take_%out_ok
    !__vec_drain_value_%out_ok
    !__vec_drain_read_ptr_%out_ok
    !__vec_drain_read_off_%out_ok
    !__vec_drain_done_%out_ok
    !__vec_drain_read_%out_ok
    jmp L_VEC_DRAIN_HEAD_%out_ok

L_VEC_DRAIN_DONE_%out_ok:
    __vec_drain_new_len_%out_ok = sub __vec_drain_len_%out_ok, %length
    store __vec_drain_view_%out_ok+Vec_len, __vec_drain_new_len_%out_ok as u64
    %out_ok = add 0, 1
    !__vec_drain_new_len_%out_ok
    !__vec_drain_done_%out_ok
    !__vec_drain_read_%out_ok
    !__vec_drain_end_%out_ok
    !__vec_drain_len_%out_ok
    !__vec_drain_ptr_%out_ok
    !__vec_drain_view_%out_ok
    jmp L_VEC_DRAIN_END_%out_ok

L_VEC_DRAIN_MISS_LEN_%out_ok:
    EXPAND VEC_WITH_CAPACITY_U64 %out_vec, 0
    %out_ok = add 0, 0
    !__vec_drain_len_ok_%out_ok
    !__vec_drain_remaining_%out_ok
    !__vec_drain_start_ok_%out_ok
    !__vec_drain_len_%out_ok
    !__vec_drain_ptr_%out_ok
    !__vec_drain_view_%out_ok
    jmp L_VEC_DRAIN_END_%out_ok

L_VEC_DRAIN_MISS_START_%out_ok:
    EXPAND VEC_WITH_CAPACITY_U64 %out_vec, 0
    %out_ok = add 0, 0
    !__vec_drain_start_ok_%out_ok
    !__vec_drain_len_%out_ok
    !__vec_drain_ptr_%out_ok
    !__vec_drain_view_%out_ok

L_VEC_DRAIN_END_%out_ok:
[END_MACRO]

[MACRO] VEC_SPLICE_U64 %out_ok, %out_vec, %vec_reg, %start, %length, %replacement_slice
    EXPAND VEC_DRAIN_U64 %out_ok, %out_vec, %vec_reg, %start, %length
    __vec_splice_hit_%out_ok = ne %out_ok, 0
    br __vec_splice_hit_%out_ok -> L_VEC_SPLICE_INIT_%out_ok, L_VEC_SPLICE_MISS_%out_ok

L_VEC_SPLICE_INIT_%out_ok:
    __vec_splice_view_%out_ok = & %vec_reg
    __vec_splice_len_%out_ok = load __vec_splice_view_%out_ok+Vec_len as u64
    __vec_splice_repl_len_%out_ok = load %replacement_slice+Slice_len as u64
    __vec_splice_suffix_len_%out_ok = sub __vec_splice_len_%out_ok, %start
    __vec_splice_new_len_%out_ok = add __vec_splice_len_%out_ok, __vec_splice_repl_len_%out_ok
    EXPAND VEC_WITH_CAPACITY_U64 __vec_splice_new_%out_ok, __vec_splice_new_len_%out_ok
    EXPAND VEC_AS_SLICE __vec_splice_current_%out_ok, %vec_reg
    EXPAND SLICE_TRY_RANGE_U64 __vec_splice_prefix_ok_%out_ok, __vec_splice_prefix_%out_ok, __vec_splice_current_%out_ok, 0, %start
    EXPAND SLICE_TRY_RANGE_U64 __vec_splice_suffix_ok_%out_ok, __vec_splice_suffix_%out_ok, __vec_splice_current_%out_ok, %start, __vec_splice_suffix_len_%out_ok
    EXPAND VEC_EXTEND_FROM_SLICE_U64 __vec_splice_new_%out_ok, __vec_splice_prefix_%out_ok
    EXPAND VEC_EXTEND_FROM_SLICE_U64 __vec_splice_new_%out_ok, %replacement_slice
    EXPAND VEC_EXTEND_FROM_SLICE_U64 __vec_splice_new_%out_ok, __vec_splice_suffix_%out_ok
    EXPAND VEC_FREE %vec_reg
    %vec_reg = __vec_splice_new_%out_ok
    !__vec_splice_suffix_%out_ok
    !__vec_splice_suffix_ok_%out_ok
    !__vec_splice_prefix_%out_ok
    !__vec_splice_prefix_ok_%out_ok
    !__vec_splice_current_%out_ok
    !__vec_splice_new_len_%out_ok
    !__vec_splice_suffix_len_%out_ok
    !__vec_splice_repl_len_%out_ok
    !__vec_splice_len_%out_ok
    !__vec_splice_view_%out_ok
    !__vec_splice_hit_%out_ok
    jmp L_VEC_SPLICE_END_%out_ok

L_VEC_SPLICE_MISS_%out_ok:
    !__vec_splice_hit_%out_ok

L_VEC_SPLICE_END_%out_ok:
[END_MACRO]

[MACRO] VEC_TRY_SWAP_REMOVE %out_ok, %out_value, %vec_reg, %index
    __vec_swap_remove_slot_%out_ok = stack_alloc 8
    __vec_swap_remove_ok_%out_ok = call @sa_vec_try_swap_remove(&%vec_reg, %index, &__vec_swap_remove_slot_%out_ok)
    %out_value = load __vec_swap_remove_slot_%out_ok+0 as u64
    %out_ok = __vec_swap_remove_ok_%out_ok
[END_MACRO]

[MACRO] VEC_TRY_SWAP_REMOVE_U64 %out_ok, %out_value, %vec_reg, %index
    EXPAND VEC_TRY_SWAP_REMOVE %out_ok, %out_value, %vec_reg, %index
[END_MACRO]

[MACRO] VEC_SWAP_REMOVE %out_ok, %out_value, %vec_reg, %index
    EXPAND VEC_TRY_SWAP_REMOVE %out_ok, %out_value, %vec_reg, %index
[END_MACRO]

[MACRO] VEC_SWAP_REMOVE_U64 %out_ok, %out_value, %vec_reg, %index
    EXPAND VEC_TRY_SWAP_REMOVE_U64 %out_ok, %out_value, %vec_reg, %index
[END_MACRO]

[MACRO] VEC_TRY_REMOVE %out_ok, %out_value, %vec_reg, %index, %elem_size
    __vec_remove_slot_%out_ok = stack_alloc 8
    __vec_remove_ok_%out_ok = call @sa_vec_try_remove(&%vec_reg, %index, &__vec_remove_slot_%out_ok, %elem_size)
    %out_value = load __vec_remove_slot_%out_ok+0 as u64
    %out_ok = __vec_remove_ok_%out_ok
[END_MACRO]

[MACRO] VEC_TRY_REMOVE_U64 %out_ok, %out_value, %vec_reg, %index
    EXPAND VEC_TRY_REMOVE %out_ok, %out_value, %vec_reg, %index, 8
[END_MACRO]

[MACRO] VEC_REMOVE %out_ok, %out_value, %vec_reg, %index, %elem_size
    EXPAND VEC_TRY_REMOVE %out_ok, %out_value, %vec_reg, %index, %elem_size
[END_MACRO]

[MACRO] VEC_REMOVE_U64 %out_ok, %out_value, %vec_reg, %index
    EXPAND VEC_TRY_REMOVE_U64 %out_ok, %out_value, %vec_reg, %index
[END_MACRO]

[MACRO] VEC_TRY_SPLIT_OFF %out_ok, %out_vec, %vec_reg, %index, %elem_size
    __vec_split_off_slot_%out_ok = stack_alloc 8
    %vec_reg = call @sa_vec_try_split_off(^%vec_reg, %index, %elem_size, &__vec_split_off_slot_%out_ok)
    %out_vec = load __vec_split_off_slot_%out_ok+0 as ptr
    %out_ok = ne %out_vec, 0
[END_MACRO]

[MACRO] VEC_TRY_SPLIT_OFF_U64 %out_ok, %out_vec, %vec_reg, %index
    EXPAND VEC_TRY_SPLIT_OFF %out_ok, %out_vec, %vec_reg, %index, 8
[END_MACRO]

[MACRO] VEC_RESIZE %vec_reg, %new_len, %fill_value, %elem_size
    %vec_reg = call @sa_vec_resize(^%vec_reg, %new_len, %fill_value, %elem_size)
[END_MACRO]

[MACRO] VEC_RESIZE_U64 %vec_reg, %new_len, %fill_value
    EXPAND VEC_RESIZE %vec_reg, %new_len, %fill_value, 8
[END_MACRO]

[MACRO] VEC_RESIZE_WITH_U64 %out_len, %vec_reg, %new_len, %gen_fn
    __vec_resize_with_view_%out_len = & %vec_reg
    __vec_resize_with_len_%out_len = load __vec_resize_with_view_%out_len+Vec_len as u64
    __vec_resize_with_grow_%out_len = ugt %new_len, __vec_resize_with_len_%out_len
    br __vec_resize_with_grow_%out_len -> L_VEC_RESIZE_WITH_GROW_%out_len, L_VEC_RESIZE_WITH_TRUNCATE_%out_len

L_VEC_RESIZE_WITH_TRUNCATE_%out_len:
    call @sa_vec_truncate(&%vec_reg, %new_len)
    %out_len = add %new_len, 0
    !__vec_resize_with_grow_%out_len
    !__vec_resize_with_len_%out_len
    !__vec_resize_with_view_%out_len
    jmp L_VEC_RESIZE_WITH_END_%out_len

L_VEC_RESIZE_WITH_GROW_%out_len:
    __vec_resize_with_additional_%out_len = sub %new_len, __vec_resize_with_len_%out_len
    EXPAND VEC_RESERVE_U64 %vec_reg, __vec_resize_with_additional_%out_len
    __vec_resize_with_idx_slot_%out_len = stack_alloc 8
    store __vec_resize_with_idx_slot_%out_len+0, __vec_resize_with_len_%out_len as u64
    !__vec_resize_with_additional_%out_len
    !__vec_resize_with_grow_%out_len
    !__vec_resize_with_len_%out_len
    !__vec_resize_with_view_%out_len
    jmp L_VEC_RESIZE_WITH_HEAD_%out_len

L_VEC_RESIZE_WITH_HEAD_%out_len:
    __vec_resize_with_idx_%out_len = load __vec_resize_with_idx_slot_%out_len+0 as u64
    __vec_resize_with_done_%out_len = eq __vec_resize_with_idx_%out_len, %new_len
    br __vec_resize_with_done_%out_len -> L_VEC_RESIZE_WITH_DONE_%out_len, L_VEC_RESIZE_WITH_BODY_%out_len

L_VEC_RESIZE_WITH_BODY_%out_len:
    __vec_resize_with_value_%out_len = call %gen_fn()
    EXPAND VEC_PUSH_U64 %vec_reg, __vec_resize_with_value_%out_len
    __vec_resize_with_next_%out_len = add __vec_resize_with_idx_%out_len, 1
    store __vec_resize_with_idx_slot_%out_len+0, __vec_resize_with_next_%out_len as u64
    !__vec_resize_with_next_%out_len
    !__vec_resize_with_value_%out_len
    !__vec_resize_with_done_%out_len
    !__vec_resize_with_idx_%out_len
    jmp L_VEC_RESIZE_WITH_HEAD_%out_len

L_VEC_RESIZE_WITH_DONE_%out_len:
    %out_len = add %new_len, 0
    !__vec_resize_with_done_%out_len
    !__vec_resize_with_idx_%out_len

L_VEC_RESIZE_WITH_END_%out_len:
[END_MACRO]

[MACRO] VEC_SHRINK_TO %vec_reg, %min_cap, %elem_size
    %vec_reg = call @sa_vec_shrink_to(^%vec_reg, %min_cap, %elem_size)
[END_MACRO]

[MACRO] VEC_SHRINK_TO_U64 %vec_reg, %min_cap
    EXPAND VEC_SHRINK_TO %vec_reg, %min_cap, 8
[END_MACRO]

[MACRO] VEC_TRY_SHRINK_TO %out_ok, %vec_reg, %min_cap, %elem_size
    EXPAND VEC_SHRINK_TO %vec_reg, %min_cap, %elem_size
    %out_ok = add 0, 1
[END_MACRO]

[MACRO] VEC_TRY_SHRINK_TO_U64 %out_ok, %vec_reg, %min_cap
    EXPAND VEC_TRY_SHRINK_TO %out_ok, %vec_reg, %min_cap, 8
[END_MACRO]

[MACRO] VEC_SHRINK_TO_FIT %vec_reg, %elem_size
    %vec_reg = call @sa_vec_shrink_to_fit(^%vec_reg, %elem_size)
[END_MACRO]

[MACRO] VEC_SHRINK_TO_FIT_U64 %vec_reg
    EXPAND VEC_SHRINK_TO_FIT %vec_reg, 8
[END_MACRO]

[MACRO] VEC_TRY_SHRINK_TO_FIT %out_ok, %vec_reg, %elem_size
    EXPAND VEC_SHRINK_TO_FIT %vec_reg, %elem_size
    %out_ok = add 0, 1
[END_MACRO]

[MACRO] VEC_TRY_SHRINK_TO_FIT_U64 %out_ok, %vec_reg
    EXPAND VEC_TRY_SHRINK_TO_FIT %out_ok, %vec_reg, 8
[END_MACRO]
