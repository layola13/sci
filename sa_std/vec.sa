[END_MACRO]

[MACRO] VEC_EXTEND_FROM_SLICE_U64 %vec_reg, %slice_reg
    EXPAND VEC_EXTEND_FROM_SLICE %vec_reg, %slice_reg, 8
[END_MACRO]

[MACRO] VEC_TRY_EXTEND_FROM_WITHIN_U64 %out_ok, %vec_reg, %start, %length
    __vec_efw_view_%out_ok = & %vec_reg
    __vec_efw_len_%out_ok = load __vec_efw_view_%out_ok+Vec_len as u64
    __vec_efw_start_ok_%out_ok = ule %start, __vec_efw_len_%out_ok
    br __vec_efw_start_ok_%out_ok -> L_VEC_EFW_LEN_CHECK_%out_ok, L_VEC_EFW_MISS_START_%out_ok

L_VEC_EFW_LEN_CHECK_%out_ok:
    __vec_efw_remaining_%out_ok = sub __vec_efw_len_%out_ok, %start
    __vec_efw_len_ok_%out_ok = ule %length, __vec_efw_remaining_%out_ok
    br __vec_efw_len_ok_%out_ok -> L_VEC_EFW_APPEND_%out_ok, L_VEC_EFW_MISS_LEN_%out_ok

L_VEC_EFW_APPEND_%out_ok:
    EXPAND VEC_RESERVE_U64 %vec_reg, %length
    EXPAND VEC_AS_SLICE __vec_efw_slice_%out_ok, %vec_reg
    EXPAND SLICE_TRY_RANGE_U64 __vec_efw_range_ok_%out_ok, __vec_efw_range_%out_ok, __vec_efw_slice_%out_ok, %start, %length
    EXPAND VEC_EXTEND_FROM_SLICE_U64 %vec_reg, __vec_efw_range_%out_ok
    %out_ok = add 0, 1
    !__vec_efw_range_ok_%out_ok
    !__vec_efw_range_%out_ok
    !__vec_efw_slice_%out_ok
    !__vec_efw_len_ok_%out_ok
    !__vec_efw_remaining_%out_ok
    !__vec_efw_start_ok_%out_ok
    !__vec_efw_len_%out_ok
    !__vec_efw_view_%out_ok
    jmp L_VEC_EFW_END_%out_ok

L_VEC_EFW_MISS_LEN_%out_ok:
    %out_ok = add 0, 0
    !__vec_efw_len_ok_%out_ok
    !__vec_efw_remaining_%out_ok
    !__vec_efw_start_ok_%out_ok
    !__vec_efw_len_%out_ok
    !__vec_efw_view_%out_ok
    jmp L_VEC_EFW_END_%out_ok

L_VEC_EFW_MISS_START_%out_ok:
    %out_ok = add 0, 0
    !__vec_efw_start_ok_%out_ok
    !__vec_efw_len_%out_ok
    !__vec_efw_view_%out_ok

L_VEC_EFW_END_%out_ok:
[END_MACRO]

[MACRO] VEC_EXTEND_FROM_WITHIN_U64 %vec_reg, %start, %length
    EXPAND VEC_TRY_EXTEND_FROM_WITHIN_U64 __vec_efw_ok_%vec_reg, %vec_reg, %start, %length
    !__vec_efw_ok_%vec_reg
[END_MACRO]

[MACRO] VEC_APPEND %dst_vec_reg, %src_vec_reg, %elem_size
    %dst_vec_reg = call @sa_vec_append(^%dst_vec_reg, &%src_vec_reg, %elem_size)
[END_MACRO]

[MACRO] VEC_APPEND_U64 %dst_vec_reg, %src_vec_reg
