@import "alloc/vec.sal"
@import "alloc/vec.sa"
@import "core/slice.sal"
@import "core/slice.sa"

[MACRO] VEC_NEW %out_vec
    %out_vec = call @sa_vec_new()
[END_MACRO]

[MACRO] VEC_LEN %out_len, %vec_reg
    %out_len = call @sa_vec_len(&%vec_reg)
[END_MACRO]

[MACRO] VEC_AS_PTR %out_ptr, %vec_reg
    __vec_view_%out_ptr = & %vec_reg
    %out_ptr = load __vec_view_%out_ptr+Vec_ptr as ptr
    !__vec_view_%out_ptr
[END_MACRO]

[MACRO] VEC_AS_MUT_PTR %out_ptr, %vec_reg
    EXPAND VEC_AS_PTR %out_ptr, %vec_reg
[END_MACRO]

[MACRO] VEC_AS_SLICE %out_slice, %vec_reg
    __vec_view_%out_slice = & %vec_reg
    __vec_ptr_%out_slice = load __vec_view_%out_slice+Vec_ptr as ptr
    __vec_len_%out_slice = load __vec_view_%out_slice+Vec_len as u64
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __vec_ptr_%out_slice, __vec_len_%out_slice
    !__vec_ptr_%out_slice
    !__vec_len_%out_slice
    !__vec_view_%out_slice
[END_MACRO]

[MACRO] VEC_AS_MUT_SLICE %out_slice, %vec_reg
    EXPAND VEC_AS_SLICE %out_slice, %vec_reg
[END_MACRO]

[MACRO] VEC_GET %out_ptr, %vec_reg, %index
    __vec_view_%out_ptr = & %vec_reg
    __vec_ptr_%out_ptr = load __vec_view_%out_ptr+Vec_ptr as ptr
    __vec_elem_off_%out_ptr = mul %index, 8
    __vec_elem_ptr_%out_ptr = ptr_add __vec_ptr_%out_ptr, __vec_elem_off_%out_ptr
    %out_ptr = load __vec_elem_ptr_%out_ptr+0 as u64
    !__vec_elem_off_%out_ptr
    !__vec_elem_ptr_%out_ptr
    !__vec_ptr_%out_ptr
    !__vec_view_%out_ptr
[END_MACRO]

[MACRO] VEC_GET_U64 %out_value, %vec_reg, %index
    EXPAND VEC_GET %out_value, %vec_reg, %index
[END_MACRO]

[MACRO] VEC_TRY_GET %out_ok, %out_value, %vec_reg, %index
    EXPAND VEC_AS_SLICE __vec_get_slice_%out_ok, %vec_reg
    EXPAND SLICE_TRY_GET_U64 %out_ok, %out_value, __vec_get_slice_%out_ok, %index
    !__vec_get_slice_%out_ok
[END_MACRO]

[MACRO] VEC_TRY_GET_U64 %out_ok, %out_value, %vec_reg, %index
    EXPAND VEC_TRY_GET %out_ok, %out_value, %vec_reg, %index
[END_MACRO]

[MACRO] VEC_FRONT %out_value, %vec_reg
    EXPAND VEC_GET %out_value, %vec_reg, 0
[END_MACRO]

[MACRO] VEC_BACK %out_value, %vec_reg
    __vec_len_%out_value = call @sa_vec_len(&%vec_reg)
    __vec_last_%out_value = sub __vec_len_%out_value, 1
    EXPAND VEC_GET %out_value, %vec_reg, __vec_last_%out_value
    !__vec_last_%out_value
    !__vec_len_%out_value
[END_MACRO]

[MACRO] VEC_TRY_FRONT %out_ok, %out_value, %vec_reg
    EXPAND VEC_AS_SLICE __vec_front_slice_%out_ok, %vec_reg
    EXPAND SLICE_TRY_FIRST_U64 %out_ok, %out_value, __vec_front_slice_%out_ok
    !__vec_front_slice_%out_ok
[END_MACRO]

[MACRO] VEC_TRY_FRONT_U64 %out_ok, %out_value, %vec_reg
    EXPAND VEC_TRY_FRONT %out_ok, %out_value, %vec_reg
[END_MACRO]

[MACRO] VEC_TRY_BACK %out_ok, %out_value, %vec_reg
    EXPAND VEC_AS_SLICE __vec_back_slice_%out_ok, %vec_reg
    EXPAND SLICE_TRY_LAST_U64 %out_ok, %out_value, __vec_back_slice_%out_ok
    !__vec_back_slice_%out_ok
[END_MACRO]

[MACRO] VEC_TRY_BACK_U64 %out_ok, %out_value, %vec_reg
    EXPAND VEC_TRY_BACK %out_ok, %out_value, %vec_reg
[END_MACRO]

[MACRO] VEC_PUSH %vec_reg, %value, %elem_size
    %vec_reg = call @sa_vec_push(^%vec_reg, %value, %elem_size)
[END_MACRO]

[MACRO] VEC_PUSH_U64 %vec_reg, %value
    EXPAND VEC_PUSH %vec_reg, %value, 8
[END_MACRO]

[MACRO] VEC_FREE %vec_reg
    call @sa_vec_free(^%vec_reg)
[END_MACRO]

[MACRO] VEC_CAPACITY %out_cap, %vec_reg
    %out_cap = call @sa_vec_capacity(&%vec_reg)
[END_MACRO]

[MACRO] VEC_RESERVE %vec_reg, %additional, %elem_size
    %vec_reg = call @sa_vec_reserve(^%vec_reg, %additional, %elem_size)
[END_MACRO]

[MACRO] VEC_RESERVE_U64 %vec_reg, %additional
    EXPAND VEC_RESERVE %vec_reg, %additional, 8
[END_MACRO]

[MACRO] VEC_RESERVE_EXACT %vec_reg, %additional, %elem_size
    EXPAND VEC_RESERVE %vec_reg, %additional, %elem_size
[END_MACRO]

[MACRO] VEC_RESERVE_EXACT_U64 %vec_reg, %additional
    EXPAND VEC_RESERVE_EXACT %vec_reg, %additional, 8
[END_MACRO]

[MACRO] VEC_TRY_RESERVE %out_ok, %vec_reg, %additional, %elem_size
    EXPAND VEC_RESERVE %vec_reg, %additional, %elem_size
    %out_ok = add 0, 1
[END_MACRO]

[MACRO] VEC_TRY_RESERVE_U64 %out_ok, %vec_reg, %additional
    EXPAND VEC_TRY_RESERVE %out_ok, %vec_reg, %additional, 8
[END_MACRO]

[MACRO] VEC_TRY_RESERVE_EXACT %out_ok, %vec_reg, %additional, %elem_size
    EXPAND VEC_RESERVE_EXACT %vec_reg, %additional, %elem_size
    %out_ok = add 0, 1
[END_MACRO]

[MACRO] VEC_TRY_RESERVE_EXACT_U64 %out_ok, %vec_reg, %additional
    EXPAND VEC_TRY_RESERVE_EXACT %out_ok, %vec_reg, %additional, 8
[END_MACRO]

[MACRO] VEC_IS_EMPTY %out_flag, %vec_reg
    %out_flag = call @sa_vec_is_empty(&%vec_reg)
[END_MACRO]

[MACRO] VEC_CLEAR %vec_reg
    call @sa_vec_clear(&%vec_reg)
[END_MACRO]

[MACRO] VEC_TRUNCATE %vec_reg, %new_len
    call @sa_vec_truncate(&%vec_reg, %new_len)
[END_MACRO]

[MACRO] VEC_SET_LEN %vec_reg, %new_len
    call @sa_vec_truncate(&%vec_reg, %new_len)
[END_MACRO]

[MACRO] VEC_TRY_POP %out_ok, %out_value, %vec_reg
    __vec_value_slot_%out_ok = stack_alloc 8
    __vec_ok_%out_ok = call @sa_vec_try_pop(&%vec_reg, &__vec_value_slot_%out_ok)
    %out_value = load __vec_value_slot_%out_ok+0 as u64
    %out_ok = __vec_ok_%out_ok
[END_MACRO]

[MACRO] VEC_TRY_POP_U64 %out_ok, %out_value, %vec_reg
    EXPAND VEC_TRY_POP %out_ok, %out_value, %vec_reg
[END_MACRO]

[MACRO] VEC_POP %out_ok, %out_value, %vec_reg
    EXPAND VEC_TRY_POP %out_ok, %out_value, %vec_reg
[END_MACRO]

[MACRO] VEC_POP_U64 %out_ok, %out_value, %vec_reg
    EXPAND VEC_TRY_POP_U64 %out_ok, %out_value, %vec_reg
[END_MACRO]

[MACRO] VEC_WITH_CAPACITY %out_vec, %cap, %elem_size
    %out_vec = call @sa_vec_with_capacity(%cap, %elem_size)
[END_MACRO]

[MACRO] VEC_WITH_CAPACITY_U64 %out_vec, %cap
    EXPAND VEC_WITH_CAPACITY %out_vec, %cap, 8
[END_MACRO]

[MACRO] VEC_TRY_WITH_CAPACITY %out_ok, %out_vec, %cap, %elem_size
    EXPAND VEC_WITH_CAPACITY %out_vec, %cap, %elem_size
    %out_ok = ne %out_vec, 0
[END_MACRO]

[MACRO] VEC_TRY_WITH_CAPACITY_U64 %out_ok, %out_vec, %cap
    EXPAND VEC_TRY_WITH_CAPACITY %out_ok, %out_vec, %cap, 8
[END_MACRO]

[MACRO] VEC_CONTAINS_U64 %out_bool, %vec_reg, %needle
    EXPAND VEC_AS_SLICE __vec_contains_slice_%out_bool, %vec_reg
    EXPAND SLICE_CONTAINS_U64 %out_bool, __vec_contains_slice_%out_bool, %needle
    !__vec_contains_slice_%out_bool
[END_MACRO]

[MACRO] VEC_STARTS_WITH_U64 %out_bool, %vec_reg, %prefix_slice
    EXPAND VEC_AS_SLICE __vec_starts_slice_%out_bool, %vec_reg
    EXPAND SLICE_STARTS_WITH_U64 %out_bool, __vec_starts_slice_%out_bool, %prefix_slice
    !__vec_starts_slice_%out_bool
[END_MACRO]

[MACRO] VEC_ENDS_WITH_U64 %out_bool, %vec_reg, %suffix_slice
    EXPAND VEC_AS_SLICE __vec_ends_slice_%out_bool, %vec_reg
    EXPAND SLICE_ENDS_WITH_U64 %out_bool, __vec_ends_slice_%out_bool, %suffix_slice
    !__vec_ends_slice_%out_bool
[END_MACRO]

[MACRO] VEC_TRY_STRIP_PREFIX_U64 %out_ok, %out_slice, %vec_reg, %prefix_slice
    EXPAND VEC_AS_SLICE __vec_strip_prefix_slice_%out_ok, %vec_reg
    EXPAND SLICE_TRY_STRIP_PREFIX_U64 %out_ok, %out_slice, __vec_strip_prefix_slice_%out_ok, %prefix_slice
    !__vec_strip_prefix_slice_%out_ok
[END_MACRO]

[MACRO] VEC_TRY_STRIP_SUFFIX_U64 %out_ok, %out_slice, %vec_reg, %suffix_slice
    EXPAND VEC_AS_SLICE __vec_strip_suffix_slice_%out_ok, %vec_reg
    EXPAND SLICE_TRY_STRIP_SUFFIX_U64 %out_ok, %out_slice, __vec_strip_suffix_slice_%out_ok, %suffix_slice
    !__vec_strip_suffix_slice_%out_ok
[END_MACRO]

[MACRO] VEC_TRIM_PREFIX_U64 %out_slice, %vec_reg, %prefix_slice
    EXPAND VEC_AS_SLICE __vec_trim_prefix_slice_%out_slice, %vec_reg
    EXPAND SLICE_TRIM_PREFIX_U64 %out_slice, __vec_trim_prefix_slice_%out_slice, %prefix_slice
    !__vec_trim_prefix_slice_%out_slice
[END_MACRO]

[MACRO] VEC_TRIM_SUFFIX_U64 %out_slice, %vec_reg, %suffix_slice
    EXPAND VEC_AS_SLICE __vec_trim_suffix_slice_%out_slice, %vec_reg
    EXPAND SLICE_TRIM_SUFFIX_U64 %out_slice, __vec_trim_suffix_slice_%out_slice, %suffix_slice
    !__vec_trim_suffix_slice_%out_slice
[END_MACRO]

[MACRO] VEC_TRY_SPLIT_AT_U64 %out_ok, %out_left, %out_right, %vec_reg, %mid
    EXPAND VEC_AS_SLICE __vec_split_slice_%out_ok, %vec_reg
    EXPAND SLICE_TRY_SPLIT_AT_U64 %out_ok, %out_left, %out_right, __vec_split_slice_%out_ok, %mid
    !__vec_split_slice_%out_ok
[END_MACRO]

[MACRO] VEC_EXTEND_FROM_SLICE %vec_reg, %slice_reg, %elem_size
    %vec_reg = call @sa_vec_extend_from_slice(^%vec_reg, &%slice_reg, %elem_size)
[END_MACRO]

[MACRO] VEC_EXTEND_FROM_SLICE_U64 %vec_reg, %slice_reg
    EXPAND VEC_EXTEND_FROM_SLICE %vec_reg, %slice_reg, 8
[END_MACRO]

[MACRO] VEC_APPEND %dst_vec_reg, %src_vec_reg, %elem_size
    %dst_vec_reg = call @sa_vec_append(^%dst_vec_reg, &%src_vec_reg, %elem_size)
[END_MACRO]

[MACRO] VEC_APPEND_U64 %dst_vec_reg, %src_vec_reg
    EXPAND VEC_APPEND %dst_vec_reg, %src_vec_reg, 8
[END_MACRO]

[MACRO] VEC_PUSH_WITHIN_CAPACITY %out_ok, %vec_reg, %value, %elem_size
    __vec_pwc_view_%out_ok = & %vec_reg
    __vec_pwc_len_%out_ok = load __vec_pwc_view_%out_ok+Vec_len as u64
    __vec_pwc_cap_%out_ok = load __vec_pwc_view_%out_ok+Vec_cap as u64
    __vec_pwc_has_room_%out_ok = ult __vec_pwc_len_%out_ok, __vec_pwc_cap_%out_ok
    br __vec_pwc_has_room_%out_ok -> L_VEC_PWC_HIT_%out_ok, L_VEC_PWC_MISS_%out_ok

L_VEC_PWC_HIT_%out_ok:
    !__vec_pwc_view_%out_ok
    %vec_reg = call @sa_vec_push(^%vec_reg, %value, %elem_size)
    %out_ok = add 0, 1
    !__vec_pwc_has_room_%out_ok
    !__vec_pwc_cap_%out_ok
    !__vec_pwc_len_%out_ok
    jmp L_VEC_PWC_END_%out_ok

L_VEC_PWC_MISS_%out_ok:
    %out_ok = add 0, 0
    !__vec_pwc_has_room_%out_ok
    !__vec_pwc_cap_%out_ok
    !__vec_pwc_len_%out_ok
    !__vec_pwc_view_%out_ok

L_VEC_PWC_END_%out_ok:
[END_MACRO]

[MACRO] VEC_PUSH_WITHIN_CAPACITY_U64 %out_ok, %vec_reg, %value
    EXPAND VEC_PUSH_WITHIN_CAPACITY %out_ok, %vec_reg, %value, 8
[END_MACRO]

[MACRO] VEC_TRY_INSERT %out_ok, %vec_reg, %index, %value, %elem_size
    __vec_insert_view_%out_ok = & %vec_reg
    __vec_insert_len_%out_ok = load __vec_insert_view_%out_ok+Vec_len as u64
    __vec_insert_in_bounds_%out_ok = ule %index, __vec_insert_len_%out_ok
    br __vec_insert_in_bounds_%out_ok -> L_VEC_INSERT_PUSH_%out_ok, L_VEC_INSERT_MISS_%out_ok

L_VEC_INSERT_PUSH_%out_ok:
    !__vec_insert_view_%out_ok
    %vec_reg = call @sa_vec_push(^%vec_reg, 0, %elem_size)
    __vec_insert_view2_%out_ok = & %vec_reg
    __vec_insert_ptr_%out_ok = load __vec_insert_view2_%out_ok+Vec_ptr as ptr
    __vec_insert_pos_slot_%out_ok = stack_alloc 8
    store __vec_insert_pos_slot_%out_ok+0, __vec_insert_len_%out_ok as u64
    jmp L_VEC_INSERT_SHIFT_HEAD_%out_ok

L_VEC_INSERT_SHIFT_HEAD_%out_ok:
    __vec_insert_pos_%out_ok = load __vec_insert_pos_slot_%out_ok+0 as u64
    __vec_insert_more_%out_ok = ugt __vec_insert_pos_%out_ok, %index
    br __vec_insert_more_%out_ok -> L_VEC_INSERT_SHIFT_BODY_%out_ok, L_VEC_INSERT_STORE_%out_ok

L_VEC_INSERT_SHIFT_BODY_%out_ok:
    __vec_insert_prev_%out_ok = sub __vec_insert_pos_%out_ok, 1
    __vec_insert_prev_off_%out_ok = mul __vec_insert_prev_%out_ok, %elem_size
    __vec_insert_pos_off_%out_ok = mul __vec_insert_pos_%out_ok, %elem_size
    __vec_insert_prev_ptr_%out_ok = ptr_add __vec_insert_ptr_%out_ok, __vec_insert_prev_off_%out_ok
    __vec_insert_pos_ptr_%out_ok = ptr_add __vec_insert_ptr_%out_ok, __vec_insert_pos_off_%out_ok
    __vec_insert_move_value_%out_ok = load __vec_insert_prev_ptr_%out_ok+0 as u64
    store __vec_insert_pos_ptr_%out_ok+0, __vec_insert_move_value_%out_ok as u64
    store __vec_insert_pos_slot_%out_ok+0, __vec_insert_prev_%out_ok as u64
    !__vec_insert_move_value_%out_ok
    !__vec_insert_pos_ptr_%out_ok
    !__vec_insert_prev_ptr_%out_ok
    !__vec_insert_pos_off_%out_ok
    !__vec_insert_prev_off_%out_ok
    !__vec_insert_prev_%out_ok
    !__vec_insert_more_%out_ok
    !__vec_insert_pos_%out_ok
    jmp L_VEC_INSERT_SHIFT_HEAD_%out_ok

L_VEC_INSERT_STORE_%out_ok:
    __vec_insert_index_off_%out_ok = mul %index, %elem_size
    __vec_insert_index_ptr_%out_ok = ptr_add __vec_insert_ptr_%out_ok, __vec_insert_index_off_%out_ok
    store __vec_insert_index_ptr_%out_ok+0, %value as u64
    %out_ok = add 0, 1
    !__vec_insert_index_ptr_%out_ok
    !__vec_insert_index_off_%out_ok
    !__vec_insert_more_%out_ok
    !__vec_insert_pos_%out_ok
    !__vec_insert_ptr_%out_ok
    !__vec_insert_view2_%out_ok
    !__vec_insert_in_bounds_%out_ok
    !__vec_insert_len_%out_ok
    jmp L_VEC_INSERT_END_%out_ok

L_VEC_INSERT_MISS_%out_ok:
    %out_ok = add 0, 0
    !__vec_insert_in_bounds_%out_ok
    !__vec_insert_len_%out_ok
    !__vec_insert_view_%out_ok

L_VEC_INSERT_END_%out_ok:
[END_MACRO]

[MACRO] VEC_TRY_INSERT_U64 %out_ok, %vec_reg, %index, %value
    EXPAND VEC_TRY_INSERT %out_ok, %vec_reg, %index, %value, 8
[END_MACRO]

[MACRO] VEC_INSERT %out_ok, %vec_reg, %index, %value, %elem_size
    EXPAND VEC_TRY_INSERT %out_ok, %vec_reg, %index, %value, %elem_size
[END_MACRO]

[MACRO] VEC_INSERT_U64 %out_ok, %vec_reg, %index, %value
    EXPAND VEC_TRY_INSERT_U64 %out_ok, %vec_reg, %index, %value
[END_MACRO]

[MACRO] VEC_DEDUP_U64 %out_len, %vec_reg
    __vec_dedup_view_%out_len = & %vec_reg
    __vec_dedup_ptr_%out_len = load __vec_dedup_view_%out_len+Vec_ptr as ptr
    __vec_dedup_len_%out_len = load __vec_dedup_view_%out_len+Vec_len as u64
    __vec_dedup_small_%out_len = ule __vec_dedup_len_%out_len, 1
    br __vec_dedup_small_%out_len -> L_VEC_DEDUP_SMALL_%out_len, L_VEC_DEDUP_INIT_%out_len

L_VEC_DEDUP_INIT_%out_len:
    __vec_dedup_read_slot_%out_len = stack_alloc 8
    __vec_dedup_write_slot_%out_len = stack_alloc 8
    store __vec_dedup_read_slot_%out_len+0, 1 as u64
    store __vec_dedup_write_slot_%out_len+0, 1 as u64
    jmp L_VEC_DEDUP_HEAD_%out_len

L_VEC_DEDUP_HEAD_%out_len:
    __vec_dedup_read_%out_len = load __vec_dedup_read_slot_%out_len+0 as u64
    __vec_dedup_done_%out_len = eq __vec_dedup_read_%out_len, __vec_dedup_len_%out_len
    br __vec_dedup_done_%out_len -> L_VEC_DEDUP_DONE_%out_len, L_VEC_DEDUP_BODY_%out_len

L_VEC_DEDUP_BODY_%out_len:
    __vec_dedup_write_%out_len = load __vec_dedup_write_slot_%out_len+0 as u64
    __vec_dedup_prev_%out_len = sub __vec_dedup_write_%out_len, 1
    __vec_dedup_read_off_%out_len = mul __vec_dedup_read_%out_len, 8
    __vec_dedup_prev_off_%out_len = mul __vec_dedup_prev_%out_len, 8
    __vec_dedup_read_ptr_%out_len = ptr_add __vec_dedup_ptr_%out_len, __vec_dedup_read_off_%out_len
    __vec_dedup_prev_ptr_%out_len = ptr_add __vec_dedup_ptr_%out_len, __vec_dedup_prev_off_%out_len
    __vec_dedup_read_value_%out_len = load __vec_dedup_read_ptr_%out_len+0 as u64
    __vec_dedup_prev_value_%out_len = load __vec_dedup_prev_ptr_%out_len+0 as u64
    __vec_dedup_same_%out_len = eq __vec_dedup_read_value_%out_len, __vec_dedup_prev_value_%out_len
    br __vec_dedup_same_%out_len -> L_VEC_DEDUP_SKIP_%out_len, L_VEC_DEDUP_KEEP_%out_len

L_VEC_DEDUP_KEEP_%out_len:
    __vec_dedup_write_off_%out_len = mul __vec_dedup_write_%out_len, 8
    __vec_dedup_write_ptr_%out_len = ptr_add __vec_dedup_ptr_%out_len, __vec_dedup_write_off_%out_len
    store __vec_dedup_write_ptr_%out_len+0, __vec_dedup_read_value_%out_len as u64
    __vec_dedup_next_write_%out_len = add __vec_dedup_write_%out_len, 1
    store __vec_dedup_write_slot_%out_len+0, __vec_dedup_next_write_%out_len as u64
    !__vec_dedup_next_write_%out_len
    !__vec_dedup_write_ptr_%out_len
    !__vec_dedup_write_off_%out_len
    jmp L_VEC_DEDUP_NEXT_%out_len

L_VEC_DEDUP_SKIP_%out_len:
    jmp L_VEC_DEDUP_NEXT_%out_len

L_VEC_DEDUP_NEXT_%out_len:
    __vec_dedup_next_read_%out_len = add __vec_dedup_read_%out_len, 1
    store __vec_dedup_read_slot_%out_len+0, __vec_dedup_next_read_%out_len as u64
    !__vec_dedup_next_read_%out_len
    !__vec_dedup_same_%out_len
    !__vec_dedup_prev_value_%out_len
    !__vec_dedup_read_value_%out_len
    !__vec_dedup_prev_ptr_%out_len
    !__vec_dedup_read_ptr_%out_len
    !__vec_dedup_prev_off_%out_len
    !__vec_dedup_read_off_%out_len
    !__vec_dedup_prev_%out_len
    !__vec_dedup_write_%out_len
    !__vec_dedup_done_%out_len
    !__vec_dedup_read_%out_len
    jmp L_VEC_DEDUP_HEAD_%out_len

L_VEC_DEDUP_DONE_%out_len:
    %out_len = load __vec_dedup_write_slot_%out_len+0 as u64
    store __vec_dedup_view_%out_len+Vec_len, %out_len as u64
    !__vec_dedup_done_%out_len
    !__vec_dedup_read_%out_len
    !__vec_dedup_small_%out_len
    !__vec_dedup_len_%out_len
    !__vec_dedup_ptr_%out_len
    !__vec_dedup_view_%out_len
    jmp L_VEC_DEDUP_END_%out_len

L_VEC_DEDUP_SMALL_%out_len:
    %out_len = add __vec_dedup_len_%out_len, 0
    !__vec_dedup_small_%out_len
    !__vec_dedup_len_%out_len
    !__vec_dedup_ptr_%out_len
    !__vec_dedup_view_%out_len

