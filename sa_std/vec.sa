[END_MACRO]

[MACRO] VEC_DEDUP_U64 %out_len, %vec_reg
    __vec_dedup_view_%out_len = & %vec_reg
    __vec_dedup_ptr_%out_len = load __vec_dedup_view_%out_len+Vec_ptr as ptr
    __vec_dedup_len_%out_len = load __vec_dedup_view_%out_len+Vec_len as u64
