// ts_array.sa -- thin-handle array ops for tsgosa mapping (R1 backport).
//
// Handle model (thin口 16 字节堆头, 与 `sci/sa_std/vec.sa` Vec 寄存器组
// 不同构, 不可直调, 故另立本模块):
//   +0: data ptr (4B 元数组)
//   +8: len u64 (元数)
// 新柄调用方持有, 用后 `!` 释放 (与 tsgosa 薄口归属口径一致).

// @ts_arr_concat2 双片合并（新柄调用方持有；形参值拷，用后即释不碰原槽）。
@ts_arr_concat2(a: ptr, b: ptr) -> ptr:
L_ENTRY:
    alen = load a+8 as u64
    blen = load b+8 as u64
    nlen = add alen, blen
    nbytes = mul nlen, 4
    nbuf = alloc nbytes
    nh = alloc 16
    store nh+0, nbuf as ptr
    store nh+8, nlen as u64
    !nbuf
    aptr = load a+0 as ptr
    bptr = load b+0 as ptr
    dptr = load nh+0 as ptr
    i = 0
    jmp L_C1_TOP
L_C1_TOP:
    c1 = slt i, alen
    br c1 -> L_C1_BODY, L_C1_END
L_C1_BODY:
    soff = mul i, 4
    saddr = add aptr, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    inext = add i, 1
    i = inext
    jmp L_C1_TOP
L_C1_END:
    j = 0
    jmp L_C2_TOP
L_C2_TOP:
    c2 = slt j, blen
    br c2 -> L_C2_BODY, L_C2_END
L_C2_BODY:
    soff2 = mul j, 4
    saddr2 = add bptr, soff2
    v2 = load saddr2+0 as i32
    k = add alen, j
    doff2 = mul k, 4
    daddr2 = add dptr, doff2
    store daddr2+0, v2 as i32
    jnext = add j, 1
    j = jnext
    jmp L_C2_TOP
L_C2_END:
    !a
    !b
    return nh
// end 双端钳位, end<start 即空; 形参 i32(薄口门禁已保非负?不, 负起合法,
// 故此处全量钳位); 句柄值参（调用方原槽不受影响；引用传参系 move 语义，
// 禁用于复用句柄）；返回新柄, 调用方持有.
// @ts_arr_splice 原地删段返删除段（插入三段拷统一新缓冲，无插入即
// ilen=0 退化同形；换柄后释旧缓冲；形参值拷，用后即释不碰原槽）。
@ts_arr_splice(src: ptr, start: i32, del: i32, items: ptr) -> ptr:
L_SP_ENTRY:
    slen = load src+8 as u64
    ilen = load items+8 as u64
    sbuf = load src+0 as ptr
    s_slot = alloc 8
    s_neg = slt start, 0
    br s_neg -> L_SP_S_NEG, L_SP_S_POS
L_SP_S_NEG:
    s_plus = add start, slen
    s_ppos = sge s_plus, 0
    br s_ppos -> L_SP_S_KEEP, L_SP_S_ZERO
L_SP_S_KEEP:
    store s_slot+0, s_plus as i32
    jmp L_SP_S_DONE
L_SP_S_ZERO:
    store s_slot+0, 0 as i32
    jmp L_SP_S_DONE
L_SP_S_POS:
    s_lt = slt start, slen
    br s_lt -> L_SP_S_TAKE, L_SP_S_CLAMP
L_SP_S_TAKE:
    store s_slot+0, start as i32
    jmp L_SP_S_DONE
L_SP_S_CLAMP:
    store s_slot+0, slen as i32
    jmp L_SP_S_DONE
L_SP_S_DONE:
    s = load s_slot+0 as i32
    !s_slot
    d_slot = alloc 8
    d_neg = slt del, 0
    br d_neg -> L_SP_D_ZERO, L_SP_D_POS
L_SP_D_ZERO:
    store d_slot+0, 0 as i32
    jmp L_SP_D_DONE
L_SP_D_POS:
    maxdel = sub slen, s
    d_over = sgt del, maxdel
    br d_over -> L_SP_D_CLAMP, L_SP_D_TAKE
L_SP_D_CLAMP:
    store d_slot+0, maxdel as i32
    jmp L_SP_D_DONE
L_SP_D_TAKE:
    store d_slot+0, del as i32
    jmp L_SP_D_DONE
L_SP_D_DONE:
    d = load d_slot+0 as i32
    !d_slot
    sd = add s, d
    ntmp = sub slen, d
    nlen = add ntmp, ilen
    dh = alloc 16
    dbytes = mul d, 4
    dbuf = alloc dbytes
    store dh+0, dbuf as ptr
    store dh+8, d as u64
    !dbuf
    dptr = load dh+0 as ptr
    iptr = load items+0 as ptr
    i = 0
    jmp L_SP1_TOP
L_SP1_TOP:
    c1 = slt i, d
    br c1 -> L_SP1_BODY, L_SP1_END
L_SP1_BODY:
    si = add s, i
    soff = mul si, 4
    saddr = add sbuf, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    inext = add i, 1
    i = inext
    jmp L_SP1_TOP
L_SP1_END:
    nbytes = mul nlen, 4
    nbuf = alloc nbytes
    nptr = add nbuf, 0
    j = 0
    jmp L_SP2_TOP
L_SP2_TOP:
    c2 = slt j, s
    br c2 -> L_SP2_BODY, L_SP2_END
L_SP2_BODY:
    joff = mul j, 4
    jaddr = add sbuf, joff
    v2 = load jaddr+0 as i32
    koff = mul j, 4
    kaddr = add nptr, koff
    store kaddr+0, v2 as i32
    jnext = add j, 1
    j = jnext
    jmp L_SP2_TOP
L_SP2_END:
    k = 0
    jmp L_SP3_TOP
L_SP3_TOP:
    c3 = slt k, ilen
    br c3 -> L_SP3_BODY, L_SP3_END
L_SP3_BODY:
    koff2 = mul k, 4
    kaddr2 = add iptr, koff2
    v3 = load kaddr2+0 as i32
    q = add s, k
    qoff = mul q, 4
    qaddr = add nptr, qoff
    store qaddr+0, v3 as i32
    knext = add k, 1
    k = knext
    jmp L_SP3_TOP
L_SP3_END:
    dst = add s, ilen
    m = 0
    jmp L_SP4_TOP
L_SP4_TOP:
    c4 = slt m, slen
    br c4 -> L_SP4_CHK, L_SP4_END
L_SP4_CHK:
    tail = sge m, sd
    br tail -> L_SP4_BODY, L_SP4_NEXT
L_SP4_BODY:
    moff = mul m, 4
    maddr = add sbuf, moff
    v4 = load maddr+0 as i32
    q2 = sub m, d
    qq2 = add q2, ilen
    qoff2 = mul qq2, 4
    qaddr2 = add nptr, qoff2
    store qaddr2+0, v4 as i32
    jmp L_SP4_NEXT
L_SP4_NEXT:
    mnext = add m, 1
    m = mnext
    jmp L_SP4_TOP
L_SP4_END:
    store src+0, nptr as ptr
    store src+8, nlen as u64
    !sbuf
    !nbuf
    !src
    !items
    !start
    !del
    return dh
// items 为插入项柄；形参值拷，用后即释不碰原槽）。
@ts_arr_tospliced(src: ptr, start: i32, del: i32, items: ptr) -> ptr:
L_TS_ENTRY:
    slen = load src+8 as u64
    ilen = load items+8 as u64
    s_slot = alloc 8
    s_neg = slt start, 0
    br s_neg -> L_TS_S_NEG, L_TS_S_POS
L_TS_S_NEG:
    s_plus = add start, slen
    s_ppos = sge s_plus, 0
    br s_ppos -> L_TS_S_KEEP, L_TS_S_ZERO
L_TS_S_KEEP:
    store s_slot+0, s_plus as i32
    jmp L_TS_S_DONE
L_TS_S_ZERO:
    store s_slot+0, 0 as i32
    jmp L_TS_S_DONE
L_TS_S_POS:
    s_lt = slt start, slen
    br s_lt -> L_TS_S_TAKE, L_TS_S_CLAMP
L_TS_S_TAKE:
    store s_slot+0, start as i32
    jmp L_TS_S_DONE
L_TS_S_CLAMP:
    store s_slot+0, slen as i32
    jmp L_TS_S_DONE
L_TS_S_DONE:
    s = load s_slot+0 as i32
    !s_slot
    d_slot = alloc 8
    d_neg = slt del, 0
    br d_neg -> L_TS_D_ZERO, L_TS_D_POS
L_TS_D_ZERO:
    store d_slot+0, 0 as i32
    jmp L_TS_D_DONE
L_TS_D_POS:
    maxdel = sub slen, s
    d_over = sgt del, maxdel
    br d_over -> L_TS_D_CLAMP, L_TS_D_TAKE
L_TS_D_CLAMP:
    store d_slot+0, maxdel as i32
    jmp L_TS_D_DONE
L_TS_D_TAKE:
    store d_slot+0, del as i32
    jmp L_TS_D_DONE
L_TS_D_DONE:
    d = load d_slot+0 as i32
    !d_slot
    ntmp = sub slen, d
    nlen = add ntmp, ilen
    nbytes = mul nlen, 4
    nbuf = alloc nbytes
    nh = alloc 16
    store nh+0, nbuf as ptr
    store nh+8, nlen as u64
    !nbuf
    sptr = load src+0 as ptr
    iptr = load items+0 as ptr
    dptr = load nh+0 as ptr
    i = 0
    jmp L_TS1_TOP
L_TS1_TOP:
    c1 = slt i, s
    br c1 -> L_TS1_BODY, L_TS1_END
L_TS1_BODY:
    soff = mul i, 4
    saddr = add sptr, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    inext = add i, 1
    i = inext
    jmp L_TS1_TOP
L_TS1_END:
    j = 0
    jmp L_TS2_TOP
L_TS2_TOP:
    c2 = slt j, ilen
    br c2 -> L_TS2_BODY, L_TS2_END
L_TS2_BODY:
    ioff = mul j, 4
    iaddr = add iptr, ioff
    v2 = load iaddr+0 as i32
    k = add s, j
    doff2 = mul k, 4
    daddr2 = add dptr, doff2
    store daddr2+0, v2 as i32
    jnext = add j, 1
    j = jnext
    jmp L_TS2_TOP
L_TS2_END:
    sd = add s, d
    dst = add s, ilen
    k2 = 0
    jmp L_TS3_TOP
L_TS3_TOP:
    c3 = slt k2, slen
    br c3 -> L_TS3_CHK, L_TS3_END
L_TS3_CHK:
    tail = sge k2, sd
    br tail -> L_TS3_BODY, L_TS3_NEXT
L_TS3_BODY:
    toff = mul k2, 4
    taddr = add sptr, toff
    v3 = load taddr+0 as i32
    q = sub k2, d
    qq = add q, ilen
    doff3 = mul qq, 4
    daddr3 = add dptr, doff3
    store daddr3+0, v3 as i32
    jmp L_TS3_NEXT
L_TS3_NEXT:
    k2next = add k2, 1
    k2 = k2next
    jmp L_TS3_TOP
L_TS3_END:
    !src
    !items
    !start
    !del
    return nh
// end 双端钳位, end<start 即空; 形参 i32; 句柄值参（调用方原槽不受影响；
// 引用传参系 move 语义，禁用于复用句柄）；返回新柄, 调用方持有.
@ts_arr_slice_copy(src: ptr, start: i32, end: i32) -> ptr:
L_ENTRY:
    slen = load src+8 as u64
    s_slot = alloc 8
    s_neg = slt start, 0
    br s_neg -> L_S_NEG, L_S_POS
L_S_NEG:
    s_plus = add start, slen
    s_pos = sge s_plus, 0
    br s_pos -> L_S_KEEP, L_S_ZERO
L_S_KEEP:
    store s_slot+0, s_plus as i32
    jmp L_S_DONE
L_S_ZERO:
    store s_slot+0, 0 as i32
    jmp L_S_DONE
L_S_POS:
    s_lt = slt start, slen
    br s_lt -> L_S_TAKE, L_S_CLAMP
L_S_TAKE:
    store s_slot+0, start as i32
    jmp L_S_DONE
L_S_CLAMP:
    store s_slot+0, slen as i32
    jmp L_S_DONE
L_S_DONE:
    s = load s_slot+0 as i32
    !s_slot
    e_slot = alloc 8
    e_neg = slt end, 0
    br e_neg -> L_E_NEG, L_E_POS
L_E_NEG:
    e_plus = add end, slen
    e_ppos = sge e_plus, 0
    br e_ppos -> L_E_KEEP, L_E_ZERO
L_E_KEEP:
    store e_slot+0, e_plus as i32
    jmp L_E_DONE
L_E_ZERO:
    store e_slot+0, 0 as i32
    jmp L_E_DONE
L_E_POS:
    e_lt = slt end, slen
    br e_lt -> L_E_TAKE, L_E_CLAMP
L_E_TAKE:
    store e_slot+0, end as i32
    jmp L_E_DONE
L_E_CLAMP:
    store e_slot+0, slen as i32
    jmp L_E_DONE
L_E_DONE:
    e = load e_slot+0 as i32
    !e_slot
    e_ge = sge e, s
    br e_ge -> L_N_OK, L_N_EMPTY
L_N_OK:
    nlen = sub e, s
    jmp L_N_DONE
L_N_EMPTY:
    nlen = 0
    jmp L_N_DONE
L_N_DONE:
    sptr = load src+0 as ptr
    nbytes = mul nlen, 4
    nbuf = alloc nbytes
    nh = alloc 16
    store nh+0, nbuf as ptr
    store nh+8, nlen as u64
    !nbuf
    dptr = load nh+0 as ptr
    i = 0
    jmp L_TOP
L_TOP:
    c = slt i, nlen
    br c -> L_BODY, L_END
L_BODY:
    si = add s, i
    soff = mul si, 4
    saddr = add sptr, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    inext = add i, 1
    i = inext
    jmp L_TOP
L_END:
    !src
    !start
    !end
    return nh

// @ts_arr_with 单点替换返新数组（负下标即 len+idx；越界原样返回；
// 新柄调用方持有；形参值拷，用后即释不碰原槽）。
@ts_arr_with(src: ptr, idx: i32, val: i32) -> ptr:
L_W_ENTRY:
    slen = load src+8 as u64
    sptr = load src+0 as ptr
    nbytes = mul slen, 4
    nbuf = alloc nbytes
    nh = alloc 16
    store nh+0, nbuf as ptr
    store nh+8, slen as u64
    !nbuf
    dptr = load nh+0 as ptr
    isneg = slt idx, 0
    adj = mul slen, isneg
    norm = add idx, adj
    i = 0
    jmp L_W_TOP
L_W_TOP:
    c = slt i, slen
    br c -> L_W_BODY, L_W_END
L_W_BODY:
    soff = mul i, 4
    saddr = add sptr, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    inext = add i, 1
    i = inext
    jmp L_W_TOP
L_W_END:
    lo = slt norm, 0
    hi = sge norm, slen
    bad = or lo, hi
    br bad -> L_W_BAD, L_W_SET
L_W_BAD:
    panic(2501)
L_W_SET:
    woff = mul norm, 4
    waddr = add dptr, woff
    store waddr+0, val as i32
    jmp L_W_FIN
L_W_FIN:
    !src
    !idx
    !val
    return nh

// @ts_arr_toreversed 逆序拷返新数组（原不动；新柄调用方持有；
// 形参值拷，用后即释不碰原槽）。
@ts_arr_toreversed(src: ptr) -> ptr:
L_TR_ENTRY:
    slen = load src+8 as u64
    sptr = load src+0 as ptr
    nbytes = mul slen, 4
    nbuf = alloc nbytes
    nh = alloc 16
    store nh+0, nbuf as ptr
    store nh+8, slen as u64
    !nbuf
    dptr = load nh+0 as ptr
    i = 0
    jmp L_TR_TOP
L_TR_TOP:
    c = slt i, slen
    br c -> L_TR_BODY, L_TR_END
L_TR_BODY:
    t = sub slen, 1
    si = sub t, i
    soff = mul si, 4
    saddr = add sptr, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    inext = add i, 1
    i = inext
    jmp L_TR_TOP
L_TR_END:
    !src
    return nh

// @ts_arr_tosorted 拷贝并数值插入排序返新数组（原不动；新柄调用方持有；
// 形参值拷，用后即释不碰原槽；与 tsgosa saLowerInsertionSort 同形）。
@ts_arr_tosorted(src: ptr) -> ptr:
L_TS_ENTRY:
    slen = load src+8 as u64
    sptr = load src+0 as ptr
    nbytes = mul slen, 4
    nbuf = alloc nbytes
    nh = alloc 16
    store nh+0, nbuf as ptr
    store nh+8, slen as u64
    !nbuf
    dptr = load nh+0 as ptr
    i = 0
    jmp L_TS_CP_TOP
L_TS_CP_TOP:
    c = slt i, slen
    br c -> L_TS_CP_BODY, L_TS_CP_END
L_TS_CP_BODY:
    soff = mul i, 4
    saddr = add sptr, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    inext = add i, 1
    i = inext
    jmp L_TS_CP_TOP
L_TS_CP_END:
    si = 1
    jmp L_TS_TOP
L_TS_TOP:
    c2 = slt si, slen
    br c2 -> L_TS_BODY, L_TS_END
L_TS_BODY:
    ioff = mul si, 4
    iaddr = add dptr, ioff
    key = load iaddr+0 as i32
    sj = sub si, 1
    jmp L_TS_IN_TOP
L_TS_IN_TOP:
    c3 = sge sj, 0
    br c3 -> L_TS_IN_CHK, L_TS_IN_END
L_TS_IN_CHK:
    joff = mul sj, 4
    jaddr = add dptr, joff
    aj = load jaddr+0 as i32
    c4 = sgt aj, key
    br c4 -> L_TS_IN_BODY, L_TS_IN_END
L_TS_IN_BODY:
    j1 = add sj, 1
    j1off = mul j1, 4
    j1addr = add dptr, j1off
    store j1addr+0, aj as i32
    jm = sub sj, 1
    sj = jm
    jmp L_TS_IN_TOP
L_TS_IN_END:
    k1 = add sj, 1
    k1off = mul k1, 4
    k1addr = add dptr, k1off
    store k1addr+0, key as i32
    snext = add si, 1
    si = snext
    jmp L_TS_TOP
L_TS_END:
    !src
    return nh

// @ts_arr_sort 原地数值插入排序（无新柄；调用方保留原柄；
// 形参 token 用后即释；与 tsgosa saLowerInsertionSort 同形）。
@ts_arr_sort(src: ptr):
L_S_ENTRY:
    slen = load src+8 as u64
    dptr = load src+0 as ptr
    si = 1
    jmp L_S_TOP
L_S_TOP:
    c2 = slt si, slen
    br c2 -> L_S_BODY, L_S_END
L_S_BODY:
    ioff = mul si, 4
    iaddr = add dptr, ioff
    key = load iaddr+0 as i32
    sj = sub si, 1
    jmp L_S_IN_TOP
L_S_IN_TOP:
    c3 = sge sj, 0
    br c3 -> L_S_IN_CHK, L_S_IN_END
L_S_IN_CHK:
    joff = mul sj, 4
    jaddr = add dptr, joff
    aj = load jaddr+0 as i32
    c4 = sgt aj, key
    br c4 -> L_S_IN_BODY, L_S_IN_END
L_S_IN_BODY:
    j1 = add sj, 1
    j1off = mul j1, 4
    j1addr = add dptr, j1off
    store j1addr+0, aj as i32
    jm = sub sj, 1
    sj = jm
    jmp L_S_IN_TOP
L_S_IN_END:
    k1 = add sj, 1
    k1off = mul k1, 4
    k1addr = add dptr, k1off
    store k1addr+0, key as i32
    snext = add si, 1
    si = snext
    jmp L_S_TOP
L_S_END:
    !src
    ret

// @ts_arr_reverse 原地对称交换（无新柄；调用方保留原柄；
// 形参 token 用后即释；与 tsgosa saLowerArrayReverse 同形）。
@ts_arr_reverse(src: ptr):
L_RV_ENTRY:
    slen = load src+8 as u64
    dptr = load src+0 as ptr
    half = div slen, 2
    i = 0
    jmp L_RV_TOP
L_RV_TOP:
    c = slt i, half
    br c -> L_RV_BODY, L_RV_END
L_RV_BODY:
    t = sub slen, 1
    j = sub t, i
    aoff = mul i, 4
    aaddr = add dptr, aoff
    boff = mul j, 4
    baddr = add dptr, boff
    a = load aaddr+0 as i32
    b = load baddr+0 as i32
    store aaddr+0, b as i32
    store baddr+0, a as i32
    inext = add i, 1
    i = inext
    jmp L_RV_TOP
L_RV_END:
    !src
    ret

// @ts_arr_fill 全域值填充（无新柄；调用方保留原柄；
// 形参 token 用后即释；与 satsgo lowerArrayFill:6257 全域同形）。
@ts_arr_fill(src: ptr, val: i32):
L_FL_ENTRY:
    slen = load src+8 as u64
    dptr = load src+0 as ptr
    i = 0
    jmp L_FL_TOP
L_FL_TOP:
    c = slt i, slen
    br c -> L_FL_BODY, L_FL_END
L_FL_BODY:
    off = mul i, 4
    addr = add dptr, off
    store addr+0, val as i32
    inext = add i, 1
    i = inext
    jmp L_FL_TOP
L_FL_END:
    !src
    !val
    ret

// @ts_arr_scan 相等扫描（index 系回位/-1，includes 回 1/0；
// hasfrom=0 即缺省（正向 0/逆向末位），否则 from 全量钳位；
// 钳位与 `ts_array.sa` 内 slice/splice 系列同形；形状证据：
// 封存 lowerArrayScan:6444-6513）。
@ts_arr_scan(src: ptr, want: i32, from: i32, hasfrom: i32, rev: i32, wantidx: i32) -> i32:
L_Q_ENTRY:
    slen = load src+8 as u64
    dptr = load src+0 as ptr
    s_slot = alloc 8
    hf = ne hasfrom, 0
    br hf -> L_Q_CLAMP, L_Q_DEFLT
L_Q_DEFLT:
    rv0 = ne rev, 0
    br rv0 -> L_Q_LAST, L_Q_ZERO
L_Q_LAST:
    lm1 = sub slen, 1
    store s_slot+0, lm1 as i32
    jmp L_Q_GOT
L_Q_ZERO:
    store s_slot+0, 0 as i32
    jmp L_Q_GOT
L_Q_CLAMP:
    fneg = slt from, 0
    br fneg -> L_Q_NEG, L_Q_POS
L_Q_NEG:
    fplus = add from, slen
    fpos = sge fplus, 0
    br fpos -> L_Q_KEEP, L_Q_FZERO
L_Q_KEEP:
    store s_slot+0, fplus as i32
    jmp L_Q_GOT
L_Q_FZERO:
    store s_slot+0, 0 as i32
    jmp L_Q_GOT
L_Q_POS:
    flt = slt from, slen
    br flt -> L_Q_TAKE, L_Q_CMP
L_Q_TAKE:
    store s_slot+0, from as i32
    jmp L_Q_GOT
L_Q_CMP:
    store s_slot+0, slen as i32
    jmp L_Q_GOT
L_Q_GOT:
    start = load s_slot+0 as i32
    !s_slot
    wi = ne wantidx, 0
    br wi -> L_Q_M1, L_Q_Z1
L_Q_M1:
    res = -1
    jmp L_Q_INIT
L_Q_Z1:
    res = 0
    jmp L_Q_INIT
L_Q_INIT:
    i = add start, 0
    jmp L_Q_TOP
L_Q_TOP:
    rv1 = ne rev, 0
    br rv1 -> L_Q_BCOND, L_Q_FCOND
L_Q_FCOND:
    c = slt i, slen
    br c -> L_Q_BODY, L_Q_END
L_Q_BCOND:
    c2 = sge i, 0
    br c2 -> L_Q_BODY, L_Q_END
L_Q_BODY:
    off = mul i, 4
    addr = add dptr, off
    cur = load addr+0 as i32
    eq = eq cur, want
    br eq -> L_Q_HIT, L_Q_NEXT
L_Q_HIT:
    wi2 = ne wantidx, 0
    br wi2 -> L_Q_AT, L_Q_ONE
L_Q_AT:
    res = add i, 0
    jmp L_Q_END
L_Q_ONE:
    res = 1
    jmp L_Q_END
L_Q_NEXT:
    rv2 = ne rev, 0
    br rv2 -> L_Q_DEC, L_Q_INC
L_Q_INC:
    step = add i, 1
    i = step
    jmp L_Q_TOP
L_Q_DEC:
    step2 = sub i, 1
    i = step2
    jmp L_Q_TOP
L_Q_END:
    !src
    !want
    !from
    !hasfrom
    !rev
    !wantidx
    return res

// @ts_arr_pop 末端取值并缩长（返 i32；调用方保留原柄；
// 形状证据：封存 lowerArrayPop:上游 saemit.go:6162）。
@ts_arr_pop(src: ptr) -> i32:
L_P_ENTRY:
    slen = load src+8 as u64
    last = sub slen, 1
    dptr = load src+0 as ptr
    off = mul last, 4
    addr = add dptr, off
    out = load addr+0 as i32
    store src+8, last as u64
    !src
    return out

// @ts_arr_shift 首端取值并前移缩长（返 i32；调用方保留原柄；
// 形状证据：封存 lowerArrayShift:上游 saemit.go:6178）。
@ts_arr_shift(src: ptr) -> i32:
L_SH_ENTRY:
    slen = load src+8 as u64
    dptr = load src+0 as ptr
    out = load dptr+0 as i32
    nlen = sub slen, 1
    i = 0
    jmp L_SH_TOP
L_SH_TOP:
    c = slt i, nlen
    br c -> L_SH_BODY, L_SH_END
L_SH_BODY:
    s = add i, 1
    soff = mul s, 4
    saddr = add dptr, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    inext = add i, 1
    i = inext
    jmp L_SH_TOP
L_SH_END:
    store src+8, nlen as u64
    !src
    return out

// @ts_arr_copywithin 交叠安全方向拷贝（无新柄；end 缺省即全长；
// 钳位与 slice 系列同形三份内联；形状证据：封存 lowerCopyWithin:6717-6798）。
@ts_arr_copywithin(src: ptr, target: i32, start: i32, end: i32, hasend: i32):
L_CW_ENTRY:
    slen = load src+8 as u64
    dptr = load src+0 as ptr
    t_neg = slt target, 0
    br t_neg -> L_CW_TN, L_CW_TP
L_CW_TN:
    t_adj = add slen, target
    jmp L_CW_TE
L_CW_TP:
    t_adj = add target, 0
    jmp L_CW_TE
L_CW_TE:
    t_lo = slt t_adj, 0
    br t_lo -> L_CW_TLO, L_CW_TMD
L_CW_TLO:
    tc = 0
    jmp L_CW_TOK
L_CW_TMD:
    t_hi = sgt t_adj, slen
    br t_hi -> L_CW_THI, L_CW_TKP
L_CW_THI:
    tc = add slen, 0
    jmp L_CW_TOK
L_CW_TKP:
    tc = add t_adj, 0
    jmp L_CW_TOK
L_CW_TOK:
    s_neg = slt start, 0
    br s_neg -> L_CW_SN, L_CW_SP
L_CW_SN:
    s_adj = add slen, start
    jmp L_CW_SE
L_CW_SP:
    s_adj = add start, 0
    jmp L_CW_SE
L_CW_SE:
    s_lo = slt s_adj, 0
    br s_lo -> L_CW_SLO, L_CW_SMD
L_CW_SLO:
    sc = 0
    jmp L_CW_SOK
L_CW_SMD:
    s_hi = sgt s_adj, slen
    br s_hi -> L_CW_SHI, L_CW_SKP
L_CW_SHI:
    sc = add slen, 0
    jmp L_CW_SOK
L_CW_SKP:
    sc = add s_adj, 0
    jmp L_CW_SOK
L_CW_SOK:
    he = ne hasend, 0
    br he -> L_CW_EC, L_CW_EL
L_CW_EL:
    fc = add slen, 0
    jmp L_CW_EOK
L_CW_EC:
    e_neg = slt end, 0
    br e_neg -> L_CW_EN, L_CW_EP
L_CW_EN:
    e_adj = add slen, end
    jmp L_CW_EE
L_CW_EP:
    e_adj = add end, 0
    jmp L_CW_EE
L_CW_EE:
    e_lo = slt e_adj, 0
    br e_lo -> L_CW_ELO, L_CW_EMD
L_CW_ELO:
    fc = 0
    jmp L_CW_EOK
L_CW_EMD:
    e_hi = sgt e_adj, slen
    br e_hi -> L_CW_EHI, L_CW_EKP
L_CW_EHI:
    fc = add slen, 0
    jmp L_CW_EOK
L_CW_EKP:
    fc = add e_adj, 0
    jmp L_CW_EOK
L_CW_EOK:
    span = sub fc, sc
    room = sub slen, tc
    pick = slt span, room
    br pick -> L_CW_MS, L_CW_MR
L_CW_MS:
    count = add span, 0
    jmp L_CW_MC
L_CW_MR:
    count = add room, 0
    jmp L_CW_MC
L_CW_MC:
    go = sgt count, 0
    br go -> L_CW_RUN, L_CW_SKIP
L_CW_RUN:
    fwd = slt tc, sc
    br fwd -> L_CW_FI, L_CW_BT
L_CW_FI:
    i = 0
    jmp L_CW_FT
L_CW_FT:
    c = slt i, count
    br c -> L_CW_FB, L_CW_FE
L_CW_FB:
    fsi = add sc, i
    fso = mul fsi, 4
    fsa = add dptr, fso
    fcur = load fsa+0 as i32
    fdi = add tc, i
    fdof = mul fdi, 4
    fda = add dptr, fdof
    store fda+0, fcur as i32
    finext = add i, 1
    i = finext
    jmp L_CW_FT
L_CW_FE:
    jmp L_CW_SKIP
L_CW_BT:
    j = sub count, 1
    jmp L_CW_BC
L_CW_BC:
    bc = sge j, 0
    br bc -> L_CW_BB, L_CW_BE
L_CW_BB:
    bsi = add sc, j
    bso = mul bsi, 4
    bsa = add dptr, bso
    bcur = load bsa+0 as i32
    bdi = add tc, j
    bdof = mul bdi, 4
    bda = add dptr, bdof
    store bda+0, bcur as i32
    jn = sub j, 1
    j = jn
    jmp L_CW_BC
L_CW_BE:
    jmp L_CW_SKIP
L_CW_SKIP:
    !src
    !target
    !start
    !end
    !hasend
    ret

// @ts_arr_rotr1 右旋一步（末槽复制语义由调用方扩展保证；
// 调用方保留原柄；unshift 后半段形状）。
@ts_arr_rotr1(src: ptr):
L_RR_ENTRY:
    slen = load src+8 as u64
    dptr = load src+0 as ptr
    i = sub slen, 1
    jmp L_RR_TOP
L_RR_TOP:
    c = sgt i, 0
    br c -> L_RR_BODY, L_RR_END
L_RR_BODY:
    prev = sub i, 1
    soff = mul prev, 4
    saddr = add dptr, soff
    v = load saddr+0 as i32
    doff = mul i, 4
    daddr = add dptr, doff
    store daddr+0, v as i32
    i = prev
    jmp L_RR_TOP
L_RR_END:
    !src
    ret
