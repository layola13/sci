// SA-facing contracts for the std::thread runtime facade.
// Handles are opaque i32 slots owned by the Zig-backed sa_std runtime.
@extern pthread_spawn(*entry: ptr, *arg: ptr) -> i32
@extern pthread_spawn_detached(*entry: ptr, *arg: ptr) -> i32
@extern pthread_join(handle: i32, *out: ptr) -> i32
@extern pthread_drop(handle: i32) -> void
@extern sa_thread_current_id() -> u64
@extern sa_thread_yield_now() -> i32
@extern sa_thread_as_pthread_t(handle: i32, &out_raw: ptr) -> i32
@extern sa_thread_into_pthread_t(handle: i32, &out_raw: ptr) -> i32
@extern sa_thread_raw_pthread_join(raw: u64, *out: ptr) -> i32
