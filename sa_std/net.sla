// SLA-facing named constants for the sa_std.net address families:
// the values sa_net_addr_family (sa_std/net.sai) returns for an
// owned NetAddr, and the values the net.sa address macros produce.
//
// Why this file exists, and why it lives at the sa_std root: the
// names have always existed at the SA layer -- sa_std/net.sal
// defines SA_NET_AF_UNSPEC / SA_NET_AF_INET / SA_NET_AF_INET6 and
// the .sa macros and unit-framework tests compare against them --
// but an SLA consumer importing net.sai saw only the bare u32 and
// had to hard-code 2 / 10. Worse, net.sal used to publish look-alike
// SA_NET_AF_IPV4 = 4 / SA_NET_AF_IPV6 = 6 next to them: those were
// sa_std-internal address-KIND numbers (the concrete IpAddr layout
// tags, cf. NET_IP_ADDR_V4 / NET_IP_ADDR_V6 in net.sal), not address
// families at all, and comparing one against a sa_net_addr_family
// result silently never matches. The internal pair was renamed
// SA_NET_ADDR_KIND_IPV4 / SA_NET_ADDR_KIND_IPV6 on 2026-10-27
// (dual-definition trap resolution), and this file publishes the
// family face for SLA. These consts are pure declarations: no new
// externs, no ABI change.
//
// Values: the runtime stores and returns these exact numbers on
// every platform (src/runtime/sa_std.zig sa_net_addr_family and
// its sa_std_windows.zig mirror return the stored family field;
// the Linux unit tests pin 2 for an IPv4 peer). They equal the
// Linux AF_* values: AF_UNSPEC = 0, AF_INET = 2, AF_INET6 = 10.

const SA_NET_AF_UNSPEC: u32 = 0;
const SA_NET_AF_INET: u32 = 2;
const SA_NET_AF_INET6: u32 = 10;

// SLA-facing named constants for the sa_net_unix_addr_kind values
// (sa_std/net.sai: sa_net_unix_addr_kind(addr) -> u32). The names
// exist at the SA layer (sa_std/net.sal: SA_NET_UNIX_ADDR_UNNAMED
// = 0 / SA_NET_UNIX_ADDR_PATHNAME = 1 / SA_NET_UNIX_ADDR_ABSTRACT
// = 2) but, like the AF face above, were invisible to SLA
// consumers, who hard-coded the numbers. Pure declarations.

const SA_NET_UNIX_ADDR_UNNAMED: u32 = 0;
const SA_NET_UNIX_ADDR_PATHNAME: u32 = 1;
const SA_NET_UNIX_ADDR_ABSTRACT: u32 = 2;

// SLA-facing named constants for socket option levels and names:
// the Linux setsockopt(2) numbering, published ahead of the
// generic setsockopt/getsockopt passthrough (registered as the
// highest-value single gap by the Python net census) so the
// passthrough, when it lands, takes named values whose numbering
// is already pinned. This is a core subset, not the full
// SocketOptionName surface (.NET names 50): SOL_SOCKET basics,
// SO_PEERCRED (named by the Java census for unix peer credentials),
// TCP keepalive/Nagle/fast-open, IP multicast/TTL/pktinfo, IPv6
// multicast/V6ONLY. Values verified against the build host's
// <asm-generic/socket.h>, <linux/tcp.h>, <linux/in.h>,
// <linux/in6.h> and <netinet/in.h> when this file was written;
// they are the asm-generic (x86_64) Linux values. Pure
// declarations: no new externs, no ABI change.

// levels (IPPROTO_* / SOL_SOCKET)
const SA_NET_SOCKOPT_LEVEL_IP: u32 = 0;
const SA_NET_SOCKOPT_LEVEL_SOCKET: u32 = 1;
const SA_NET_SOCKOPT_LEVEL_TCP: u32 = 6;
const SA_NET_SOCKOPT_LEVEL_UDP: u32 = 17;
const SA_NET_SOCKOPT_LEVEL_IPV6: u32 = 41;

// SOL_SOCKET options
const SA_NET_SO_DEBUG: u32 = 1;
const SA_NET_SO_REUSEADDR: u32 = 2;
const SA_NET_SO_TYPE: u32 = 3;
const SA_NET_SO_ERROR: u32 = 4;
const SA_NET_SO_DONTROUTE: u32 = 5;
const SA_NET_SO_BROADCAST: u32 = 6;
const SA_NET_SO_SNDBUF: u32 = 7;
const SA_NET_SO_RCVBUF: u32 = 8;
const SA_NET_SO_KEEPALIVE: u32 = 9;
const SA_NET_SO_OOBINLINE: u32 = 10;
const SA_NET_SO_LINGER: u32 = 13;
const SA_NET_SO_REUSEPORT: u32 = 15;
const SA_NET_SO_PEERCRED: u32 = 17;
const SA_NET_SO_RCVLOWAT: u32 = 18;
const SA_NET_SO_SNDLOWAT: u32 = 19;
const SA_NET_SO_RCVTIMEO: u32 = 20;
const SA_NET_SO_SNDTIMEO: u32 = 21;
const SA_NET_SO_ACCEPTCONN: u32 = 30;

// IPPROTO_TCP options
const SA_NET_TCP_NODELAY: u32 = 1;
const SA_NET_TCP_MAXSEG: u32 = 2;
const SA_NET_TCP_CORK: u32 = 3;
const SA_NET_TCP_KEEPIDLE: u32 = 4;
const SA_NET_TCP_KEEPINTVL: u32 = 5;
const SA_NET_TCP_KEEPCNT: u32 = 6;
const SA_NET_TCP_FASTOPEN: u32 = 23;

// IPPROTO_IP options
const SA_NET_IP_TOS: u32 = 1;
const SA_NET_IP_TTL: u32 = 2;
const SA_NET_IP_HDRINCL: u32 = 3;
const SA_NET_IP_PKTINFO: u32 = 8;
const SA_NET_IP_MULTICAST_IF: u32 = 32;
const SA_NET_IP_MULTICAST_TTL: u32 = 33;
const SA_NET_IP_MULTICAST_LOOP: u32 = 34;
const SA_NET_IP_ADD_MEMBERSHIP: u32 = 35;
const SA_NET_IP_DROP_MEMBERSHIP: u32 = 36;

// IPPROTO_IPV6 options
const SA_NET_IPV6_MULTICAST_IF: u32 = 17;
const SA_NET_IPV6_MULTICAST_HOPS: u32 = 18;
const SA_NET_IPV6_MULTICAST_LOOP: u32 = 19;
const SA_NET_IPV6_ADD_MEMBERSHIP: u32 = 20;
const SA_NET_IPV6_DROP_MEMBERSHIP: u32 = 21;
const SA_NET_IPV6_V6ONLY: u32 = 26;

// Wave-2 completion of the set above (same provenance: the build
// host's <asm-generic/socket.h> and <linux/in6.h>): the options the
// generic passthrough and the datagram receive surface
// (sa_std_net_socket_* / sa_std_net_udp_recv_msg in net.sai, landed
// with the passthrough) need named. SO_PASSCRED gates SCM_CREDENTIALS
// delivery on unix sockets; SO_TIMESTAMP gates the receive-timestamp
// control message sa_std_net_udp_recv_msg parses; for IPv6 the
// receive-side switch is IPV6_RECVPKTINFO while the control message
// itself is typed IPV6_PKTINFO (the IPPROTO_IP pair is one number:
// SA_NET_IP_PKTINFO above serves both roles).
const SA_NET_SO_PASSCRED: u32 = 16;
const SA_NET_SO_TIMESTAMP: u32 = 29;
const SA_NET_IPV6_RECVPKTINFO: u32 = 49;
const SA_NET_IPV6_PKTINFO: u32 = 50;

// out_flags bits of sa_std_net_udp_recv_msg (net.sai): which
// per-packet info a receive actually carried, and whether the
// kernel truncated the control data (CTRUNC) or the datagram
// itself (TRUNC). These are sa_std's own bit assignments, not OS
// numbers.
const SA_NET_RECV_MSG_PKTINFO: u32 = 1;
const SA_NET_RECV_MSG_TIMESTAMP: u32 = 2;
const SA_NET_RECV_MSG_CTRUNC: u32 = 4;
const SA_NET_RECV_MSG_TRUNC: u32 = 8;
