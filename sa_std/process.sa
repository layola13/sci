@import "process.sal"
@import "process.sai"
@import "fs.sa"
@import "core/slice.sal"

[MACRO] PROCESS_STATUS_IS_OK %out_bool, %status
    %out_bool = eq %status, SA_PROCESS_OK
[END_MACRO]

[MACRO] PROCESS_EXIT_SUCCESS %out_bool, %code
    %out_bool = eq %code, 0
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_NEW %exit_status, %code
    store %exit_status+ProcessExitStatus_code, %code as u32
    store %exit_status+ProcessExitStatus_raw, 0 as i32
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_FROM_RAW %exit_status, %raw
    __process_exit_status_code_%exit_status = call @sa_std_process_exit_status_code(%raw)
    store %exit_status+ProcessExitStatus_code, __process_exit_status_code_%exit_status as u32
    store %exit_status+ProcessExitStatus_raw, %raw as i32
    !__process_exit_status_code_%exit_status
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_CODE %out_code, %exit_status
    %out_code = load %exit_status+ProcessExitStatus_code as u32
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_RAW %out_raw, %exit_status
    %out_raw = load %exit_status+ProcessExitStatus_raw as i32
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_SUCCESS %out_bool, %exit_status
    EXPAND PROCESS_EXIT_STATUS_CODE __process_exit_status_code_%out_bool, %exit_status
    EXPAND PROCESS_EXIT_SUCCESS %out_bool, __process_exit_status_code_%out_bool
    !__process_exit_status_code_%out_bool
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_SIGNAL %out_signal, %exit_status
    EXPAND PROCESS_EXIT_STATUS_RAW __process_exit_status_raw_%out_signal, %exit_status
    %out_signal = call @sa_std_process_exit_status_signal(__process_exit_status_raw_%out_signal)
    !__process_exit_status_raw_%out_signal
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_COREDUMPED %out_flag, %exit_status
    EXPAND PROCESS_EXIT_STATUS_RAW __process_exit_status_raw_%out_flag, %exit_status
    %out_flag = call @sa_std_process_exit_status_core_dumped(__process_exit_status_raw_%out_flag)
    !__process_exit_status_raw_%out_flag
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_STOPPED_SIGNAL %out_signal, %exit_status
    EXPAND PROCESS_EXIT_STATUS_RAW __process_exit_status_raw_%out_signal, %exit_status
    %out_signal = call @sa_std_process_exit_status_stopped_signal(__process_exit_status_raw_%out_signal)
    !__process_exit_status_raw_%out_signal
[END_MACRO]

[MACRO] PROCESS_EXIT_STATUS_CONTINUED %out_flag, %exit_status
    EXPAND PROCESS_EXIT_STATUS_RAW __process_exit_status_raw_%out_flag, %exit_status
    %out_flag = call @sa_std_process_exit_status_continued(__process_exit_status_raw_%out_flag)
    !__process_exit_status_raw_%out_flag
[END_MACRO]

[MACRO] PROCESS_OUTPUT_NEW %output, %exit_status, %stdout_buffer, %stderr_buffer
    store %output+ProcessOutput_status, %exit_status as ptr
    store %output+ProcessOutput_stdout, %stdout_buffer as u64
    store %output+ProcessOutput_stderr, %stderr_buffer as u64
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STATUS_PTR %out_ptr, %output
    %out_ptr = load %output+ProcessOutput_status as ptr
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDOUT_BUFFER %out_buffer, %output
    %out_buffer = load %output+ProcessOutput_stdout as u64
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDERR_BUFFER %out_buffer, %output
    %out_buffer = load %output+ProcessOutput_stderr as u64
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDOUT_DATA %out_ptr, %output
    EXPAND PROCESS_OUTPUT_STDOUT_BUFFER __process_output_stdout_%out_ptr, %output
    EXPAND FS_READ_BUFFER_DATA %out_ptr, __process_output_stdout_%out_ptr
    !__process_output_stdout_%out_ptr
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDOUT_LEN %out_len, %output
    EXPAND PROCESS_OUTPUT_STDOUT_BUFFER __process_output_stdout_%out_len, %output
    EXPAND FS_READ_BUFFER_LEN %out_len, __process_output_stdout_%out_len
    !__process_output_stdout_%out_len
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDERR_DATA %out_ptr, %output
    EXPAND PROCESS_OUTPUT_STDERR_BUFFER __process_output_stderr_%out_ptr, %output
    EXPAND FS_READ_BUFFER_DATA %out_ptr, __process_output_stderr_%out_ptr
    !__process_output_stderr_%out_ptr
[END_MACRO]

[MACRO] PROCESS_OUTPUT_STDERR_LEN %out_len, %output
    EXPAND PROCESS_OUTPUT_STDERR_BUFFER __process_output_stderr_%out_len, %output
    EXPAND FS_READ_BUFFER_LEN %out_len, __process_output_stderr_%out_len
    !__process_output_stderr_%out_len
[END_MACRO]

[MACRO] PROCESS_OUTPUT_FREE %out_status, %output
    EXPAND PROCESS_OUTPUT_STDOUT_BUFFER __process_output_free_stdout_%out_status, %output
    EXPAND PROCESS_OUTPUT_STDERR_BUFFER __process_output_free_stderr_%out_status, %output
    EXPAND FS_READ_BUFFER_FREE __process_output_free_stdout_status_%out_status, __process_output_free_stdout_%out_status
    EXPAND FS_READ_BUFFER_FREE __process_output_free_stderr_status_%out_status, __process_output_free_stderr_%out_status
    __process_output_free_stdout_ok_%out_status = eq __process_output_free_stdout_status_%out_status, SA_PROCESS_OK
    __process_output_free_stderr_ok_%out_status = eq __process_output_free_stderr_status_%out_status, SA_PROCESS_OK
    __process_output_free_both_ok_%out_status = and __process_output_free_stdout_ok_%out_status, __process_output_free_stderr_ok_%out_status
    br __process_output_free_both_ok_%out_status -> L_PROCESS_OUTPUT_FREE_OK_%out_status, L_PROCESS_OUTPUT_FREE_ERR_%out_status

L_PROCESS_OUTPUT_FREE_OK_%out_status:
    %out_status = add 0, SA_PROCESS_OK
    !__process_output_free_both_ok_%out_status
    !__process_output_free_stderr_ok_%out_status
    !__process_output_free_stdout_ok_%out_status
    !__process_output_free_stderr_status_%out_status
    !__process_output_free_stdout_status_%out_status
    jmp L_PROCESS_OUTPUT_FREE_DONE_%out_status

L_PROCESS_OUTPUT_FREE_ERR_%out_status:
    %out_status = add 0, SA_PROCESS_ERR_IO
    !__process_output_free_both_ok_%out_status
    !__process_output_free_stderr_ok_%out_status
    !__process_output_free_stdout_ok_%out_status
    !__process_output_free_stderr_status_%out_status
    !__process_output_free_stdout_status_%out_status

L_PROCESS_OUTPUT_FREE_DONE_%out_status:
[END_MACRO]

[MACRO] PROCESS_ARGV_SLOT %out_ptr, %argv, %index
    __process_argv_off_%out_ptr = mul %index, SaProcessArgv_SIZE
    %out_ptr = ptr_add %argv, __process_argv_off_%out_ptr
    !__process_argv_off_%out_ptr
[END_MACRO]

[MACRO] PROCESS_ARGV_SET_CONST %argv, %index, %const_label, %const_len
    EXPAND PROCESS_ARGV_SLOT __process_argv_slot_%argv_%index, %argv, %index
    store __process_argv_slot_%argv_%index+SaProcessArgv_data, &%const_label as ptr
    store __process_argv_slot_%argv_%index+SaProcessArgv_len, %const_len as u64
    !__process_argv_slot_%argv_%index
[END_MACRO]

[MACRO] PROCESS_ARGV_SET_PTR %argv, %index, %data_ptr, %data_len
    EXPAND PROCESS_ARGV_SLOT __process_argv_slot_%argv_%index, %argv, %index
    store __process_argv_slot_%argv_%index+SaProcessArgv_data, %data_ptr as ptr
    store __process_argv_slot_%argv_%index+SaProcessArgv_len, %data_len as u64
    !__process_argv_slot_%argv_%index
[END_MACRO]

[MACRO] PROCESS_ARGV_SET_SLICE %argv, %index, %slice_reg
    __process_argv_slice_ptr_%argv_%index = load %slice_reg+Slice_ptr as ptr
    __process_argv_slice_len_%argv_%index = load %slice_reg+Slice_len as u64
    EXPAND PROCESS_ARGV_SET_PTR %argv, %index, __process_argv_slice_ptr_%argv_%index, __process_argv_slice_len_%argv_%index
    !__process_argv_slice_len_%argv_%index
    !__process_argv_slice_ptr_%argv_%index
[END_MACRO]

[MACRO] PROCESS_ARGV_DATA %out_ptr, %argv, %index
    EXPAND PROCESS_ARGV_SLOT __process_argv_slot_%out_ptr, %argv, %index
    %out_ptr = load __process_argv_slot_%out_ptr+SaProcessArgv_data as ptr
    !__process_argv_slot_%out_ptr
[END_MACRO]

[MACRO] PROCESS_ARGV_LEN %out_len, %argv, %index
    EXPAND PROCESS_ARGV_SLOT __process_argv_slot_%out_len, %argv, %index
    %out_len = load __process_argv_slot_%out_len+SaProcessArgv_len as u64
    !__process_argv_slot_%out_len
[END_MACRO]

[MACRO] PROCESS_RUN %out_status, %out_process, %argv, %argv_len
    __process_run_slot_%out_process = stack_alloc 8
    %out_status = call @sa_std_process_run(&%argv, %argv_len, &__process_run_slot_%out_process)
    %out_process = load __process_run_slot_%out_process+0 as u64
[END_MACRO]

[MACRO] PROCESS_RUN_CWD %out_status, %out_process, %argv, %argv_len, %cwd, %cwd_len
    __process_run_cwd_slot_%out_process = stack_alloc 8
    %out_status = call @sa_std_process_run_cwd(&%argv, %argv_len, &%cwd, %cwd_len, &__process_run_cwd_slot_%out_process)
    %out_process = load __process_run_cwd_slot_%out_process+0 as u64
[END_MACRO]

[MACRO] PROCESS_SPAWN %out_status, %out_process, %argv, %argv_len
    __process_spawn_slot_%out_process = stack_alloc 8
    %out_status = call @sa_std_process_spawn(&%argv, %argv_len, &__process_spawn_slot_%out_process)
    %out_process = load __process_spawn_slot_%out_process+0 as u64
[END_MACRO]

[MACRO] PROCESS_SPAWN_CWD %out_status, %out_process, %argv, %argv_len, %cwd, %cwd_len
    __process_spawn_cwd_slot_%out_process = stack_alloc 8
    %out_status = call @sa_std_process_spawn_cwd(&%argv, %argv_len, &%cwd, %cwd_len, &__process_spawn_cwd_slot_%out_process)
    %out_process = load __process_spawn_cwd_slot_%out_process+0 as u64
[END_MACRO]

[MACRO] PROCESS_SPAWN_STREAM %out_status, %out_process, %out_stdout, %out_stderr, %argv, %argv_len
    __process_stream_proc_slot_%out_process = stack_alloc 8
    __process_stream_stdout_slot_%out_stdout = stack_alloc 8
    __process_stream_stderr_slot_%out_stderr = stack_alloc 8
    %out_status = call @sa_std_process_spawn_stream(&%argv, %argv_len, &__process_stream_proc_slot_%out_process, &__process_stream_stdout_slot_%out_stdout, &__process_stream_stderr_slot_%out_stderr)
    %out_process = load __process_stream_proc_slot_%out_process+0 as u64
    %out_stdout = load __process_stream_stdout_slot_%out_stdout+0 as u64
    %out_stderr = load __process_stream_stderr_slot_%out_stderr+0 as u64
[END_MACRO]

[MACRO] PROCESS_SPAWN_STREAM_CWD %out_status, %out_process, %out_stdout, %out_stderr, %argv, %argv_len, %cwd, %cwd_len
    __process_stream_cwd_proc_slot_%out_process = stack_alloc 8
    __process_stream_cwd_stdout_slot_%out_stdout = stack_alloc 8
    __process_stream_cwd_stderr_slot_%out_stderr = stack_alloc 8
    %out_status = call @sa_std_process_spawn_stream_cwd(&%argv, %argv_len, &%cwd, %cwd_len, &__process_stream_cwd_proc_slot_%out_process, &__process_stream_cwd_stdout_slot_%out_stdout, &__process_stream_cwd_stderr_slot_%out_stderr)
    %out_process = load __process_stream_cwd_proc_slot_%out_process+0 as u64
    %out_stdout = load __process_stream_cwd_stdout_slot_%out_stdout+0 as u64
    %out_stderr = load __process_stream_cwd_stderr_slot_%out_stderr+0 as u64
[END_MACRO]

[MACRO] PROCESS_RUN_COMMAND_EXT %out_status, %out_process, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid
    __process_run_ext_slot_%out_process = stack_alloc 8
    %out_status = call @sa_std_process_run_command_ext(&%argv, %argv_len, &%cwd, %cwd_len, %has_cwd, &%arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid, &__process_run_ext_slot_%out_process)
    %out_process = load __process_run_ext_slot_%out_process+0 as u64
[END_MACRO]

[MACRO] PROCESS_SPAWN_COMMAND_EXT %out_status, %out_process, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid
    __process_spawn_ext_slot_%out_process = stack_alloc 8
    %out_status = call @sa_std_process_spawn_command_ext(&%argv, %argv_len, &%cwd, %cwd_len, %has_cwd, &%arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid, &__process_spawn_ext_slot_%out_process)
    %out_process = load __process_spawn_ext_slot_%out_process+0 as u64
[END_MACRO]

[MACRO] PROCESS_SPAWN_STREAM_COMMAND_EXT %out_status, %out_process, %out_stdout, %out_stderr, %argv, %argv_len, %cwd, %cwd_len, %has_cwd, %arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid
    __process_stream_ext_proc_slot_%out_process = stack_alloc 8
    __process_stream_ext_stdout_slot_%out_stdout = stack_alloc 8
    __process_stream_ext_stderr_slot_%out_stderr = stack_alloc 8
    %out_status = call @sa_std_process_spawn_stream_command_ext(&%argv, %argv_len, &%cwd, %cwd_len, %has_cwd, &%arg0, %arg0_len, %has_arg0, %process_group, %has_process_group, %setsid, &__process_stream_ext_proc_slot_%out_process, &__process_stream_ext_stdout_slot_%out_stdout, &__process_stream_ext_stderr_slot_%out_stderr)
    %out_process = load __process_stream_ext_proc_slot_%out_process+0 as u64
    %out_stdout = load __process_stream_ext_stdout_slot_%out_stdout+0 as u64
    %out_stderr = load __process_stream_ext_stderr_slot_%out_stderr+0 as u64
[END_MACRO]

[MACRO] PROCESS_RUN_ARG0 %out_status, %out_process, %argv, %argv_len, %arg0, %arg0_len
    __process_run_arg0_dummy_%out_process = stack_alloc 1
    EXPAND PROCESS_RUN_COMMAND_EXT %out_status, %out_process, %argv, %argv_len, __process_run_arg0_dummy_%out_process, 0, 0, %arg0, %arg0_len, 1, 0, 0, 0
[END_MACRO]

[MACRO] PROCESS_RUN_PROCESS_GROUP %out_status, %out_process, %argv, %argv_len, %process_group
    __process_run_pgroup_dummy_%out_process = stack_alloc 1
    EXPAND PROCESS_RUN_COMMAND_EXT %out_status, %out_process, %argv, %argv_len, __process_run_pgroup_dummy_%out_process, 0, 0, __process_run_pgroup_dummy_%out_process, 0, 0, %process_group, 1, 0
[END_MACRO]

[MACRO] PROCESS_RUN_SETSID %out_status, %out_process, %argv, %argv_len
    __process_run_setsid_dummy_%out_process = stack_alloc 1
    EXPAND PROCESS_RUN_COMMAND_EXT %out_status, %out_process, %argv, %argv_len, __process_run_setsid_dummy_%out_process, 0, 0, __process_run_setsid_dummy_%out_process, 0, 0, 0, 0, 1
[END_MACRO]

[MACRO] PROCESS_ID %out_pid
    %out_pid = call @sa_std_process_id()
[END_MACRO]

[MACRO] PROCESS_PARENT_ID %out_pid
    %out_pid = call @sa_std_process_parent_id()
[END_MACRO]

[MACRO] PROCESS_ABORT
    call @sa_std_process_abort()
[END_MACRO]

[MACRO] PROCESS_CHILD_ID %out_status, %out_pid, %process
    __process_child_id_slot_%out_pid = stack_alloc 4
    %out_status = call @sa_std_process_child_id(%process, &__process_child_id_slot_%out_pid)
    %out_pid = load __process_child_id_slot_%out_pid+0 as u32
[END_MACRO]

[MACRO] PROCESS_WAIT %out_status, %out_code, %process
    __process_wait_code_slot_%out_code = stack_alloc 4
    %out_status = call @sa_std_process_wait(%process, &__process_wait_code_slot_%out_code)
    %out_code = load __process_wait_code_slot_%out_code+0 as u32
[END_MACRO]

[MACRO] PROCESS_WAIT_RAW %out_status, %out_raw, %process
    __process_wait_raw_slot_%out_raw = stack_alloc 4
    %out_status = call @sa_std_process_wait_raw(%process, &__process_wait_raw_slot_%out_raw)
    %out_raw = load __process_wait_raw_slot_%out_raw+0 as i32
[END_MACRO]

[MACRO] PROCESS_TRY_WAIT %out_status, %out_ready, %out_code, %process
    __process_try_wait_ready_slot_%out_ready = stack_alloc 4
    __process_try_wait_code_slot_%out_code = stack_alloc 4
    %out_status = call @sa_std_process_try_wait(%process, &__process_try_wait_ready_slot_%out_ready, &__process_try_wait_code_slot_%out_code)
    %out_ready = load __process_try_wait_ready_slot_%out_ready+0 as i32
    %out_code = load __process_try_wait_code_slot_%out_code+0 as u32
[END_MACRO]

[MACRO] PROCESS_TRY_WAIT_RAW %out_status, %out_ready, %out_raw, %process
    __process_try_wait_raw_ready_slot_%out_ready = stack_alloc 4
    __process_try_wait_raw_slot_%out_raw = stack_alloc 4
    %out_status = call @sa_std_process_try_wait_raw(%process, &__process_try_wait_raw_ready_slot_%out_ready, &__process_try_wait_raw_slot_%out_raw)
    %out_ready = load __process_try_wait_raw_ready_slot_%out_ready+0 as i32
    %out_raw = load __process_try_wait_raw_slot_%out_raw+0 as i32
[END_MACRO]

[MACRO] PROCESS_WAIT_EXIT_STATUS %out_status, %exit_status, %process
    __process_wait_exit_raw_%out_status = stack_alloc 4
    %out_status = call @sa_std_process_wait_raw(%process, &__process_wait_exit_raw_%out_status)
    __process_wait_exit_value_%out_status = load __process_wait_exit_raw_%out_status+0 as i32
    EXPAND PROCESS_EXIT_STATUS_FROM_RAW %exit_status, __process_wait_exit_value_%out_status
    !__process_wait_exit_value_%out_status
[END_MACRO]

[MACRO] PROCESS_TRY_WAIT_EXIT_STATUS %out_status, %out_ready, %exit_status, %process
    __process_try_wait_exit_ready_slot_%out_ready = stack_alloc 4
    __process_try_wait_exit_code_%out_status = stack_alloc 4
    %out_status = call @sa_std_process_try_wait_raw(%process, &__process_try_wait_exit_ready_slot_%out_ready, &__process_try_wait_exit_code_%out_status)
    %out_ready = load __process_try_wait_exit_ready_slot_%out_ready+0 as i32
    __process_try_wait_exit_value_%out_status = load __process_try_wait_exit_code_%out_status+0 as i32
    EXPAND PROCESS_EXIT_STATUS_FROM_RAW %exit_status, __process_try_wait_exit_value_%out_status
    !__process_try_wait_exit_value_%out_status
[END_MACRO]

[MACRO] PROCESS_KILL %out_status, %process
    %out_status = call @sa_std_process_kill(%process)
[END_MACRO]

[MACRO] PROCESS_SEND_SIGNAL %out_status, %process, %signal
    %out_status = call @sa_std_process_send_signal(%process, %signal)
[END_MACRO]

[MACRO] PROCESS_READ_STDOUT %out_status, %out_len, %process, %buf, %cap
    __process_stdout_len_slot_%out_len = stack_alloc 8
    %out_status = call @sa_std_process_read_stdout(%process, &%buf, %cap, &__process_stdout_len_slot_%out_len)
    %out_len = load __process_stdout_len_slot_%out_len+0 as u64
[END_MACRO]

[MACRO] PROCESS_READ_STDERR %out_status, %out_len, %process, %buf, %cap
    __process_stderr_len_slot_%out_len = stack_alloc 8
    %out_status = call @sa_std_process_read_stderr(%process, &%buf, %cap, &__process_stderr_len_slot_%out_len)
    %out_len = load __process_stderr_len_slot_%out_len+0 as u64
[END_MACRO]

[MACRO] PROCESS_EXEC_CAPTURE %out_status, %out_code, %out_stdout, %out_stderr, %argv, %argv_len
    __process_capture_code_slot_%out_code = stack_alloc 4
    __process_capture_stdout_slot_%out_stdout = stack_alloc 8
    __process_capture_stderr_slot_%out_stderr = stack_alloc 8
    %out_status = call @sa_std_process_exec_capture(&%argv, %argv_len, &__process_capture_code_slot_%out_code, &__process_capture_stdout_slot_%out_stdout, &__process_capture_stderr_slot_%out_stderr)
    %out_code = load __process_capture_code_slot_%out_code+0 as u32
    %out_stdout = load __process_capture_stdout_slot_%out_stdout+0 as u64
    %out_stderr = load __process_capture_stderr_slot_%out_stderr+0 as u64
[END_MACRO]

[MACRO] PROCESS_EXEC_CAPTURE_OUTPUT %out_status, %output, %argv, %argv_len
    __process_capture_output_status_%output = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_EXEC_CAPTURE %out_status, __process_capture_output_code_%output, __process_capture_output_stdout_handle_%output, __process_capture_output_stderr_handle_%output, %argv, %argv_len
    EXPAND PROCESS_EXIT_STATUS_NEW __process_capture_output_status_%output, __process_capture_output_code_%output
    EXPAND PROCESS_OUTPUT_NEW %output, __process_capture_output_status_%output, __process_capture_output_stdout_handle_%output, __process_capture_output_stderr_handle_%output
    !__process_capture_output_stderr_handle_%output
    !__process_capture_output_stdout_handle_%output
    !__process_capture_output_code_%output
[END_MACRO]

[MACRO] PROCESS_EXEC_CAPTURE_CWD %out_status, %out_code, %out_stdout, %out_stderr, %argv, %argv_len, %cwd, %cwd_len
    __process_capture_cwd_code_slot_%out_code = stack_alloc 4
    __process_capture_cwd_stdout_slot_%out_stdout = stack_alloc 8
    __process_capture_cwd_stderr_slot_%out_stderr = stack_alloc 8
    %out_status = call @sa_std_process_exec_capture_cwd(&%argv, %argv_len, &%cwd, %cwd_len, &__process_capture_cwd_code_slot_%out_code, &__process_capture_cwd_stdout_slot_%out_stdout, &__process_capture_cwd_stderr_slot_%out_stderr)
    %out_code = load __process_capture_cwd_code_slot_%out_code+0 as u32
    %out_stdout = load __process_capture_cwd_stdout_slot_%out_stdout+0 as u64
    %out_stderr = load __process_capture_cwd_stderr_slot_%out_stderr+0 as u64
[END_MACRO]

[MACRO] PROCESS_EXEC_CAPTURE_OUTPUT_CWD %out_status, %output, %argv, %argv_len, %cwd, %cwd_len
    __process_capture_cwd_output_status_%output = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_EXEC_CAPTURE_CWD %out_status, __process_capture_cwd_output_code_%output, __process_capture_cwd_output_stdout_handle_%output, __process_capture_cwd_output_stderr_handle_%output, %argv, %argv_len, %cwd, %cwd_len
    EXPAND PROCESS_EXIT_STATUS_NEW __process_capture_cwd_output_status_%output, __process_capture_cwd_output_code_%output
    EXPAND PROCESS_OUTPUT_NEW %output, __process_capture_cwd_output_status_%output, __process_capture_cwd_output_stdout_handle_%output, __process_capture_cwd_output_stderr_handle_%output
    !__process_capture_cwd_output_stderr_handle_%output
    !__process_capture_cwd_output_stdout_handle_%output
    !__process_capture_cwd_output_code_%output
[END_MACRO]

[MACRO] PROCESS_CLOSE %out_status, %process
    %out_status = call @sa_std_process_close(%process)
[END_MACRO]
