// SA-facing contracts for environment variable helpers.
// Env values are copied into owned buffer handles and must be freed explicitly.
@extern sa_env_get(key: ptr, key_len: u64) -> u64
@extern sa_env_has(key: ptr, key_len: u64) -> i32
@extern sa_env_set_var(key: ptr, key_len: u64, value: ptr, value_len: u64) -> i32
@extern sa_env_remove_var(key: ptr, key_len: u64) -> i32
@extern sa_env_current_dir() -> u64
@extern sa_env_set_current_dir(path: ptr, path_len: u64) -> i32
@extern sa_env_temp_dir() -> u64
@extern sa_env_current_exe() -> u64
@extern sa_env_home_dir() -> u64
@extern sa_env_args_json() -> u64
@extern sa_env_vars_json() -> u64
@extern sa_env_split_paths_json(path_list: ptr, path_list_len: u64) -> u64
@extern sa_env_join_paths_json(paths_json: ptr, paths_json_len: u64) -> u64
@extern sa_env_xdg_data_home_dir() -> u64
@extern sa_env_xdg_config_home_dir() -> u64
@extern sa_env_xdg_state_home_dir() -> u64
@extern sa_env_xdg_cache_home_dir() -> u64
@extern sa_env_xdg_data_dirs() -> u64
@extern sa_env_xdg_config_dirs() -> u64

@extern sa_env_buffer_data(buffer: u64) -> &ptr
@extern sa_env_buffer_len(buffer: u64) -> u64
@extern sa_env_buffer_free(^buffer: u64) -> i32
