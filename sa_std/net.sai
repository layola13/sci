@extern sa_net_udp_leave_multicast_v6(socket: u64, &multi_host: ptr, multi_host_len: u64, interface_index: u32) -> i32
@extern sa_net_udp_close(socket: u64) -> i32

// Owned SaNetAddr values are returned by address query APIs and must be freed.
@extern sa_net_addr_host(addr: u64) -> &ptr
@extern sa_net_addr_host_len(addr: u64) -> u64
@extern sa_net_addr_port(addr: u64) -> u32
@extern sa_net_addr_family(addr: u64) -> u32
@extern sa_net_addr_scope_id(addr: u64) -> u64
@extern sa_std_net_addr_format(addr: u64, &out: ptr, out_cap: u64, &out_len: ptr) -> i32
@extern sa_net_addr_free(addr: u64) -> i32!
@extern sa_net_ipv4_parse_ascii(&text: ptr, text_len: u64, &out_addr: ptr) -> i32
@extern sa_net_socket_addr_v4_parse_ascii(&text: ptr, text_len: u64, &out_socket_addr: ptr) -> i32
