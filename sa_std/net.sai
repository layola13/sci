@extern sa_net_udp_peek_from(socket: u64, &buf: ptr, cap: u64, &out_addr: ptr) -> i32
@extern sa_net_udp_join_multicast_v4(socket: u64, &multi_host: ptr, multi_host_len: u64, &interface_host: ptr, interface_host_len: u64) -> i32
@extern sa_net_udp_leave_multicast_v4(socket: u64, &multi_host: ptr, multi_host_len: u64, &interface_host: ptr, interface_host_len: u64) -> i32
