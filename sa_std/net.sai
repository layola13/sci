// SA-facing contracts for the Zig-backed sa_std.net module.
// TcpStream, TcpListener, UdpSocket, and NetAddr values are opaque u64 handles.
@extern sa_std_net_tcp_connect(&host: ptr, host_len: u64, port: u32, &out_handle: ptr) -> i32
@extern sa_std_net_tcp_listen(&host: ptr, host_len: u64, port: u32, &out_handle: ptr, &out_bound_port: ptr) -> i32
@extern sa_std_net_tcp_accept(listener: u64, &out_handle: ptr) -> i32
@extern sa_std_net_tcp_listener_local_addr(listener: u64, &out_handle: ptr) -> i32
@extern sa_std_net_tcp_stream_read(stream: u64, &buf: ptr, cap: u64, &out_read: ptr) -> i32
@extern sa_std_net_tcp_stream_peek(stream: u64, &buf: ptr, cap: u64, &out_read: ptr) -> i32
@extern sa_std_net_tcp_stream_write(stream: u64, &buf: ptr, len: u64, &out_written: ptr) -> i32
@extern sa_std_net_tcp_stream_set_read_timeout(stream: u64, timeout_ns: u64) -> i32
@extern sa_std_net_tcp_stream_set_write_timeout(stream: u64, timeout_ns: u64) -> i32
@extern sa_std_net_tcp_stream_set_nonblocking(stream: u64, enabled: i32) -> i32
@extern sa_std_net_tcp_stream_set_nodelay(stream: u64, enabled: i32) -> i32
@extern sa_std_net_tcp_stream_set_ttl(stream: u64, ttl: u32) -> i32
@extern sa_std_net_tcp_stream_read_timeout(stream: u64, &out_timeout_ns: ptr) -> i32
@extern sa_std_net_tcp_stream_write_timeout(stream: u64, &out_timeout_ns: ptr) -> i32
@extern sa_std_net_tcp_stream_nodelay(stream: u64, &out_enabled: ptr) -> i32
@extern sa_std_net_tcp_stream_ttl(stream: u64, &out_ttl: ptr) -> i32
@extern sa_std_net_tcp_stream_take_error(stream: u64, &out_error: ptr) -> i32
@extern sa_std_net_tcp_stream_peer_addr(stream: u64, &out_handle: ptr) -> i32
@extern sa_std_net_tcp_stream_local_addr(stream: u64, &out_handle: ptr) -> i32
@extern sa_std_net_to_socket_addr_first(&host: ptr, host_len: u64, port: u32, &out_handle: ptr) -> i32
@extern sa_std_net_tcp_listener_set_nonblocking(listener: u64, enabled: i32) -> i32
@extern sa_std_net_tcp_listener_set_ttl(listener: u64, ttl: u32) -> i32
@extern sa_std_net_tcp_listener_ttl(listener: u64, &out_ttl: ptr) -> i32
@extern sa_std_net_tcp_listener_take_error(listener: u64, &out_error: ptr) -> i32

// Unix domain sockets (stream). Handles reuse the tcp_stream/tcp_listener kinds,
// so NET_TCP_STREAM_READ/WRITE/CLOSE and NET_TCP_LISTENER_CLOSE work on them.
@extern sa_std_net_unix_listen(&path: ptr, path_len: u64, &out_handle: ptr) -> i32
@extern sa_std_net_unix_accept(listener: u64, &out_handle: ptr) -> i32
@extern sa_std_net_unix_connect(&path: ptr, path_len: u64, &out_handle: ptr) -> i32

// Additional stream/listener socket options.
@extern sa_std_net_tcp_stream_set_keepalive(stream: u64, enabled: i32) -> i32
@extern sa_std_net_tcp_stream_set_keepalive_params(stream: u64, idle_secs: u32, intvl_secs: u32, cnt: u32) -> i32
@extern sa_std_net_tcp_listener_set_reuseaddr(listener: u64, enabled: i32) -> i32
@extern sa_std_net_tcp_listener_set_reuseport(listener: u64, enabled: i32) -> i32

@extern sa_std_net_udp_bind(&host: ptr, host_len: u64, port: u32, &out_handle: ptr) -> i32
@extern sa_std_net_udp_local_addr(socket: u64, &out_handle: ptr) -> i32
@extern sa_std_net_udp_peer_addr(socket: u64, &out_handle: ptr) -> i32
@extern sa_std_net_udp_connect(socket: u64, &host: ptr, host_len: u64, port: u32) -> i32
@extern sa_std_net_udp_set_read_timeout(socket: u64, timeout_ns: u64) -> i32
@extern sa_std_net_udp_set_write_timeout(socket: u64, timeout_ns: u64) -> i32
@extern sa_std_net_udp_set_nonblocking(socket: u64, enabled: i32) -> i32
@extern sa_std_net_udp_set_broadcast(socket: u64, enabled: i32) -> i32
@extern sa_std_net_udp_set_ttl(socket: u64, ttl: u32) -> i32
@extern sa_std_net_udp_set_multicast_loop_v4(socket: u64, enabled: i32) -> i32
@extern sa_std_net_udp_set_multicast_ttl_v4(socket: u64, ttl: u32) -> i32
@extern sa_std_net_udp_read_timeout(socket: u64, &out_timeout_ns: ptr) -> i32
@extern sa_std_net_udp_write_timeout(socket: u64, &out_timeout_ns: ptr) -> i32
@extern sa_std_net_udp_broadcast(socket: u64, &out_enabled: ptr) -> i32
@extern sa_std_net_udp_ttl(socket: u64, &out_ttl: ptr) -> i32
@extern sa_std_net_udp_multicast_loop_v4(socket: u64, &out_enabled: ptr) -> i32
@extern sa_std_net_udp_multicast_ttl_v4(socket: u64, &out_ttl: ptr) -> i32
@extern sa_std_net_udp_take_error(socket: u64, &out_error: ptr) -> i32
@extern sa_std_net_udp_send(socket: u64, &buf: ptr, len: u64, &out_written: ptr) -> i32
@extern sa_std_net_udp_recv(socket: u64, &buf: ptr, cap: u64, &out_read: ptr) -> i32
@extern sa_std_net_udp_peek(socket: u64, &buf: ptr, cap: u64, &out_read: ptr) -> i32
@extern sa_std_net_udp_send_to(socket: u64, &buf: ptr, len: u64, &host: ptr, host_len: u64, port: u32, &out_written: ptr) -> i32
@extern sa_std_net_udp_recv_from(socket: u64, &buf: ptr, cap: u64, &out_read: ptr, &out_addr: ptr) -> i32
@extern sa_std_net_udp_peek_from(socket: u64, &buf: ptr, cap: u64, &out_read: ptr, &out_addr: ptr) -> i32
@extern sa_std_net_udp_join_multicast_v4(socket: u64, &multi_host: ptr, multi_host_len: u64, &interface_host: ptr, interface_host_len: u64) -> i32
@extern sa_std_net_udp_leave_multicast_v4(socket: u64, &multi_host: ptr, multi_host_len: u64, &interface_host: ptr, interface_host_len: u64) -> i32
@extern sa_std_net_udp_join_multicast_v6(socket: u64, &multi_host: ptr, multi_host_len: u64, interface_index: u32) -> i32
@extern sa_std_net_udp_leave_multicast_v6(socket: u64, &multi_host: ptr, multi_host_len: u64, interface_index: u32) -> i32

@extern sa_net_tcp_connect(&host: ptr, host_len: u64, port: u32) -> u64!
@extern sa_net_tcp_stream_read(stream: u64, &buf: ptr, cap: u64) -> u64!
@extern sa_net_tcp_stream_peek(stream: u64, &buf: ptr, cap: u64) -> i32
@extern sa_net_tcp_stream_set_read_timeout(stream: u64, timeout_ns: u64) -> i32
@extern sa_net_tcp_stream_set_write_timeout(stream: u64, timeout_ns: u64) -> i32
@extern sa_net_tcp_stream_set_nonblocking(stream: u64, enabled: i32) -> i32
@extern sa_net_tcp_stream_set_nodelay(stream: u64, enabled: i32) -> i32
@extern sa_net_tcp_stream_set_ttl(stream: u64, ttl: u32) -> i32
@extern sa_net_tcp_stream_write(stream: u64, &buf: ptr, len: u64) -> i32
@extern sa_net_tcp_stream_write_all(stream: u64, &buf: ptr, len: u64) -> i32!
@extern sa_net_tcp_stream_flush(stream: u64) -> i32
@extern sa_net_tcp_stream_peer_addr(stream: u64) -> i32
@extern sa_net_tcp_stream_shutdown(stream: u64, how: u32) -> i32
@extern sa_net_tcp_stream_close(stream: u64) -> i32!

@extern sa_net_tcp_listener_bind(&host: ptr, host_len: u64, port: u16) -> u64!
@extern sa_net_tcp_listener_accept(listener: u64) -> u64!
@extern sa_net_tcp_listener_local_addr(listener: u64) -> u64!
@extern sa_net_tcp_listener_close(listener: u64) -> i32!

@extern sa_net_udp_bind(&host: ptr, host_len: u64, port: u16) -> i32
@extern sa_net_udp_connect(socket: u64, &host: ptr, host_len: u64, port: u16) -> i32
@extern sa_net_udp_local_addr(socket: u64) -> i32
@extern sa_net_udp_set_read_timeout(socket: u64, timeout_ns: u64) -> i32
@extern sa_net_udp_set_write_timeout(socket: u64, timeout_ns: u64) -> i32
@extern sa_net_udp_set_nonblocking(socket: u64, enabled: i32) -> i32
@extern sa_net_udp_set_broadcast(socket: u64, enabled: i32) -> i32
@extern sa_net_udp_set_ttl(socket: u64, ttl: u32) -> i32
@extern sa_net_udp_set_multicast_loop_v4(socket: u64, enabled: i32) -> i32
@extern sa_net_udp_set_multicast_ttl_v4(socket: u64, ttl: u32) -> i32
@extern sa_net_udp_send(socket: u64, &buf: ptr, len: u64) -> i32
@extern sa_net_udp_recv(socket: u64, &buf: ptr, cap: u64) -> i32
@extern sa_net_udp_peek(socket: u64, &buf: ptr, cap: u64) -> i32
