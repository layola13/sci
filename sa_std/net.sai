@extern sa_std_net_tcp_stream_set_nodelay(stream: u64, enabled: i32) -> i32
@extern sa_std_net_tcp_stream_set_quickack(stream: u64, enabled: i32) -> i32
@extern sa_std_net_tcp_stream_quickack(stream: u64, &out_enabled: ptr) -> i32
@extern sa_std_net_tcp_stream_set_deferaccept(stream: u64, seconds: u32) -> i32
@extern sa_std_net_tcp_stream_deferaccept(stream: u64, &out_seconds: ptr) -> i32
@extern sa_std_net_tcp_stream_set_ttl(stream: u64, ttl: u32) -> i32
@extern sa_std_net_tcp_stream_read_timeout(stream: u64, &out_timeout_ns: ptr) -> i32
@extern sa_std_net_tcp_stream_write_timeout(stream: u64, &out_timeout_ns: ptr) -> i32
@extern sa_std_net_tcp_stream_nodelay(stream: u64, &out_enabled: ptr) -> i32
@extern sa_std_net_tcp_stream_ttl(stream: u64, &out_ttl: ptr) -> i32
