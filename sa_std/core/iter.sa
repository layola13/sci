@import "iter.sal"
@import "slice.sal"

[MACRO] ITER_NEW %out_iter, %slice_reg
    %out_iter = alloc Iter_SIZE
    __iter_ptr_%out_iter = load %slice_reg+Slice_ptr as ptr
    __iter_len_%out_iter = load %slice_reg+Slice_len as u64
    store %out_iter+Iter_ptr, __iter_ptr_%out_iter as ptr
    store %out_iter+Iter_len, __iter_len_%out_iter as u64
    store %out_iter+Iter_index, 0 as u64
    !__iter_ptr_%out_iter
    !__iter_len_%out_iter
[END_MACRO]

[MACRO] ITER_FROM_SLICE %out_iter, %slice_reg
    EXPAND ITER_NEW %out_iter, %slice_reg
[END_MACRO]

[MACRO] ITER_IS_EMPTY %out_bool, %iter_reg
    __iter_len_%out_bool = load %iter_reg+Iter_len as u64
    __iter_index_%out_bool = load %iter_reg+Iter_index as u64
    __iter_done_%out_bool = eq __iter_index_%out_bool, __iter_len_%out_bool
    %out_bool = __iter_done_%out_bool
    !__iter_index_%out_bool
    !__iter_len_%out_bool
[END_MACRO]

[MACRO] ITER_HAS_NEXT %out_bool, %iter_reg
    __iter_len_%out_bool = load %iter_reg+Iter_len as u64
    __iter_index_%out_bool = load %iter_reg+Iter_index as u64
    %out_bool = lt __iter_index_%out_bool, __iter_len_%out_bool
    !__iter_index_%out_bool
    !__iter_len_%out_bool
[END_MACRO]

[MACRO] ITER_REMAINING %out_len, %iter_reg
    __iter_len_%out_len = load %iter_reg+Iter_len as u64
    __iter_index_%out_len = load %iter_reg+Iter_index as u64
    %out_len = sub __iter_len_%out_len, __iter_index_%out_len
    !__iter_index_%out_len
    !__iter_len_%out_len
[END_MACRO]

[MACRO] ITER_LEN %out_len, %iter_reg
    __iter_len_%out_len = load %iter_reg+Iter_len as u64
    __iter_index_%out_len = load %iter_reg+Iter_index as u64
    %out_len = sub __iter_len_%out_len, __iter_index_%out_len
    !__iter_index_%out_len
    !__iter_len_%out_len
[END_MACRO]

[MACRO] ITER_PEEK_U64 %out_value, %iter_reg
    __iter_ptr_%out_value = load %iter_reg+Iter_ptr as ptr
    __iter_index_%out_value = load %iter_reg+Iter_index as u64
    __iter_off_%out_value = mul __iter_index_%out_value, 8
    __iter_item_%out_value = ptr_add __iter_ptr_%out_value, __iter_off_%out_value
    %out_value = load __iter_item_%out_value+0 as u64
    !__iter_item_%out_value
    !__iter_off_%out_value
    !__iter_index_%out_value
    !__iter_ptr_%out_value
[END_MACRO]

[MACRO] ITER_NEXT %out_has, %out_value, %iter_reg, %elem_size
    __iter_ptr_%out_has = load %iter_reg+Iter_ptr as ptr
    __iter_len_%out_has = load %iter_reg+Iter_len as u64
    __iter_index_%out_has = load %iter_reg+Iter_index as u64
    __iter_done_%out_has = eq __iter_index_%out_has, __iter_len_%out_has
    br __iter_done_%out_has -> L_ITER_NEXT_NONE_%out_has, L_ITER_NEXT_SOME_%out_has
L_ITER_NEXT_SOME_%out_has:
    __iter_off_%out_has = mul __iter_index_%out_has, %elem_size
    __iter_item_%out_has = ptr_add __iter_ptr_%out_has, __iter_off_%out_has
    %out_value = load __iter_item_%out_has+0 as u64
    __iter_next_%out_has = add __iter_index_%out_has, 1
    store %iter_reg+Iter_index, __iter_next_%out_has as u64
    %out_has = add 0, 1
    !__iter_next_%out_has
    !__iter_item_%out_has
    !__iter_off_%out_has
    !__iter_done_%out_has
    !__iter_index_%out_has
    !__iter_len_%out_has
    !__iter_ptr_%out_has
    jmp L_ITER_NEXT_END_%out_has
L_ITER_NEXT_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    !__iter_done_%out_has
    !__iter_index_%out_has
    !__iter_len_%out_has
    !__iter_ptr_%out_has
L_ITER_NEXT_END_%out_has:
[END_MACRO]

[MACRO] ITER_NEXT_U64 %out_has, %out_value, %iter_reg
    EXPAND ITER_NEXT %out_has, %out_value, %iter_reg, 8
[END_MACRO]

[MACRO] ITER_CLONE %out_iter, %iter_reg
    %out_iter = alloc Iter_SIZE
    __iter_clone_ptr_%out_iter = load %iter_reg+Iter_ptr as ptr
    __iter_clone_len_%out_iter = load %iter_reg+Iter_len as u64
    __iter_clone_index_%out_iter = load %iter_reg+Iter_index as u64
    store %out_iter+Iter_ptr, __iter_clone_ptr_%out_iter as ptr
    store %out_iter+Iter_len, __iter_clone_len_%out_iter as u64
    store %out_iter+Iter_index, __iter_clone_index_%out_iter as u64
    !__iter_clone_index_%out_iter
    !__iter_clone_len_%out_iter
    !__iter_clone_ptr_%out_iter
[END_MACRO]

[MACRO] ITER_AS_SLICE_U64 %out_slice, %iter_reg
    __iter_slice_ptr_%out_slice = load %iter_reg+Iter_ptr as ptr
    __iter_slice_len_%out_slice = load %iter_reg+Iter_len as u64
    __iter_slice_index_%out_slice = load %iter_reg+Iter_index as u64
    __iter_slice_off_%out_slice = mul __iter_slice_index_%out_slice, 8
    __iter_slice_data_%out_slice = ptr_add __iter_slice_ptr_%out_slice, __iter_slice_off_%out_slice
    __iter_slice_rem_%out_slice = sub __iter_slice_len_%out_slice, __iter_slice_index_%out_slice
    store %out_slice+Slice_ptr, __iter_slice_data_%out_slice as ptr
    store %out_slice+Slice_len, __iter_slice_rem_%out_slice as u64
    !__iter_slice_rem_%out_slice
    !__iter_slice_data_%out_slice
    !__iter_slice_off_%out_slice
    !__iter_slice_index_%out_slice
    !__iter_slice_len_%out_slice
    !__iter_slice_ptr_%out_slice
[END_MACRO]

[MACRO] ITER_NEXT_BACK_U64 %out_has, %out_value, %iter_reg
    __iter_back_ptr_%out_has = load %iter_reg+Iter_ptr as ptr
    __iter_back_len_%out_has = load %iter_reg+Iter_len as u64
    __iter_back_index_%out_has = load %iter_reg+Iter_index as u64
    __iter_back_has_%out_has = ult __iter_back_index_%out_has, __iter_back_len_%out_has
    br __iter_back_has_%out_has -> L_ITER_NEXT_BACK_SOME_%out_has, L_ITER_NEXT_BACK_NONE_%out_has
L_ITER_NEXT_BACK_SOME_%out_has:
    __iter_back_next_len_%out_has = sub __iter_back_len_%out_has, 1
    __iter_back_off_%out_has = mul __iter_back_next_len_%out_has, 8
    __iter_back_item_%out_has = ptr_add __iter_back_ptr_%out_has, __iter_back_off_%out_has
    %out_value = load __iter_back_item_%out_has+0 as u64
    store %iter_reg+Iter_len, __iter_back_next_len_%out_has as u64
    %out_has = add 0, 1
    !__iter_back_item_%out_has
    !__iter_back_off_%out_has
    !__iter_back_next_len_%out_has
    !__iter_back_has_%out_has
    !__iter_back_index_%out_has
    !__iter_back_len_%out_has
    !__iter_back_ptr_%out_has
    jmp L_ITER_NEXT_BACK_END_%out_has
L_ITER_NEXT_BACK_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    !__iter_back_has_%out_has
    !__iter_back_index_%out_has
    !__iter_back_len_%out_has
    !__iter_back_ptr_%out_has
L_ITER_NEXT_BACK_END_%out_has:
[END_MACRO]

[MACRO] ITER_NTH_U64 %out_has, %out_value, %iter_reg, %nth
    __iter_nth_len_%out_has = load %iter_reg+Iter_len as u64
    __iter_nth_index_%out_has = load %iter_reg+Iter_index as u64
    __iter_nth_remaining_%out_has = sub __iter_nth_len_%out_has, __iter_nth_index_%out_has
    __iter_nth_ok_%out_has = ult %nth, __iter_nth_remaining_%out_has
    br __iter_nth_ok_%out_has -> L_ITER_NTH_SOME_%out_has, L_ITER_NTH_NONE_%out_has
L_ITER_NTH_SOME_%out_has:
    __iter_nth_target_%out_has = add __iter_nth_index_%out_has, %nth
    __iter_nth_ptr_%out_has = load %iter_reg+Iter_ptr as ptr
    __iter_nth_off_%out_has = mul __iter_nth_target_%out_has, 8
    __iter_nth_item_%out_has = ptr_add __iter_nth_ptr_%out_has, __iter_nth_off_%out_has
    %out_value = load __iter_nth_item_%out_has+0 as u64
    __iter_nth_next_%out_has = add __iter_nth_target_%out_has, 1
    store %iter_reg+Iter_index, __iter_nth_next_%out_has as u64
    %out_has = add 0, 1
    !__iter_nth_next_%out_has
    !__iter_nth_item_%out_has
    !__iter_nth_off_%out_has
    !__iter_nth_ptr_%out_has
    !__iter_nth_target_%out_has
    !__iter_nth_ok_%out_has
    !__iter_nth_remaining_%out_has
    !__iter_nth_index_%out_has
    !__iter_nth_len_%out_has
    jmp L_ITER_NTH_END_%out_has
L_ITER_NTH_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    store %iter_reg+Iter_index, __iter_nth_len_%out_has as u64
    !__iter_nth_ok_%out_has
    !__iter_nth_remaining_%out_has
    !__iter_nth_index_%out_has
    !__iter_nth_len_%out_has
L_ITER_NTH_END_%out_has:
[END_MACRO]

[MACRO] ITER_COUNT %out_count, %iter_reg
    __iter_count_len_%out_count = load %iter_reg+Iter_len as u64
    __iter_count_index_%out_count = load %iter_reg+Iter_index as u64
    %out_count = sub __iter_count_len_%out_count, __iter_count_index_%out_count
    store %iter_reg+Iter_index, __iter_count_len_%out_count as u64
    !__iter_count_index_%out_count
    !__iter_count_len_%out_count
[END_MACRO]

[MACRO] ITER_LAST_U64 %out_has, %out_value, %iter_reg
    EXPAND ITER_NEXT_BACK_U64 %out_has, %out_value, %iter_reg
    __iter_last_len_%out_has = load %iter_reg+Iter_len as u64
    store %iter_reg+Iter_index, __iter_last_len_%out_has as u64
    !__iter_last_len_%out_has
[END_MACRO]

[MACRO] ITER_FIND_U64 %out_has, %out_value, %iter_reg, %pred_fn
    jmp L_ITER_FIND_HEAD_%out_has
L_ITER_FIND_HEAD_%out_has:
    EXPAND ITER_NEXT_U64 __iter_find_has_%out_has, __iter_find_value_%out_has, %iter_reg
    br __iter_find_has_%out_has -> L_ITER_FIND_CHECK_%out_has, L_ITER_FIND_NONE_%out_has
L_ITER_FIND_CHECK_%out_has:
    __iter_find_pred_%out_has = call %pred_fn(__iter_find_value_%out_has)
    __iter_find_match_%out_has = ne __iter_find_pred_%out_has, 0
    br __iter_find_match_%out_has -> L_ITER_FIND_SOME_%out_has, L_ITER_FIND_NEXT_%out_has
L_ITER_FIND_NEXT_%out_has:
    !__iter_find_match_%out_has
    !__iter_find_pred_%out_has
    !__iter_find_value_%out_has
    !__iter_find_has_%out_has
    jmp L_ITER_FIND_HEAD_%out_has
L_ITER_FIND_SOME_%out_has:
    %out_value = add __iter_find_value_%out_has, 0
    %out_has = add 0, 1
    !__iter_find_match_%out_has
    !__iter_find_pred_%out_has
    !__iter_find_value_%out_has
    !__iter_find_has_%out_has
    jmp L_ITER_FIND_END_%out_has
L_ITER_FIND_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    !__iter_find_value_%out_has
    !__iter_find_has_%out_has
L_ITER_FIND_END_%out_has:
[END_MACRO]

[MACRO] ITER_POSITION_U64 %out_has, %out_index, %iter_reg, %pred_fn
    __iter_pos_base_%out_has = load %iter_reg+Iter_index as u64
    jmp L_ITER_POSITION_HEAD_%out_has
L_ITER_POSITION_HEAD_%out_has:
    __iter_pos_before_%out_has = load %iter_reg+Iter_index as u64
    EXPAND ITER_NEXT_U64 __iter_pos_has_%out_has, __iter_pos_value_%out_has, %iter_reg
    br __iter_pos_has_%out_has -> L_ITER_POSITION_CHECK_%out_has, L_ITER_POSITION_NONE_%out_has
L_ITER_POSITION_CHECK_%out_has:
    __iter_pos_pred_%out_has = call %pred_fn(__iter_pos_value_%out_has)
    __iter_pos_match_%out_has = ne __iter_pos_pred_%out_has, 0
    br __iter_pos_match_%out_has -> L_ITER_POSITION_SOME_%out_has, L_ITER_POSITION_NEXT_%out_has
L_ITER_POSITION_NEXT_%out_has:
    !__iter_pos_match_%out_has
    !__iter_pos_pred_%out_has
    !__iter_pos_value_%out_has
    !__iter_pos_has_%out_has
    !__iter_pos_before_%out_has
    jmp L_ITER_POSITION_HEAD_%out_has
L_ITER_POSITION_SOME_%out_has:
    %out_index = sub __iter_pos_before_%out_has, __iter_pos_base_%out_has
    %out_has = add 0, 1
    !__iter_pos_match_%out_has
    !__iter_pos_pred_%out_has
    !__iter_pos_value_%out_has
    !__iter_pos_has_%out_has
    !__iter_pos_before_%out_has
    !__iter_pos_base_%out_has
    jmp L_ITER_POSITION_END_%out_has
L_ITER_POSITION_NONE_%out_has:
    %out_index = add 0, 0
    %out_has = add 0, 0
    !__iter_pos_value_%out_has
    !__iter_pos_has_%out_has
    !__iter_pos_before_%out_has
    !__iter_pos_base_%out_has
L_ITER_POSITION_END_%out_has:
[END_MACRO]

[MACRO] ITER_RPOSITION_U64 %out_has, %out_index, %iter_reg, %pred_fn
    __iter_rpos_base_%out_has = load %iter_reg+Iter_index as u64
    jmp L_ITER_RPOSITION_HEAD_%out_has
L_ITER_RPOSITION_HEAD_%out_has:
    __iter_rpos_len_before_%out_has = load %iter_reg+Iter_len as u64
    EXPAND ITER_NEXT_BACK_U64 __iter_rpos_has_%out_has, __iter_rpos_value_%out_has, %iter_reg
    br __iter_rpos_has_%out_has -> L_ITER_RPOSITION_CHECK_%out_has, L_ITER_RPOSITION_NONE_%out_has
L_ITER_RPOSITION_CHECK_%out_has:
    __iter_rpos_pred_%out_has = call %pred_fn(__iter_rpos_value_%out_has)
    __iter_rpos_match_%out_has = ne __iter_rpos_pred_%out_has, 0
    br __iter_rpos_match_%out_has -> L_ITER_RPOSITION_SOME_%out_has, L_ITER_RPOSITION_NEXT_%out_has
L_ITER_RPOSITION_NEXT_%out_has:
    !__iter_rpos_match_%out_has
    !__iter_rpos_pred_%out_has
    !__iter_rpos_value_%out_has
    !__iter_rpos_has_%out_has
    !__iter_rpos_len_before_%out_has
    jmp L_ITER_RPOSITION_HEAD_%out_has
L_ITER_RPOSITION_SOME_%out_has:
    __iter_rpos_match_index_%out_has = sub __iter_rpos_len_before_%out_has, 1
    %out_index = sub __iter_rpos_match_index_%out_has, __iter_rpos_base_%out_has
    %out_has = add 0, 1
    !__iter_rpos_match_index_%out_has
    !__iter_rpos_match_%out_has
    !__iter_rpos_pred_%out_has
    !__iter_rpos_value_%out_has
    !__iter_rpos_has_%out_has
    !__iter_rpos_len_before_%out_has
    !__iter_rpos_base_%out_has
    jmp L_ITER_RPOSITION_END_%out_has
L_ITER_RPOSITION_NONE_%out_has:
    %out_index = add 0, 0
    %out_has = add 0, 0
    !__iter_rpos_value_%out_has
    !__iter_rpos_has_%out_has
    !__iter_rpos_len_before_%out_has
    !__iter_rpos_base_%out_has
L_ITER_RPOSITION_END_%out_has:
[END_MACRO]

[MACRO] ITER_ANY_U64 %out_bool, %iter_reg, %pred_fn
    jmp L_ITER_ANY_HEAD_%out_bool
L_ITER_ANY_HEAD_%out_bool:
    EXPAND ITER_NEXT_U64 __iter_any_has_%out_bool, __iter_any_value_%out_bool, %iter_reg
    br __iter_any_has_%out_bool -> L_ITER_ANY_CHECK_%out_bool, L_ITER_ANY_FALSE_%out_bool
L_ITER_ANY_CHECK_%out_bool:
    __iter_any_pred_%out_bool = call %pred_fn(__iter_any_value_%out_bool)
    __iter_any_match_%out_bool = ne __iter_any_pred_%out_bool, 0
    br __iter_any_match_%out_bool -> L_ITER_ANY_TRUE_%out_bool, L_ITER_ANY_NEXT_%out_bool
L_ITER_ANY_NEXT_%out_bool:
    !__iter_any_match_%out_bool
    !__iter_any_pred_%out_bool
    !__iter_any_value_%out_bool
    !__iter_any_has_%out_bool
    jmp L_ITER_ANY_HEAD_%out_bool
L_ITER_ANY_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__iter_any_match_%out_bool
    !__iter_any_pred_%out_bool
    !__iter_any_value_%out_bool
    !__iter_any_has_%out_bool
    jmp L_ITER_ANY_END_%out_bool
L_ITER_ANY_FALSE_%out_bool:
    %out_bool = add 0, 0
    !__iter_any_value_%out_bool
    !__iter_any_has_%out_bool
L_ITER_ANY_END_%out_bool:
[END_MACRO]

[MACRO] ITER_ALL_U64 %out_bool, %iter_reg, %pred_fn
    jmp L_ITER_ALL_HEAD_%out_bool
L_ITER_ALL_HEAD_%out_bool:
    EXPAND ITER_NEXT_U64 __iter_all_has_%out_bool, __iter_all_value_%out_bool, %iter_reg
    br __iter_all_has_%out_bool -> L_ITER_ALL_CHECK_%out_bool, L_ITER_ALL_TRUE_%out_bool
L_ITER_ALL_CHECK_%out_bool:
    __iter_all_pred_%out_bool = call %pred_fn(__iter_all_value_%out_bool)
    __iter_all_match_%out_bool = ne __iter_all_pred_%out_bool, 0
    br __iter_all_match_%out_bool -> L_ITER_ALL_NEXT_%out_bool, L_ITER_ALL_FALSE_%out_bool
L_ITER_ALL_NEXT_%out_bool:
    !__iter_all_match_%out_bool
    !__iter_all_pred_%out_bool
    !__iter_all_value_%out_bool
    !__iter_all_has_%out_bool
    jmp L_ITER_ALL_HEAD_%out_bool
L_ITER_ALL_FALSE_%out_bool:
    %out_bool = add 0, 0
    !__iter_all_match_%out_bool
    !__iter_all_pred_%out_bool
    !__iter_all_value_%out_bool
    !__iter_all_has_%out_bool
    jmp L_ITER_ALL_END_%out_bool
L_ITER_ALL_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__iter_all_value_%out_bool
    !__iter_all_has_%out_bool
L_ITER_ALL_END_%out_bool:
[END_MACRO]

[MACRO] ITER_FOLD_U64 %out_value, %iter_reg, %init_value, %fold_fn
    __iter_fold_acc_slot_%out_value = stack_alloc 8
    store __iter_fold_acc_slot_%out_value+0, %init_value as u64
    jmp L_ITER_FOLD_HEAD_%out_value
L_ITER_FOLD_HEAD_%out_value:
    EXPAND ITER_NEXT_U64 __iter_fold_has_%out_value, __iter_fold_value_%out_value, %iter_reg
    br __iter_fold_has_%out_value -> L_ITER_FOLD_BODY_%out_value, L_ITER_FOLD_DONE_%out_value
L_ITER_FOLD_BODY_%out_value:
    __iter_fold_acc_%out_value = load __iter_fold_acc_slot_%out_value+0 as u64
    __iter_fold_next_%out_value = call %fold_fn(__iter_fold_acc_%out_value, __iter_fold_value_%out_value)
    store __iter_fold_acc_slot_%out_value+0, __iter_fold_next_%out_value as u64
    !__iter_fold_next_%out_value
    !__iter_fold_acc_%out_value
    !__iter_fold_value_%out_value
    !__iter_fold_has_%out_value
    jmp L_ITER_FOLD_HEAD_%out_value
L_ITER_FOLD_DONE_%out_value:
    %out_value = load __iter_fold_acc_slot_%out_value+0 as u64
    !__iter_fold_value_%out_value
    !__iter_fold_has_%out_value
[END_MACRO]

[MACRO] ITER_SUM_U64 %out_value, %iter_reg
    __iter_sum_slot_%out_value = stack_alloc 8
    store __iter_sum_slot_%out_value+0, 0 as u64
    jmp L_ITER_SUM_HEAD_%out_value
L_ITER_SUM_HEAD_%out_value:
    EXPAND ITER_NEXT_U64 __iter_sum_has_%out_value, __iter_sum_value_%out_value, %iter_reg
    br __iter_sum_has_%out_value -> L_ITER_SUM_BODY_%out_value, L_ITER_SUM_DONE_%out_value
L_ITER_SUM_BODY_%out_value:
    __iter_sum_acc_%out_value = load __iter_sum_slot_%out_value+0 as u64
    __iter_sum_next_%out_value = add __iter_sum_acc_%out_value, __iter_sum_value_%out_value
    store __iter_sum_slot_%out_value+0, __iter_sum_next_%out_value as u64
    !__iter_sum_next_%out_value
    !__iter_sum_acc_%out_value
    !__iter_sum_value_%out_value
    !__iter_sum_has_%out_value
    jmp L_ITER_SUM_HEAD_%out_value
L_ITER_SUM_DONE_%out_value:
    %out_value = load __iter_sum_slot_%out_value+0 as u64
    !__iter_sum_value_%out_value
    !__iter_sum_has_%out_value
[END_MACRO]

[MACRO] ITER_PRODUCT_U64 %out_value, %iter_reg
    __iter_product_slot_%out_value = stack_alloc 8
    store __iter_product_slot_%out_value+0, 1 as u64
    jmp L_ITER_PRODUCT_HEAD_%out_value
L_ITER_PRODUCT_HEAD_%out_value:
    EXPAND ITER_NEXT_U64 __iter_product_has_%out_value, __iter_product_value_%out_value, %iter_reg
    br __iter_product_has_%out_value -> L_ITER_PRODUCT_BODY_%out_value, L_ITER_PRODUCT_DONE_%out_value
L_ITER_PRODUCT_BODY_%out_value:
    __iter_product_acc_%out_value = load __iter_product_slot_%out_value+0 as u64
    __iter_product_next_%out_value = mul __iter_product_acc_%out_value, __iter_product_value_%out_value
    store __iter_product_slot_%out_value+0, __iter_product_next_%out_value as u64
    !__iter_product_next_%out_value
    !__iter_product_acc_%out_value
    !__iter_product_value_%out_value
    !__iter_product_has_%out_value
    jmp L_ITER_PRODUCT_HEAD_%out_value
L_ITER_PRODUCT_DONE_%out_value:
    %out_value = load __iter_product_slot_%out_value+0 as u64
    !__iter_product_value_%out_value
    !__iter_product_has_%out_value
[END_MACRO]

[MACRO] ITER_MIN_U64 %out_has, %out_value, %iter_reg
    EXPAND ITER_NEXT_U64 __iter_min_has_%out_has, __iter_min_value_%out_has, %iter_reg
    br __iter_min_has_%out_has -> L_ITER_MIN_INIT_%out_has, L_ITER_MIN_NONE_%out_has
L_ITER_MIN_INIT_%out_has:
    __iter_min_slot_%out_has = stack_alloc 8
    store __iter_min_slot_%out_has+0, __iter_min_value_%out_has as u64
    !__iter_min_value_%out_has
    !__iter_min_has_%out_has
