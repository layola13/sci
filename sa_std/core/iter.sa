[MACRO] ITER_SIZE_HINT %out_lower, %out_upper, %iter_reg
    EXPAND ITER_LEN %out_lower, %iter_reg
    %out_upper = add %out_lower, 0
[END_MACRO]

[MACRO] ITER_ADVANCE_BY %out_ok, %out_remaining, %iter_reg, %count
    __iter_adv_len_%out_ok = load %iter_reg+Iter_len as u64
    __iter_adv_index_%out_ok = load %iter_reg+Iter_index as u64
    __iter_adv_remaining_%out_ok = sub __iter_adv_len_%out_ok, __iter_adv_index_%out_ok
    __iter_adv_can_%out_ok = ule %count, __iter_adv_remaining_%out_ok
    br __iter_adv_can_%out_ok -> L_ITER_ADVANCE_BY_OK_%out_ok, L_ITER_ADVANCE_BY_SHORT_%out_ok
L_ITER_ADVANCE_BY_OK_%out_ok:
    __iter_adv_next_%out_ok = add __iter_adv_index_%out_ok, %count
    store %iter_reg+Iter_index, __iter_adv_next_%out_ok as u64
    %out_remaining = add 0, 0
    %out_ok = add 0, 1
    !__iter_adv_next_%out_ok
    !__iter_adv_can_%out_ok
    !__iter_adv_remaining_%out_ok
    !__iter_adv_index_%out_ok
    !__iter_adv_len_%out_ok
    jmp L_ITER_ADVANCE_BY_END_%out_ok
L_ITER_ADVANCE_BY_SHORT_%out_ok:
    %out_remaining = sub %count, __iter_adv_remaining_%out_ok
    store %iter_reg+Iter_index, __iter_adv_len_%out_ok as u64
    %out_ok = add 0, 0
    !__iter_adv_can_%out_ok
    !__iter_adv_remaining_%out_ok
    !__iter_adv_index_%out_ok
    !__iter_adv_len_%out_ok
L_ITER_ADVANCE_BY_END_%out_ok:
[END_MACRO]

[MACRO] ITER_ADVANCE_BACK_BY %out_ok, %out_remaining, %iter_reg, %count
    __iter_adv_back_len_%out_ok = load %iter_reg+Iter_len as u64
    __iter_adv_back_index_%out_ok = load %iter_reg+Iter_index as u64
    __iter_adv_back_remaining_%out_ok = sub __iter_adv_back_len_%out_ok, __iter_adv_back_index_%out_ok
    __iter_adv_back_can_%out_ok = ule %count, __iter_adv_back_remaining_%out_ok
    br __iter_adv_back_can_%out_ok -> L_ITER_ADVANCE_BACK_BY_OK_%out_ok, L_ITER_ADVANCE_BACK_BY_SHORT_%out_ok
