    br __iter_min_next_has_%out_has -> L_ITER_MIN_BODY_%out_has, L_ITER_MIN_DONE_%out_has
L_ITER_MIN_BODY_%out_has:
    __iter_min_current_%out_has = load __iter_min_slot_%out_has+0 as u64
    __iter_min_less_%out_has = ult __iter_min_next_value_%out_has, __iter_min_current_%out_has
    br __iter_min_less_%out_has -> L_ITER_MIN_STORE_%out_has, L_ITER_MIN_KEEP_%out_has
L_ITER_MIN_STORE_%out_has:
    store __iter_min_slot_%out_has+0, __iter_min_next_value_%out_has as u64
    jmp L_ITER_MIN_NEXT_%out_has
L_ITER_MIN_KEEP_%out_has:
    jmp L_ITER_MIN_NEXT_%out_has
L_ITER_MIN_NEXT_%out_has:
    !__iter_min_less_%out_has
    !__iter_min_current_%out_has
    !__iter_min_next_value_%out_has
    !__iter_min_next_has_%out_has
    jmp L_ITER_MIN_HEAD_%out_has
L_ITER_MIN_DONE_%out_has:
    %out_value = load __iter_min_slot_%out_has+0 as u64
    %out_has = add 0, 1
    !__iter_min_next_value_%out_has
