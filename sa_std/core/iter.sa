L_ITER_MAX_BODY_%out_has:
    __iter_max_current_%out_has = load __iter_max_slot_%out_has+0 as u64
    __iter_max_greater_%out_has = ugt __iter_max_next_value_%out_has, __iter_max_current_%out_has
    br __iter_max_greater_%out_has -> L_ITER_MAX_STORE_%out_has, L_ITER_MAX_KEEP_%out_has
L_ITER_MAX_STORE_%out_has:
    store __iter_max_slot_%out_has+0, __iter_max_next_value_%out_has as u64
    jmp L_ITER_MAX_NEXT_%out_has
L_ITER_MAX_KEEP_%out_has:
    jmp L_ITER_MAX_NEXT_%out_has
L_ITER_MAX_NEXT_%out_has:
    !__iter_max_greater_%out_has
    !__iter_max_current_%out_has
    !__iter_max_next_value_%out_has
