[END_MACRO]

[MACRO] ITER_MIN_BY_U64 %out_has, %out_value, %iter_reg, %compare_fn
    EXPAND ITER_NEXT_U64 __iter_min_by_has_%out_has, __iter_min_by_value_%out_has, %iter_reg
    br __iter_min_by_has_%out_has -> L_ITER_MIN_BY_INIT_%out_has, L_ITER_MIN_BY_NONE_%out_has
L_ITER_MIN_BY_INIT_%out_has:
    __iter_min_by_slot_%out_has = stack_alloc 8
    store __iter_min_by_slot_%out_has+0, __iter_min_by_value_%out_has as u64
    !__iter_min_by_value_%out_has
    !__iter_min_by_has_%out_has
    jmp L_ITER_MIN_BY_HEAD_%out_has
L_ITER_MIN_BY_HEAD_%out_has:
    EXPAND ITER_NEXT_U64 __iter_min_by_next_has_%out_has, __iter_min_by_next_value_%out_has, %iter_reg
    br __iter_min_by_next_has_%out_has -> L_ITER_MIN_BY_BODY_%out_has, L_ITER_MIN_BY_DONE_%out_has
L_ITER_MIN_BY_BODY_%out_has:
    __iter_min_by_current_%out_has = load __iter_min_by_slot_%out_has+0 as u64
    __iter_min_by_order_%out_has = call %compare_fn(__iter_min_by_next_value_%out_has, __iter_min_by_current_%out_has)
    __iter_min_by_take_%out_has = slt __iter_min_by_order_%out_has, 0
    br __iter_min_by_take_%out_has -> L_ITER_MIN_BY_STORE_%out_has, L_ITER_MIN_BY_KEEP_%out_has
L_ITER_MIN_BY_STORE_%out_has:
    store __iter_min_by_slot_%out_has+0, __iter_min_by_next_value_%out_has as u64
    jmp L_ITER_MIN_BY_NEXT_%out_has
L_ITER_MIN_BY_KEEP_%out_has:
    jmp L_ITER_MIN_BY_NEXT_%out_has
L_ITER_MIN_BY_NEXT_%out_has:
    !__iter_min_by_take_%out_has
    !__iter_min_by_order_%out_has
    !__iter_min_by_current_%out_has
    !__iter_min_by_next_value_%out_has
    !__iter_min_by_next_has_%out_has
    jmp L_ITER_MIN_BY_HEAD_%out_has
L_ITER_MIN_BY_DONE_%out_has:
    %out_value = load __iter_min_by_slot_%out_has+0 as u64
    %out_has = add 0, 1
    !__iter_min_by_next_value_%out_has
    !__iter_min_by_next_has_%out_has
    jmp L_ITER_MIN_BY_END_%out_has
L_ITER_MIN_BY_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    !__iter_min_by_value_%out_has
    !__iter_min_by_has_%out_has
L_ITER_MIN_BY_END_%out_has:
[END_MACRO]

