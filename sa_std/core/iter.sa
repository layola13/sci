    jmp L_ITER_MIN_END_%out_has
L_ITER_MIN_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    !__iter_min_value_%out_has
    !__iter_min_has_%out_has
L_ITER_MIN_END_%out_has:
[END_MACRO]

[MACRO] ITER_MAX_U64 %out_has, %out_value, %iter_reg
    EXPAND ITER_NEXT_U64 __iter_max_has_%out_has, __iter_max_value_%out_has, %iter_reg
    br __iter_max_has_%out_has -> L_ITER_MAX_INIT_%out_has, L_ITER_MAX_NONE_%out_has
L_ITER_MAX_INIT_%out_has:
    __iter_max_slot_%out_has = stack_alloc 8
    store __iter_max_slot_%out_has+0, __iter_max_value_%out_has as u64
    !__iter_max_value_%out_has
    !__iter_max_has_%out_has
