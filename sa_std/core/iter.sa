    !__iter_adv_back_can_%out_ok
    !__iter_adv_back_remaining_%out_ok
    !__iter_adv_back_index_%out_ok
    !__iter_adv_back_len_%out_ok
L_ITER_ADVANCE_BACK_BY_END_%out_ok:
[END_MACRO]

[MACRO] ITER_NTH_BACK_U64 %out_has, %out_value, %iter_reg, %nth
    __iter_nth_back_len_%out_has = load %iter_reg+Iter_len as u64
    __iter_nth_back_index_%out_has = load %iter_reg+Iter_index as u64
    __iter_nth_back_remaining_%out_has = sub __iter_nth_back_len_%out_has, __iter_nth_back_index_%out_has
    __iter_nth_back_ok_%out_has = ult %nth, __iter_nth_back_remaining_%out_has
    br __iter_nth_back_ok_%out_has -> L_ITER_NTH_BACK_SOME_%out_has, L_ITER_NTH_BACK_NONE_%out_has
L_ITER_NTH_BACK_SOME_%out_has:
    __iter_nth_back_skip_%out_has = add %nth, 1
    __iter_nth_back_target_%out_has = sub __iter_nth_back_len_%out_has, __iter_nth_back_skip_%out_has
    __iter_nth_back_ptr_%out_has = load %iter_reg+Iter_ptr as ptr
    __iter_nth_back_off_%out_has = mul __iter_nth_back_target_%out_has, 8
    __iter_nth_back_item_%out_has = ptr_add __iter_nth_back_ptr_%out_has, __iter_nth_back_off_%out_has
    %out_value = load __iter_nth_back_item_%out_has+0 as u64
    store %iter_reg+Iter_len, __iter_nth_back_target_%out_has as u64
    %out_has = add 0, 1
    !__iter_nth_back_item_%out_has
    !__iter_nth_back_off_%out_has
    !__iter_nth_back_ptr_%out_has
    !__iter_nth_back_target_%out_has
    !__iter_nth_back_skip_%out_has
    !__iter_nth_back_ok_%out_has
    !__iter_nth_back_remaining_%out_has
    !__iter_nth_back_index_%out_has
    !__iter_nth_back_len_%out_has
    jmp L_ITER_NTH_BACK_END_%out_has
L_ITER_NTH_BACK_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    store %iter_reg+Iter_len, __iter_nth_back_index_%out_has as u64
    !__iter_nth_back_ok_%out_has
    !__iter_nth_back_remaining_%out_has
    !__iter_nth_back_index_%out_has
    !__iter_nth_back_len_%out_has
L_ITER_NTH_BACK_END_%out_has:
[END_MACRO]

[MACRO] ITER_RFIND_U64 %out_has, %out_value, %iter_reg, %pred_fn
    jmp L_ITER_RFIND_HEAD_%out_has
L_ITER_RFIND_HEAD_%out_has:
    EXPAND ITER_NEXT_BACK_U64 __iter_rfind_has_%out_has, __iter_rfind_value_%out_has, %iter_reg
    br __iter_rfind_has_%out_has -> L_ITER_RFIND_CHECK_%out_has, L_ITER_RFIND_NONE_%out_has
L_ITER_RFIND_CHECK_%out_has:
    __iter_rfind_pred_%out_has = call %pred_fn(__iter_rfind_value_%out_has)
    __iter_rfind_match_%out_has = ne __iter_rfind_pred_%out_has, 0
    br __iter_rfind_match_%out_has -> L_ITER_RFIND_SOME_%out_has, L_ITER_RFIND_NEXT_%out_has
