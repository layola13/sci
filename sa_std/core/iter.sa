[MACRO] ITER_MIN_BY_KEY_U64 %out_has, %out_value, %iter_reg, %key_fn
    EXPAND ITER_NEXT_U64 __iter_min_key_has_%out_has, __iter_min_key_value_%out_has, %iter_reg
    br __iter_min_key_has_%out_has -> L_ITER_MIN_KEY_INIT_%out_has, L_ITER_MIN_KEY_NONE_%out_has
L_ITER_MIN_KEY_INIT_%out_has:
    __iter_min_key_slot_%out_has = stack_alloc 8
    store __iter_min_key_slot_%out_has+0, __iter_min_key_value_%out_has as u64
    !__iter_min_key_value_%out_has
    !__iter_min_key_has_%out_has
    jmp L_ITER_MIN_KEY_HEAD_%out_has
L_ITER_MIN_KEY_HEAD_%out_has:
    EXPAND ITER_NEXT_U64 __iter_min_key_next_has_%out_has, __iter_min_key_next_value_%out_has, %iter_reg
    br __iter_min_key_next_has_%out_has -> L_ITER_MIN_KEY_BODY_%out_has, L_ITER_MIN_KEY_DONE_%out_has
L_ITER_MIN_KEY_BODY_%out_has:
    __iter_min_key_current_%out_has = load __iter_min_key_slot_%out_has+0 as u64
    __iter_min_key_current_key_%out_has = call %key_fn(__iter_min_key_current_%out_has)
    __iter_min_key_next_key_%out_has = call %key_fn(__iter_min_key_next_value_%out_has)
    __iter_min_key_take_%out_has = ult __iter_min_key_next_key_%out_has, __iter_min_key_current_key_%out_has
    br __iter_min_key_take_%out_has -> L_ITER_MIN_KEY_STORE_%out_has, L_ITER_MIN_KEY_KEEP_%out_has
L_ITER_MIN_KEY_STORE_%out_has:
    store __iter_min_key_slot_%out_has+0, __iter_min_key_next_value_%out_has as u64
    jmp L_ITER_MIN_KEY_NEXT_%out_has
L_ITER_MIN_KEY_KEEP_%out_has:
    jmp L_ITER_MIN_KEY_NEXT_%out_has
L_ITER_MIN_KEY_NEXT_%out_has:
    !__iter_min_key_take_%out_has
    !__iter_min_key_next_key_%out_has
    !__iter_min_key_current_key_%out_has
    !__iter_min_key_current_%out_has
    !__iter_min_key_next_value_%out_has
    !__iter_min_key_next_has_%out_has
    jmp L_ITER_MIN_KEY_HEAD_%out_has
L_ITER_MIN_KEY_DONE_%out_has:
    %out_value = load __iter_min_key_slot_%out_has+0 as u64
    %out_has = add 0, 1
    !__iter_min_key_next_value_%out_has
    !__iter_min_key_next_has_%out_has
    jmp L_ITER_MIN_KEY_END_%out_has
L_ITER_MIN_KEY_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    !__iter_min_key_value_%out_has
    !__iter_min_key_has_%out_has
L_ITER_MIN_KEY_END_%out_has:
[END_MACRO]

[MACRO] ITER_MAX_BY_KEY_U64 %out_has, %out_value, %iter_reg, %key_fn
    EXPAND ITER_NEXT_U64 __iter_max_key_has_%out_has, __iter_max_key_value_%out_has, %iter_reg
    br __iter_max_key_has_%out_has -> L_ITER_MAX_KEY_INIT_%out_has, L_ITER_MAX_KEY_NONE_%out_has
L_ITER_MAX_KEY_INIT_%out_has:
    __iter_max_key_slot_%out_has = stack_alloc 8
    store __iter_max_key_slot_%out_has+0, __iter_max_key_value_%out_has as u64
    !__iter_max_key_value_%out_has
    !__iter_max_key_has_%out_has
    jmp L_ITER_MAX_KEY_HEAD_%out_has
L_ITER_MAX_KEY_HEAD_%out_has:
    EXPAND ITER_NEXT_U64 __iter_max_key_next_has_%out_has, __iter_max_key_next_value_%out_has, %iter_reg
    br __iter_max_key_next_has_%out_has -> L_ITER_MAX_KEY_BODY_%out_has, L_ITER_MAX_KEY_DONE_%out_has
L_ITER_MAX_KEY_BODY_%out_has:
    __iter_max_key_current_%out_has = load __iter_max_key_slot_%out_has+0 as u64
    __iter_max_key_current_key_%out_has = call %key_fn(__iter_max_key_current_%out_has)
    __iter_max_key_next_key_%out_has = call %key_fn(__iter_max_key_next_value_%out_has)
    __iter_max_key_take_%out_has = ugt __iter_max_key_next_key_%out_has, __iter_max_key_current_key_%out_has
    br __iter_max_key_take_%out_has -> L_ITER_MAX_KEY_STORE_%out_has, L_ITER_MAX_KEY_KEEP_%out_has
L_ITER_MAX_KEY_STORE_%out_has:
    store __iter_max_key_slot_%out_has+0, __iter_max_key_next_value_%out_has as u64
    jmp L_ITER_MAX_KEY_NEXT_%out_has
L_ITER_MAX_KEY_KEEP_%out_has:
    jmp L_ITER_MAX_KEY_NEXT_%out_has
L_ITER_MAX_KEY_NEXT_%out_has:
    !__iter_max_key_take_%out_has
    !__iter_max_key_next_key_%out_has
    !__iter_max_key_current_key_%out_has
    !__iter_max_key_current_%out_has
    !__iter_max_key_next_value_%out_has
    !__iter_max_key_next_has_%out_has
    jmp L_ITER_MAX_KEY_HEAD_%out_has
L_ITER_MAX_KEY_DONE_%out_has:
    %out_value = load __iter_max_key_slot_%out_has+0 as u64
    %out_has = add 0, 1
    !__iter_max_key_next_value_%out_has
    !__iter_max_key_next_has_%out_has
    jmp L_ITER_MAX_KEY_END_%out_has
L_ITER_MAX_KEY_NONE_%out_has:
    %out_value = add 0, 0
    %out_has = add 0, 0
    !__iter_max_key_value_%out_has
    !__iter_max_key_has_%out_has
L_ITER_MAX_KEY_END_%out_has:
[END_MACRO]

[MACRO] ITER_CMP_U64 %out_ordering, %left_iter, %right_iter
    jmp L_ITER_CMP_HEAD_%out_ordering
L_ITER_CMP_HEAD_%out_ordering:
    EXPAND ITER_NEXT_U64 __iter_cmp_left_has_%out_ordering, __iter_cmp_left_value_%out_ordering, %left_iter
    EXPAND ITER_NEXT_U64 __iter_cmp_right_has_%out_ordering, __iter_cmp_right_value_%out_ordering, %right_iter
    br __iter_cmp_left_has_%out_ordering -> L_ITER_CMP_LEFT_SOME_%out_ordering, L_ITER_CMP_LEFT_NONE_%out_ordering
L_ITER_CMP_LEFT_SOME_%out_ordering:
    br __iter_cmp_right_has_%out_ordering -> L_ITER_CMP_BOTH_SOME_%out_ordering, L_ITER_CMP_RIGHT_NONE_%out_ordering
L_ITER_CMP_BOTH_SOME_%out_ordering:
    __iter_cmp_less_%out_ordering = ult __iter_cmp_left_value_%out_ordering, __iter_cmp_right_value_%out_ordering
    br __iter_cmp_less_%out_ordering -> L_ITER_CMP_LESS_%out_ordering, L_ITER_CMP_CHECK_GREATER_%out_ordering
L_ITER_CMP_CHECK_GREATER_%out_ordering:
    __iter_cmp_greater_%out_ordering = ugt __iter_cmp_left_value_%out_ordering, __iter_cmp_right_value_%out_ordering
    br __iter_cmp_greater_%out_ordering -> L_ITER_CMP_GREATER_%out_ordering, L_ITER_CMP_EQUAL_ITEM_%out_ordering
L_ITER_CMP_EQUAL_ITEM_%out_ordering:
    !__iter_cmp_greater_%out_ordering
    !__iter_cmp_less_%out_ordering
    !__iter_cmp_right_value_%out_ordering
    !__iter_cmp_right_has_%out_ordering
    !__iter_cmp_left_value_%out_ordering
    !__iter_cmp_left_has_%out_ordering
    jmp L_ITER_CMP_HEAD_%out_ordering
L_ITER_CMP_LESS_%out_ordering:
    %out_ordering = sub 0, 1
    !__iter_cmp_less_%out_ordering
    !__iter_cmp_right_value_%out_ordering
    !__iter_cmp_right_has_%out_ordering
    !__iter_cmp_left_value_%out_ordering
    !__iter_cmp_left_has_%out_ordering
    jmp L_ITER_CMP_END_%out_ordering
L_ITER_CMP_GREATER_%out_ordering:
    %out_ordering = add 0, 1
    !__iter_cmp_greater_%out_ordering
    !__iter_cmp_less_%out_ordering
    !__iter_cmp_right_value_%out_ordering
    !__iter_cmp_right_has_%out_ordering
    !__iter_cmp_left_value_%out_ordering
    !__iter_cmp_left_has_%out_ordering
    jmp L_ITER_CMP_END_%out_ordering
L_ITER_CMP_RIGHT_NONE_%out_ordering:
    %out_ordering = add 0, 1
    !__iter_cmp_right_value_%out_ordering
    !__iter_cmp_right_has_%out_ordering
    !__iter_cmp_left_value_%out_ordering
    !__iter_cmp_left_has_%out_ordering
    jmp L_ITER_CMP_END_%out_ordering
L_ITER_CMP_LEFT_NONE_%out_ordering:
    br __iter_cmp_right_has_%out_ordering -> L_ITER_CMP_LEFT_SHORT_%out_ordering, L_ITER_CMP_BOTH_DONE_%out_ordering
L_ITER_CMP_LEFT_SHORT_%out_ordering:
    %out_ordering = sub 0, 1
    !__iter_cmp_right_value_%out_ordering
    !__iter_cmp_right_has_%out_ordering
    !__iter_cmp_left_value_%out_ordering
    !__iter_cmp_left_has_%out_ordering
    jmp L_ITER_CMP_END_%out_ordering
L_ITER_CMP_BOTH_DONE_%out_ordering:
    %out_ordering = add 0, 0
    !__iter_cmp_right_value_%out_ordering
    !__iter_cmp_right_has_%out_ordering
    !__iter_cmp_left_value_%out_ordering
    !__iter_cmp_left_has_%out_ordering
L_ITER_CMP_END_%out_ordering:
[END_MACRO]

[MACRO] ITER_EQ_U64 %out_bool, %left_iter, %right_iter
    EXPAND ITER_CMP_U64 __iter_eq_order_%out_bool, %left_iter, %right_iter
    %out_bool = eq __iter_eq_order_%out_bool, 0
    !__iter_eq_order_%out_bool
[END_MACRO]

[MACRO] ITER_NE_U64 %out_bool, %left_iter, %right_iter
    EXPAND ITER_CMP_U64 __iter_ne_order_%out_bool, %left_iter, %right_iter
    __iter_ne_is_eq_%out_bool = eq __iter_ne_order_%out_bool, 0
    %out_bool = eq __iter_ne_is_eq_%out_bool, 0
    !__iter_ne_is_eq_%out_bool
    !__iter_ne_order_%out_bool
[END_MACRO]

[MACRO] ITER_LT_U64 %out_bool, %left_iter, %right_iter
    EXPAND ITER_CMP_U64 __iter_lt_order_%out_bool, %left_iter, %right_iter
    %out_bool = slt __iter_lt_order_%out_bool, 0
    !__iter_lt_order_%out_bool
[END_MACRO]

[MACRO] ITER_LE_U64 %out_bool, %left_iter, %right_iter
    EXPAND ITER_CMP_U64 __iter_le_order_%out_bool, %left_iter, %right_iter
    %out_bool = sle __iter_le_order_%out_bool, 0
    !__iter_le_order_%out_bool
[END_MACRO]

[MACRO] ITER_GT_U64 %out_bool, %left_iter, %right_iter
    EXPAND ITER_CMP_U64 __iter_gt_order_%out_bool, %left_iter, %right_iter
    %out_bool = sgt __iter_gt_order_%out_bool, 0
    !__iter_gt_order_%out_bool
[END_MACRO]

[MACRO] ITER_GE_U64 %out_bool, %left_iter, %right_iter
    EXPAND ITER_CMP_U64 __iter_ge_order_%out_bool, %left_iter, %right_iter
    %out_bool = sge __iter_ge_order_%out_bool, 0
    !__iter_ge_order_%out_bool
[END_MACRO]
