// 在栈上或预分配寄存器中初始化 Slice
[MACRO] SLICE_NEW %slice_reg, %data_ptr, %length
    store %slice_reg+Slice_ptr, %data_ptr as ptr
    store %slice_reg+Slice_len, %length as u64
[END_MACRO]

[MACRO] SLICE_GET_PTR %out_ptr, %slice_reg
    %out_ptr = load %slice_reg+Slice_ptr as ptr
[END_MACRO]

[MACRO] SLICE_AS_PTR %out_ptr, %slice_reg
    EXPAND SLICE_GET_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] SLICE_GET_LEN %out_len, %slice_reg
    %out_len = load %slice_reg+Slice_len as u64
[END_MACRO]

[MACRO] SLICE_IS_EMPTY %out_bool, %slice_reg
    __slice_len_%out_bool = load %slice_reg+Slice_len as u64
    %out_bool = eq __slice_len_%out_bool, 0
    !__slice_len_%out_bool
[END_MACRO]

[MACRO] SLICE_GET_U64 %out_value, %slice_reg, %index
    __slice_ptr_%out_value = load %slice_reg+Slice_ptr as ptr
    __slice_off_%out_value = mul %index, 8
    __slice_item_%out_value = ptr_add __slice_ptr_%out_value, __slice_off_%out_value
    %out_value = load __slice_item_%out_value+0 as u64
    !__slice_item_%out_value
    !__slice_off_%out_value
    !__slice_ptr_%out_value
[END_MACRO]

[MACRO] SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, %index
    __slice_ptr_%out_ptr = load %slice_reg+Slice_ptr as ptr
    __slice_off_%out_ptr = mul %index, 8
    %out_ptr = ptr_add __slice_ptr_%out_ptr, __slice_off_%out_ptr
    !__slice_off_%out_ptr
    !__slice_ptr_%out_ptr
[END_MACRO]

[MACRO] SLICE_FIRST_U64 %out_value, %slice_reg
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, 0
[END_MACRO]

[MACRO] SLICE_FIRST_MUT_PTR_U64 %out_ptr, %slice_reg
    EXPAND SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, 0
[END_MACRO]

[MACRO] SLICE_TRY_FIRST_U64 %out_ok, %out_value, %slice_reg
    EXPAND SLICE_TRY_GET_U64 %out_ok, %out_value, %slice_reg, 0
[END_MACRO]

[MACRO] SLICE_LAST_U64 %out_value, %slice_reg
    __slice_len_%out_value = load %slice_reg+Slice_len as u64
    __slice_last_%out_value = sub __slice_len_%out_value, 1
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, __slice_last_%out_value
    !__slice_last_%out_value
    !__slice_len_%out_value
[END_MACRO]

[MACRO] SLICE_LAST_MUT_PTR_U64 %out_ptr, %slice_reg
    __slice_len_%out_ptr = load %slice_reg+Slice_len as u64
    __slice_last_%out_ptr = sub __slice_len_%out_ptr, 1
    EXPAND SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, __slice_last_%out_ptr
    !__slice_last_%out_ptr
    !__slice_len_%out_ptr
[END_MACRO]

[MACRO] SLICE_TRY_LAST_U64 %out_ok, %out_value, %slice_reg
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_empty_%out_ok = eq __slice_len_%out_ok, 0
    br __slice_empty_%out_ok -> L_SLICE_TRY_LAST_MISS_%out_ok, L_SLICE_TRY_LAST_HIT_%out_ok

L_SLICE_TRY_LAST_HIT_%out_ok:
    __slice_last_%out_ok = sub __slice_len_%out_ok, 1
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, __slice_last_%out_ok
    %out_ok = add 0, 1
    !__slice_last_%out_ok
    !__slice_empty_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_TRY_LAST_END_%out_ok

L_SLICE_TRY_LAST_MISS_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__slice_empty_%out_ok
    !__slice_len_%out_ok

L_SLICE_TRY_LAST_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_TRY_GET_U64 %out_ok, %out_value, %slice_reg, %index
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_in_bounds_%out_ok = ult %index, __slice_len_%out_ok
    br __slice_in_bounds_%out_ok -> L_SLICE_TRY_GET_HIT_%out_ok, L_SLICE_TRY_GET_MISS_%out_ok

L_SLICE_TRY_GET_HIT_%out_ok:
    EXPAND SLICE_GET_U64 %out_value, %slice_reg, %index
    %out_ok = add 0, 1
    !__slice_in_bounds_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_TRY_GET_END_%out_ok

L_SLICE_TRY_GET_MISS_%out_ok:
    %out_value = add 0, 0
    %out_ok = add 0, 0
    !__slice_in_bounds_%out_ok
    !__slice_len_%out_ok

L_SLICE_TRY_GET_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_TRY_GET_MUT_PTR_U64 %out_ok, %out_ptr, %slice_reg, %index
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_in_bounds_%out_ok = ult %index, __slice_len_%out_ok
    br __slice_in_bounds_%out_ok -> L_SLICE_TRY_GET_MUT_HIT_%out_ok, L_SLICE_TRY_GET_MUT_MISS_%out_ok

L_SLICE_TRY_GET_MUT_HIT_%out_ok:
    EXPAND SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, %index
    %out_ok = add 0, 1
    !__slice_in_bounds_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_TRY_GET_MUT_END_%out_ok

L_SLICE_TRY_GET_MUT_MISS_%out_ok:
    %out_ptr = 0 as ptr
    %out_ok = add 0, 0
    !__slice_in_bounds_%out_ok
    !__slice_len_%out_ok

L_SLICE_TRY_GET_MUT_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_TRY_FIRST_MUT_PTR_U64 %out_ok, %out_ptr, %slice_reg
    EXPAND SLICE_TRY_GET_MUT_PTR_U64 %out_ok, %out_ptr, %slice_reg, 0
[END_MACRO]

[MACRO] SLICE_TRY_LAST_MUT_PTR_U64 %out_ok, %out_ptr, %slice_reg
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_empty_%out_ok = eq __slice_len_%out_ok, 0
    br __slice_empty_%out_ok -> L_SLICE_TRY_LAST_MUT_MISS_%out_ok, L_SLICE_TRY_LAST_MUT_HIT_%out_ok

L_SLICE_TRY_LAST_MUT_HIT_%out_ok:
    __slice_last_%out_ok = sub __slice_len_%out_ok, 1
    EXPAND SLICE_GET_MUT_PTR_U64 %out_ptr, %slice_reg, __slice_last_%out_ok
    %out_ok = add 0, 1
    !__slice_last_%out_ok
    !__slice_empty_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_TRY_LAST_MUT_END_%out_ok

L_SLICE_TRY_LAST_MUT_MISS_%out_ok:
    %out_ptr = 0 as ptr
    %out_ok = add 0, 0
    !__slice_empty_%out_ok
    !__slice_len_%out_ok

L_SLICE_TRY_LAST_MUT_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_CONTAINS_U64 %out_bool, %slice_reg, %needle
    __slice_ptr_%out_bool = load %slice_reg+Slice_ptr as ptr
    __slice_len_%out_bool = load %slice_reg+Slice_len as u64
    __slice_idx_slot_%out_bool = stack_alloc 8
    store __slice_idx_slot_%out_bool+0, 0 as u64
    jmp L_SLICE_CONTAINS_HEAD_%out_bool

L_SLICE_CONTAINS_HEAD_%out_bool:
    __slice_idx_%out_bool = load __slice_idx_slot_%out_bool+0 as u64
    __slice_done_%out_bool = eq __slice_idx_%out_bool, __slice_len_%out_bool
    br __slice_done_%out_bool -> L_SLICE_CONTAINS_MISS_%out_bool, L_SLICE_CONTAINS_BODY_%out_bool

L_SLICE_CONTAINS_BODY_%out_bool:
    __slice_off_%out_bool = mul __slice_idx_%out_bool, 8
    __slice_elem_ptr_%out_bool = ptr_add __slice_ptr_%out_bool, __slice_off_%out_bool
    __slice_elem_%out_bool = load __slice_elem_ptr_%out_bool+0 as u64
    __slice_match_%out_bool = eq __slice_elem_%out_bool, %needle
    br __slice_match_%out_bool -> L_SLICE_CONTAINS_HIT_%out_bool, L_SLICE_CONTAINS_NEXT_%out_bool

L_SLICE_CONTAINS_NEXT_%out_bool:
    __slice_next_%out_bool = add __slice_idx_%out_bool, 1
    store __slice_idx_slot_%out_bool+0, __slice_next_%out_bool as u64
    !__slice_next_%out_bool
    !__slice_match_%out_bool
    !__slice_elem_%out_bool
    !__slice_elem_ptr_%out_bool
    !__slice_off_%out_bool
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    jmp L_SLICE_CONTAINS_HEAD_%out_bool

L_SLICE_CONTAINS_HIT_%out_bool:
    %out_bool = add 0, 1
    !__slice_match_%out_bool
    !__slice_elem_%out_bool
    !__slice_elem_ptr_%out_bool
    !__slice_off_%out_bool
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    !__slice_len_%out_bool
    !__slice_ptr_%out_bool
    jmp L_SLICE_CONTAINS_END_%out_bool

L_SLICE_CONTAINS_MISS_%out_bool:
    %out_bool = add 0, 0
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    !__slice_len_%out_bool
    !__slice_ptr_%out_bool

L_SLICE_CONTAINS_END_%out_bool:
[END_MACRO]

[MACRO] SLICE_STARTS_WITH_U64 %out_bool, %slice_reg, %prefix_slice
    __slice_ptr_%out_bool = load %slice_reg+Slice_ptr as ptr
    __slice_prefix_ptr_%out_bool = load %prefix_slice+Slice_ptr as ptr
    __slice_len_%out_bool = load %slice_reg+Slice_len as u64
    __slice_prefix_len_%out_bool = load %prefix_slice+Slice_len as u64
    __slice_idx_slot_%out_bool = stack_alloc 8
    store __slice_idx_slot_%out_bool+0, 0 as u64
    __slice_can_match_%out_bool = ule __slice_prefix_len_%out_bool, __slice_len_%out_bool
    br __slice_can_match_%out_bool -> L_SLICE_STARTS_HEAD_%out_bool, L_SLICE_STARTS_FALSE_%out_bool

L_SLICE_STARTS_HEAD_%out_bool:
    __slice_idx_%out_bool = load __slice_idx_slot_%out_bool+0 as u64
    __slice_done_%out_bool = eq __slice_idx_%out_bool, __slice_prefix_len_%out_bool
    br __slice_done_%out_bool -> L_SLICE_STARTS_TRUE_%out_bool, L_SLICE_STARTS_BODY_%out_bool

L_SLICE_STARTS_BODY_%out_bool:
    __slice_off_%out_bool = mul __slice_idx_%out_bool, 8
    __slice_elem_ptr_%out_bool = ptr_add __slice_ptr_%out_bool, __slice_off_%out_bool
    __slice_prefix_elem_ptr_%out_bool = ptr_add __slice_prefix_ptr_%out_bool, __slice_off_%out_bool
    __slice_elem_%out_bool = load __slice_elem_ptr_%out_bool+0 as u64
    __slice_prefix_elem_%out_bool = load __slice_prefix_elem_ptr_%out_bool+0 as u64
    __slice_match_%out_bool = eq __slice_elem_%out_bool, __slice_prefix_elem_%out_bool
    br __slice_match_%out_bool -> L_SLICE_STARTS_NEXT_%out_bool, L_SLICE_STARTS_FALSE_LOOP_%out_bool

L_SLICE_STARTS_NEXT_%out_bool:
    __slice_next_%out_bool = add __slice_idx_%out_bool, 1
    store __slice_idx_slot_%out_bool+0, __slice_next_%out_bool as u64
    !__slice_next_%out_bool
    !__slice_match_%out_bool
    !__slice_prefix_elem_%out_bool
    !__slice_elem_%out_bool
    !__slice_prefix_elem_ptr_%out_bool
    !__slice_elem_ptr_%out_bool
    !__slice_off_%out_bool
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    jmp L_SLICE_STARTS_HEAD_%out_bool

L_SLICE_STARTS_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    !__slice_can_match_%out_bool
    !__slice_prefix_len_%out_bool
    !__slice_len_%out_bool
    !__slice_prefix_ptr_%out_bool
    !__slice_ptr_%out_bool
    jmp L_SLICE_STARTS_END_%out_bool

L_SLICE_STARTS_FALSE_LOOP_%out_bool:
    %out_bool = add 0, 0
    !__slice_match_%out_bool
    !__slice_prefix_elem_%out_bool
    !__slice_elem_%out_bool
    !__slice_prefix_elem_ptr_%out_bool
    !__slice_elem_ptr_%out_bool
    !__slice_off_%out_bool
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    !__slice_can_match_%out_bool
    !__slice_prefix_len_%out_bool
    !__slice_len_%out_bool
    !__slice_prefix_ptr_%out_bool
    !__slice_ptr_%out_bool
    jmp L_SLICE_STARTS_END_%out_bool

L_SLICE_STARTS_FALSE_%out_bool:
    %out_bool = add 0, 0
    !__slice_can_match_%out_bool
    !__slice_prefix_len_%out_bool
    !__slice_len_%out_bool
    !__slice_prefix_ptr_%out_bool
    !__slice_ptr_%out_bool

L_SLICE_STARTS_END_%out_bool:
[END_MACRO]

[MACRO] SLICE_ENDS_WITH_U64 %out_bool, %slice_reg, %suffix_slice
    __slice_ptr_%out_bool = load %slice_reg+Slice_ptr as ptr
    __slice_suffix_ptr_%out_bool = load %suffix_slice+Slice_ptr as ptr
    __slice_len_%out_bool = load %slice_reg+Slice_len as u64
    __slice_suffix_len_%out_bool = load %suffix_slice+Slice_len as u64
    __slice_idx_slot_%out_bool = stack_alloc 8
    store __slice_idx_slot_%out_bool+0, 0 as u64
    __slice_can_match_%out_bool = ule __slice_suffix_len_%out_bool, __slice_len_%out_bool
    br __slice_can_match_%out_bool -> L_SLICE_ENDS_INIT_%out_bool, L_SLICE_ENDS_FALSE_%out_bool

L_SLICE_ENDS_INIT_%out_bool:
    __slice_start_%out_bool = sub __slice_len_%out_bool, __slice_suffix_len_%out_bool
    jmp L_SLICE_ENDS_HEAD_%out_bool

L_SLICE_ENDS_HEAD_%out_bool:
    __slice_idx_%out_bool = load __slice_idx_slot_%out_bool+0 as u64
    __slice_done_%out_bool = eq __slice_idx_%out_bool, __slice_suffix_len_%out_bool
    br __slice_done_%out_bool -> L_SLICE_ENDS_TRUE_%out_bool, L_SLICE_ENDS_BODY_%out_bool

L_SLICE_ENDS_BODY_%out_bool:
    __slice_hay_idx_%out_bool = add __slice_start_%out_bool, __slice_idx_%out_bool
    __slice_hay_off_%out_bool = mul __slice_hay_idx_%out_bool, 8
    __slice_suffix_off_%out_bool = mul __slice_idx_%out_bool, 8
    __slice_elem_ptr_%out_bool = ptr_add __slice_ptr_%out_bool, __slice_hay_off_%out_bool
    __slice_suffix_elem_ptr_%out_bool = ptr_add __slice_suffix_ptr_%out_bool, __slice_suffix_off_%out_bool
    __slice_elem_%out_bool = load __slice_elem_ptr_%out_bool+0 as u64
    __slice_suffix_elem_%out_bool = load __slice_suffix_elem_ptr_%out_bool+0 as u64
    __slice_match_%out_bool = eq __slice_elem_%out_bool, __slice_suffix_elem_%out_bool
    br __slice_match_%out_bool -> L_SLICE_ENDS_NEXT_%out_bool, L_SLICE_ENDS_FALSE_LOOP_%out_bool

L_SLICE_ENDS_NEXT_%out_bool:
    __slice_next_%out_bool = add __slice_idx_%out_bool, 1
    store __slice_idx_slot_%out_bool+0, __slice_next_%out_bool as u64
    !__slice_next_%out_bool
    !__slice_match_%out_bool
    !__slice_suffix_elem_%out_bool
    !__slice_elem_%out_bool
    !__slice_suffix_elem_ptr_%out_bool
    !__slice_elem_ptr_%out_bool
    !__slice_suffix_off_%out_bool
    !__slice_hay_off_%out_bool
    !__slice_hay_idx_%out_bool
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    jmp L_SLICE_ENDS_HEAD_%out_bool

L_SLICE_ENDS_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    !__slice_start_%out_bool
    !__slice_can_match_%out_bool
    !__slice_suffix_len_%out_bool
    !__slice_len_%out_bool
    !__slice_suffix_ptr_%out_bool
    !__slice_ptr_%out_bool
    jmp L_SLICE_ENDS_END_%out_bool

L_SLICE_ENDS_FALSE_LOOP_%out_bool:
    %out_bool = add 0, 0
    !__slice_match_%out_bool
    !__slice_suffix_elem_%out_bool
    !__slice_elem_%out_bool
    !__slice_suffix_elem_ptr_%out_bool
    !__slice_elem_ptr_%out_bool
    !__slice_suffix_off_%out_bool
    !__slice_hay_off_%out_bool
    !__slice_hay_idx_%out_bool
    !__slice_done_%out_bool
    !__slice_idx_%out_bool
    !__slice_start_%out_bool
    !__slice_can_match_%out_bool
    !__slice_suffix_len_%out_bool
    !__slice_len_%out_bool
    !__slice_suffix_ptr_%out_bool
    !__slice_ptr_%out_bool
    jmp L_SLICE_ENDS_END_%out_bool

L_SLICE_ENDS_FALSE_%out_bool:
    %out_bool = add 0, 0
    !__slice_can_match_%out_bool
    !__slice_suffix_len_%out_bool
    !__slice_len_%out_bool
    !__slice_suffix_ptr_%out_bool
    !__slice_ptr_%out_bool

L_SLICE_ENDS_END_%out_bool:
[END_MACRO]

[MACRO] SLICE_TRY_STRIP_PREFIX_U64 %out_ok, %out_slice, %slice_reg, %prefix_slice
    %out_slice = alloc Slice_SIZE
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_prefix_len_%out_ok = load %prefix_slice+Slice_len as u64
    EXPAND SLICE_STARTS_WITH_U64 __slice_strip_match_%out_ok, %slice_reg, %prefix_slice
    br __slice_strip_match_%out_ok -> L_SLICE_STRIP_PREFIX_HIT_%out_ok, L_SLICE_STRIP_PREFIX_MISS_%out_ok

L_SLICE_STRIP_PREFIX_HIT_%out_ok:
    __slice_rest_len_%out_ok = sub __slice_len_%out_ok, __slice_prefix_len_%out_ok
    __slice_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __slice_prefix_bytes_%out_ok = mul __slice_prefix_len_%out_ok, 8
    __slice_rest_ptr_%out_ok = ptr_add __slice_src_ptr_%out_ok, __slice_prefix_bytes_%out_ok
    EXPAND SLICE_NEW %out_slice, __slice_rest_ptr_%out_ok, __slice_rest_len_%out_ok
    %out_ok = add 0, 1
    !__slice_rest_ptr_%out_ok
    !__slice_prefix_bytes_%out_ok
    !__slice_src_ptr_%out_ok
    !__slice_rest_len_%out_ok
    !__slice_strip_match_%out_ok
    !__slice_prefix_len_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_STRIP_PREFIX_END_%out_ok

L_SLICE_STRIP_PREFIX_MISS_%out_ok:
    __slice_empty_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_empty_ptr_%out_ok
    !__slice_strip_match_%out_ok
    !__slice_prefix_len_%out_ok
    !__slice_len_%out_ok

L_SLICE_STRIP_PREFIX_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_TRY_STRIP_SUFFIX_U64 %out_ok, %out_slice, %slice_reg, %suffix_slice
    %out_slice = alloc Slice_SIZE
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_suffix_len_%out_ok = load %suffix_slice+Slice_len as u64
    EXPAND SLICE_ENDS_WITH_U64 __slice_strip_match_%out_ok, %slice_reg, %suffix_slice
    br __slice_strip_match_%out_ok -> L_SLICE_STRIP_SUFFIX_HIT_%out_ok, L_SLICE_STRIP_SUFFIX_MISS_%out_ok

L_SLICE_STRIP_SUFFIX_HIT_%out_ok:
    __slice_rest_len_%out_ok = sub __slice_len_%out_ok, __slice_suffix_len_%out_ok
    __slice_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    EXPAND SLICE_NEW %out_slice, __slice_src_ptr_%out_ok, __slice_rest_len_%out_ok
    %out_ok = add 0, 1
    !__slice_src_ptr_%out_ok
    !__slice_rest_len_%out_ok
    !__slice_strip_match_%out_ok
    !__slice_suffix_len_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_STRIP_SUFFIX_END_%out_ok

L_SLICE_STRIP_SUFFIX_MISS_%out_ok:
    __slice_empty_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_empty_ptr_%out_ok
    !__slice_strip_match_%out_ok
    !__slice_suffix_len_%out_ok
    !__slice_len_%out_ok

L_SLICE_STRIP_SUFFIX_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_TRIM_PREFIX_U64 %out_slice, %slice_reg, %prefix_slice
    %out_slice = alloc Slice_SIZE
    __slice_len_%out_slice = load %slice_reg+Slice_len as u64
    __slice_prefix_len_%out_slice = load %prefix_slice+Slice_len as u64
    EXPAND SLICE_STARTS_WITH_U64 __slice_trim_match_%out_slice, %slice_reg, %prefix_slice
    br __slice_trim_match_%out_slice -> L_SLICE_TRIM_PREFIX_HIT_%out_slice, L_SLICE_TRIM_PREFIX_MISS_%out_slice

L_SLICE_TRIM_PREFIX_HIT_%out_slice:
    __slice_rest_len_%out_slice = sub __slice_len_%out_slice, __slice_prefix_len_%out_slice
    __slice_src_ptr_%out_slice = load %slice_reg+Slice_ptr as ptr
    __slice_prefix_bytes_%out_slice = mul __slice_prefix_len_%out_slice, 8
    __slice_rest_ptr_%out_slice = ptr_add __slice_src_ptr_%out_slice, __slice_prefix_bytes_%out_slice
    EXPAND SLICE_NEW %out_slice, __slice_rest_ptr_%out_slice, __slice_rest_len_%out_slice
    !__slice_rest_ptr_%out_slice
    !__slice_prefix_bytes_%out_slice
    !__slice_src_ptr_%out_slice
    !__slice_rest_len_%out_slice
    !__slice_trim_match_%out_slice
    !__slice_prefix_len_%out_slice
    !__slice_len_%out_slice
    jmp L_SLICE_TRIM_PREFIX_END_%out_slice

L_SLICE_TRIM_PREFIX_MISS_%out_slice:
    __slice_src_ptr_miss_%out_slice = load %slice_reg+Slice_ptr as ptr
    EXPAND SLICE_NEW %out_slice, __slice_src_ptr_miss_%out_slice, __slice_len_%out_slice
    !__slice_src_ptr_miss_%out_slice
    !__slice_trim_match_%out_slice
    !__slice_prefix_len_%out_slice
    !__slice_len_%out_slice

L_SLICE_TRIM_PREFIX_END_%out_slice:
[END_MACRO]

[MACRO] SLICE_TRIM_SUFFIX_U64 %out_slice, %slice_reg, %suffix_slice
    %out_slice = alloc Slice_SIZE
    __slice_len_%out_slice = load %slice_reg+Slice_len as u64
    __slice_suffix_len_%out_slice = load %suffix_slice+Slice_len as u64
    EXPAND SLICE_ENDS_WITH_U64 __slice_trim_match_%out_slice, %slice_reg, %suffix_slice
    br __slice_trim_match_%out_slice -> L_SLICE_TRIM_SUFFIX_HIT_%out_slice, L_SLICE_TRIM_SUFFIX_MISS_%out_slice

L_SLICE_TRIM_SUFFIX_HIT_%out_slice:
    __slice_rest_len_%out_slice = sub __slice_len_%out_slice, __slice_suffix_len_%out_slice
    __slice_src_ptr_%out_slice = load %slice_reg+Slice_ptr as ptr
    EXPAND SLICE_NEW %out_slice, __slice_src_ptr_%out_slice, __slice_rest_len_%out_slice
    !__slice_src_ptr_%out_slice
    !__slice_rest_len_%out_slice
    !__slice_trim_match_%out_slice
    !__slice_suffix_len_%out_slice
    !__slice_len_%out_slice
    jmp L_SLICE_TRIM_SUFFIX_END_%out_slice

L_SLICE_TRIM_SUFFIX_MISS_%out_slice:
    __slice_src_ptr_miss_%out_slice = load %slice_reg+Slice_ptr as ptr
    EXPAND SLICE_NEW %out_slice, __slice_src_ptr_miss_%out_slice, __slice_len_%out_slice
    !__slice_src_ptr_miss_%out_slice
    !__slice_trim_match_%out_slice
    !__slice_suffix_len_%out_slice
    !__slice_len_%out_slice

L_SLICE_TRIM_SUFFIX_END_%out_slice:
[END_MACRO]

[MACRO] SLICE_TRY_SPLIT_AT_U64 %out_ok, %out_left, %out_right, %slice_reg, %mid
    %out_left = alloc Slice_SIZE
    %out_right = alloc Slice_SIZE
    __slice_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_in_bounds_%out_ok = ule %mid, __slice_len_%out_ok
    br __slice_in_bounds_%out_ok -> L_SLICE_SPLIT_AT_HIT_%out_ok, L_SLICE_SPLIT_AT_MISS_%out_ok

L_SLICE_SPLIT_AT_HIT_%out_ok:
    __slice_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __slice_right_len_%out_ok = sub __slice_len_%out_ok, %mid
    __slice_mid_bytes_%out_ok = mul %mid, 8
    __slice_right_ptr_%out_ok = ptr_add __slice_src_ptr_%out_ok, __slice_mid_bytes_%out_ok
    EXPAND SLICE_NEW %out_left, __slice_src_ptr_%out_ok, %mid
    EXPAND SLICE_NEW %out_right, __slice_right_ptr_%out_ok, __slice_right_len_%out_ok
    %out_ok = add 0, 1
    !__slice_right_ptr_%out_ok
    !__slice_mid_bytes_%out_ok
    !__slice_right_len_%out_ok
    !__slice_src_ptr_%out_ok
    !__slice_in_bounds_%out_ok
    !__slice_len_%out_ok
    jmp L_SLICE_SPLIT_AT_END_%out_ok

L_SLICE_SPLIT_AT_MISS_%out_ok:
    __slice_empty_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_left, __slice_empty_ptr_%out_ok, 0
    EXPAND SLICE_NEW %out_right, __slice_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_empty_ptr_%out_ok
    !__slice_in_bounds_%out_ok
    !__slice_len_%out_ok

L_SLICE_SPLIT_AT_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_TRY_SPLIT_AT_MUT_U64 %out_ok, %out_left, %out_right, %slice_reg, %mid
    EXPAND SLICE_TRY_SPLIT_AT_U64 %out_ok, %out_left, %out_right, %slice_reg, %mid
[END_MACRO]

[MACRO] SLICE_TRY_RANGE_U64 %out_ok, %out_slice, %slice_reg, %start, %length
    %out_slice = alloc Slice_SIZE
    __slice_range_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_range_start_ok_%out_ok = ule %start, __slice_range_len_%out_ok
    br __slice_range_start_ok_%out_ok -> L_SLICE_RANGE_LEN_CHECK_%out_ok, L_SLICE_RANGE_MISS_START_%out_ok

L_SLICE_RANGE_LEN_CHECK_%out_ok:
    __slice_range_remaining_%out_ok = sub __slice_range_len_%out_ok, %start
    __slice_range_len_ok_%out_ok = ule %length, __slice_range_remaining_%out_ok
    br __slice_range_len_ok_%out_ok -> L_SLICE_RANGE_HIT_%out_ok, L_SLICE_RANGE_MISS_LEN_%out_ok

L_SLICE_RANGE_HIT_%out_ok:
    __slice_range_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __slice_range_start_bytes_%out_ok = mul %start, 8
    __slice_range_ptr_%out_ok = ptr_add __slice_range_src_ptr_%out_ok, __slice_range_start_bytes_%out_ok
    EXPAND SLICE_NEW %out_slice, __slice_range_ptr_%out_ok, %length
    %out_ok = add 0, 1
    !__slice_range_ptr_%out_ok
    !__slice_range_start_bytes_%out_ok
    !__slice_range_src_ptr_%out_ok
    !__slice_range_len_ok_%out_ok
    !__slice_range_remaining_%out_ok
    !__slice_range_start_ok_%out_ok
    !__slice_range_len_%out_ok
    jmp L_SLICE_RANGE_END_%out_ok

L_SLICE_RANGE_MISS_LEN_%out_ok:
    __slice_range_empty_ptr_len_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_range_empty_ptr_len_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_range_empty_ptr_len_%out_ok
    !__slice_range_len_ok_%out_ok
    !__slice_range_remaining_%out_ok
    !__slice_range_start_ok_%out_ok
    !__slice_range_len_%out_ok
    jmp L_SLICE_RANGE_END_%out_ok

L_SLICE_RANGE_MISS_START_%out_ok:
    __slice_range_empty_ptr_start_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_range_empty_ptr_start_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_range_empty_ptr_start_%out_ok
    !__slice_range_start_ok_%out_ok
    !__slice_range_len_%out_ok

L_SLICE_RANGE_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_TRY_GET_RANGE_U64 %out_ok, %out_slice, %slice_reg, %start, %length
    EXPAND SLICE_TRY_RANGE_U64 %out_ok, %out_slice, %slice_reg, %start, %length
[END_MACRO]

[MACRO] SLICE_CHUNK_COUNT_U64 %out_count, %slice_reg, %chunk_size
    __slice_chunk_len_%out_count = load %slice_reg+Slice_len as u64
    __slice_chunk_zero_%out_count = eq %chunk_size, 0
    br __slice_chunk_zero_%out_count -> L_SLICE_CHUNK_COUNT_ZERO_%out_count, L_SLICE_CHUNK_COUNT_CALC_%out_count

L_SLICE_CHUNK_COUNT_CALC_%out_count:
    __slice_chunk_adjusted_%out_count = add __slice_chunk_len_%out_count, %chunk_size
    __slice_chunk_adjusted2_%out_count = sub __slice_chunk_adjusted_%out_count, 1
    %out_count = udiv __slice_chunk_adjusted2_%out_count, %chunk_size
    !__slice_chunk_adjusted2_%out_count
    !__slice_chunk_adjusted_%out_count
    !__slice_chunk_zero_%out_count
    !__slice_chunk_len_%out_count
    jmp L_SLICE_CHUNK_COUNT_END_%out_count

L_SLICE_CHUNK_COUNT_ZERO_%out_count:
    %out_count = add 0, 0
    !__slice_chunk_zero_%out_count
    !__slice_chunk_len_%out_count

L_SLICE_CHUNK_COUNT_END_%out_count:
[END_MACRO]

[MACRO] SLICE_TRY_CHUNK_AT_U64 %out_ok, %out_slice, %slice_reg, %chunk_size, %chunk_index
    %out_slice = alloc Slice_SIZE
    __slice_chunk_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_chunk_zero_%out_ok = eq %chunk_size, 0
    br __slice_chunk_zero_%out_ok -> L_SLICE_CHUNK_AT_MISS_ZERO_%out_ok, L_SLICE_CHUNK_AT_START_%out_ok

L_SLICE_CHUNK_AT_START_%out_ok:
    __slice_chunk_start_%out_ok = mul %chunk_index, %chunk_size
    __slice_chunk_in_bounds_%out_ok = ult __slice_chunk_start_%out_ok, __slice_chunk_len_%out_ok
    br __slice_chunk_in_bounds_%out_ok -> L_SLICE_CHUNK_AT_LEN_%out_ok, L_SLICE_CHUNK_AT_MISS_BOUNDS_%out_ok

L_SLICE_CHUNK_AT_LEN_%out_ok:
    __slice_chunk_remaining_%out_ok = sub __slice_chunk_len_%out_ok, __slice_chunk_start_%out_ok
    __slice_chunk_full_%out_ok = ule %chunk_size, __slice_chunk_remaining_%out_ok
    br __slice_chunk_full_%out_ok -> L_SLICE_CHUNK_AT_FULL_%out_ok, L_SLICE_CHUNK_AT_TAIL_%out_ok

L_SLICE_CHUNK_AT_FULL_%out_ok:
    __slice_chunk_src_ptr_full_%out_ok = load %slice_reg+Slice_ptr as ptr
    __slice_chunk_start_bytes_full_%out_ok = mul __slice_chunk_start_%out_ok, 8
    __slice_chunk_ptr_full_%out_ok = ptr_add __slice_chunk_src_ptr_full_%out_ok, __slice_chunk_start_bytes_full_%out_ok
    EXPAND SLICE_NEW %out_slice, __slice_chunk_ptr_full_%out_ok, %chunk_size
    %out_ok = add 0, 1
    !__slice_chunk_ptr_full_%out_ok
    !__slice_chunk_start_bytes_full_%out_ok
    !__slice_chunk_src_ptr_full_%out_ok
    !__slice_chunk_full_%out_ok
    !__slice_chunk_remaining_%out_ok
    !__slice_chunk_in_bounds_%out_ok
    !__slice_chunk_start_%out_ok
    !__slice_chunk_zero_%out_ok
    !__slice_chunk_len_%out_ok
    jmp L_SLICE_CHUNK_AT_END_%out_ok

L_SLICE_CHUNK_AT_TAIL_%out_ok:
    __slice_chunk_src_ptr_tail_%out_ok = load %slice_reg+Slice_ptr as ptr
    __slice_chunk_start_bytes_tail_%out_ok = mul __slice_chunk_start_%out_ok, 8
    __slice_chunk_ptr_tail_%out_ok = ptr_add __slice_chunk_src_ptr_tail_%out_ok, __slice_chunk_start_bytes_tail_%out_ok
    EXPAND SLICE_NEW %out_slice, __slice_chunk_ptr_tail_%out_ok, __slice_chunk_remaining_%out_ok
    %out_ok = add 0, 1
    !__slice_chunk_ptr_tail_%out_ok
    !__slice_chunk_start_bytes_tail_%out_ok
    !__slice_chunk_src_ptr_tail_%out_ok
    !__slice_chunk_full_%out_ok
    !__slice_chunk_remaining_%out_ok
    !__slice_chunk_in_bounds_%out_ok
    !__slice_chunk_start_%out_ok
    !__slice_chunk_zero_%out_ok
    !__slice_chunk_len_%out_ok
    jmp L_SLICE_CHUNK_AT_END_%out_ok

L_SLICE_CHUNK_AT_MISS_BOUNDS_%out_ok:
    __slice_chunk_empty_ptr_bounds_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_chunk_empty_ptr_bounds_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_chunk_empty_ptr_bounds_%out_ok
    !__slice_chunk_in_bounds_%out_ok
    !__slice_chunk_start_%out_ok
    !__slice_chunk_zero_%out_ok
    !__slice_chunk_len_%out_ok
    jmp L_SLICE_CHUNK_AT_END_%out_ok

L_SLICE_CHUNK_AT_MISS_ZERO_%out_ok:
    __slice_chunk_empty_ptr_zero_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_chunk_empty_ptr_zero_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_chunk_empty_ptr_zero_%out_ok
    !__slice_chunk_zero_%out_ok
    !__slice_chunk_len_%out_ok

L_SLICE_CHUNK_AT_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_WINDOW_COUNT_U64 %out_count, %slice_reg, %window_size
    __slice_window_len_%out_count = load %slice_reg+Slice_len as u64
    __slice_window_zero_%out_count = eq %window_size, 0
    br __slice_window_zero_%out_count -> L_SLICE_WINDOW_COUNT_ZERO_%out_count, L_SLICE_WINDOW_COUNT_SIZE_%out_count

L_SLICE_WINDOW_COUNT_SIZE_%out_count:
    __slice_window_fits_%out_count = ule %window_size, __slice_window_len_%out_count
    br __slice_window_fits_%out_count -> L_SLICE_WINDOW_COUNT_CALC_%out_count, L_SLICE_WINDOW_COUNT_MISS_%out_count

L_SLICE_WINDOW_COUNT_CALC_%out_count:
    __slice_window_remaining_%out_count = sub __slice_window_len_%out_count, %window_size
    %out_count = add __slice_window_remaining_%out_count, 1
    !__slice_window_remaining_%out_count
    !__slice_window_fits_%out_count
    !__slice_window_zero_%out_count
    !__slice_window_len_%out_count
    jmp L_SLICE_WINDOW_COUNT_END_%out_count

L_SLICE_WINDOW_COUNT_MISS_%out_count:
    %out_count = add 0, 0
    !__slice_window_fits_%out_count
    !__slice_window_zero_%out_count
    !__slice_window_len_%out_count
    jmp L_SLICE_WINDOW_COUNT_END_%out_count

L_SLICE_WINDOW_COUNT_ZERO_%out_count:
    %out_count = add 0, 0
    !__slice_window_zero_%out_count
    !__slice_window_len_%out_count

L_SLICE_WINDOW_COUNT_END_%out_count:
[END_MACRO]

[MACRO] SLICE_TRY_WINDOW_AT_U64 %out_ok, %out_slice, %slice_reg, %window_size, %window_index
    %out_slice = alloc Slice_SIZE
    __slice_window_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_window_zero_%out_ok = eq %window_size, 0
    br __slice_window_zero_%out_ok -> L_SLICE_WINDOW_AT_MISS_ZERO_%out_ok, L_SLICE_WINDOW_AT_SIZE_%out_ok

L_SLICE_WINDOW_AT_SIZE_%out_ok:
    __slice_window_start_ok_%out_ok = ule %window_index, __slice_window_len_%out_ok
    br __slice_window_start_ok_%out_ok -> L_SLICE_WINDOW_AT_LEN_%out_ok, L_SLICE_WINDOW_AT_MISS_START_%out_ok

L_SLICE_WINDOW_AT_LEN_%out_ok:
    __slice_window_remaining_%out_ok = sub __slice_window_len_%out_ok, %window_index
    __slice_window_fits_%out_ok = ule %window_size, __slice_window_remaining_%out_ok
    br __slice_window_fits_%out_ok -> L_SLICE_WINDOW_AT_HIT_%out_ok, L_SLICE_WINDOW_AT_MISS_LEN_%out_ok

L_SLICE_WINDOW_AT_HIT_%out_ok:
    __slice_window_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __slice_window_start_bytes_%out_ok = mul %window_index, 8
    __slice_window_ptr_%out_ok = ptr_add __slice_window_src_ptr_%out_ok, __slice_window_start_bytes_%out_ok
    EXPAND SLICE_NEW %out_slice, __slice_window_ptr_%out_ok, %window_size
    %out_ok = add 0, 1
    !__slice_window_ptr_%out_ok
    !__slice_window_start_bytes_%out_ok
    !__slice_window_src_ptr_%out_ok
    !__slice_window_fits_%out_ok
    !__slice_window_remaining_%out_ok
    !__slice_window_start_ok_%out_ok
    !__slice_window_zero_%out_ok
    !__slice_window_len_%out_ok
    jmp L_SLICE_WINDOW_AT_END_%out_ok

L_SLICE_WINDOW_AT_MISS_LEN_%out_ok:
    __slice_window_empty_ptr_len_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_window_empty_ptr_len_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_window_empty_ptr_len_%out_ok
    !__slice_window_fits_%out_ok
    !__slice_window_remaining_%out_ok
    !__slice_window_start_ok_%out_ok
    !__slice_window_zero_%out_ok
    !__slice_window_len_%out_ok
    jmp L_SLICE_WINDOW_AT_END_%out_ok

L_SLICE_WINDOW_AT_MISS_START_%out_ok:
    __slice_window_empty_ptr_start_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_window_empty_ptr_start_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_window_empty_ptr_start_%out_ok
    !__slice_window_start_ok_%out_ok
    !__slice_window_zero_%out_ok
    !__slice_window_len_%out_ok
    jmp L_SLICE_WINDOW_AT_END_%out_ok

L_SLICE_WINDOW_AT_MISS_ZERO_%out_ok:
    __slice_window_empty_ptr_zero_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __slice_window_empty_ptr_zero_%out_ok, 0
    %out_ok = add 0, 0
    !__slice_window_empty_ptr_zero_%out_ok
    !__slice_window_zero_%out_ok
    !__slice_window_len_%out_ok

L_SLICE_WINDOW_AT_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_SWAP_U64 %slice_reg, %left, %right
    __slice_swap_ptr_%slice_reg = load %slice_reg+Slice_ptr as ptr
    __slice_swap_left_off_%slice_reg = mul %left, 8
    __slice_swap_right_off_%slice_reg = mul %right, 8
    __slice_swap_left_ptr_%slice_reg = ptr_add __slice_swap_ptr_%slice_reg, __slice_swap_left_off_%slice_reg
    __slice_swap_right_ptr_%slice_reg = ptr_add __slice_swap_ptr_%slice_reg, __slice_swap_right_off_%slice_reg
    __slice_swap_left_value_%slice_reg = load __slice_swap_left_ptr_%slice_reg+0 as u64
    __slice_swap_right_value_%slice_reg = load __slice_swap_right_ptr_%slice_reg+0 as u64
    store __slice_swap_left_ptr_%slice_reg+0, __slice_swap_right_value_%slice_reg as u64
    store __slice_swap_right_ptr_%slice_reg+0, __slice_swap_left_value_%slice_reg as u64
    !__slice_swap_right_value_%slice_reg
    !__slice_swap_left_value_%slice_reg
    !__slice_swap_right_ptr_%slice_reg
    !__slice_swap_left_ptr_%slice_reg
    !__slice_swap_right_off_%slice_reg
    !__slice_swap_left_off_%slice_reg
    !__slice_swap_ptr_%slice_reg
[END_MACRO]

[MACRO] SLICE_TRY_SWAP_U64 %out_ok, %slice_reg, %left, %right
    __slice_swap_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_swap_left_ok_%out_ok = ult %left, __slice_swap_len_%out_ok
    __slice_swap_right_ok_%out_ok = ult %right, __slice_swap_len_%out_ok
    __slice_swap_in_bounds_%out_ok = and __slice_swap_left_ok_%out_ok, __slice_swap_right_ok_%out_ok
    br __slice_swap_in_bounds_%out_ok -> L_SLICE_TRY_SWAP_HIT_%out_ok, L_SLICE_TRY_SWAP_MISS_%out_ok

L_SLICE_TRY_SWAP_HIT_%out_ok:
    EXPAND SLICE_SWAP_U64 %slice_reg, %left, %right
    %out_ok = add 0, 1
    !__slice_swap_in_bounds_%out_ok
    !__slice_swap_right_ok_%out_ok
    !__slice_swap_left_ok_%out_ok
    !__slice_swap_len_%out_ok
    jmp L_SLICE_TRY_SWAP_END_%out_ok

L_SLICE_TRY_SWAP_MISS_%out_ok:
    %out_ok = add 0, 0
    !__slice_swap_in_bounds_%out_ok
    !__slice_swap_right_ok_%out_ok
    !__slice_swap_left_ok_%out_ok
    !__slice_swap_len_%out_ok

L_SLICE_TRY_SWAP_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_FILL_U64 %slice_reg, %value
    __slice_fill_ptr_%slice_reg = load %slice_reg+Slice_ptr as ptr
    __slice_fill_len_%slice_reg = load %slice_reg+Slice_len as u64
    __slice_fill_idx_slot_%slice_reg = stack_alloc 8
    store __slice_fill_idx_slot_%slice_reg+0, 0 as u64
    jmp L_SLICE_FILL_HEAD_%slice_reg

L_SLICE_FILL_HEAD_%slice_reg:
    __slice_fill_idx_%slice_reg = load __slice_fill_idx_slot_%slice_reg+0 as u64
    __slice_fill_done_%slice_reg = eq __slice_fill_idx_%slice_reg, __slice_fill_len_%slice_reg
    br __slice_fill_done_%slice_reg -> L_SLICE_FILL_END_%slice_reg, L_SLICE_FILL_BODY_%slice_reg

L_SLICE_FILL_BODY_%slice_reg:
    __slice_fill_off_%slice_reg = mul __slice_fill_idx_%slice_reg, 8
    __slice_fill_item_%slice_reg = ptr_add __slice_fill_ptr_%slice_reg, __slice_fill_off_%slice_reg
    store __slice_fill_item_%slice_reg+0, %value as u64
    __slice_fill_next_%slice_reg = add __slice_fill_idx_%slice_reg, 1
    store __slice_fill_idx_slot_%slice_reg+0, __slice_fill_next_%slice_reg as u64
    !__slice_fill_next_%slice_reg
    !__slice_fill_item_%slice_reg
    !__slice_fill_off_%slice_reg
    !__slice_fill_done_%slice_reg
    !__slice_fill_idx_%slice_reg
    jmp L_SLICE_FILL_HEAD_%slice_reg

L_SLICE_FILL_END_%slice_reg:
    !__slice_fill_done_%slice_reg
    !__slice_fill_idx_%slice_reg
    !__slice_fill_len_%slice_reg
    !__slice_fill_ptr_%slice_reg
[END_MACRO]

[MACRO] SLICE_REVERSE_U64 %slice_reg
    __slice_rev_len_%slice_reg = load %slice_reg+Slice_len as u64
    __slice_rev_small_%slice_reg = ule __slice_rev_len_%slice_reg, 1
    br __slice_rev_small_%slice_reg -> L_SLICE_REV_DONE_SMALL_%slice_reg, L_SLICE_REV_INIT_%slice_reg

L_SLICE_REV_INIT_%slice_reg:
    __slice_rev_ptr_%slice_reg = load %slice_reg+Slice_ptr as ptr
    __slice_rev_left_slot_%slice_reg = stack_alloc 8
    __slice_rev_right_slot_%slice_reg = stack_alloc 8
    __slice_rev_last_%slice_reg = sub __slice_rev_len_%slice_reg, 1
    store __slice_rev_left_slot_%slice_reg+0, 0 as u64
    store __slice_rev_right_slot_%slice_reg+0, __slice_rev_last_%slice_reg as u64
    !__slice_rev_last_%slice_reg
    jmp L_SLICE_REV_HEAD_%slice_reg

L_SLICE_REV_HEAD_%slice_reg:
    __slice_rev_left_%slice_reg = load __slice_rev_left_slot_%slice_reg+0 as u64
    __slice_rev_right_%slice_reg = load __slice_rev_right_slot_%slice_reg+0 as u64
    __slice_rev_continue_%slice_reg = ult __slice_rev_left_%slice_reg, __slice_rev_right_%slice_reg
    br __slice_rev_continue_%slice_reg -> L_SLICE_REV_BODY_%slice_reg, L_SLICE_REV_DONE_%slice_reg

L_SLICE_REV_BODY_%slice_reg:
    __slice_rev_left_off_%slice_reg = mul __slice_rev_left_%slice_reg, 8
    __slice_rev_right_off_%slice_reg = mul __slice_rev_right_%slice_reg, 8
    __slice_rev_left_ptr_%slice_reg = ptr_add __slice_rev_ptr_%slice_reg, __slice_rev_left_off_%slice_reg
    __slice_rev_right_ptr_%slice_reg = ptr_add __slice_rev_ptr_%slice_reg, __slice_rev_right_off_%slice_reg
    __slice_rev_left_value_%slice_reg = load __slice_rev_left_ptr_%slice_reg+0 as u64
    __slice_rev_right_value_%slice_reg = load __slice_rev_right_ptr_%slice_reg+0 as u64
    store __slice_rev_left_ptr_%slice_reg+0, __slice_rev_right_value_%slice_reg as u64
    store __slice_rev_right_ptr_%slice_reg+0, __slice_rev_left_value_%slice_reg as u64
    __slice_rev_next_left_%slice_reg = add __slice_rev_left_%slice_reg, 1
    __slice_rev_next_right_%slice_reg = sub __slice_rev_right_%slice_reg, 1
    store __slice_rev_left_slot_%slice_reg+0, __slice_rev_next_left_%slice_reg as u64
    store __slice_rev_right_slot_%slice_reg+0, __slice_rev_next_right_%slice_reg as u64
    !__slice_rev_next_right_%slice_reg
    !__slice_rev_next_left_%slice_reg
    !__slice_rev_right_value_%slice_reg
    !__slice_rev_left_value_%slice_reg
    !__slice_rev_right_ptr_%slice_reg
    !__slice_rev_left_ptr_%slice_reg
    !__slice_rev_right_off_%slice_reg
    !__slice_rev_left_off_%slice_reg
    !__slice_rev_continue_%slice_reg
    !__slice_rev_right_%slice_reg
    !__slice_rev_left_%slice_reg
    jmp L_SLICE_REV_HEAD_%slice_reg

L_SLICE_REV_DONE_%slice_reg:
    !__slice_rev_continue_%slice_reg
    !__slice_rev_right_%slice_reg
    !__slice_rev_left_%slice_reg
    !__slice_rev_ptr_%slice_reg
    !__slice_rev_small_%slice_reg
    !__slice_rev_len_%slice_reg
    jmp L_SLICE_REV_END_%slice_reg

L_SLICE_REV_DONE_SMALL_%slice_reg:
    !__slice_rev_small_%slice_reg
    !__slice_rev_len_%slice_reg

L_SLICE_REV_END_%slice_reg:
[END_MACRO]

[MACRO] SLICE_COPY_FROM_SLICE_U64 %out_ok, %dst_slice, %src_slice
    __slice_copy_dst_len_%out_ok = load %dst_slice+Slice_len as u64
    __slice_copy_src_len_%out_ok = load %src_slice+Slice_len as u64
    __slice_copy_same_len_%out_ok = eq __slice_copy_dst_len_%out_ok, __slice_copy_src_len_%out_ok
    br __slice_copy_same_len_%out_ok -> L_SLICE_COPY_INIT_%out_ok, L_SLICE_COPY_MISS_%out_ok

L_SLICE_COPY_INIT_%out_ok:
    __slice_copy_dst_ptr_%out_ok = load %dst_slice+Slice_ptr as ptr
    __slice_copy_src_ptr_%out_ok = load %src_slice+Slice_ptr as ptr
    __slice_copy_idx_slot_%out_ok = stack_alloc 8
    store __slice_copy_idx_slot_%out_ok+0, 0 as u64
    jmp L_SLICE_COPY_HEAD_%out_ok

L_SLICE_COPY_HEAD_%out_ok:
    __slice_copy_idx_%out_ok = load __slice_copy_idx_slot_%out_ok+0 as u64
    __slice_copy_done_%out_ok = eq __slice_copy_idx_%out_ok, __slice_copy_dst_len_%out_ok
    br __slice_copy_done_%out_ok -> L_SLICE_COPY_HIT_%out_ok, L_SLICE_COPY_BODY_%out_ok

L_SLICE_COPY_BODY_%out_ok:
    __slice_copy_off_%out_ok = mul __slice_copy_idx_%out_ok, 8
    __slice_copy_dst_item_%out_ok = ptr_add __slice_copy_dst_ptr_%out_ok, __slice_copy_off_%out_ok
    __slice_copy_src_item_%out_ok = ptr_add __slice_copy_src_ptr_%out_ok, __slice_copy_off_%out_ok
    __slice_copy_value_%out_ok = load __slice_copy_src_item_%out_ok+0 as u64
    store __slice_copy_dst_item_%out_ok+0, __slice_copy_value_%out_ok as u64
    __slice_copy_next_%out_ok = add __slice_copy_idx_%out_ok, 1
    store __slice_copy_idx_slot_%out_ok+0, __slice_copy_next_%out_ok as u64
    !__slice_copy_next_%out_ok
    !__slice_copy_value_%out_ok
    !__slice_copy_src_item_%out_ok
    !__slice_copy_dst_item_%out_ok
    !__slice_copy_off_%out_ok
    !__slice_copy_done_%out_ok
    !__slice_copy_idx_%out_ok
    jmp L_SLICE_COPY_HEAD_%out_ok

L_SLICE_COPY_HIT_%out_ok:
    %out_ok = add 0, 1
    !__slice_copy_done_%out_ok
    !__slice_copy_idx_%out_ok
    !__slice_copy_src_ptr_%out_ok
    !__slice_copy_dst_ptr_%out_ok
    !__slice_copy_same_len_%out_ok
    !__slice_copy_src_len_%out_ok
    !__slice_copy_dst_len_%out_ok
    jmp L_SLICE_COPY_END_%out_ok

L_SLICE_COPY_MISS_%out_ok:
    %out_ok = add 0, 0
    !__slice_copy_same_len_%out_ok
    !__slice_copy_src_len_%out_ok
    !__slice_copy_dst_len_%out_ok

L_SLICE_COPY_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_CLONE_FROM_SLICE_U64 %out_ok, %dst_slice, %src_slice
    EXPAND SLICE_COPY_FROM_SLICE_U64 %out_ok, %dst_slice, %src_slice
[END_MACRO]

[MACRO] SLICE_COPY_WITHIN_U64 %out_ok, %slice_reg, %src_start, %src_len, %dest
    __slice_cw_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_cw_idx_slot_%out_ok = stack_alloc 8
    __slice_cw_src_start_ok_%out_ok = ule %src_start, __slice_cw_len_%out_ok
    br __slice_cw_src_start_ok_%out_ok -> L_SLICE_CW_SRC_LEN_CHECK_%out_ok, L_SLICE_CW_MISS_SRC_START_%out_ok

L_SLICE_CW_SRC_LEN_CHECK_%out_ok:
    __slice_cw_src_remaining_%out_ok = sub __slice_cw_len_%out_ok, %src_start
    __slice_cw_src_len_ok_%out_ok = ule %src_len, __slice_cw_src_remaining_%out_ok
    br __slice_cw_src_len_ok_%out_ok -> L_SLICE_CW_DEST_CHECK_%out_ok, L_SLICE_CW_MISS_SRC_LEN_%out_ok

L_SLICE_CW_DEST_CHECK_%out_ok:
    __slice_cw_dest_ok_%out_ok = ule %dest, __slice_cw_len_%out_ok
    br __slice_cw_dest_ok_%out_ok -> L_SLICE_CW_DEST_LEN_CHECK_%out_ok, L_SLICE_CW_MISS_DEST_%out_ok

L_SLICE_CW_DEST_LEN_CHECK_%out_ok:
    __slice_cw_dest_remaining_%out_ok = sub __slice_cw_len_%out_ok, %dest
    __slice_cw_dest_len_ok_%out_ok = ule %src_len, __slice_cw_dest_remaining_%out_ok
    br __slice_cw_dest_len_ok_%out_ok -> L_SLICE_CW_INIT_%out_ok, L_SLICE_CW_MISS_DEST_LEN_%out_ok

L_SLICE_CW_INIT_%out_ok:
    __slice_cw_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __slice_cw_dest_after_%out_ok = ugt %dest, %src_start
    br __slice_cw_dest_after_%out_ok -> L_SLICE_CW_BACK_INIT_%out_ok, L_SLICE_CW_FORWARD_INIT_%out_ok

L_SLICE_CW_FORWARD_INIT_%out_ok:
    store __slice_cw_idx_slot_%out_ok+0, 0 as u64
    jmp L_SLICE_CW_FORWARD_HEAD_%out_ok

L_SLICE_CW_FORWARD_HEAD_%out_ok:
    __slice_cw_fwd_idx_%out_ok = load __slice_cw_idx_slot_%out_ok+0 as u64
    __slice_cw_fwd_done_%out_ok = eq __slice_cw_fwd_idx_%out_ok, %src_len
    br __slice_cw_fwd_done_%out_ok -> L_SLICE_CW_FORWARD_HIT_%out_ok, L_SLICE_CW_FORWARD_BODY_%out_ok

L_SLICE_CW_FORWARD_BODY_%out_ok:
    __slice_cw_fwd_src_idx_%out_ok = add %src_start, __slice_cw_fwd_idx_%out_ok
    __slice_cw_fwd_dst_idx_%out_ok = add %dest, __slice_cw_fwd_idx_%out_ok
    __slice_cw_fwd_src_off_%out_ok = mul __slice_cw_fwd_src_idx_%out_ok, 8
    __slice_cw_fwd_dst_off_%out_ok = mul __slice_cw_fwd_dst_idx_%out_ok, 8
    __slice_cw_fwd_src_ptr_%out_ok = ptr_add __slice_cw_ptr_%out_ok, __slice_cw_fwd_src_off_%out_ok
    __slice_cw_fwd_dst_ptr_%out_ok = ptr_add __slice_cw_ptr_%out_ok, __slice_cw_fwd_dst_off_%out_ok
    __slice_cw_fwd_value_%out_ok = load __slice_cw_fwd_src_ptr_%out_ok+0 as u64
    store __slice_cw_fwd_dst_ptr_%out_ok+0, __slice_cw_fwd_value_%out_ok as u64
    __slice_cw_fwd_next_%out_ok = add __slice_cw_fwd_idx_%out_ok, 1
    store __slice_cw_idx_slot_%out_ok+0, __slice_cw_fwd_next_%out_ok as u64
    !__slice_cw_fwd_next_%out_ok
    !__slice_cw_fwd_value_%out_ok
    !__slice_cw_fwd_dst_ptr_%out_ok
    !__slice_cw_fwd_src_ptr_%out_ok
    !__slice_cw_fwd_dst_off_%out_ok
    !__slice_cw_fwd_src_off_%out_ok
    !__slice_cw_fwd_dst_idx_%out_ok
    !__slice_cw_fwd_src_idx_%out_ok
    !__slice_cw_fwd_done_%out_ok
    !__slice_cw_fwd_idx_%out_ok
    jmp L_SLICE_CW_FORWARD_HEAD_%out_ok

L_SLICE_CW_FORWARD_HIT_%out_ok:
    %out_ok = add 0, 1
    !__slice_cw_fwd_done_%out_ok
    !__slice_cw_fwd_idx_%out_ok
    !__slice_cw_dest_after_%out_ok
    !__slice_cw_ptr_%out_ok
    !__slice_cw_dest_len_ok_%out_ok
    !__slice_cw_dest_remaining_%out_ok
    !__slice_cw_dest_ok_%out_ok
    !__slice_cw_src_len_ok_%out_ok
    !__slice_cw_src_remaining_%out_ok
    !__slice_cw_src_start_ok_%out_ok
    !__slice_cw_len_%out_ok
    jmp L_SLICE_CW_END_%out_ok

L_SLICE_CW_BACK_INIT_%out_ok:
    store __slice_cw_idx_slot_%out_ok+0, %src_len as u64
    jmp L_SLICE_CW_BACK_HEAD_%out_ok

L_SLICE_CW_BACK_HEAD_%out_ok:
    __slice_cw_back_remaining_%out_ok = load __slice_cw_idx_slot_%out_ok+0 as u64
    __slice_cw_back_done_%out_ok = eq __slice_cw_back_remaining_%out_ok, 0
    br __slice_cw_back_done_%out_ok -> L_SLICE_CW_BACK_HIT_%out_ok, L_SLICE_CW_BACK_BODY_%out_ok

L_SLICE_CW_BACK_BODY_%out_ok:
    __slice_cw_back_idx_%out_ok = sub __slice_cw_back_remaining_%out_ok, 1
    __slice_cw_back_src_idx_%out_ok = add %src_start, __slice_cw_back_idx_%out_ok
    __slice_cw_back_dst_idx_%out_ok = add %dest, __slice_cw_back_idx_%out_ok
    __slice_cw_back_src_off_%out_ok = mul __slice_cw_back_src_idx_%out_ok, 8
    __slice_cw_back_dst_off_%out_ok = mul __slice_cw_back_dst_idx_%out_ok, 8
    __slice_cw_back_src_ptr_%out_ok = ptr_add __slice_cw_ptr_%out_ok, __slice_cw_back_src_off_%out_ok
    __slice_cw_back_dst_ptr_%out_ok = ptr_add __slice_cw_ptr_%out_ok, __slice_cw_back_dst_off_%out_ok
    __slice_cw_back_value_%out_ok = load __slice_cw_back_src_ptr_%out_ok+0 as u64
    store __slice_cw_back_dst_ptr_%out_ok+0, __slice_cw_back_value_%out_ok as u64
    store __slice_cw_idx_slot_%out_ok+0, __slice_cw_back_idx_%out_ok as u64
    !__slice_cw_back_value_%out_ok
    !__slice_cw_back_dst_ptr_%out_ok
    !__slice_cw_back_src_ptr_%out_ok
    !__slice_cw_back_dst_off_%out_ok
    !__slice_cw_back_src_off_%out_ok
    !__slice_cw_back_dst_idx_%out_ok
    !__slice_cw_back_src_idx_%out_ok
    !__slice_cw_back_idx_%out_ok
    !__slice_cw_back_done_%out_ok
    !__slice_cw_back_remaining_%out_ok
    jmp L_SLICE_CW_BACK_HEAD_%out_ok

L_SLICE_CW_BACK_HIT_%out_ok:
    %out_ok = add 0, 1
    !__slice_cw_back_done_%out_ok
    !__slice_cw_back_remaining_%out_ok
    !__slice_cw_dest_after_%out_ok
    !__slice_cw_ptr_%out_ok
    !__slice_cw_dest_len_ok_%out_ok
    !__slice_cw_dest_remaining_%out_ok
    !__slice_cw_dest_ok_%out_ok
    !__slice_cw_src_len_ok_%out_ok
    !__slice_cw_src_remaining_%out_ok
    !__slice_cw_src_start_ok_%out_ok
    !__slice_cw_len_%out_ok
    jmp L_SLICE_CW_END_%out_ok

L_SLICE_CW_MISS_DEST_LEN_%out_ok:
    %out_ok = add 0, 0
    !__slice_cw_dest_len_ok_%out_ok
    !__slice_cw_dest_remaining_%out_ok
    !__slice_cw_dest_ok_%out_ok
    !__slice_cw_src_len_ok_%out_ok
    !__slice_cw_src_remaining_%out_ok
    !__slice_cw_src_start_ok_%out_ok
    !__slice_cw_len_%out_ok
    jmp L_SLICE_CW_END_%out_ok

L_SLICE_CW_MISS_DEST_%out_ok:
    %out_ok = add 0, 0
    !__slice_cw_dest_ok_%out_ok
    !__slice_cw_src_len_ok_%out_ok
    !__slice_cw_src_remaining_%out_ok
    !__slice_cw_src_start_ok_%out_ok
    !__slice_cw_len_%out_ok
    jmp L_SLICE_CW_END_%out_ok

L_SLICE_CW_MISS_SRC_LEN_%out_ok:
    %out_ok = add 0, 0
    !__slice_cw_src_len_ok_%out_ok
    !__slice_cw_src_remaining_%out_ok
    !__slice_cw_src_start_ok_%out_ok
    !__slice_cw_len_%out_ok
    jmp L_SLICE_CW_END_%out_ok

L_SLICE_CW_MISS_SRC_START_%out_ok:
    %out_ok = add 0, 0
    !__slice_cw_src_start_ok_%out_ok
    !__slice_cw_len_%out_ok

L_SLICE_CW_END_%out_ok:
[END_MACRO]

[MACRO] SLICE_TRY_BINARY_SEARCH_U64 %out_ok, %out_index, %slice_reg, %needle
    __slice_bs_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __slice_bs_len_%out_ok = load %slice_reg+Slice_len as u64
    __slice_bs_left_slot_%out_ok = stack_alloc 8
    __slice_bs_right_slot_%out_ok = stack_alloc 8
    store __slice_bs_left_slot_%out_ok+0, 0 as u64
    store __slice_bs_right_slot_%out_ok+0, __slice_bs_len_%out_ok as u64
    jmp L_SLICE_BS_HEAD_%out_ok

L_SLICE_BS_HEAD_%out_ok:
    __slice_bs_left_%out_ok = load __slice_bs_left_slot_%out_ok+0 as u64
    __slice_bs_right_%out_ok = load __slice_bs_right_slot_%out_ok+0 as u64
    __slice_bs_continue_%out_ok = ult __slice_bs_left_%out_ok, __slice_bs_right_%out_ok
    br __slice_bs_continue_%out_ok -> L_SLICE_BS_BODY_%out_ok, L_SLICE_BS_MISS_%out_ok

L_SLICE_BS_BODY_%out_ok:
    __slice_bs_span_%out_ok = sub __slice_bs_right_%out_ok, __slice_bs_left_%out_ok
    __slice_bs_half_%out_ok = udiv __slice_bs_span_%out_ok, 2
    __slice_bs_mid_%out_ok = add __slice_bs_left_%out_ok, __slice_bs_half_%out_ok
    __slice_bs_mid_off_%out_ok = mul __slice_bs_mid_%out_ok, 8
    __slice_bs_mid_ptr_%out_ok = ptr_add __slice_bs_ptr_%out_ok, __slice_bs_mid_off_%out_ok
    __slice_bs_value_%out_ok = load __slice_bs_mid_ptr_%out_ok+0 as u64
    __slice_bs_equal_%out_ok = eq __slice_bs_value_%out_ok, %needle
    br __slice_bs_equal_%out_ok -> L_SLICE_BS_HIT_%out_ok, L_SLICE_BS_ORDER_%out_ok

L_SLICE_BS_ORDER_%out_ok:
    __slice_bs_less_%out_ok = ult __slice_bs_value_%out_ok, %needle
    br __slice_bs_less_%out_ok -> L_SLICE_BS_MOVE_RIGHT_%out_ok, L_SLICE_BS_MOVE_LEFT_%out_ok

L_SLICE_BS_MOVE_RIGHT_%out_ok:
    __slice_bs_next_left_%out_ok = add __slice_bs_mid_%out_ok, 1
    store __slice_bs_left_slot_%out_ok+0, __slice_bs_next_left_%out_ok as u64
    !__slice_bs_next_left_%out_ok
    !__slice_bs_less_%out_ok
    !__slice_bs_equal_%out_ok
    !__slice_bs_value_%out_ok
    !__slice_bs_mid_ptr_%out_ok
    !__slice_bs_mid_off_%out_ok
    !__slice_bs_mid_%out_ok
    !__slice_bs_half_%out_ok
    !__slice_bs_span_%out_ok
    !__slice_bs_continue_%out_ok
    !__slice_bs_right_%out_ok
    !__slice_bs_left_%out_ok
    jmp L_SLICE_BS_HEAD_%out_ok

L_SLICE_BS_MOVE_LEFT_%out_ok:
    store __slice_bs_right_slot_%out_ok+0, __slice_bs_mid_%out_ok as u64
    !__slice_bs_less_%out_ok
    !__slice_bs_equal_%out_ok
    !__slice_bs_value_%out_ok
    !__slice_bs_mid_ptr_%out_ok
    !__slice_bs_mid_off_%out_ok
    !__slice_bs_mid_%out_ok
    !__slice_bs_half_%out_ok
    !__slice_bs_span_%out_ok
    !__slice_bs_continue_%out_ok
    !__slice_bs_right_%out_ok
    !__slice_bs_left_%out_ok
    jmp L_SLICE_BS_HEAD_%out_ok

L_SLICE_BS_HIT_%out_ok:
    %out_ok = add 0, 1
    %out_index = add __slice_bs_mid_%out_ok, 0
    !__slice_bs_equal_%out_ok
    !__slice_bs_value_%out_ok
    !__slice_bs_mid_ptr_%out_ok
    !__slice_bs_mid_off_%out_ok
    !__slice_bs_mid_%out_ok
    !__slice_bs_half_%out_ok
    !__slice_bs_span_%out_ok
    !__slice_bs_continue_%out_ok
    !__slice_bs_right_%out_ok
    !__slice_bs_left_%out_ok
    !__slice_bs_len_%out_ok
    !__slice_bs_ptr_%out_ok
    jmp L_SLICE_BS_END_%out_ok

L_SLICE_BS_MISS_%out_ok:
    %out_ok = add 0, 0
    %out_index = add __slice_bs_left_%out_ok, 0
    !__slice_bs_continue_%out_ok
    !__slice_bs_right_%out_ok
    !__slice_bs_left_%out_ok
    !__slice_bs_len_%out_ok
    !__slice_bs_ptr_%out_ok

L_SLICE_BS_END_%out_ok:
[END_MACRO]
