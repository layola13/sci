// sa_std TLS-client surface — real std.crypto.tls backend living in the sci runtime.
//
// A TLS client connection is an opaque u64 handle (0 == invalid). connect()
// performs the TCP dial and the TLS handshake in one call and always verifies
// the peer: the hostname is sent as SNI and checked against the peer
// certificate, and the chain is verified against the process-wide CA bundle
// (OS trust store, optionally extended with sa_std_tls_client_add_ca_file).
// There is no verification-disabled mode.
//
// Error codes: 0 = OK; negative = error (-1 unsupported, -5 I/O,
// -12 out of memory, -22 invalid argument, -100 certificate verification
// failure). close() consumes the handle.
//
// String/JSON outputs are returned as registered u64 buffer handles, following
// the same convention as sa_std.fs.read_* and sa_std.http2: read bytes/length
// with sa_std_tls_client_buffer_data / sa_std_tls_client_buffer_len and
// release with sa_std_tls_client_buffer_free.

@extern sa_std_tls_client_supported(&out_supported: ptr) -> i32

@extern sa_std_tls_client_connect(&host: ptr, host_len: u64, port: u32, &out_handle: ptr) -> i32

@extern sa_std_tls_client_add_ca_file(&path: ptr, path_len: u64) -> i32
// Trust-anchor rule (std.crypto.Bundle): the bundle keeps only the FIRST
// certificate seen for a given subject name. Pinning a second, different
// certificate with an identical subject is silently ignored -- it returns
// OK but changes nothing. Regenerate with a distinguishing subject field
// if you must re-pin.

@extern sa_std_tls_client_read(handle: u64, &buf: ptr, cap: u64, &out_read: ptr) -> i32
@extern sa_std_tls_client_write(handle: u64, &buf: ptr, len: u64, &out_written: ptr) -> i32
@extern sa_std_tls_client_close(handle: u64) -> i32

@extern sa_std_tls_client_status_json(&out_handle: ptr) -> i32

// buffer handle accessors (sci convention)
@extern sa_std_tls_client_buffer_data(buffer: u64) -> &ptr
@extern sa_std_tls_client_buffer_len(buffer: u64) -> u64
@extern sa_std_tls_client_buffer_free(^buffer: u64) -> i32

// ---- shaped client (sa_tls_shaped.zig): profile-controlled ClientHello ----
// Profile JSON keys: preset (chrome|firefox|safari|go|default), alpn[],
// ciphersuites, ciphers, groups, sigalgs, min_version, max_version,
// ca_file. Unknown keys are rejected; grease:true -> UNSUPPORTED.
// hello_ja3/ja4 are computed from the ClientHello bytes actually sent
// (captured via an OpenSSL message callback), never estimated.

@extern sa_std_tls_shaped_supported(&out_supported: ptr) -> i32
@extern sa_std_tls_shaped_connect(&host: ptr, host_len: u64, port: u32, &profile: ptr, profile_len: u64, &out_handle: ptr) -> i32
@extern sa_std_tls_shaped_read(handle: u64, &buf: ptr, cap: u64, &out_read: ptr) -> i32
@extern sa_std_tls_shaped_write(handle: u64, &buf: ptr, len: u64, &out_written: ptr) -> i32
@extern sa_std_tls_shaped_close(handle: u64) -> i32
@extern sa_std_tls_shaped_negotiated_json(handle: u64, &out_handle: ptr) -> i32
@extern sa_std_tls_shaped_hello_ja3(handle: u64, &out: ptr, out_cap: u64, &out_len: ptr) -> i32
@extern sa_std_tls_shaped_hello_ja3_string(handle: u64, &out: ptr, out_cap: u64, &out_len: ptr) -> i32
@extern sa_std_tls_shaped_hello_ja4(handle: u64, &out: ptr, out_cap: u64, &out_len: ptr) -> i32

@extern sa_std_tls_shaped_buffer_data(buffer: u64) -> &ptr
@extern sa_std_tls_shaped_buffer_len(buffer: u64) -> u64
@extern sa_std_tls_shaped_buffer_free(^buffer: u64) -> i32
