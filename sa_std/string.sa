L_STR_RFIND_BYTE_NEXT_%out_ok:
    __str_rfind_byte_is_zero_%out_ok = eq __str_rfind_byte_idx_%out_ok, 0
    br __str_rfind_byte_is_zero_%out_ok -> L_STR_RFIND_BYTE_MISS_%out_ok, L_STR_RFIND_BYTE_DEC_%out_ok

L_STR_RFIND_BYTE_DEC_%out_ok:
    __str_rfind_byte_prev_%out_ok = sub __str_rfind_byte_idx_%out_ok, 1
    store __str_rfind_byte_idx_slot_%out_ok+0, __str_rfind_byte_prev_%out_ok as u64
