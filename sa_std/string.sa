[MACRO] STR_ENDS_WITH %out_bool, %slice_reg, %suffix_slice
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    __str_suffix_len_%out_bool = load %suffix_slice+Slice_len as u64
    __str_can_match_%out_bool = ule __str_suffix_len_%out_bool, __str_len_%out_bool
