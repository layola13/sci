@import "core/slice.sal"
@import "core/slice.sa"
@import "vec.sal"
@import "string.sai"
@import "fmt.sai"

[MACRO] STR_LEN %out_len, %slice_reg
    EXPAND SLICE_GET_LEN %out_len, %slice_reg
[END_MACRO]

[MACRO] STRING_LEN %out_len, %slice_reg
    EXPAND STR_LEN %out_len, %slice_reg
[END_MACRO]

[MACRO] STR_PTR %out_ptr, %slice_reg
    EXPAND SLICE_GET_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_PTR %out_ptr, %slice_reg
    EXPAND STR_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_PTR %out_ptr, %slice_reg
    EXPAND STR_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_PTR %out_ptr, %slice_reg
    EXPAND STRING_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_BYTES %out_slice, %slice_reg
    __str_ptr_%out_slice = load %slice_reg+Slice_ptr as ptr
    __str_len_%out_slice = load %slice_reg+Slice_len as u64
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_ptr_%out_slice, __str_len_%out_slice
    !__str_ptr_%out_slice
    !__str_len_%out_slice
[END_MACRO]

[MACRO] STRING_AS_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_BYTES %out_slice, %slice_reg
    EXPAND STRING_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_STR %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_IS_EMPTY %out_bool, %slice_reg
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    %out_bool = eq __str_len_%out_bool, 0
    !__str_len_%out_bool
[END_MACRO]

[MACRO] STRING_IS_EMPTY %out_bool, %slice_reg
    EXPAND STR_IS_EMPTY %out_bool, %slice_reg
[END_MACRO]

[MACRO] STR_FROM_PARTS %out_slice, %data_ptr, %length
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, %data_ptr, %length
[END_MACRO]

[MACRO] STRING_FROM_PARTS %out_slice, %data_ptr, %length
    EXPAND STR_FROM_PARTS %out_slice, %data_ptr, %length
[END_MACRO]

[MACRO] STRING_NEW %out_slice
    __string_empty_ptr_%out_slice = 0 as ptr
    EXPAND STRING_FROM_PARTS %out_slice, __string_empty_ptr_%out_slice, 0
    !__string_empty_ptr_%out_slice
[END_MACRO]

[MACRO] STRING_BUF_NEW %out_string
    EXPAND VEC_WITH_CAPACITY %out_string, 0, 1
[END_MACRO]

[MACRO] STRING_BUF_WITH_CAPACITY %out_string, %capacity
    EXPAND VEC_WITH_CAPACITY %out_string, %capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_WITH_CAPACITY %out_ok, %out_string, %capacity
    EXPAND VEC_TRY_WITH_CAPACITY %out_ok, %out_string, %capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_FREE %string_reg
    EXPAND VEC_FREE %string_reg
[END_MACRO]

[MACRO] STRING_BUF_LEN %out_len, %string_reg
    EXPAND VEC_LEN %out_len, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_CAPACITY %out_cap, %string_reg
    EXPAND VEC_CAPACITY %out_cap, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_IS_EMPTY %out_bool, %string_reg
    EXPAND VEC_IS_EMPTY %out_bool, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_PTR %out_ptr, %string_reg
    EXPAND VEC_AS_PTR %out_ptr, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_MUT_PTR %out_ptr, %string_reg
    EXPAND VEC_AS_MUT_PTR %out_ptr, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_STR %out_slice, %string_reg
    EXPAND VEC_AS_SLICE %out_slice, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_BYTES %out_slice, %string_reg
    EXPAND VEC_AS_SLICE %out_slice, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_RESERVE %string_reg, %additional
    EXPAND VEC_RESERVE %string_reg, %additional, 1
[END_MACRO]

[MACRO] STRING_BUF_RESERVE_EXACT %string_reg, %additional
    EXPAND VEC_RESERVE_EXACT %string_reg, %additional, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_RESERVE %out_ok, %string_reg, %additional
    EXPAND VEC_TRY_RESERVE %out_ok, %string_reg, %additional, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_RESERVE_EXACT %out_ok, %string_reg, %additional
    EXPAND VEC_TRY_RESERVE_EXACT %out_ok, %string_reg, %additional, 1
[END_MACRO]

[MACRO] STRING_BUF_SHRINK_TO %string_reg, %min_capacity
    EXPAND VEC_SHRINK_TO %string_reg, %min_capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_SHRINK_TO_FIT %string_reg
    EXPAND VEC_SHRINK_TO_FIT %string_reg, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_SHRINK_TO %out_ok, %string_reg, %min_capacity
    EXPAND VEC_TRY_SHRINK_TO %out_ok, %string_reg, %min_capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_SHRINK_TO_FIT %out_ok, %string_reg
    EXPAND VEC_TRY_SHRINK_TO_FIT %out_ok, %string_reg, 1
[END_MACRO]

[MACRO] STRING_BUF_CLEAR %string_reg
    EXPAND VEC_CLEAR %string_reg
[END_MACRO]

[MACRO] STRING_BUF_TRUNCATE %string_reg, %new_len
    EXPAND VEC_TRUNCATE %string_reg, %new_len
[END_MACRO]

[MACRO] STRING_BUF_PUSH_BYTE %string_reg, %byte_value
    __string_buf_push_view_%string_reg = & %string_reg
    __string_buf_push_len_%string_reg = load __string_buf_push_view_%string_reg+Vec_len as u64
    __string_buf_push_cap_%string_reg = load __string_buf_push_view_%string_reg+Vec_cap as u64
    __string_buf_push_needs_grow_%string_reg = eq __string_buf_push_len_%string_reg, __string_buf_push_cap_%string_reg
    !__string_buf_push_view_%string_reg
    br __string_buf_push_needs_grow_%string_reg -> L_STRING_BUF_PUSH_GROW_%string_reg, L_STRING_BUF_PUSH_WRITE_%string_reg

L_STRING_BUF_PUSH_GROW_%string_reg:
    EXPAND STRING_BUF_RESERVE %string_reg, 1
    jmp L_STRING_BUF_PUSH_WRITE_%string_reg

L_STRING_BUF_PUSH_WRITE_%string_reg:
    __string_buf_push_view2_%string_reg = & %string_reg
    __string_buf_push_ptr_%string_reg = load __string_buf_push_view2_%string_reg+Vec_ptr as ptr
    __string_buf_push_dst_%string_reg = ptr_add __string_buf_push_ptr_%string_reg, __string_buf_push_len_%string_reg
    store __string_buf_push_dst_%string_reg+0, %byte_value as u8
    __string_buf_push_next_len_%string_reg = add __string_buf_push_len_%string_reg, 1
    store __string_buf_push_view2_%string_reg+Vec_len, __string_buf_push_next_len_%string_reg as u64
    !__string_buf_push_next_len_%string_reg
    !__string_buf_push_dst_%string_reg
    !__string_buf_push_ptr_%string_reg
    !__string_buf_push_view2_%string_reg
    !__string_buf_push_needs_grow_%string_reg
    !__string_buf_push_cap_%string_reg
    !__string_buf_push_len_%string_reg
[END_MACRO]

[MACRO] STRING_BUF_PUSH_STR %string_reg, %suffix_slice
    __string_buf_suffix_len_%string_reg = load %suffix_slice+Slice_len as u64
    EXPAND STRING_BUF_RESERVE %string_reg, __string_buf_suffix_len_%string_reg
    __string_buf_push_str_view_%string_reg = & %string_reg
    __string_buf_dst_buf_%string_reg = load __string_buf_push_str_view_%string_reg+Vec_ptr as ptr
    __string_buf_dst_len_%string_reg = load __string_buf_push_str_view_%string_reg+Vec_len as u64
    __string_buf_dst_ptr_%string_reg = ptr_add __string_buf_dst_buf_%string_reg, __string_buf_dst_len_%string_reg
    __string_buf_src_ptr_%string_reg = load %suffix_slice+Slice_ptr as ptr
    call @sa_mem_copy(&__string_buf_dst_ptr_%string_reg, &__string_buf_src_ptr_%string_reg, __string_buf_suffix_len_%string_reg)
    __string_buf_next_len_%string_reg = add __string_buf_dst_len_%string_reg, __string_buf_suffix_len_%string_reg
    store __string_buf_push_str_view_%string_reg+Vec_len, __string_buf_next_len_%string_reg as u64
    !__string_buf_next_len_%string_reg
    !__string_buf_src_ptr_%string_reg
    !__string_buf_dst_ptr_%string_reg
    !__string_buf_dst_len_%string_reg
    !__string_buf_dst_buf_%string_reg
    !__string_buf_push_str_view_%string_reg
    !__string_buf_suffix_len_%string_reg
[END_MACRO]

[MACRO] STR_EMPTY %out_slice
    __str_empty_ptr_%out_slice = 0 as ptr
    EXPAND STR_FROM_PARTS %out_slice, __str_empty_ptr_%out_slice, 0
    !__str_empty_ptr_%out_slice
[END_MACRO]

[MACRO] STR_SLICE %out_slice, %src_slice, %start, %length
    __str_src_ptr_%out_slice = load %src_slice+Slice_ptr as ptr
    __str_start_ptr_%out_slice = ptr_add __str_src_ptr_%out_slice, %start
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_start_ptr_%out_slice, %length
    !__str_src_ptr_%out_slice
    !__str_start_ptr_%out_slice
[END_MACRO]

[MACRO] STR_EQ %out_bool, %left_slice, %right_slice
    left_ptr_%out_bool = load %left_slice+Slice_ptr as ptr
    right_ptr_%out_bool = load %right_slice+Slice_ptr as ptr
    left_len_%out_bool = load %left_slice+Slice_len as u64
    right_len_%out_bool = load %right_slice+Slice_len as u64
    same_len_%out_bool = eq left_len_%out_bool, right_len_%out_bool
    idx_slot_%out_bool = stack_alloc 8
    store idx_slot_%out_bool+0, 0 as u64
    br same_len_%out_bool -> L_STR_EQ_HEAD_%out_bool, L_STR_EQ_NE_%out_bool
L_STR_EQ_LOOP_%out_bool:
    jmp L_STR_EQ_HEAD_%out_bool
L_STR_EQ_HEAD_%out_bool:
    idx_%out_bool = load idx_slot_%out_bool+0 as u64
    done_%out_bool = eq idx_%out_bool, left_len_%out_bool
    br done_%out_bool -> L_STR_EQ_TRUE_%out_bool, L_STR_EQ_BODY_%out_bool
L_STR_EQ_BODY_%out_bool:
    left_ip_%out_bool = ptr_add left_ptr_%out_bool, idx_%out_bool
    right_ip_%out_bool = ptr_add right_ptr_%out_bool, idx_%out_bool
    left_byte_%out_bool = load left_ip_%out_bool+0 as u8
    right_byte_%out_bool = load right_ip_%out_bool+0 as u8
    bytes_eq_%out_bool = eq left_byte_%out_bool, right_byte_%out_bool
    !left_byte_%out_bool
    !right_byte_%out_bool
    !left_ip_%out_bool
    !right_ip_%out_bool
    br bytes_eq_%out_bool -> L_STR_EQ_NEXT_%out_bool, L_STR_EQ_FALSE_%out_bool
L_STR_EQ_NEXT_%out_bool:
    next_idx_%out_bool = add idx_%out_bool, 1
    store idx_slot_%out_bool+0, next_idx_%out_bool as u64
    !idx_%out_bool
    !done_%out_bool
    !bytes_eq_%out_bool
    !next_idx_%out_bool
    jmp L_STR_EQ_HEAD_%out_bool
L_STR_EQ_TRUE_%out_bool:
    %out_bool = add 0, 1
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
    jmp L_STR_EQ_END_%out_bool
L_STR_EQ_FALSE_%out_bool:
    %out_bool = add 0, 0
    !bytes_eq_%out_bool
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
    jmp L_STR_EQ_END_%out_bool
L_STR_EQ_NE_%out_bool:
    %out_bool = add 0, 0
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
L_STR_EQ_END_%out_bool:
[END_MACRO]

[MACRO] STR_CONTAINS %out_bool, %slice_reg, %needle_slice
    __str_ptr_%out_bool = load %slice_reg+Slice_ptr as ptr
    __str_needle_ptr_%out_bool = load %needle_slice+Slice_ptr as ptr
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    __str_needle_len_%out_bool = load %needle_slice+Slice_len as u64
    __str_idx_slot_%out_bool = stack_alloc 8
    __str_inner_slot_%out_bool = stack_alloc 8
    store __str_idx_slot_%out_bool+0, 0 as u64
    store __str_inner_slot_%out_bool+0, 0 as u64
    __str_empty_needle_%out_bool = eq __str_needle_len_%out_bool, 0
    br __str_empty_needle_%out_bool -> L_STR_CONTAINS_TRUE_EMPTY_%out_bool, L_STR_CONTAINS_CHECK_%out_bool

L_STR_CONTAINS_TRUE_EMPTY_%out_bool:
    %out_bool = add 0, 1
    !__str_empty_needle_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_CHECK_%out_bool:
    __str_can_match_%out_bool = ule __str_needle_len_%out_bool, __str_len_%out_bool
    br __str_can_match_%out_bool -> L_STR_CONTAINS_INIT_%out_bool, L_STR_CONTAINS_FALSE_%out_bool

L_STR_CONTAINS_INIT_%out_bool:
    __str_last_start_%out_bool = sub __str_len_%out_bool, __str_needle_len_%out_bool
    store __str_idx_slot_%out_bool+0, 0 as u64
    !__str_can_match_%out_bool
    !__str_empty_needle_%out_bool
    jmp L_STR_CONTAINS_HEAD_%out_bool

L_STR_CONTAINS_HEAD_%out_bool:
    __str_idx_%out_bool = load __str_idx_slot_%out_bool+0 as u64
    __str_after_last_%out_bool = ugt __str_idx_%out_bool, __str_last_start_%out_bool
    br __str_after_last_%out_bool -> L_STR_CONTAINS_FALSE_LOOP_%out_bool, L_STR_CONTAINS_INNER_INIT_%out_bool

L_STR_CONTAINS_INNER_INIT_%out_bool:
    store __str_inner_slot_%out_bool+0, 0 as u64
    !__str_after_last_%out_bool
    jmp L_STR_CONTAINS_INNER_HEAD_%out_bool

L_STR_CONTAINS_INNER_HEAD_%out_bool:
    __str_inner_%out_bool = load __str_inner_slot_%out_bool+0 as u64
    __str_inner_done_%out_bool = eq __str_inner_%out_bool, __str_needle_len_%out_bool
    br __str_inner_done_%out_bool -> L_STR_CONTAINS_TRUE_%out_bool, L_STR_CONTAINS_BODY_%out_bool

L_STR_CONTAINS_BODY_%out_bool:
    __str_hay_off_%out_bool = add __str_idx_%out_bool, __str_inner_%out_bool
    __str_hay_ip_%out_bool = ptr_add __str_ptr_%out_bool, __str_hay_off_%out_bool
    __str_needle_ip_%out_bool = ptr_add __str_needle_ptr_%out_bool, __str_inner_%out_bool
    __str_hay_byte_%out_bool = load __str_hay_ip_%out_bool+0 as u8
    __str_needle_byte_%out_bool = load __str_needle_ip_%out_bool+0 as u8
    __str_match_%out_bool = eq __str_hay_byte_%out_bool, __str_needle_byte_%out_bool
    br __str_match_%out_bool -> L_STR_CONTAINS_INNER_NEXT_%out_bool, L_STR_CONTAINS_NEXT_%out_bool

L_STR_CONTAINS_INNER_NEXT_%out_bool:
    __str_inner_next_%out_bool = add __str_inner_%out_bool, 1
    store __str_inner_slot_%out_bool+0, __str_inner_next_%out_bool as u64
    !__str_inner_next_%out_bool
    !__str_match_%out_bool
    !__str_needle_byte_%out_bool
    !__str_hay_byte_%out_bool
    !__str_needle_ip_%out_bool
    !__str_hay_ip_%out_bool
    !__str_hay_off_%out_bool
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    jmp L_STR_CONTAINS_INNER_HEAD_%out_bool

L_STR_CONTAINS_NEXT_%out_bool:
    __str_next_%out_bool = add __str_idx_%out_bool, 1
    store __str_idx_slot_%out_bool+0, __str_next_%out_bool as u64
    !__str_next_%out_bool
    !__str_match_%out_bool
    !__str_needle_byte_%out_bool
    !__str_hay_byte_%out_bool
    !__str_needle_ip_%out_bool
    !__str_hay_ip_%out_bool
    !__str_hay_off_%out_bool
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    !__str_idx_%out_bool
    jmp L_STR_CONTAINS_HEAD_%out_bool

L_STR_CONTAINS_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    !__str_idx_%out_bool
    !__str_last_start_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_FALSE_LOOP_%out_bool:
    %out_bool = add 0, 0
    !__str_after_last_%out_bool
    !__str_idx_%out_bool
    !__str_last_start_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_FALSE_%out_bool:
    %out_bool = add 0, 0
    !__str_can_match_%out_bool
    !__str_empty_needle_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool

L_STR_CONTAINS_END_%out_bool:
[END_MACRO]

[MACRO] STRING_CONTAINS %out_bool, %slice_reg, %needle_slice
    EXPAND STR_CONTAINS %out_bool, %slice_reg, %needle_slice
[END_MACRO]

[MACRO] STR_TRY_FIND %out_ok, %out_index, %slice_reg, %needle_slice
    __str_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_needle_ptr_%out_ok = load %needle_slice+Slice_ptr as ptr
    __str_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_idx_slot_%out_ok = stack_alloc 8
    __str_inner_slot_%out_ok = stack_alloc 8
    store __str_idx_slot_%out_ok+0, 0 as u64
    store __str_inner_slot_%out_ok+0, 0 as u64
    __str_empty_needle_%out_ok = eq __str_needle_len_%out_ok, 0
    br __str_empty_needle_%out_ok -> L_STR_FIND_EMPTY_%out_ok, L_STR_FIND_CHECK_%out_ok

L_STR_FIND_EMPTY_%out_ok:
    %out_ok = add 0, 1
    %out_index = add 0, 0
    !__str_empty_needle_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_needle_ptr_%out_ok
    !__str_ptr_%out_ok
    jmp L_STR_FIND_END_%out_ok

L_STR_FIND_CHECK_%out_ok:
    __str_can_match_%out_ok = ule __str_needle_len_%out_ok, __str_len_%out_ok
    br __str_can_match_%out_ok -> L_STR_FIND_INIT_%out_ok, L_STR_FIND_MISS_%out_ok

L_STR_FIND_INIT_%out_ok:
    __str_last_start_%out_ok = sub __str_len_%out_ok, __str_needle_len_%out_ok
    store __str_idx_slot_%out_ok+0, 0 as u64
    !__str_can_match_%out_ok
    !__str_empty_needle_%out_ok
    jmp L_STR_FIND_HEAD_%out_ok

L_STR_FIND_HEAD_%out_ok:
    __str_idx_%out_ok = load __str_idx_slot_%out_ok+0 as u64
    __str_after_last_%out_ok = ugt __str_idx_%out_ok, __str_last_start_%out_ok
    br __str_after_last_%out_ok -> L_STR_FIND_MISS_LOOP_%out_ok, L_STR_FIND_INNER_INIT_%out_ok

L_STR_FIND_INNER_INIT_%out_ok:
    store __str_inner_slot_%out_ok+0, 0 as u64
    !__str_after_last_%out_ok
    jmp L_STR_FIND_INNER_HEAD_%out_ok

L_STR_FIND_INNER_HEAD_%out_ok:
    __str_inner_%out_ok = load __str_inner_slot_%out_ok+0 as u64
    __str_inner_done_%out_ok = eq __str_inner_%out_ok, __str_needle_len_%out_ok
    br __str_inner_done_%out_ok -> L_STR_FIND_HIT_%out_ok, L_STR_FIND_BODY_%out_ok

L_STR_FIND_BODY_%out_ok:
    __str_hay_off_%out_ok = add __str_idx_%out_ok, __str_inner_%out_ok
    __str_hay_ip_%out_ok = ptr_add __str_ptr_%out_ok, __str_hay_off_%out_ok
    __str_needle_ip_%out_ok = ptr_add __str_needle_ptr_%out_ok, __str_inner_%out_ok
    __str_hay_byte_%out_ok = load __str_hay_ip_%out_ok+0 as u8
    __str_needle_byte_%out_ok = load __str_needle_ip_%out_ok+0 as u8
    __str_match_%out_ok = eq __str_hay_byte_%out_ok, __str_needle_byte_%out_ok
    br __str_match_%out_ok -> L_STR_FIND_INNER_NEXT_%out_ok, L_STR_FIND_NEXT_%out_ok

