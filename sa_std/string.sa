    EXPAND CHAR_TRY_ENCODE_UTF8 __string_buf_insert_char_encode_ok_%out_ok, __string_buf_insert_char_width_%out_ok, __string_buf_insert_char_tmp_%out_ok, 4, %char_value
    br __string_buf_insert_char_encode_ok_%out_ok -> L_STRING_BUF_INSERT_CHAR_HIT_%out_ok, L_STRING_BUF_INSERT_CHAR_MISS_%out_ok

L_STRING_BUF_INSERT_CHAR_HIT_%out_ok:
    __string_buf_insert_char_slice_%out_ok = alloc Slice_SIZE
    EXPAND SLICE_NEW __string_buf_insert_char_slice_%out_ok, __string_buf_insert_char_tmp_%out_ok, __string_buf_insert_char_width_%out_ok
    EXPAND STRING_BUF_TRY_INSERT_STR %out_ok, %string_reg, %index, __string_buf_insert_char_slice_%out_ok
    !__string_buf_insert_char_slice_%out_ok
    !__string_buf_insert_char_width_%out_ok
    !__string_buf_insert_char_encode_ok_%out_ok
    jmp L_STRING_BUF_INSERT_CHAR_END_%out_ok

L_STRING_BUF_INSERT_CHAR_MISS_%out_ok:
