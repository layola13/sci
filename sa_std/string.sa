    EXPAND STR_STARTS_WITH %out_bool, %slice_reg, %prefix_slice
[END_MACRO]

[MACRO] STR_TRY_STRIP_PREFIX %out_ok, %out_slice, %slice_reg, %prefix_slice
    %out_slice = alloc Slice_SIZE
    __str_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_prefix_len_%out_ok = load %prefix_slice+Slice_len as u64
    EXPAND STR_STARTS_WITH __str_strip_match_%out_ok, %slice_reg, %prefix_slice
    br __str_strip_match_%out_ok -> L_STR_STRIP_PREFIX_HIT_%out_ok, L_STR_STRIP_PREFIX_MISS_%out_ok

L_STR_STRIP_PREFIX_HIT_%out_ok:
    __str_rest_len_%out_ok = sub __str_len_%out_ok, __str_prefix_len_%out_ok
    __str_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_rest_ptr_%out_ok = ptr_add __str_src_ptr_%out_ok, __str_prefix_len_%out_ok
    EXPAND SLICE_NEW %out_slice, __str_rest_ptr_%out_ok, __str_rest_len_%out_ok
    %out_ok = add 0, 1
    !__str_rest_ptr_%out_ok
    !__str_src_ptr_%out_ok
    !__str_rest_len_%out_ok
    !__str_strip_match_%out_ok
    !__str_prefix_len_%out_ok
    !__str_len_%out_ok
    jmp L_STR_STRIP_PREFIX_END_%out_ok

L_STR_STRIP_PREFIX_MISS_%out_ok:
    __str_empty_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_slice, __str_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_empty_ptr_%out_ok
    !__str_strip_match_%out_ok
    !__str_prefix_len_%out_ok
    !__str_len_%out_ok

L_STR_STRIP_PREFIX_END_%out_ok:
[END_MACRO]

