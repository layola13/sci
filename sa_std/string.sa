@import "core/slice.sal"
@import "core/slice.sa"
@import "vec.sal"
@import "string.sai"
@import "fmt.sai"

[MACRO] STR_LEN %out_len, %slice_reg
    EXPAND SLICE_GET_LEN %out_len, %slice_reg
[END_MACRO]

[MACRO] STRING_LEN %out_len, %slice_reg
    EXPAND STR_LEN %out_len, %slice_reg
[END_MACRO]

[MACRO] STR_PTR %out_ptr, %slice_reg
    EXPAND SLICE_GET_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_PTR %out_ptr, %slice_reg
    EXPAND STR_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_PTR %out_ptr, %slice_reg
    EXPAND STR_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_PTR %out_ptr, %slice_reg
    EXPAND STRING_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_BYTES %out_slice, %slice_reg
    __str_ptr_%out_slice = load %slice_reg+Slice_ptr as ptr
    __str_len_%out_slice = load %slice_reg+Slice_len as u64
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_ptr_%out_slice, __str_len_%out_slice
    !__str_ptr_%out_slice
    !__str_len_%out_slice
[END_MACRO]

[MACRO] STRING_AS_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_BYTES %out_slice, %slice_reg
    EXPAND STRING_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_STR %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_IS_EMPTY %out_bool, %slice_reg
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    %out_bool = eq __str_len_%out_bool, 0
    !__str_len_%out_bool
[END_MACRO]

[MACRO] STRING_IS_EMPTY %out_bool, %slice_reg
    EXPAND STR_IS_EMPTY %out_bool, %slice_reg
[END_MACRO]

[MACRO] STR_FROM_PARTS %out_slice, %data_ptr, %length
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, %data_ptr, %length
[END_MACRO]

[MACRO] STRING_FROM_PARTS %out_slice, %data_ptr, %length
    EXPAND STR_FROM_PARTS %out_slice, %data_ptr, %length
[END_MACRO]

[MACRO] STRING_NEW %out_slice
    __string_empty_ptr_%out_slice = 0 as ptr
    EXPAND STRING_FROM_PARTS %out_slice, __string_empty_ptr_%out_slice, 0
    !__string_empty_ptr_%out_slice
[END_MACRO]

[MACRO] STRING_BUF_NEW %out_string
    EXPAND VEC_WITH_CAPACITY %out_string, 0, 1
[END_MACRO]

[MACRO] STRING_BUF_WITH_CAPACITY %out_string, %capacity
    EXPAND VEC_WITH_CAPACITY %out_string, %capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_WITH_CAPACITY %out_ok, %out_string, %capacity
    EXPAND VEC_TRY_WITH_CAPACITY %out_ok, %out_string, %capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_FREE %string_reg
    EXPAND VEC_FREE %string_reg
[END_MACRO]

[MACRO] STRING_BUF_LEN %out_len, %string_reg
    EXPAND VEC_LEN %out_len, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_CAPACITY %out_cap, %string_reg
    EXPAND VEC_CAPACITY %out_cap, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_IS_EMPTY %out_bool, %string_reg
    EXPAND VEC_IS_EMPTY %out_bool, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_PTR %out_ptr, %string_reg
    EXPAND VEC_AS_PTR %out_ptr, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_MUT_PTR %out_ptr, %string_reg
    EXPAND VEC_AS_MUT_PTR %out_ptr, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_STR %out_slice, %string_reg
    EXPAND VEC_AS_SLICE %out_slice, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_BYTES %out_slice, %string_reg
    EXPAND VEC_AS_SLICE %out_slice, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_INTO_BYTES %out_vec, %string_reg
    %out_vec = %string_reg
[END_MACRO]

[MACRO] STRING_BUF_FROM_UTF8_UNCHECKED %out_string, %bytes_slice
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, 0
    EXPAND STRING_BUF_PUSH_STR %out_string, %bytes_slice
[END_MACRO]

[MACRO] STRING_BUF_TRY_FROM_UTF8_ASCII %out_ok, %out_string, %bytes_slice
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, 0
    __string_buf_ascii_ptr_%out_ok = load %bytes_slice+Slice_ptr as ptr
    __string_buf_ascii_len_%out_ok = load %bytes_slice+Slice_len as u64
    __string_buf_ascii_idx_slot_%out_ok = stack_alloc 8
    store __string_buf_ascii_idx_slot_%out_ok+0, 0 as u64
    jmp L_STRING_BUF_ASCII_HEAD_%out_ok

L_STRING_BUF_ASCII_HEAD_%out_ok:
    __string_buf_ascii_idx_%out_ok = load __string_buf_ascii_idx_slot_%out_ok+0 as u64
    __string_buf_ascii_done_%out_ok = eq __string_buf_ascii_idx_%out_ok, __string_buf_ascii_len_%out_ok
    br __string_buf_ascii_done_%out_ok -> L_STRING_BUF_ASCII_OK_%out_ok, L_STRING_BUF_ASCII_BODY_%out_ok

L_STRING_BUF_ASCII_BODY_%out_ok:
    __string_buf_ascii_ip_%out_ok = ptr_add __string_buf_ascii_ptr_%out_ok, __string_buf_ascii_idx_%out_ok
    __string_buf_ascii_byte_%out_ok = load __string_buf_ascii_ip_%out_ok+0 as u8
    __string_buf_ascii_is_ascii_%out_ok = ult __string_buf_ascii_byte_%out_ok, 128
    br __string_buf_ascii_is_ascii_%out_ok -> L_STRING_BUF_ASCII_NEXT_%out_ok, L_STRING_BUF_ASCII_MISS_%out_ok

L_STRING_BUF_ASCII_NEXT_%out_ok:
    __string_buf_ascii_next_%out_ok = add __string_buf_ascii_idx_%out_ok, 1
    store __string_buf_ascii_idx_slot_%out_ok+0, __string_buf_ascii_next_%out_ok as u64
    !__string_buf_ascii_next_%out_ok
    !__string_buf_ascii_is_ascii_%out_ok
    !__string_buf_ascii_byte_%out_ok
    !__string_buf_ascii_ip_%out_ok
    !__string_buf_ascii_done_%out_ok
    !__string_buf_ascii_idx_%out_ok
    jmp L_STRING_BUF_ASCII_HEAD_%out_ok

L_STRING_BUF_ASCII_OK_%out_ok:
    EXPAND STRING_BUF_PUSH_STR %out_string, %bytes_slice
    %out_ok = add 0, 1
    !__string_buf_ascii_done_%out_ok
    !__string_buf_ascii_idx_%out_ok
    !__string_buf_ascii_len_%out_ok
    !__string_buf_ascii_ptr_%out_ok
    jmp L_STRING_BUF_ASCII_END_%out_ok

L_STRING_BUF_ASCII_MISS_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_ascii_is_ascii_%out_ok
    !__string_buf_ascii_byte_%out_ok
    !__string_buf_ascii_ip_%out_ok
    !__string_buf_ascii_done_%out_ok
    !__string_buf_ascii_idx_%out_ok
    !__string_buf_ascii_len_%out_ok
    !__string_buf_ascii_ptr_%out_ok

L_STRING_BUF_ASCII_END_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_REPLACE %out_string, %source_slice, %needle_slice, %replacement_slice
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, 0
    __string_buf_replace_all_ptr_%out_string = load %source_slice+Slice_ptr as ptr
    __string_buf_replace_all_len_%out_string = load %source_slice+Slice_len as u64
    __string_buf_replace_all_needle_ptr_%out_string = load %needle_slice+Slice_ptr as ptr
    __string_buf_replace_all_needle_len_%out_string = load %needle_slice+Slice_len as u64
    __string_buf_replace_all_idx_slot_%out_string = stack_alloc 8
    __string_buf_replace_all_inner_slot_%out_string = stack_alloc 8
    store __string_buf_replace_all_idx_slot_%out_string+0, 0 as u64
    store __string_buf_replace_all_inner_slot_%out_string+0, 0 as u64
    __string_buf_replace_all_empty_%out_string = eq __string_buf_replace_all_needle_len_%out_string, 0
    br __string_buf_replace_all_empty_%out_string -> L_STRING_BUF_REPLACE_ALL_COPY_%out_string, L_STRING_BUF_REPLACE_ALL_HEAD_%out_string

L_STRING_BUF_REPLACE_ALL_COPY_%out_string:
    EXPAND STRING_BUF_PUSH_STR %out_string, %source_slice
    !__string_buf_replace_all_empty_%out_string
    !__string_buf_replace_all_needle_len_%out_string
    !__string_buf_replace_all_needle_ptr_%out_string
    !__string_buf_replace_all_len_%out_string
    !__string_buf_replace_all_ptr_%out_string
    jmp L_STRING_BUF_REPLACE_ALL_END_%out_string

L_STRING_BUF_REPLACE_ALL_HEAD_%out_string:
    __string_buf_replace_all_idx_%out_string = load __string_buf_replace_all_idx_slot_%out_string+0 as u64
    __string_buf_replace_all_done_%out_string = eq __string_buf_replace_all_idx_%out_string, __string_buf_replace_all_len_%out_string
    br __string_buf_replace_all_done_%out_string -> L_STRING_BUF_REPLACE_ALL_DONE_%out_string, L_STRING_BUF_REPLACE_ALL_RANGE_%out_string

L_STRING_BUF_REPLACE_ALL_RANGE_%out_string:
    __string_buf_replace_all_remaining_%out_string = sub __string_buf_replace_all_len_%out_string, __string_buf_replace_all_idx_%out_string
    __string_buf_replace_all_can_match_%out_string = uge __string_buf_replace_all_remaining_%out_string, __string_buf_replace_all_needle_len_%out_string
    br __string_buf_replace_all_can_match_%out_string -> L_STRING_BUF_REPLACE_ALL_MATCH_INIT_%out_string, L_STRING_BUF_REPLACE_ALL_KEEP_RANGE_%out_string

L_STRING_BUF_REPLACE_ALL_MATCH_INIT_%out_string:
    store __string_buf_replace_all_inner_slot_%out_string+0, 0 as u64
    !__string_buf_replace_all_can_match_%out_string
    !__string_buf_replace_all_remaining_%out_string
    jmp L_STRING_BUF_REPLACE_ALL_MATCH_HEAD_%out_string

L_STRING_BUF_REPLACE_ALL_MATCH_HEAD_%out_string:
    __string_buf_replace_all_inner_%out_string = load __string_buf_replace_all_inner_slot_%out_string+0 as u64
    __string_buf_replace_all_inner_done_%out_string = eq __string_buf_replace_all_inner_%out_string, __string_buf_replace_all_needle_len_%out_string
    br __string_buf_replace_all_inner_done_%out_string -> L_STRING_BUF_REPLACE_ALL_HIT_%out_string, L_STRING_BUF_REPLACE_ALL_MATCH_BODY_%out_string

L_STRING_BUF_REPLACE_ALL_MATCH_BODY_%out_string:
    __string_buf_replace_all_hay_off_%out_string = add __string_buf_replace_all_idx_%out_string, __string_buf_replace_all_inner_%out_string
    __string_buf_replace_all_hay_ip_%out_string = ptr_add __string_buf_replace_all_ptr_%out_string, __string_buf_replace_all_hay_off_%out_string
    __string_buf_replace_all_needle_ip_%out_string = ptr_add __string_buf_replace_all_needle_ptr_%out_string, __string_buf_replace_all_inner_%out_string
    __string_buf_replace_all_hay_byte_%out_string = load __string_buf_replace_all_hay_ip_%out_string+0 as u8
    __string_buf_replace_all_needle_byte_%out_string = load __string_buf_replace_all_needle_ip_%out_string+0 as u8
    __string_buf_replace_all_match_%out_string = eq __string_buf_replace_all_hay_byte_%out_string, __string_buf_replace_all_needle_byte_%out_string
    br __string_buf_replace_all_match_%out_string -> L_STRING_BUF_REPLACE_ALL_MATCH_NEXT_%out_string, L_STRING_BUF_REPLACE_ALL_KEEP_MATCH_%out_string

L_STRING_BUF_REPLACE_ALL_MATCH_NEXT_%out_string:
    __string_buf_replace_all_inner_next_%out_string = add __string_buf_replace_all_inner_%out_string, 1
    store __string_buf_replace_all_inner_slot_%out_string+0, __string_buf_replace_all_inner_next_%out_string as u64
    !__string_buf_replace_all_inner_next_%out_string
    !__string_buf_replace_all_match_%out_string
    !__string_buf_replace_all_needle_byte_%out_string
    !__string_buf_replace_all_hay_byte_%out_string
    !__string_buf_replace_all_needle_ip_%out_string
    !__string_buf_replace_all_hay_ip_%out_string
    !__string_buf_replace_all_hay_off_%out_string
    !__string_buf_replace_all_inner_done_%out_string
    !__string_buf_replace_all_inner_%out_string
    jmp L_STRING_BUF_REPLACE_ALL_MATCH_HEAD_%out_string

L_STRING_BUF_REPLACE_ALL_KEEP_MATCH_%out_string:
    !__string_buf_replace_all_match_%out_string
    !__string_buf_replace_all_needle_byte_%out_string
    !__string_buf_replace_all_hay_byte_%out_string
    !__string_buf_replace_all_needle_ip_%out_string
    !__string_buf_replace_all_hay_ip_%out_string
    !__string_buf_replace_all_hay_off_%out_string
    !__string_buf_replace_all_inner_done_%out_string
    !__string_buf_replace_all_inner_%out_string
    jmp L_STRING_BUF_REPLACE_ALL_KEEP_%out_string

L_STRING_BUF_REPLACE_ALL_KEEP_RANGE_%out_string:
    !__string_buf_replace_all_can_match_%out_string
    !__string_buf_replace_all_remaining_%out_string
    jmp L_STRING_BUF_REPLACE_ALL_KEEP_%out_string

L_STRING_BUF_REPLACE_ALL_KEEP_%out_string:
    __string_buf_replace_all_ip_%out_string = ptr_add __string_buf_replace_all_ptr_%out_string, __string_buf_replace_all_idx_%out_string
    __string_buf_replace_all_byte_%out_string = load __string_buf_replace_all_ip_%out_string+0 as u8
    EXPAND STRING_BUF_PUSH_BYTE %out_string, __string_buf_replace_all_byte_%out_string
    __string_buf_replace_all_keep_next_%out_string = add __string_buf_replace_all_idx_%out_string, 1
    store __string_buf_replace_all_idx_slot_%out_string+0, __string_buf_replace_all_keep_next_%out_string as u64
    !__string_buf_replace_all_keep_next_%out_string
    !__string_buf_replace_all_byte_%out_string
    !__string_buf_replace_all_ip_%out_string
    !__string_buf_replace_all_done_%out_string
    !__string_buf_replace_all_idx_%out_string
    jmp L_STRING_BUF_REPLACE_ALL_HEAD_%out_string

L_STRING_BUF_REPLACE_ALL_HIT_%out_string:
    EXPAND STRING_BUF_PUSH_STR %out_string, %replacement_slice
    __string_buf_replace_all_next_idx_%out_string = add __string_buf_replace_all_idx_%out_string, __string_buf_replace_all_needle_len_%out_string
    store __string_buf_replace_all_idx_slot_%out_string+0, __string_buf_replace_all_next_idx_%out_string as u64
    !__string_buf_replace_all_next_idx_%out_string
    !__string_buf_replace_all_inner_done_%out_string
    !__string_buf_replace_all_inner_%out_string
    !__string_buf_replace_all_done_%out_string
    !__string_buf_replace_all_idx_%out_string
    jmp L_STRING_BUF_REPLACE_ALL_HEAD_%out_string

L_STRING_BUF_REPLACE_ALL_DONE_%out_string:
    !__string_buf_replace_all_done_%out_string
    !__string_buf_replace_all_idx_%out_string
    !__string_buf_replace_all_empty_%out_string
    !__string_buf_replace_all_needle_len_%out_string
    !__string_buf_replace_all_needle_ptr_%out_string
    !__string_buf_replace_all_len_%out_string
    !__string_buf_replace_all_ptr_%out_string

L_STRING_BUF_REPLACE_ALL_END_%out_string:
[END_MACRO]

[MACRO] STRING_BUF_RESERVE %string_reg, %additional
    EXPAND VEC_RESERVE %string_reg, %additional, 1
[END_MACRO]

[MACRO] STRING_BUF_RESERVE_EXACT %string_reg, %additional
    EXPAND VEC_RESERVE_EXACT %string_reg, %additional, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_RESERVE %out_ok, %string_reg, %additional
    EXPAND VEC_TRY_RESERVE %out_ok, %string_reg, %additional, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_RESERVE_EXACT %out_ok, %string_reg, %additional
    EXPAND VEC_TRY_RESERVE_EXACT %out_ok, %string_reg, %additional, 1
[END_MACRO]

[MACRO] STRING_BUF_SHRINK_TO %string_reg, %min_capacity
    EXPAND VEC_SHRINK_TO %string_reg, %min_capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_SHRINK_TO_FIT %string_reg
    EXPAND VEC_SHRINK_TO_FIT %string_reg, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_SHRINK_TO %out_ok, %string_reg, %min_capacity
    EXPAND VEC_TRY_SHRINK_TO %out_ok, %string_reg, %min_capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_SHRINK_TO_FIT %out_ok, %string_reg
    EXPAND VEC_TRY_SHRINK_TO_FIT %out_ok, %string_reg, 1
[END_MACRO]

[MACRO] STRING_BUF_CLEAR %string_reg
    EXPAND VEC_CLEAR %string_reg
[END_MACRO]

[MACRO] STRING_BUF_TRUNCATE %string_reg, %new_len
    EXPAND VEC_TRUNCATE %string_reg, %new_len
[END_MACRO]

[MACRO] STRING_BUF_PUSH_BYTE %string_reg, %byte_value
    __string_buf_push_view_%string_reg = & %string_reg
    __string_buf_push_len_%string_reg = load __string_buf_push_view_%string_reg+Vec_len as u64
    __string_buf_push_cap_%string_reg = load __string_buf_push_view_%string_reg+Vec_cap as u64
    __string_buf_push_needs_grow_%string_reg = eq __string_buf_push_len_%string_reg, __string_buf_push_cap_%string_reg
    !__string_buf_push_view_%string_reg
    br __string_buf_push_needs_grow_%string_reg -> L_STRING_BUF_PUSH_GROW_%string_reg, L_STRING_BUF_PUSH_WRITE_%string_reg

L_STRING_BUF_PUSH_GROW_%string_reg:
    EXPAND STRING_BUF_RESERVE %string_reg, 1
    jmp L_STRING_BUF_PUSH_WRITE_%string_reg

L_STRING_BUF_PUSH_WRITE_%string_reg:
    __string_buf_push_view2_%string_reg = & %string_reg
    __string_buf_push_ptr_%string_reg = load __string_buf_push_view2_%string_reg+Vec_ptr as ptr
    __string_buf_push_dst_%string_reg = ptr_add __string_buf_push_ptr_%string_reg, __string_buf_push_len_%string_reg
    store __string_buf_push_dst_%string_reg+0, %byte_value as u8
    __string_buf_push_next_len_%string_reg = add __string_buf_push_len_%string_reg, 1
    store __string_buf_push_view2_%string_reg+Vec_len, __string_buf_push_next_len_%string_reg as u64
    !__string_buf_push_next_len_%string_reg
    !__string_buf_push_dst_%string_reg
    !__string_buf_push_ptr_%string_reg
    !__string_buf_push_view2_%string_reg
    !__string_buf_push_needs_grow_%string_reg
    !__string_buf_push_cap_%string_reg
    !__string_buf_push_len_%string_reg
[END_MACRO]

[MACRO] STRING_BUF_TRY_PUSH_CHAR %out_ok, %string_reg, %char_value
    __string_buf_push_char_ascii_%out_ok = ult %char_value, 128
    br __string_buf_push_char_ascii_%out_ok -> L_STRING_BUF_PUSH_CHAR_HIT_%out_ok, L_STRING_BUF_PUSH_CHAR_MISS_%out_ok

L_STRING_BUF_PUSH_CHAR_HIT_%out_ok:
    __string_buf_push_char_view_%out_ok = & %string_reg
    __string_buf_push_char_len_%out_ok = load __string_buf_push_char_view_%out_ok+Vec_len as u64
    __string_buf_push_char_cap_%out_ok = load __string_buf_push_char_view_%out_ok+Vec_cap as u64
    __string_buf_push_char_needs_grow_%out_ok = eq __string_buf_push_char_len_%out_ok, __string_buf_push_char_cap_%out_ok
    !__string_buf_push_char_view_%out_ok
    br __string_buf_push_char_needs_grow_%out_ok -> L_STRING_BUF_PUSH_CHAR_GROW_%out_ok, L_STRING_BUF_PUSH_CHAR_WRITE_%out_ok

L_STRING_BUF_PUSH_CHAR_GROW_%out_ok:
    EXPAND STRING_BUF_RESERVE %string_reg, 1
    jmp L_STRING_BUF_PUSH_CHAR_WRITE_%out_ok

L_STRING_BUF_PUSH_CHAR_WRITE_%out_ok:
    __string_buf_push_char_view2_%out_ok = & %string_reg
    __string_buf_push_char_ptr_%out_ok = load __string_buf_push_char_view2_%out_ok+Vec_ptr as ptr
    __string_buf_push_char_dst_%out_ok = ptr_add __string_buf_push_char_ptr_%out_ok, __string_buf_push_char_len_%out_ok
    store __string_buf_push_char_dst_%out_ok+0, %char_value as u8
    __string_buf_push_char_next_len_%out_ok = add __string_buf_push_char_len_%out_ok, 1
    store __string_buf_push_char_view2_%out_ok+Vec_len, __string_buf_push_char_next_len_%out_ok as u64
    %out_ok = add 0, 1
    !__string_buf_push_char_next_len_%out_ok
    !__string_buf_push_char_dst_%out_ok
    !__string_buf_push_char_ptr_%out_ok
    !__string_buf_push_char_view2_%out_ok
    !__string_buf_push_char_needs_grow_%out_ok
    !__string_buf_push_char_cap_%out_ok
    !__string_buf_push_char_len_%out_ok
    !__string_buf_push_char_ascii_%out_ok
    jmp L_STRING_BUF_PUSH_CHAR_END_%out_ok

L_STRING_BUF_PUSH_CHAR_MISS_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_push_char_ascii_%out_ok

L_STRING_BUF_PUSH_CHAR_END_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_PUSH_CHAR %string_reg, %char_value
    EXPAND STRING_BUF_TRY_PUSH_CHAR __string_buf_push_char_ok_%string_reg, %string_reg, %char_value
    !__string_buf_push_char_ok_%string_reg
[END_MACRO]

[MACRO] STRING_BUF_PUSH_STR %string_reg, %suffix_slice
    __string_buf_suffix_len_%string_reg = load %suffix_slice+Slice_len as u64
    EXPAND STRING_BUF_RESERVE %string_reg, __string_buf_suffix_len_%string_reg
    __string_buf_push_str_view_%string_reg = & %string_reg
    __string_buf_dst_buf_%string_reg = load __string_buf_push_str_view_%string_reg+Vec_ptr as ptr
    __string_buf_dst_len_%string_reg = load __string_buf_push_str_view_%string_reg+Vec_len as u64
    __string_buf_dst_ptr_%string_reg = ptr_add __string_buf_dst_buf_%string_reg, __string_buf_dst_len_%string_reg
    __string_buf_src_ptr_%string_reg = load %suffix_slice+Slice_ptr as ptr
    call @sa_mem_copy(&__string_buf_dst_ptr_%string_reg, &__string_buf_src_ptr_%string_reg, __string_buf_suffix_len_%string_reg)
    __string_buf_next_len_%string_reg = add __string_buf_dst_len_%string_reg, __string_buf_suffix_len_%string_reg
    store __string_buf_push_str_view_%string_reg+Vec_len, __string_buf_next_len_%string_reg as u64
    !__string_buf_next_len_%string_reg
    !__string_buf_src_ptr_%string_reg
    !__string_buf_dst_ptr_%string_reg
    !__string_buf_dst_len_%string_reg
    !__string_buf_dst_buf_%string_reg
    !__string_buf_push_str_view_%string_reg
    !__string_buf_suffix_len_%string_reg
[END_MACRO]

[MACRO] STRING_BUF_TRY_POP_BYTE %out_ok, %out_byte, %string_reg
    __string_buf_pop_view_%out_ok = & %string_reg
    __string_buf_pop_len_%out_ok = load __string_buf_pop_view_%out_ok+Vec_len as u64
    __string_buf_pop_empty_%out_ok = eq __string_buf_pop_len_%out_ok, 0
    br __string_buf_pop_empty_%out_ok -> L_STRING_BUF_POP_EMPTY_%out_ok, L_STRING_BUF_POP_HIT_%out_ok

L_STRING_BUF_POP_HIT_%out_ok:
    __string_buf_pop_ptr_%out_ok = load __string_buf_pop_view_%out_ok+Vec_ptr as ptr
    __string_buf_pop_last_%out_ok = sub __string_buf_pop_len_%out_ok, 1
    __string_buf_pop_byte_ptr_%out_ok = ptr_add __string_buf_pop_ptr_%out_ok, __string_buf_pop_last_%out_ok
    %out_byte = load __string_buf_pop_byte_ptr_%out_ok+0 as u8
    store __string_buf_pop_view_%out_ok+Vec_len, __string_buf_pop_last_%out_ok as u64
    %out_ok = add 0, 1
    !__string_buf_pop_byte_ptr_%out_ok
    !__string_buf_pop_last_%out_ok
    !__string_buf_pop_ptr_%out_ok
    !__string_buf_pop_empty_%out_ok
    !__string_buf_pop_len_%out_ok
    !__string_buf_pop_view_%out_ok
    jmp L_STRING_BUF_POP_END_%out_ok

L_STRING_BUF_POP_EMPTY_%out_ok:
    %out_byte = add 0, 0
    %out_ok = add 0, 0
    !__string_buf_pop_empty_%out_ok
    !__string_buf_pop_len_%out_ok
    !__string_buf_pop_view_%out_ok

L_STRING_BUF_POP_END_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_POP_BYTE %out_ok, %out_byte, %string_reg
    EXPAND STRING_BUF_TRY_POP_BYTE %out_ok, %out_byte, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_TRY_SPLIT_OFF %out_ok, %out_tail, %string_reg, %index
    EXPAND VEC_TRY_SPLIT_OFF %out_ok, %out_tail, %string_reg, %index, 1
[END_MACRO]

[MACRO] STRING_BUF_SPLIT_OFF %out_ok, %out_tail, %string_reg, %index
    EXPAND STRING_BUF_TRY_SPLIT_OFF %out_ok, %out_tail, %string_reg, %index
[END_MACRO]

[MACRO] STRING_BUF_TRY_INSERT_BYTE %out_ok, %string_reg, %index, %byte_value
    __string_buf_insert_view_%out_ok = & %string_reg
    __string_buf_insert_len_%out_ok = load __string_buf_insert_view_%out_ok+Vec_len as u64
    __string_buf_insert_in_bounds_%out_ok = ule %index, __string_buf_insert_len_%out_ok
    !__string_buf_insert_view_%out_ok
    br __string_buf_insert_in_bounds_%out_ok -> L_STRING_BUF_INSERT_GROW_%out_ok, L_STRING_BUF_INSERT_MISS_%out_ok

L_STRING_BUF_INSERT_GROW_%out_ok:
    EXPAND STRING_BUF_RESERVE %string_reg, 1
    __string_buf_insert_view2_%out_ok = & %string_reg
    __string_buf_insert_ptr_%out_ok = load __string_buf_insert_view2_%out_ok+Vec_ptr as ptr
    __string_buf_insert_pos_slot_%out_ok = stack_alloc 8
    store __string_buf_insert_pos_slot_%out_ok+0, __string_buf_insert_len_%out_ok as u64
    jmp L_STRING_BUF_INSERT_SHIFT_HEAD_%out_ok

L_STRING_BUF_INSERT_SHIFT_HEAD_%out_ok:
    __string_buf_insert_pos_%out_ok = load __string_buf_insert_pos_slot_%out_ok+0 as u64
    __string_buf_insert_more_%out_ok = ugt __string_buf_insert_pos_%out_ok, %index
    br __string_buf_insert_more_%out_ok -> L_STRING_BUF_INSERT_SHIFT_BODY_%out_ok, L_STRING_BUF_INSERT_STORE_%out_ok

L_STRING_BUF_INSERT_SHIFT_BODY_%out_ok:
    __string_buf_insert_prev_%out_ok = sub __string_buf_insert_pos_%out_ok, 1
    __string_buf_insert_prev_ptr_%out_ok = ptr_add __string_buf_insert_ptr_%out_ok, __string_buf_insert_prev_%out_ok
    __string_buf_insert_pos_ptr_%out_ok = ptr_add __string_buf_insert_ptr_%out_ok, __string_buf_insert_pos_%out_ok
    __string_buf_insert_move_byte_%out_ok = load __string_buf_insert_prev_ptr_%out_ok+0 as u8
    store __string_buf_insert_pos_ptr_%out_ok+0, __string_buf_insert_move_byte_%out_ok as u8
    store __string_buf_insert_pos_slot_%out_ok+0, __string_buf_insert_prev_%out_ok as u64
    !__string_buf_insert_move_byte_%out_ok
    !__string_buf_insert_pos_ptr_%out_ok
    !__string_buf_insert_prev_ptr_%out_ok
    !__string_buf_insert_prev_%out_ok
    !__string_buf_insert_more_%out_ok
    !__string_buf_insert_pos_%out_ok
    jmp L_STRING_BUF_INSERT_SHIFT_HEAD_%out_ok

L_STRING_BUF_INSERT_STORE_%out_ok:
    __string_buf_insert_dst_%out_ok = ptr_add __string_buf_insert_ptr_%out_ok, %index
    store __string_buf_insert_dst_%out_ok+0, %byte_value as u8
    __string_buf_insert_next_len_%out_ok = add __string_buf_insert_len_%out_ok, 1
    store __string_buf_insert_view2_%out_ok+Vec_len, __string_buf_insert_next_len_%out_ok as u64
    %out_ok = add 0, 1
    !__string_buf_insert_next_len_%out_ok
    !__string_buf_insert_dst_%out_ok
    !__string_buf_insert_more_%out_ok
    !__string_buf_insert_pos_%out_ok
    !__string_buf_insert_ptr_%out_ok
    !__string_buf_insert_view2_%out_ok
    !__string_buf_insert_in_bounds_%out_ok
    !__string_buf_insert_len_%out_ok
    jmp L_STRING_BUF_INSERT_END_%out_ok

L_STRING_BUF_INSERT_MISS_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_insert_in_bounds_%out_ok
    !__string_buf_insert_len_%out_ok

L_STRING_BUF_INSERT_END_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_TRY_INSERT_CHAR %out_ok, %string_reg, %index, %char_value
    __string_buf_insert_char_ascii_%out_ok = ult %char_value, 128
    br __string_buf_insert_char_ascii_%out_ok -> L_STRING_BUF_INSERT_CHAR_HIT_%out_ok, L_STRING_BUF_INSERT_CHAR_MISS_%out_ok

L_STRING_BUF_INSERT_CHAR_HIT_%out_ok:
    EXPAND STRING_BUF_TRY_INSERT_BYTE %out_ok, %string_reg, %index, %char_value
    !__string_buf_insert_char_ascii_%out_ok
    jmp L_STRING_BUF_INSERT_CHAR_END_%out_ok

L_STRING_BUF_INSERT_CHAR_MISS_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_insert_char_ascii_%out_ok

L_STRING_BUF_INSERT_CHAR_END_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_INSERT_CHAR %out_ok, %string_reg, %index, %char_value
