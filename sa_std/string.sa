[MACRO] STR_TRY_SPLIT_BYTE_AT %out_ok, %out_part, %slice_reg, %byte_value, %part_index
    %out_part = alloc Slice_SIZE
    __str_split_byte_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
