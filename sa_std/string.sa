    jmp L_STR_SPLIT_BYTE_HEAD_%out_ok

L_STR_SPLIT_BYTE_FINAL_%out_ok:
    __str_split_byte_current_final_%out_ok = load __str_split_byte_current_slot_%out_ok+0 as u64
    __str_split_byte_final_target_%out_ok = eq __str_split_byte_current_final_%out_ok, %part_index
    br __str_split_byte_final_target_%out_ok -> L_STR_SPLIT_BYTE_HIT_FINAL_%out_ok, L_STR_SPLIT_BYTE_MISS_%out_ok

L_STR_SPLIT_BYTE_HIT_FINAL_%out_ok:
    __str_split_byte_start_final_%out_ok = load __str_split_byte_start_slot_%out_ok+0 as u64
    __str_split_byte_final_len_%out_ok = sub __str_split_byte_len_%out_ok, __str_split_byte_start_final_%out_ok
    __str_split_byte_final_ptr_%out_ok = ptr_add __str_split_byte_ptr_%out_ok, __str_split_byte_start_final_%out_ok
    EXPAND SLICE_NEW %out_part, __str_split_byte_final_ptr_%out_ok, __str_split_byte_final_len_%out_ok
    %out_ok = add 0, 1
    !__str_split_byte_final_ptr_%out_ok
    !__str_split_byte_final_len_%out_ok
    !__str_split_byte_start_final_%out_ok
    !__str_split_byte_final_target_%out_ok
    !__str_split_byte_current_final_%out_ok
    !__str_split_byte_done_%out_ok
    !__str_split_byte_scan_%out_ok
    jmp L_STR_SPLIT_BYTE_END_%out_ok

L_STR_SPLIT_BYTE_MISS_%out_ok:
    __str_split_byte_empty_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_part, __str_split_byte_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_split_byte_empty_ptr_%out_ok
    !__str_split_byte_final_target_%out_ok
    !__str_split_byte_current_final_%out_ok
    !__str_split_byte_done_%out_ok
    !__str_split_byte_scan_%out_ok

L_STR_SPLIT_BYTE_END_%out_ok:
    !__str_split_byte_len_%out_ok
    !__str_split_byte_ptr_%out_ok
[END_MACRO]

[MACRO] STRING_TRY_SPLIT_BYTE_AT %out_ok, %out_part, %slice_reg, %byte_value, %part_index
    EXPAND STR_TRY_SPLIT_BYTE_AT %out_ok, %out_part, %slice_reg, %byte_value, %part_index
[END_MACRO]

[MACRO] STR_LINE_COUNT %out_count, %slice_reg
    __str_line_count_ptr_%out_count = load %slice_reg+Slice_ptr as ptr
    __str_line_count_len_%out_count = load %slice_reg+Slice_len as u64
    __str_line_count_idx_slot_%out_count = stack_alloc 8
    store __str_line_count_idx_slot_%out_count+0, 0 as u64
    %out_count = add 0, 0
    jmp L_STR_LINE_COUNT_HEAD_%out_count

L_STR_LINE_COUNT_HEAD_%out_count:
    __str_line_count_idx_%out_count = load __str_line_count_idx_slot_%out_count+0 as u64
    __str_line_count_done_%out_count = eq __str_line_count_idx_%out_count, __str_line_count_len_%out_count
    br __str_line_count_done_%out_count -> L_STR_LINE_COUNT_DONE_%out_count, L_STR_LINE_COUNT_BODY_%out_count

L_STR_LINE_COUNT_BODY_%out_count:
    __str_line_count_ip_%out_count = ptr_add __str_line_count_ptr_%out_count, __str_line_count_idx_%out_count
    __str_line_count_byte_%out_count = load __str_line_count_ip_%out_count+0 as u8
    __str_line_count_is_lf_%out_count = eq __str_line_count_byte_%out_count, 10
    br __str_line_count_is_lf_%out_count -> L_STR_LINE_COUNT_INC_%out_count, L_STR_LINE_COUNT_NEXT_%out_count

L_STR_LINE_COUNT_INC_%out_count:
    %out_count = add %out_count, 1
    jmp L_STR_LINE_COUNT_NEXT_%out_count

L_STR_LINE_COUNT_NEXT_%out_count:
    __str_line_count_next_%out_count = add __str_line_count_idx_%out_count, 1
    store __str_line_count_idx_slot_%out_count+0, __str_line_count_next_%out_count as u64
    !__str_line_count_next_%out_count
    !__str_line_count_is_lf_%out_count
    !__str_line_count_byte_%out_count
    !__str_line_count_ip_%out_count
    !__str_line_count_done_%out_count
    !__str_line_count_idx_%out_count
    jmp L_STR_LINE_COUNT_HEAD_%out_count

L_STR_LINE_COUNT_DONE_%out_count:
    __str_line_count_empty_%out_count = eq __str_line_count_len_%out_count, 0
    br __str_line_count_empty_%out_count -> L_STR_LINE_COUNT_EMPTY_%out_count, L_STR_LINE_COUNT_TRAILING_%out_count

L_STR_LINE_COUNT_TRAILING_%out_count:
    __str_line_count_last_idx_%out_count = sub __str_line_count_len_%out_count, 1
    __str_line_count_last_ip_%out_count = ptr_add __str_line_count_ptr_%out_count, __str_line_count_last_idx_%out_count
    __str_line_count_last_byte_%out_count = load __str_line_count_last_ip_%out_count+0 as u8
    __str_line_count_last_lf_%out_count = eq __str_line_count_last_byte_%out_count, 10
    br __str_line_count_last_lf_%out_count -> L_STR_LINE_COUNT_SKIP_FINAL_%out_count, L_STR_LINE_COUNT_ADD_FINAL_%out_count

L_STR_LINE_COUNT_SKIP_FINAL_%out_count:
    !__str_line_count_last_lf_%out_count
    !__str_line_count_last_byte_%out_count
    !__str_line_count_last_ip_%out_count
    !__str_line_count_last_idx_%out_count
    !__str_line_count_empty_%out_count
    jmp L_STR_LINE_COUNT_FINAL_%out_count

L_STR_LINE_COUNT_ADD_FINAL_%out_count:
    %out_count = add %out_count, 1
    !__str_line_count_last_lf_%out_count
    !__str_line_count_last_byte_%out_count
    !__str_line_count_last_ip_%out_count
    !__str_line_count_last_idx_%out_count
    !__str_line_count_empty_%out_count
    jmp L_STR_LINE_COUNT_FINAL_%out_count

L_STR_LINE_COUNT_EMPTY_%out_count:
    !__str_line_count_empty_%out_count
    jmp L_STR_LINE_COUNT_FINAL_%out_count

L_STR_LINE_COUNT_FINAL_%out_count:
    !__str_line_count_done_%out_count
    !__str_line_count_idx_%out_count
    !__str_line_count_len_%out_count
    !__str_line_count_ptr_%out_count
[END_MACRO]

[MACRO] STRING_LINE_COUNT %out_count, %slice_reg
    EXPAND STR_LINE_COUNT %out_count, %slice_reg
[END_MACRO]

[MACRO] STR_TRY_LINE_AT %out_ok, %out_line, %slice_reg, %line_index
    %out_line = alloc Slice_SIZE
    __str_line_at_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_line_at_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_line_at_scan_slot_%out_ok = stack_alloc 8
    __str_line_at_start_slot_%out_ok = stack_alloc 8
    __str_line_at_current_slot_%out_ok = stack_alloc 8
    __str_line_at_end_slot_%out_ok = stack_alloc 8
    store __str_line_at_scan_slot_%out_ok+0, 0 as u64
    store __str_line_at_start_slot_%out_ok+0, 0 as u64
    store __str_line_at_current_slot_%out_ok+0, 0 as u64
    store __str_line_at_end_slot_%out_ok+0, 0 as u64
    jmp L_STR_LINE_AT_HEAD_%out_ok

L_STR_LINE_AT_HEAD_%out_ok:
    __str_line_at_scan_%out_ok = load __str_line_at_scan_slot_%out_ok+0 as u64
    __str_line_at_done_%out_ok = eq __str_line_at_scan_%out_ok, __str_line_at_len_%out_ok
    br __str_line_at_done_%out_ok -> L_STR_LINE_AT_FINAL_CHECK_%out_ok, L_STR_LINE_AT_BODY_%out_ok

L_STR_LINE_AT_BODY_%out_ok:
    __str_line_at_ip_%out_ok = ptr_add __str_line_at_ptr_%out_ok, __str_line_at_scan_%out_ok
    __str_line_at_byte_%out_ok = load __str_line_at_ip_%out_ok+0 as u8
    __str_line_at_is_lf_%out_ok = eq __str_line_at_byte_%out_ok, 10
    br __str_line_at_is_lf_%out_ok -> L_STR_LINE_AT_TERM_%out_ok, L_STR_LINE_AT_NEXT_%out_ok

L_STR_LINE_AT_NEXT_%out_ok:
    __str_line_at_next_%out_ok = add __str_line_at_scan_%out_ok, 1
    store __str_line_at_scan_slot_%out_ok+0, __str_line_at_next_%out_ok as u64
    !__str_line_at_next_%out_ok
    !__str_line_at_is_lf_%out_ok
    !__str_line_at_byte_%out_ok
    !__str_line_at_ip_%out_ok
    !__str_line_at_done_%out_ok
    !__str_line_at_scan_%out_ok
    jmp L_STR_LINE_AT_HEAD_%out_ok

L_STR_LINE_AT_TERM_%out_ok:
    __str_line_at_current_%out_ok = load __str_line_at_current_slot_%out_ok+0 as u64
    __str_line_at_target_%out_ok = eq __str_line_at_current_%out_ok, %line_index
    br __str_line_at_target_%out_ok -> L_STR_LINE_AT_HIT_TERM_%out_ok, L_STR_LINE_AT_ADVANCE_%out_ok

L_STR_LINE_AT_HIT_TERM_%out_ok:
    __str_line_at_start_%out_ok = load __str_line_at_start_slot_%out_ok+0 as u64
    store __str_line_at_end_slot_%out_ok+0, __str_line_at_scan_%out_ok as u64
    __str_line_at_has_prev_%out_ok = ugt __str_line_at_scan_%out_ok, __str_line_at_start_%out_ok
    br __str_line_at_has_prev_%out_ok -> L_STR_LINE_AT_CR_CHECK_%out_ok, L_STR_LINE_AT_MAKE_TERM_%out_ok

L_STR_LINE_AT_CR_CHECK_%out_ok:
    __str_line_at_prev_%out_ok = sub __str_line_at_scan_%out_ok, 1
    __str_line_at_prev_ip_%out_ok = ptr_add __str_line_at_ptr_%out_ok, __str_line_at_prev_%out_ok
    __str_line_at_prev_byte_%out_ok = load __str_line_at_prev_ip_%out_ok+0 as u8
    __str_line_at_is_cr_%out_ok = eq __str_line_at_prev_byte_%out_ok, 13
    br __str_line_at_is_cr_%out_ok -> L_STR_LINE_AT_DROP_CR_%out_ok, L_STR_LINE_AT_KEEP_END_%out_ok

L_STR_LINE_AT_DROP_CR_%out_ok:
    store __str_line_at_end_slot_%out_ok+0, __str_line_at_prev_%out_ok as u64
    !__str_line_at_is_cr_%out_ok
    !__str_line_at_prev_byte_%out_ok
    !__str_line_at_prev_ip_%out_ok
    !__str_line_at_prev_%out_ok
    jmp L_STR_LINE_AT_MAKE_TERM_%out_ok

L_STR_LINE_AT_KEEP_END_%out_ok:
    !__str_line_at_is_cr_%out_ok
    !__str_line_at_prev_byte_%out_ok
    !__str_line_at_prev_ip_%out_ok
    !__str_line_at_prev_%out_ok
    jmp L_STR_LINE_AT_MAKE_TERM_%out_ok

L_STR_LINE_AT_MAKE_TERM_%out_ok:
    __str_line_at_end_%out_ok = load __str_line_at_end_slot_%out_ok+0 as u64
    __str_line_at_line_len_%out_ok = sub __str_line_at_end_%out_ok, __str_line_at_start_%out_ok
    __str_line_at_line_ptr_%out_ok = ptr_add __str_line_at_ptr_%out_ok, __str_line_at_start_%out_ok
    EXPAND SLICE_NEW %out_line, __str_line_at_line_ptr_%out_ok, __str_line_at_line_len_%out_ok
    %out_ok = add 0, 1
    !__str_line_at_line_ptr_%out_ok
    !__str_line_at_line_len_%out_ok
    !__str_line_at_end_%out_ok
    !__str_line_at_has_prev_%out_ok
    !__str_line_at_start_%out_ok
    !__str_line_at_target_%out_ok
    !__str_line_at_current_%out_ok
    !__str_line_at_is_lf_%out_ok
    !__str_line_at_byte_%out_ok
    !__str_line_at_ip_%out_ok
    !__str_line_at_done_%out_ok
    !__str_line_at_scan_%out_ok
    jmp L_STR_LINE_AT_END_%out_ok

L_STR_LINE_AT_ADVANCE_%out_ok:
    __str_line_at_next_line_%out_ok = add __str_line_at_current_%out_ok, 1
    __str_line_at_after_lf_%out_ok = add __str_line_at_scan_%out_ok, 1
    store __str_line_at_current_slot_%out_ok+0, __str_line_at_next_line_%out_ok as u64
    store __str_line_at_start_slot_%out_ok+0, __str_line_at_after_lf_%out_ok as u64
    store __str_line_at_scan_slot_%out_ok+0, __str_line_at_after_lf_%out_ok as u64
    !__str_line_at_after_lf_%out_ok
    !__str_line_at_next_line_%out_ok
    !__str_line_at_target_%out_ok
    !__str_line_at_current_%out_ok
    !__str_line_at_is_lf_%out_ok
    !__str_line_at_byte_%out_ok
    !__str_line_at_ip_%out_ok
    !__str_line_at_done_%out_ok
    !__str_line_at_scan_%out_ok
    jmp L_STR_LINE_AT_HEAD_%out_ok

L_STR_LINE_AT_FINAL_CHECK_%out_ok:
    __str_line_at_start_final_%out_ok = load __str_line_at_start_slot_%out_ok+0 as u64
    __str_line_at_has_final_%out_ok = ult __str_line_at_start_final_%out_ok, __str_line_at_len_%out_ok
    br __str_line_at_has_final_%out_ok -> L_STR_LINE_AT_FINAL_TARGET_%out_ok, L_STR_LINE_AT_MISS_NO_FINAL_%out_ok

L_STR_LINE_AT_FINAL_TARGET_%out_ok:
    __str_line_at_current_final_%out_ok = load __str_line_at_current_slot_%out_ok+0 as u64
    __str_line_at_final_target_%out_ok = eq __str_line_at_current_final_%out_ok, %line_index
    br __str_line_at_final_target_%out_ok -> L_STR_LINE_AT_HIT_FINAL_%out_ok, L_STR_LINE_AT_MISS_FINAL_%out_ok

L_STR_LINE_AT_HIT_FINAL_%out_ok:
    __str_line_at_final_len_%out_ok = sub __str_line_at_len_%out_ok, __str_line_at_start_final_%out_ok
    __str_line_at_final_ptr_%out_ok = ptr_add __str_line_at_ptr_%out_ok, __str_line_at_start_final_%out_ok
    EXPAND SLICE_NEW %out_line, __str_line_at_final_ptr_%out_ok, __str_line_at_final_len_%out_ok
    %out_ok = add 0, 1
    !__str_line_at_final_ptr_%out_ok
    !__str_line_at_final_len_%out_ok
    !__str_line_at_final_target_%out_ok
    !__str_line_at_current_final_%out_ok
    !__str_line_at_has_final_%out_ok
    !__str_line_at_start_final_%out_ok
    !__str_line_at_done_%out_ok
    !__str_line_at_scan_%out_ok
    jmp L_STR_LINE_AT_END_%out_ok

L_STR_LINE_AT_MISS_FINAL_%out_ok:
    !__str_line_at_final_target_%out_ok
    !__str_line_at_current_final_%out_ok
    !__str_line_at_has_final_%out_ok
    !__str_line_at_start_final_%out_ok
    jmp L_STR_LINE_AT_MISS_%out_ok

L_STR_LINE_AT_MISS_NO_FINAL_%out_ok:
    !__str_line_at_has_final_%out_ok
    !__str_line_at_start_final_%out_ok
    jmp L_STR_LINE_AT_MISS_%out_ok

L_STR_LINE_AT_MISS_%out_ok:
    __str_line_at_empty_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_line, __str_line_at_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_line_at_empty_ptr_%out_ok
    !__str_line_at_done_%out_ok
    !__str_line_at_scan_%out_ok

L_STR_LINE_AT_END_%out_ok:
    !__str_line_at_len_%out_ok
    !__str_line_at_ptr_%out_ok
[END_MACRO]

[MACRO] STRING_TRY_LINE_AT %out_ok, %out_line, %slice_reg, %line_index
    EXPAND STR_TRY_LINE_AT %out_ok, %out_line, %slice_reg, %line_index
[END_MACRO]

[MACRO] STR_TRY_RFIND %out_ok, %out_index, %slice_reg, %needle_slice
    __str_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_needle_ptr_%out_ok = load %needle_slice+Slice_ptr as ptr
    __str_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_idx_slot_%out_ok = stack_alloc 8
    __str_inner_slot_%out_ok = stack_alloc 8
    store __str_idx_slot_%out_ok+0, 0 as u64
    store __str_inner_slot_%out_ok+0, 0 as u64
    __str_empty_needle_%out_ok = eq __str_needle_len_%out_ok, 0
    br __str_empty_needle_%out_ok -> L_STR_RFIND_EMPTY_%out_ok, L_STR_RFIND_CHECK_%out_ok

L_STR_RFIND_EMPTY_%out_ok:
    %out_ok = add 0, 1
    %out_index = add __str_len_%out_ok, 0
    !__str_empty_needle_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_needle_ptr_%out_ok
    !__str_ptr_%out_ok
    jmp L_STR_RFIND_END_%out_ok

L_STR_RFIND_CHECK_%out_ok:
    __str_can_match_%out_ok = ule __str_needle_len_%out_ok, __str_len_%out_ok
    br __str_can_match_%out_ok -> L_STR_RFIND_INIT_%out_ok, L_STR_RFIND_MISS_%out_ok

L_STR_RFIND_INIT_%out_ok:
    __str_last_start_%out_ok = sub __str_len_%out_ok, __str_needle_len_%out_ok
    store __str_idx_slot_%out_ok+0, __str_last_start_%out_ok as u64
    !__str_can_match_%out_ok
    !__str_empty_needle_%out_ok
    jmp L_STR_RFIND_HEAD_%out_ok

L_STR_RFIND_HEAD_%out_ok:
    __str_idx_%out_ok = load __str_idx_slot_%out_ok+0 as u64
    store __str_inner_slot_%out_ok+0, 0 as u64
    jmp L_STR_RFIND_INNER_HEAD_%out_ok

L_STR_RFIND_INNER_HEAD_%out_ok:
    __str_inner_%out_ok = load __str_inner_slot_%out_ok+0 as u64
    __str_inner_done_%out_ok = eq __str_inner_%out_ok, __str_needle_len_%out_ok
    br __str_inner_done_%out_ok -> L_STR_RFIND_HIT_%out_ok, L_STR_RFIND_BODY_%out_ok

L_STR_RFIND_BODY_%out_ok:
    __str_hay_off_%out_ok = add __str_idx_%out_ok, __str_inner_%out_ok
    __str_hay_ip_%out_ok = ptr_add __str_ptr_%out_ok, __str_hay_off_%out_ok
    __str_needle_ip_%out_ok = ptr_add __str_needle_ptr_%out_ok, __str_inner_%out_ok
    __str_hay_byte_%out_ok = load __str_hay_ip_%out_ok+0 as u8
    __str_needle_byte_%out_ok = load __str_needle_ip_%out_ok+0 as u8
    __str_match_%out_ok = eq __str_hay_byte_%out_ok, __str_needle_byte_%out_ok
    br __str_match_%out_ok -> L_STR_RFIND_INNER_NEXT_%out_ok, L_STR_RFIND_NEXT_%out_ok

L_STR_RFIND_INNER_NEXT_%out_ok:
    __str_inner_next_%out_ok = add __str_inner_%out_ok, 1
    store __str_inner_slot_%out_ok+0, __str_inner_next_%out_ok as u64
    !__str_inner_next_%out_ok
    !__str_match_%out_ok
    !__str_needle_byte_%out_ok
    !__str_hay_byte_%out_ok
    !__str_needle_ip_%out_ok
    !__str_hay_ip_%out_ok
    !__str_hay_off_%out_ok
    !__str_inner_done_%out_ok
    !__str_inner_%out_ok
    jmp L_STR_RFIND_INNER_HEAD_%out_ok

L_STR_RFIND_NEXT_%out_ok:
    __str_is_zero_%out_ok = eq __str_idx_%out_ok, 0
    br __str_is_zero_%out_ok -> L_STR_RFIND_MISS_LOOP_%out_ok, L_STR_RFIND_DEC_%out_ok

L_STR_RFIND_DEC_%out_ok:
    __str_prev_%out_ok = sub __str_idx_%out_ok, 1
    store __str_idx_slot_%out_ok+0, __str_prev_%out_ok as u64
    !__str_prev_%out_ok
    !__str_is_zero_%out_ok
    !__str_match_%out_ok
    !__str_needle_byte_%out_ok
    !__str_hay_byte_%out_ok
    !__str_needle_ip_%out_ok
    !__str_hay_ip_%out_ok
    !__str_hay_off_%out_ok
    !__str_inner_done_%out_ok
    !__str_inner_%out_ok
    !__str_idx_%out_ok
    jmp L_STR_RFIND_HEAD_%out_ok

L_STR_RFIND_HIT_%out_ok:
    %out_ok = add 0, 1
    %out_index = add __str_idx_%out_ok, 0
    !__str_inner_done_%out_ok
    !__str_inner_%out_ok
    !__str_idx_%out_ok
    !__str_last_start_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_needle_ptr_%out_ok
    !__str_ptr_%out_ok
    jmp L_STR_RFIND_END_%out_ok

L_STR_RFIND_MISS_LOOP_%out_ok:
    %out_ok = add 0, 0
    %out_index = add 0, 0
    !__str_is_zero_%out_ok
    !__str_match_%out_ok
    !__str_needle_byte_%out_ok
    !__str_hay_byte_%out_ok
    !__str_needle_ip_%out_ok
    !__str_hay_ip_%out_ok
    !__str_hay_off_%out_ok
    !__str_inner_done_%out_ok
    !__str_inner_%out_ok
    !__str_idx_%out_ok
    !__str_last_start_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_needle_ptr_%out_ok
    !__str_ptr_%out_ok
    jmp L_STR_RFIND_END_%out_ok

L_STR_RFIND_MISS_%out_ok:
    %out_ok = add 0, 0
    %out_index = add 0, 0
