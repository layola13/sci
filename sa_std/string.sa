[END_MACRO]

[MACRO] STR_EMPTY %out_slice
    __str_empty_ptr_%out_slice = 0 as ptr
    EXPAND STR_FROM_PARTS %out_slice, __str_empty_ptr_%out_slice, 0
    !__str_empty_ptr_%out_slice
[END_MACRO]

[MACRO] STR_SLICE %out_slice, %src_slice, %start, %length
    __str_src_ptr_%out_slice = load %src_slice+Slice_ptr as ptr
    __str_start_ptr_%out_slice = ptr_add __str_src_ptr_%out_slice, %start
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_start_ptr_%out_slice, %length
    !__str_src_ptr_%out_slice
    !__str_start_ptr_%out_slice
[END_MACRO]

[MACRO] STR_EQ %out_bool, %left_slice, %right_slice
    left_ptr_%out_bool = load %left_slice+Slice_ptr as ptr
    right_ptr_%out_bool = load %right_slice+Slice_ptr as ptr
    left_len_%out_bool = load %left_slice+Slice_len as u64
    right_len_%out_bool = load %right_slice+Slice_len as u64
    same_len_%out_bool = eq left_len_%out_bool, right_len_%out_bool
    idx_slot_%out_bool = stack_alloc 8
    store idx_slot_%out_bool+0, 0 as u64
    br same_len_%out_bool -> L_STR_EQ_HEAD_%out_bool, L_STR_EQ_NE_%out_bool
L_STR_EQ_LOOP_%out_bool:
    jmp L_STR_EQ_HEAD_%out_bool
L_STR_EQ_HEAD_%out_bool:
    idx_%out_bool = load idx_slot_%out_bool+0 as u64
    done_%out_bool = eq idx_%out_bool, left_len_%out_bool
    br done_%out_bool -> L_STR_EQ_TRUE_%out_bool, L_STR_EQ_BODY_%out_bool
L_STR_EQ_BODY_%out_bool:
    left_ip_%out_bool = ptr_add left_ptr_%out_bool, idx_%out_bool
    right_ip_%out_bool = ptr_add right_ptr_%out_bool, idx_%out_bool
    left_byte_%out_bool = load left_ip_%out_bool+0 as u8
    right_byte_%out_bool = load right_ip_%out_bool+0 as u8
    bytes_eq_%out_bool = eq left_byte_%out_bool, right_byte_%out_bool
    !left_byte_%out_bool
    !right_byte_%out_bool
    !left_ip_%out_bool
    !right_ip_%out_bool
    br bytes_eq_%out_bool -> L_STR_EQ_NEXT_%out_bool, L_STR_EQ_FALSE_%out_bool
L_STR_EQ_NEXT_%out_bool:
    next_idx_%out_bool = add idx_%out_bool, 1
    store idx_slot_%out_bool+0, next_idx_%out_bool as u64
    !idx_%out_bool
    !done_%out_bool
    !bytes_eq_%out_bool
    !next_idx_%out_bool
    jmp L_STR_EQ_HEAD_%out_bool
L_STR_EQ_TRUE_%out_bool:
    %out_bool = add 0, 1
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
    jmp L_STR_EQ_END_%out_bool
L_STR_EQ_FALSE_%out_bool:
    %out_bool = add 0, 0
    !bytes_eq_%out_bool
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
    jmp L_STR_EQ_END_%out_bool
L_STR_EQ_NE_%out_bool:
    %out_bool = add 0, 0
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
L_STR_EQ_END_%out_bool:
[END_MACRO]

[MACRO] STR_CONTAINS %out_bool, %slice_reg, %needle_slice
    __str_ptr_%out_bool = load %slice_reg+Slice_ptr as ptr
    __str_needle_ptr_%out_bool = load %needle_slice+Slice_ptr as ptr
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    __str_needle_len_%out_bool = load %needle_slice+Slice_len as u64
    __str_idx_slot_%out_bool = stack_alloc 8
    __str_inner_slot_%out_bool = stack_alloc 8
    store __str_idx_slot_%out_bool+0, 0 as u64
    store __str_inner_slot_%out_bool+0, 0 as u64
    __str_empty_needle_%out_bool = eq __str_needle_len_%out_bool, 0
    br __str_empty_needle_%out_bool -> L_STR_CONTAINS_TRUE_EMPTY_%out_bool, L_STR_CONTAINS_CHECK_%out_bool

L_STR_CONTAINS_TRUE_EMPTY_%out_bool:
    %out_bool = add 0, 1
    !__str_empty_needle_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_CHECK_%out_bool:
    __str_can_match_%out_bool = ule __str_needle_len_%out_bool, __str_len_%out_bool
    br __str_can_match_%out_bool -> L_STR_CONTAINS_INIT_%out_bool, L_STR_CONTAINS_FALSE_%out_bool

L_STR_CONTAINS_INIT_%out_bool:
    __str_last_start_%out_bool = sub __str_len_%out_bool, __str_needle_len_%out_bool
    store __str_idx_slot_%out_bool+0, 0 as u64
    !__str_can_match_%out_bool
    !__str_empty_needle_%out_bool
    jmp L_STR_CONTAINS_HEAD_%out_bool

L_STR_CONTAINS_HEAD_%out_bool:
    __str_idx_%out_bool = load __str_idx_slot_%out_bool+0 as u64
    __str_after_last_%out_bool = ugt __str_idx_%out_bool, __str_last_start_%out_bool
    br __str_after_last_%out_bool -> L_STR_CONTAINS_FALSE_LOOP_%out_bool, L_STR_CONTAINS_INNER_INIT_%out_bool

L_STR_CONTAINS_INNER_INIT_%out_bool:
    store __str_inner_slot_%out_bool+0, 0 as u64
    !__str_after_last_%out_bool
    jmp L_STR_CONTAINS_INNER_HEAD_%out_bool

L_STR_CONTAINS_INNER_HEAD_%out_bool:
    __str_inner_%out_bool = load __str_inner_slot_%out_bool+0 as u64
    __str_inner_done_%out_bool = eq __str_inner_%out_bool, __str_needle_len_%out_bool
    br __str_inner_done_%out_bool -> L_STR_CONTAINS_TRUE_%out_bool, L_STR_CONTAINS_BODY_%out_bool

L_STR_CONTAINS_BODY_%out_bool:
    __str_hay_off_%out_bool = add __str_idx_%out_bool, __str_inner_%out_bool
    __str_hay_ip_%out_bool = ptr_add __str_ptr_%out_bool, __str_hay_off_%out_bool
    __str_needle_ip_%out_bool = ptr_add __str_needle_ptr_%out_bool, __str_inner_%out_bool
    __str_hay_byte_%out_bool = load __str_hay_ip_%out_bool+0 as u8
    __str_needle_byte_%out_bool = load __str_needle_ip_%out_bool+0 as u8
    __str_match_%out_bool = eq __str_hay_byte_%out_bool, __str_needle_byte_%out_bool
    br __str_match_%out_bool -> L_STR_CONTAINS_INNER_NEXT_%out_bool, L_STR_CONTAINS_NEXT_%out_bool

L_STR_CONTAINS_INNER_NEXT_%out_bool:
    __str_inner_next_%out_bool = add __str_inner_%out_bool, 1
    store __str_inner_slot_%out_bool+0, __str_inner_next_%out_bool as u64
    !__str_inner_next_%out_bool
    !__str_match_%out_bool
    !__str_needle_byte_%out_bool
    !__str_hay_byte_%out_bool
    !__str_needle_ip_%out_bool
    !__str_hay_ip_%out_bool
    !__str_hay_off_%out_bool
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    jmp L_STR_CONTAINS_INNER_HEAD_%out_bool

L_STR_CONTAINS_NEXT_%out_bool:
    __str_next_%out_bool = add __str_idx_%out_bool, 1
    store __str_idx_slot_%out_bool+0, __str_next_%out_bool as u64
    !__str_next_%out_bool
    !__str_match_%out_bool
    !__str_needle_byte_%out_bool
    !__str_hay_byte_%out_bool
    !__str_needle_ip_%out_bool
    !__str_hay_ip_%out_bool
    !__str_hay_off_%out_bool
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    !__str_idx_%out_bool
    jmp L_STR_CONTAINS_HEAD_%out_bool

L_STR_CONTAINS_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    !__str_idx_%out_bool
    !__str_last_start_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_FALSE_LOOP_%out_bool:
    %out_bool = add 0, 0
    !__str_after_last_%out_bool
    !__str_idx_%out_bool
    !__str_last_start_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_FALSE_%out_bool:
    %out_bool = add 0, 0
    !__str_can_match_%out_bool
    !__str_empty_needle_%out_bool
