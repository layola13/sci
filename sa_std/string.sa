[MACRO] STR_TRY_SPLIT_AT %out_ok, %out_left, %out_right, %slice_reg, %mid
    %out_left = alloc Slice_SIZE
    %out_right = alloc Slice_SIZE
    __str_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_in_bounds_%out_ok = ule %mid, __str_len_%out_ok
    br __str_in_bounds_%out_ok -> L_STR_SPLIT_AT_HIT_%out_ok, L_STR_SPLIT_AT_MISS_%out_ok

L_STR_SPLIT_AT_HIT_%out_ok:
    __str_src_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_right_len_%out_ok = sub __str_len_%out_ok, %mid
    __str_right_ptr_%out_ok = ptr_add __str_src_ptr_%out_ok, %mid
    EXPAND SLICE_NEW %out_left, __str_src_ptr_%out_ok, %mid
    EXPAND SLICE_NEW %out_right, __str_right_ptr_%out_ok, __str_right_len_%out_ok
    %out_ok = add 0, 1
    !__str_right_ptr_%out_ok
    !__str_right_len_%out_ok
    !__str_src_ptr_%out_ok
    !__str_in_bounds_%out_ok
    !__str_len_%out_ok
    jmp L_STR_SPLIT_AT_END_%out_ok

L_STR_SPLIT_AT_MISS_%out_ok:
    __str_empty_ptr_%out_ok = 0 as ptr
    EXPAND SLICE_NEW %out_left, __str_empty_ptr_%out_ok, 0
    EXPAND SLICE_NEW %out_right, __str_empty_ptr_%out_ok, 0
    %out_ok = add 0, 0
    !__str_empty_ptr_%out_ok
    !__str_in_bounds_%out_ok
    !__str_len_%out_ok

L_STR_SPLIT_AT_END_%out_ok:
[END_MACRO]

[MACRO] STRING_TRY_SPLIT_AT %out_ok, %out_left, %out_right, %slice_reg, %mid
    EXPAND STR_TRY_SPLIT_AT %out_ok, %out_left, %out_right, %slice_reg, %mid
[END_MACRO]

[MACRO] STR_CONCAT %out_slice, %left_slice, %right_slice
    __str_left_ptr_%out_slice = load %left_slice+Slice_ptr as ptr
    __str_right_ptr_%out_slice = load %right_slice+Slice_ptr as ptr
    __str_left_len_%out_slice = load %left_slice+Slice_len as u64
    __str_right_len_%out_slice = load %right_slice+Slice_len as u64
    __str_total_len_%out_slice = add __str_left_len_%out_slice, __str_right_len_%out_slice
    __str_out_buf_%out_slice = call @sa_string_concat(__str_left_ptr_%out_slice, __str_left_len_%out_slice, __str_right_ptr_%out_slice, __str_right_len_%out_slice)
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_out_buf_%out_slice, __str_total_len_%out_slice
    !__str_left_ptr_%out_slice
    !__str_right_ptr_%out_slice
    !__str_left_len_%out_slice
    !__str_right_len_%out_slice
    !__str_total_len_%out_slice
    !__str_out_buf_%out_slice
[END_MACRO]
