[MACRO] STRING_BUF_TRY_INSERT_STR %out_ok, %string_reg, %index, %insert_slice
    __string_buf_insert_str_len_%out_ok = load %insert_slice+Slice_len as u64
    __string_buf_insert_str_view_%out_ok = & %string_reg
    __string_buf_insert_str_old_len_%out_ok = load __string_buf_insert_str_view_%out_ok+Vec_len as u64
    __string_buf_insert_str_in_bounds_%out_ok = ule %index, __string_buf_insert_str_old_len_%out_ok
    br __string_buf_insert_str_in_bounds_%out_ok -> L_STRING_BUF_INSERT_STR_HIT_%out_ok, L_STRING_BUF_INSERT_STR_MISS_%out_ok

L_STRING_BUF_INSERT_STR_HIT_%out_ok:
    __string_buf_insert_str_old_ptr_%out_ok = load __string_buf_insert_str_view_%out_ok+Vec_ptr as ptr
    __string_buf_insert_str_suffix_len_%out_ok = sub __string_buf_insert_str_old_len_%out_ok, %index
    __string_buf_insert_str_new_len_%out_ok = add __string_buf_insert_str_old_len_%out_ok, __string_buf_insert_str_len_%out_ok
    EXPAND STRING_BUF_WITH_CAPACITY __string_buf_insert_str_new_%out_ok, __string_buf_insert_str_new_len_%out_ok
    __string_buf_insert_str_prefix_%out_ok = alloc Slice_SIZE
    EXPAND SLICE_NEW __string_buf_insert_str_prefix_%out_ok, __string_buf_insert_str_old_ptr_%out_ok, %index
    __string_buf_insert_str_suffix_ptr_%out_ok = ptr_add __string_buf_insert_str_old_ptr_%out_ok, %index
    __string_buf_insert_str_suffix_%out_ok = alloc Slice_SIZE
    EXPAND SLICE_NEW __string_buf_insert_str_suffix_%out_ok, __string_buf_insert_str_suffix_ptr_%out_ok, __string_buf_insert_str_suffix_len_%out_ok
    EXPAND STRING_BUF_PUSH_STR __string_buf_insert_str_new_%out_ok, __string_buf_insert_str_prefix_%out_ok
    EXPAND STRING_BUF_PUSH_STR __string_buf_insert_str_new_%out_ok, %insert_slice
    EXPAND STRING_BUF_PUSH_STR __string_buf_insert_str_new_%out_ok, __string_buf_insert_str_suffix_%out_ok
    EXPAND VEC_FREE %string_reg
    %string_reg = __string_buf_insert_str_new_%out_ok
    %out_ok = add 0, 1
    !__string_buf_insert_str_suffix_%out_ok
    !__string_buf_insert_str_suffix_ptr_%out_ok
    !__string_buf_insert_str_prefix_%out_ok
    !__string_buf_insert_str_new_len_%out_ok
    !__string_buf_insert_str_suffix_len_%out_ok
    !__string_buf_insert_str_old_ptr_%out_ok
    !__string_buf_insert_str_in_bounds_%out_ok
    !__string_buf_insert_str_old_len_%out_ok
    !__string_buf_insert_str_view_%out_ok
    !__string_buf_insert_str_len_%out_ok
    jmp L_STRING_BUF_INSERT_STR_END_%out_ok

L_STRING_BUF_INSERT_STR_MISS_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_insert_str_in_bounds_%out_ok
    !__string_buf_insert_str_old_len_%out_ok
    !__string_buf_insert_str_view_%out_ok
    !__string_buf_insert_str_len_%out_ok

L_STRING_BUF_INSERT_STR_END_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_INSERT_STR %out_ok, %string_reg, %index, %insert_slice
    EXPAND STRING_BUF_TRY_INSERT_STR %out_ok, %string_reg, %index, %insert_slice
[END_MACRO]

[MACRO] STRING_BUF_TRY_REPLACE_RANGE %out_ok, %string_reg, %start, %length, %replace_slice
    __string_buf_replace_view_%out_ok = & %string_reg
    __string_buf_replace_old_len_%out_ok = load __string_buf_replace_view_%out_ok+Vec_len as u64
    __string_buf_replace_start_ok_%out_ok = ule %start, __string_buf_replace_old_len_%out_ok
    br __string_buf_replace_start_ok_%out_ok -> L_STRING_BUF_REPLACE_LEN_CHECK_%out_ok, L_STRING_BUF_REPLACE_MISS_START_%out_ok

L_STRING_BUF_REPLACE_LEN_CHECK_%out_ok:
    __string_buf_replace_remaining_%out_ok = sub __string_buf_replace_old_len_%out_ok, %start
    __string_buf_replace_len_ok_%out_ok = ule %length, __string_buf_replace_remaining_%out_ok
    br __string_buf_replace_len_ok_%out_ok -> L_STRING_BUF_REPLACE_HIT_%out_ok, L_STRING_BUF_REPLACE_MISS_LEN_%out_ok

L_STRING_BUF_REPLACE_HIT_%out_ok:
    __string_buf_replace_old_ptr_%out_ok = load __string_buf_replace_view_%out_ok+Vec_ptr as ptr
    __string_buf_replace_text_len_%out_ok = load %replace_slice+Slice_len as u64
    __string_buf_replace_suffix_start_%out_ok = add %start, %length
    __string_buf_replace_suffix_len_%out_ok = sub __string_buf_replace_old_len_%out_ok, __string_buf_replace_suffix_start_%out_ok
    __string_buf_replace_prefix_plus_%out_ok = add %start, __string_buf_replace_text_len_%out_ok
    __string_buf_replace_new_len_%out_ok = add __string_buf_replace_prefix_plus_%out_ok, __string_buf_replace_suffix_len_%out_ok
    EXPAND STRING_BUF_WITH_CAPACITY __string_buf_replace_new_%out_ok, __string_buf_replace_new_len_%out_ok
    __string_buf_replace_prefix_%out_ok = alloc Slice_SIZE
    EXPAND SLICE_NEW __string_buf_replace_prefix_%out_ok, __string_buf_replace_old_ptr_%out_ok, %start
    __string_buf_replace_suffix_ptr_%out_ok = ptr_add __string_buf_replace_old_ptr_%out_ok, __string_buf_replace_suffix_start_%out_ok
    __string_buf_replace_suffix_%out_ok = alloc Slice_SIZE
    EXPAND SLICE_NEW __string_buf_replace_suffix_%out_ok, __string_buf_replace_suffix_ptr_%out_ok, __string_buf_replace_suffix_len_%out_ok
    EXPAND STRING_BUF_PUSH_STR __string_buf_replace_new_%out_ok, __string_buf_replace_prefix_%out_ok
    EXPAND STRING_BUF_PUSH_STR __string_buf_replace_new_%out_ok, %replace_slice
    EXPAND STRING_BUF_PUSH_STR __string_buf_replace_new_%out_ok, __string_buf_replace_suffix_%out_ok
    EXPAND VEC_FREE %string_reg
    %string_reg = __string_buf_replace_new_%out_ok
    %out_ok = add 0, 1
    !__string_buf_replace_suffix_%out_ok
    !__string_buf_replace_suffix_ptr_%out_ok
    !__string_buf_replace_prefix_%out_ok
    !__string_buf_replace_new_len_%out_ok
    !__string_buf_replace_prefix_plus_%out_ok
    !__string_buf_replace_suffix_len_%out_ok
    !__string_buf_replace_suffix_start_%out_ok
    !__string_buf_replace_text_len_%out_ok
    !__string_buf_replace_old_ptr_%out_ok
    !__string_buf_replace_len_ok_%out_ok
    !__string_buf_replace_remaining_%out_ok
    !__string_buf_replace_start_ok_%out_ok
    !__string_buf_replace_old_len_%out_ok
    !__string_buf_replace_view_%out_ok
    jmp L_STRING_BUF_REPLACE_END_%out_ok

L_STRING_BUF_REPLACE_MISS_LEN_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_replace_len_ok_%out_ok
    !__string_buf_replace_remaining_%out_ok
    !__string_buf_replace_start_ok_%out_ok
    !__string_buf_replace_old_len_%out_ok
    !__string_buf_replace_view_%out_ok
    jmp L_STRING_BUF_REPLACE_END_%out_ok

L_STRING_BUF_REPLACE_MISS_START_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_replace_start_ok_%out_ok
    !__string_buf_replace_old_len_%out_ok
    !__string_buf_replace_view_%out_ok

L_STRING_BUF_REPLACE_END_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_REPLACE_RANGE %out_ok, %string_reg, %start, %length, %replace_slice
    EXPAND STRING_BUF_TRY_REPLACE_RANGE %out_ok, %string_reg, %start, %length, %replace_slice
[END_MACRO]

[MACRO] STR_EMPTY %out_slice
    __str_empty_ptr_%out_slice = 0 as ptr
    EXPAND STR_FROM_PARTS %out_slice, __str_empty_ptr_%out_slice, 0
    !__str_empty_ptr_%out_slice
[END_MACRO]

[MACRO] STR_SLICE %out_slice, %src_slice, %start, %length
    __str_src_ptr_%out_slice = load %src_slice+Slice_ptr as ptr
    __str_start_ptr_%out_slice = ptr_add __str_src_ptr_%out_slice, %start
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_start_ptr_%out_slice, %length
    !__str_src_ptr_%out_slice
    !__str_start_ptr_%out_slice
[END_MACRO]

[MACRO] STR_EQ %out_bool, %left_slice, %right_slice
    left_ptr_%out_bool = load %left_slice+Slice_ptr as ptr
    right_ptr_%out_bool = load %right_slice+Slice_ptr as ptr
    left_len_%out_bool = load %left_slice+Slice_len as u64
    right_len_%out_bool = load %right_slice+Slice_len as u64
    same_len_%out_bool = eq left_len_%out_bool, right_len_%out_bool
    idx_slot_%out_bool = stack_alloc 8
    store idx_slot_%out_bool+0, 0 as u64
    br same_len_%out_bool -> L_STR_EQ_HEAD_%out_bool, L_STR_EQ_NE_%out_bool
L_STR_EQ_LOOP_%out_bool:
    jmp L_STR_EQ_HEAD_%out_bool
L_STR_EQ_HEAD_%out_bool:
    idx_%out_bool = load idx_slot_%out_bool+0 as u64
    done_%out_bool = eq idx_%out_bool, left_len_%out_bool
    br done_%out_bool -> L_STR_EQ_TRUE_%out_bool, L_STR_EQ_BODY_%out_bool
L_STR_EQ_BODY_%out_bool:
    left_ip_%out_bool = ptr_add left_ptr_%out_bool, idx_%out_bool
    right_ip_%out_bool = ptr_add right_ptr_%out_bool, idx_%out_bool
    left_byte_%out_bool = load left_ip_%out_bool+0 as u8
    right_byte_%out_bool = load right_ip_%out_bool+0 as u8
    bytes_eq_%out_bool = eq left_byte_%out_bool, right_byte_%out_bool
    !left_byte_%out_bool
    !right_byte_%out_bool
    !left_ip_%out_bool
    !right_ip_%out_bool
    br bytes_eq_%out_bool -> L_STR_EQ_NEXT_%out_bool, L_STR_EQ_FALSE_%out_bool
L_STR_EQ_NEXT_%out_bool:
    next_idx_%out_bool = add idx_%out_bool, 1
    store idx_slot_%out_bool+0, next_idx_%out_bool as u64
    !idx_%out_bool
    !done_%out_bool
    !bytes_eq_%out_bool
    !next_idx_%out_bool
    jmp L_STR_EQ_HEAD_%out_bool
L_STR_EQ_TRUE_%out_bool:
    %out_bool = add 0, 1
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
    jmp L_STR_EQ_END_%out_bool
L_STR_EQ_FALSE_%out_bool:
    %out_bool = add 0, 0
    !bytes_eq_%out_bool
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
    jmp L_STR_EQ_END_%out_bool
L_STR_EQ_NE_%out_bool:
    %out_bool = add 0, 0
    !left_ptr_%out_bool
    !right_ptr_%out_bool
    !left_len_%out_bool
    !right_len_%out_bool
    !same_len_%out_bool
L_STR_EQ_END_%out_bool:
[END_MACRO]

[MACRO] STR_CONTAINS %out_bool, %slice_reg, %needle_slice
    __str_ptr_%out_bool = load %slice_reg+Slice_ptr as ptr
    __str_needle_ptr_%out_bool = load %needle_slice+Slice_ptr as ptr
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    __str_needle_len_%out_bool = load %needle_slice+Slice_len as u64
    __str_idx_slot_%out_bool = stack_alloc 8
    __str_inner_slot_%out_bool = stack_alloc 8
    store __str_idx_slot_%out_bool+0, 0 as u64
    store __str_inner_slot_%out_bool+0, 0 as u64
    __str_empty_needle_%out_bool = eq __str_needle_len_%out_bool, 0
    br __str_empty_needle_%out_bool -> L_STR_CONTAINS_TRUE_EMPTY_%out_bool, L_STR_CONTAINS_CHECK_%out_bool

L_STR_CONTAINS_TRUE_EMPTY_%out_bool:
    %out_bool = add 0, 1
    !__str_empty_needle_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_CHECK_%out_bool:
    __str_can_match_%out_bool = ule __str_needle_len_%out_bool, __str_len_%out_bool
    br __str_can_match_%out_bool -> L_STR_CONTAINS_INIT_%out_bool, L_STR_CONTAINS_FALSE_%out_bool

L_STR_CONTAINS_INIT_%out_bool:
    __str_last_start_%out_bool = sub __str_len_%out_bool, __str_needle_len_%out_bool
    store __str_idx_slot_%out_bool+0, 0 as u64
    !__str_can_match_%out_bool
    !__str_empty_needle_%out_bool
    jmp L_STR_CONTAINS_HEAD_%out_bool

L_STR_CONTAINS_HEAD_%out_bool:
    __str_idx_%out_bool = load __str_idx_slot_%out_bool+0 as u64
    __str_after_last_%out_bool = ugt __str_idx_%out_bool, __str_last_start_%out_bool
    br __str_after_last_%out_bool -> L_STR_CONTAINS_FALSE_LOOP_%out_bool, L_STR_CONTAINS_INNER_INIT_%out_bool

L_STR_CONTAINS_INNER_INIT_%out_bool:
    store __str_inner_slot_%out_bool+0, 0 as u64
    !__str_after_last_%out_bool
    jmp L_STR_CONTAINS_INNER_HEAD_%out_bool

L_STR_CONTAINS_INNER_HEAD_%out_bool:
    __str_inner_%out_bool = load __str_inner_slot_%out_bool+0 as u64
    __str_inner_done_%out_bool = eq __str_inner_%out_bool, __str_needle_len_%out_bool
    br __str_inner_done_%out_bool -> L_STR_CONTAINS_TRUE_%out_bool, L_STR_CONTAINS_BODY_%out_bool

L_STR_CONTAINS_BODY_%out_bool:
    __str_hay_off_%out_bool = add __str_idx_%out_bool, __str_inner_%out_bool
    __str_hay_ip_%out_bool = ptr_add __str_ptr_%out_bool, __str_hay_off_%out_bool
    __str_needle_ip_%out_bool = ptr_add __str_needle_ptr_%out_bool, __str_inner_%out_bool
    __str_hay_byte_%out_bool = load __str_hay_ip_%out_bool+0 as u8
    __str_needle_byte_%out_bool = load __str_needle_ip_%out_bool+0 as u8
    __str_match_%out_bool = eq __str_hay_byte_%out_bool, __str_needle_byte_%out_bool
    br __str_match_%out_bool -> L_STR_CONTAINS_INNER_NEXT_%out_bool, L_STR_CONTAINS_NEXT_%out_bool

L_STR_CONTAINS_INNER_NEXT_%out_bool:
    __str_inner_next_%out_bool = add __str_inner_%out_bool, 1
    store __str_inner_slot_%out_bool+0, __str_inner_next_%out_bool as u64
    !__str_inner_next_%out_bool
    !__str_match_%out_bool
    !__str_needle_byte_%out_bool
    !__str_hay_byte_%out_bool
    !__str_needle_ip_%out_bool
    !__str_hay_ip_%out_bool
    !__str_hay_off_%out_bool
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    jmp L_STR_CONTAINS_INNER_HEAD_%out_bool

L_STR_CONTAINS_NEXT_%out_bool:
    __str_next_%out_bool = add __str_idx_%out_bool, 1
    store __str_idx_slot_%out_bool+0, __str_next_%out_bool as u64
    !__str_next_%out_bool
    !__str_match_%out_bool
    !__str_needle_byte_%out_bool
    !__str_hay_byte_%out_bool
    !__str_needle_ip_%out_bool
    !__str_hay_ip_%out_bool
    !__str_hay_off_%out_bool
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    !__str_idx_%out_bool
    jmp L_STR_CONTAINS_HEAD_%out_bool

L_STR_CONTAINS_TRUE_%out_bool:
    %out_bool = add 0, 1
    !__str_inner_done_%out_bool
    !__str_inner_%out_bool
    !__str_idx_%out_bool
    !__str_last_start_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_FALSE_LOOP_%out_bool:
    %out_bool = add 0, 0
    !__str_after_last_%out_bool
    !__str_idx_%out_bool
    !__str_last_start_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool
    jmp L_STR_CONTAINS_END_%out_bool

L_STR_CONTAINS_FALSE_%out_bool:
    %out_bool = add 0, 0
    !__str_can_match_%out_bool
    !__str_empty_needle_%out_bool
    !__str_needle_len_%out_bool
    !__str_len_%out_bool
    !__str_needle_ptr_%out_bool
    !__str_ptr_%out_bool

L_STR_CONTAINS_END_%out_bool:
[END_MACRO]

[MACRO] STRING_CONTAINS %out_bool, %slice_reg, %needle_slice
    EXPAND STR_CONTAINS %out_bool, %slice_reg, %needle_slice
[END_MACRO]

[MACRO] STR_TRY_FIND %out_ok, %out_index, %slice_reg, %needle_slice
    __str_ptr_%out_ok = load %slice_reg+Slice_ptr as ptr
    __str_needle_ptr_%out_ok = load %needle_slice+Slice_ptr as ptr
    __str_len_%out_ok = load %slice_reg+Slice_len as u64
    __str_needle_len_%out_ok = load %needle_slice+Slice_len as u64
    __str_idx_slot_%out_ok = stack_alloc 8
    __str_inner_slot_%out_ok = stack_alloc 8
    store __str_idx_slot_%out_ok+0, 0 as u64
    store __str_inner_slot_%out_ok+0, 0 as u64
    __str_empty_needle_%out_ok = eq __str_needle_len_%out_ok, 0
    br __str_empty_needle_%out_ok -> L_STR_FIND_EMPTY_%out_ok, L_STR_FIND_CHECK_%out_ok

L_STR_FIND_EMPTY_%out_ok:
    %out_ok = add 0, 1
    %out_index = add 0, 0
    !__str_empty_needle_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_needle_ptr_%out_ok
    !__str_ptr_%out_ok
    jmp L_STR_FIND_END_%out_ok

L_STR_FIND_CHECK_%out_ok:
    __str_can_match_%out_ok = ule __str_needle_len_%out_ok, __str_len_%out_ok
    br __str_can_match_%out_ok -> L_STR_FIND_INIT_%out_ok, L_STR_FIND_MISS_%out_ok

L_STR_FIND_INIT_%out_ok:
    __str_last_start_%out_ok = sub __str_len_%out_ok, __str_needle_len_%out_ok
    store __str_idx_slot_%out_ok+0, 0 as u64
    !__str_can_match_%out_ok
    !__str_empty_needle_%out_ok
    jmp L_STR_FIND_HEAD_%out_ok

L_STR_FIND_HEAD_%out_ok:
    __str_idx_%out_ok = load __str_idx_slot_%out_ok+0 as u64
    __str_after_last_%out_ok = ugt __str_idx_%out_ok, __str_last_start_%out_ok
    br __str_after_last_%out_ok -> L_STR_FIND_MISS_LOOP_%out_ok, L_STR_FIND_INNER_INIT_%out_ok

L_STR_FIND_INNER_INIT_%out_ok:
    store __str_inner_slot_%out_ok+0, 0 as u64
    !__str_after_last_%out_ok
    jmp L_STR_FIND_INNER_HEAD_%out_ok

L_STR_FIND_INNER_HEAD_%out_ok:
    __str_inner_%out_ok = load __str_inner_slot_%out_ok+0 as u64
    __str_inner_done_%out_ok = eq __str_inner_%out_ok, __str_needle_len_%out_ok
    br __str_inner_done_%out_ok -> L_STR_FIND_HIT_%out_ok, L_STR_FIND_BODY_%out_ok

L_STR_FIND_BODY_%out_ok:
    __str_hay_off_%out_ok = add __str_idx_%out_ok, __str_inner_%out_ok
    __str_hay_ip_%out_ok = ptr_add __str_ptr_%out_ok, __str_hay_off_%out_ok
    __str_needle_ip_%out_ok = ptr_add __str_needle_ptr_%out_ok, __str_inner_%out_ok
    __str_hay_byte_%out_ok = load __str_hay_ip_%out_ok+0 as u8
    __str_needle_byte_%out_ok = load __str_needle_ip_%out_ok+0 as u8
    __str_match_%out_ok = eq __str_hay_byte_%out_ok, __str_needle_byte_%out_ok
    br __str_match_%out_ok -> L_STR_FIND_INNER_NEXT_%out_ok, L_STR_FIND_NEXT_%out_ok

L_STR_FIND_INNER_NEXT_%out_ok:
    __str_inner_next_%out_ok = add __str_inner_%out_ok, 1
    store __str_inner_slot_%out_ok+0, __str_inner_next_%out_ok as u64
    !__str_inner_next_%out_ok
    !__str_match_%out_ok
    !__str_needle_byte_%out_ok
    !__str_hay_byte_%out_ok
    !__str_needle_ip_%out_ok
    !__str_hay_ip_%out_ok
    !__str_hay_off_%out_ok
    !__str_inner_done_%out_ok
    !__str_inner_%out_ok
    jmp L_STR_FIND_INNER_HEAD_%out_ok

L_STR_FIND_NEXT_%out_ok:
    __str_next_%out_ok = add __str_idx_%out_ok, 1
    store __str_idx_slot_%out_ok+0, __str_next_%out_ok as u64
    !__str_next_%out_ok
    !__str_match_%out_ok
    !__str_needle_byte_%out_ok
    !__str_hay_byte_%out_ok
    !__str_needle_ip_%out_ok
    !__str_hay_ip_%out_ok
    !__str_hay_off_%out_ok
    !__str_inner_done_%out_ok
    !__str_inner_%out_ok
    !__str_idx_%out_ok
    jmp L_STR_FIND_HEAD_%out_ok

L_STR_FIND_HIT_%out_ok:
    %out_ok = add 0, 1
    %out_index = add __str_idx_%out_ok, 0
    !__str_inner_done_%out_ok
    !__str_inner_%out_ok
    !__str_idx_%out_ok
    !__str_last_start_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_needle_ptr_%out_ok
    !__str_ptr_%out_ok
    jmp L_STR_FIND_END_%out_ok

L_STR_FIND_MISS_LOOP_%out_ok:
    %out_ok = add 0, 0
    %out_index = add 0, 0
    !__str_after_last_%out_ok
    !__str_idx_%out_ok
    !__str_last_start_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_needle_ptr_%out_ok
    !__str_ptr_%out_ok
    jmp L_STR_FIND_END_%out_ok

L_STR_FIND_MISS_%out_ok:
    %out_ok = add 0, 0
    %out_index = add 0, 0
    !__str_can_match_%out_ok
    !__str_empty_needle_%out_ok
    !__str_needle_len_%out_ok
    !__str_len_%out_ok
    !__str_needle_ptr_%out_ok
    !__str_ptr_%out_ok

L_STR_FIND_END_%out_ok:
[END_MACRO]

[MACRO] STRING_TRY_FIND %out_ok, %out_index, %slice_reg, %needle_slice
    EXPAND STR_TRY_FIND %out_ok, %out_index, %slice_reg, %needle_slice
