    !__str_boundary_lt_after_cont_%out_bool
    !__str_boundary_ge_cont_%out_bool
    !__str_boundary_byte_%out_bool
    !__str_boundary_ip_%out_bool
    !__str_boundary_ptr_%out_bool
    !__str_boundary_in_bounds_%out_bool
    !__str_boundary_at_end_%out_bool
    !__str_boundary_at_start_%out_bool
    !__str_boundary_len_%out_bool
    jmp L_STR_BOUNDARY_END_%out_bool

L_STR_BOUNDARY_FALSE_BOUNDS_%out_bool:
    %out_bool = add 0, 0
    !__str_boundary_in_bounds_%out_bool
    !__str_boundary_at_end_%out_bool
    !__str_boundary_at_start_%out_bool
    !__str_boundary_len_%out_bool
    jmp L_STR_BOUNDARY_END_%out_bool

L_STR_BOUNDARY_TRUE_END_%out_bool:
