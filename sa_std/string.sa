    __str_split_byte_part_len_%out_ok = sub __str_split_byte_scan_%out_ok, __str_split_byte_start_%out_ok
    __str_split_byte_part_ptr_%out_ok = ptr_add __str_split_byte_ptr_%out_ok, __str_split_byte_start_%out_ok
    EXPAND SLICE_NEW %out_part, __str_split_byte_part_ptr_%out_ok, __str_split_byte_part_len_%out_ok
    %out_ok = add 0, 1
