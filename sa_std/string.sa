    jmp L_STR_SPLIT_BYTE_END_%out_ok

L_STR_SPLIT_BYTE_ADVANCE_%out_ok:
    __str_split_byte_next_part_%out_ok = add __str_split_byte_current_%out_ok, 1
    __str_split_byte_after_%out_ok = add __str_split_byte_scan_%out_ok, 1
    store __str_split_byte_current_slot_%out_ok+0, __str_split_byte_next_part_%out_ok as u64
    store __str_split_byte_start_slot_%out_ok+0, __str_split_byte_after_%out_ok as u64
    store __str_split_byte_scan_slot_%out_ok+0, __str_split_byte_after_%out_ok as u64
    !__str_split_byte_after_%out_ok
    !__str_split_byte_next_part_%out_ok
    !__str_split_byte_target_%out_ok
    !__str_split_byte_current_%out_ok
    !__str_split_byte_match_%out_ok
    !__str_split_byte_value_%out_ok
    !__str_split_byte_ip_%out_ok
    !__str_split_byte_done_%out_ok
