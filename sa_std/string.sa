@import "core/slice.sal"
@import "core/slice.sa"
@import "char.sa"
@import "vec.sa"
@import "vec.sal"
@import "string.sai"
@import "fmt.sai"

[MACRO] STR_LEN %out_len, %slice_reg
    EXPAND SLICE_GET_LEN %out_len, %slice_reg
[END_MACRO]

[MACRO] STRING_LEN %out_len, %slice_reg
    EXPAND STR_LEN %out_len, %slice_reg
[END_MACRO]

[MACRO] STR_PTR %out_ptr, %slice_reg
    EXPAND SLICE_GET_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_PTR %out_ptr, %slice_reg
    EXPAND STR_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_PTR %out_ptr, %slice_reg
    EXPAND STR_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_PTR %out_ptr, %slice_reg
    EXPAND STRING_PTR %out_ptr, %slice_reg
[END_MACRO]

[MACRO] STR_AS_BYTES %out_slice, %slice_reg
    __str_ptr_%out_slice = load %slice_reg+Slice_ptr as ptr
    __str_len_%out_slice = load %slice_reg+Slice_len as u64
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __str_ptr_%out_slice, __str_len_%out_slice
    !__str_ptr_%out_slice
    !__str_len_%out_slice
[END_MACRO]

[MACRO] STRING_AS_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_BYTES %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_BYTES %out_slice, %slice_reg
    EXPAND STRING_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STRING_AS_STR %out_slice, %slice_reg
    EXPAND STR_AS_BYTES %out_slice, %slice_reg
[END_MACRO]

[MACRO] STR_IS_EMPTY %out_bool, %slice_reg
    __str_len_%out_bool = load %slice_reg+Slice_len as u64
    %out_bool = eq __str_len_%out_bool, 0
    !__str_len_%out_bool
[END_MACRO]

[MACRO] STRING_IS_EMPTY %out_bool, %slice_reg
    EXPAND STR_IS_EMPTY %out_bool, %slice_reg
[END_MACRO]

[MACRO] STR_FROM_PARTS %out_slice, %data_ptr, %length
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, %data_ptr, %length
[END_MACRO]

[MACRO] STRING_FROM_PARTS %out_slice, %data_ptr, %length
    EXPAND STR_FROM_PARTS %out_slice, %data_ptr, %length
[END_MACRO]

[MACRO] STRING_NEW %out_slice
    __string_empty_ptr_%out_slice = 0 as ptr
    EXPAND STRING_FROM_PARTS %out_slice, __string_empty_ptr_%out_slice, 0
    !__string_empty_ptr_%out_slice
[END_MACRO]

[MACRO] STRING_BUF_NEW %out_string
    EXPAND VEC_WITH_CAPACITY %out_string, 0, 1
[END_MACRO]

[MACRO] STRING_BUF_WITH_CAPACITY %out_string, %capacity
    EXPAND VEC_WITH_CAPACITY %out_string, %capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_TRY_WITH_CAPACITY %out_ok, %out_string, %capacity
    EXPAND VEC_TRY_WITH_CAPACITY %out_ok, %out_string, %capacity, 1
[END_MACRO]

[MACRO] STRING_BUF_FREE %string_reg
    EXPAND VEC_FREE %string_reg
[END_MACRO]

[MACRO] STRING_BUF_LEN %out_len, %string_reg
    EXPAND VEC_LEN %out_len, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_CAPACITY %out_cap, %string_reg
    EXPAND VEC_CAPACITY %out_cap, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_INTO_RAW_PARTS %out_ptr, %out_len, %out_cap, %string_reg
    EXPAND VEC_INTO_RAW_PARTS %out_ptr, %out_len, %out_cap, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_FROM_RAW_PARTS %out_string, %ptr, %len, %cap
    EXPAND VEC_FROM_RAW_PARTS %out_string, %ptr, %len, %cap
[END_MACRO]

[MACRO] STRING_BUF_IS_EMPTY %out_bool, %string_reg
    EXPAND VEC_IS_EMPTY %out_bool, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_PTR %out_ptr, %string_reg
    EXPAND VEC_AS_PTR %out_ptr, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_MUT_PTR %out_ptr, %string_reg
    EXPAND VEC_AS_MUT_PTR %out_ptr, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_STR %out_slice, %string_reg
    EXPAND VEC_AS_SLICE %out_slice, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_AS_BYTES %out_slice, %string_reg
    EXPAND VEC_AS_SLICE %out_slice, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_LEAK %out_slice, %string_reg
    EXPAND VEC_LEAK %out_slice, %string_reg
[END_MACRO]

[MACRO] STRING_BUF_INTO_BYTES %out_vec, %string_reg
    %out_vec = %string_reg
[END_MACRO]

[MACRO] STRING_BUF_INTO_CHARS_U64 %out_vec, %string_reg
    EXPAND STRING_BUF_AS_STR __string_into_chars_slice_%out_vec, %string_reg
    EXPAND STR_CHAR_COUNT __string_into_chars_count_%out_vec, __string_into_chars_slice_%out_vec
    EXPAND VEC_WITH_CAPACITY_U64 %out_vec, __string_into_chars_count_%out_vec
    __string_into_chars_idx_slot_%out_vec = stack_alloc 8
    store __string_into_chars_idx_slot_%out_vec+0, 0 as u64
    jmp L_STRING_INTO_CHARS_HEAD_%out_vec

L_STRING_INTO_CHARS_HEAD_%out_vec:
    __string_into_chars_idx_%out_vec = load __string_into_chars_idx_slot_%out_vec+0 as u64
    __string_into_chars_done_%out_vec = eq __string_into_chars_idx_%out_vec, __string_into_chars_count_%out_vec
    br __string_into_chars_done_%out_vec -> L_STRING_INTO_CHARS_DONE_%out_vec, L_STRING_INTO_CHARS_BODY_%out_vec

L_STRING_INTO_CHARS_BODY_%out_vec:
    EXPAND STR_TRY_CHAR_AT __string_into_chars_char_ok_%out_vec, __string_into_chars_codepoint_%out_vec, __string_into_chars_slice_%out_vec, __string_into_chars_idx_%out_vec
    br __string_into_chars_char_ok_%out_vec -> L_STRING_INTO_CHARS_PUSH_%out_vec, L_STRING_INTO_CHARS_INVALID_%out_vec

L_STRING_INTO_CHARS_PUSH_%out_vec:
    EXPAND VEC_PUSH_U64 %out_vec, __string_into_chars_codepoint_%out_vec
    __string_into_chars_next_%out_vec = add __string_into_chars_idx_%out_vec, 1
    store __string_into_chars_idx_slot_%out_vec+0, __string_into_chars_next_%out_vec as u64
    !__string_into_chars_next_%out_vec
    !__string_into_chars_codepoint_%out_vec
    !__string_into_chars_char_ok_%out_vec
    !__string_into_chars_done_%out_vec
    !__string_into_chars_idx_%out_vec
    jmp L_STRING_INTO_CHARS_HEAD_%out_vec

L_STRING_INTO_CHARS_INVALID_%out_vec:
    panic(1210)

L_STRING_INTO_CHARS_DONE_%out_vec:
    !__string_into_chars_done_%out_vec
    !__string_into_chars_idx_%out_vec
    !__string_into_chars_count_%out_vec
    !__string_into_chars_slice_%out_vec
    EXPAND STRING_BUF_FREE %string_reg
[END_MACRO]

[MACRO] STRING_BUF_FROM_UTF8_UNCHECKED %out_string, %bytes_slice
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, 0
    EXPAND STRING_BUF_PUSH_STR %out_string, %bytes_slice
[END_MACRO]

[MACRO] STRING_BUF_TRY_FROM_UTF8 %out_ok, %out_string, %bytes_slice
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, 0
    EXPAND STR_IS_UTF8 __string_buf_from_utf8_valid_%out_ok, %bytes_slice
    br __string_buf_from_utf8_valid_%out_ok -> L_STRING_BUF_FROM_UTF8_OK_%out_ok, L_STRING_BUF_FROM_UTF8_MISS_%out_ok

L_STRING_BUF_FROM_UTF8_OK_%out_ok:
    EXPAND STRING_BUF_PUSH_STR %out_string, %bytes_slice
    %out_ok = add 0, 1
    !__string_buf_from_utf8_valid_%out_ok
    jmp L_STRING_BUF_FROM_UTF8_DONE_%out_ok

L_STRING_BUF_FROM_UTF8_MISS_%out_ok:
    %out_ok = add 0, 0
    !__string_buf_from_utf8_valid_%out_ok

L_STRING_BUF_FROM_UTF8_DONE_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_TRY_FROM_UTF8_VEC %out_ok, %out_string, %out_err_vec, %bytes_vec
    EXPAND VEC_AS_SLICE __string_buf_from_utf8_vec_slice_%out_ok, %bytes_vec
    EXPAND STR_IS_UTF8 __string_buf_from_utf8_vec_valid_%out_ok, __string_buf_from_utf8_vec_slice_%out_ok
    !__string_buf_from_utf8_vec_slice_%out_ok
    br __string_buf_from_utf8_vec_valid_%out_ok -> L_STRING_BUF_FROM_UTF8_VEC_OK_%out_ok, L_STRING_BUF_FROM_UTF8_VEC_ERR_%out_ok

L_STRING_BUF_FROM_UTF8_VEC_OK_%out_ok:
    %out_string = %bytes_vec
    EXPAND VEC_WITH_CAPACITY %out_err_vec, 0, 1
    %out_ok = add 0, 1
    !__string_buf_from_utf8_vec_valid_%out_ok
    jmp L_STRING_BUF_FROM_UTF8_VEC_DONE_%out_ok

L_STRING_BUF_FROM_UTF8_VEC_ERR_%out_ok:
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, 0
    %out_err_vec = %bytes_vec
    %out_ok = add 0, 0
    !__string_buf_from_utf8_vec_valid_%out_ok

L_STRING_BUF_FROM_UTF8_VEC_DONE_%out_ok:
[END_MACRO]

[MACRO] STRING_BUF_FROM_UTF8_LOSSY %out_string, %bytes_slice
    __string_buf_utf8_lossy_ptr_%out_string = load %bytes_slice+Slice_ptr as ptr
    __string_buf_utf8_lossy_len_%out_string = load %bytes_slice+Slice_len as u64
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, __string_buf_utf8_lossy_len_%out_string
    __string_buf_utf8_lossy_idx_slot_%out_string = stack_alloc 8
    store __string_buf_utf8_lossy_idx_slot_%out_string+0, 0 as u64
    jmp L_STRING_BUF_UTF8_LOSSY_HEAD_%out_string

L_STRING_BUF_UTF8_LOSSY_HEAD_%out_string:
    __string_buf_utf8_lossy_idx_%out_string = load __string_buf_utf8_lossy_idx_slot_%out_string+0 as u64
    __string_buf_utf8_lossy_done_%out_string = uge __string_buf_utf8_lossy_idx_%out_string, __string_buf_utf8_lossy_len_%out_string
    br __string_buf_utf8_lossy_done_%out_string -> L_STRING_BUF_UTF8_LOSSY_DONE_%out_string, L_STRING_BUF_UTF8_LOSSY_BODY_%out_string

L_STRING_BUF_UTF8_LOSSY_BODY_%out_string:
    __string_buf_utf8_lossy_code_slot_%out_string = stack_alloc 8
    __string_buf_utf8_lossy_width_slot_%out_string = stack_alloc 8
    __string_buf_utf8_lossy_status_%out_string = call @sa_str_utf8_lossy_next(__string_buf_utf8_lossy_ptr_%out_string, __string_buf_utf8_lossy_len_%out_string, __string_buf_utf8_lossy_idx_%out_string, &__string_buf_utf8_lossy_code_slot_%out_string, &__string_buf_utf8_lossy_width_slot_%out_string)
    __string_buf_utf8_lossy_status_ok_%out_string = eq __string_buf_utf8_lossy_status_%out_string, 0
    br __string_buf_utf8_lossy_status_ok_%out_string -> L_STRING_BUF_UTF8_LOSSY_PUSH_%out_string, L_STRING_BUF_UTF8_LOSSY_INVALID_%out_string

L_STRING_BUF_UTF8_LOSSY_PUSH_%out_string:
    __string_buf_utf8_lossy_code_%out_string = load __string_buf_utf8_lossy_code_slot_%out_string+0 as u64
    __string_buf_utf8_lossy_width_%out_string = load __string_buf_utf8_lossy_width_slot_%out_string+0 as u64
    EXPAND STRING_BUF_TRY_PUSH_CHAR __string_buf_utf8_lossy_push_ok_%out_string, %out_string, __string_buf_utf8_lossy_code_%out_string
    br __string_buf_utf8_lossy_push_ok_%out_string -> L_STRING_BUF_UTF8_LOSSY_ADVANCE_%out_string, L_STRING_BUF_UTF8_LOSSY_INVALID_%out_string

L_STRING_BUF_UTF8_LOSSY_ADVANCE_%out_string:
    __string_buf_utf8_lossy_next_%out_string = add __string_buf_utf8_lossy_idx_%out_string, __string_buf_utf8_lossy_width_%out_string
    store __string_buf_utf8_lossy_idx_slot_%out_string+0, __string_buf_utf8_lossy_next_%out_string as u64
    !__string_buf_utf8_lossy_next_%out_string
    !__string_buf_utf8_lossy_push_ok_%out_string
    !__string_buf_utf8_lossy_width_%out_string
    !__string_buf_utf8_lossy_code_%out_string
    !__string_buf_utf8_lossy_status_ok_%out_string
    !__string_buf_utf8_lossy_status_%out_string
    !__string_buf_utf8_lossy_done_%out_string
    !__string_buf_utf8_lossy_idx_%out_string
    jmp L_STRING_BUF_UTF8_LOSSY_HEAD_%out_string

L_STRING_BUF_UTF8_LOSSY_INVALID_%out_string:
    panic(1211)

L_STRING_BUF_UTF8_LOSSY_DONE_%out_string:
    !__string_buf_utf8_lossy_done_%out_string
    !__string_buf_utf8_lossy_idx_%out_string
    !__string_buf_utf8_lossy_len_%out_string
    !__string_buf_utf8_lossy_ptr_%out_string
[END_MACRO]

[MACRO] STRING_BUF_FROM_UTF8_LOSSY_VEC %out_string, %bytes_vec
    EXPAND VEC_AS_SLICE __string_buf_utf8_lossy_vec_slice_%out_string, %bytes_vec
    EXPAND STR_IS_UTF8 __string_buf_utf8_lossy_vec_valid_%out_string, __string_buf_utf8_lossy_vec_slice_%out_string
    br __string_buf_utf8_lossy_vec_valid_%out_string -> L_STRING_BUF_UTF8_LOSSY_VEC_VALID_%out_string, L_STRING_BUF_UTF8_LOSSY_VEC_REPLACE_%out_string

L_STRING_BUF_UTF8_LOSSY_VEC_VALID_%out_string:
    %out_string = %bytes_vec
    !__string_buf_utf8_lossy_vec_valid_%out_string
    !__string_buf_utf8_lossy_vec_slice_%out_string
    jmp L_STRING_BUF_UTF8_LOSSY_VEC_DONE_%out_string

L_STRING_BUF_UTF8_LOSSY_VEC_REPLACE_%out_string:
    EXPAND STRING_BUF_FROM_UTF8_LOSSY %out_string, __string_buf_utf8_lossy_vec_slice_%out_string
    EXPAND VEC_FREE %bytes_vec
    !__string_buf_utf8_lossy_vec_valid_%out_string
    !__string_buf_utf8_lossy_vec_slice_%out_string

L_STRING_BUF_UTF8_LOSSY_VEC_DONE_%out_string:
[END_MACRO]

[MACRO] STRING_BUF_FROM_UTF8_LOSSY_OWNED %out_string, %bytes_vec
    EXPAND STRING_BUF_FROM_UTF8_LOSSY_VEC %out_string, %bytes_vec
[END_MACRO]

[MACRO] STRING_BUF_TRY_FROM_UTF16_U16 %out_ok, %out_string, %u16_slice
    EXPAND STRING_BUF_WITH_CAPACITY %out_string, 0
    __string_buf_utf16_len_%out_ok = load %u16_slice+Slice_len as u64
    __string_buf_utf16_idx_slot_%out_ok = stack_alloc 8
    store __string_buf_utf16_idx_slot_%out_ok+0, 0 as u64
    jmp L_STRING_BUF_UTF16_HEAD_%out_ok

L_STRING_BUF_UTF16_HEAD_%out_ok:
    __string_buf_utf16_idx_%out_ok = load __string_buf_utf16_idx_slot_%out_ok+0 as u64
    __string_buf_utf16_done_%out_ok = eq __string_buf_utf16_idx_%out_ok, __string_buf_utf16_len_%out_ok
    br __string_buf_utf16_done_%out_ok -> L_STRING_BUF_UTF16_OK_%out_ok, L_STRING_BUF_UTF16_BODY_%out_ok

L_STRING_BUF_UTF16_BODY_%out_ok:
    EXPAND SLICE_GET_TYPED_U16 __string_buf_utf16_unit_%out_ok, %u16_slice, __string_buf_utf16_idx_%out_ok, 2
    __string_buf_utf16_high_ge_%out_ok = uge __string_buf_utf16_unit_%out_ok, 55296
    __string_buf_utf16_high_le_%out_ok = ule __string_buf_utf16_unit_%out_ok, 56319
    __string_buf_utf16_is_high_%out_ok = and __string_buf_utf16_high_ge_%out_ok, __string_buf_utf16_high_le_%out_ok
    __string_buf_utf16_low_ge_%out_ok = uge __string_buf_utf16_unit_%out_ok, 56320
    __string_buf_utf16_low_le_%out_ok = ule __string_buf_utf16_unit_%out_ok, 57343
    __string_buf_utf16_is_low_%out_ok = and __string_buf_utf16_low_ge_%out_ok, __string_buf_utf16_low_le_%out_ok
    br __string_buf_utf16_is_high_%out_ok -> L_STRING_BUF_UTF16_HIGH_%out_ok, L_STRING_BUF_UTF16_CHECK_LOW_%out_ok

L_STRING_BUF_UTF16_CHECK_LOW_%out_ok:
    br __string_buf_utf16_is_low_%out_ok -> L_STRING_BUF_UTF16_FAIL_UNIT_%out_ok, L_STRING_BUF_UTF16_PUSH_BMP_%out_ok

L_STRING_BUF_UTF16_PUSH_BMP_%out_ok:
    EXPAND STRING_BUF_TRY_PUSH_CHAR __string_buf_utf16_push_ok_%out_ok, %out_string, __string_buf_utf16_unit_%out_ok
    br __string_buf_utf16_push_ok_%out_ok -> L_STRING_BUF_UTF16_NEXT_ONE_%out_ok, L_STRING_BUF_UTF16_FAIL_PUSH_%out_ok

L_STRING_BUF_UTF16_NEXT_ONE_%out_ok:
    __string_buf_utf16_next_%out_ok = add __string_buf_utf16_idx_%out_ok, 1
    store __string_buf_utf16_idx_slot_%out_ok+0, __string_buf_utf16_next_%out_ok as u64
    !__string_buf_utf16_next_%out_ok
    !__string_buf_utf16_push_ok_%out_ok
    !__string_buf_utf16_is_low_%out_ok
    !__string_buf_utf16_low_le_%out_ok
    !__string_buf_utf16_low_ge_%out_ok
    !__string_buf_utf16_is_high_%out_ok
    !__string_buf_utf16_high_le_%out_ok
    !__string_buf_utf16_high_ge_%out_ok
    !__string_buf_utf16_unit_%out_ok
    !__string_buf_utf16_done_%out_ok
    !__string_buf_utf16_idx_%out_ok
    jmp L_STRING_BUF_UTF16_HEAD_%out_ok

L_STRING_BUF_UTF16_HIGH_%out_ok:
    __string_buf_utf16_low_idx_%out_ok = add __string_buf_utf16_idx_%out_ok, 1
    __string_buf_utf16_has_low_%out_ok = ult __string_buf_utf16_low_idx_%out_ok, __string_buf_utf16_len_%out_ok
    br __string_buf_utf16_has_low_%out_ok -> L_STRING_BUF_UTF16_READ_LOW_%out_ok, L_STRING_BUF_UTF16_FAIL_HIGH_END_%out_ok

L_STRING_BUF_UTF16_READ_LOW_%out_ok:
    EXPAND SLICE_GET_TYPED_U16 __string_buf_utf16_low_unit_%out_ok, %u16_slice, __string_buf_utf16_low_idx_%out_ok, 2
    __string_buf_utf16_pair_low_ge_%out_ok = uge __string_buf_utf16_low_unit_%out_ok, 56320
    __string_buf_utf16_pair_low_le_%out_ok = ule __string_buf_utf16_low_unit_%out_ok, 57343
    __string_buf_utf16_pair_low_ok_%out_ok = and __string_buf_utf16_pair_low_ge_%out_ok, __string_buf_utf16_pair_low_le_%out_ok
    br __string_buf_utf16_pair_low_ok_%out_ok -> L_STRING_BUF_UTF16_PUSH_PAIR_%out_ok, L_STRING_BUF_UTF16_FAIL_PAIR_%out_ok

L_STRING_BUF_UTF16_PUSH_PAIR_%out_ok:
    __string_buf_utf16_high_ten_%out_ok = sub __string_buf_utf16_unit_%out_ok, 55296
    __string_buf_utf16_high_bits_%out_ok = shl __string_buf_utf16_high_ten_%out_ok, 10
    __string_buf_utf16_low_ten_%out_ok = sub __string_buf_utf16_low_unit_%out_ok, 56320
    __string_buf_utf16_pair_bits_%out_ok = add __string_buf_utf16_high_bits_%out_ok, __string_buf_utf16_low_ten_%out_ok
    __string_buf_utf16_codepoint_%out_ok = add __string_buf_utf16_pair_bits_%out_ok, 65536
    EXPAND STRING_BUF_TRY_PUSH_CHAR __string_buf_utf16_pair_push_ok_%out_ok, %out_string, __string_buf_utf16_codepoint_%out_ok
    br __string_buf_utf16_pair_push_ok_%out_ok -> L_STRING_BUF_UTF16_NEXT_TWO_%out_ok, L_STRING_BUF_UTF16_FAIL_PAIR_PUSH_%out_ok

L_STRING_BUF_UTF16_NEXT_TWO_%out_ok:
    __string_buf_utf16_after_pair_%out_ok = add __string_buf_utf16_idx_%out_ok, 2
    store __string_buf_utf16_idx_slot_%out_ok+0, __string_buf_utf16_after_pair_%out_ok as u64
    !__string_buf_utf16_after_pair_%out_ok
    !__string_buf_utf16_pair_push_ok_%out_ok
    !__string_buf_utf16_codepoint_%out_ok
    !__string_buf_utf16_pair_bits_%out_ok
    !__string_buf_utf16_low_ten_%out_ok
    !__string_buf_utf16_high_bits_%out_ok
    !__string_buf_utf16_high_ten_%out_ok
    !__string_buf_utf16_pair_low_ok_%out_ok
    !__string_buf_utf16_pair_low_le_%out_ok
    !__string_buf_utf16_pair_low_ge_%out_ok
    !__string_buf_utf16_low_unit_%out_ok
    !__string_buf_utf16_has_low_%out_ok
    !__string_buf_utf16_low_idx_%out_ok
    !__string_buf_utf16_is_low_%out_ok
    !__string_buf_utf16_low_le_%out_ok
    !__string_buf_utf16_low_ge_%out_ok
    !__string_buf_utf16_is_high_%out_ok
    !__string_buf_utf16_high_le_%out_ok
    !__string_buf_utf16_high_ge_%out_ok
    !__string_buf_utf16_unit_%out_ok
    !__string_buf_utf16_done_%out_ok
    !__string_buf_utf16_idx_%out_ok
    jmp L_STRING_BUF_UTF16_HEAD_%out_ok

L_STRING_BUF_UTF16_OK_%out_ok:
    %out_ok = add 0, 1
    !__string_buf_utf16_done_%out_ok
    !__string_buf_utf16_idx_%out_ok
