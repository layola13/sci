@import "hash.sal"
@import "core/slice.sal"

[MACRO] DEFAULT_HASHER_NEW %hasher
    store %hasher+DefaultHasher_state, HASHER_DEFAULT_SEED as u64
[END_MACRO]

[MACRO] DEFAULT_HASHER_DEFAULT %hasher
    EXPAND DEFAULT_HASHER_NEW %hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WITH_SEED %hasher, %seed
    store %hasher+DefaultHasher_state, %seed as u64
[END_MACRO]

[MACRO] DEFAULT_HASHER_RESET %hasher
    EXPAND DEFAULT_HASHER_NEW %hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_FINISH %out_hash, %hasher
    %out_hash = load %hasher+DefaultHasher_state as u64
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_U64 %hasher, %value
    __hasher_state_%hasher = load %hasher+DefaultHasher_state as u64
    __hasher_xor_%hasher = xor __hasher_state_%hasher, %value
    __hasher_next_%hasher = mul __hasher_xor_%hasher, HASHER_MIX_PRIME
    store %hasher+DefaultHasher_state, __hasher_next_%hasher as u64
    !__hasher_next_%hasher
    !__hasher_xor_%hasher
    !__hasher_state_%hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_USIZE %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_I64 %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_I8 %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_U8 %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_I16 %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_U16 %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_I32 %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_U32 %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_ISIZE %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_USIZE %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_U32 %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_U16 %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_U8 %hasher, %value
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, %value
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_BOOL %hasher, %value
    __hasher_bool_%hasher = ne %value, 0
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, __hasher_bool_%hasher
    !__hasher_bool_%hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_PTR %hasher, %ptr
    __hasher_ptr_bits_%hasher = bitcast %ptr as u64
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, __hasher_ptr_bits_%hasher
    !__hasher_ptr_bits_%hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_LENGTH_PREFIX %hasher, %len
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, %len
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_BYTES %hasher, %slice_reg
    __hasher_bytes_ptr_%hasher = load %slice_reg+Slice_ptr as ptr
    __hasher_bytes_len_%hasher = load %slice_reg+Slice_len as u64
    __hasher_bytes_idx_slot_%hasher = stack_alloc 8
    store __hasher_bytes_idx_slot_%hasher+0, 0 as u64
    jmp L_HASHER_WRITE_BYTES_HEAD_%hasher

L_HASHER_WRITE_BYTES_HEAD_%hasher:
    __hasher_bytes_idx_%hasher = load __hasher_bytes_idx_slot_%hasher+0 as u64
    __hasher_bytes_done_%hasher = eq __hasher_bytes_idx_%hasher, __hasher_bytes_len_%hasher
    br __hasher_bytes_done_%hasher -> L_HASHER_WRITE_BYTES_DONE_%hasher, L_HASHER_WRITE_BYTES_BODY_%hasher

L_HASHER_WRITE_BYTES_BODY_%hasher:
    __hasher_bytes_item_%hasher = ptr_add __hasher_bytes_ptr_%hasher, __hasher_bytes_idx_%hasher
    __hasher_bytes_value_%hasher = load __hasher_bytes_item_%hasher+0 as u8
    EXPAND DEFAULT_HASHER_WRITE_U8 %hasher, __hasher_bytes_value_%hasher
    __hasher_bytes_next_%hasher = add __hasher_bytes_idx_%hasher, 1
    store __hasher_bytes_idx_slot_%hasher+0, __hasher_bytes_next_%hasher as u64
    !__hasher_bytes_next_%hasher
    !__hasher_bytes_value_%hasher
    !__hasher_bytes_item_%hasher
    !__hasher_bytes_done_%hasher
    !__hasher_bytes_idx_%hasher
    jmp L_HASHER_WRITE_BYTES_HEAD_%hasher

L_HASHER_WRITE_BYTES_DONE_%hasher:
    !__hasher_bytes_done_%hasher
    !__hasher_bytes_idx_%hasher
    !__hasher_bytes_len_%hasher
    !__hasher_bytes_ptr_%hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_STR %hasher, %slice_reg
    EXPAND DEFAULT_HASHER_WRITE_BYTES %hasher, %slice_reg
    EXPAND DEFAULT_HASHER_WRITE_U8 %hasher, 255
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_SLICE_U8 %hasher, %slice_reg
    __hasher_u8_slice_len_%hasher = load %slice_reg+Slice_len as u64
    EXPAND DEFAULT_HASHER_WRITE_LENGTH_PREFIX %hasher, __hasher_u8_slice_len_%hasher
    EXPAND DEFAULT_HASHER_WRITE_BYTES %hasher, %slice_reg
    !__hasher_u8_slice_len_%hasher
[END_MACRO]

[MACRO] DEFAULT_HASHER_WRITE_SLICE_U64 %hasher, %slice_reg
    __hasher_u64_slice_ptr_%hasher = load %slice_reg+Slice_ptr as ptr
    __hasher_u64_slice_len_%hasher = load %slice_reg+Slice_len as u64
    __hasher_u64_slice_idx_slot_%hasher = stack_alloc 8
    EXPAND DEFAULT_HASHER_WRITE_LENGTH_PREFIX %hasher, __hasher_u64_slice_len_%hasher
    store __hasher_u64_slice_idx_slot_%hasher+0, 0 as u64
    jmp L_HASHER_WRITE_SLICE_U64_HEAD_%hasher

L_HASHER_WRITE_SLICE_U64_HEAD_%hasher:
    __hasher_u64_slice_idx_%hasher = load __hasher_u64_slice_idx_slot_%hasher+0 as u64
    __hasher_u64_slice_done_%hasher = eq __hasher_u64_slice_idx_%hasher, __hasher_u64_slice_len_%hasher
    br __hasher_u64_slice_done_%hasher -> L_HASHER_WRITE_SLICE_U64_DONE_%hasher, L_HASHER_WRITE_SLICE_U64_BODY_%hasher

L_HASHER_WRITE_SLICE_U64_BODY_%hasher:
    __hasher_u64_slice_off_%hasher = mul __hasher_u64_slice_idx_%hasher, 8
    __hasher_u64_slice_item_%hasher = ptr_add __hasher_u64_slice_ptr_%hasher, __hasher_u64_slice_off_%hasher
    __hasher_u64_slice_value_%hasher = load __hasher_u64_slice_item_%hasher+0 as u64
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, __hasher_u64_slice_value_%hasher
    __hasher_u64_slice_next_%hasher = add __hasher_u64_slice_idx_%hasher, 1
    store __hasher_u64_slice_idx_slot_%hasher+0, __hasher_u64_slice_next_%hasher as u64
    !__hasher_u64_slice_next_%hasher
    !__hasher_u64_slice_value_%hasher
    !__hasher_u64_slice_item_%hasher
    !__hasher_u64_slice_off_%hasher
    !__hasher_u64_slice_done_%hasher
    !__hasher_u64_slice_idx_%hasher
    jmp L_HASHER_WRITE_SLICE_U64_HEAD_%hasher

L_HASHER_WRITE_SLICE_U64_DONE_%hasher:
    !__hasher_u64_slice_done_%hasher
    !__hasher_u64_slice_idx_%hasher
    !__hasher_u64_slice_len_%hasher
    !__hasher_u64_slice_ptr_%hasher
[END_MACRO]

[MACRO] HASH_U64 %out_hash, %value
    __hash_u64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_u64_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_U64 __hash_u64_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_u64_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_PTR_VALUE %out_hash, %ptr
    __hash_ptr_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_ptr_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_PTR __hash_ptr_hasher_%out_hash, %ptr
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_ptr_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_STR %out_hash, %slice_reg
    __hash_str_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_str_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_STR __hash_str_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_str_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_SLICE_U8 %out_hash, %slice_reg
    __hash_slice_u8_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_slice_u8_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U8 __hash_slice_u8_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_slice_u8_hasher_%out_hash
[END_MACRO]

[MACRO] SLICE_HASH_U64 %out_hash, %slice_reg
    __hash_slice_u64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_slice_u64_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U64 __hash_slice_u64_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_slice_u64_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_NEW %builder
    %builder = add 0, 0
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_DEFAULT %builder
    EXPAND BUILD_HASHER_DEFAULT_NEW %builder
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_CLONE %out_builder, %builder
    EXPAND BUILD_HASHER_DEFAULT_NEW %out_builder
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_COPY %out_builder, %builder
    EXPAND BUILD_HASHER_DEFAULT_CLONE %out_builder, %builder
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_EQ %out_bool, %left_builder, %right_builder
    %out_bool = add 0, 1
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_NE %out_bool, %left_builder, %right_builder
    %out_bool = add 0, 0
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_BUILD %hasher, %builder
    EXPAND DEFAULT_HASHER_NEW %hasher
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_U64 %out_hash, %builder, %value
    __build_hash_one_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_U64 __build_hash_one_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_STR %out_hash, %builder, %slice_reg
    __build_hash_one_str_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_str_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_STR __build_hash_one_str_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_str_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_SLICE_U8 %out_hash, %builder, %slice_reg
    __build_hash_one_slice_u8_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_slice_u8_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U8 __build_hash_one_slice_u8_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_slice_u8_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_SLICE_U64 %out_hash, %builder, %slice_reg
    __build_hash_one_slice_u64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_slice_u64_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U64 __build_hash_one_slice_u64_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_slice_u64_hasher_%out_hash
[END_MACRO]
