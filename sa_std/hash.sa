[MACRO] HASH_USIZE %out_hash, %value
    __hash_usize_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_usize_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_USIZE __hash_usize_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_usize_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_I64 %out_hash, %value
    __hash_i64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_i64_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_I64 __hash_i64_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_i64_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_I32 %out_hash, %value
    __hash_i32_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_i32_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_I32 __hash_i32_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_i32_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_I16 %out_hash, %value
    __hash_i16_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_i16_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_I16 __hash_i16_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_i16_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_I8 %out_hash, %value
    __hash_i8_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_i8_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_I8 __hash_i8_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_i8_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_ISIZE %out_hash, %value
    __hash_isize_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_isize_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_ISIZE __hash_isize_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_isize_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_BOOL %out_hash, %value
    __hash_bool_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_bool_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_BOOL __hash_bool_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_bool_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_PTR_VALUE %out_hash, %ptr
    __hash_ptr_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_ptr_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_PTR __hash_ptr_hasher_%out_hash, %ptr
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_ptr_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_STR %out_hash, %slice_reg
    __hash_str_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_str_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_STR __hash_str_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_str_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_CHAR %out_hash, %code
    __hash_char_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_char_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_CHAR __hash_char_hasher_%out_hash, %code
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_char_hasher_%out_hash
[END_MACRO]

[MACRO] HASH_SLICE_U8 %out_hash, %slice_reg
    __hash_slice_u8_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_slice_u8_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U8 __hash_slice_u8_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_slice_u8_hasher_%out_hash
[END_MACRO]

[MACRO] SLICE_HASH_U64 %out_hash, %slice_reg
    __hash_slice_u64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW __hash_slice_u64_hasher_%out_hash
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U64 __hash_slice_u64_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __hash_slice_u64_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_NEW %builder
    %builder = add 0, 0
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_DEFAULT %builder
    EXPAND BUILD_HASHER_DEFAULT_NEW %builder
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_CLONE %out_builder, %builder
    EXPAND BUILD_HASHER_DEFAULT_NEW %out_builder
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_COPY %out_builder, %builder
    EXPAND BUILD_HASHER_DEFAULT_CLONE %out_builder, %builder
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_EQ %out_bool, %left_builder, %right_builder
    %out_bool = add 0, 1
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_NE %out_bool, %left_builder, %right_builder
    %out_bool = add 0, 0
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_BUILD %hasher, %builder
    EXPAND DEFAULT_HASHER_NEW %hasher
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_U64 %out_hash, %builder, %value
    __build_hash_one_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_U64 __build_hash_one_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_STR %out_hash, %builder, %slice_reg
    __build_hash_one_str_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_str_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_STR __build_hash_one_str_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_str_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_SLICE_U8 %out_hash, %builder, %slice_reg
    __build_hash_one_slice_u8_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_slice_u8_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U8 __build_hash_one_slice_u8_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_slice_u8_hasher_%out_hash
[END_MACRO]

[MACRO] BUILD_HASHER_DEFAULT_HASH_ONE_SLICE_U64 %out_hash, %builder, %slice_reg
    __build_hash_one_slice_u64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD __build_hash_one_slice_u64_hasher_%out_hash, %builder
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U64 __build_hash_one_slice_u64_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __build_hash_one_slice_u64_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_NEW %state
    store %state+RandomState_k0, RANDOM_STATE_DEFAULT_K0 as u64
    store %state+RandomState_k1, RANDOM_STATE_DEFAULT_K1 as u64
[END_MACRO]

[MACRO] RANDOM_STATE_DEFAULT %state
    EXPAND RANDOM_STATE_NEW %state
[END_MACRO]

[MACRO] RANDOM_STATE_WITH_SEEDS %state, %k0, %k1
    store %state+RandomState_k0, %k0 as u64
    store %state+RandomState_k1, %k1 as u64
[END_MACRO]

[MACRO] RANDOM_STATE_CLONE %out_state, %state
    __random_state_k0_%out_state = load %state+RandomState_k0 as u64
    __random_state_k1_%out_state = load %state+RandomState_k1 as u64
    store %out_state+RandomState_k0, __random_state_k0_%out_state as u64
    store %out_state+RandomState_k1, __random_state_k1_%out_state as u64
    !__random_state_k1_%out_state
    !__random_state_k0_%out_state
[END_MACRO]

[MACRO] RANDOM_STATE_BUILD %hasher, %state
    __random_state_build_k0_%hasher = load %state+RandomState_k0 as u64
    __random_state_build_k1_%hasher = load %state+RandomState_k1 as u64
    EXPAND DEFAULT_HASHER_WITH_SEED %hasher, __random_state_build_k0_%hasher
    EXPAND DEFAULT_HASHER_WRITE_U64 %hasher, __random_state_build_k1_%hasher
    !__random_state_build_k1_%hasher
    !__random_state_build_k0_%hasher
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_U64 %out_hash, %state, %value
    __random_state_hash_one_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_U64 __random_state_hash_one_hasher_%out_hash, %value
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_STR %out_hash, %state, %slice_reg
    __random_state_hash_one_str_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_str_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_STR __random_state_hash_one_str_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_str_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_SLICE_U8 %out_hash, %state, %slice_reg
    __random_state_hash_one_slice_u8_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_slice_u8_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U8 __random_state_hash_one_slice_u8_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_slice_u8_hasher_%out_hash
[END_MACRO]

[MACRO] RANDOM_STATE_HASH_ONE_SLICE_U64 %out_hash, %state, %slice_reg
    __random_state_hash_one_slice_u64_hasher_%out_hash = stack_alloc DefaultHasher_SIZE
    EXPAND RANDOM_STATE_BUILD __random_state_hash_one_slice_u64_hasher_%out_hash, %state
    EXPAND DEFAULT_HASHER_WRITE_SLICE_U64 __random_state_hash_one_slice_u64_hasher_%out_hash, %slice_reg
    EXPAND DEFAULT_HASHER_FINISH %out_hash, __random_state_hash_one_slice_u64_hasher_%out_hash
[END_MACRO]
