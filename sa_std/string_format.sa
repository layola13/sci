@import "fmt.sai"
@import "vec.sa"
@import "core/slice.sal"
@import "core/slice.sa"

[MACRO] STRFMT_I64 %out_buf, %value, %base
    %out_buf = call @sa_fmt_i64(%value, %base)
[END_MACRO]

[MACRO] STRFMT_U64 %out_buf, %value, %base
    %out_buf = call @sa_fmt_u64(%value, %base)
[END_MACRO]

// Rust method-name alias over STRFMT_U64.
[MACRO] STRFMT %out_buf, %value, %base
    EXPAND STRFMT_U64 %out_buf, %value, %base
[END_MACRO]

[MACRO] STRFMT_F64 %out_buf, %value, %precision
    %out_buf = call @sa_fmt_f64(%value, %precision)
[END_MACRO]

[MACRO] STRFMT_BOOL %out_buf, %value
    %out_buf = call @sa_fmt_bool(%value)
[END_MACRO]

[MACRO] STRFMT_BYTES %out_buf, %buf, %len
    %out_buf = call @sa_fmt_bytes(&%buf, %len)
[END_MACRO]

[MACRO] STRFMT_I64_INTO %out_ok, %out_len_ptr, %value, %base, %buf, %cap
    %out_ok = call @sa_fmt_i64_into(%value, %base, %buf, %cap, &%out_len_ptr)
[END_MACRO]

[MACRO] STRFMT_U64_INTO %out_ok, %out_len_ptr, %value, %base, %buf, %cap
    %out_ok = call @sa_fmt_u64_into(%value, %base, %buf, %cap, &%out_len_ptr)
[END_MACRO]

[MACRO] STRFMT_F64_INTO %out_ok, %out_len_ptr, %value, %precision, %buf, %cap
    %out_ok = call @sa_fmt_f64_into(%value, %precision, %buf, %cap, &%out_len_ptr)
[END_MACRO]

[MACRO] STRFMT_BOOL_INTO %out_ok, %out_len_ptr, %value, %buf, %cap
    %out_ok = call @sa_fmt_bool_into(%value, %buf, %cap, &%out_len_ptr)
[END_MACRO]

[MACRO] STRFMT_BYTES_INTO %out_ok, %out_len_ptr, %src, %src_len, %buf, %cap
    %out_ok = call @sa_fmt_bytes_into(&%src, %src_len, %buf, %cap, &%out_len_ptr)
[END_MACRO]

[MACRO] STRFMT_DATA %out_ptr, %buffer
    %out_ptr = call @sa_fmt_buffer_data(%buffer)
[END_MACRO]

[MACRO] STRFMT_LEN %out_len, %buffer
    %out_len = call @sa_fmt_buffer_len(%buffer)
[END_MACRO]

[MACRO] STRFMT_WRITE_TO %out_ok, %buffer, %writer
    %out_ok = call @sa_fmt_buffer_write_to(%buffer, %writer)
[END_MACRO]

[MACRO] STRFMT_FREE %out_ok, %buffer
    %out_ok = call @sa_fmt_buffer_free(^%buffer)
[END_MACRO]

[MACRO] FORMAT_BEGIN %out_string, %capacity
    %out_string = call @sa_vec_with_capacity(%capacity, 1)
[END_MACRO]

[MACRO] FORMAT_PUSH_BYTES %tag, %string_reg, %src_ptr, %src_len
    %string_reg = call @sa_vec_reserve(^%string_reg, %src_len, 1)
    __format_view_%tag = & %string_reg
    __format_dst_buf_%tag = load __format_view_%tag+Vec_ptr as ptr
    __format_dst_len_%tag = load __format_view_%tag+Vec_len as u64
    __format_dst_ptr_%tag = ptr_add __format_dst_buf_%tag, __format_dst_len_%tag
    call @sa_mem_copy(&__format_dst_ptr_%tag, &%src_ptr, %src_len)
    __format_next_len_%tag = add __format_dst_len_%tag, %src_len
    store __format_view_%tag+Vec_len, __format_next_len_%tag as u64
    !__format_next_len_%tag
    !__format_dst_ptr_%tag
    !__format_dst_len_%tag
    !__format_dst_buf_%tag
    !__format_view_%tag
[END_MACRO]

[MACRO] FORMAT_PUSH_SLICE %tag, %string_reg, %slice_reg
    __format_slice_ptr_%tag = load %slice_reg+Slice_ptr as ptr
    __format_slice_len_%tag = load %slice_reg+Slice_len as u64
    EXPAND FORMAT_PUSH_BYTES %tag, %string_reg, __format_slice_ptr_%tag, __format_slice_len_%tag
    !__format_slice_len_%tag
    !__format_slice_ptr_%tag
[END_MACRO]

[MACRO] FORMAT_PUSH_I64 %tag, %string_reg, %value
    EXPAND STRFMT_I64 __format_fmt_buf_%tag, %value, 10
    EXPAND STRFMT_DATA __format_fmt_ptr_%tag, __format_fmt_buf_%tag
    EXPAND STRFMT_LEN __format_fmt_len_%tag, __format_fmt_buf_%tag
    EXPAND FORMAT_PUSH_BYTES %tag, %string_reg, __format_fmt_ptr_%tag, __format_fmt_len_%tag
    EXPAND STRFMT_FREE __format_fmt_free_ok_%tag, __format_fmt_buf_%tag
    !__format_fmt_free_ok_%tag
    !__format_fmt_len_%tag
    !__format_fmt_ptr_%tag
[END_MACRO]

[MACRO] FORMAT_PUSH_U64 %tag, %string_reg, %value
    EXPAND STRFMT_U64 __format_fmt_buf_%tag, %value, 10
    EXPAND STRFMT_DATA __format_fmt_ptr_%tag, __format_fmt_buf_%tag
    EXPAND STRFMT_LEN __format_fmt_len_%tag, __format_fmt_buf_%tag
    EXPAND FORMAT_PUSH_BYTES %tag, %string_reg, __format_fmt_ptr_%tag, __format_fmt_len_%tag
    EXPAND STRFMT_FREE __format_fmt_free_ok_%tag, __format_fmt_buf_%tag
    !__format_fmt_free_ok_%tag
    !__format_fmt_len_%tag
    !__format_fmt_ptr_%tag
[END_MACRO]

// Rust method-name alias over FORMAT_PUSH_U64.
[MACRO] FORMAT_PUSH %tag, %string_reg, %value
    EXPAND FORMAT_PUSH_U64 %tag, %string_reg, %value
[END_MACRO]

[MACRO] FORMAT_PUSH_F64 %tag, %string_reg, %value, %precision
    EXPAND STRFMT_F64 __format_fmt_buf_%tag, %value, %precision
    EXPAND STRFMT_DATA __format_fmt_ptr_%tag, __format_fmt_buf_%tag
    EXPAND STRFMT_LEN __format_fmt_len_%tag, __format_fmt_buf_%tag
    EXPAND FORMAT_PUSH_BYTES %tag, %string_reg, __format_fmt_ptr_%tag, __format_fmt_len_%tag
    EXPAND STRFMT_FREE __format_fmt_free_ok_%tag, __format_fmt_buf_%tag
    !__format_fmt_free_ok_%tag
    !__format_fmt_len_%tag
    !__format_fmt_ptr_%tag
[END_MACRO]

[MACRO] FORMAT_PUSH_BOOL %tag, %string_reg, %value
    EXPAND STRFMT_BOOL __format_fmt_buf_%tag, %value
    EXPAND STRFMT_DATA __format_fmt_ptr_%tag, __format_fmt_buf_%tag
    EXPAND STRFMT_LEN __format_fmt_len_%tag, __format_fmt_buf_%tag
    EXPAND FORMAT_PUSH_BYTES %tag, %string_reg, __format_fmt_ptr_%tag, __format_fmt_len_%tag
    EXPAND STRFMT_FREE __format_fmt_free_ok_%tag, __format_fmt_buf_%tag
    !__format_fmt_free_ok_%tag
    !__format_fmt_len_%tag
    !__format_fmt_ptr_%tag
[END_MACRO]

[MACRO] FORMAT_AS_STR %out_slice, %string_reg
    __format_as_str_view_%out_slice = & %string_reg
    __format_as_str_ptr_%out_slice = load __format_as_str_view_%out_slice+Vec_ptr as ptr
    __format_as_str_len_%out_slice = load __format_as_str_view_%out_slice+Vec_len as u64
    %out_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW %out_slice, __format_as_str_ptr_%out_slice, __format_as_str_len_%out_slice
    !__format_as_str_len_%out_slice
    !__format_as_str_ptr_%out_slice
    !__format_as_str_view_%out_slice
[END_MACRO]

[MACRO] FORMAT_FREE %string_reg
    call @sa_vec_free(^%string_reg)
[END_MACRO]
