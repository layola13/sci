[MACRO] NET_IP_ADDR_TO_IPV4 %out_ok, %ipv4, %ipaddr
    __net_ip_to4_tag_%ipv4 = load %ipaddr+NetIpAddr_tag as u64
    __net_ip_to4_payload_%ipv4 = ptr_add %ipaddr, 8
    __net_ip_to4_is_v4_%ipv4 = eq __net_ip_to4_tag_%ipv4, NET_IP_ADDR_V4
    br __net_ip_to4_is_v4_%ipv4 -> L_NET_IP_TO4_V4_%ipv4, L_NET_IP_TO4_V6_%ipv4
L_NET_IP_TO4_V4_%ipv4:
    %out_ok = add 0, 1
    EXPAND NET_IPV4_COPY %ipv4, __net_ip_to4_payload_%ipv4
    jmp L_NET_IP_TO4_DONE_%ipv4
L_NET_IP_TO4_V6_%ipv4:
