    EXPAND NET_IPV6_IS_UNICAST %out_bool, __net_ip_unicast_payload_%out_bool
    jmp L_NET_IP_UNICAST_DONE_%out_bool
L_NET_IP_UNICAST_DONE_%out_bool:
    !__net_ip_unicast_is_v4_%out_bool
    !__net_ip_unicast_payload_%out_bool
    !__net_ip_unicast_tag_%out_bool
