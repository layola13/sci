    store __net_ip_v4_payload_%ipaddr+NetIpv4Addr_a, __net_ip_v4_a_%ipaddr as u8
    store __net_ip_v4_payload_%ipaddr+NetIpv4Addr_b, __net_ip_v4_b_%ipaddr as u8
    store __net_ip_v4_payload_%ipaddr+NetIpv4Addr_c, __net_ip_v4_c_%ipaddr as u8
    store __net_ip_v4_payload_%ipaddr+NetIpv4Addr_d, __net_ip_v4_d_%ipaddr as u8
    !__net_ip_v4_d_%ipaddr
    !__net_ip_v4_c_%ipaddr
    !__net_ip_v4_b_%ipaddr
    !__net_ip_v4_a_%ipaddr
    !__net_ip_v4_payload_%ipaddr
