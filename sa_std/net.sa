[MACRO] NET_IP_ADDR_IS_UNIQUE_LOCAL %out_bool, %ipaddr
    __net_ip_unique_tag_%out_bool = load %ipaddr+NetIpAddr_tag as u64
    __net_ip_unique_payload_%out_bool = ptr_add %ipaddr, 8
    __net_ip_unique_is_v4_%out_bool = eq __net_ip_unique_tag_%out_bool, NET_IP_ADDR_V4
    br __net_ip_unique_is_v4_%out_bool -> L_NET_IP_UNIQUE_V4_%out_bool, L_NET_IP_UNIQUE_V6_%out_bool
L_NET_IP_UNIQUE_V4_%out_bool:
    %out_bool = add 0, 0
    jmp L_NET_IP_UNIQUE_DONE_%out_bool
L_NET_IP_UNIQUE_V6_%out_bool:
