[MACRO] NET_IPV6_COPY %dst_addr, %src_addr
    __net_ipv6_copy_s0_%dst_addr = load %src_addr+NetIpv6Addr_s0 as u16
    __net_ipv6_copy_s1_%dst_addr = load %src_addr+NetIpv6Addr_s1 as u16
    __net_ipv6_copy_s2_%dst_addr = load %src_addr+NetIpv6Addr_s2 as u16
    __net_ipv6_copy_s3_%dst_addr = load %src_addr+NetIpv6Addr_s3 as u16
    __net_ipv6_copy_s4_%dst_addr = load %src_addr+NetIpv6Addr_s4 as u16
    __net_ipv6_copy_s5_%dst_addr = load %src_addr+NetIpv6Addr_s5 as u16
