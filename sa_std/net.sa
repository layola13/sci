    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s0, __net_ip_v6_s0_%ipaddr as u16
    store __net_ip_v6_payload_%ipaddr+NetIpv6Addr_s1, __net_ip_v6_s1_%ipaddr as u16
