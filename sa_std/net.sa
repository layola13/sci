[MACRO] NET_IPV4_NEW %addr, %a, %b, %c, %d
    store %addr+NetIpv4Addr_a, %a as u8
    store %addr+NetIpv4Addr_b, %b as u8
    store %addr+NetIpv4Addr_c, %c as u8
    store %addr+NetIpv4Addr_d, %d as u8
[END_MACRO]

[MACRO] NET_IPV4_UNSPECIFIED %addr
    EXPAND NET_IPV4_NEW %addr, 0, 0, 0, 0
[END_MACRO]

[MACRO] NET_IPV4_LOCALHOST %addr
    EXPAND NET_IPV4_NEW %addr, 127, 0, 0, 1
[END_MACRO]

[MACRO] NET_IPV4_BROADCAST %addr
    EXPAND NET_IPV4_NEW %addr, 255, 255, 255, 255
[END_MACRO]

[MACRO] NET_IPV4_BITS %out_bits
    %out_bits = add 0, NET_IPV4_BITS_VALUE
[END_MACRO]

[MACRO] NET_IPV4_OCTETS %out_a, %out_b, %out_c, %out_d, %addr
    %out_a = load %addr+NetIpv4Addr_a as u8
    %out_b = load %addr+NetIpv4Addr_b as u8
    %out_c = load %addr+NetIpv4Addr_c as u8
    %out_d = load %addr+NetIpv4Addr_d as u8
[END_MACRO]

[MACRO] NET_IPV4_AS_OCTETS_PTR %out_ptr, %addr
    %out_ptr = ptr_add %addr, 0
[END_MACRO]

[MACRO] NET_IPV4_WRITE_OCTETS %out_ok, %dst_ptr, %dst_len, %addr
    __net_ipv4_write_fits_%out_ok = uge %dst_len, 4
    br __net_ipv4_write_fits_%out_ok -> L_NET_IPV4_WRITE_OCTETS_OK_%out_ok, L_NET_IPV4_WRITE_OCTETS_FAIL_%out_ok

L_NET_IPV4_WRITE_OCTETS_OK_%out_ok:
    __net_ipv4_write_a_%out_ok = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_write_b_%out_ok = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_write_c_%out_ok = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_write_d_%out_ok = load %addr+NetIpv4Addr_d as u8
    store %dst_ptr+0, __net_ipv4_write_a_%out_ok as u8
    __net_ipv4_write_p1_%out_ok = ptr_add %dst_ptr, 1
    __net_ipv4_write_p2_%out_ok = ptr_add %dst_ptr, 2
    __net_ipv4_write_p3_%out_ok = ptr_add %dst_ptr, 3
    store __net_ipv4_write_p1_%out_ok+0, __net_ipv4_write_b_%out_ok as u8
    store __net_ipv4_write_p2_%out_ok+0, __net_ipv4_write_c_%out_ok as u8
    store __net_ipv4_write_p3_%out_ok+0, __net_ipv4_write_d_%out_ok as u8
    %out_ok = add 0, 1
    !__net_ipv4_write_p3_%out_ok
    !__net_ipv4_write_p2_%out_ok
    !__net_ipv4_write_p1_%out_ok
    !__net_ipv4_write_d_%out_ok
    !__net_ipv4_write_c_%out_ok
    !__net_ipv4_write_b_%out_ok
    !__net_ipv4_write_a_%out_ok
    !__net_ipv4_write_fits_%out_ok
    jmp L_NET_IPV4_WRITE_OCTETS_END_%out_ok

L_NET_IPV4_WRITE_OCTETS_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__net_ipv4_write_fits_%out_ok

L_NET_IPV4_WRITE_OCTETS_END_%out_ok:
[END_MACRO]

[MACRO] NET_IPV4_FROM_OCTETS %addr, %a, %b, %c, %d
    EXPAND NET_IPV4_NEW %addr, %a, %b, %c, %d
[END_MACRO]

[MACRO] NET_IPV4_COPY %dst_addr, %src_addr
    __net_ipv4_copy_a_%dst_addr = load %src_addr+NetIpv4Addr_a as u8
    __net_ipv4_copy_b_%dst_addr = load %src_addr+NetIpv4Addr_b as u8
    __net_ipv4_copy_c_%dst_addr = load %src_addr+NetIpv4Addr_c as u8
    __net_ipv4_copy_d_%dst_addr = load %src_addr+NetIpv4Addr_d as u8
    EXPAND NET_IPV4_NEW %dst_addr, __net_ipv4_copy_a_%dst_addr, __net_ipv4_copy_b_%dst_addr, __net_ipv4_copy_c_%dst_addr, __net_ipv4_copy_d_%dst_addr
    !__net_ipv4_copy_d_%dst_addr
    !__net_ipv4_copy_c_%dst_addr
    !__net_ipv4_copy_b_%dst_addr
    !__net_ipv4_copy_a_%dst_addr
[END_MACRO]

[MACRO] NET_IPV4_TO_BITS %out_bits, %addr
    __net_ipv4_bits_a_%out_bits = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_bits_b_%out_bits = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_bits_c_%out_bits = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_bits_d_%out_bits = load %addr+NetIpv4Addr_d as u8
    __net_ipv4_bits_a_shift_%out_bits = shl __net_ipv4_bits_a_%out_bits, 24
    __net_ipv4_bits_b_shift_%out_bits = shl __net_ipv4_bits_b_%out_bits, 16
    __net_ipv4_bits_c_shift_%out_bits = shl __net_ipv4_bits_c_%out_bits, 8
    __net_ipv4_bits_ab_%out_bits = or __net_ipv4_bits_a_shift_%out_bits, __net_ipv4_bits_b_shift_%out_bits
    __net_ipv4_bits_cd_%out_bits = or __net_ipv4_bits_c_shift_%out_bits, __net_ipv4_bits_d_%out_bits
    %out_bits = or __net_ipv4_bits_ab_%out_bits, __net_ipv4_bits_cd_%out_bits
    !__net_ipv4_bits_cd_%out_bits
    !__net_ipv4_bits_ab_%out_bits
    !__net_ipv4_bits_c_shift_%out_bits
    !__net_ipv4_bits_b_shift_%out_bits
    !__net_ipv4_bits_a_shift_%out_bits
    !__net_ipv4_bits_d_%out_bits
    !__net_ipv4_bits_c_%out_bits
    !__net_ipv4_bits_b_%out_bits
    !__net_ipv4_bits_a_%out_bits
[END_MACRO]

[MACRO] NET_IPV4_FROM_BITS %addr, %bits
    __net_ipv4_from_a_%addr = lshr %bits, 24
    __net_ipv4_from_b_raw_%addr = lshr %bits, 16
    __net_ipv4_from_b_%addr = and __net_ipv4_from_b_raw_%addr, 255
    __net_ipv4_from_c_raw_%addr = lshr %bits, 8
    __net_ipv4_from_c_%addr = and __net_ipv4_from_c_raw_%addr, 255
    __net_ipv4_from_d_%addr = and %bits, 255
    EXPAND NET_IPV4_NEW %addr, __net_ipv4_from_a_%addr, __net_ipv4_from_b_%addr, __net_ipv4_from_c_%addr, __net_ipv4_from_d_%addr
    !__net_ipv4_from_d_%addr
    !__net_ipv4_from_c_%addr
    !__net_ipv4_from_c_raw_%addr
    !__net_ipv4_from_b_%addr
    !__net_ipv4_from_b_raw_%addr
    !__net_ipv4_from_a_%addr
[END_MACRO]

[MACRO] NET_IPV4_TRY_PARSE_ASCII %out_ok, %addr, %ptr, %len
    %out_ok = call @sa_net_ipv4_parse_ascii(&%ptr, %len, &%addr)
[END_MACRO]

[MACRO] NET_IPV4_PARSE_ASCII %out_ok, %addr, %ptr, %len
    EXPAND NET_IPV4_TRY_PARSE_ASCII %out_ok, %addr, %ptr, %len
[END_MACRO]

[MACRO] NET_IPV4_EQ %out_bool, %left, %right
    __net_ipv4_la_%out_bool = load %left+NetIpv4Addr_a as u8
    __net_ipv4_lb_%out_bool = load %left+NetIpv4Addr_b as u8
    __net_ipv4_lc_%out_bool = load %left+NetIpv4Addr_c as u8
    __net_ipv4_ld_%out_bool = load %left+NetIpv4Addr_d as u8
    __net_ipv4_ra_%out_bool = load %right+NetIpv4Addr_a as u8
    __net_ipv4_rb_%out_bool = load %right+NetIpv4Addr_b as u8
    __net_ipv4_rc_%out_bool = load %right+NetIpv4Addr_c as u8
    __net_ipv4_rd_%out_bool = load %right+NetIpv4Addr_d as u8
    __net_ipv4_ea_%out_bool = eq __net_ipv4_la_%out_bool, __net_ipv4_ra_%out_bool
    __net_ipv4_eb_%out_bool = eq __net_ipv4_lb_%out_bool, __net_ipv4_rb_%out_bool
    __net_ipv4_ec_%out_bool = eq __net_ipv4_lc_%out_bool, __net_ipv4_rc_%out_bool
    __net_ipv4_ed_%out_bool = eq __net_ipv4_ld_%out_bool, __net_ipv4_rd_%out_bool
    __net_ipv4_eab_%out_bool = and __net_ipv4_ea_%out_bool, __net_ipv4_eb_%out_bool
    __net_ipv4_ecd_%out_bool = and __net_ipv4_ec_%out_bool, __net_ipv4_ed_%out_bool
    %out_bool = and __net_ipv4_eab_%out_bool, __net_ipv4_ecd_%out_bool
    !__net_ipv4_ecd_%out_bool
    !__net_ipv4_eab_%out_bool
    !__net_ipv4_ed_%out_bool
    !__net_ipv4_ec_%out_bool
    !__net_ipv4_eb_%out_bool
    !__net_ipv4_ea_%out_bool
    !__net_ipv4_rd_%out_bool
    !__net_ipv4_rc_%out_bool
    !__net_ipv4_rb_%out_bool
    !__net_ipv4_ra_%out_bool
    !__net_ipv4_ld_%out_bool
    !__net_ipv4_lc_%out_bool
    !__net_ipv4_lb_%out_bool
    !__net_ipv4_la_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_UNSPECIFIED %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_c_%out_bool = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_d_%out_bool = load %addr+NetIpv4Addr_d as u8
    __net_ipv4_ab_%out_bool = or __net_ipv4_a_%out_bool, __net_ipv4_b_%out_bool
    __net_ipv4_cd_%out_bool = or __net_ipv4_c_%out_bool, __net_ipv4_d_%out_bool
    __net_ipv4_any_%out_bool = or __net_ipv4_ab_%out_bool, __net_ipv4_cd_%out_bool
    %out_bool = eq __net_ipv4_any_%out_bool, 0
    !__net_ipv4_any_%out_bool
    !__net_ipv4_cd_%out_bool
    !__net_ipv4_ab_%out_bool
    !__net_ipv4_d_%out_bool
    !__net_ipv4_c_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_LOOPBACK %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    %out_bool = eq __net_ipv4_a_%out_bool, 127
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_PRIVATE %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_is_10_%out_bool = eq __net_ipv4_a_%out_bool, 10
    __net_ipv4_is_172_%out_bool = eq __net_ipv4_a_%out_bool, 172
    __net_ipv4_172_lo_%out_bool = uge __net_ipv4_b_%out_bool, 16
    __net_ipv4_172_hi_%out_bool = ule __net_ipv4_b_%out_bool, 31
    __net_ipv4_172_range_%out_bool = and __net_ipv4_172_lo_%out_bool, __net_ipv4_172_hi_%out_bool
    __net_ipv4_172_private_%out_bool = and __net_ipv4_is_172_%out_bool, __net_ipv4_172_range_%out_bool
    __net_ipv4_is_192_%out_bool = eq __net_ipv4_a_%out_bool, 192
    __net_ipv4_is_168_%out_bool = eq __net_ipv4_b_%out_bool, 168
    __net_ipv4_192_private_%out_bool = and __net_ipv4_is_192_%out_bool, __net_ipv4_is_168_%out_bool
    __net_ipv4_left_%out_bool = or __net_ipv4_is_10_%out_bool, __net_ipv4_172_private_%out_bool
    %out_bool = or __net_ipv4_left_%out_bool, __net_ipv4_192_private_%out_bool
    !__net_ipv4_left_%out_bool
    !__net_ipv4_192_private_%out_bool
    !__net_ipv4_is_168_%out_bool
    !__net_ipv4_is_192_%out_bool
    !__net_ipv4_172_private_%out_bool
    !__net_ipv4_172_range_%out_bool
    !__net_ipv4_172_hi_%out_bool
    !__net_ipv4_172_lo_%out_bool
    !__net_ipv4_is_172_%out_bool
    !__net_ipv4_is_10_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_LINK_LOCAL %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_a_ok_%out_bool = eq __net_ipv4_a_%out_bool, 169
    __net_ipv4_b_ok_%out_bool = eq __net_ipv4_b_%out_bool, 254
    %out_bool = and __net_ipv4_a_ok_%out_bool, __net_ipv4_b_ok_%out_bool
    !__net_ipv4_b_ok_%out_bool
    !__net_ipv4_a_ok_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_SHARED %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_is_100_%out_bool = eq __net_ipv4_a_%out_bool, 100
    __net_ipv4_b_mask_%out_bool = and __net_ipv4_b_%out_bool, 192
    __net_ipv4_b_range_%out_bool = eq __net_ipv4_b_mask_%out_bool, 64
    %out_bool = and __net_ipv4_is_100_%out_bool, __net_ipv4_b_range_%out_bool
    !__net_ipv4_b_range_%out_bool
    !__net_ipv4_b_mask_%out_bool
    !__net_ipv4_is_100_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_BENCHMARKING %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_is_198_%out_bool = eq __net_ipv4_a_%out_bool, 198
    __net_ipv4_b_mask_%out_bool = and __net_ipv4_b_%out_bool, 254
    __net_ipv4_b_range_%out_bool = eq __net_ipv4_b_mask_%out_bool, 18
    %out_bool = and __net_ipv4_is_198_%out_bool, __net_ipv4_b_range_%out_bool
    !__net_ipv4_b_range_%out_bool
    !__net_ipv4_b_mask_%out_bool
    !__net_ipv4_is_198_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_RESERVED %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_mask_%out_bool = and __net_ipv4_a_%out_bool, 240
    __net_ipv4_reserved_range_%out_bool = eq __net_ipv4_mask_%out_bool, 240
    EXPAND NET_IPV4_IS_BROADCAST __net_ipv4_broadcast_%out_bool, %addr
    __net_ipv4_not_broadcast_%out_bool = eq __net_ipv4_broadcast_%out_bool, 0
    %out_bool = and __net_ipv4_reserved_range_%out_bool, __net_ipv4_not_broadcast_%out_bool
    !__net_ipv4_not_broadcast_%out_bool
    !__net_ipv4_broadcast_%out_bool
    !__net_ipv4_reserved_range_%out_bool
    !__net_ipv4_mask_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_MULTICAST %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_lo_%out_bool = uge __net_ipv4_a_%out_bool, 224
    __net_ipv4_hi_%out_bool = ule __net_ipv4_a_%out_bool, 239
    %out_bool = and __net_ipv4_lo_%out_bool, __net_ipv4_hi_%out_bool
    !__net_ipv4_hi_%out_bool
    !__net_ipv4_lo_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_BROADCAST %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_c_%out_bool = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_d_%out_bool = load %addr+NetIpv4Addr_d as u8
    __net_ipv4_ea_%out_bool = eq __net_ipv4_a_%out_bool, 255
    __net_ipv4_eb_%out_bool = eq __net_ipv4_b_%out_bool, 255
    __net_ipv4_ec_%out_bool = eq __net_ipv4_c_%out_bool, 255
    __net_ipv4_ed_%out_bool = eq __net_ipv4_d_%out_bool, 255
    __net_ipv4_eab_%out_bool = and __net_ipv4_ea_%out_bool, __net_ipv4_eb_%out_bool
    __net_ipv4_ecd_%out_bool = and __net_ipv4_ec_%out_bool, __net_ipv4_ed_%out_bool
    %out_bool = and __net_ipv4_eab_%out_bool, __net_ipv4_ecd_%out_bool
    !__net_ipv4_ecd_%out_bool
    !__net_ipv4_eab_%out_bool
    !__net_ipv4_ed_%out_bool
    !__net_ipv4_ec_%out_bool
    !__net_ipv4_eb_%out_bool
    !__net_ipv4_ea_%out_bool
    !__net_ipv4_d_%out_bool
    !__net_ipv4_c_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_DOCUMENTATION %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_c_%out_bool = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_192_%out_bool = eq __net_ipv4_a_%out_bool, 192
    __net_ipv4_0_%out_bool = eq __net_ipv4_b_%out_bool, 0
    __net_ipv4_2_%out_bool = eq __net_ipv4_c_%out_bool, 2
    __net_ipv4_doc1a_%out_bool = and __net_ipv4_192_%out_bool, __net_ipv4_0_%out_bool
    __net_ipv4_doc1_%out_bool = and __net_ipv4_doc1a_%out_bool, __net_ipv4_2_%out_bool
    __net_ipv4_198_%out_bool = eq __net_ipv4_a_%out_bool, 198
    __net_ipv4_51_%out_bool = eq __net_ipv4_b_%out_bool, 51
    __net_ipv4_100_%out_bool = eq __net_ipv4_c_%out_bool, 100
    __net_ipv4_doc2a_%out_bool = and __net_ipv4_198_%out_bool, __net_ipv4_51_%out_bool
    __net_ipv4_doc2_%out_bool = and __net_ipv4_doc2a_%out_bool, __net_ipv4_100_%out_bool
    __net_ipv4_203_%out_bool = eq __net_ipv4_a_%out_bool, 203
    __net_ipv4_113_%out_bool = eq __net_ipv4_c_%out_bool, 113
    __net_ipv4_doc3a_%out_bool = and __net_ipv4_203_%out_bool, __net_ipv4_0_%out_bool
    __net_ipv4_doc3_%out_bool = and __net_ipv4_doc3a_%out_bool, __net_ipv4_113_%out_bool
    __net_ipv4_left_%out_bool = or __net_ipv4_doc1_%out_bool, __net_ipv4_doc2_%out_bool
    %out_bool = or __net_ipv4_left_%out_bool, __net_ipv4_doc3_%out_bool
    !__net_ipv4_left_%out_bool
    !__net_ipv4_doc3_%out_bool
    !__net_ipv4_doc3a_%out_bool
    !__net_ipv4_113_%out_bool
    !__net_ipv4_203_%out_bool
    !__net_ipv4_doc2_%out_bool
    !__net_ipv4_doc2a_%out_bool
    !__net_ipv4_100_%out_bool
