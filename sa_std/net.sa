[MACRO] NET_SOCKET_ADDR_EQ %out_bool, %left, %right
    __net_sock_eq_ltag_%out_bool = load %left+NetSocketAddr_tag as u64
    __net_sock_eq_rtag_%out_bool = load %right+NetSocketAddr_tag as u64
    __net_sock_eq_same_tag_%out_bool = eq __net_sock_eq_ltag_%out_bool, __net_sock_eq_rtag_%out_bool
    br __net_sock_eq_same_tag_%out_bool -> L_NET_SOCKET_EQ_SAME_%out_bool, L_NET_SOCKET_EQ_DIFF_%out_bool
L_NET_SOCKET_EQ_DIFF_%out_bool:
    %out_bool = add 0, 0
    jmp L_NET_SOCKET_EQ_DONE_%out_bool
L_NET_SOCKET_EQ_SAME_%out_bool:
    __net_sock_eq_lpayload_%out_bool = ptr_add %left, 8
    __net_sock_eq_rpayload_%out_bool = ptr_add %right, 8
    __net_sock_eq_is_v4_%out_bool = eq __net_sock_eq_ltag_%out_bool, NET_IP_ADDR_V4
    br __net_sock_eq_is_v4_%out_bool -> L_NET_SOCKET_EQ_V4_%out_bool, L_NET_SOCKET_EQ_V6_%out_bool
L_NET_SOCKET_EQ_V4_%out_bool:
    EXPAND NET_SOCKET_ADDR_V4_EQ %out_bool, __net_sock_eq_lpayload_%out_bool, __net_sock_eq_rpayload_%out_bool
    jmp L_NET_SOCKET_EQ_SAME_DONE_%out_bool
L_NET_SOCKET_EQ_V6_%out_bool:
    EXPAND NET_SOCKET_ADDR_V6_EQ %out_bool, __net_sock_eq_lpayload_%out_bool, __net_sock_eq_rpayload_%out_bool
    jmp L_NET_SOCKET_EQ_SAME_DONE_%out_bool
L_NET_SOCKET_EQ_SAME_DONE_%out_bool:
    !__net_sock_eq_is_v4_%out_bool
    !__net_sock_eq_rpayload_%out_bool
    !__net_sock_eq_lpayload_%out_bool
    jmp L_NET_SOCKET_EQ_DONE_%out_bool
L_NET_SOCKET_EQ_DONE_%out_bool:
    !__net_sock_eq_same_tag_%out_bool
    !__net_sock_eq_rtag_%out_bool
    !__net_sock_eq_ltag_%out_bool
[END_MACRO]

[MACRO] NET_SOCKET_ADDR_NEW %socket_addr, %ipaddr, %port
    __net_sock_new_tag_%socket_addr = load %ipaddr+NetIpAddr_tag as u64
    __net_sock_new_payload_%socket_addr = ptr_add %socket_addr, 8
    __net_sock_new_ip_payload_%socket_addr = ptr_add %ipaddr, 8
    store %socket_addr+NetSocketAddr_tag, __net_sock_new_tag_%socket_addr as u64
    __net_sock_new_is_v4_%socket_addr = eq __net_sock_new_tag_%socket_addr, NET_IP_ADDR_V4
    br __net_sock_new_is_v4_%socket_addr -> L_NET_SOCKET_NEW_V4_%socket_addr_%ipaddr, L_NET_SOCKET_NEW_V6_%socket_addr_%ipaddr
L_NET_SOCKET_NEW_V4_%socket_addr_%ipaddr:
    EXPAND NET_SOCKET_ADDR_V4_NEW __net_sock_new_payload_%socket_addr, __net_sock_new_ip_payload_%socket_addr, %port
    jmp L_NET_SOCKET_NEW_DONE_%socket_addr_%ipaddr
L_NET_SOCKET_NEW_V6_%socket_addr_%ipaddr:
    EXPAND NET_SOCKET_ADDR_V6_NEW __net_sock_new_payload_%socket_addr, __net_sock_new_ip_payload_%socket_addr, %port, 0, 0
    jmp L_NET_SOCKET_NEW_DONE_%socket_addr_%ipaddr
L_NET_SOCKET_NEW_DONE_%socket_addr_%ipaddr:
    !__net_sock_new_is_v4_%socket_addr
    !__net_sock_new_ip_payload_%socket_addr
    !__net_sock_new_payload_%socket_addr
    !__net_sock_new_tag_%socket_addr
[END_MACRO]

[MACRO] NET_SOCKET_ADDR_IP %out_ipaddr, %socket_addr
    __net_sock_ip_tag_%out_ipaddr = load %socket_addr+NetSocketAddr_tag as u64
    __net_sock_ip_payload_%out_ipaddr = ptr_add %socket_addr, 8
    __net_sock_ip_is_v4_%out_ipaddr = eq __net_sock_ip_tag_%out_ipaddr, NET_IP_ADDR_V4
    br __net_sock_ip_is_v4_%out_ipaddr -> L_NET_SOCKET_IP_V4_%out_ipaddr, L_NET_SOCKET_IP_V6_%out_ipaddr
L_NET_SOCKET_IP_V4_%out_ipaddr:
    EXPAND NET_SOCKET_ADDR_V4_IP_PTR __net_sock_ip_v4_%out_ipaddr, __net_sock_ip_payload_%out_ipaddr
    EXPAND NET_IP_ADDR_V4_NEW %out_ipaddr, __net_sock_ip_v4_%out_ipaddr
    !__net_sock_ip_v4_%out_ipaddr
    jmp L_NET_SOCKET_IP_DONE_%out_ipaddr
L_NET_SOCKET_IP_V6_%out_ipaddr:
    EXPAND NET_SOCKET_ADDR_V6_IP_PTR __net_sock_ip_v6_%out_ipaddr, __net_sock_ip_payload_%out_ipaddr
    EXPAND NET_IP_ADDR_V6_NEW %out_ipaddr, __net_sock_ip_v6_%out_ipaddr
    !__net_sock_ip_v6_%out_ipaddr
    jmp L_NET_SOCKET_IP_DONE_%out_ipaddr
L_NET_SOCKET_IP_DONE_%out_ipaddr:
    !__net_sock_ip_is_v4_%out_ipaddr
    !__net_sock_ip_payload_%out_ipaddr
    !__net_sock_ip_tag_%out_ipaddr
[END_MACRO]

[MACRO] NET_SOCKET_ADDR_PORT %out_port, %socket_addr
    __net_sock_port_tag_%out_port = load %socket_addr+NetSocketAddr_tag as u64
    __net_sock_port_payload_%out_port = ptr_add %socket_addr, 8
    __net_sock_port_is_v4_%out_port = eq __net_sock_port_tag_%out_port, NET_IP_ADDR_V4
    br __net_sock_port_is_v4_%out_port -> L_NET_SOCKET_PORT_V4_%out_port, L_NET_SOCKET_PORT_V6_%out_port
L_NET_SOCKET_PORT_V4_%out_port:
    EXPAND NET_SOCKET_ADDR_V4_PORT %out_port, __net_sock_port_payload_%out_port
    jmp L_NET_SOCKET_PORT_DONE_%out_port
L_NET_SOCKET_PORT_V6_%out_port:
    EXPAND NET_SOCKET_ADDR_V6_PORT %out_port, __net_sock_port_payload_%out_port
    jmp L_NET_SOCKET_PORT_DONE_%out_port
L_NET_SOCKET_PORT_DONE_%out_port:
    !__net_sock_port_is_v4_%out_port
    !__net_sock_port_payload_%out_port
    !__net_sock_port_tag_%out_port
[END_MACRO]

[MACRO] NET_SOCKET_ADDR_SET_PORT %socket_addr, %port
    __net_sock_set_port_tag_%socket_addr = load %socket_addr+NetSocketAddr_tag as u64
    __net_sock_set_port_payload_%socket_addr = ptr_add %socket_addr, 8
    __net_sock_set_port_is_v4_%socket_addr = eq __net_sock_set_port_tag_%socket_addr, NET_IP_ADDR_V4
    br __net_sock_set_port_is_v4_%socket_addr -> L_NET_SOCKET_SET_PORT_V4_%socket_addr, L_NET_SOCKET_SET_PORT_V6_%socket_addr
L_NET_SOCKET_SET_PORT_V4_%socket_addr:
    EXPAND NET_SOCKET_ADDR_V4_SET_PORT __net_sock_set_port_payload_%socket_addr, %port
    jmp L_NET_SOCKET_SET_PORT_DONE_%socket_addr
L_NET_SOCKET_SET_PORT_V6_%socket_addr:
    EXPAND NET_SOCKET_ADDR_V6_SET_PORT __net_sock_set_port_payload_%socket_addr, %port
    jmp L_NET_SOCKET_SET_PORT_DONE_%socket_addr
L_NET_SOCKET_SET_PORT_DONE_%socket_addr:
    !__net_sock_set_port_is_v4_%socket_addr
    !__net_sock_set_port_payload_%socket_addr
    !__net_sock_set_port_tag_%socket_addr
[END_MACRO]

[MACRO] NET_SOCKET_ADDR_SET_IP %socket_addr, %ipaddr
    EXPAND NET_SOCKET_ADDR_PORT __net_sock_set_ip_port_%socket_addr, %socket_addr
    EXPAND NET_SOCKET_ADDR_NEW %socket_addr, %ipaddr, __net_sock_set_ip_port_%socket_addr
    !__net_sock_set_ip_port_%socket_addr
[END_MACRO]
