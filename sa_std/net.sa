    !__net_ipv4_doc1a_%out_bool
    !__net_ipv4_2_%out_bool
    !__net_ipv4_0_%out_bool
    !__net_ipv4_192_%out_bool
    !__net_ipv4_c_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_IS_GLOBAL %out_bool, %addr
    __net_ipv4_a_%out_bool = load %addr+NetIpv4Addr_a as u8
    __net_ipv4_b_%out_bool = load %addr+NetIpv4Addr_b as u8
    __net_ipv4_c_%out_bool = load %addr+NetIpv4Addr_c as u8
    __net_ipv4_d_%out_bool = load %addr+NetIpv4Addr_d as u8
    __net_ipv4_this_network_%out_bool = eq __net_ipv4_a_%out_bool, 0
    EXPAND NET_IPV4_IS_PRIVATE __net_ipv4_private_%out_bool, %addr
    EXPAND NET_IPV4_IS_SHARED __net_ipv4_shared_%out_bool, %addr
    EXPAND NET_IPV4_IS_LOOPBACK __net_ipv4_loopback_%out_bool, %addr
    EXPAND NET_IPV4_IS_LINK_LOCAL __net_ipv4_link_%out_bool, %addr
    __net_ipv4_192_%out_bool = eq __net_ipv4_a_%out_bool, 192
    __net_ipv4_0_%out_bool = eq __net_ipv4_b_%out_bool, 0
    __net_ipv4_0c_%out_bool = eq __net_ipv4_c_%out_bool, 0
    __net_ipv4_d_not_9_%out_bool = ne __net_ipv4_d_%out_bool, 9
    __net_ipv4_d_not_10_%out_bool = ne __net_ipv4_d_%out_bool, 10
    __net_ipv4_d_excluded_%out_bool = and __net_ipv4_d_not_9_%out_bool, __net_ipv4_d_not_10_%out_bool
    __net_ipv4_proto0a_%out_bool = and __net_ipv4_192_%out_bool, __net_ipv4_0_%out_bool
    __net_ipv4_proto0b_%out_bool = and __net_ipv4_proto0a_%out_bool, __net_ipv4_0c_%out_bool
    __net_ipv4_proto0_%out_bool = and __net_ipv4_proto0b_%out_bool, __net_ipv4_d_excluded_%out_bool
    EXPAND NET_IPV4_IS_DOCUMENTATION __net_ipv4_doc_%out_bool, %addr
    EXPAND NET_IPV4_IS_BENCHMARKING __net_ipv4_bench_%out_bool, %addr
    EXPAND NET_IPV4_IS_RESERVED __net_ipv4_reserved_%out_bool, %addr
    EXPAND NET_IPV4_IS_BROADCAST __net_ipv4_broadcast_%out_bool, %addr
    __net_ipv4_ng01_%out_bool = or __net_ipv4_this_network_%out_bool, __net_ipv4_private_%out_bool
    __net_ipv4_ng02_%out_bool = or __net_ipv4_ng01_%out_bool, __net_ipv4_shared_%out_bool
    __net_ipv4_ng03_%out_bool = or __net_ipv4_ng02_%out_bool, __net_ipv4_loopback_%out_bool
    __net_ipv4_ng04_%out_bool = or __net_ipv4_ng03_%out_bool, __net_ipv4_link_%out_bool
    __net_ipv4_ng05_%out_bool = or __net_ipv4_ng04_%out_bool, __net_ipv4_proto0_%out_bool
    __net_ipv4_ng06_%out_bool = or __net_ipv4_ng05_%out_bool, __net_ipv4_doc_%out_bool
    __net_ipv4_ng07_%out_bool = or __net_ipv4_ng06_%out_bool, __net_ipv4_bench_%out_bool
    __net_ipv4_ng08_%out_bool = or __net_ipv4_ng07_%out_bool, __net_ipv4_reserved_%out_bool
    __net_ipv4_not_global_%out_bool = or __net_ipv4_ng08_%out_bool, __net_ipv4_broadcast_%out_bool
    %out_bool = eq __net_ipv4_not_global_%out_bool, 0
    !__net_ipv4_not_global_%out_bool
    !__net_ipv4_ng08_%out_bool
    !__net_ipv4_ng07_%out_bool
    !__net_ipv4_ng06_%out_bool
    !__net_ipv4_ng05_%out_bool
    !__net_ipv4_ng04_%out_bool
    !__net_ipv4_ng03_%out_bool
    !__net_ipv4_ng02_%out_bool
    !__net_ipv4_ng01_%out_bool
    !__net_ipv4_broadcast_%out_bool
    !__net_ipv4_reserved_%out_bool
    !__net_ipv4_bench_%out_bool
    !__net_ipv4_doc_%out_bool
    !__net_ipv4_proto0_%out_bool
    !__net_ipv4_proto0b_%out_bool
    !__net_ipv4_proto0a_%out_bool
    !__net_ipv4_d_excluded_%out_bool
    !__net_ipv4_d_not_10_%out_bool
    !__net_ipv4_d_not_9_%out_bool
    !__net_ipv4_0c_%out_bool
    !__net_ipv4_0_%out_bool
    !__net_ipv4_192_%out_bool
    !__net_ipv4_link_%out_bool
    !__net_ipv4_loopback_%out_bool
    !__net_ipv4_shared_%out_bool
    !__net_ipv4_private_%out_bool
    !__net_ipv4_this_network_%out_bool
    !__net_ipv4_d_%out_bool
    !__net_ipv4_c_%out_bool
    !__net_ipv4_b_%out_bool
    !__net_ipv4_a_%out_bool
[END_MACRO]

[MACRO] NET_IPV4_TO_IPV6_COMPATIBLE %ipv6, %ipv4
    __net_ipv4_compat_a_%ipv6 = load %ipv4+NetIpv4Addr_a as u8
    __net_ipv4_compat_b_%ipv6 = load %ipv4+NetIpv4Addr_b as u8
    __net_ipv4_compat_c_%ipv6 = load %ipv4+NetIpv4Addr_c as u8
    __net_ipv4_compat_d_%ipv6 = load %ipv4+NetIpv4Addr_d as u8
    __net_ipv4_compat_ab_%ipv6 = shl __net_ipv4_compat_a_%ipv6, 8
    __net_ipv4_compat_s6_%ipv6 = or __net_ipv4_compat_ab_%ipv6, __net_ipv4_compat_b_%ipv6
    __net_ipv4_compat_cd_%ipv6 = shl __net_ipv4_compat_c_%ipv6, 8
    __net_ipv4_compat_s7_%ipv6 = or __net_ipv4_compat_cd_%ipv6, __net_ipv4_compat_d_%ipv6
    EXPAND NET_IPV6_NEW %ipv6, 0, 0, 0, 0, 0, 0, __net_ipv4_compat_s6_%ipv6, __net_ipv4_compat_s7_%ipv6
    !__net_ipv4_compat_s7_%ipv6
    !__net_ipv4_compat_cd_%ipv6
    !__net_ipv4_compat_s6_%ipv6
    !__net_ipv4_compat_ab_%ipv6
    !__net_ipv4_compat_d_%ipv6
    !__net_ipv4_compat_c_%ipv6
    !__net_ipv4_compat_b_%ipv6
    !__net_ipv4_compat_a_%ipv6
[END_MACRO]

[MACRO] NET_IPV4_TO_IPV6_MAPPED %ipv6, %ipv4
    __net_ipv4_mapped_a_%ipv6 = load %ipv4+NetIpv4Addr_a as u8
    __net_ipv4_mapped_b_%ipv6 = load %ipv4+NetIpv4Addr_b as u8
    __net_ipv4_mapped_c_%ipv6 = load %ipv4+NetIpv4Addr_c as u8
    __net_ipv4_mapped_d_%ipv6 = load %ipv4+NetIpv4Addr_d as u8
    __net_ipv4_mapped_ab_%ipv6 = shl __net_ipv4_mapped_a_%ipv6, 8
    __net_ipv4_mapped_s6_%ipv6 = or __net_ipv4_mapped_ab_%ipv6, __net_ipv4_mapped_b_%ipv6
    __net_ipv4_mapped_cd_%ipv6 = shl __net_ipv4_mapped_c_%ipv6, 8
    __net_ipv4_mapped_s7_%ipv6 = or __net_ipv4_mapped_cd_%ipv6, __net_ipv4_mapped_d_%ipv6
    EXPAND NET_IPV6_NEW %ipv6, 0, 0, 0, 0, 0, 65535, __net_ipv4_mapped_s6_%ipv6, __net_ipv4_mapped_s7_%ipv6
    !__net_ipv4_mapped_s7_%ipv6
    !__net_ipv4_mapped_cd_%ipv6
    !__net_ipv4_mapped_s6_%ipv6
    !__net_ipv4_mapped_ab_%ipv6
    !__net_ipv4_mapped_d_%ipv6
    !__net_ipv4_mapped_c_%ipv6
    !__net_ipv4_mapped_b_%ipv6
    !__net_ipv4_mapped_a_%ipv6
[END_MACRO]

[MACRO] NET_IPV6_NEW %addr, %s0, %s1, %s2, %s3, %s4, %s5, %s6, %s7
    store %addr+NetIpv6Addr_s0, %s0 as u16
    store %addr+NetIpv6Addr_s1, %s1 as u16
    store %addr+NetIpv6Addr_s2, %s2 as u16
    store %addr+NetIpv6Addr_s3, %s3 as u16
    store %addr+NetIpv6Addr_s4, %s4 as u16
    store %addr+NetIpv6Addr_s5, %s5 as u16
    store %addr+NetIpv6Addr_s6, %s6 as u16
    store %addr+NetIpv6Addr_s7, %s7 as u16
[END_MACRO]

[MACRO] NET_IPV6_SEGMENTS %out_s0, %out_s1, %out_s2, %out_s3, %out_s4, %out_s5, %out_s6, %out_s7, %addr
    %out_s0 = load %addr+NetIpv6Addr_s0 as u16
    %out_s1 = load %addr+NetIpv6Addr_s1 as u16
    %out_s2 = load %addr+NetIpv6Addr_s2 as u16
    %out_s3 = load %addr+NetIpv6Addr_s3 as u16
    %out_s4 = load %addr+NetIpv6Addr_s4 as u16
    %out_s5 = load %addr+NetIpv6Addr_s5 as u16
    %out_s6 = load %addr+NetIpv6Addr_s6 as u16
    %out_s7 = load %addr+NetIpv6Addr_s7 as u16
[END_MACRO]

[MACRO] NET_IPV6_FROM_SEGMENTS %addr, %s0, %s1, %s2, %s3, %s4, %s5, %s6, %s7
    EXPAND NET_IPV6_NEW %addr, %s0, %s1, %s2, %s3, %s4, %s5, %s6, %s7
[END_MACRO]

[MACRO] NET_IPV6_UNSPECIFIED %addr
    EXPAND NET_IPV6_NEW %addr, 0, 0, 0, 0, 0, 0, 0, 0
[END_MACRO]

[MACRO] NET_IPV6_LOCALHOST %addr
    EXPAND NET_IPV6_NEW %addr, 0, 0, 0, 0, 0, 0, 0, 1
[END_MACRO]

[MACRO] NET_IPV6_BITS %out_bits
    %out_bits = add 0, NET_IPV6_BITS_VALUE
[END_MACRO]

[MACRO] NET_IPV6_OCTETS %out_b0, %out_b1, %out_b2, %out_b3, %out_b4, %out_b5, %out_b6, %out_b7, %out_b8, %out_b9, %out_b10, %out_b11, %out_b12, %out_b13, %out_b14, %out_b15, %addr
    __net_ipv6_oct_s0_%out_b0 = load %addr+NetIpv6Addr_s0 as u16
    __net_ipv6_oct_s1_%out_b0 = load %addr+NetIpv6Addr_s1 as u16
    __net_ipv6_oct_s2_%out_b0 = load %addr+NetIpv6Addr_s2 as u16
    __net_ipv6_oct_s3_%out_b0 = load %addr+NetIpv6Addr_s3 as u16
    __net_ipv6_oct_s4_%out_b0 = load %addr+NetIpv6Addr_s4 as u16
    __net_ipv6_oct_s5_%out_b0 = load %addr+NetIpv6Addr_s5 as u16
    __net_ipv6_oct_s6_%out_b0 = load %addr+NetIpv6Addr_s6 as u16
    __net_ipv6_oct_s7_%out_b0 = load %addr+NetIpv6Addr_s7 as u16
    %out_b0 = lshr __net_ipv6_oct_s0_%out_b0, 8
    %out_b1 = and __net_ipv6_oct_s0_%out_b0, 255
    %out_b2 = lshr __net_ipv6_oct_s1_%out_b0, 8
    %out_b3 = and __net_ipv6_oct_s1_%out_b0, 255
    %out_b4 = lshr __net_ipv6_oct_s2_%out_b0, 8
    %out_b5 = and __net_ipv6_oct_s2_%out_b0, 255
    %out_b6 = lshr __net_ipv6_oct_s3_%out_b0, 8
    %out_b7 = and __net_ipv6_oct_s3_%out_b0, 255
    %out_b8 = lshr __net_ipv6_oct_s4_%out_b0, 8
    %out_b9 = and __net_ipv6_oct_s4_%out_b0, 255
    %out_b10 = lshr __net_ipv6_oct_s5_%out_b0, 8
    %out_b11 = and __net_ipv6_oct_s5_%out_b0, 255
    %out_b12 = lshr __net_ipv6_oct_s6_%out_b0, 8
    %out_b13 = and __net_ipv6_oct_s6_%out_b0, 255
    %out_b14 = lshr __net_ipv6_oct_s7_%out_b0, 8
    %out_b15 = and __net_ipv6_oct_s7_%out_b0, 255
    !__net_ipv6_oct_s7_%out_b0
    !__net_ipv6_oct_s6_%out_b0
    !__net_ipv6_oct_s5_%out_b0
    !__net_ipv6_oct_s4_%out_b0
    !__net_ipv6_oct_s3_%out_b0
    !__net_ipv6_oct_s2_%out_b0
    !__net_ipv6_oct_s1_%out_b0
    !__net_ipv6_oct_s0_%out_b0
[END_MACRO]

[MACRO] NET_IPV6_WRITE_OCTETS %out_ok, %dst_ptr, %dst_len, %addr
    __net_ipv6_write_fits_%out_ok = uge %dst_len, 16
    br __net_ipv6_write_fits_%out_ok -> L_NET_IPV6_WRITE_OCTETS_OK_%out_ok, L_NET_IPV6_WRITE_OCTETS_FAIL_%out_ok

L_NET_IPV6_WRITE_OCTETS_OK_%out_ok:
    EXPAND NET_IPV6_OCTETS __net_ipv6_write_b0_%out_ok, __net_ipv6_write_b1_%out_ok, __net_ipv6_write_b2_%out_ok, __net_ipv6_write_b3_%out_ok, __net_ipv6_write_b4_%out_ok, __net_ipv6_write_b5_%out_ok, __net_ipv6_write_b6_%out_ok, __net_ipv6_write_b7_%out_ok, __net_ipv6_write_b8_%out_ok, __net_ipv6_write_b9_%out_ok, __net_ipv6_write_b10_%out_ok, __net_ipv6_write_b11_%out_ok, __net_ipv6_write_b12_%out_ok, __net_ipv6_write_b13_%out_ok, __net_ipv6_write_b14_%out_ok, __net_ipv6_write_b15_%out_ok, %addr
    store %dst_ptr+0, __net_ipv6_write_b0_%out_ok as u8
    __net_ipv6_write_p1_%out_ok = ptr_add %dst_ptr, 1
    __net_ipv6_write_p2_%out_ok = ptr_add %dst_ptr, 2
    __net_ipv6_write_p3_%out_ok = ptr_add %dst_ptr, 3
    __net_ipv6_write_p4_%out_ok = ptr_add %dst_ptr, 4
    __net_ipv6_write_p5_%out_ok = ptr_add %dst_ptr, 5
    __net_ipv6_write_p6_%out_ok = ptr_add %dst_ptr, 6
    __net_ipv6_write_p7_%out_ok = ptr_add %dst_ptr, 7
    __net_ipv6_write_p8_%out_ok = ptr_add %dst_ptr, 8
    __net_ipv6_write_p9_%out_ok = ptr_add %dst_ptr, 9
    __net_ipv6_write_p10_%out_ok = ptr_add %dst_ptr, 10
    __net_ipv6_write_p11_%out_ok = ptr_add %dst_ptr, 11
    __net_ipv6_write_p12_%out_ok = ptr_add %dst_ptr, 12
    __net_ipv6_write_p13_%out_ok = ptr_add %dst_ptr, 13
    __net_ipv6_write_p14_%out_ok = ptr_add %dst_ptr, 14
    __net_ipv6_write_p15_%out_ok = ptr_add %dst_ptr, 15
    store __net_ipv6_write_p1_%out_ok+0, __net_ipv6_write_b1_%out_ok as u8
    store __net_ipv6_write_p2_%out_ok+0, __net_ipv6_write_b2_%out_ok as u8
    store __net_ipv6_write_p3_%out_ok+0, __net_ipv6_write_b3_%out_ok as u8
    store __net_ipv6_write_p4_%out_ok+0, __net_ipv6_write_b4_%out_ok as u8
    store __net_ipv6_write_p5_%out_ok+0, __net_ipv6_write_b5_%out_ok as u8
    store __net_ipv6_write_p6_%out_ok+0, __net_ipv6_write_b6_%out_ok as u8
    store __net_ipv6_write_p7_%out_ok+0, __net_ipv6_write_b7_%out_ok as u8
    store __net_ipv6_write_p8_%out_ok+0, __net_ipv6_write_b8_%out_ok as u8
    store __net_ipv6_write_p9_%out_ok+0, __net_ipv6_write_b9_%out_ok as u8
    store __net_ipv6_write_p10_%out_ok+0, __net_ipv6_write_b10_%out_ok as u8
    store __net_ipv6_write_p11_%out_ok+0, __net_ipv6_write_b11_%out_ok as u8
    store __net_ipv6_write_p12_%out_ok+0, __net_ipv6_write_b12_%out_ok as u8
    store __net_ipv6_write_p13_%out_ok+0, __net_ipv6_write_b13_%out_ok as u8
    store __net_ipv6_write_p14_%out_ok+0, __net_ipv6_write_b14_%out_ok as u8
    store __net_ipv6_write_p15_%out_ok+0, __net_ipv6_write_b15_%out_ok as u8
    %out_ok = add 0, 1
    !__net_ipv6_write_p15_%out_ok
    !__net_ipv6_write_p14_%out_ok
    !__net_ipv6_write_p13_%out_ok
    !__net_ipv6_write_p12_%out_ok
    !__net_ipv6_write_p11_%out_ok
    !__net_ipv6_write_p10_%out_ok
    !__net_ipv6_write_p9_%out_ok
    !__net_ipv6_write_p8_%out_ok
    !__net_ipv6_write_p7_%out_ok
    !__net_ipv6_write_p6_%out_ok
    !__net_ipv6_write_p5_%out_ok
    !__net_ipv6_write_p4_%out_ok
    !__net_ipv6_write_p3_%out_ok
    !__net_ipv6_write_p2_%out_ok
    !__net_ipv6_write_p1_%out_ok
    !__net_ipv6_write_b15_%out_ok
    !__net_ipv6_write_b14_%out_ok
    !__net_ipv6_write_b13_%out_ok
    !__net_ipv6_write_b12_%out_ok
    !__net_ipv6_write_b11_%out_ok
    !__net_ipv6_write_b10_%out_ok
    !__net_ipv6_write_b9_%out_ok
    !__net_ipv6_write_b8_%out_ok
    !__net_ipv6_write_b7_%out_ok
    !__net_ipv6_write_b6_%out_ok
    !__net_ipv6_write_b5_%out_ok
    !__net_ipv6_write_b4_%out_ok
    !__net_ipv6_write_b3_%out_ok
    !__net_ipv6_write_b2_%out_ok
    !__net_ipv6_write_b1_%out_ok
    !__net_ipv6_write_b0_%out_ok
    !__net_ipv6_write_fits_%out_ok
    jmp L_NET_IPV6_WRITE_OCTETS_END_%out_ok

L_NET_IPV6_WRITE_OCTETS_FAIL_%out_ok:
    %out_ok = add 0, 0
    !__net_ipv6_write_fits_%out_ok

L_NET_IPV6_WRITE_OCTETS_END_%out_ok:
[END_MACRO]

[MACRO] NET_IPV6_FROM_OCTETS %addr, %b0, %b1, %b2, %b3, %b4, %b5, %b6, %b7, %b8, %b9, %b10, %b11, %b12, %b13, %b14, %b15
    __net_ipv6_from_oct_s0_hi_%addr = shl %b0, 8
    __net_ipv6_from_oct_s0_%addr = or __net_ipv6_from_oct_s0_hi_%addr, %b1
    __net_ipv6_from_oct_s1_hi_%addr = shl %b2, 8
    __net_ipv6_from_oct_s1_%addr = or __net_ipv6_from_oct_s1_hi_%addr, %b3
    __net_ipv6_from_oct_s2_hi_%addr = shl %b4, 8
    __net_ipv6_from_oct_s2_%addr = or __net_ipv6_from_oct_s2_hi_%addr, %b5
    __net_ipv6_from_oct_s3_hi_%addr = shl %b6, 8
    __net_ipv6_from_oct_s3_%addr = or __net_ipv6_from_oct_s3_hi_%addr, %b7
    __net_ipv6_from_oct_s4_hi_%addr = shl %b8, 8
    __net_ipv6_from_oct_s4_%addr = or __net_ipv6_from_oct_s4_hi_%addr, %b9
    __net_ipv6_from_oct_s5_hi_%addr = shl %b10, 8
    __net_ipv6_from_oct_s5_%addr = or __net_ipv6_from_oct_s5_hi_%addr, %b11
    __net_ipv6_from_oct_s6_hi_%addr = shl %b12, 8
    __net_ipv6_from_oct_s6_%addr = or __net_ipv6_from_oct_s6_hi_%addr, %b13
    __net_ipv6_from_oct_s7_hi_%addr = shl %b14, 8
    __net_ipv6_from_oct_s7_%addr = or __net_ipv6_from_oct_s7_hi_%addr, %b15
    EXPAND NET_IPV6_NEW %addr, __net_ipv6_from_oct_s0_%addr, __net_ipv6_from_oct_s1_%addr, __net_ipv6_from_oct_s2_%addr, __net_ipv6_from_oct_s3_%addr, __net_ipv6_from_oct_s4_%addr, __net_ipv6_from_oct_s5_%addr, __net_ipv6_from_oct_s6_%addr, __net_ipv6_from_oct_s7_%addr
    !__net_ipv6_from_oct_s7_%addr
    !__net_ipv6_from_oct_s7_hi_%addr
    !__net_ipv6_from_oct_s6_%addr
    !__net_ipv6_from_oct_s6_hi_%addr
    !__net_ipv6_from_oct_s5_%addr
    !__net_ipv6_from_oct_s5_hi_%addr
    !__net_ipv6_from_oct_s4_%addr
    !__net_ipv6_from_oct_s4_hi_%addr
    !__net_ipv6_from_oct_s3_%addr
    !__net_ipv6_from_oct_s3_hi_%addr
    !__net_ipv6_from_oct_s2_%addr
    !__net_ipv6_from_oct_s2_hi_%addr
    !__net_ipv6_from_oct_s1_%addr
    !__net_ipv6_from_oct_s1_hi_%addr
    !__net_ipv6_from_oct_s0_%addr
