    EXPAND NET_SOCKET_ADDR_V4_NEW __net_sock_from_v4_ip_%socket_addr, __net_sock_from_v4_src_%socket_addr, 0
    __net_sock_from_v4_port_%socket_addr = load %socket_v4+NetSocketAddrV4_port as u16
