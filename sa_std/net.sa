    EXPAND NET_SOCKET_ADDR_V6_IP_PTR __net_sock_v6_eq_lip_%out_bool, %left
    EXPAND NET_SOCKET_ADDR_V6_IP_PTR __net_sock_v6_eq_rip_%out_bool, %right
