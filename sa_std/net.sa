[MACRO] NET_ADDR_IS_IPV4 %out_flag, %addr
    __net_addr_family_%out_flag = call @sa_net_addr_family(%addr)
    %out_flag = eq __net_addr_family_%out_flag, SA_NET_AF_INET
    !__net_addr_family_%out_flag
[END_MACRO]

[MACRO] NET_ADDR_IS_IPV6 %out_flag, %addr
    __net_addr_family_%out_flag = call @sa_net_addr_family(%addr)
    %out_flag = eq __net_addr_family_%out_flag, SA_NET_AF_INET6
    !__net_addr_family_%out_flag
[END_MACRO]

