[MACRO] NET_SOCKET_ADDR_FAMILY %out_family, %socket_addr
    __net_sock_family_tag_%out_family = load %socket_addr+NetSocketAddr_tag as u64
    __net_sock_family_is_v4_%out_family = eq __net_sock_family_tag_%out_family, NET_IP_ADDR_V4
    br __net_sock_family_is_v4_%out_family -> L_NET_SOCKET_FAMILY_V4_%out_family, L_NET_SOCKET_FAMILY_V6_%out_family
L_NET_SOCKET_FAMILY_V4_%out_family:
    %out_family = add 0, SA_NET_AF_INET
    jmp L_NET_SOCKET_FAMILY_DONE_%out_family
L_NET_SOCKET_FAMILY_V6_%out_family:
    %out_family = add 0, SA_NET_AF_INET6
