    !__net_sock_v6_eq_lscope_%out_bool
    !__net_sock_v6_eq_rflow_%out_bool
    !__net_sock_v6_eq_lflow_%out_bool
    !__net_sock_v6_eq_rport_%out_bool
    !__net_sock_v6_eq_lport_%out_bool
    !__net_sock_v6_eq_ip_%out_bool
    !__net_sock_v6_eq_rip_%out_bool
    !__net_sock_v6_eq_lip_%out_bool
[END_MACRO]

