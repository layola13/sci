[MACRO] NET_IP_ADDR_TO_CANONICAL %out_ipaddr, %ipaddr
    __net_ip_canon_tag_%out_ipaddr = load %ipaddr+NetIpAddr_tag as u64
    __net_ip_canon_payload_%out_ipaddr = ptr_add %ipaddr, 8
    __net_ip_canon_is_v4_%out_ipaddr = eq __net_ip_canon_tag_%out_ipaddr, NET_IP_ADDR_V4
    br __net_ip_canon_is_v4_%out_ipaddr -> L_NET_IP_CANON_V4_%out_ipaddr, L_NET_IP_CANON_V6_%out_ipaddr
L_NET_IP_CANON_V4_%out_ipaddr:
    EXPAND NET_IP_ADDR_V4_NEW %out_ipaddr, __net_ip_canon_payload_%out_ipaddr
    jmp L_NET_IP_CANON_DONE_%out_ipaddr
L_NET_IP_CANON_V6_%out_ipaddr:
    __net_ip_canon_v4_%out_ipaddr = stack_alloc NetIpv4Addr_SIZE
    EXPAND NET_IPV6_TO_IPV4_MAPPED __net_ip_canon_mapped_%out_ipaddr, __net_ip_canon_v4_%out_ipaddr, __net_ip_canon_payload_%out_ipaddr
    br __net_ip_canon_mapped_%out_ipaddr -> L_NET_IP_CANON_MAPPED_%out_ipaddr, L_NET_IP_CANON_KEEP_V6_%out_ipaddr
L_NET_IP_CANON_MAPPED_%out_ipaddr:
    EXPAND NET_IP_ADDR_V4_NEW %out_ipaddr, __net_ip_canon_v4_%out_ipaddr
    jmp L_NET_IP_CANON_DONE_%out_ipaddr
L_NET_IP_CANON_KEEP_V6_%out_ipaddr:
    EXPAND NET_IP_ADDR_V6_NEW %out_ipaddr, __net_ip_canon_payload_%out_ipaddr
    jmp L_NET_IP_CANON_DONE_%out_ipaddr
L_NET_IP_CANON_DONE_%out_ipaddr:
    !__net_ip_canon_is_v4_%out_ipaddr
    !__net_ip_canon_payload_%out_ipaddr
    !__net_ip_canon_tag_%out_ipaddr
[END_MACRO]

