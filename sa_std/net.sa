    __net_sock_v6_eq_flow_%out_bool = eq __net_sock_v6_eq_lflow_%out_bool, __net_sock_v6_eq_rflow_%out_bool
    __net_sock_v6_eq_scope_%out_bool = eq __net_sock_v6_eq_lscope_%out_bool, __net_sock_v6_eq_rscope_%out_bool
    __net_sock_v6_eq_meta1_%out_bool = and __net_sock_v6_eq_port_%out_bool, __net_sock_v6_eq_flow_%out_bool
    __net_sock_v6_eq_meta_%out_bool = and __net_sock_v6_eq_meta1_%out_bool, __net_sock_v6_eq_scope_%out_bool
    %out_bool = and __net_sock_v6_eq_ip_%out_bool, __net_sock_v6_eq_meta_%out_bool
    !__net_sock_v6_eq_meta_%out_bool
    !__net_sock_v6_eq_meta1_%out_bool
