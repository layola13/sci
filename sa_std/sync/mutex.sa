// Concrete mutex/spinlock macros built on atomic xchg and release unlock.
@import "mutex.sal"
@import "../time.sai"

@__mutex_lock_spin(lock: ptr) -> void:
L_MUTEX_LOCK_INIT:
    backoff_slot = stack_alloc 8
    store backoff_slot+0, 1 as u64

L_MUTEX_LOCK_TRY:
    prev = atomic_rmw_xchg lock+Mutex_lock, 1 as u64 seq_cst
    free = eq prev, 0
    br free -> L_MUTEX_LOCK_DONE, L_MUTEX_LOCK_WAIT

L_MUTEX_LOCK_WAIT:
    backoff_ns = load backoff_slot+0 as u64
    call @sa_time_sleep_ns(backoff_ns)
    backoff_at_limit = uge backoff_ns, 1024
    br backoff_at_limit -> L_MUTEX_LOCK_KEEP_BACKOFF, L_MUTEX_LOCK_GROW_BACKOFF

L_MUTEX_LOCK_GROW_BACKOFF:
    next_backoff = shl backoff_ns, 1
    store backoff_slot+0, next_backoff as u64
    !next_backoff
    !backoff_at_limit
    !backoff_ns
    !free
    !prev
    jmp L_MUTEX_LOCK_TRY

L_MUTEX_LOCK_KEEP_BACKOFF:
    !backoff_at_limit
    !backoff_ns
    !free
    !prev
    jmp L_MUTEX_LOCK_TRY

L_MUTEX_LOCK_DONE:
    !free
    !prev
    return

[MACRO] MUTEX_NEW %out_mutex
    %out_mutex = alloc Mutex_SIZE
    store %out_mutex+Mutex_lock, 0 as u64
[END_MACRO]

[MACRO] MUTEX_NEW_I32 %out_mutex, %value
    %out_mutex = alloc 16
    store %out_mutex+Mutex_lock, 0 as u64
    store %out_mutex+Mutex_data, %value as i32
[END_MACRO]

[MACRO] MUTEX_LOCK %lock_ptr
    call @__mutex_lock_spin(%lock_ptr)
[END_MACRO]

[MACRO] MUTEX_TRY_LOCK %out_ok, %lock_ptr
    __mutex_try_prev_%out_ok = atomic_rmw_xchg %lock_ptr+Mutex_lock, 1 as u64 acquire
    %out_ok = eq __mutex_try_prev_%out_ok, 0
    !__mutex_try_prev_%out_ok
[END_MACRO]

[MACRO] MUTEX_IS_LOCKED %out_bool, %lock_ptr
    __mutex_state_%out_bool = atomic_load %lock_ptr+Mutex_lock as u64 acquire
    %out_bool = ne __mutex_state_%out_bool, 0
    !__mutex_state_%out_bool
[END_MACRO]

[MACRO] MUTEX_UNLOCK %lock_ptr
    atomic_store %lock_ptr+Mutex_lock, 0 as u64 release
[END_MACRO]

[MACRO] MUTEX_FORCE_UNLOCKED %lock_ptr
    atomic_store %lock_ptr+Mutex_lock, 0 as u64 release
[END_MACRO]
