// ---- method codes (u8 values of HttpMethod, widened to u32) ----
const SA_HTTP_METHOD_GET: u32 = 1;
const SA_HTTP_METHOD_POST: u32 = 2;
const SA_HTTP_METHOD_PUT: u32 = 3;
const SA_HTTP_METHOD_DELETE: u32 = 4;
