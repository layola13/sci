@extern sa_fs_metadata_st_ino(metadata: u64) -> u64
@extern sa_fs_metadata_st_mode(metadata: u64) -> u32
@extern sa_fs_metadata_st_nlink(metadata: u64) -> u64
@extern sa_fs_metadata_st_uid(metadata: u64) -> u32
@extern sa_fs_metadata_st_gid(metadata: u64) -> u32
@extern sa_fs_metadata_st_rdev(metadata: u64) -> u64
@extern sa_fs_metadata_st_size(metadata: u64) -> u64
@extern sa_fs_metadata_st_atime(metadata: u64) -> i64
@extern sa_fs_metadata_st_atime_nsec(metadata: u64) -> i64
@extern sa_fs_metadata_st_mtime(metadata: u64) -> i64
@extern sa_fs_metadata_st_mtime_nsec(metadata: u64) -> i64
@extern sa_fs_metadata_st_ctime(metadata: u64) -> i64
@extern sa_fs_metadata_st_ctime_nsec(metadata: u64) -> i64
@extern sa_fs_metadata_st_blksize(metadata: u64) -> u64
@extern sa_fs_metadata_st_blocks(metadata: u64) -> u64
@extern sa_fs_metadata_free(metadata: u64) -> i32!
@extern sa_fs_remove_file(&path: ptr, path_len: u64) -> i32
@extern sa_fs_rename(&from_path: ptr, from_len: u64, &to_path: ptr, to_len: u64) -> i32
@extern sa_fs_make_dir(&path: ptr, path_len: u64) -> i32
@extern sa_fs_make_dir_mode(&path: ptr, path_len: u64, mode: u32) -> i32
@extern sa_fs_create_dir(&path: ptr, path_len: u64) -> i32
@extern sa_fs_create_dir_mode(&path: ptr, path_len: u64, mode: u32) -> i32
@extern sa_fs_remove_dir(&path: ptr, path_len: u64) -> i32
@extern sa_fs_remove_dir_all(&path: ptr, path_len: u64) -> i32
@extern sa_fs_remove_path(&path: ptr, path_len: u64) -> i32
