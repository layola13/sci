@import "fs.sal"
@import "fs.sai"

[MACRO] FS_OPEN_READ %out_status, %out_file, %path, %path_len
    __fs_open_read_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_open_read(&%path, %path_len, &__fs_open_read_handle_%out_status)
    %out_file = load __fs_open_read_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_OPEN_WRITE %out_status, %out_file, %path, %path_len, %truncate
    __fs_open_write_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_open_write(&%path, %path_len, %truncate, &__fs_open_write_handle_%out_status)
    %out_file = load __fs_open_write_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_CREATE %out_status, %out_file, %path, %path_len
    EXPAND FS_OPEN_WRITE %out_status, %out_file, %path, %path_len, 1
[END_MACRO]

[MACRO] FS_CLOSE %out_status, %file
    %out_status = call @sa_std_close(%file)
[END_MACRO]

[MACRO] FS_READ %out_status, %out_len, %file, %buf, %cap
    __fs_read_len_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_file_read(%file, &%buf, %cap, &__fs_read_len_%out_status)
    %out_len = load __fs_read_len_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_READ_EXACT %out_status, %file, %buf, %len
    %out_status = call @sa_fs_file_read_exact(%file, &%buf, %len)
[END_MACRO]

[MACRO] FS_WRITE %out_status, %out_len, %file, %buf, %len
    __fs_write_len_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_file_write(%file, &%buf, %len, &__fs_write_len_%out_status)
    %out_len = load __fs_write_len_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_WRITE_ALL %out_status, %file, %buf, %len
    %out_status = call @sa_fs_file_write_all(%file, &%buf, %len)
[END_MACRO]

[MACRO] FS_FLUSH %out_status, %file
    %out_status = call @sa_fs_file_flush(%file)
[END_MACRO]

[MACRO] FS_SYNC_DATA %out_status, %file
    %out_status = call @sa_fs_file_sync_data(%file)
[END_MACRO]

[MACRO] FS_SYNC_ALL %out_status, %file
    %out_status = call @sa_fs_file_sync(%file)
[END_MACRO]

[MACRO] FS_SET_LEN %out_status, %file, %len
    %out_status = call @sa_fs_file_truncate(%file, %len)
[END_MACRO]

[MACRO] FS_SEEK %out_status, %out_pos, %file, %whence, %offset
    __fs_seek_pos_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_file_seek(%file, %whence, %offset, &__fs_seek_pos_%out_status)
    %out_pos = load __fs_seek_pos_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_REWIND %out_status, %file
    __fs_rewind_pos_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_file_seek(%file, SA_FS_SEEK_START, 0, &__fs_rewind_pos_%out_status)
[END_MACRO]

[MACRO] FS_READ_FILE %out_status, %out_buffer, %path, %path_len, %max_bytes
    __fs_read_file_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_read_file(&%path, %path_len, %max_bytes, &__fs_read_file_handle_%out_status)
    %out_buffer = load __fs_read_file_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_READ_TO_STRING %out_status, %out_buffer, %path, %path_len, %max_bytes
    __fs_read_to_string_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_read_to_string(&%path, %path_len, %max_bytes, &__fs_read_to_string_handle_%out_status)
    %out_buffer = load __fs_read_to_string_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_WRITE_FILE %out_status, %path, %path_len, %buf, %len
    %out_status = call @sa_fs_write_file(&%path, %path_len, &%buf, %len)
[END_MACRO]

[MACRO] FS_READ_BUFFER_DATA %out_ptr, %buffer
    %out_ptr = call @sa_fs_read_buffer_data(%buffer)
[END_MACRO]

[MACRO] FS_READ_BUFFER_LEN %out_len, %buffer
    %out_len = call @sa_fs_read_buffer_len(%buffer)
[END_MACRO]

[MACRO] FS_READ_BUFFER_FREE %out_status, %buffer
    %out_status = call @sa_fs_read_buffer_free(^%buffer)
[END_MACRO]

[MACRO] FS_READ_FILE_BASE64 %out_status, %out_buffer, %path, %path_len, %max_bytes
    __fs_read_b64_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_read_file_base64(&%path, %path_len, %max_bytes, &__fs_read_b64_handle_%out_status)
    %out_buffer = load __fs_read_b64_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_WRITE_FILE_BASE64 %out_status, %path, %path_len, %buf, %len
    %out_status = call @sa_fs_write_file_base64(&%path, %path_len, &%buf, %len)
[END_MACRO]

[MACRO] FS_READ_DIR_JSON %out_status, %out_buffer, %path, %path_len, %max_entries
    __fs_read_dir_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_read_dir_json(&%path, %path_len, %max_entries, &__fs_read_dir_handle_%out_status)
    %out_buffer = load __fs_read_dir_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_DIR_BUFFER_DATA %out_ptr, %buffer
    %out_ptr = call @sa_fs_dir_buffer_data(%buffer)
[END_MACRO]

[MACRO] FS_DIR_BUFFER_LEN %out_len, %buffer
    %out_len = call @sa_fs_dir_buffer_len(%buffer)
[END_MACRO]

[MACRO] FS_DIR_BUFFER_FREE %out_status, %buffer
    %out_status = call @sa_fs_dir_buffer_free(^%buffer)
[END_MACRO]

[MACRO] FS_METADATA %out_status, %out_metadata, %path, %path_len
    __fs_metadata_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_metadata(&%path, %path_len, &__fs_metadata_handle_%out_status)
    %out_metadata = load __fs_metadata_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_METADATA_JSON %out_status, %out_buffer, %path, %path_len
    __fs_metadata_json_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_metadata_json(&%path, %path_len, &__fs_metadata_json_handle_%out_status)
    %out_buffer = load __fs_metadata_json_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_METADATA_IS_FILE %out_flag, %metadata
    %out_flag = call @sa_fs_metadata_is_file(%metadata)
[END_MACRO]

[MACRO] FS_METADATA_IS_DIR %out_flag, %metadata
    %out_flag = call @sa_fs_metadata_is_directory(%metadata)
[END_MACRO]

[MACRO] FS_METADATA_IS_SYMLINK %out_flag, %metadata
    %out_flag = call @sa_fs_metadata_is_symlink(%metadata)
[END_MACRO]

[MACRO] FS_METADATA_MODIFIED_MS %out_ms, %metadata
    %out_ms = call @sa_fs_metadata_modified_ms(%metadata)
[END_MACRO]

[MACRO] FS_METADATA_CREATED_MS %out_ms, %metadata
    %out_ms = call @sa_fs_metadata_created_ms(%metadata)
[END_MACRO]

[MACRO] FS_METADATA_FREE %out_status, %metadata
    %out_status = call @sa_std_fs_metadata_free(%metadata)
[END_MACRO]

[MACRO] FS_CANONICALIZE %out_status, %out_buffer, %path, %path_len
    __fs_canonical_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_canonicalize(&%path, %path_len, &__fs_canonical_handle_%out_status)
    %out_buffer = load __fs_canonical_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_EXISTS %out_flag, %path, %path_len
    __fs_exists_status_%out_flag = call @sa_std_fs_exists(&%path, %path_len)
    %out_flag = eq __fs_exists_status_%out_flag, SA_FS_OK
    !__fs_exists_status_%out_flag
[END_MACRO]

[MACRO] FS_TRY_EXISTS %out_status, %out_flag, %path, %path_len
    __fs_try_exists_slot_%out_status = stack_alloc 1
    %out_status = call @sa_std_fs_try_exists(&%path, %path_len, &__fs_try_exists_slot_%out_status)
    %out_flag = load __fs_try_exists_slot_%out_status+0 as u8
[END_MACRO]

[MACRO] FS_LEN %out_status, %out_len, %path, %path_len
    __fs_len_slot_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_len(&%path, %path_len, &__fs_len_slot_%out_status)
    %out_len = load __fs_len_slot_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_REMOVE_FILE %out_status, %path, %path_len
    %out_status = call @sa_fs_remove_file(&%path, %path_len)
[END_MACRO]

[MACRO] FS_REMOVE %out_status, %path, %path_len
    %out_status = call @sa_std_fs_remove(&%path, %path_len)
[END_MACRO]

[MACRO] FS_REMOVE_DIR %out_status, %path, %path_len
    %out_status = call @sa_fs_remove_dir(&%path, %path_len)
[END_MACRO]

[MACRO] FS_REMOVE_DIR_ALL %out_status, %path, %path_len
    %out_status = call @sa_fs_remove_dir_all(&%path, %path_len)
[END_MACRO]

[MACRO] FS_REMOVE_PATH %out_status, %path, %path_len
    %out_status = call @sa_fs_remove_path(&%path, %path_len)
[END_MACRO]

[MACRO] FS_RENAME %out_status, %from_path, %from_len, %to_path, %to_len
    %out_status = call @sa_fs_rename(&%from_path, %from_len, &%to_path, %to_len)
[END_MACRO]

[MACRO] FS_MAKE_DIR %out_status, %path, %path_len
    %out_status = call @sa_fs_make_dir(&%path, %path_len)
[END_MACRO]

[MACRO] FS_CREATE_DIR %out_status, %path, %path_len
    %out_status = call @sa_fs_create_dir(&%path, %path_len)
[END_MACRO]

[MACRO] FS_CREATE_DIR_ALL %out_status, %path, %path_len
    EXPAND FS_MAKE_DIR %out_status, %path, %path_len
[END_MACRO]

[MACRO] FS_COPY %out_status, %from_path, %from_len, %to_path, %to_len
    %out_status = call @sa_fs_copy_file(&%from_path, %from_len, &%to_path, %to_len)
[END_MACRO]

[MACRO] FS_SET_PERMISSIONS %out_status, %path, %path_len, %mode
    %out_status = call @sa_fs_set_permissions(&%path, %path_len, %mode)
[END_MACRO]

[MACRO] FS_SET_TIMES_MS %out_status, %path, %path_len, %accessed_ms, %modified_ms
    %out_status = call @sa_fs_set_times_ms(&%path, %path_len, %accessed_ms, %modified_ms)
[END_MACRO]

[MACRO] FS_HARD_LINK %out_status, %from_path, %from_len, %to_path, %to_len
    %out_status = call @sa_fs_hard_link(&%from_path, %from_len, &%to_path, %to_len)
[END_MACRO]

[MACRO] FS_SYMLINK %out_status, %target_path, %target_len, %link_path, %link_len
    %out_status = call @sa_fs_symlink(&%target_path, %target_len, &%link_path, %link_len)
[END_MACRO]

[MACRO] FS_READ_LINK %out_status, %out_buffer, %path, %path_len
    __fs_read_link_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_read_link(&%path, %path_len, &__fs_read_link_handle_%out_status)
    %out_buffer = load __fs_read_link_handle_%out_status+0 as u64
[END_MACRO]
