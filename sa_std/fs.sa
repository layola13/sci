[MACRO] FS_CANONICALIZE %out_status, %out_buffer, %path, %path_len
    __fs_canonical_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_canonicalize(&%path, %path_len, &__fs_canonical_handle_%out_status)
    %out_buffer = load __fs_canonical_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_EXISTS %out_flag, %path, %path_len
    __fs_exists_status_%out_flag = call @sa_std_fs_exists(&%path, %path_len)
    %out_flag = eq __fs_exists_status_%out_flag, SA_FS_OK
    !__fs_exists_status_%out_flag
[END_MACRO]

[MACRO] FS_TRY_EXISTS %out_status, %out_flag, %path, %path_len
    __fs_try_exists_slot_%out_status = stack_alloc 1
    %out_status = call @sa_std_fs_try_exists(&%path, %path_len, &__fs_try_exists_slot_%out_status)
    %out_flag = load __fs_try_exists_slot_%out_status+0 as u8
[END_MACRO]

[MACRO] FS_LEN %out_status, %out_len, %path, %path_len
    __fs_len_slot_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_len(&%path, %path_len, &__fs_len_slot_%out_status)
    %out_len = load __fs_len_slot_%out_status+0 as u64
[END_MACRO]

