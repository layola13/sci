@import "fs.sal"
@import "fs.sai"

[MACRO] FS_OPEN_READ %out_status, %out_file, %path, %path_len
    __fs_open_read_handle_%out_status = alloc 8
    %out_status = call @sa_std_fs_open_read(&%path, %path_len, &__fs_open_read_handle_%out_status)
    %out_file = load __fs_open_read_handle_%out_status+0 as u64
    !__fs_open_read_handle_%out_status
[END_MACRO]

[MACRO] FS_OPEN_WRITE %out_status, %out_file, %path, %path_len, %truncate
    __fs_open_write_handle_%out_status = alloc 8
    %out_status = call @sa_std_fs_open_write(&%path, %path_len, %truncate, &__fs_open_write_handle_%out_status)
    %out_file = load __fs_open_write_handle_%out_status+0 as u64
    !__fs_open_write_handle_%out_status
[END_MACRO]

[MACRO] FS_CREATE %out_status, %out_file, %path, %path_len
    EXPAND FS_OPEN_WRITE %out_status, %out_file, %path, %path_len, 1
[END_MACRO]

[MACRO] FS_OPEN_OPTIONS %out_status, %out_file, %path, %path_len, %flags, %create_mode, %custom_flags
    __fs_open_options_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_open_options(&%path, %path_len, %flags, %create_mode, %custom_flags, &__fs_open_options_handle_%out_status)
    %out_file = load __fs_open_options_handle_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_OPEN_FLAGS %out_status, %out_file, %path, %path_len, %flags
    EXPAND FS_OPEN_OPTIONS %out_status, %out_file, %path, %path_len, %flags, SA_FS_OPEN_MODE_DEFAULT, 0
[END_MACRO]

[MACRO] FS_CLOSE %out_status, %file
    %out_status = call @sa_std_close(%file)
[END_MACRO]

[MACRO] FS_READ %out_status, %out_len, %file, %buf, %cap
    __fs_read_len_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_file_read(%file, &%buf, %cap, &__fs_read_len_%out_status)
    %out_len = load __fs_read_len_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_READ_EXACT %out_status, %file, %buf, %len
    %out_status = call @sa_fs_file_read_exact(%file, &%buf, %len)
[END_MACRO]

[MACRO] FS_READ_AT %out_status, %out_len, %file, %buf, %cap, %offset
    __fs_read_at_len_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_file_read_at(%file, &%buf, %cap, %offset, &__fs_read_at_len_%out_status)
    %out_len = load __fs_read_at_len_%out_status+0 as u64
[END_MACRO]

[MACRO] FS_READ_EXACT_AT %out_status, %file, %buf, %len, %offset
