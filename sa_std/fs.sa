[END_MACRO]

[MACRO] FS_LCHOWN %out_status, %path, %path_len, %uid, %gid, %has_uid, %has_gid
    %out_status = call @sa_fs_lchown(&%path, %path_len, %uid, %gid, %has_uid, %has_gid)
[END_MACRO]

[MACRO] FS_FCHOWN %out_status, %file, %uid, %gid, %has_uid, %has_gid
    %out_status = call @sa_fs_fchown(%file, %uid, %gid, %has_uid, %has_gid)
[END_MACRO]

[MACRO] FS_CHOWN_RAW %out_status, %path, %path_len, %uid, %gid
    __fs_chown_has_uid_%out_status = ne %uid, SA_FS_CHOWN_ID_UNCHANGED
    __fs_chown_has_gid_%out_status = ne %gid, SA_FS_CHOWN_ID_UNCHANGED
    %out_status = call @sa_fs_chown(&%path, %path_len, %uid, %gid, __fs_chown_has_uid_%out_status, __fs_chown_has_gid_%out_status)
    !__fs_chown_has_gid_%out_status
    !__fs_chown_has_uid_%out_status
[END_MACRO]

[MACRO] FS_LCHOWN_RAW %out_status, %path, %path_len, %uid, %gid
    __fs_lchown_has_uid_%out_status = ne %uid, SA_FS_CHOWN_ID_UNCHANGED
    __fs_lchown_has_gid_%out_status = ne %gid, SA_FS_CHOWN_ID_UNCHANGED
    %out_status = call @sa_fs_lchown(&%path, %path_len, %uid, %gid, __fs_lchown_has_uid_%out_status, __fs_lchown_has_gid_%out_status)
    !__fs_lchown_has_gid_%out_status
    !__fs_lchown_has_uid_%out_status
[END_MACRO]

[MACRO] FS_FCHOWN_RAW %out_status, %file, %uid, %gid
    __fs_fchown_has_uid_%out_status = ne %uid, SA_FS_CHOWN_ID_UNCHANGED
    __fs_fchown_has_gid_%out_status = ne %gid, SA_FS_CHOWN_ID_UNCHANGED
    %out_status = call @sa_fs_fchown(%file, %uid, %gid, __fs_fchown_has_uid_%out_status, __fs_fchown_has_gid_%out_status)
    !__fs_fchown_has_gid_%out_status
    !__fs_fchown_has_uid_%out_status
[END_MACRO]

[MACRO] FS_MKFIFO %out_status, %path, %path_len, %mode
    %out_status = call @sa_fs_mkfifo(&%path, %path_len, %mode)
[END_MACRO]

[MACRO] FS_READ_LINK %out_status, %out_buffer, %path, %path_len
    __fs_read_link_handle_%out_status = stack_alloc 8
    %out_status = call @sa_std_fs_read_link(&%path, %path_len, &__fs_read_link_handle_%out_status)
    %out_buffer = load __fs_read_link_handle_%out_status+0 as u64
[END_MACRO]
