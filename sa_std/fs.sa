[END_MACRO]

[MACRO] FS_PERMISSIONS_FROM_MODE %out_permissions, %mode
    store %out_permissions+SaFsPermissions_mode, %mode as u32
[END_MACRO]

[MACRO] FS_PERMISSIONS_MODE %out_mode, %permissions
    %out_mode = load %permissions+SaFsPermissions_mode as u32
[END_MACRO]

[MACRO] FS_PERMISSIONS_SET_MODE %permissions, %mode
    store %permissions+SaFsPermissions_mode, %mode as u32
[END_MACRO]

