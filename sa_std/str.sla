@import "sa_std/string.sa"
@import "sa_std/fmt/format/string_format.sa"
@import "sa_std/core/result.sa"
@import "sa_std/core/slice.sa"

fn str_from_utf8(bytes: Slice<u8>) -> Result<String, i32> {
    // The input slice follows the std byte-slice convention: its
    // elements are addressed individually (SLICE_GET_U8), the same
    // reads dns.sla and net_info.sla use. Under the VECFIX compact
    // stride a Vec-backed slice's raw buffer is packed, exactly
    // like a String's own buffer, so the two provenances agree.
    // (History: the buffer used to be word-slot strided under the
    // old sa_std/vec_packed.sla contract, and handing it directly
    // to the packed extern behind STR_IS_UTF8 or to the raw
    // mem_copy inside STRING_BUF_FROM_UTF8_UNCHECKED rejected
    // valid multi-byte text and accepted ASCII-led invalid text --
    // DEF-STR-UTF8-VALIDATE.) Build the text element-wise anyway
    // (the net_info.sla collect idiom), then validate the packed
    // image of the built String.
    let text: String = format("");
    let n: u64 = 0;
    SLICE_GET_LEN(n, bytes);
    let i: u64 = 0;
    while i < n {
        let b: u8 = 0;
        SLICE_GET_U8(b, bytes, i);
        let one: [u8; 1] = [b];
        let piece: String = one.iter().collect<String>();
        text = format("{}{}", text, piece);
        i = i + 1;
    }
    let tb = text.as_bytes();
    let ok: bool = STR_IS_UTF8(tb);
    if ok != true {
        return Err(1);
    };
    return Ok(text);
}
