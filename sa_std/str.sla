@import "sa_std/string.sa"
@import "sa_std/string_format.sa"
@import "sa_std/core/result.sa"
@import "sa_std/core/slice.sa"

fn str_from_utf8(bytes: Slice<u8>) -> Result<String, i32> {
    let ok: bool = STR_IS_UTF8(bytes);
    if ok != true {
        return Err(1);
    };
    let text: String = STRING_BUF_FROM_UTF8_UNCHECKED(bytes);
    return Ok(text);
}
