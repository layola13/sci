// sa_std/rel_link.sla -- relative-offset links (Class-A batch,
// ruling addendum 2: Jev F4 form B -- standard pattern library,
// NOT a language feature).
//
// PURPOSE: structures whose links must survive the whole block
// being copied or moved -- a serialized graph in one arena, a
// shared-memory layout, a save image -- store u32 OFFSETS from
// the block base instead of pointers. Traversal looks exactly
// like pointer chasing; the relocation story is "copy the
// block, keep the base, every link still resolves".
//
// CONTRACT:
//   * Offsets are always relative to the caller-supplied base;
//     REL_NIL is the null link. Offset 0 is a VALID link (the
//     base itself), never a sentinel.
//   * rel_off panics (1331) when the pointer is outside the
//     4 GiB window above base or below it -- a link that cannot
//     be represented must fail loudly, not truncate.
//   * Links live in caller memory (typically one field inside
//     each node of an arena); the helpers read/write the u32
//     field at node + field_off little-endian, the same image
//     a serialized block would carry. ptr.sa has no u32 field
//     macros, so the field access is byte assembly here.
//   * Nothing here owns memory: base/nodes are caller-managed
//     raw pointers, and every helper is a pure function of its
//     arguments.

@import "sa_std/vec.sa"
@import "sa_std/ptr.sa"

const REL_NIL: u32 = 4294967295;

// Resolve an offset to a pointer; REL_NIL resolves to null.
fn rel_ptr(base: ptr, off: u32) -> ptr {
    if off == REL_NIL {
        let np: ptr = PTR_NULL();
        return np;
    };
    let o: u64 = off as u64;
    let r: ptr = PTR_BYTE_ADD(base, o);
    return r;
}

// The offset of p from base; null maps to REL_NIL. Panics
// (1331) when p is not within [base, base + 4 GiB).
fn rel_off(base: ptr, p: ptr) -> u32 {
    let addr: u64 = PTR_ADDR(p);
    if addr == 0 {
        return REL_NIL;
    };
    let pa: u64 = PTR_ADDR(p);
    let ba: u64 = PTR_ADDR(base);
    let d: u64 = pa - ba;
    if d > 4294967295 {
        panic(1331);
    };
    return d as u32;
}

// Read the u32 link field at node + field_off.
fn rel_link_get(node: ptr, field_off: u64) -> u32 {
    let fp: ptr = PTR_BYTE_ADD(node, field_off);
    let c0: u8 = PTR_BYTE_AT(fp, 0);
    let c1: u8 = PTR_BYTE_AT(fp, 1);
    let c2: u8 = PTR_BYTE_AT(fp, 2);
    let c3: u8 = PTR_BYTE_AT(fp, 3);
    let b0: u64 = c0 as u64;
    let b1: u64 = c1 as u64;
    let b2: u64 = c2 as u64;
    let b3: u64 = c3 as u64;
    let w: u64 = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
    return w as u32;
}

// Write the u32 link field at node + field_off.
fn rel_link_set(node: ptr, field_off: u64, off: u32) {
    let fp: ptr = PTR_BYTE_ADD(node, field_off);
    let w: u64 = off as u64;
    let v0: u8 = w as u8;
    PTR_WRITE_U8(fp, v0);
    let f1: ptr = PTR_BYTE_ADD(fp, 1);
    let s1: u64 = w >> 8;
    let v1: u8 = s1 as u8;
    PTR_WRITE_U8(f1, v1);
    let f2: ptr = PTR_BYTE_ADD(fp, 2);
    let s2: u64 = w >> 16;
    let v2: u8 = s2 as u8;
    PTR_WRITE_U8(f2, v2);
    let f3: ptr = PTR_BYTE_ADD(fp, 3);
    let s3: u64 = w >> 24;
    let v3: u8 = s3 as u8;
    PTR_WRITE_U8(f3, v3);
}

// Resolve the link stored in node's field against base.
fn rel_link_ptr(base: ptr, node: ptr, field_off: u64) -> ptr {
    let off: u32 = rel_link_get(node, field_off);
    return rel_ptr(base, off);
}
