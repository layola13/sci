#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

has_tag_push=0
ref_count=0
while read -r local_ref local_oid remote_ref remote_oid; do
    ref_count=$((ref_count + 1))
    if [[ "$local_ref" == refs/tags/* || "$remote_ref" == refs/tags/* ]]; then
        has_tag_push=1
    fi
done

if [ "$has_tag_push" -eq 0 ] && [ "$ref_count" -gt 0 ]; then
    printf '[pre-push] skip: no tag refs in this push\n'
    exit 0
fi

if [ "$has_tag_push" -eq 1 ]; then
    printf '[pre-push] tag ref detected; running release checks\n'
else
    printf '[pre-push] no refs received; running release checks for explicit push retry\n'
fi
if [ "${SA_PRE_PUSH_SKIP_CHECKS:-0}" = "1" ]; then
    printf '[pre-push] skip: SA_PRE_PUSH_SKIP_CHECKS=1\n'
    exit 0
fi

exec env SA_PRE_PUSH_FORCE_CHECKS=1 tools/pre_push_timed.sh
