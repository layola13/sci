#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

has_tag_push=0
while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_ref" == refs/tags/* || "$remote_ref" == refs/tags/* ]]; then
        has_tag_push=1
    fi
done

if [ "$has_tag_push" -eq 0 ]; then
    printf '[pre-push] skip: no tag refs in this push\n'
    exit 0
fi

printf '[pre-push] tag ref detected; running release checks\n'
if [ "${SA_PRE_PUSH_SKIP_CHECKS:-0}" = "1" ]; then
    printf '[pre-push] skip: SA_PRE_PUSH_SKIP_CHECKS=1\n'
    exit 0
fi

exec tools/pre_push_timed.sh
