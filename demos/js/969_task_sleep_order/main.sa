// Probe g5: sa_task_sleep_ms ordering across tasks. The sleeper
// task sleeps 30 ms and then stores 111; main sleeps 120 ms, so by
// the time main wakes the store must have happened (the sleeper can
// only run if main's sleep yields the scheduler). Expected:
//   111
//   0        (join status)
@extern sa_task_spawn(*entry: ptr, arg: ptr, &out_handle: ptr) -> i32
@extern sa_task_join(handle: u64) -> i32
@extern sa_task_sleep_ms(ms: u64) -> i32
@extern sa_fmt_u64(value: u64, base: u32) -> u64
@extern sa_fmt_buffer_data(buffer: u64) -> &ptr
@extern sa_fmt_buffer_len(buffer: u64) -> u64
@extern sa_fmt_buffer_free(^buffer: u64) -> i32
@extern sa_print_bytes(&msg: ptr, len: u64) -> void

@const NL = utf8:"\n"
@const S_VT = vtable { call = @sleeper }

@print_u64(v: u64) -> void:
L_ENTRY:
    buf = call @sa_fmt_u64(v, 10)
    p = call @sa_fmt_buffer_data(buf)
    n = call @sa_fmt_buffer_len(buf)
    call @sa_print_bytes(&p, n)
    call @sa_print_bytes(&NL, 1)
    st = call @sa_fmt_buffer_free(^buf)
    !st
    !n
    !p
    !v
    return

@sleeper(arg: ptr) -> void:
L_ENTRY:
    sst = call @sa_task_sleep_ms(30)
    store arg+0, 111 as u64
    !sst
    !arg
    return

@ffi_wrapper main() -> i32:
L_ENTRY:
    cell = alloc 8
    store cell+0, 0 as u64
    ts = stack_alloc 8
    vt = &S_VT
    fncell = load vt+0 as ptr
    raw = *fncell
    safe = assume_safe raw
    sst = call @sa_task_spawn(*safe, cell, &ts)
    handle = load ts+0 as u64
    mst = call @sa_task_sleep_ms(120)
    v = load cell+0 as u64
    call @print_u64(v)
    jst = call @sa_task_join(handle)
    jv = zext jst as u64
    call @print_u64(jv)
    !sst
    !fncell
    !vt
    !raw
    !safe
    !handle
    !mst
    !v
    !jst
    !jv
    !cell
    return 0
