// Probe g3: sa_chan_select ready-arm scan + default arm (no tasks).
// chan B is pre-loaded with 33 (buffered); chan A stays empty.
// select(recv A, recv B) must pick index 1 with value 33; a second
// select over A alone with a default must report index -1 (printed
// as the 999 sentinel). Expected:
//   1
//   33
//   999
@extern sa_chan_make(capacity: u32, &out_handle: ptr) -> i32
@extern sa_chan_send(handle: u64, *value: ptr) -> i32
@extern sa_chan_select(*cases: ptr, *ops: ptr, *slots: ptr, count: u64, has_default: u32, timeout_ns: i64, &out_index: ptr, &out_closed: ptr) -> i32
@extern sa_fmt_u64(value: u64, base: u32) -> u64
@extern sa_fmt_buffer_data(buffer: u64) -> &ptr
@extern sa_fmt_buffer_len(buffer: u64) -> u64
@extern sa_fmt_buffer_free(^buffer: u64) -> i32
@extern sa_print_bytes(&msg: ptr, len: u64) -> void

@const NL = utf8:"\n"

@print_u64(v: u64) -> void:
L_ENTRY:
    buf = call @sa_fmt_u64(v, 10)
    p = call @sa_fmt_buffer_data(buf)
    n = call @sa_fmt_buffer_len(buf)
    call @sa_print_bytes(&p, n)
    call @sa_print_bytes(&NL, 1)
    st = call @sa_fmt_buffer_free(^buf)
    !st
    !n
    !p
    !v
    return

@main() -> i32:
L_ENTRY:
    hs = stack_alloc 8
    m1 = call @sa_chan_make(1, &hs)
    cha = load hs+0 as u64
    m2 = call @sa_chan_make(1, &hs)
    chb = load hs+0 as u64
    cell = stack_alloc 16
    store cell+0, 33 as u64
    store cell+8, 0 as u64
    sst = call @sa_chan_send(chb, *cell)
    cases = alloc 16
    store cases+0, cha as u64
    store cases+8, chb as u64
    ops = alloc 8
    store ops+0, 0 as u32
    store ops+4, 0 as u32
    slots = alloc 32
    idx = stack_alloc 8
    cls = stack_alloc 8
    st = call @sa_chan_select(*cases, *ops, *slots, 2, 0, -1, &idx, &cls)
    i1 = load idx+0 as i64
    i1u = bitcast i1 as u64
    call @print_u64(i1u)
    v = load slots+16 as u64
    call @print_u64(v)
    st2 = call @sa_chan_select(*cases, *ops, *slots, 1, 1, -1, &idx, &cls)
    i2 = load idx+0 as i64
    isdef = eq i2, -1
    br isdef -> L_DEF, L_NODEF
L_DEF:
    call @print_u64(999)
    jmp L_FIN
L_NODEF:
    i2u = bitcast i2 as u64
    call @print_u64(i2u)
    jmp L_FIN
L_FIN:
    !m1
    !m2
    !cha
    !chb
    !sst
    !st
    !st2
    !i1
    !i1u
    !v
    !i2
    !isdef
    !cases
    !ops
    !slots
    return 0
