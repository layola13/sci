// Trap probe t3 (JS): a task locking the same non-reentrant mutex
// twice can never proceed; with no other task and no timer pending
// the cooperative scheduler traps loudly with the deadlock message
// instead of hanging (the wasm coop runtime does the same). The
// 999 print is unreachable.
@extern sa_sync_mutex_new(&out_handle: ptr) -> i32
@extern sa_sync_mutex_lock(handle: u64) -> i32
@extern sa_fmt_u64(value: u64, base: u32) -> u64
@extern sa_fmt_buffer_data(buffer: u64) -> &ptr
@extern sa_fmt_buffer_len(buffer: u64) -> u64
@extern sa_fmt_buffer_free(^buffer: u64) -> i32
@extern sa_print_bytes(&msg: ptr, len: u64) -> void

@const NL = utf8:"\n"

@print_u64(v: u64) -> void:
L_ENTRY:
    buf = call @sa_fmt_u64(v, 10)
    p = call @sa_fmt_buffer_data(buf)
    n = call @sa_fmt_buffer_len(buf)
    call @sa_print_bytes(&p, n)
    call @sa_print_bytes(&NL, 1)
    st = call @sa_fmt_buffer_free(^buf)
    !st
    !n
    !p
    !v
    return

@main() -> i32:
L_ENTRY:
    hs = stack_alloc 8
    nst = call @sa_sync_mutex_new(&hs)
    mu = load hs+0 as u64
    l1 = call @sa_sync_mutex_lock(mu)
    l2 = call @sa_sync_mutex_lock(mu)
    call @print_u64(999)
    !nst
    !mu
    !l1
    !l2
    return 0
