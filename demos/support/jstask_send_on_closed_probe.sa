// Trap probe t2 (JS): send on a closed channel must trap with
// "sa_task: send on closed channel" (same loud failure as the
// native and coop runtimes). The 999 print is unreachable.
@extern sa_chan_make(capacity: u32, &out_handle: ptr) -> i32
@extern sa_chan_close(handle: u64) -> i32
@extern sa_chan_send(handle: u64, *value: ptr) -> i32
@extern sa_fmt_u64(value: u64, base: u32) -> u64
@extern sa_fmt_buffer_data(buffer: u64) -> &ptr
@extern sa_fmt_buffer_len(buffer: u64) -> u64
@extern sa_fmt_buffer_free(^buffer: u64) -> i32
@extern sa_print_bytes(&msg: ptr, len: u64) -> void

@const NL = utf8:"\n"

@print_u64(v: u64) -> void:
L_ENTRY:
    buf = call @sa_fmt_u64(v, 10)
    p = call @sa_fmt_buffer_data(buf)
    n = call @sa_fmt_buffer_len(buf)
    call @sa_print_bytes(&p, n)
    call @sa_print_bytes(&NL, 1)
    st = call @sa_fmt_buffer_free(^buf)
    !st
    !n
    !p
    !v
    return

@main() -> i32:
L_ENTRY:
    hs = stack_alloc 8
    mst = call @sa_chan_make(1, &hs)
    ch = load hs+0 as u64
    cst = call @sa_chan_close(ch)
    cell = alloc 16
    store cell+0, 5 as u64
    store cell+8, 0 as u64
    sst = call @sa_chan_send(ch, *cell)
    call @print_u64(999)
    !mst
    !ch
    !cst
    !sst
    !cell
    return 0
