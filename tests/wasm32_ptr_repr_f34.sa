// DEF-WASM32-PTR-REPR regression: the success chain end to end.
// Provenance: sim-wasm32-munmap-diag varF34, verbatim in form. flags 34
// (MAP_PRIVATE|MAP_ANON) is accepted by wasi-libc's emulated mmap, the
// sentinel check must NOT fire, munmap succeeds. Exit 42 = full chain.
@extern mmap(addr: ptr, len: u32, prot: i32, flags: i32, fd: i32, offset: u64) -> ptr
@extern munmap(addr: ptr, len: u32) -> i32

@main() -> i32:
L_ENTRY:
    base = call @mmap(0 as ptr, 4096, 3, 34, -1, 0)
    fail_ptr = -1 as ptr
    failed = eq base, fail_ptr
    br failed -> L_FAIL, L_OK
L_OK:
    rc = call @munmap(base, 4096)
    !rc
    !base
    !fail_ptr
    !failed
    ret = add 0, 42
    return ret
L_FAIL:
    !base
    !fail_ptr
    !failed
    ret7 = add 0, 7
    return ret7
