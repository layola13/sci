@import "sa_std/os/unix_ffi.sa"
@import "sa_std/core/slice.sa"
@import "sa_std/vec.sa"

@test "sa_std os unix ffi OsStr byte view macros"():
L_ENTRY:
    bytes = stack_alloc 4
    store bytes+0, 102 as u8
    store bytes+1, 111 as u8
    store bytes+2, 111 as u8
    store bytes+3, 255 as u8

    byte_slice = stack_alloc Slice_SIZE
    EXPAND SLICE_NEW byte_slice, bytes, 4
    EXPAND OS_STR_FROM_BYTES os_str, byte_slice
    EXPAND OS_STR_AS_BYTES bytes_again, os_str
    EXPAND OS_STR_FROM_BYTES_SLICE os_str_alias, byte_slice
    EXPAND OS_STR_AS_BYTES_SLICE bytes_alias, os_str_alias

    EXPAND SLICE_GET_LEN source_len, byte_slice
    EXPAND SLICE_GET_PTR source_ptr, byte_slice
    EXPAND SLICE_GET_LEN os_len, os_str
    EXPAND SLICE_GET_PTR os_ptr, os_str
    EXPAND SLICE_GET_LEN bytes_len, bytes_again
    EXPAND SLICE_GET_PTR bytes_ptr, bytes_again
    EXPAND SLICE_TRY_GET_TYPED_U8 first_ok, first_byte, bytes_again, 0, 1
    EXPAND SLICE_TRY_GET_TYPED_U8 last_ok, last_byte, bytes_again, 3, 1
    EXPAND SLICE_GET_LEN alias_len, bytes_alias
    EXPAND SLICE_GET_PTR alias_ptr, bytes_alias

    null_ptr = 0 as ptr
    source_len_ok = eq source_len, 4
    source_ptr_ok = ne source_ptr, null_ptr
    os_len_ok = eq os_len, 4
    os_ptr_ok = eq os_ptr, source_ptr
    bytes_len_ok = eq bytes_len, 4
    bytes_ptr_ok = eq bytes_ptr, source_ptr
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first_byte, 102
    last_flag_ok = eq last_ok, 1
    last_value_ok = eq last_byte, 255
    alias_len_ok = eq alias_len, 4
    alias_ptr_ok = eq alias_ptr, source_ptr

    ok01 = and source_len_ok, source_ptr_ok
    ok02 = and ok01, os_len_ok
    ok03 = and ok02, os_ptr_ok
    ok04 = and ok03, bytes_len_ok
    ok05 = and ok04, bytes_ptr_ok
    ok06 = and ok05, first_flag_ok
    ok07 = and ok06, first_value_ok
    ok08 = and ok07, last_flag_ok
    ok09 = and ok08, last_value_ok
    ok10 = and ok09, alias_len_ok
    ok = and ok10, alias_ptr_ok

    !source_len
    !source_ptr
    !os_len
    !os_ptr
    !bytes_len
    !bytes_ptr
    !first_ok
    !first_byte
    !last_ok
    !last_byte
    !alias_len
    !alias_ptr
    !null_ptr
    !source_len_ok
    !source_ptr_ok
    !os_len_ok
    !os_ptr_ok
    !bytes_len_ok
    !bytes_ptr_ok
    !first_flag_ok
    !first_value_ok
    !last_flag_ok
    !last_value_ok
    !alias_len_ok
    !alias_ptr_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !bytes_alias
    !os_str_alias
    !bytes_again
    !os_str
    br ok -> L_OS_STR_OK, L_OS_STR_FAIL

L_OS_STR_FAIL:
    !ok
    panic(941)

L_OS_STR_OK:
    !ok
    return

@test "sa_std os unix ffi OsString byte vec macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY bytes_vec, 4, 1
    EXPAND VEC_PUSH bytes_vec, 102, 1
    EXPAND VEC_PUSH bytes_vec, 111, 1
    EXPAND VEC_PUSH bytes_vec, 111, 1
    EXPAND VEC_PUSH bytes_vec, 255, 1
    EXPAND OS_STRING_FROM_VEC os_string, bytes_vec
    EXPAND OS_STRING_INTO_VEC roundtrip_vec, os_string
    EXPAND VEC_LEN roundtrip_len, roundtrip_vec
    EXPAND VEC_TRY_GET_TYPED_U8 first_ok, first_byte, roundtrip_vec, 0, 1
    EXPAND VEC_TRY_GET_TYPED_U8 last_ok, last_byte, roundtrip_vec, 3, 1

    EXPAND VEC_WITH_CAPACITY alias_vec, 1, 1
    EXPAND VEC_PUSH alias_vec, 120, 1
    EXPAND OS_STRING_FROM_VEC_U8 alias_os_string, alias_vec
    EXPAND OS_STRING_INTO_VEC_U8 alias_roundtrip_vec, alias_os_string
    EXPAND VEC_LEN alias_len, alias_roundtrip_vec
    EXPAND VEC_TRY_GET_TYPED_U8 alias_ok, alias_byte, alias_roundtrip_vec, 0, 1

    len_ok = eq roundtrip_len, 4
    first_flag_ok = eq first_ok, 1
    first_value_ok = eq first_byte, 102
    last_flag_ok = eq last_ok, 1
    last_value_ok = eq last_byte, 255
    alias_len_ok = eq alias_len, 1
    alias_flag_ok = eq alias_ok, 1
    alias_value_ok = eq alias_byte, 120

    ok01 = and len_ok, first_flag_ok
    ok02 = and ok01, first_value_ok
    ok03 = and ok02, last_flag_ok
    ok04 = and ok03, last_value_ok
    ok05 = and ok04, alias_len_ok
    ok06 = and ok05, alias_flag_ok
    ok = and ok06, alias_value_ok

    !roundtrip_len
    !first_ok
    !first_byte
    !last_ok
    !last_byte
    !alias_len
    !alias_ok
    !alias_byte
    !len_ok
    !first_flag_ok
    !first_value_ok
    !last_flag_ok
    !last_value_ok
    !alias_len_ok
    !alias_flag_ok
    !alias_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    EXPAND VEC_FREE alias_roundtrip_vec
    EXPAND VEC_FREE roundtrip_vec
    br ok -> L_OS_STRING_OK, L_OS_STRING_FAIL

L_OS_STRING_FAIL:
    !ok
    panic(942)

L_OS_STRING_OK:
    !ok
    return
