@test "sa_std fs remove_dir_all macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_remove_all_status, FS_TEST_REMOVE_ALL_DIR, FS_TEST_REMOVE_ALL_DIR_LEN
    EXPAND FS_CREATE_DIR_ALL create_nested_status, FS_TEST_REMOVE_ALL_CHILD, FS_TEST_REMOVE_ALL_CHILD_LEN
    EXPAND FS_REMOVE_DIR remove_nonempty_status, FS_TEST_REMOVE_ALL_DIR, FS_TEST_REMOVE_ALL_DIR_LEN
    EXPAND FS_REMOVE_DIR_ALL remove_all_status, FS_TEST_REMOVE_ALL_DIR, FS_TEST_REMOVE_ALL_DIR_LEN
    EXPAND FS_EXISTS gone_after_remove_all, FS_TEST_REMOVE_ALL_DIR, FS_TEST_REMOVE_ALL_DIR_LEN

    create_nested_ok = eq create_nested_status, SA_FS_OK
    nonempty_failed = ne remove_nonempty_status, SA_FS_OK
    remove_all_ok = eq remove_all_status, SA_FS_OK
    gone_ok = eq gone_after_remove_all, 0
    ok01 = and create_nested_ok, nonempty_failed
    ok02 = and ok01, remove_all_ok
    ok = and ok02, gone_ok
    br ok -> L_OK, L_FAIL

L_FAIL:
    call @sa_test_debug_i64(&FS_DBG_MKDIR_STATUS, FS_DBG_MKDIR_STATUS_LEN, create_nested_status)
    call @sa_test_debug_i64(&FS_DBG_REMOVE_NONEMPTY_STATUS, FS_DBG_REMOVE_NONEMPTY_STATUS_LEN, remove_nonempty_status)
    call @sa_test_debug_i64(&FS_DBG_REMOVE_DIR_ALL_STATUS, FS_DBG_REMOVE_DIR_ALL_STATUS_LEN, remove_all_status)
    call @sa_test_debug_i64(&FS_DBG_GONE_AFTER_REMOVE_ALL, FS_DBG_GONE_AFTER_REMOVE_ALL_LEN, gone_after_remove_all)
    call @sa_assert_eq_i64(create_nested_status, SA_FS_OK, 943)
    call @sa_assert_eq_i64(nonempty_failed, 1, 943)
    call @sa_assert_eq_i64(remove_all_status, SA_FS_OK, 943)
    call @sa_assert_eq_i64(gone_after_remove_all, 0, 943)
    !ok
    !ok02
    !ok01
    !gone_ok
    !remove_all_ok
    !nonempty_failed
    !create_nested_ok
    !gone_after_remove_all
    !remove_all_status
    !remove_nonempty_status
    !create_nested_status
    !cleanup_remove_all_status
    panic(943)

L_OK:
    !ok
    !ok02
    !ok01
    !gone_ok
    !remove_all_ok
    !nonempty_failed
    !create_nested_ok
    !gone_after_remove_all
    !remove_all_status
    !remove_nonempty_status
    !create_nested_status
    !cleanup_remove_all_status
    return

@test "sa_std fs read_to_string macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_utf8_status, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN
    EXPAND FS_WRITE_FILE write_utf8_status, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN, FS_TEST_HELLO, FS_TEST_HELLO_LEN
    EXPAND FS_READ_TO_STRING read_string_status, string_buffer, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN, 64
    EXPAND FS_READ_BUFFER_DATA string_data, string_buffer
    EXPAND FS_READ_BUFFER_LEN string_len, string_buffer
    EXPAND STR_FROM_PARTS string_view, string_data, string_len
    EXPAND STR_FROM_PARTS hello_view, &FS_TEST_HELLO, FS_TEST_HELLO_LEN
    EXPAND STR_EQ string_eq, string_view, hello_view
    EXPAND FS_READ_BUFFER_FREE string_free_status, string_buffer

    invalid_buf = alloc 1
    store invalid_buf+0, 255 as u8
    EXPAND FS_WRITE_FILE write_invalid_status, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN, invalid_buf, 1
    EXPAND FS_READ_TO_STRING invalid_utf8_status, invalid_string_buffer, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN, 64
    EXPAND FS_REMOVE_PATH cleanup_end_status, FS_TEST_UTF8_PATH, FS_TEST_UTF8_PATH_LEN

    write_ok = eq write_utf8_status, SA_FS_OK
    read_ok = eq read_string_status, SA_FS_OK
    len_ok = eq string_len, FS_TEST_HELLO_LEN
    eq_ok = eq string_eq, 1
    free_ok = eq string_free_status, SA_FS_OK
    write_invalid_ok = eq write_invalid_status, SA_FS_OK
    invalid_failed = ne invalid_utf8_status, SA_FS_OK
    cleanup_ok = eq cleanup_end_status, SA_FS_OK
    ok01 = and write_ok, read_ok
    ok02 = and ok01, len_ok
    ok03 = and ok02, eq_ok
    ok04 = and ok03, free_ok
    ok05 = and ok04, write_invalid_ok
    ok06 = and ok05, invalid_failed
    ok = and ok06, cleanup_ok
    br ok -> L_OK, L_FAIL

L_FAIL:
    call @sa_test_debug_i64(&FS_DBG_WRITE_STATUS, FS_DBG_WRITE_STATUS_LEN, write_utf8_status)
    call @sa_test_debug_i64(&FS_DBG_READ_TO_STRING_STATUS, FS_DBG_READ_TO_STRING_STATUS_LEN, read_string_status)
    call @sa_test_debug_i64(&FS_DBG_READ_LEN, FS_DBG_READ_LEN_LEN, string_len)
    call @sa_test_debug_i64(&FS_DBG_READ_TO_STRING_EQ, FS_DBG_READ_TO_STRING_EQ_LEN, string_eq)
    call @sa_test_debug_i64(&FS_DBG_INVALID_UTF8_STATUS, FS_DBG_INVALID_UTF8_STATUS_LEN, invalid_utf8_status)
    call @sa_test_debug_i64(&FS_DBG_REMOVE_STATUS, FS_DBG_REMOVE_STATUS_LEN, cleanup_end_status)
    call @sa_assert_eq_i64(write_utf8_status, SA_FS_OK, 944)
    call @sa_assert_eq_i64(read_string_status, SA_FS_OK, 944)
    call @sa_assert_eq_i64(string_len, FS_TEST_HELLO_LEN, 944)
    call @sa_assert_eq_i64(string_eq, 1, 944)
    call @sa_assert_eq_i64(string_free_status, SA_FS_OK, 944)
    call @sa_assert_eq_i64(write_invalid_status, SA_FS_OK, 944)
    call @sa_assert_eq_i64(invalid_failed, 1, 944)
    call @sa_assert_eq_i64(cleanup_end_status, SA_FS_OK, 944)
    !ok
    !ok06
    !ok05
    !ok04
    !ok03
    !ok02
    !ok01
    !cleanup_ok
    !invalid_failed
    !write_invalid_ok
    !free_ok
    !eq_ok
    !len_ok
    !read_ok
    !write_ok
    !cleanup_end_status
    !invalid_string_buffer
    !invalid_utf8_status
    !write_invalid_status
    !invalid_buf
    !string_free_status
    !string_eq
    !hello_view
    !string_view
    !string_len
    !string_data
    !read_string_status
    !write_utf8_status
    !cleanup_utf8_status
    panic(944)

L_OK:
    !ok
    !ok06
    !ok05
    !ok04
    !ok03
    !ok02
    !ok01
    !cleanup_ok
    !invalid_failed
    !write_invalid_ok
    !free_ok
    !eq_ok
    !len_ok
    !read_ok
    !write_ok
    !cleanup_end_status
    !invalid_string_buffer
    !invalid_utf8_status
    !write_invalid_status
    !invalid_buf
    !string_free_status
    !string_eq
    !hello_view
    !string_view
    !string_len
    !string_data
    !read_string_status
    !write_utf8_status
    !cleanup_utf8_status
    return

@test "sa_std fs try_exists macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_path_status, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN
    EXPAND FS_TRY_EXISTS missing_status, missing_exists, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN
    EXPAND FS_WRITE_FILE write_status, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN, FS_TEST_HELLO, FS_TEST_HELLO_LEN
    EXPAND FS_TRY_EXISTS present_status, present_exists, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN
    EXPAND FS_REMOVE_PATH cleanup_end_status, FS_EXISTS_PATH, FS_EXISTS_PATH_LEN

    missing_status_ok = eq missing_status, SA_FS_OK
    missing_value_ok = eq missing_exists, 0
    write_ok = eq write_status, SA_FS_OK
    present_status_ok = eq present_status, SA_FS_OK
    present_value_ok = eq present_exists, 1
    cleanup_ok = eq cleanup_end_status, SA_FS_OK
    ok01 = and missing_status_ok, missing_value_ok
    ok02 = and ok01, write_ok
    ok03 = and ok02, present_status_ok
    ok04 = and ok03, present_value_ok
    ok = and ok04, cleanup_ok
    br ok -> L_OK, L_FAIL

L_FAIL:
    call @sa_test_debug_i64(&FS_DBG_TRY_EXISTS_STATUS, FS_DBG_TRY_EXISTS_STATUS_LEN, missing_status)
    call @sa_test_debug_i64(&FS_DBG_EXISTS, FS_DBG_EXISTS_LEN, missing_exists)
    call @sa_test_debug_i64(&FS_DBG_WRITE_STATUS, FS_DBG_WRITE_STATUS_LEN, write_status)
    call @sa_test_debug_i64(&FS_DBG_TRY_EXISTS_STATUS, FS_DBG_TRY_EXISTS_STATUS_LEN, present_status)
    call @sa_test_debug_i64(&FS_DBG_EXISTS, FS_DBG_EXISTS_LEN, present_exists)
    call @sa_test_debug_i64(&FS_DBG_REMOVE_STATUS, FS_DBG_REMOVE_STATUS_LEN, cleanup_end_status)
    call @sa_assert_eq_i64(missing_status, SA_FS_OK, 945)
    call @sa_assert_eq_i64(missing_exists, 0, 945)
    call @sa_assert_eq_i64(write_status, SA_FS_OK, 945)
    call @sa_assert_eq_i64(present_status, SA_FS_OK, 945)
    call @sa_assert_eq_i64(present_exists, 1, 945)
    call @sa_assert_eq_i64(cleanup_end_status, SA_FS_OK, 945)
    !ok
    !ok04
    !ok03
    !ok02
    !ok01
    !cleanup_ok
    !present_value_ok
    !present_status_ok
    !write_ok
    !missing_value_ok
    !missing_status_ok
    !cleanup_end_status
    !present_exists
    !present_status
    !write_status
    !missing_exists
    !missing_status
    !cleanup_path_status
    panic(945)

L_OK:
    !ok
    !ok04
    !ok03
    !ok02
    !ok01
    !cleanup_ok
    !present_value_ok
    !present_status_ok
    !write_ok
    !missing_value_ok
    !missing_status_ok
    !cleanup_end_status
    !present_exists
    !present_status
    !write_status
    !missing_exists
    !missing_status
    !cleanup_path_status
    return

@test "sa_std fs DirBuilder macro surface"():
L_ENTRY:
    EXPAND FS_REMOVE_PATH cleanup_recursive_status, FS_DB_BASE, FS_DB_BASE_LEN
    EXPAND FS_REMOVE_PATH cleanup_single_status, FS_DB_SINGLE, FS_DB_SINGLE_LEN

    EXPAND FS_DIR_BUILDER_NEW b_recursive, b_mode
    new_recursive_ok = eq b_recursive, 0
    new_mode_ok = eq b_mode, 493

    EXPAND FS_DIR_BUILDER_WITH_RECURSIVE b_rec2, b_mode2, b_recursive, b_mode, 1
    rec_flag_ok = eq b_rec2, 1
    rec_mode_ok = eq b_mode2, 493

    EXPAND FS_DIR_BUILDER_WITH_MODE b_rec3, b_mode3, b_rec2, b_mode2, 448
    mode_flag_ok = eq b_rec3, 1
    mode_val_ok = eq b_mode3, 448

    EXPAND FS_DIR_BUILDER_CREATE create_recursive_status, b_rec3, b_mode3, FS_DB_DIR, FS_DB_DIR_LEN
    create_recursive_ok = eq create_recursive_status, SA_FS_OK
    EXPAND FS_EXISTS exists_recursive, FS_DB_DIR, FS_DB_DIR_LEN
    exists_recursive_ok = eq exists_recursive, 1

    EXPAND FS_DIR_BUILDER_NEW s_recursive, s_mode
    EXPAND FS_DIR_BUILDER_WITH_RECURSIVE s_rec2, s_mode2, s_recursive, s_mode, 3
    s_rec_flag_ok = eq s_rec2, 1
    EXPAND FS_DIR_BUILDER_CREATE create_single_status, s_rec2, s_mode2, FS_DB_SINGLE, FS_DB_SINGLE_LEN
    create_single_ok = eq create_single_status, SA_FS_OK
    EXPAND FS_EXISTS exists_single, FS_DB_SINGLE, FS_DB_SINGLE_LEN
    exists_single_ok = eq exists_single, 1

    EXPAND FS_REMOVE_PATH cleanup_final_recursive_status, FS_DB_BASE, FS_DB_BASE_LEN
    EXPAND FS_REMOVE_PATH cleanup_final_single_status, FS_DB_SINGLE, FS_DB_SINGLE_LEN

    ok = and new_recursive_ok, new_mode_ok
    ok = and ok, rec_flag_ok
    ok = and ok, rec_mode_ok
    ok = and ok, mode_flag_ok
    ok = and ok, mode_val_ok
    ok = and ok, create_recursive_ok
    ok = and ok, exists_recursive_ok
    ok = and ok, s_rec_flag_ok
    ok = and ok, create_single_ok
    ok = and ok, exists_single_ok

    !b_recursive
    !b_mode
    !b_rec2
    !b_mode2
    !b_rec3
    !b_mode3
    !s_recursive
    !s_mode
    !s_rec2
    !s_mode2
    !cleanup_recursive_status
    !cleanup_single_status
    !create_recursive_status
    !exists_recursive
    !create_single_status
    !exists_single
    !cleanup_final_recursive_status
    !cleanup_final_single_status
    !new_recursive_ok
    !new_mode_ok
    !rec_flag_ok
    !rec_mode_ok
    !mode_flag_ok
    !mode_val_ok
    !create_recursive_ok
    !exists_recursive_ok
    !s_rec_flag_ok
    !create_single_ok
    !exists_single_ok
    br ok -> L_OK, L_FAIL
L_FAIL:
    !ok
    panic(946)
L_OK:
    !ok
    return
