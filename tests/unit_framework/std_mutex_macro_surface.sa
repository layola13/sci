@import "sa_std/sync/mutex.sa"

@test "sa_std sync mutex try-lock state macros"():
L_ENTRY:
    EXPAND MUTEX_NEW mutex
    EXPAND MUTEX_IS_LOCKED locked0, mutex
    EXPAND MUTEX_TRY_LOCK try0_ok, mutex
    EXPAND MUTEX_IS_LOCKED locked1, mutex
    EXPAND MUTEX_TRY_LOCK try1_ok, mutex
    EXPAND MUTEX_UNLOCK mutex
    EXPAND MUTEX_IS_LOCKED locked2, mutex
    EXPAND MUTEX_LOCK mutex
    EXPAND MUTEX_IS_LOCKED locked3, mutex
    EXPAND MUTEX_FORCE_UNLOCKED mutex
    EXPAND MUTEX_IS_LOCKED locked4, mutex

    ok_locked0 = eq locked0, 0
    ok_try0 = eq try0_ok, 1
    ok_locked1 = eq locked1, 1
    ok_try1 = eq try1_ok, 0
    ok_locked2 = eq locked2, 0
    ok_locked3 = eq locked3, 1
    ok_locked4 = eq locked4, 0

    ok01 = and ok_locked0, ok_try0
    ok02 = and ok01, ok_locked1
    ok03 = and ok02, ok_try1
    ok04 = and ok03, ok_locked2
    ok05 = and ok04, ok_locked3
    ok = and ok05, ok_locked4

    !mutex
    !locked0
    !try0_ok
    !locked1
    !try1_ok
    !locked2
    !locked3
    !locked4
    !ok_locked0
    !ok_try0
    !ok_locked1
    !ok_try1
    !ok_locked2
    !ok_locked3
    !ok_locked4
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05

    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(998)

L_PASS:
    !ok
    return 0
