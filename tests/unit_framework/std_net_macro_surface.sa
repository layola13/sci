    !connect_status
    !listener_options_ok
    !bind_ok
    !bound_port
    !listener
    !bind_status
    panic(955)

L_STREAM_OPTIONS:
    EXPAND NET_TCP_STREAM_SET_NODELAY set_nodelay_status, client, SA_NET_SOCKET_OPTION_ENABLE
    EXPAND NET_TCP_STREAM_SET_TTL set_ttl_status, client, 64
    EXPAND NET_TCP_STREAM_SET_READ_TIMEOUT set_read_timeout_status, server, NET_TEST_TIMEOUT_NS
    EXPAND NET_TCP_STREAM_SET_WRITE_TIMEOUT set_write_timeout_status, client, NET_TEST_TIMEOUT_NS
