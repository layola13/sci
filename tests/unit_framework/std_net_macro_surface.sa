    EXPAND NET_TCP_STREAM_WRITE_TIMEOUT write_timeout_status, write_timeout_ns, client
    EXPAND NET_TCP_STREAM_TAKE_ERROR stream_error_status, stream_error, client
    set_nodelay_ok = eq set_nodelay_status, 0
    set_ttl_ok = eq set_ttl_status, 0
    set_read_timeout_ok = eq set_read_timeout_status, 0
    set_write_timeout_ok = eq set_write_timeout_status, 0
