@import "sa_std/hash.sa"

@test "sa_std hash default hasher macros"():
L_ENTRY:
    hasher_a = stack_alloc DefaultHasher_SIZE
    hasher_b = stack_alloc DefaultHasher_SIZE
    hasher_c = stack_alloc DefaultHasher_SIZE
    EXPAND DEFAULT_HASHER_NEW hasher_a
    EXPAND DEFAULT_HASHER_NEW hasher_b
    EXPAND DEFAULT_HASHER_NEW hasher_c

    EXPAND DEFAULT_HASHER_WRITE_U64 hasher_a, 7
    EXPAND DEFAULT_HASHER_WRITE_BOOL hasher_a, 1
    EXPAND DEFAULT_HASHER_WRITE_U32 hasher_a, 99
    EXPAND DEFAULT_HASHER_FINISH hash_a, hasher_a

    EXPAND DEFAULT_HASHER_WRITE_U64 hasher_b, 7
    EXPAND DEFAULT_HASHER_WRITE_BOOL hasher_b, 1
    EXPAND DEFAULT_HASHER_WRITE_U32 hasher_b, 99
    EXPAND DEFAULT_HASHER_FINISH hash_b, hasher_b

    EXPAND DEFAULT_HASHER_WRITE_U64 hasher_c, 8
    EXPAND DEFAULT_HASHER_WRITE_BOOL hasher_c, 1
    EXPAND DEFAULT_HASHER_WRITE_U32 hasher_c, 99
    EXPAND DEFAULT_HASHER_FINISH hash_c, hasher_c

    EXPAND DEFAULT_HASHER_RESET hasher_c
    EXPAND DEFAULT_HASHER_FINISH reset_hash, hasher_c

    ptr_slot = stack_alloc 8
    EXPAND HASH_PTR_VALUE ptr_hash, ptr_slot
    EXPAND HASH_U64 direct_hash, 7

    EXPAND BUILD_HASHER_DEFAULT_NEW builder
    built_hasher = stack_alloc DefaultHasher_SIZE
    EXPAND BUILD_HASHER_DEFAULT_BUILD built_hasher, builder
    EXPAND DEFAULT_HASHER_WRITE_USIZE built_hasher, 7
    EXPAND DEFAULT_HASHER_FINISH built_hash, built_hasher

    same_hash = eq hash_a, hash_b
    diff_hash = ne hash_a, hash_c
    reset_ok = eq reset_hash, HASHER_DEFAULT_SEED
    ptr_hash_changed = ne ptr_hash, HASHER_DEFAULT_SEED
    direct_hash_changed = ne direct_hash, HASHER_DEFAULT_SEED
    built_hash_eq = eq built_hash, direct_hash
    ok01 = and same_hash, diff_hash
    ok02 = and ok01, reset_ok
    ok03 = and ok02, ptr_hash_changed
    ok04 = and ok03, direct_hash_changed
    ok = and ok04, built_hash_eq

    !hash_a
    !hash_b
    !hash_c
    !reset_hash
    !ptr_hash
    !direct_hash
    !builder
    !built_hash
    !same_hash
    !diff_hash
    !reset_ok
    !ptr_hash_changed
    !direct_hash_changed
    !built_hash_eq
    !ok01
    !ok02
    !ok03
    !ok04

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(996)

L_PASS:
    return 0
