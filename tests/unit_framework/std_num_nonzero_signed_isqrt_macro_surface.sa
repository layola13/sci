@import "sa_std/num.sa"

@test "sa_std signed NonZero isqrt macro surface"():
L_ENTRY:
    i8_nz = stack_alloc NonZeroI8_SIZE
    i16_nz = stack_alloc NonZeroI16_SIZE
    i32_nz = stack_alloc NonZeroI32_SIZE
    i64_nz = stack_alloc NonZeroI64_SIZE
    isize_nz = stack_alloc NonZeroIsize_SIZE

    i8_out = stack_alloc NonZeroI8_SIZE
    i16_out = stack_alloc NonZeroI16_SIZE
    i32_out = stack_alloc NonZeroI32_SIZE
    i64_out = stack_alloc NonZeroI64_SIZE
    isize_out = stack_alloc NonZeroIsize_SIZE

    EXPAND NONZERO_I8_NEW ok_i8, i8_nz, 100
    EXPAND NONZERO_I16_NEW ok_i16, i16_nz, 1000
    EXPAND NONZERO_I32_NEW ok_i32, i32_nz, NUM_I32_MAX
    EXPAND NONZERO_I64_NEW ok_i64, i64_nz, NUM_I64_MAX
    EXPAND NONZERO_ISIZE_NEW ok_isize, isize_nz, 225

    EXPAND NONZERO_I8_ISQRT i8_out, i8_nz
    EXPAND NONZERO_I16_ISQRT i16_out, i16_nz
    EXPAND NONZERO_I32_ISQRT i32_out, i32_nz
    EXPAND NONZERO_I64_ISQRT i64_out, i64_nz
    EXPAND NONZERO_ISIZE_ISQRT isize_out, isize_nz

    EXPAND NONZERO_I8_GET i8_value, i8_out
    EXPAND NONZERO_I16_GET i16_value, i16_out
    EXPAND NONZERO_I32_GET i32_value, i32_out
    EXPAND NONZERO_I64_GET i64_value, i64_out
    EXPAND NONZERO_ISIZE_GET isize_value, isize_out

    ok_new_01 = and ok_i8, ok_i16
    ok_new_02 = and ok_new_01, ok_i32
    ok_new_03 = and ok_new_02, ok_i64
    ok_new_all = and ok_new_03, ok_isize

    ok_value_01 = eq i8_value, 10
    ok_value_02 = eq i16_value, 31
    ok_value_03 = eq i32_value, 46340
    ok_value_04 = eq i64_value, 3037000499
    ok_value_05 = eq isize_value, 15

    ok_acc_01 = and ok_new_all, ok_value_01
    ok_acc_02 = and ok_acc_01, ok_value_02
    ok_acc_03 = and ok_acc_02, ok_value_03
    ok_acc_04 = and ok_acc_03, ok_value_04
    ok = and ok_acc_04, ok_value_05
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10659)

L_PASS:
    !ok
    return 0
