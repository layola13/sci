@import "sa_std/net.sa"

@const IPV4_TEXT = utf8:"192.0.2.9"
@const IPV4_TEXT_LEN = 10
@const IPV6_TEXT = utf8:"2001:db8::1"
@const IPV6_TEXT_LEN = 11
@const SOCKET4_TEXT = utf8:"192.0.2.9:8080"
@const SOCKET4_TEXT_LEN = 14
@const SOCKET6_TEXT = utf8:"[2001:db8::1]:443"
@const SOCKET6_TEXT_LEN = 17
@const BAD_TEXT = utf8:"not-an-address"
@const BAD_TEXT_LEN = 14

@test "sa_std net parse error detail kinds"():
L_ENTRY:
    ipv4 = stack_alloc NetIpv4Addr_SIZE
    ipv6 = stack_alloc NetIpv6Addr_SIZE
    ip = stack_alloc NetIpAddr_SIZE
    sock4 = stack_alloc NetSocketAddrV4_SIZE
    sock6 = stack_alloc NetSocketAddrV6_SIZE
    socket = stack_alloc NetSocketAddr_SIZE

    EXPAND NET_IPV4_TRY_PARSE_ASCII_DETAIL ipv4_ok, ipv4_kind, ipv4, IPV4_TEXT, IPV4_TEXT_LEN
    EXPAND NET_IPV6_TRY_PARSE_ASCII_DETAIL ipv6_ok, ipv6_kind, ipv6, IPV6_TEXT, IPV6_TEXT_LEN
    EXPAND NET_IP_ADDR_TRY_PARSE_ASCII_DETAIL ip_ok, ip_kind, ip, IPV4_TEXT, IPV4_TEXT_LEN
    EXPAND NET_SOCKET_ADDR_V4_TRY_PARSE_ASCII_DETAIL sock4_ok, sock4_kind, sock4, SOCKET4_TEXT, SOCKET4_TEXT_LEN
    EXPAND NET_SOCKET_ADDR_V6_TRY_PARSE_ASCII_DETAIL sock6_ok, sock6_kind, sock6, SOCKET6_TEXT, SOCKET6_TEXT_LEN
    EXPAND NET_SOCKET_ADDR_TRY_PARSE_ASCII_DETAIL socket_ok, socket_kind, socket, BAD_TEXT, BAD_TEXT_LEN

    ipv4_bad = stack_alloc NetIpv4Addr_SIZE
    ipv6_bad = stack_alloc NetIpv6Addr_SIZE
    EXPAND NET_IPV4_PARSE_ASCII_DETAIL ipv4_bad_ok, ipv4_bad_kind, ipv4_bad, BAD_TEXT, BAD_TEXT_LEN
    EXPAND NET_IPV6_PARSE_ASCII_DETAIL ipv6_bad_ok, ipv6_bad_kind, ipv6_bad, BAD_TEXT, BAD_TEXT_LEN

    ok01 = and ipv4_ok, eq ipv4_kind, ADDR_PARSE_ERROR_IPV4
    ok02 = and ok01, ipv6_ok
    ok03 = and ok02, eq ipv6_kind, ADDR_PARSE_ERROR_IPV6
    ok04 = and ok03, ip_ok
    ok05 = and ok04, eq ip_kind, ADDR_PARSE_ERROR_IP
    ok06 = and ok05, sock4_ok
    ok07 = and ok06, eq sock4_kind, ADDR_PARSE_ERROR_SOCKET_V4
    ok08 = and ok07, sock6_ok
    ok09 = and ok08, eq sock6_kind, ADDR_PARSE_ERROR_SOCKET_V6
    ok10 = and ok09, eq socket_ok, 0
    ok11 = and ok10, eq socket_kind, ADDR_PARSE_ERROR_SOCKET
    ok12 = and ok11, eq ipv4_bad_ok, 0
    ok13 = and ok12, eq ipv4_bad_kind, ADDR_PARSE_ERROR_IPV4
    ok14 = and ok13, eq ipv6_bad_ok, 0
    ok = and ok14, eq ipv6_bad_kind, ADDR_PARSE_ERROR_IPV6

    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    br ok -> L_PASS, L_FAIL

L_FAIL:
    !ok
    panic(10595)

L_PASS:
    !ok
    return 0
