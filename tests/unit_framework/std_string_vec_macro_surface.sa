    EXPAND STR_FROM_PARTS split_tail_expected, &MUT_SUFFIX, 4
    EXPAND STR_FROM_PARTS insert_byte_expected, &MUT_AFTER_INSERT_BYTE, 9

    EXPAND STRING_PUSH_STR string, suffix
    EXPAND STR_EQ pushed_eq, string, pushed_expected
    EXPAND STRING_PUSH string, 33
    EXPAND STRING_LEN len_after_push, string
