    range_to_ae_flag_ok = eq range_to_ae_ok, 1
    range_from_smile_z_flag_ok = eq range_from_smile_z_ok, 1
    between_smile_flag_ok = eq between_smile_ok, 1
    between_bad_order_flag_ok = eq between_bad_order_ok, 0
    split_checked_flag_ok = eq split_checked_ok, 1
    split_checked_bad_flag_ok = eq split_checked_bad_ok, 0
    prefix_ae_value_ok = eq prefix_ae_eq, 1
    suffix_smile_z_value_ok = eq suffix_smile_z_eq, 1
    suffix_z_value_ok = eq suffix_z_eq, 1
    range_to_ae_value_ok = eq range_to_ae_eq, 1
    range_from_smile_z_value_ok = eq range_from_smile_z_eq, 1
    between_smile_value_ok = eq between_smile_eq, 1
    between_bad_order_empty_ok = eq between_bad_order_empty, 1
    split_checked_left_ok = eq split_checked_left_eq, 1
