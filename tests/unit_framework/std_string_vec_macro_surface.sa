    ok14 = and ok13, starts_match_ok
    ok15 = and ok14, ends_match_ok
    ok16 = and ok15, starts_empty_match_ok
    ok17 = and ok16, ends_empty_match_ok
    ok18 = and ok17, starts_miss_ok
    ok19 = and ok18, ends_long_miss_ok
