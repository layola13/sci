    EXPAND STRING_BUF_FREE replaced_buf
    EXPAND STRING_BUF_FREE replace_empty_buf
    EXPAND STRING_BUF_FREE replace_multi_buf
    EXPAND STRING_BUF_FREE replace_long_buf
    br ok -> L_STRING_BUF_UTF8_OK, L_STRING_BUF_UTF8_FAIL

L_STRING_BUF_UTF8_FAIL:
    !ok
    panic(915)

L_STRING_BUF_UTF8_OK:
