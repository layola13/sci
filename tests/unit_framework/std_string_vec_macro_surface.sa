    EXPAND SLICE_NEW select_key_slice, select_key_data, 4
    EXPAND SLICE_TRY_SELECT_NTH_UNSTABLE_U64 select_ok, select_left, select_pivot_ptr, select_right, select_slice, 2
    EXPAND SLICE_TRY_SELECT_NTH_UNSTABLE_BY_U64 select_by_ok, select_by_left, select_by_pivot_ptr, select_by_right, select_by_slice, 1, @slice_sorted_ge
    EXPAND SLICE_TRY_SELECT_NTH_UNSTABLE_BY_KEY_U64 select_key_ok, select_key_left, select_key_pivot_ptr, select_key_right, select_key_slice, 2, @slice_sorted_key_tens
    EXPAND SLICE_TRY_SELECT_NTH_UNSTABLE_U64 select_miss_ok, select_miss_left, select_miss_pivot_ptr, select_miss_right, select_slice, 9

    select_left_len = load select_left+Slice_len as u64
    select_pivot = load select_pivot_ptr+0 as u64
    select_right_len = load select_right+Slice_len as u64
    EXPAND SLICE_GET_U64 select_left0, select_left, 0
