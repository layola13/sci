@test "sa_std slice and vec sorted callback macros"():
L_ENTRY:
    sorted_data = alloc 24
    dup_data = alloc 24
    unsorted_data = alloc 24
    key_sorted_data = alloc 32
    key_unsorted_data = alloc 24
    empty_data = alloc 8
    store sorted_data+0, 1 as u64
    store sorted_data+8, 2 as u64
    store sorted_data+16, 3 as u64
    store dup_data+0, 1 as u64
    store dup_data+8, 2 as u64
    store dup_data+16, 2 as u64
    store unsorted_data+0, 1 as u64
    store unsorted_data+8, 3 as u64
    store unsorted_data+16, 2 as u64
    store key_sorted_data+0, 11 as u64
    store key_sorted_data+8, 19 as u64
    store key_sorted_data+16, 21 as u64
    store key_sorted_data+24, 29 as u64
    store key_unsorted_data+0, 21 as u64
    store key_unsorted_data+8, 19 as u64
    store key_unsorted_data+16, 31 as u64
    sorted = alloc Slice_SIZE
    dup = alloc Slice_SIZE
    unsorted = alloc Slice_SIZE
    key_sorted = alloc Slice_SIZE
    key_unsorted = alloc Slice_SIZE
    empty = alloc Slice_SIZE
    EXPAND SLICE_NEW sorted, sorted_data, 3
    EXPAND SLICE_NEW dup, dup_data, 3
    EXPAND SLICE_NEW unsorted, unsorted_data, 3
    EXPAND SLICE_NEW key_sorted, key_sorted_data, 4
    EXPAND SLICE_NEW key_unsorted, key_unsorted_data, 3
    EXPAND SLICE_NEW empty, empty_data, 0

    EXPAND SLICE_IS_SORTED_BY_U64 sorted_by_le, sorted, @slice_sorted_le
    EXPAND SLICE_IS_SORTED_BY_U64 dup_by_le, dup, @slice_sorted_le
    EXPAND SLICE_IS_SORTED_BY_U64 dup_by_lt, dup, @slice_sorted_lt
    EXPAND SLICE_IS_SORTED_BY_U64 unsorted_by_le, unsorted, @slice_sorted_le
    EXPAND SLICE_IS_SORTED_BY_U64 empty_by_lt, empty, @slice_sorted_lt
    EXPAND SLICE_IS_SORTED_BY_KEY_U64 key_sorted_ok, key_sorted, @slice_sorted_key_tens
    EXPAND SLICE_IS_SORTED_BY_KEY_U64 key_unsorted_ok, key_unsorted, @slice_sorted_key_tens
    EXPAND SLICE_IS_SORTED_BY_KEY_U64 empty_key_ok, empty, @slice_sorted_key_tens

    EXPAND VEC_NEW vec
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_IS_SORTED_BY_U64 vec_by_le, vec, @slice_sorted_le
    EXPAND VEC_IS_SORTED_BY_U64 vec_by_lt, vec, @slice_sorted_lt
    EXPAND VEC_PUSH_U64 vec, 19
    EXPAND VEC_IS_SORTED_BY_U64 vec_unsorted_by_le, vec, @slice_sorted_le

    EXPAND VEC_NEW key_vec
    EXPAND VEC_PUSH_U64 key_vec, 11
    EXPAND VEC_PUSH_U64 key_vec, 19
    EXPAND VEC_PUSH_U64 key_vec, 21
    EXPAND VEC_IS_SORTED_BY_KEY_U64 vec_key_sorted_ok, key_vec, @slice_sorted_key_tens
    EXPAND VEC_PUSH_U64 key_vec, 15
    EXPAND VEC_IS_SORTED_BY_KEY_U64 vec_key_unsorted_ok, key_vec, @slice_sorted_key_tens

    sorted_by_le_ok = eq sorted_by_le, 1
    dup_by_le_ok = eq dup_by_le, 1
    dup_by_lt_ok = eq dup_by_lt, 0
    unsorted_by_le_ok = eq unsorted_by_le, 0
    empty_by_lt_ok = eq empty_by_lt, 1
    key_sorted_flag_ok = eq key_sorted_ok, 1
    key_unsorted_flag_ok = eq key_unsorted_ok, 0
    empty_key_flag_ok = eq empty_key_ok, 1
    vec_by_le_ok = eq vec_by_le, 1
    vec_by_lt_ok = eq vec_by_lt, 0
    vec_unsorted_by_le_ok = eq vec_unsorted_by_le, 0
    vec_key_sorted_flag_ok = eq vec_key_sorted_ok, 1
    vec_key_unsorted_flag_ok = eq vec_key_unsorted_ok, 0

    ok01 = and sorted_by_le_ok, dup_by_le_ok
    ok02 = and ok01, dup_by_lt_ok
    ok03 = and ok02, unsorted_by_le_ok
    ok04 = and ok03, empty_by_lt_ok
    ok05 = and ok04, key_sorted_flag_ok
    ok06 = and ok05, key_unsorted_flag_ok
    ok07 = and ok06, empty_key_flag_ok
    ok08 = and ok07, vec_by_le_ok
    ok09 = and ok08, vec_by_lt_ok
    ok10 = and ok09, vec_unsorted_by_le_ok
    ok11 = and ok10, vec_key_sorted_flag_ok
    ok = and ok11, vec_key_unsorted_flag_ok

    !sorted_data
    !dup_data
    !unsorted_data
    !key_sorted_data
    !key_unsorted_data
    !empty_data
    !sorted
    !dup
    !unsorted
    !key_sorted
    !key_unsorted
    !empty
    !sorted_by_le
    !dup_by_le
    !dup_by_lt
    !unsorted_by_le
    !empty_by_lt
    !key_sorted_ok
    !key_unsorted_ok
    !empty_key_ok
    !vec_by_le
    !vec_by_lt
    !vec_unsorted_by_le
    !vec_key_sorted_ok
    !vec_key_unsorted_ok
    !sorted_by_le_ok
    !dup_by_le_ok
    !dup_by_lt_ok
    !unsorted_by_le_ok
    !empty_by_lt_ok
    !key_sorted_flag_ok
    !key_unsorted_flag_ok
    !empty_key_flag_ok
    !vec_by_le_ok
    !vec_by_lt_ok
    !vec_unsorted_by_le_ok
    !vec_key_sorted_flag_ok
    !vec_key_unsorted_flag_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    EXPAND VEC_FREE vec
    EXPAND VEC_FREE key_vec
    br ok -> L_SLICE_VEC_SORTED_CALLBACK_OK, L_SLICE_VEC_SORTED_CALLBACK_FAIL

L_SLICE_VEC_SORTED_CALLBACK_FAIL:
    !ok
    panic(923)

L_SLICE_VEC_SORTED_CALLBACK_OK:
    !ok
    return

