    !suffix_slice
    !prefix_slice
    !long_suffix_data
    !miss_prefix_data
    !empty_slice
    !slice
    !data
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(903)

L_OK:
    !ok
    return

@test "sa_std vec capacity/view macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 20
    EXPAND VEC_RESIZE_U64 vec, 5, 30
    EXPAND VEC_CAPACITY cap_after_resize, vec
    EXPAND VEC_AS_MUT_SLICE mut_slice, vec
    EXPAND SLICE_GET_LEN mut_slice_len, mut_slice
    EXPAND VEC_SET_LEN vec, 3
    EXPAND VEC_LEN len_after_set_len, vec
    EXPAND VEC_SHRINK_TO_U64 vec, 2
    EXPAND VEC_CAPACITY cap_after_shrink_to, vec
    EXPAND VEC_TRY_SHRINK_TO_U64 try_shrink_to_ok, vec, 2
    EXPAND VEC_CAPACITY cap_after_try_shrink_to, vec
    EXPAND VEC_SHRINK_TO_FIT_U64 vec
    EXPAND VEC_CAPACITY cap_after_shrink_to_fit, vec
    EXPAND VEC_TRY_SHRINK_TO_FIT_U64 try_shrink_to_fit_ok, vec
    EXPAND VEC_CAPACITY cap_after_try_shrink_to_fit, vec
    EXPAND VEC_TRY_SHRINK_TO try_shrink_to_generic_ok, vec, 2, 8
    EXPAND VEC_CAPACITY cap_after_try_shrink_to_generic, vec
    EXPAND VEC_TRY_SHRINK_TO_FIT try_shrink_to_fit_generic_ok, vec, 8
    EXPAND VEC_CAPACITY cap_after_try_shrink_to_fit_generic, vec
    EXPAND VEC_TRY_GET_U64 tail_ok, tail_value, vec, 2

    resize_cap_ok = eq cap_after_resize, 5
    mut_slice_len_ok = eq mut_slice_len, 5
    set_len_ok = eq len_after_set_len, 3
    shrink_to_ok = eq cap_after_shrink_to, 3
    try_shrink_to_flag_ok = eq try_shrink_to_ok, 1
    try_shrink_to_cap_ok = eq cap_after_try_shrink_to, 3
    shrink_to_fit_ok = eq cap_after_shrink_to_fit, 3
    try_shrink_to_fit_flag_ok = eq try_shrink_to_fit_ok, 1
    try_shrink_to_fit_cap_ok = eq cap_after_try_shrink_to_fit, 3
    try_shrink_to_generic_flag_ok = eq try_shrink_to_generic_ok, 1
    try_shrink_to_generic_cap_ok = eq cap_after_try_shrink_to_generic, 3
    try_shrink_to_fit_generic_flag_ok = eq try_shrink_to_fit_generic_ok, 1
    try_shrink_to_fit_generic_cap_ok = eq cap_after_try_shrink_to_fit_generic, 3
    tail_flag_ok = eq tail_ok, 1
    tail_value_ok = eq tail_value, 30
    ok01 = and resize_cap_ok, mut_slice_len_ok
    ok02 = and ok01, set_len_ok
    ok03 = and ok02, shrink_to_ok
    ok04 = and ok03, try_shrink_to_flag_ok
    ok05 = and ok04, try_shrink_to_cap_ok
    ok06 = and ok05, shrink_to_fit_ok
    ok07 = and ok06, try_shrink_to_fit_flag_ok
    ok08 = and ok07, try_shrink_to_fit_cap_ok
    ok09 = and ok08, try_shrink_to_generic_flag_ok
    ok10 = and ok09, try_shrink_to_generic_cap_ok
    ok11 = and ok10, try_shrink_to_fit_generic_flag_ok
    ok12 = and ok11, try_shrink_to_fit_generic_cap_ok
    ok13 = and ok12, tail_flag_ok
    ok = and ok13, tail_value_ok
    !cap_after_resize
    !mut_slice
    !mut_slice_len
    !len_after_set_len
    !cap_after_shrink_to
    !try_shrink_to_ok
    !cap_after_try_shrink_to
    !cap_after_shrink_to_fit
    !try_shrink_to_fit_ok
    !cap_after_try_shrink_to_fit
    !try_shrink_to_generic_ok
    !cap_after_try_shrink_to_generic
    !try_shrink_to_fit_generic_ok
    !cap_after_try_shrink_to_fit_generic
    !tail_ok
    !tail_value
    !resize_cap_ok
    !mut_slice_len_ok
    !set_len_ok
    !shrink_to_ok
    !try_shrink_to_flag_ok
    !try_shrink_to_cap_ok
    !shrink_to_fit_ok
    !try_shrink_to_fit_flag_ok
    !try_shrink_to_fit_cap_ok
    !try_shrink_to_generic_flag_ok
    !try_shrink_to_generic_cap_ok
    !try_shrink_to_fit_generic_flag_ok
    !try_shrink_to_fit_generic_cap_ok
    !tail_flag_ok
    !tail_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    EXPAND VEC_FREE vec
    br ok -> L_VEC_CAP_OK, L_VEC_CAP_FAIL

L_VEC_CAP_FAIL:
    !ok
    panic(907)

L_VEC_CAP_OK:
    !ok
    return

@test "sa_std slice mutation and search macros"():
L_ENTRY:
    src_data = alloc 24
    dst_data = alloc 24
    store src_data+0, 10 as u64
    store src_data+8, 20 as u64
    store src_data+16, 30 as u64
    store dst_data+0, 1 as u64
    store dst_data+8, 2 as u64
    store dst_data+16, 3 as u64
    src = alloc Slice_SIZE
    dst = alloc Slice_SIZE
    EXPAND SLICE_NEW src, src_data, 3
    EXPAND SLICE_NEW dst, dst_data, 3
    EXPAND SLICE_COPY_FROM_SLICE_U64 copy_ok, dst, src
    EXPAND SLICE_GET_U64 copied_mid, dst, 1
    EXPAND SLICE_REVERSE_U64 dst
    EXPAND SLICE_GET_U64 reversed_first, dst, 0
    EXPAND SLICE_GET_U64 reversed_last, dst, 2
    EXPAND SLICE_FILL_U64 dst, 7
    EXPAND SLICE_GET_U64 filled_first, dst, 0
    EXPAND SLICE_GET_U64 filled_last, dst, 2
    EXPAND SLICE_TRY_FIRST_MUT_PTR_U64 first_mut_ok, first_mut_ptr, dst
    store first_mut_ptr+0, 70 as u64
    !first_mut_ptr
    EXPAND SLICE_TRY_LAST_MUT_PTR_U64 last_mut_ok, last_mut_ptr, dst
    store last_mut_ptr+0, 90 as u64
    !last_mut_ptr
    EXPAND SLICE_TRY_GET_MUT_PTR_U64 mid_mut_ok, mid_mut_ptr, dst, 1
    store mid_mut_ptr+0, 80 as u64
    !mid_mut_ptr
    EXPAND SLICE_TRY_GET_MUT_PTR_U64 mut_miss_ok, mut_miss_ptr, dst, 9
    mut_miss_ptr_ok = eq mut_miss_ptr, 0
    !mut_miss_ptr
    EXPAND SLICE_FIRST_MUT_PTR_U64 first_direct_ptr, dst
    first_direct_value = load first_direct_ptr+0 as u64
    !first_direct_ptr
    EXPAND SLICE_LAST_MUT_PTR_U64 last_direct_ptr, dst
    last_direct_value = load last_direct_ptr+0 as u64
    !last_direct_ptr
    EXPAND SLICE_GET_U64 mutated_mid, dst, 1
    EXPAND SLICE_TRY_RANGE_U64 range_ok, range_slice, dst, 1, 2
    EXPAND SLICE_GET_LEN range_len, range_slice
    EXPAND SLICE_FIRST_U64 range_first, range_slice
    EXPAND SLICE_LAST_U64 range_last, range_slice
    EXPAND SLICE_TRY_GET_RANGE_U64 range_alias_ok, range_alias_slice, dst, 0, 2
    EXPAND SLICE_GET_LEN range_alias_len, range_alias_slice
    EXPAND SLICE_TRY_RANGE_U64 range_miss_ok, range_miss_slice, dst, 2, 5
    EXPAND SLICE_GET_LEN range_miss_len, range_miss_slice
    EXPAND SLICE_TRY_SPLIT_AT_MUT_U64 split_mut_ok, split_left, split_right, dst, 2
    EXPAND SLICE_GET_LEN split_left_len, split_left
    EXPAND SLICE_GET_LEN split_right_len, split_right
    EXPAND SLICE_FIRST_MUT_PTR_U64 split_right_ptr, split_right
    store split_right_ptr+0, 99 as u64
    !split_right_ptr
    EXPAND SLICE_GET_U64 split_view_value, dst, 2
    EXPAND SLICE_TRY_SWAP_U64 swap_ok, dst, 0, 2
    EXPAND SLICE_GET_U64 swap_first, dst, 0
    EXPAND SLICE_GET_U64 swap_last, dst, 2
    EXPAND SLICE_TRY_SWAP_U64 swap_miss_ok, dst, 0, 9
    EXPAND SLICE_SWAP_U64 dst, 0, 1
    EXPAND SLICE_GET_U64 swap_direct_first, dst, 0
    EXPAND SLICE_GET_U64 swap_direct_mid, dst, 1
    EXPAND SLICE_CLONE_FROM_SLICE_U64 clone_ok, dst, src
    EXPAND SLICE_GET_U64 clone_last, dst, 2
    cw_data = alloc 40
    store cw_data+0, 1 as u64
    store cw_data+8, 2 as u64
    store cw_data+16, 3 as u64
    store cw_data+24, 4 as u64
    store cw_data+32, 5 as u64
    cw = alloc Slice_SIZE
    EXPAND SLICE_NEW cw, cw_data, 5
    EXPAND SLICE_COPY_WITHIN_U64 cw_back_ok, cw, 0, 3, 2
    EXPAND SLICE_GET_U64 cw_back_two, cw, 2
    EXPAND SLICE_GET_U64 cw_back_four, cw, 4
    EXPAND SLICE_COPY_WITHIN_U64 cw_fwd_ok, cw, 3, 2, 0
    EXPAND SLICE_GET_U64 cw_fwd_zero, cw, 0
    EXPAND SLICE_GET_U64 cw_fwd_one, cw, 1
    EXPAND SLICE_COPY_WITHIN_U64 cw_miss_ok, cw, 4, 2, 0
    sorted_data = alloc 32
    store sorted_data+0, 5 as u64
    store sorted_data+8, 10 as u64
    store sorted_data+16, 20 as u64
    store sorted_data+24, 40 as u64
    sorted = alloc Slice_SIZE
    EXPAND SLICE_NEW sorted, sorted_data, 4
    EXPAND SLICE_TRY_BINARY_SEARCH_U64 bs_hit_ok, bs_hit_idx, sorted, 20
    EXPAND SLICE_TRY_BINARY_SEARCH_U64 bs_miss_ok, bs_miss_idx, sorted, 30
    short_dst = alloc Slice_SIZE
    EXPAND SLICE_NEW short_dst, dst_data, 2
    EXPAND SLICE_COPY_FROM_SLICE_U64 copy_miss_ok, short_dst, src

    copy_flag_ok = eq copy_ok, 1
    copied_mid_ok = eq copied_mid, 20
    reversed_first_ok = eq reversed_first, 30
    reversed_last_ok = eq reversed_last, 10
    filled_first_ok = eq filled_first, 7
    filled_last_ok = eq filled_last, 7
    first_mut_flag_ok = eq first_mut_ok, 1
    last_mut_flag_ok = eq last_mut_ok, 1
    mid_mut_flag_ok = eq mid_mut_ok, 1
    mut_miss_flag_ok = eq mut_miss_ok, 0
    first_direct_ok = eq first_direct_value, 70
    last_direct_ok = eq last_direct_value, 90
    mutated_mid_ok = eq mutated_mid, 80
    range_flag_ok = eq range_ok, 1
    range_len_ok = eq range_len, 2
    range_first_ok = eq range_first, 80
    range_last_ok = eq range_last, 90
    range_alias_flag_ok = eq range_alias_ok, 1
    range_alias_len_ok = eq range_alias_len, 2
    range_miss_flag_ok = eq range_miss_ok, 0
    range_miss_len_ok = eq range_miss_len, 0
    split_mut_flag_ok = eq split_mut_ok, 1
    split_left_len_ok = eq split_left_len, 2
    split_right_len_ok = eq split_right_len, 1
    split_view_value_ok = eq split_view_value, 99
    swap_flag_ok = eq swap_ok, 1
    swap_first_ok = eq swap_first, 99
    swap_last_ok = eq swap_last, 70
    swap_miss_flag_ok = eq swap_miss_ok, 0
    swap_direct_first_ok = eq swap_direct_first, 80
    swap_direct_mid_ok = eq swap_direct_mid, 99
    clone_flag_ok = eq clone_ok, 1
    clone_last_ok = eq clone_last, 30
    cw_back_flag_ok = eq cw_back_ok, 1
    cw_back_two_ok = eq cw_back_two, 1
    cw_back_four_ok = eq cw_back_four, 3
    cw_fwd_flag_ok = eq cw_fwd_ok, 1
    cw_fwd_zero_ok = eq cw_fwd_zero, 2
    cw_fwd_one_ok = eq cw_fwd_one, 3
    cw_miss_flag_ok = eq cw_miss_ok, 0
    bs_hit_flag_ok = eq bs_hit_ok, 1
    bs_hit_idx_ok = eq bs_hit_idx, 2
    bs_miss_flag_ok = eq bs_miss_ok, 0
    bs_miss_idx_ok = eq bs_miss_idx, 3
    copy_miss_flag_ok = eq copy_miss_ok, 0
    ok01 = and copy_flag_ok, copied_mid_ok
    ok02 = and ok01, reversed_first_ok
    ok03 = and ok02, reversed_last_ok
    ok04 = and ok03, filled_first_ok
    ok05 = and ok04, filled_last_ok
    ok06 = and ok05, first_mut_flag_ok
    ok07 = and ok06, last_mut_flag_ok
    ok08 = and ok07, mid_mut_flag_ok
    ok09 = and ok08, mut_miss_flag_ok
    ok10 = and ok09, mut_miss_ptr_ok
    ok11 = and ok10, first_direct_ok
    ok12 = and ok11, last_direct_ok
    ok13 = and ok12, mutated_mid_ok
    ok14 = and ok13, range_flag_ok
    ok15 = and ok14, range_len_ok
    ok16 = and ok15, range_first_ok
    ok17 = and ok16, range_last_ok
    ok18 = and ok17, range_alias_flag_ok
    ok19 = and ok18, range_alias_len_ok
    ok20 = and ok19, range_miss_flag_ok
    ok21 = and ok20, range_miss_len_ok
    ok22 = and ok21, split_mut_flag_ok
    ok23 = and ok22, split_left_len_ok
    ok24 = and ok23, split_right_len_ok
    ok25 = and ok24, split_view_value_ok
    ok26 = and ok25, swap_flag_ok
    ok27 = and ok26, swap_first_ok
    ok28 = and ok27, swap_last_ok
    ok29 = and ok28, swap_miss_flag_ok
    ok30 = and ok29, swap_direct_first_ok
    ok31 = and ok30, swap_direct_mid_ok
    ok32 = and ok31, clone_flag_ok
    ok33 = and ok32, clone_last_ok
    ok34 = and ok33, cw_back_flag_ok
    ok35 = and ok34, cw_back_two_ok
    ok36 = and ok35, cw_back_four_ok
    ok37 = and ok36, cw_fwd_flag_ok
    ok38 = and ok37, cw_fwd_zero_ok
    ok39 = and ok38, cw_fwd_one_ok
    ok40 = and ok39, cw_miss_flag_ok
    ok41 = and ok40, bs_hit_flag_ok
    ok42 = and ok41, bs_hit_idx_ok
    ok43 = and ok42, bs_miss_flag_ok
    ok44 = and ok43, bs_miss_idx_ok
    ok = and ok44, copy_miss_flag_ok
