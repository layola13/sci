    EXPAND STR_EQ replace_eq, string, replace_expected
    EXPAND STRING_TRY_SPLIT_OFF split_ok, split_tail, string, 8
    EXPAND STR_EQ split_left_eq, string, split_left_expected
    EXPAND STR_EQ split_tail_eq, split_tail, split_tail_expected
    EXPAND STRING_TRY_INSERT insert_byte_ok, string, 4, 45
    EXPAND STR_EQ insert_byte_eq, string, insert_byte_expected
    EXPAND STRING_TRUNCATE string, 4
    EXPAND STRING_LEN truncate_len, string
    EXPAND STRING_CLEAR string
    EXPAND STRING_LEN clear_len, string
    EXPAND STRING_POP pop_empty_ok, pop_empty_byte, string
    EXPAND STRING_TRY_INSERT insert_miss_ok, string, 2, 33
    EXPAND STRING_TRY_REPLACE_RANGE replace_miss_ok, string, 2, 1, suffix
    EXPAND STRING_TRY_SPLIT_OFF split_miss_ok, split_miss_tail, string, 2
    EXPAND STR_IS_EMPTY split_miss_tail_empty, split_miss_tail

