    EXPAND VEC_DEDUP_BY_KEY_U64 dedup_key_len, vec, @vec_key_tens
    EXPAND VEC_LEN len_after_dedup_key, vec
    EXPAND VEC_TRY_GET_U64 first_ok, first, vec, 0
