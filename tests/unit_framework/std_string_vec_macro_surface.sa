@test "sa_std slice and vec rchunk macros"():
L_ENTRY:
    data = alloc 40
    store data+0, 10 as u64
    store data+8, 20 as u64
    store data+16, 30 as u64
    store data+24, 40 as u64
    store data+32, 50 as u64
    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 5

    EXPAND SLICE_RCHUNK_COUNT_U64 rchunk_count, slice, 2
    EXPAND SLICE_TRY_RCHUNK_AT_U64 rchunk0_ok, rchunk0, slice, 2, 0
    EXPAND SLICE_TRY_RCHUNK_AT_U64 rchunk1_ok, rchunk1, slice, 2, 1
    EXPAND SLICE_TRY_RCHUNK_AT_U64 rchunk2_ok, rchunk2, slice, 2, 2
