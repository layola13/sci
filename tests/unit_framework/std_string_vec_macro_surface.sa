    first_value_ok = eq first, 10
    second_flag_ok = eq second_ok, 1
    second_value_ok = eq second, 21
    third_flag_ok = eq third_ok, 1
    third_value_ok = eq third, 31
    fourth_flag_ok = eq fourth_ok, 0
    fourth_value_ok = eq fourth, 0
    remain_len_ok = eq remain_len, 2
