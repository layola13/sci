@import "sa_std/string.sa"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"

@const WORD = utf8:"rust"
@const PREFIX = utf8:"ru"
@const SUFFIX = utf8:"st"
@const INFIX = utf8:"us"
@const REPEATED = utf8:"ana"
@const MISS = utf8:"zz"

@test "sa_std string convenience macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS word, &WORD, 4
    EXPAND STR_FROM_PARTS prefix, &PREFIX, 2
    EXPAND STR_FROM_PARTS suffix, &SUFFIX, 2
    EXPAND STR_FROM_PARTS infix, &INFIX, 2
    EXPAND STR_FROM_PARTS miss, &MISS, 2
    EXPAND STRING_LEN len, word
    EXPAND STR_AS_PTR as_ptr, word
    EXPAND STRING_AS_BYTES bytes, word
    EXPAND STRING_AS_STR str_view, word
    EXPAND STR_LEN bytes_len, bytes
    EXPAND STRING_LEN str_len, str_view
    EXPAND STRING_NEW new_empty
    EXPAND STR_EMPTY str_empty
    EXPAND STRING_IS_EMPTY new_empty_ok, new_empty
    EXPAND STR_IS_EMPTY str_empty_ok, str_empty
    EXPAND STR_STARTS_WITH starts_ok, word, prefix
    EXPAND STRING_ENDS_WITH ends_ok, word, suffix
    EXPAND STR_CONTAINS contains_ok, word, infix
    EXPAND STR_TRY_FIND find_ok, find_idx, word, infix
    EXPAND STRING_TRY_RFIND rfind_ok, rfind_idx, word, infix
    EXPAND STRING_CONTAINS contains_empty_ok, word, str_empty
    EXPAND STR_STARTS_WITH starts_miss, word, miss
    EXPAND STRING_ENDS_WITH ends_miss, word, miss
    EXPAND STR_CONTAINS contains_miss, word, miss
    EXPAND STR_TRY_FIND find_miss_ok, find_miss_idx, word, miss
    EXPAND STRING_TRY_RFIND rfind_miss_ok, rfind_miss_idx, word, miss
    EXPAND STR_TRY_STRIP_PREFIX strip_prefix_ok, strip_prefix_tail, word, prefix
    EXPAND STRING_TRY_STRIP_SUFFIX strip_suffix_ok, strip_suffix_head, word, suffix
    EXPAND STR_TRY_STRIP_PREFIX strip_prefix_miss_ok, strip_prefix_miss, word, miss
    EXPAND STRING_TRY_STRIP_SUFFIX strip_suffix_miss_ok, strip_suffix_miss, word, miss
    EXPAND STR_EQ strip_prefix_tail_eq, strip_prefix_tail, suffix
    EXPAND STR_EQ strip_suffix_head_eq, strip_suffix_head, prefix
    EXPAND STR_IS_EMPTY strip_prefix_miss_empty, strip_prefix_miss
    EXPAND STR_IS_EMPTY strip_suffix_miss_empty, strip_suffix_miss

    len_ok = eq len, 4
    ptr_ok = ne as_ptr, 0
    bytes_len_ok = eq bytes_len, 4
    str_len_ok = eq str_len, 4
    starts_match_ok = eq starts_ok, 1
    ends_match_ok = eq ends_ok, 1
    contains_match_ok = eq contains_ok, 1
    find_flag_ok = eq find_ok, 1
    find_idx_ok = eq find_idx, 1
    rfind_flag_ok = eq rfind_ok, 1
    rfind_idx_ok = eq rfind_idx, 1
    contains_empty_match_ok = eq contains_empty_ok, 1
    starts_miss_ok = eq starts_miss, 0
    ends_miss_ok = eq ends_miss, 0
    contains_miss_ok = eq contains_miss, 0
    find_miss_flag_ok = eq find_miss_ok, 0
    find_miss_idx_ok = eq find_miss_idx, 0
    rfind_miss_flag_ok = eq rfind_miss_ok, 0
    rfind_miss_idx_ok = eq rfind_miss_idx, 0
    strip_prefix_flag_ok = eq strip_prefix_ok, 1
    strip_suffix_flag_ok = eq strip_suffix_ok, 1
    strip_prefix_miss_flag_ok = eq strip_prefix_miss_ok, 0
    strip_suffix_miss_flag_ok = eq strip_suffix_miss_ok, 0
    strip_prefix_tail_ok = eq strip_prefix_tail_eq, 1
    strip_suffix_head_ok = eq strip_suffix_head_eq, 1
    strip_prefix_miss_empty_ok = eq strip_prefix_miss_empty, 1
    strip_suffix_miss_empty_ok = eq strip_suffix_miss_empty, 1
    ok01 = and len_ok, ptr_ok
    ok02 = and ok01, bytes_len_ok
    ok03 = and ok02, str_len_ok
    ok04 = and ok03, new_empty_ok
    ok05 = and ok04, str_empty_ok
    ok06 = and ok05, starts_match_ok
    ok07 = and ok06, ends_match_ok
    ok08 = and ok07, contains_match_ok
    ok09 = and ok08, find_flag_ok
    ok10 = and ok09, find_idx_ok
    ok11 = and ok10, rfind_flag_ok
    ok12 = and ok11, rfind_idx_ok
    ok13 = and ok12, contains_empty_match_ok
    ok14 = and ok13, starts_miss_ok
    ok15 = and ok14, ends_miss_ok
    ok16 = and ok15, contains_miss_ok
    ok17 = and ok16, find_miss_flag_ok
    ok18 = and ok17, find_miss_idx_ok
    ok19 = and ok18, rfind_miss_flag_ok
    ok20 = and ok19, rfind_miss_idx_ok
    ok21 = and ok20, strip_prefix_flag_ok
    ok22 = and ok21, strip_suffix_flag_ok
    ok23 = and ok22, strip_prefix_miss_flag_ok
    ok24 = and ok23, strip_suffix_miss_flag_ok
    ok25 = and ok24, strip_prefix_tail_ok
    ok26 = and ok25, strip_suffix_head_ok
    ok27 = and ok26, strip_prefix_miss_empty_ok
    ok = and ok27, strip_suffix_miss_empty_ok
    !len
    !as_ptr
    !bytes
    !str_view
    !bytes_len
    !str_len
    !new_empty_ok
    !str_empty_ok
    !starts_ok
    !ends_ok
    !contains_ok
    !find_ok
    !find_idx
    !rfind_ok
    !rfind_idx
    !contains_empty_ok
    !starts_miss
    !ends_miss
    !contains_miss
    !find_miss_ok
    !find_miss_idx
    !rfind_miss_ok
    !rfind_miss_idx
    !strip_prefix_ok
    !strip_prefix_tail
    !strip_suffix_ok
    !strip_suffix_head
    !strip_prefix_miss_ok
    !strip_prefix_miss
    !strip_suffix_miss_ok
    !strip_suffix_miss
    !strip_prefix_tail_eq
    !strip_suffix_head_eq
    !strip_prefix_miss_empty
    !strip_suffix_miss_empty
    !len_ok
    !ptr_ok
    !bytes_len_ok
    !str_len_ok
    !starts_match_ok
    !ends_match_ok
    !contains_match_ok
    !find_flag_ok
    !find_idx_ok
    !rfind_flag_ok
    !rfind_idx_ok
    !contains_empty_match_ok
    !starts_miss_ok
    !ends_miss_ok
    !contains_miss_ok
    !find_miss_flag_ok
    !find_miss_idx_ok
    !rfind_miss_flag_ok
    !rfind_miss_idx_ok
    !strip_prefix_flag_ok
    !strip_suffix_flag_ok
    !strip_prefix_miss_flag_ok
    !strip_suffix_miss_flag_ok
    !strip_prefix_tail_ok
    !strip_suffix_head_ok
    !strip_prefix_miss_empty_ok
    !strip_suffix_miss_empty_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !word
    !prefix
    !suffix
    !infix
    !miss
    !new_empty
    !str_empty
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(901)

L_OK:
    !ok
    return

@test "sa_std string find macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS word, &WORD, 4
    EXPAND STR_FROM_PARTS infix, &INFIX, 2
    EXPAND STR_FROM_PARTS miss, &MISS, 2
    EXPAND STR_TRY_FIND find_ok, find_idx, word, infix
    EXPAND STRING_TRY_RFIND rfind_ok, rfind_idx, word, infix
    EXPAND STR_TRY_FIND find_miss_ok, find_miss_idx, word, miss
    EXPAND STRING_TRY_RFIND rfind_miss_ok, rfind_miss_idx, word, miss
    find_flag_ok = eq find_ok, 1
    find_idx_ok = eq find_idx, 1
    rfind_flag_ok = eq rfind_ok, 1
    rfind_idx_ok = eq rfind_idx, 1
    find_miss_flag_ok = eq find_miss_ok, 0
    find_miss_idx_ok = eq find_miss_idx, 0
    rfind_miss_flag_ok = eq rfind_miss_ok, 0
    rfind_miss_idx_ok = eq rfind_miss_idx, 0
    ok01 = and find_flag_ok, find_idx_ok
    ok02 = and ok01, rfind_flag_ok
    ok03 = and ok02, rfind_idx_ok
    ok04 = and ok03, find_miss_flag_ok
    ok05 = and ok04, find_miss_idx_ok
    ok06 = and ok05, rfind_miss_flag_ok
    ok = and ok06, rfind_miss_idx_ok
    !find_ok
    !find_idx
    !rfind_ok
    !rfind_idx
    !find_miss_ok
    !find_miss_idx
    !rfind_miss_ok
    !rfind_miss_idx
    !find_flag_ok
    !find_idx_ok
    !rfind_flag_ok
    !rfind_idx_ok
    !find_miss_flag_ok
    !find_miss_idx_ok
    !rfind_miss_flag_ok
    !rfind_miss_idx_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !word
    !infix
    !miss
    br ok -> L_FIND_OK, L_FIND_FAIL

L_FIND_FAIL:
    !ok
    panic(906)

L_FIND_OK:
    !ok
    return

@test "sa_std rust parity checked view macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS word_s, &WORD, 4
    EXPAND STR_FROM_PARTS prefix_s, &PREFIX, 2
    EXPAND STR_FROM_PARTS suffix_s, &SUFFIX, 2
    EXPAND STR_FROM_PARTS miss_s, &MISS, 2
    EXPAND STR_TRIM_PREFIX trim_prefix_s, word_s, prefix_s
    EXPAND STRING_TRIM_SUFFIX trim_suffix_s, word_s, suffix_s
    EXPAND STR_TRIM_PREFIX trim_prefix_miss_s, word_s, miss_s
    EXPAND STRING_TRIM_SUFFIX trim_suffix_miss_s, word_s, miss_s
    EXPAND STR_TRY_SPLIT_AT str_split_ok, str_split_left, str_split_right, word_s, 2
    EXPAND STRING_TRY_SPLIT_AT str_split_miss_ok, str_split_miss_left, str_split_miss_right, word_s, 9
    EXPAND STR_EQ trim_prefix_eq, trim_prefix_s, suffix_s
    EXPAND STR_EQ trim_suffix_eq, trim_suffix_s, prefix_s
    EXPAND STR_EQ trim_prefix_miss_eq, trim_prefix_miss_s, word_s
    EXPAND STR_EQ trim_suffix_miss_eq, trim_suffix_miss_s, word_s
    EXPAND STR_EQ str_split_left_eq, str_split_left, prefix_s
    EXPAND STR_EQ str_split_right_eq, str_split_right, suffix_s
    EXPAND STR_IS_EMPTY str_split_miss_left_empty, str_split_miss_left
    EXPAND STR_IS_EMPTY str_split_miss_right_empty, str_split_miss_right

    data = alloc 24
    store data+0, 11 as u64
    store data+8, 22 as u64
    store data+16, 33 as u64
    suffix_ptr = ptr_add data, 16
    miss_data = alloc 8
    store miss_data+0, 44 as u64
    slice = alloc Slice_SIZE
    slice_prefix = alloc Slice_SIZE
    slice_suffix = alloc Slice_SIZE
    slice_miss = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 3
    EXPAND SLICE_NEW slice_prefix, data, 1
    EXPAND SLICE_NEW slice_suffix, suffix_ptr, 1
    EXPAND SLICE_NEW slice_miss, miss_data, 1
    !suffix_ptr
    EXPAND SLICE_TRIM_PREFIX_U64 slice_trim_prefix, slice, slice_prefix
    EXPAND SLICE_TRIM_SUFFIX_U64 slice_trim_suffix, slice, slice_suffix
    EXPAND SLICE_TRIM_PREFIX_U64 slice_trim_prefix_miss, slice, slice_miss
    EXPAND SLICE_TRY_SPLIT_AT_U64 slice_split_ok, slice_split_left, slice_split_right, slice, 1
    EXPAND SLICE_TRY_SPLIT_AT_U64 slice_split_miss_ok, slice_split_miss_left, slice_split_miss_right, slice, 9
    EXPAND SLICE_GET_LEN slice_trim_prefix_len, slice_trim_prefix
    EXPAND SLICE_FIRST_U64 slice_trim_prefix_first, slice_trim_prefix
    EXPAND SLICE_GET_LEN slice_trim_suffix_len, slice_trim_suffix
    EXPAND SLICE_LAST_U64 slice_trim_suffix_last, slice_trim_suffix
    EXPAND SLICE_GET_LEN slice_trim_prefix_miss_len, slice_trim_prefix_miss
    EXPAND SLICE_GET_LEN slice_split_left_len, slice_split_left
    EXPAND SLICE_FIRST_U64 slice_split_left_first, slice_split_left
    EXPAND SLICE_GET_LEN slice_split_right_len, slice_split_right
    EXPAND SLICE_FIRST_U64 slice_split_right_first, slice_split_right
    EXPAND SLICE_IS_EMPTY slice_split_miss_left_empty, slice_split_miss_left
    EXPAND SLICE_IS_EMPTY slice_split_miss_right_empty, slice_split_miss_right

    EXPAND VEC_WITH_CAPACITY_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 44
    EXPAND VEC_PUSH_U64 vec, 55
    vec_prefix_data = alloc 8
    vec_suffix_data = alloc 8
    vec_miss_data = alloc 8
    store vec_prefix_data+0, 44 as u64
    store vec_suffix_data+0, 55 as u64
    store vec_miss_data+0, 66 as u64
    vec_prefix = alloc Slice_SIZE
    vec_suffix = alloc Slice_SIZE
    vec_miss = alloc Slice_SIZE
    EXPAND SLICE_NEW vec_prefix, vec_prefix_data, 1
    EXPAND SLICE_NEW vec_suffix, vec_suffix_data, 1
    EXPAND SLICE_NEW vec_miss, vec_miss_data, 1
    EXPAND VEC_TRY_GET_U64 vec_get_ok, vec_get, vec, 1
    EXPAND VEC_TRY_GET_U64 vec_get_miss_ok, vec_get_miss, vec, 9
    EXPAND VEC_TRIM_PREFIX_U64 vec_trim_prefix, vec, vec_prefix
    EXPAND VEC_TRIM_SUFFIX_U64 vec_trim_suffix, vec, vec_suffix
    EXPAND VEC_TRIM_PREFIX_U64 vec_trim_prefix_miss, vec, vec_miss
    EXPAND VEC_TRY_SPLIT_AT_U64 vec_split_ok, vec_split_left, vec_split_right, vec, 1
    EXPAND VEC_TRY_SPLIT_AT_U64 vec_split_miss_ok, vec_split_miss_left, vec_split_miss_right, vec, 9
    EXPAND SLICE_GET_LEN vec_trim_prefix_len, vec_trim_prefix
    EXPAND SLICE_FIRST_U64 vec_trim_prefix_first, vec_trim_prefix
    EXPAND SLICE_GET_LEN vec_trim_suffix_len, vec_trim_suffix
    EXPAND SLICE_FIRST_U64 vec_trim_suffix_first, vec_trim_suffix
    EXPAND SLICE_GET_LEN vec_trim_prefix_miss_len, vec_trim_prefix_miss
    EXPAND SLICE_GET_LEN vec_split_left_len, vec_split_left
    EXPAND SLICE_FIRST_U64 vec_split_left_first, vec_split_left
    EXPAND SLICE_GET_LEN vec_split_right_len, vec_split_right
    EXPAND SLICE_FIRST_U64 vec_split_right_first, vec_split_right
    EXPAND SLICE_IS_EMPTY vec_split_miss_left_empty, vec_split_miss_left
    EXPAND SLICE_IS_EMPTY vec_split_miss_right_empty, vec_split_miss_right

    str_trim_prefix_ok = eq trim_prefix_eq, 1
    str_trim_suffix_ok = eq trim_suffix_eq, 1
    str_trim_prefix_miss_ok = eq trim_prefix_miss_eq, 1
    str_trim_suffix_miss_ok = eq trim_suffix_miss_eq, 1
    str_split_flag_ok = eq str_split_ok, 1
    str_split_left_ok = eq str_split_left_eq, 1
    str_split_right_ok = eq str_split_right_eq, 1
    str_split_miss_flag_ok = eq str_split_miss_ok, 0
    str_split_miss_left_ok = eq str_split_miss_left_empty, 1
    str_split_miss_right_ok = eq str_split_miss_right_empty, 1
    slice_trim_prefix_len_ok = eq slice_trim_prefix_len, 2
    slice_trim_prefix_first_ok = eq slice_trim_prefix_first, 22
    slice_trim_suffix_len_ok = eq slice_trim_suffix_len, 2
    slice_trim_suffix_last_ok = eq slice_trim_suffix_last, 22
    slice_trim_prefix_miss_len_ok = eq slice_trim_prefix_miss_len, 3
    slice_split_flag_ok = eq slice_split_ok, 1
    slice_split_left_len_ok = eq slice_split_left_len, 1
    slice_split_left_first_ok = eq slice_split_left_first, 11
    slice_split_right_len_ok = eq slice_split_right_len, 2
    slice_split_right_first_ok = eq slice_split_right_first, 22
    slice_split_miss_flag_ok = eq slice_split_miss_ok, 0
    slice_split_miss_left_ok = eq slice_split_miss_left_empty, 1
    slice_split_miss_right_ok = eq slice_split_miss_right_empty, 1
    vec_get_flag_ok = eq vec_get_ok, 1
    vec_get_value_ok = eq vec_get, 55
    vec_get_miss_flag_ok = eq vec_get_miss_ok, 0
    vec_get_miss_value_ok = eq vec_get_miss, 0
    vec_trim_prefix_len_ok = eq vec_trim_prefix_len, 1
    vec_trim_prefix_first_ok = eq vec_trim_prefix_first, 55
    vec_trim_suffix_len_ok = eq vec_trim_suffix_len, 1
    vec_trim_suffix_first_ok = eq vec_trim_suffix_first, 44
    vec_trim_prefix_miss_len_ok = eq vec_trim_prefix_miss_len, 2
    vec_split_flag_ok = eq vec_split_ok, 1
    vec_split_left_len_ok = eq vec_split_left_len, 1
    vec_split_left_first_ok = eq vec_split_left_first, 44
    vec_split_right_len_ok = eq vec_split_right_len, 1
    vec_split_right_first_ok = eq vec_split_right_first, 55
    vec_split_miss_flag_ok = eq vec_split_miss_ok, 0
    vec_split_miss_left_ok = eq vec_split_miss_left_empty, 1
    vec_split_miss_right_ok = eq vec_split_miss_right_empty, 1
    ok01 = and str_trim_prefix_ok, str_trim_suffix_ok
    ok02 = and ok01, str_trim_prefix_miss_ok
    ok03 = and ok02, str_trim_suffix_miss_ok
    ok04 = and ok03, str_split_flag_ok
    ok05 = and ok04, str_split_left_ok
    ok06 = and ok05, str_split_right_ok
    ok07 = and ok06, str_split_miss_flag_ok
    ok08 = and ok07, str_split_miss_left_ok
    ok09 = and ok08, str_split_miss_right_ok
    ok10 = and ok09, slice_trim_prefix_len_ok
    ok11 = and ok10, slice_trim_prefix_first_ok
    ok12 = and ok11, slice_trim_suffix_len_ok
    ok13 = and ok12, slice_trim_suffix_last_ok
    ok14 = and ok13, slice_trim_prefix_miss_len_ok
    ok15 = and ok14, slice_split_flag_ok
    ok16 = and ok15, slice_split_left_len_ok
    ok17 = and ok16, slice_split_left_first_ok
    ok18 = and ok17, slice_split_right_len_ok
    ok19 = and ok18, slice_split_right_first_ok
    ok20 = and ok19, slice_split_miss_flag_ok
    ok21 = and ok20, slice_split_miss_left_ok
    ok22 = and ok21, slice_split_miss_right_ok
    ok23 = and ok22, vec_get_flag_ok
    ok24 = and ok23, vec_get_value_ok
    ok25 = and ok24, vec_get_miss_flag_ok
    ok26 = and ok25, vec_get_miss_value_ok
    ok27 = and ok26, vec_trim_prefix_len_ok
    ok28 = and ok27, vec_trim_prefix_first_ok
    ok29 = and ok28, vec_trim_suffix_len_ok
    ok30 = and ok29, vec_trim_suffix_first_ok
    ok31 = and ok30, vec_trim_prefix_miss_len_ok
    ok32 = and ok31, vec_split_flag_ok
    ok33 = and ok32, vec_split_left_len_ok
    ok34 = and ok33, vec_split_left_first_ok
    ok35 = and ok34, vec_split_right_len_ok
    ok36 = and ok35, vec_split_right_first_ok
    ok37 = and ok36, vec_split_miss_flag_ok
    ok38 = and ok37, vec_split_miss_left_ok
    ok = and ok38, vec_split_miss_right_ok
    !word_s
    !prefix_s
    !suffix_s
    !miss_s
    !trim_prefix_s
    !trim_suffix_s
    !trim_prefix_miss_s
    !trim_suffix_miss_s
    !str_split_ok
    !str_split_left
    !str_split_right
    !str_split_miss_ok
    !str_split_miss_left
    !str_split_miss_right
    !trim_prefix_eq
    !trim_suffix_eq
    !trim_prefix_miss_eq
    !trim_suffix_miss_eq
    !str_split_left_eq
    !str_split_right_eq
    !str_split_miss_left_empty
    !str_split_miss_right_empty
    !data
    !miss_data
    !slice
    !slice_prefix
    !slice_suffix
    !slice_miss
    !slice_trim_prefix
    !slice_trim_suffix
    !slice_trim_prefix_miss
    !slice_split_ok
    !slice_split_left
    !slice_split_right
