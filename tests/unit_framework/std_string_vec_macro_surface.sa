    EXPAND VEC_TRY_RCHUNK_MUT_AT_U64 vec_rchunk_mut_ok, vec_rchunk_mut, vec, 2, 0
    EXPAND SLICE_GET_MUT_PTR_U64 vec_rchunk_mut_ptr, vec_rchunk_mut, 1
    store vec_rchunk_mut_ptr+0, 55 as u64
    EXPAND VEC_TRY_RCHUNK_AT_U64 vec_rchunk3_ok, vec_rchunk3, vec, 2, 3
    EXPAND VEC_RCHUNK_COUNT_U64 vec_zero_count, vec, 0
    EXPAND SLICE_GET_LEN vec_rchunk0_len, vec_rchunk0
    EXPAND SLICE_FIRST_U64 vec_rchunk0_first, vec_rchunk0
    EXPAND SLICE_LAST_U64 vec_rchunk0_last, vec_rchunk0
    EXPAND SLICE_GET_LEN vec_rchunk2_len, vec_rchunk2
    EXPAND SLICE_FIRST_U64 vec_rchunk2_first, vec_rchunk2
    EXPAND SLICE_GET_LEN vec_rchunk3_len, vec_rchunk3
    EXPAND VEC_TRY_GET_U64 vec_mutated_ok, vec_mutated, vec, 4

    rchunk_count_ok = eq rchunk_count, 3
    rchunk0_flag_ok = eq rchunk0_ok, 1
    rchunk0_len_ok = eq rchunk0_len, 2
    rchunk0_first_ok = eq rchunk0_first, 44
    rchunk0_last_ok = eq rchunk0_last, 50
    rchunk1_flag_ok = eq rchunk1_ok, 1
    rchunk1_len_ok = eq rchunk1_len, 2
    rchunk1_first_ok = eq rchunk1_first, 20
    rchunk1_last_ok = eq rchunk1_last, 30
    rchunk2_flag_ok = eq rchunk2_ok, 1
    rchunk2_len_ok = eq rchunk2_len, 1
    rchunk2_first_ok = eq rchunk2_first, 10
    rchunk3_flag_ok = eq rchunk3_ok, 0
    rchunk3_len_ok = eq rchunk3_len, 0
    zero_count_ok = eq zero_count, 0
    zero_flag_ok = eq zero_ok, 0
    zero_len_ok = eq zero_len, 0
    rchunk_mut_flag_ok = eq rchunk_mut_ok, 1
    mutated_ok = eq mutated, 44
    vec_rchunk_count_ok = eq vec_rchunk_count, 3
    vec_rchunk0_flag_ok = eq vec_rchunk0_ok, 1
    vec_rchunk0_len_ok = eq vec_rchunk0_len, 2
    vec_rchunk0_first_ok = eq vec_rchunk0_first, 40
    vec_rchunk0_last_ok = eq vec_rchunk0_last, 55
    vec_rchunk2_flag_ok = eq vec_rchunk2_ok, 1
    vec_rchunk2_len_ok = eq vec_rchunk2_len, 1
    vec_rchunk2_first_ok = eq vec_rchunk2_first, 10
    vec_rchunk_mut_flag_ok = eq vec_rchunk_mut_ok, 1
    vec_rchunk3_flag_ok = eq vec_rchunk3_ok, 0
    vec_rchunk3_len_ok = eq vec_rchunk3_len, 0
    vec_zero_count_ok = eq vec_zero_count, 0
    vec_mutated_flag_ok = eq vec_mutated_ok, 1
    vec_mutated_value_ok = eq vec_mutated, 55

    ok01 = and rchunk_count_ok, rchunk0_flag_ok
