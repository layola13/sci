    !grow_first_value_ok
    !grow_second_flag_ok
    !grow_second_value_ok
    !len_after_truncate_ok
    !resize_truncate_len_ok
    !truncated_flag_ok
    !truncated_value_ok
    !small_len_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    EXPAND VEC_FREE small_vec
    EXPAND VEC_FREE vec
    br ok -> L_VEC_RESIZE_WITH_OK, L_VEC_RESIZE_WITH_FAIL

L_VEC_RESIZE_WITH_FAIL:
    !ok
    panic(915)

L_VEC_RESIZE_WITH_OK:
    !ok
    return

@test "sa_std vec dedup_by_key and extract_if macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 8
    EXPAND VEC_PUSH_U64 vec, 10
    EXPAND VEC_PUSH_U64 vec, 11
    EXPAND VEC_PUSH_U64 vec, 21
    EXPAND VEC_PUSH_U64 vec, 29
    EXPAND VEC_PUSH_U64 vec, 31
