@test "sa_std vec convenience macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 44
    EXPAND VEC_PUSH_U64 vec, 55
    append_src_data = alloc 16
    store append_src_data+0, 66 as u64
    store append_src_data+8, 77 as u64
    append_src_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW append_src_slice, append_src_data, 2
    EXPAND VEC_EXTEND_FROM_SLICE_U64 vec, append_src_slice
    EXPAND VEC_TRY_GET_U64 after_extend_ok, after_extend, vec, 3
    EXPAND VEC_TRY_EXTEND_FROM_WITHIN_U64 extend_within_ok, vec, 1, 2
    EXPAND VEC_TRY_GET_U64 extend_within_first_ok, extend_within_first, vec, 4
    EXPAND VEC_TRY_GET_U64 extend_within_second_ok, extend_within_second, vec, 5
    EXPAND VEC_TRY_EXTEND_FROM_WITHIN_U64 extend_within_miss_ok, vec, 9, 1
    EXPAND VEC_LEN len_after_extend_within, vec
    EXPAND VEC_WITH_CAPACITY_U64 append_src_vec, 2
    EXPAND VEC_PUSH_U64 append_src_vec, 88
    EXPAND VEC_PUSH_U64 append_src_vec, 99
    EXPAND VEC_APPEND_U64 vec, append_src_vec
    EXPAND VEC_TRY_GET_U64 after_append_ok, after_append, vec, 7
    EXPAND VEC_LEN append_src_len_after, append_src_vec
    EXPAND VEC_TRY_POP_IF_U64 pop_if_miss_ok, pop_if_miss, vec, @vec_pop_if_is_88
    EXPAND VEC_LEN len_after_pop_if_miss, vec
    EXPAND VEC_TRY_POP_IF_U64 pop_if_hit_ok, pop_if_hit, vec, @vec_pop_if_is_99
    EXPAND VEC_LEN len_after_pop_if_hit, vec
    EXPAND VEC_WITH_CAPACITY_U64 pop_if_empty_vec, 0
    EXPAND VEC_TRY_POP_IF_U64 pop_if_empty_ok, pop_if_empty, pop_if_empty_vec, @vec_pop_if_is_99
    prefix_data = alloc 8
    suffix_data = alloc 8
    miss_prefix_data = alloc 8
    long_suffix_data = alloc 24
    store prefix_data+0, 44 as u64
    store suffix_data+0, 88 as u64
    store miss_prefix_data+0, 66 as u64
    store long_suffix_data+0, 44 as u64
    store long_suffix_data+8, 55 as u64
    store long_suffix_data+16, 66 as u64
    prefix = alloc Slice_SIZE
    suffix = alloc Slice_SIZE
