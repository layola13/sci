    ok06 = and ok05, third_flag_ok
    ok07 = and ok06, third_value_ok
    ok08 = and ok07, fourth_flag_ok
    ok = and ok08, fourth_value_ok
    !retain_len
    !len_after_retain
    !first_ok
    !first
    !second_ok
    !second
    !third_ok
    !third
    !fourth_ok
    !fourth
