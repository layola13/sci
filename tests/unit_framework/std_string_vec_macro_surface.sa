    ok24 = and ok23, splice_fourth_flag_ok
    ok25 = and ok24, splice_fourth_value_ok
    ok26 = and ok25, spliced_first_flag_ok
    ok27 = and ok26, spliced_first_value_ok
    ok28 = and ok27, spliced_second_flag_ok
    ok = and ok28, spliced_second_value_ok
    !repl_slice
    !drain_ok
    !vec_len_after_drain
    !drained_len
    !vec_first_ok
