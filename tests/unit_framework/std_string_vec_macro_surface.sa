L_PARITY_OK:
    !ok
    return

@test "sa_std vec convenience macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 44
    EXPAND VEC_PUSH_U64 vec, 55
    append_src_data = alloc 16
