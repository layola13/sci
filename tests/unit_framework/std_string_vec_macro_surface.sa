    ok14 = and ok13, remain_first_value_ok
    ok15 = and ok14, remain_second_flag_ok
    ok16 = and ok15, remain_second_value_ok
    ok17 = and ok16, remain_third_flag_ok
    ok18 = and ok17, remain_third_value_ok
    ok19 = and ok18, extracted_first_flag_ok
    ok20 = and ok19, extracted_first_value_ok
    ok21 = and ok20, extracted_second_flag_ok
    ok = and ok21, extracted_second_value_ok
    !dedup_key_len
    !len_after_dedup_key
    !first_ok
    !first
    !second_ok
    !second
    !third_ok
