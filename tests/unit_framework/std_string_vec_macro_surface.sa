@import "sa_std/string.sa"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"

@const WORD = utf8:"rust"
@const PREFIX = utf8:"ru"
@const SUFFIX = utf8:"st"
@const INFIX = utf8:"us"
@const MISS = utf8:"zz"

@test "sa_std string convenience macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS word, &WORD, 4
    EXPAND STR_FROM_PARTS prefix, &PREFIX, 2
    EXPAND STR_FROM_PARTS suffix, &SUFFIX, 2
    EXPAND STR_FROM_PARTS infix, &INFIX, 2
    EXPAND STR_FROM_PARTS miss, &MISS, 2
    EXPAND STRING_LEN len, word
    EXPAND STR_AS_PTR as_ptr, word
    EXPAND STRING_AS_BYTES bytes, word
    EXPAND STRING_AS_STR str_view, word
    EXPAND STR_LEN bytes_len, bytes
    EXPAND STRING_LEN str_len, str_view
    EXPAND STRING_NEW new_empty
    EXPAND STR_EMPTY str_empty
    EXPAND STRING_IS_EMPTY new_empty_ok, new_empty
    EXPAND STR_IS_EMPTY str_empty_ok, str_empty
    EXPAND STR_STARTS_WITH starts_ok, word, prefix
    EXPAND STRING_ENDS_WITH ends_ok, word, suffix
    EXPAND STR_CONTAINS contains_ok, word, infix
    EXPAND STRING_CONTAINS contains_empty_ok, word, str_empty
    EXPAND STR_STARTS_WITH starts_miss, word, miss
    EXPAND STRING_ENDS_WITH ends_miss, word, miss
    EXPAND STR_CONTAINS contains_miss, word, miss

    len_ok = eq len, 4
    ptr_ok = ne as_ptr, 0
    bytes_len_ok = eq bytes_len, 4
    str_len_ok = eq str_len, 4
    starts_match_ok = eq starts_ok, 1
    ends_match_ok = eq ends_ok, 1
    contains_match_ok = eq contains_ok, 1
    contains_empty_match_ok = eq contains_empty_ok, 1
    starts_miss_ok = eq starts_miss, 0
    ends_miss_ok = eq ends_miss, 0
    contains_miss_ok = eq contains_miss, 0
    ok01 = and len_ok, ptr_ok
    ok02 = and ok01, bytes_len_ok
    ok03 = and ok02, str_len_ok
    ok04 = and ok03, new_empty_ok
    ok05 = and ok04, str_empty_ok
    ok06 = and ok05, starts_match_ok
    ok07 = and ok06, ends_match_ok
    ok08 = and ok07, contains_match_ok
    ok09 = and ok08, contains_empty_match_ok
    ok10 = and ok09, starts_miss_ok
    ok11 = and ok10, ends_miss_ok
    ok = and ok11, contains_miss_ok
    !len
    !as_ptr
    !bytes
    !str_view
    !bytes_len
    !str_len
    !new_empty_ok
    !str_empty_ok
    !starts_ok
    !ends_ok
    !contains_ok
    !contains_empty_ok
    !starts_miss
    !ends_miss
    !contains_miss
    !len_ok
    !ptr_ok
    !bytes_len_ok
    !str_len_ok
    !starts_match_ok
    !ends_match_ok
    !contains_match_ok
    !contains_empty_match_ok
    !starts_miss_ok
    !ends_miss_ok
    !contains_miss_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !word
    !prefix
    !suffix
    !infix
    !miss
    !new_empty
    !str_empty
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(901)

L_OK:
    !ok
    return

@test "sa_std vec convenience macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 44
    EXPAND VEC_PUSH_U64 vec, 55
    prefix_data = alloc 8
    suffix_data = alloc 8
    miss_prefix_data = alloc 8
    long_suffix_data = alloc 24
    store prefix_data+0, 44 as u64
    store suffix_data+0, 55 as u64
    store miss_prefix_data+0, 66 as u64
    store long_suffix_data+0, 44 as u64
    store long_suffix_data+8, 55 as u64
    store long_suffix_data+16, 66 as u64
    prefix = alloc Slice_SIZE
    suffix = alloc Slice_SIZE
    miss_prefix = alloc Slice_SIZE
    long_suffix = alloc Slice_SIZE
    EXPAND SLICE_NEW prefix, prefix_data, 1
    EXPAND SLICE_NEW suffix, suffix_data, 1
    EXPAND SLICE_NEW miss_prefix, miss_prefix_data, 1
    EXPAND SLICE_NEW long_suffix, long_suffix_data, 3
    EXPAND VEC_RESERVE_U64 vec, 5
    EXPAND VEC_CAPACITY cap, vec
    EXPAND VEC_GET_U64 got, vec, 1
    EXPAND VEC_FRONT front, vec
    EXPAND VEC_BACK back, vec
    EXPAND VEC_CONTAINS_U64 contains_55, vec, 55
    EXPAND VEC_CONTAINS_U64 contains_99, vec, 99
    EXPAND VEC_STARTS_WITH_U64 starts_ok, vec, prefix
    EXPAND VEC_ENDS_WITH_U64 ends_ok, vec, suffix
    EXPAND VEC_STARTS_WITH_U64 starts_miss, vec, miss_prefix
    EXPAND VEC_ENDS_WITH_U64 ends_long_miss, vec, long_suffix
    EXPAND VEC_TRY_POP_U64 pop_ok, popped, vec
    EXPAND VEC_AS_PTR data_ptr, vec
    EXPAND VEC_AS_SLICE slice, vec
    EXPAND SLICE_GET_LEN slice_len, slice
    EXPAND VEC_POP_U64 pop2_ok, popped2, vec
    EXPAND VEC_LEN len, vec

    got_ok = eq got, 55
    cap_ok = eq cap, 7
    front_ok = eq front, 44
    back_ok = eq back, 55
    contains_55_ok = eq contains_55, 1
    contains_99_ok = eq contains_99, 0
    starts_match_ok = eq starts_ok, 1
    ends_match_ok = eq ends_ok, 1
    starts_miss_ok = eq starts_miss, 0
    ends_long_miss_ok = eq ends_long_miss, 0
    pop_ok_flag = eq pop_ok, 1
    pop_ok_value = eq popped, 55
    ptr_ok = ne data_ptr, 0
    slice_len_ok = eq slice_len, 1
    pop2_ok_flag = eq pop2_ok, 1
    pop2_ok_value = eq popped2, 44
    len_ok = eq len, 0
    ok01 = and got_ok, cap_ok
    ok02 = and ok01, front_ok
    ok03 = and ok02, back_ok
    ok04 = and ok03, contains_55_ok
    ok05 = and ok04, contains_99_ok
    pattern01 = and starts_match_ok, ends_match_ok
    pattern02 = and pattern01, starts_miss_ok
    pattern_ok = and pattern02, ends_long_miss_ok
    ok06 = and ok05, pattern_ok
    ok07 = and ok06, pop_ok_flag
    ok08 = and ok07, pop_ok_value
    ok09 = and ok08, ptr_ok
    ok10 = and ok09, slice_len_ok
    ok11 = and ok10, pop2_ok_flag
    ok12 = and ok11, pop2_ok_value
    ok = and ok12, len_ok
    !got
    !cap
    !front
    !back
    !contains_55
    !contains_99
    !starts_ok
    !ends_ok
    !starts_miss
    !ends_long_miss
    !pop_ok
    !popped
    !data_ptr
    !slice
    !slice_len
    !pop2_ok
    !popped2
    !len
    !got_ok
    !cap_ok
    !front_ok
    !back_ok
    !contains_55_ok
    !contains_99_ok
    !starts_match_ok
    !ends_match_ok
    !starts_miss_ok
    !ends_long_miss_ok
    !pop_ok_flag
    !pop_ok_value
    !ptr_ok
    !slice_len_ok
    !pop2_ok_flag
    !pop2_ok_value
    !len_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !pattern01
    !pattern02
    !pattern_ok
    !prefix
    !suffix
    !miss_prefix
    !long_suffix
    !prefix_data
    !suffix_data
    !miss_prefix_data
    !long_suffix_data
    EXPAND VEC_FREE vec
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(902)

L_OK:
    !ok
    return

@test "sa_std slice convenience macros"():
L_ENTRY:
    data = alloc 24
    store data+0, 11 as u64
    store data+8, 22 as u64
    store data+16, 33 as u64
    slice = alloc Slice_SIZE
    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, data, 3
    EXPAND SLICE_NEW empty_slice, data, 0
    EXPAND SLICE_AS_PTR ptr, slice
    EXPAND SLICE_IS_EMPTY empty, slice
    EXPAND SLICE_FIRST_U64 first, slice
    EXPAND SLICE_LAST_U64 last, slice
    EXPAND SLICE_TRY_FIRST_U64 first_try_ok, first_try, slice
    EXPAND SLICE_TRY_LAST_U64 last_try_ok, last_try, slice
    EXPAND SLICE_TRY_GET_U64 get_ok, got, slice, 1
    EXPAND SLICE_TRY_GET_U64 miss_ok, missed, slice, 9
    EXPAND SLICE_CONTAINS_U64 contains_22, slice, 22
    EXPAND SLICE_CONTAINS_U64 contains_44, slice, 44
    suffix_ptr = ptr_add data, 8
    miss_prefix_data = alloc 16
    long_suffix_data = alloc 32
    store miss_prefix_data+0, 11 as u64
    store miss_prefix_data+8, 44 as u64
    store long_suffix_data+0, 11 as u64
    store long_suffix_data+8, 22 as u64
    store long_suffix_data+16, 33 as u64
    store long_suffix_data+24, 44 as u64
    prefix_slice = alloc Slice_SIZE
    suffix_slice = alloc Slice_SIZE
    miss_prefix_slice = alloc Slice_SIZE
    long_suffix_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW prefix_slice, data, 2
    EXPAND SLICE_NEW suffix_slice, suffix_ptr, 2
    EXPAND SLICE_NEW miss_prefix_slice, miss_prefix_data, 2
    EXPAND SLICE_NEW long_suffix_slice, long_suffix_data, 4
    !suffix_ptr
    EXPAND SLICE_STARTS_WITH_U64 starts_ok, slice, prefix_slice
    EXPAND SLICE_ENDS_WITH_U64 ends_ok, slice, suffix_slice
    EXPAND SLICE_STARTS_WITH_U64 starts_empty_ok, slice, empty_slice
    EXPAND SLICE_ENDS_WITH_U64 ends_empty_ok, slice, empty_slice
    EXPAND SLICE_STARTS_WITH_U64 starts_miss, slice, miss_prefix_slice
    EXPAND SLICE_ENDS_WITH_U64 ends_long_miss, slice, long_suffix_slice
    EXPAND SLICE_TRY_FIRST_U64 empty_first_ok, empty_first, empty_slice
    EXPAND SLICE_TRY_LAST_U64 empty_last_ok, empty_last, empty_slice

    ptr_ok = ne ptr, 0
    empty_ok = eq empty, 0
    first_ok = eq first, 11
    last_ok = eq last, 33
    first_try_flag_ok = eq first_try_ok, 1
    first_try_value_ok = eq first_try, 11
    last_try_flag_ok = eq last_try_ok, 1
    last_try_value_ok = eq last_try, 33
    get_flag_ok = eq get_ok, 1
    get_value_ok = eq got, 22
    miss_flag_ok = eq miss_ok, 0
    miss_value_ok = eq missed, 0
    contains_22_ok = eq contains_22, 1
    contains_44_ok = eq contains_44, 0
    starts_match_ok = eq starts_ok, 1
    ends_match_ok = eq ends_ok, 1
    starts_empty_match_ok = eq starts_empty_ok, 1
    ends_empty_match_ok = eq ends_empty_ok, 1
    starts_miss_ok = eq starts_miss, 0
    ends_long_miss_ok = eq ends_long_miss, 0
    empty_first_flag_ok = eq empty_first_ok, 0
    empty_first_value_ok = eq empty_first, 0
    empty_last_flag_ok = eq empty_last_ok, 0
    empty_last_value_ok = eq empty_last, 0
    ok01 = and ptr_ok, empty_ok
    ok02 = and ok01, first_ok
    ok03 = and ok02, last_ok
    ok04 = and ok03, first_try_flag_ok
    ok05 = and ok04, first_try_value_ok
    ok06 = and ok05, last_try_flag_ok
    ok07 = and ok06, last_try_value_ok
    ok08 = and ok07, get_flag_ok
    ok09 = and ok08, get_value_ok
    ok10 = and ok09, miss_flag_ok
    ok11 = and ok10, miss_value_ok
    ok12 = and ok11, contains_22_ok
    ok13 = and ok12, contains_44_ok
    ok14 = and ok13, starts_match_ok
    ok15 = and ok14, ends_match_ok
    ok16 = and ok15, starts_empty_match_ok
    ok17 = and ok16, ends_empty_match_ok
    ok18 = and ok17, starts_miss_ok
    ok19 = and ok18, ends_long_miss_ok
    ok20 = and ok19, empty_first_flag_ok
    ok21 = and ok20, empty_first_value_ok
    ok22 = and ok21, empty_last_flag_ok
    ok = and ok22, empty_last_value_ok
    !ptr
    !empty
    !first
    !last
    !first_try_ok
    !first_try
    !last_try_ok
    !last_try
    !get_ok
    !got
    !miss_ok
    !missed
    !contains_22
    !contains_44
    !starts_ok
    !ends_ok
    !starts_empty_ok
    !ends_empty_ok
    !starts_miss
    !ends_long_miss
    !empty_first_ok
    !empty_first
    !empty_last_ok
    !empty_last
    !ptr_ok
    !empty_ok
    !first_ok
    !last_ok
    !first_try_flag_ok
    !first_try_value_ok
    !last_try_flag_ok
    !last_try_value_ok
    !get_flag_ok
    !get_value_ok
    !miss_flag_ok
    !miss_value_ok
    !contains_22_ok
    !contains_44_ok
    !starts_match_ok
    !ends_match_ok
    !starts_empty_match_ok
    !ends_empty_match_ok
    !starts_miss_ok
    !ends_long_miss_ok
    !empty_first_flag_ok
    !empty_first_value_ok
    !empty_last_flag_ok
    !empty_last_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !long_suffix_slice
    !miss_prefix_slice
    !suffix_slice
    !prefix_slice
    !long_suffix_data
    !miss_prefix_data
    !empty_slice
    !slice
    !data
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(903)

L_OK:
    !ok
    return
