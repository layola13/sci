    !extracted_second_ok
    !extracted_second
    !dedup_key_len_ok
    !len_after_dedup_key_ok
    !first_flag_ok
    !first_value_ok
    !second_flag_ok
    !second_value_ok
    !third_flag_ok
    !third_value_ok
    !fourth_flag_ok
    !fourth_value_ok
    !remain_len_ok
