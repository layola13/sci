    ok02 = and ok01, pwc2_flag_ok
    ok03 = and ok02, insert_mid_flag_ok
    ok04 = and ok03, inserted_mid_flag_ok
    ok05 = and ok04, inserted_mid_value_ok
    ok06 = and ok05, insert_end_flag_ok
    ok07 = and ok06, insert_miss_flag_ok
