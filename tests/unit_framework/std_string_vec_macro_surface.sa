@test "sa_std vec insert and dedup macros"():
L_ENTRY:
    EXPAND VEC_TRY_WITH_CAPACITY_U64 with_cap_ok, vec, 6
    EXPAND VEC_PUSH_WITHIN_CAPACITY_U64 pwc1_ok, vec, 10
    EXPAND VEC_PUSH_WITHIN_CAPACITY_U64 pwc2_ok, vec, 30
    EXPAND VEC_TRY_INSERT_U64 insert_mid_ok, vec, 1, 20
    EXPAND VEC_TRY_GET_U64 inserted_mid_ok, inserted_mid, vec, 1
    EXPAND VEC_TRY_INSERT_U64 insert_end_ok, vec, 3, 30
    EXPAND VEC_TRY_INSERT_U64 insert_miss_ok, vec, 9, 99
    EXPAND VEC_PUSH_U64 vec, 30
    EXPAND VEC_PUSH_U64 vec, 40
    EXPAND VEC_DEDUP_U64 dedup_len, vec
    EXPAND VEC_LEN len_after_dedup, vec
    EXPAND VEC_TRY_GET_U64 dedup_first_ok, dedup_first, vec, 0
    EXPAND VEC_TRY_GET_U64 dedup_second_ok, dedup_second, vec, 1
    EXPAND VEC_TRY_GET_U64 dedup_third_ok, dedup_third, vec, 2
    EXPAND VEC_TRY_GET_U64 dedup_fourth_ok, dedup_fourth, vec, 3
    EXPAND VEC_CAPACITY cap_after, vec
    EXPAND VEC_PUSH_WITHIN_CAPACITY_U64 pwc_full_ok, vec, 50

    with_cap_flag_ok = eq with_cap_ok, 1
    pwc1_flag_ok = eq pwc1_ok, 1
    pwc2_flag_ok = eq pwc2_ok, 1
    insert_mid_flag_ok = eq insert_mid_ok, 1
    inserted_mid_flag_ok = eq inserted_mid_ok, 1
    inserted_mid_value_ok = eq inserted_mid, 20
    insert_end_flag_ok = eq insert_end_ok, 1
    insert_miss_flag_ok = eq insert_miss_ok, 0
    dedup_len_ok = eq dedup_len, 4
    len_after_dedup_ok = eq len_after_dedup, 4
    dedup_first_flag_ok = eq dedup_first_ok, 1
    dedup_first_value_ok = eq dedup_first, 10
    dedup_second_flag_ok = eq dedup_second_ok, 1
    dedup_second_value_ok = eq dedup_second, 20
    dedup_third_flag_ok = eq dedup_third_ok, 1
    dedup_third_value_ok = eq dedup_third, 30
    dedup_fourth_flag_ok = eq dedup_fourth_ok, 1
    dedup_fourth_value_ok = eq dedup_fourth, 40
    cap_after_ok = eq cap_after, 6
    pwc_full_flag_ok = eq pwc_full_ok, 1
    ok01 = and with_cap_flag_ok, pwc1_flag_ok
    ok02 = and ok01, pwc2_flag_ok
    ok03 = and ok02, insert_mid_flag_ok
    ok04 = and ok03, inserted_mid_flag_ok
    ok05 = and ok04, inserted_mid_value_ok
