    store append_src_data+8, 77 as u64
    append_src_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW append_src_slice, append_src_data, 2
    EXPAND VEC_EXTEND_FROM_SLICE_U64 vec, append_src_slice
    EXPAND VEC_TRY_GET_U64 after_extend_ok, after_extend, vec, 3
    EXPAND VEC_WITH_CAPACITY_U64 append_src_vec, 2
