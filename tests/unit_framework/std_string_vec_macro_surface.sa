    EXPAND VEC_TRY_GET_U64 after_append_ok, after_append, vec, 5
    EXPAND VEC_LEN append_src_len_after, append_src_vec
    prefix_data = alloc 8
    suffix_data = alloc 8
    miss_prefix_data = alloc 8
    long_suffix_data = alloc 24
    store prefix_data+0, 44 as u64
    store suffix_data+0, 99 as u64
    store miss_prefix_data+0, 66 as u64
    store long_suffix_data+0, 44 as u64
    store long_suffix_data+8, 55 as u64
    store long_suffix_data+16, 66 as u64
    prefix = alloc Slice_SIZE
    suffix = alloc Slice_SIZE
    miss_prefix = alloc Slice_SIZE
    long_suffix = alloc Slice_SIZE
    EXPAND SLICE_NEW prefix, prefix_data, 1
    EXPAND SLICE_NEW suffix, suffix_data, 1
    EXPAND SLICE_NEW miss_prefix, miss_prefix_data, 1
    EXPAND SLICE_NEW long_suffix, long_suffix_data, 3
    EXPAND VEC_RESERVE_EXACT_U64 vec, 2
    EXPAND VEC_CAPACITY cap_exact, vec
