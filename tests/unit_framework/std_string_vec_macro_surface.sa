    !contains_22
    !contains_44
    !starts_ok
    !ends_ok
    !starts_empty_ok
    !ends_empty_ok
    !starts_miss
    !ends_long_miss
    !strip_prefix_ok
    !strip_prefix_tail
    !strip_suffix_ok
