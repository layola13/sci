    !get0_ok
    !get0
    !get2_ok
    !get2
    !miss_ok
    !miss_value
    !has_30
    !has_99
    !get_mut_ok
    !mut_ptr
    !get1_after_mut_ok
    !get1_after_mut
    !set_ok
    !set_miss_ok
    !swap_ok
    !swap_miss_ok
    !front_ok
    !front
    !back_ok
    !back
    !len_after_truncate
    !cap_after_shrink_to
    !cap_after_shrink_fit
    !back_after_truncate_ok
    !back_after_truncate
    !ok_cap0
    !ok_empty0
    !ok_try_new
    !ok_try_cap
    !ok_reserve
