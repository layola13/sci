    !ok_back_flag
    !ok_back
    !ok_len_after_truncate
    !ok_cap_after_shrink_to
    !ok_cap_after_shrink_fit
    !ok_back_after_truncate_flag
    !ok_back_after_truncate
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !ok32
    EXPAND VEC_DEQUE_FREE deque
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(910)

L_OK:
    !ok
    return

@test "sa_std vec_deque rust parity macros"():
L_ENTRY:
    EXPAND VEC_DEQUE_WITH_CAPACITY deque, 4
    EXPAND VEC_DEQUE_PUSH_BACK deque, 10
    EXPAND VEC_DEQUE_PUSH_BACK deque, 20
    EXPAND VEC_DEQUE_PUSH_BACK deque, 30
    EXPAND VEC_DEQUE_PUSH_BACK deque, 40
    EXPAND VEC_DEQUE_TRY_POP_FRONT pop0_ok, pop0, deque
    EXPAND VEC_DEQUE_PUSH_BACK deque, 50
    EXPAND VEC_DEQUE_AS_SLICES front_slice, back_slice, deque
    EXPAND SLICE_GET_LEN front_slice_len, front_slice
    EXPAND SLICE_GET_LEN back_slice_len, back_slice
    EXPAND SLICE_FIRST_U64 front_slice_first, front_slice
    EXPAND SLICE_FIRST_U64 back_slice_first, back_slice
    EXPAND VEC_DEQUE_AS_MUT_SLICES mut_front_slice, mut_back_slice, deque
    EXPAND SLICE_GET_LEN mut_front_len, mut_front_slice
    EXPAND SLICE_GET_LEN mut_back_len, mut_back_slice
    EXPAND VEC_DEQUE_TRY_FRONT_MUT_PTR front_mut_ok, front_mut_ptr, deque
    store front_mut_ptr+0, 21 as u64
    EXPAND VEC_DEQUE_TRY_BACK_MUT_PTR back_mut_ok, back_mut_ptr, deque
    store back_mut_ptr+0, 55 as u64
    EXPAND VEC_DEQUE_TRY_GET after_front_mut_ok, after_front_mut, deque, 0
    EXPAND VEC_DEQUE_TRY_GET after_back_mut_ok, after_back_mut, deque, 3

    EXPAND VEC_DEQUE_TRY_INSERT insert_ok, deque, 2, 33
    EXPAND VEC_DEQUE_TRY_INSERT insert_miss_ok, deque, 9, 99
    EXPAND VEC_DEQUE_LEN len_after_insert, deque
    EXPAND VEC_DEQUE_TRY_GET inserted_ok, inserted_value, deque, 2
    EXPAND VEC_DEQUE_TRY_GET shifted_ok, shifted_value, deque, 3
    EXPAND VEC_DEQUE_TRY_REMOVE remove_ok, removed_value, deque, 3
    EXPAND VEC_DEQUE_TRY_REMOVE remove_miss_ok, remove_miss_value, deque, 9
    EXPAND VEC_DEQUE_LEN len_after_remove, deque
    EXPAND VEC_DEQUE_TRY_GET after_remove_tail_ok, after_remove_tail, deque, 3

    EXPAND VEC_DEQUE_TRY_SWAP_REMOVE_FRONT swap_front_ok, swap_front_value, deque, 2
    EXPAND VEC_DEQUE_LEN len_after_swap_front, deque
    EXPAND VEC_DEQUE_TRY_GET after_swap_front0_ok, after_swap_front0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET after_swap_front1_ok, after_swap_front1, deque, 1
    EXPAND VEC_DEQUE_TRY_GET after_swap_front2_ok, after_swap_front2, deque, 2
    EXPAND VEC_DEQUE_TRY_SWAP_REMOVE_BACK swap_back_ok, swap_back_value, deque, 0
    EXPAND VEC_DEQUE_LEN len_after_swap_back, deque
    EXPAND VEC_DEQUE_TRY_GET after_swap_back0_ok, after_swap_back0, deque, 0
    EXPAND VEC_DEQUE_TRY_GET after_swap_back1_ok, after_swap_back1, deque, 1

    EXPAND VEC_DEQUE_MAKE_CONTIGUOUS contiguous_slice, deque
    EXPAND SLICE_GET_LEN contiguous_len, contiguous_slice
    EXPAND SLICE_GET_U64 contiguous0, contiguous_slice, 0
    EXPAND SLICE_GET_U64 contiguous1, contiguous_slice, 1
    EXPAND VEC_DEQUE_TRY_SHRINK_TO shrink_to_ok, deque, 1
    EXPAND VEC_DEQUE_CAPACITY cap_after_try_shrink_to, deque
    EXPAND VEC_DEQUE_TRY_SHRINK_TO_FIT shrink_fit_ok, deque
    EXPAND VEC_DEQUE_CAPACITY cap_after_try_shrink_fit, deque
    EXPAND VEC_DEQUE_AS_SLICES final_front_slice, final_back_slice, deque
    EXPAND SLICE_GET_LEN final_front_len, final_front_slice
    EXPAND SLICE_GET_LEN final_back_len, final_back_slice

    ok_pop0 = eq pop0_ok, 1
    ok_pop0_value = eq pop0, 10
    ok_front_slice_len = eq front_slice_len, 3
    ok_back_slice_len = eq back_slice_len, 1
    ok_front_slice_first = eq front_slice_first, 20
    ok_back_slice_first = eq back_slice_first, 50
    ok_mut_front_len = eq mut_front_len, 3
    ok_mut_back_len = eq mut_back_len, 1
    ok_front_mut = eq front_mut_ok, 1
    ok_back_mut = eq back_mut_ok, 1
    ok_after_front_mut_flag = eq after_front_mut_ok, 1
    ok_after_front_mut = eq after_front_mut, 21
    ok_after_back_mut_flag = eq after_back_mut_ok, 1
    ok_after_back_mut = eq after_back_mut, 55
    ok_insert = eq insert_ok, 1
    ok_insert_miss = eq insert_miss_ok, 0
    ok_len_after_insert = eq len_after_insert, 5
    ok_inserted_flag = eq inserted_ok, 1
    ok_inserted = eq inserted_value, 33
    ok_shifted_flag = eq shifted_ok, 1
    ok_shifted = eq shifted_value, 40
    ok_remove = eq remove_ok, 1
    ok_removed = eq removed_value, 40
    ok_remove_miss_flag = eq remove_miss_ok, 0
    ok_remove_miss_value = eq remove_miss_value, 0
    ok_len_after_remove = eq len_after_remove, 4
    ok_after_remove_tail_flag = eq after_remove_tail_ok, 1
    ok_after_remove_tail = eq after_remove_tail, 55
    ok_swap_front = eq swap_front_ok, 1
    ok_swap_front_value = eq swap_front_value, 33
    ok_len_after_swap_front = eq len_after_swap_front, 3
    ok_after_swap_front0_flag = eq after_swap_front0_ok, 1
    ok_after_swap_front0 = eq after_swap_front0, 30
    ok_after_swap_front1_flag = eq after_swap_front1_ok, 1
    ok_after_swap_front1 = eq after_swap_front1, 21
    ok_after_swap_front2_flag = eq after_swap_front2_ok, 1
    ok_after_swap_front2 = eq after_swap_front2, 55
    ok_swap_back = eq swap_back_ok, 1
    ok_swap_back_value = eq swap_back_value, 30
    ok_len_after_swap_back = eq len_after_swap_back, 2
    ok_after_swap_back0_flag = eq after_swap_back0_ok, 1
    ok_after_swap_back0 = eq after_swap_back0, 55
    ok_after_swap_back1_flag = eq after_swap_back1_ok, 1
    ok_after_swap_back1 = eq after_swap_back1, 21
    ok_contiguous_len = eq contiguous_len, 2
    ok_contiguous0 = eq contiguous0, 55
    ok_contiguous1 = eq contiguous1, 21
    ok_shrink_to = eq shrink_to_ok, 1
    ok_cap_after_try_shrink_to = eq cap_after_try_shrink_to, 2
    ok_shrink_fit = eq shrink_fit_ok, 1
    ok_cap_after_try_shrink_fit = eq cap_after_try_shrink_fit, 2
    ok_final_front_len = eq final_front_len, 2
    ok_final_back_len = eq final_back_len, 0

    ok01 = and ok_pop0, ok_pop0_value
    ok02 = and ok01, ok_front_slice_len
    ok03 = and ok02, ok_back_slice_len
    ok04 = and ok03, ok_front_slice_first
    ok05 = and ok04, ok_back_slice_first
    ok06 = and ok05, ok_mut_front_len
    ok07 = and ok06, ok_mut_back_len
    ok08 = and ok07, ok_front_mut
    ok09 = and ok08, ok_back_mut
    ok10 = and ok09, ok_after_front_mut_flag
    ok11 = and ok10, ok_after_front_mut
    ok12 = and ok11, ok_after_back_mut_flag
    ok13 = and ok12, ok_after_back_mut
    ok14 = and ok13, ok_insert
    ok15 = and ok14, ok_insert_miss
    ok16 = and ok15, ok_len_after_insert
    ok17 = and ok16, ok_inserted_flag
    ok18 = and ok17, ok_inserted
    ok19 = and ok18, ok_shifted_flag
    ok20 = and ok19, ok_shifted
    ok21 = and ok20, ok_remove
    ok22 = and ok21, ok_removed
    ok23 = and ok22, ok_remove_miss_flag
    ok24 = and ok23, ok_remove_miss_value
    ok25 = and ok24, ok_len_after_remove
    ok26 = and ok25, ok_after_remove_tail_flag
    ok27 = and ok26, ok_after_remove_tail
    ok28 = and ok27, ok_swap_front
    ok29 = and ok28, ok_swap_front_value
    ok30 = and ok29, ok_len_after_swap_front
    ok31 = and ok30, ok_after_swap_front0_flag
    ok32 = and ok31, ok_after_swap_front0
    ok33 = and ok32, ok_after_swap_front1_flag
    ok34 = and ok33, ok_after_swap_front1
    ok35 = and ok34, ok_after_swap_front2_flag
