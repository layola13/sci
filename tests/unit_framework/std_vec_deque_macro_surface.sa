    ok40 = and ok39, ok_after_swap_back0_flag
    ok41 = and ok40, ok_after_swap_back0
    ok42 = and ok41, ok_after_swap_back1_flag
    ok43 = and ok42, ok_after_swap_back1
    ok44 = and ok43, ok_contiguous_len
