    ok_isize_add_old = eq isize_add_old, -10
    ok_isize_sub_old = eq isize_sub_old, 5
    ok_isize_swap_old = eq isize_swap_old, -3
    ok_isize_cmp_old = eq isize_cmp_old, 21
    ok_isize_cmp = eq isize_cmp_ok, 1
    ok_isize_final = eq isize_final, -3

    ok_ptr_initial = eq ptr_initial, ptr_a
    ok_ptr_swap_old = eq ptr_swap_old, ptr_b
    ok_ptr_cmp_old = eq ptr_cmp_old, ptr_c
    ok_ptr_cmp = eq ptr_cmp_ok, 1
    ok_ptr_final = eq ptr_final, ptr_a
