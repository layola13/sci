L_PASS:
    return 0

@test "sa_std sync atomic extended type macros"():
L_ENTRY:
    u8_slot = stack_alloc AtomicU8_SIZE
    EXPAND ATOMIC_U8_INIT u8_slot, 5
    EXPAND ATOMIC_U8_LOAD u8_initial, u8_slot, seq_cst
    EXPAND ATOMIC_U8_FETCH_ADD u8_add_old, u8_slot, 3, seq_cst
    EXPAND ATOMIC_U8_FETCH_SUB u8_sub_old, u8_slot, 2, seq_cst
    EXPAND ATOMIC_U8_FETCH_OR u8_or_old, u8_slot, 8, seq_cst
    EXPAND ATOMIC_U8_FETCH_AND u8_and_old, u8_slot, 14, seq_cst
    EXPAND ATOMIC_U8_FETCH_XOR u8_xor_old, u8_slot, 3, seq_cst
    EXPAND ATOMIC_U8_SWAP u8_swap_old, u8_slot, 99, seq_cst
    EXPAND ATOMIC_U8_COMPARE_EXCHANGE u8_cmp_old, u8_cmp_ok, u8_slot, 99, 7, seq_cst, acquire
    EXPAND ATOMIC_U8_LOAD u8_final, u8_slot, seq_cst

    u16_slot = stack_alloc AtomicU16_SIZE
    EXPAND ATOMIC_U16_INIT u16_slot, 5
    EXPAND ATOMIC_U16_LOAD u16_initial, u16_slot, seq_cst
    EXPAND ATOMIC_U16_FETCH_ADD u16_add_old, u16_slot, 3, seq_cst
    EXPAND ATOMIC_U16_FETCH_SUB u16_sub_old, u16_slot, 2, seq_cst
    EXPAND ATOMIC_U16_FETCH_OR u16_or_old, u16_slot, 8, seq_cst
    EXPAND ATOMIC_U16_FETCH_AND u16_and_old, u16_slot, 14, seq_cst
    EXPAND ATOMIC_U16_FETCH_XOR u16_xor_old, u16_slot, 3, seq_cst
    EXPAND ATOMIC_U16_SWAP u16_swap_old, u16_slot, 99, seq_cst
    EXPAND ATOMIC_U16_COMPARE_EXCHANGE u16_cmp_old, u16_cmp_ok, u16_slot, 99, 7, seq_cst, acquire
    EXPAND ATOMIC_U16_LOAD u16_final, u16_slot, seq_cst

    usize_slot = stack_alloc AtomicUsize_SIZE
    EXPAND ATOMIC_USIZE_INIT usize_slot, 10
    EXPAND ATOMIC_USIZE_LOAD usize_initial, usize_slot, seq_cst
    EXPAND ATOMIC_USIZE_FETCH_ADD usize_add_old, usize_slot, 5, seq_cst
    EXPAND ATOMIC_USIZE_FETCH_SUB usize_sub_old, usize_slot, 3, seq_cst
    EXPAND ATOMIC_USIZE_FETCH_OR usize_or_old, usize_slot, 2, seq_cst
    EXPAND ATOMIC_USIZE_FETCH_AND usize_and_old, usize_slot, 14, seq_cst
    EXPAND ATOMIC_USIZE_FETCH_XOR usize_xor_old, usize_slot, 7, seq_cst
    EXPAND ATOMIC_USIZE_SWAP usize_swap_old, usize_slot, 33, seq_cst
    EXPAND ATOMIC_USIZE_COMPARE_EXCHANGE usize_cmp_old, usize_cmp_ok, usize_slot, 33, 44, seq_cst, acquire
    EXPAND ATOMIC_USIZE_LOAD usize_final, usize_slot, seq_cst

    isize_slot = stack_alloc AtomicIsize_SIZE
    EXPAND ATOMIC_ISIZE_INIT isize_slot, -10
    EXPAND ATOMIC_ISIZE_LOAD isize_initial, isize_slot, seq_cst
    EXPAND ATOMIC_ISIZE_FETCH_ADD isize_add_old, isize_slot, 15, seq_cst
    EXPAND ATOMIC_ISIZE_FETCH_SUB isize_sub_old, isize_slot, 8, seq_cst
    EXPAND ATOMIC_ISIZE_SWAP isize_swap_old, isize_slot, 21, seq_cst
    EXPAND ATOMIC_ISIZE_COMPARE_EXCHANGE isize_cmp_old, isize_cmp_ok, isize_slot, 21, -3, seq_cst, acquire
    EXPAND ATOMIC_ISIZE_LOAD isize_final, isize_slot, seq_cst

    ptr_a = stack_alloc 8
    ptr_b = stack_alloc 8
    ptr_c = stack_alloc 8
    ptr_slot = stack_alloc AtomicPtr_SIZE
    EXPAND ATOMIC_PTR_INIT ptr_slot, ptr_a
    EXPAND ATOMIC_PTR_LOAD ptr_initial, ptr_slot, seq_cst
    EXPAND ATOMIC_PTR_STORE ptr_slot, ptr_b, seq_cst
    EXPAND ATOMIC_PTR_SWAP ptr_swap_old, ptr_slot, ptr_c, seq_cst
    EXPAND ATOMIC_PTR_COMPARE_EXCHANGE ptr_cmp_old, ptr_cmp_ok, ptr_slot, ptr_c, ptr_a, seq_cst, acquire
    EXPAND ATOMIC_PTR_LOAD ptr_final, ptr_slot, seq_cst

    ptr_block = stack_alloc 32
    ptr_block_8 = ptr_add ptr_block, 8
    ptr_block_16 = ptr_add ptr_block, 16
    ptr_block_24 = ptr_add ptr_block, 24
    ptr_math_slot = stack_alloc AtomicPtr_SIZE
    EXPAND ATOMIC_PTR_INIT ptr_math_slot, ptr_block
    EXPAND ATOMIC_PTR_FETCH_BYTE_ADD ptr_byte_add_old, ptr_math_slot, 8, seq_cst
    EXPAND ATOMIC_PTR_FETCH_U64_ADD ptr_u64_add_old, ptr_math_slot, 2, seq_cst
    EXPAND ATOMIC_PTR_FETCH_BYTE_SUB ptr_byte_sub_old, ptr_math_slot, 8, seq_cst
    EXPAND ATOMIC_PTR_FETCH_U64_SUB ptr_u64_sub_old, ptr_math_slot, 2, seq_cst
    EXPAND ATOMIC_PTR_LOAD ptr_math_final, ptr_math_slot, seq_cst

