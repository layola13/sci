@test "sa_std sync atomic narrow signed macros"():
L_ENTRY:
    i8_slot = stack_alloc AtomicI8_SIZE
    EXPAND ATOMIC_I8_INIT i8_slot, -5
    EXPAND ATOMIC_I8_LOAD i8_initial, i8_slot, seq_cst
    EXPAND ATOMIC_I8_FETCH_ADD i8_add_old, i8_slot, 8, seq_cst
    EXPAND ATOMIC_I8_FETCH_SUB i8_sub_old, i8_slot, 4, seq_cst
    EXPAND ATOMIC_I8_SWAP i8_swap_old, i8_slot, 21, seq_cst
    EXPAND ATOMIC_I8_COMPARE_EXCHANGE i8_cmp_old, i8_cmp_ok, i8_slot, 21, -3, seq_cst, acquire
    EXPAND ATOMIC_I8_LOAD i8_final, i8_slot, seq_cst

    i16_slot = stack_alloc AtomicI16_SIZE
    EXPAND ATOMIC_I16_INIT i16_slot, -5
    EXPAND ATOMIC_I16_LOAD i16_initial, i16_slot, seq_cst
    EXPAND ATOMIC_I16_FETCH_ADD i16_add_old, i16_slot, 8, seq_cst
    EXPAND ATOMIC_I16_FETCH_SUB i16_sub_old, i16_slot, 4, seq_cst
    EXPAND ATOMIC_I16_SWAP i16_swap_old, i16_slot, 21, seq_cst
    EXPAND ATOMIC_I16_COMPARE_EXCHANGE i16_cmp_old, i16_cmp_ok, i16_slot, 21, -3, seq_cst, acquire
    EXPAND ATOMIC_I16_LOAD i16_final, i16_slot, seq_cst

    ok_i8_initial = eq i8_initial, -5
    ok_i8_add_old = eq i8_add_old, -5
    ok_i8_sub_old = eq i8_sub_old, 3
    ok_i8_swap_old = eq i8_swap_old, -1
    ok_i8_cmp_old = eq i8_cmp_old, 21
    ok_i8_cmp = eq i8_cmp_ok, 1
    ok_i8_final = eq i8_final, -3

    ok_i16_initial = eq i16_initial, -5
    ok_i16_add_old = eq i16_add_old, -5
    ok_i16_sub_old = eq i16_sub_old, 3
    ok_i16_swap_old = eq i16_swap_old, -1
    ok_i16_cmp_old = eq i16_cmp_old, 21
    ok_i16_cmp = eq i16_cmp_ok, 1
    ok_i16_final = eq i16_final, -3

    ok01 = and ok_i8_initial, ok_i8_add_old
    ok02 = and ok01, ok_i8_sub_old
    ok03 = and ok02, ok_i8_swap_old
    ok04 = and ok03, ok_i8_cmp_old
    ok05 = and ok04, ok_i8_cmp
    ok06 = and ok05, ok_i8_final
    ok07 = and ok06, ok_i16_initial
    ok08 = and ok07, ok_i16_add_old
    ok09 = and ok08, ok_i16_sub_old
    ok10 = and ok09, ok_i16_swap_old
    ok11 = and ok10, ok_i16_cmp_old
    ok12 = and ok11, ok_i16_cmp
    ok = and ok12, ok_i16_final

    !i8_initial
    !i8_add_old
    !i8_sub_old
    !i8_swap_old
    !i8_cmp_old
    !i8_cmp_ok
    !i8_final
    !i16_initial
    !i16_add_old
    !i16_sub_old
    !i16_swap_old
    !i16_cmp_old
    !i16_cmp_ok
    !i16_final
    !ok_i8_initial
    !ok_i8_add_old
    !ok_i8_sub_old
    !ok_i8_swap_old
    !ok_i8_cmp_old
    !ok_i8_cmp
    !ok_i8_final
    !ok_i16_initial
    !ok_i16_add_old
    !ok_i16_sub_old
    !ok_i16_swap_old
    !ok_i16_cmp_old
    !ok_i16_cmp
    !ok_i16_final
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12

    br ok -> L_PASS, L_FAIL

