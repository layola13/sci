@import "sa_std/sync/atomic.sa"

@test "sa_std sync atomic primitive macros"():
L_ENTRY:
    bool_slot = stack_alloc AtomicBool_SIZE
    EXPAND ATOMIC_BOOL_INIT bool_slot, 0
    EXPAND ATOMIC_BOOL_LOAD bool_initial, bool_slot, seq_cst
    EXPAND ATOMIC_BOOL_STORE bool_slot, 1, seq_cst
    EXPAND ATOMIC_BOOL_SWAP bool_old, bool_slot, 0, seq_cst
    EXPAND ATOMIC_BOOL_COMPARE_EXCHANGE bool_cmp_old, bool_cmp_ok, bool_slot, 0, 1, seq_cst, acquire
    EXPAND ATOMIC_BOOL_LOAD bool_final, bool_slot, seq_cst

    u32_slot = stack_alloc AtomicU32_SIZE
    EXPAND ATOMIC_U32_INIT u32_slot, 5
    EXPAND ATOMIC_U32_LOAD u32_initial, u32_slot, seq_cst
    EXPAND ATOMIC_U32_FETCH_ADD u32_add_old, u32_slot, 3, seq_cst
    EXPAND ATOMIC_U32_FETCH_SUB u32_sub_old, u32_slot, 2, seq_cst
    EXPAND ATOMIC_U32_FETCH_OR u32_or_old, u32_slot, 8, seq_cst
    EXPAND ATOMIC_U32_FETCH_AND u32_and_old, u32_slot, 14, seq_cst
    EXPAND ATOMIC_U32_FETCH_XOR u32_xor_old, u32_slot, 3, seq_cst
    EXPAND ATOMIC_U32_SWAP u32_swap_old, u32_slot, 99, seq_cst
    EXPAND ATOMIC_U32_COMPARE_EXCHANGE u32_cmp_old, u32_cmp_ok, u32_slot, 99, 7, seq_cst, acquire
    EXPAND ATOMIC_U32_LOAD u32_final, u32_slot, seq_cst

    i32_slot = stack_alloc AtomicI32_SIZE
    EXPAND ATOMIC_I32_INIT i32_slot, -5
    EXPAND ATOMIC_I32_FETCH_ADD i32_add_old, i32_slot, 8, seq_cst
    EXPAND ATOMIC_I32_FETCH_SUB i32_sub_old, i32_slot, 4, seq_cst
    EXPAND ATOMIC_I32_COMPARE_EXCHANGE i32_cmp_old, i32_cmp_ok, i32_slot, -1, 12, seq_cst, acquire
    EXPAND ATOMIC_I32_LOAD i32_final, i32_slot, seq_cst

    u64_slot = stack_alloc AtomicU64_SIZE
    EXPAND ATOMIC_U64_INIT u64_slot, 10
    EXPAND ATOMIC_U64_FETCH_ADD u64_add_old, u64_slot, 5, seq_cst
    EXPAND ATOMIC_U64_FETCH_SUB u64_sub_old, u64_slot, 3, seq_cst
    EXPAND ATOMIC_U64_FETCH_UMIN u64_umin_old, u64_slot, 8, seq_cst
    EXPAND ATOMIC_U64_FETCH_UMAX u64_umax_old, u64_slot, 20, seq_cst
    EXPAND ATOMIC_U64_FETCH_OR u64_or_old, u64_slot, 2, seq_cst
    EXPAND ATOMIC_U64_FETCH_AND u64_and_old, u64_slot, 22, seq_cst
    EXPAND ATOMIC_U64_FETCH_XOR u64_xor_old, u64_slot, 7, seq_cst
    EXPAND ATOMIC_U64_SWAP u64_swap_old, u64_slot, 33, seq_cst
    EXPAND ATOMIC_U64_COMPARE_EXCHANGE u64_cmp_old, u64_cmp_ok, u64_slot, 33, 44, seq_cst, acquire
    EXPAND ATOMIC_U64_LOAD u64_final, u64_slot, seq_cst

    i64_slot = stack_alloc AtomicI64_SIZE
    EXPAND ATOMIC_I64_INIT i64_slot, -10
    EXPAND ATOMIC_I64_FETCH_ADD i64_add_old, i64_slot, 15, seq_cst
    EXPAND ATOMIC_I64_FETCH_SUB i64_sub_old, i64_slot, 8, seq_cst
    EXPAND ATOMIC_I64_SWAP i64_swap_old, i64_slot, 21, seq_cst
    EXPAND ATOMIC_I64_COMPARE_EXCHANGE i64_cmp_old, i64_cmp_ok, i64_slot, 21, -3, seq_cst, acquire
    EXPAND ATOMIC_I64_LOAD i64_final, i64_slot, seq_cst

    EXPAND ATOMIC_FENCE seq_cst

    ok_bool_initial = eq bool_initial, 0
    ok_bool_old = eq bool_old, 1
    ok_bool_cmp_old = eq bool_cmp_old, 0
    ok_bool_cmp = eq bool_cmp_ok, 1
    ok_bool_final = eq bool_final, 1

    ok_u32_initial = eq u32_initial, 5
    ok_u32_add_old = eq u32_add_old, 5
    ok_u32_sub_old = eq u32_sub_old, 8
    ok_u32_or_old = eq u32_or_old, 6
    ok_u32_and_old = eq u32_and_old, 14
    ok_u32_xor_old = eq u32_xor_old, 14
    ok_u32_swap_old = eq u32_swap_old, 13
    ok_u32_cmp_old = eq u32_cmp_old, 99
    ok_u32_cmp = eq u32_cmp_ok, 1
    ok_u32_final = eq u32_final, 7

    ok_i32_add_old = eq i32_add_old, -5
    ok_i32_sub_old = eq i32_sub_old, 3
    ok_i32_cmp_old = eq i32_cmp_old, -1
    ok_i32_cmp = eq i32_cmp_ok, 1
    ok_i32_final = eq i32_final, 12

    ok_u64_add_old = eq u64_add_old, 10
    ok_u64_sub_old = eq u64_sub_old, 15
    ok_u64_umin_old = eq u64_umin_old, 12
    ok_u64_umax_old = eq u64_umax_old, 8
    ok_u64_or_old = eq u64_or_old, 20
    ok_u64_and_old = eq u64_and_old, 22
    ok_u64_xor_old = eq u64_xor_old, 22
    ok_u64_swap_old = eq u64_swap_old, 17
    ok_u64_cmp_old = eq u64_cmp_old, 33
    ok_u64_cmp = eq u64_cmp_ok, 1
    ok_u64_final = eq u64_final, 44

    ok_i64_add_old = eq i64_add_old, -10
    ok_i64_sub_old = eq i64_sub_old, 5
    ok_i64_swap_old = eq i64_swap_old, -3
    ok_i64_cmp_old = eq i64_cmp_old, 21
    ok_i64_cmp = eq i64_cmp_ok, 1
    ok_i64_final = eq i64_final, -3

    ok01 = and ok_bool_initial, ok_bool_old
    ok02 = and ok01, ok_bool_cmp_old
    ok03 = and ok02, ok_bool_cmp
    ok04 = and ok03, ok_bool_final
    ok05 = and ok04, ok_u32_initial
    ok06 = and ok05, ok_u32_add_old
    ok07 = and ok06, ok_u32_sub_old
    ok08 = and ok07, ok_u32_or_old
    ok09 = and ok08, ok_u32_and_old
    ok10 = and ok09, ok_u32_xor_old
    ok11 = and ok10, ok_u32_swap_old
    ok12 = and ok11, ok_u32_cmp_old
    ok13 = and ok12, ok_u32_cmp
    ok14 = and ok13, ok_u32_final
    ok15 = and ok14, ok_i32_add_old
    ok16 = and ok15, ok_i32_sub_old
    ok17 = and ok16, ok_i32_cmp_old
    ok18 = and ok17, ok_i32_cmp
    ok19 = and ok18, ok_i32_final
    ok20 = and ok19, ok_u64_add_old
    ok21 = and ok20, ok_u64_sub_old
    ok22 = and ok21, ok_u64_umin_old
    ok23 = and ok22, ok_u64_umax_old
    ok24 = and ok23, ok_u64_or_old
    ok25 = and ok24, ok_u64_and_old
    ok26 = and ok25, ok_u64_xor_old
    ok27 = and ok26, ok_u64_swap_old
    ok28 = and ok27, ok_u64_cmp_old
    ok29 = and ok28, ok_u64_cmp
    ok30 = and ok29, ok_u64_final
    ok31 = and ok30, ok_i64_add_old
    ok32 = and ok31, ok_i64_sub_old
    ok33 = and ok32, ok_i64_swap_old
    ok34 = and ok33, ok_i64_cmp_old
    ok35 = and ok34, ok_i64_cmp
    ok = and ok35, ok_i64_final

    !bool_initial
    !bool_old
    !bool_cmp_old
    !bool_cmp_ok
    !bool_final
    !u32_initial
    !u32_add_old
    !u32_sub_old
    !u32_or_old
    !u32_and_old
    !u32_xor_old
    !u32_swap_old
    !u32_cmp_old
    !u32_cmp_ok
    !u32_final
    !i32_add_old
    !i32_sub_old
    !i32_cmp_old
    !i32_cmp_ok
    !i32_final
    !u64_add_old
    !u64_sub_old
    !u64_umin_old
    !u64_umax_old
    !u64_or_old
    !u64_and_old
    !u64_xor_old
    !u64_swap_old
    !u64_cmp_old
    !u64_cmp_ok
    !u64_final
    !i64_add_old
    !i64_sub_old
    !i64_swap_old
    !i64_cmp_old
    !i64_cmp_ok
    !i64_final
    !ok_bool_initial
    !ok_bool_old
    !ok_bool_cmp_old
    !ok_bool_cmp
    !ok_bool_final
    !ok_u32_initial
    !ok_u32_add_old
    !ok_u32_sub_old
    !ok_u32_or_old
    !ok_u32_and_old
    !ok_u32_xor_old
    !ok_u32_swap_old
    !ok_u32_cmp_old
    !ok_u32_cmp
    !ok_u32_final
    !ok_i32_add_old
    !ok_i32_sub_old
    !ok_i32_cmp_old
    !ok_i32_cmp
    !ok_i32_final
    !ok_u64_add_old
    !ok_u64_sub_old
    !ok_u64_umin_old
    !ok_u64_umax_old
    !ok_u64_or_old
    !ok_u64_and_old
    !ok_u64_xor_old
    !ok_u64_swap_old
    !ok_u64_cmp_old
    !ok_u64_cmp
    !ok_u64_final
    !ok_i64_add_old
    !ok_i64_sub_old
    !ok_i64_swap_old
    !ok_i64_cmp_old
    !ok_i64_cmp
    !ok_i64_final
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !ok32
    !ok33
    !ok34
    !ok35

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(990)

L_PASS:
    return 0

@test "sa_std sync atomic compare_exchange_weak macros"():
L_ENTRY:
    bool_slot = stack_alloc AtomicBool_SIZE
    EXPAND ATOMIC_BOOL_INIT bool_slot, 0
    EXPAND ATOMIC_BOOL_COMPARE_EXCHANGE_WEAK bool_old, bool_ok, bool_slot, 0, 1, seq_cst, acquire

    u8_slot = stack_alloc AtomicU8_SIZE
    EXPAND ATOMIC_U8_INIT u8_slot, 8
    EXPAND ATOMIC_U8_COMPARE_EXCHANGE_WEAK u8_old, u8_ok, u8_slot, 8, 9, seq_cst, acquire

    i8_slot = stack_alloc AtomicI8_SIZE
    EXPAND ATOMIC_I8_INIT i8_slot, -8
    EXPAND ATOMIC_I8_COMPARE_EXCHANGE_WEAK i8_old, i8_ok, i8_slot, -8, -9, seq_cst, acquire

    u16_slot = stack_alloc AtomicU16_SIZE
    EXPAND ATOMIC_U16_INIT u16_slot, 16
    EXPAND ATOMIC_U16_COMPARE_EXCHANGE_WEAK u16_old, u16_ok, u16_slot, 16, 17, seq_cst, acquire

    i16_slot = stack_alloc AtomicI16_SIZE
    EXPAND ATOMIC_I16_INIT i16_slot, -16
    EXPAND ATOMIC_I16_COMPARE_EXCHANGE_WEAK i16_old, i16_ok, i16_slot, -16, -17, seq_cst, acquire

    u32_slot = stack_alloc AtomicU32_SIZE
    EXPAND ATOMIC_U32_INIT u32_slot, 32
    EXPAND ATOMIC_U32_COMPARE_EXCHANGE_WEAK u32_old, u32_ok, u32_slot, 32, 33, seq_cst, acquire

    i32_slot = stack_alloc AtomicI32_SIZE
    EXPAND ATOMIC_I32_INIT i32_slot, -32
    EXPAND ATOMIC_I32_COMPARE_EXCHANGE_WEAK i32_old, i32_ok, i32_slot, -32, -33, seq_cst, acquire

    u64_slot = stack_alloc AtomicU64_SIZE
    EXPAND ATOMIC_U64_INIT u64_slot, 64
    EXPAND ATOMIC_U64_COMPARE_EXCHANGE_WEAK u64_old, u64_ok, u64_slot, 64, 65, seq_cst, acquire

    i64_slot = stack_alloc AtomicI64_SIZE
    EXPAND ATOMIC_I64_INIT i64_slot, -64
    EXPAND ATOMIC_I64_COMPARE_EXCHANGE_WEAK i64_old, i64_ok, i64_slot, -64, -65, seq_cst, acquire

    usize_slot = stack_alloc AtomicUsize_SIZE
    EXPAND ATOMIC_USIZE_INIT usize_slot, 100
    EXPAND ATOMIC_USIZE_COMPARE_EXCHANGE_WEAK usize_old, usize_ok, usize_slot, 100, 101, seq_cst, acquire

    isize_slot = stack_alloc AtomicIsize_SIZE
    EXPAND ATOMIC_ISIZE_INIT isize_slot, -100
    EXPAND ATOMIC_ISIZE_COMPARE_EXCHANGE_WEAK isize_old, isize_ok, isize_slot, -100, -101, seq_cst, acquire

    ptr_a = stack_alloc 8
    ptr_b = stack_alloc 8
    ptr_slot = stack_alloc AtomicPtr_SIZE
    EXPAND ATOMIC_PTR_INIT ptr_slot, ptr_a
    EXPAND ATOMIC_PTR_COMPARE_EXCHANGE_WEAK ptr_old, ptr_ok, ptr_slot, ptr_a, ptr_b, seq_cst, acquire

    bool_old_ok = eq bool_old, 0
    bool_flag_ok = eq bool_ok, 1
    u8_old_ok = eq u8_old, 8
    u8_flag_ok = eq u8_ok, 1
    i8_old_ok = eq i8_old, -8
    i8_flag_ok = eq i8_ok, 1
    u16_old_ok = eq u16_old, 16
    u16_flag_ok = eq u16_ok, 1
    i16_old_ok = eq i16_old, -16
    i16_flag_ok = eq i16_ok, 1
    u32_old_ok = eq u32_old, 32
    u32_flag_ok = eq u32_ok, 1
    i32_old_ok = eq i32_old, -32
    i32_flag_ok = eq i32_ok, 1
    u64_old_ok = eq u64_old, 64
    u64_flag_ok = eq u64_ok, 1
    i64_old_ok = eq i64_old, -64
    i64_flag_ok = eq i64_ok, 1
    usize_old_ok = eq usize_old, 100
    usize_flag_ok = eq usize_ok, 1
    isize_old_ok = eq isize_old, -100
    isize_flag_ok = eq isize_ok, 1
    ptr_old_ok = eq ptr_old, ptr_a
    ptr_flag_ok = eq ptr_ok, 1

    ok01 = and bool_old_ok, bool_flag_ok
    ok02 = and ok01, u8_old_ok
    ok03 = and ok02, u8_flag_ok
    ok04 = and ok03, i8_old_ok
    ok05 = and ok04, i8_flag_ok
    ok06 = and ok05, u16_old_ok
    ok07 = and ok06, u16_flag_ok
    ok08 = and ok07, i16_old_ok
    ok09 = and ok08, i16_flag_ok
    ok10 = and ok09, u32_old_ok
    ok11 = and ok10, u32_flag_ok
    ok12 = and ok11, i32_old_ok
    ok13 = and ok12, i32_flag_ok
    ok14 = and ok13, u64_old_ok
    ok15 = and ok14, u64_flag_ok
    ok16 = and ok15, i64_old_ok
    ok17 = and ok16, i64_flag_ok
    ok18 = and ok17, usize_old_ok
    ok19 = and ok18, usize_flag_ok
    ok20 = and ok19, isize_old_ok
    ok21 = and ok20, isize_flag_ok
    ok22 = and ok21, ptr_old_ok
    ok = and ok22, ptr_flag_ok

    !bool_old
    !bool_ok
    !u8_old
    !u8_ok
    !i8_old
    !i8_ok
    !u16_old
    !u16_ok
    !i16_old
    !i16_ok
    !u32_old
    !u32_ok
    !i32_old
    !i32_ok
    !u64_old
    !u64_ok
    !i64_old
    !i64_ok
    !usize_old
    !usize_ok
    !isize_old
    !isize_ok
    !ptr_old
    !ptr_ok
    !bool_old_ok
    !bool_flag_ok
    !u8_old_ok
    !u8_flag_ok
    !i8_old_ok
    !i8_flag_ok
    !u16_old_ok
    !u16_flag_ok
    !i16_old_ok
    !i16_flag_ok
    !u32_old_ok
    !u32_flag_ok
    !i32_old_ok
    !i32_flag_ok
    !u64_old_ok
    !u64_flag_ok
    !i64_old_ok
    !i64_flag_ok
    !usize_old_ok
    !usize_flag_ok
    !isize_old_ok
    !isize_flag_ok
    !ptr_old_ok
    !ptr_flag_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(988)

L_PASS:
    return 0

@test "sa_std sync atomic layout view macros"():
L_ENTRY:
    bool_slot = stack_alloc AtomicBool_SIZE
    EXPAND ATOMIC_BOOL_INIT bool_slot, 0
    EXPAND ATOMIC_BOOL_GET_MUT_PTR bool_mut, bool_slot
    store bool_mut+0, 1 as u8
    EXPAND ATOMIC_BOOL_FROM_MUT_PTR bool_from, bool_mut
    EXPAND ATOMIC_BOOL_INTO_INNER bool_inner, bool_from

    u8_slot = stack_alloc AtomicU8_SIZE
    EXPAND ATOMIC_U8_INIT u8_slot, 0
    EXPAND ATOMIC_U8_GET_MUT_PTR u8_mut, u8_slot
    store u8_mut+0, 11 as u8
    EXPAND ATOMIC_U8_FROM_MUT_PTR u8_from, u8_mut
    EXPAND ATOMIC_U8_INTO_INNER u8_inner, u8_from

    i8_slot = stack_alloc AtomicI8_SIZE
    EXPAND ATOMIC_I8_INIT i8_slot, 0
    EXPAND ATOMIC_I8_GET_MUT_PTR i8_mut, i8_slot
    store i8_mut+0, -7 as i8
    EXPAND ATOMIC_I8_FROM_MUT_PTR i8_from, i8_mut
    EXPAND ATOMIC_I8_INTO_INNER i8_inner, i8_from

    u16_slot = stack_alloc AtomicU16_SIZE
    EXPAND ATOMIC_U16_INIT u16_slot, 0
    EXPAND ATOMIC_U16_GET_MUT_PTR u16_mut, u16_slot
    store u16_mut+0, 222 as u16
    EXPAND ATOMIC_U16_FROM_MUT_PTR u16_from, u16_mut
    EXPAND ATOMIC_U16_INTO_INNER u16_inner, u16_from

    i16_slot = stack_alloc AtomicI16_SIZE
    EXPAND ATOMIC_I16_INIT i16_slot, 0
    EXPAND ATOMIC_I16_GET_MUT_PTR i16_mut, i16_slot
    store i16_mut+0, -333 as i16
    EXPAND ATOMIC_I16_FROM_MUT_PTR i16_from, i16_mut
    EXPAND ATOMIC_I16_INTO_INNER i16_inner, i16_from

    u32_slot = stack_alloc AtomicU32_SIZE
    EXPAND ATOMIC_U32_INIT u32_slot, 0
    EXPAND ATOMIC_U32_GET_MUT_PTR u32_mut, u32_slot
    store u32_mut+0, 4444 as u32
    EXPAND ATOMIC_U32_FROM_MUT_PTR u32_from, u32_mut
    EXPAND ATOMIC_U32_INTO_INNER u32_inner, u32_from

    i32_slot = stack_alloc AtomicI32_SIZE
    EXPAND ATOMIC_I32_INIT i32_slot, 0
    EXPAND ATOMIC_I32_GET_MUT_PTR i32_mut, i32_slot
    store i32_mut+0, -5555 as i32
    EXPAND ATOMIC_I32_FROM_MUT_PTR i32_from, i32_mut
    EXPAND ATOMIC_I32_INTO_INNER i32_inner, i32_from

    u64_slot = stack_alloc AtomicU64_SIZE
    EXPAND ATOMIC_U64_INIT u64_slot, 0
    EXPAND ATOMIC_U64_GET_MUT_PTR u64_mut, u64_slot
    store u64_mut+0, 666666 as u64
    EXPAND ATOMIC_U64_FROM_MUT_PTR u64_from, u64_mut
    EXPAND ATOMIC_U64_INTO_INNER u64_inner, u64_from

    i64_slot = stack_alloc AtomicI64_SIZE
    EXPAND ATOMIC_I64_INIT i64_slot, 0
    EXPAND ATOMIC_I64_GET_MUT_PTR i64_mut, i64_slot
    store i64_mut+0, -777777 as i64
    EXPAND ATOMIC_I64_FROM_MUT_PTR i64_from, i64_mut
    EXPAND ATOMIC_I64_INTO_INNER i64_inner, i64_from

    usize_slot = stack_alloc AtomicUsize_SIZE
    EXPAND ATOMIC_USIZE_INIT usize_slot, 0
    EXPAND ATOMIC_USIZE_GET_MUT_PTR usize_mut, usize_slot
    store usize_mut+0, 888888 as u64
    EXPAND ATOMIC_USIZE_FROM_MUT_PTR usize_from, usize_mut
    EXPAND ATOMIC_USIZE_INTO_INNER usize_inner, usize_from

    isize_slot = stack_alloc AtomicIsize_SIZE
    EXPAND ATOMIC_ISIZE_INIT isize_slot, 0
    EXPAND ATOMIC_ISIZE_GET_MUT_PTR isize_mut, isize_slot
    store isize_mut+0, -999999 as i64
    EXPAND ATOMIC_ISIZE_FROM_MUT_PTR isize_from, isize_mut
    EXPAND ATOMIC_ISIZE_INTO_INNER isize_inner, isize_from

    ptr_a = stack_alloc 8
    ptr_b = stack_alloc 8
    ptr_c = stack_alloc 8
    ptr_slot = stack_alloc AtomicPtr_SIZE
    EXPAND ATOMIC_PTR_INIT ptr_slot, ptr_a
    EXPAND ATOMIC_PTR_GET_MUT_PTR ptr_mut, ptr_slot
    store ptr_mut+0, ptr_b as ptr
    EXPAND ATOMIC_PTR_FROM_MUT_PTR ptr_from, ptr_mut
    EXPAND ATOMIC_PTR_INTO_INNER ptr_inner_before, ptr_from
    EXPAND ATOMIC_PTR_STORE ptr_from, ptr_c, seq_cst
    EXPAND ATOMIC_PTR_INTO_INNER ptr_inner_after, ptr_from

    bool_from_ok = eq bool_from, bool_slot
    bool_inner_ok = eq bool_inner, 1
    u8_from_ok = eq u8_from, u8_slot
    u8_inner_ok = eq u8_inner, 11
    i8_from_ok = eq i8_from, i8_slot
    i8_inner_ok = eq i8_inner, -7
    u16_from_ok = eq u16_from, u16_slot
    u16_inner_ok = eq u16_inner, 222
    i16_from_ok = eq i16_from, i16_slot
    i16_inner_ok = eq i16_inner, -333
    u32_from_ok = eq u32_from, u32_slot
    u32_inner_ok = eq u32_inner, 4444
    i32_from_ok = eq i32_from, i32_slot
    i32_inner_ok = eq i32_inner, -5555
    u64_from_ok = eq u64_from, u64_slot
    u64_inner_ok = eq u64_inner, 666666
    i64_from_ok = eq i64_from, i64_slot
    i64_inner_ok = eq i64_inner, -777777
    usize_from_ok = eq usize_from, usize_slot
    usize_inner_ok = eq usize_inner, 888888
    isize_from_ok = eq isize_from, isize_slot
    isize_inner_ok = eq isize_inner, -999999
    ptr_from_ok = eq ptr_from, ptr_slot
