@import "sa_std/core/slice.sa"
@import "sa_std/iter.sa"

@iter_is_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    out = eq rem, 0
    !rem
    return out

@iter_gt_four(value: u64) -> u64:
L_ENTRY:
    out = ugt value, 4
    return out

@iter_lt_ten(value: u64) -> u64:
L_ENTRY:
    out = ult value, 10
    return out

@iter_accumulate_tens(acc: u64, value: u64) -> u64:
L_ENTRY:
    scaled = mul value, 10
    out = add acc, scaled
    !scaled
    return out

@iter_compare_u64(left: u64, right: u64) -> i64:
L_ENTRY:
    is_less = ult left, right
    br is_less -> L_LESS, L_CHECK_GREATER
L_LESS:
    out_less = sub 0, 1
    !is_less
    !right
    !left
    return out_less
L_CHECK_GREATER:
    is_greater = ugt left, right
    br is_greater -> L_GREATER, L_EQUAL
L_GREATER:
    out_greater = add 0, 1
    !is_greater
    !is_less
    !right
    !left
    return out_greater
L_EQUAL:
    out_equal = add 0, 0
    !is_greater
    !is_less
    !right
    !left
    return out_equal

@iter_key_ones(value: u64) -> u64:
L_ENTRY:
    key = urem value, 10
    !value
    return key

@iter_for_each_noop(value: u64) -> u64:
L_ENTRY:
    !value
    return 0

@test "sa_std iter cursor double-ended macros"():
L_ENTRY:
    values = stack_alloc 40
    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND ITER_FROM_SLICE iter, slice
    EXPAND ITER_LEN len0, iter
    EXPAND ITER_PEEK_U64 peek0, iter
    EXPAND ITER_NEXT_U64 next1_ok, next1, iter
    EXPAND ITER_NEXT_BACK_U64 back1_ok, back1, iter
    EXPAND ITER_LEN len_after_edges, iter

    rem_slice = alloc Slice_SIZE
    EXPAND ITER_AS_SLICE_U64 rem_slice, iter
    rem_ptr = load rem_slice+Slice_ptr as ptr
    rem_len = load rem_slice+Slice_len as u64
    rem_first = load rem_ptr+0 as u64
    expected_rem_ptr = ptr_add values, 8
    EXPAND ITER_CLONE cloned, iter
    EXPAND ITER_NEXT_U64 clone_next_ok, clone_next, cloned
    EXPAND ITER_NEXT_U64 iter_next_ok, iter_next, iter
    EXPAND ITER_NEXT_BACK_U64 iter_back_ok, iter_back, iter
    EXPAND ITER_NEXT_BACK_U64 iter_empty_ok, iter_empty_value, iter
    EXPAND ITER_IS_EMPTY iter_empty, iter

    ok01 = eq len0, 5
    ok02 = eq peek0, 1
    ok03 = eq next1_ok, 1
    ok04 = eq next1, 1
    ok05 = eq back1_ok, 1
    ok06 = eq back1, 5
    ok07 = eq len_after_edges, 3
    ok08 = eq rem_ptr, expected_rem_ptr
    ok09 = eq rem_len, 3
    ok10 = eq rem_first, 2
    ok11 = eq clone_next_ok, 1
    ok12 = eq clone_next, 2
    ok13 = eq iter_next_ok, 1
    ok14 = eq iter_next, 2
    ok15 = eq iter_back_ok, 1
    ok16 = eq iter_back, 4
    ok17 = eq iter_empty_ok, 1
    ok18 = eq iter_empty_value, 3
    ok19 = eq iter_empty, 1

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
    all08 = and all07, ok09
    all09 = and all08, ok10
    all10 = and all09, ok11
    all11 = and all10, ok12
    all12 = and all11, ok13
    all13 = and all12, ok14
    all14 = and all13, ok15
    all15 = and all14, ok16
    all16 = and all15, ok17
    all17 = and all16, ok18
    all = and all17, ok19

    !len0
    !peek0
    !next1_ok
    !next1
    !back1_ok
    !back1
    !len_after_edges
    !rem_len
    !rem_first
    !clone_next_ok
    !clone_next
    !iter_next_ok
    !iter_next
    !iter_back_ok
    !iter_back
    !iter_empty_ok
    !iter_empty_value
    !iter_empty
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !all01
    !all02
    !all03
    !all04
    !all05
    !all06
    !all07
    !all08
    !all09
    !all10
    !all11
    !all12
    !all13
    !all14
    !all15
    !all16
    !all17
    !rem_ptr
    !expected_rem_ptr
    !cloned
    !rem_slice
    !iter
    !slice
    br all -> L_PASS, L_FAIL

L_FAIL:
    !all
    panic(940)

L_PASS:
    !all
    return 0

@test "sa_std iter comparison and callback macros"():
L_ENTRY:
    values = stack_alloc 40
    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    keyed = stack_alloc 32
    store keyed+0, 24 as u64
    store keyed+8, 31 as u64
    store keyed+16, 12 as u64
    store keyed+24, 49 as u64

    same = stack_alloc 40
    store same+0, 1 as u64
    store same+8, 2 as u64
    store same+16, 3 as u64
    store same+24, 4 as u64
    store same+32, 5 as u64

    greater_item = stack_alloc 40
    store greater_item+0, 1 as u64
    store greater_item+8, 2 as u64
    store greater_item+16, 9 as u64
    store greater_item+24, 4 as u64
    store greater_item+32, 5 as u64

    short = stack_alloc 24
    store short+0, 1 as u64
    store short+8, 2 as u64
    store short+16, 3 as u64

    slice = alloc Slice_SIZE
    keyed_slice = alloc Slice_SIZE
    same_slice = alloc Slice_SIZE
    greater_slice = alloc Slice_SIZE
    short_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5
    EXPAND SLICE_NEW keyed_slice, keyed, 4
    EXPAND SLICE_NEW same_slice, same, 5
    EXPAND SLICE_NEW greater_slice, greater_item, 5
    EXPAND SLICE_NEW short_slice, short, 3

    EXPAND ITER_FROM_SLICE for_each_iter, slice
    EXPAND ITER_FOR_EACH_U64 for_each_iter, @iter_for_each_noop
    EXPAND ITER_IS_EMPTY for_each_empty, for_each_iter

    EXPAND ITER_FROM_SLICE min_by_iter, slice
    EXPAND ITER_MIN_BY_U64 min_by_ok, min_by_value, min_by_iter, @iter_compare_u64

    EXPAND ITER_FROM_SLICE max_by_iter, slice
    EXPAND ITER_MAX_BY_U64 max_by_ok, max_by_value, max_by_iter, @iter_compare_u64

    EXPAND ITER_FROM_SLICE min_key_iter, keyed_slice
    EXPAND ITER_MIN_BY_KEY_U64 min_key_ok, min_key_value, min_key_iter, @iter_key_ones

    EXPAND ITER_FROM_SLICE max_key_iter, keyed_slice
    EXPAND ITER_MAX_BY_KEY_U64 max_key_ok, max_key_value, max_key_iter, @iter_key_ones

    EXPAND ITER_FROM_SLICE cmp_left_equal, slice
    EXPAND ITER_FROM_SLICE cmp_right_equal, same_slice
    EXPAND ITER_CMP_U64 cmp_equal, cmp_left_equal, cmp_right_equal

    EXPAND ITER_FROM_SLICE cmp_left_less_item, slice
    EXPAND ITER_FROM_SLICE cmp_right_less_item, greater_slice
    EXPAND ITER_CMP_U64 cmp_less_item, cmp_left_less_item, cmp_right_less_item

    EXPAND ITER_FROM_SLICE cmp_left_greater_item, greater_slice
    EXPAND ITER_FROM_SLICE cmp_right_greater_item, slice
    EXPAND ITER_CMP_U64 cmp_greater_item, cmp_left_greater_item, cmp_right_greater_item

    EXPAND ITER_FROM_SLICE cmp_left_short, short_slice
    EXPAND ITER_FROM_SLICE cmp_right_short, slice
    EXPAND ITER_CMP_U64 cmp_short, cmp_left_short, cmp_right_short

    EXPAND ITER_FROM_SLICE eq_left, slice
    EXPAND ITER_FROM_SLICE eq_right, same_slice
    EXPAND ITER_EQ_U64 eq_value, eq_left, eq_right

    EXPAND ITER_FROM_SLICE ne_left, slice
    EXPAND ITER_FROM_SLICE ne_right, greater_slice
    EXPAND ITER_NE_U64 ne_value, ne_left, ne_right

    EXPAND ITER_FROM_SLICE lt_left, slice
    EXPAND ITER_FROM_SLICE lt_right, greater_slice
    EXPAND ITER_LT_U64 lt_value, lt_left, lt_right

    EXPAND ITER_FROM_SLICE le_left, slice
    EXPAND ITER_FROM_SLICE le_right, same_slice
    EXPAND ITER_LE_U64 le_value, le_left, le_right

    EXPAND ITER_FROM_SLICE gt_left, greater_slice
    EXPAND ITER_FROM_SLICE gt_right, slice
    EXPAND ITER_GT_U64 gt_value, gt_left, gt_right

    EXPAND ITER_FROM_SLICE ge_left, slice
    EXPAND ITER_FROM_SLICE ge_right, same_slice
    EXPAND ITER_GE_U64 ge_value, ge_left, ge_right

    ok01 = eq for_each_empty, 1
    ok02 = eq min_by_ok, 1
    ok03 = eq min_by_value, 1
    ok04 = eq max_by_ok, 1
    ok05 = eq max_by_value, 5
    ok06 = eq min_key_ok, 1
    ok07 = eq min_key_value, 31
    ok08 = eq max_key_ok, 1
    ok09 = eq max_key_value, 49
    ok10 = eq cmp_equal, 0
    ok11 = slt cmp_less_item, 0
    ok12 = sgt cmp_greater_item, 0
    ok13 = slt cmp_short, 0
    ok14 = eq eq_value, 1
    ok15 = eq ne_value, 1
    ok16 = eq lt_value, 1
    ok17 = eq le_value, 1
    ok18 = eq gt_value, 1
    ok19 = eq ge_value, 1

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
    all08 = and all07, ok09
    all09 = and all08, ok10
    all10 = and all09, ok11
    all11 = and all10, ok12
    all12 = and all11, ok13
    all13 = and all12, ok14
    all14 = and all13, ok15
    all15 = and all14, ok16
    all16 = and all15, ok17
    all17 = and all16, ok18
    all = and all17, ok19

    !for_each_empty
    !min_by_ok
    !min_by_value
    !max_by_ok
    !max_by_value
    !min_key_ok
    !min_key_value
    !max_key_ok
    !max_key_value
    !cmp_equal
    !cmp_less_item
    !cmp_greater_item
    !cmp_short
    !eq_value
    !ne_value
    !lt_value
    !le_value
    !gt_value
    !ge_value
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !all01
    !all02
    !all03
    !all04
    !all05
    !all06
    !all07
    !all08
    !all09
    !all10
    !all11
    !all12
    !all13
    !all14
    !all15
    !all16
    !all17
    !ge_right
    !ge_left
    !gt_right
    !gt_left
    !le_right
    !le_left
    !lt_right
    !lt_left
    !ne_right
    !ne_left
    !eq_right
    !eq_left
    !cmp_right_short
    !cmp_left_short
    !cmp_right_greater_item
    !cmp_left_greater_item
    !cmp_right_less_item
    !cmp_left_less_item
    !cmp_right_equal
    !cmp_left_equal
    !max_key_iter
    !min_key_iter
    !max_by_iter
    !min_by_iter
    !for_each_iter
    !short_slice
    !greater_slice
    !same_slice
    !keyed_slice
    !slice
    br all -> L_PASS, L_FAIL

L_FAIL:
    !all
    panic(943)

L_PASS:
    !all
    return 0

@test "sa_std iter consuming adaptor macros"():
L_ENTRY:
    values = stack_alloc 40
    store values+0, 1 as u64
    store values+8, 2 as u64
    store values+16, 3 as u64
    store values+24, 4 as u64
    store values+32, 5 as u64

    slice = alloc Slice_SIZE
    EXPAND SLICE_NEW slice, values, 5

    EXPAND ITER_FROM_SLICE nth_iter, slice
    EXPAND ITER_NTH_U64 nth_ok, nth_value, nth_iter, 2
    EXPAND ITER_NEXT_U64 nth_next_ok, nth_next_value, nth_iter
    EXPAND ITER_NTH_U64 nth_miss_ok, nth_miss_value, nth_iter, 99
    EXPAND ITER_IS_EMPTY nth_empty, nth_iter

    EXPAND ITER_FROM_SLICE count_iter, slice
    EXPAND ITER_NEXT_U64 count_skip_ok, count_skip_value, count_iter
    EXPAND ITER_COUNT count_remaining, count_iter
    EXPAND ITER_IS_EMPTY count_empty, count_iter

    EXPAND ITER_FROM_SLICE last_iter, slice
    EXPAND ITER_LAST_U64 last_ok, last_value, last_iter
    EXPAND ITER_IS_EMPTY last_empty, last_iter

    EXPAND ITER_FROM_SLICE find_iter, slice
    EXPAND ITER_FIND_U64 find_ok, find_value, find_iter, @iter_gt_four
    EXPAND ITER_LEN find_remaining, find_iter

    EXPAND ITER_FROM_SLICE pos_iter, slice
    EXPAND ITER_POSITION_U64 pos_ok, pos_index, pos_iter, @iter_is_even
    EXPAND ITER_LEN pos_remaining, pos_iter

    EXPAND ITER_FROM_SLICE rpos_iter, slice
    EXPAND ITER_RPOSITION_U64 rpos_ok, rpos_index, rpos_iter, @iter_is_even
    EXPAND ITER_LEN rpos_remaining, rpos_iter

    EXPAND ITER_FROM_SLICE any_iter, slice
    EXPAND ITER_ANY_U64 any_value, any_iter, @iter_gt_four
    EXPAND ITER_LEN any_remaining, any_iter

    EXPAND ITER_FROM_SLICE all_iter, slice
    EXPAND ITER_ALL_U64 all_value, all_iter, @iter_lt_ten
    EXPAND ITER_LEN all_remaining, all_iter

    EXPAND ITER_FROM_SLICE fold_iter, slice
    EXPAND ITER_FOLD_U64 fold_value, fold_iter, 1, @iter_accumulate_tens

    EXPAND ITER_FROM_SLICE sum_iter, slice
    EXPAND ITER_SUM_U64 sum_value, sum_iter

    EXPAND ITER_FROM_SLICE product_iter, slice
    EXPAND ITER_PRODUCT_U64 product_value, product_iter

    EXPAND ITER_FROM_SLICE min_iter, slice
    EXPAND ITER_MIN_U64 min_ok, min_value, min_iter

    EXPAND ITER_FROM_SLICE max_iter, slice
    EXPAND ITER_MAX_U64 max_ok, max_value, max_iter

    empty_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW empty_slice, values, 0
    EXPAND ITER_FROM_SLICE empty_iter, empty_slice
    EXPAND ITER_MIN_U64 empty_min_ok, empty_min_value, empty_iter

    ok01 = eq nth_ok, 1
    ok02 = eq nth_value, 3
    ok03 = eq nth_next_ok, 1
    ok04 = eq nth_next_value, 4
    ok05 = eq nth_miss_ok, 0
    ok06 = eq nth_miss_value, 0
    ok07 = eq nth_empty, 1
    ok08 = eq count_skip_ok, 1
    ok09 = eq count_skip_value, 1
    ok10 = eq count_remaining, 4
    ok11 = eq count_empty, 1
    ok12 = eq last_ok, 1
    ok13 = eq last_value, 5
    ok14 = eq last_empty, 1
    ok15 = eq find_ok, 1
    ok16 = eq find_value, 5
    ok17 = eq find_remaining, 0
    ok18 = eq pos_ok, 1
    ok19 = eq pos_index, 1
    ok20 = eq pos_remaining, 3
    ok21 = eq rpos_ok, 1
    ok22 = eq rpos_index, 3
    ok23 = eq rpos_remaining, 3
    ok24 = eq any_value, 1
    ok25 = eq any_remaining, 0
    ok26 = eq all_value, 1
    ok27 = eq all_remaining, 0
    ok28 = eq fold_value, 151
    ok29 = eq sum_value, 15
    ok30 = eq product_value, 120
    ok31 = eq min_ok, 1
    ok32 = eq min_value, 1
    ok33 = eq max_ok, 1
    ok34 = eq max_value, 5
    ok35 = eq empty_min_ok, 0
    ok36 = eq empty_min_value, 0

    all01 = and ok01, ok02
    all02 = and all01, ok03
    all03 = and all02, ok04
    all04 = and all03, ok05
    all05 = and all04, ok06
    all06 = and all05, ok07
    all07 = and all06, ok08
