@import "sa_std/io.sa"
@import "sa_std/testing/assert.sai"

@test "sa_std io error and slice utility macros"():
L_ENTRY:
    EXPAND IO_ERROR_KIND_FROM_STATUS kind_eof, SA_IO_ERR_EOF
    EXPAND IO_ERROR_KIND_FROM_STATUS kind_would_block, SA_IO_ERR_WOULD_BLOCK
    EXPAND IO_ERROR_KIND_FROM_STATUS kind_interrupted, SA_IO_ERR_INTERRUPTED
    EXPAND IO_ERROR_KIND_FROM_STATUS kind_invalid, SA_IO_ERR_INVALID_HANDLE
    EXPAND IO_ERROR_KIND_FROM_STATUS kind_other, SA_IO_ERR_UNKNOWN
    EXPAND IO_ERROR_KIND_IS_RETRYABLE retry_would_block, kind_would_block
    EXPAND IO_ERROR_KIND_IS_RETRYABLE retry_interrupted, kind_interrupted
    EXPAND IO_ERROR_KIND_IS_RETRYABLE retry_eof, kind_eof

    data = stack_alloc 4
    store data+0, 65 as u8
    store data+1, 66 as u8
    io_slice = stack_alloc IoSlice_SIZE
    io_slice_empty = stack_alloc IoSlice_SIZE
    EXPAND IO_SLICE_NEW io_slice, data, 4
    EXPAND IO_SLICE_NEW io_slice_empty, data, 0
    EXPAND IO_SLICE_AS_PTR slice_ptr, io_slice
    EXPAND IO_SLICE_LEN slice_len, io_slice
    EXPAND IO_SLICE_IS_EMPTY slice_is_empty, io_slice
    EXPAND IO_SLICE_IS_EMPTY slice_empty_is_empty, io_slice_empty

    mut_slice = stack_alloc IoSliceMut_SIZE
    EXPAND IO_SLICE_MUT_NEW mut_slice, data, 4
    EXPAND IO_SLICE_MUT_AS_PTR mut_ptr, mut_slice
    EXPAND IO_SLICE_MUT_LEN mut_len, mut_slice
    EXPAND IO_SLICE_MUT_IS_EMPTY mut_empty, mut_slice

    ok_kind_eof = eq kind_eof, IO_ERROR_KIND_UNEXPECTED_EOF
    ok_kind_wb = eq kind_would_block, IO_ERROR_KIND_WOULD_BLOCK
    ok_kind_int = eq kind_interrupted, IO_ERROR_KIND_INTERRUPTED
    ok_kind_invalid = eq kind_invalid, IO_ERROR_KIND_INVALID_INPUT
    ok_kind_other = eq kind_other, IO_ERROR_KIND_OTHER
    ok_retry_wb = eq retry_would_block, 1
    ok_retry_int = eq retry_interrupted, 1
    ok_retry_eof = eq retry_eof, 0
    ok_slice_ptr = eq slice_ptr, data
    ok_slice_len = eq slice_len, 4
    ok_slice_empty = eq slice_is_empty, 0
    ok_slice_empty2 = eq slice_empty_is_empty, 1
    ok_mut_ptr = eq mut_ptr, data
    ok_mut_len = eq mut_len, 4
    ok_mut_empty = eq mut_empty, 0
    ok01 = and ok_kind_eof, ok_kind_wb
    ok02 = and ok01, ok_kind_int
    ok03 = and ok02, ok_kind_invalid
    ok04 = and ok03, ok_kind_other
    ok05 = and ok04, ok_retry_wb
    ok06 = and ok05, ok_retry_int
    ok07 = and ok06, ok_retry_eof
    ok08 = and ok07, ok_slice_ptr
    ok09 = and ok08, ok_slice_len
    ok10 = and ok09, ok_slice_empty
    ok11 = and ok10, ok_slice_empty2
    ok12 = and ok11, ok_mut_ptr
    ok13 = and ok12, ok_mut_len
    ok = and ok13, ok_mut_empty

    !kind_eof
    !kind_would_block
    !kind_interrupted
    !kind_invalid
    !kind_other
    !retry_would_block
    !retry_interrupted
    !retry_eof
    !slice_ptr
    !slice_len
    !slice_is_empty
    !slice_empty_is_empty
    !mut_ptr
    !mut_len
    !mut_empty
    !ok_kind_eof
    !ok_kind_wb
    !ok_kind_int
    !ok_kind_invalid
    !ok_kind_other
    !ok_retry_wb
    !ok_retry_int
    !ok_retry_eof
    !ok_slice_ptr
    !ok_slice_len
    !ok_slice_empty
    !ok_slice_empty2
    !ok_mut_ptr
    !ok_mut_len
    !ok_mut_empty
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(997)

L_PASS:
    return 0

@test "sa_std io cursor empty repeat sink macros"():
L_ENTRY:
    data = stack_alloc 8
    store data+0, 1 as u8
    store data+1, 2 as u8
    store data+2, 3 as u8
    store data+3, 4 as u8
    dst = stack_alloc 8
    src = stack_alloc 4
    store src+0, 90 as u8
    store src+1, 91 as u8
    store src+2, 0 as u8
    store src+3, 0 as u8

    cursor = stack_alloc IoCursor_SIZE
    EXPAND IO_CURSOR_NEW cursor, data, 4
    cursor_slice = stack_alloc IoSlice_SIZE
    cursor_mut_slice = stack_alloc IoSliceMut_SIZE
    EXPAND IO_CURSOR_AS_PTR cursor_ptr, cursor
    EXPAND IO_CURSOR_LEN cursor_len, cursor
    EXPAND IO_CURSOR_IS_EMPTY cursor_empty, cursor
    EXPAND IO_CURSOR_AS_SLICE cursor_slice, cursor
    EXPAND IO_CURSOR_AS_MUT_SLICE cursor_mut_slice, cursor
    EXPAND IO_CURSOR_INTO_INNER inner_ptr, inner_len, cursor
    EXPAND IO_SLICE_AS_PTR cursor_slice_ptr, cursor_slice
    EXPAND IO_SLICE_LEN cursor_slice_len, cursor_slice
    EXPAND IO_SLICE_MUT_AS_PTR cursor_mut_ptr, cursor_mut_slice
    EXPAND IO_SLICE_MUT_LEN cursor_mut_len, cursor_mut_slice
    EXPAND IO_CURSOR_POSITION pos0, cursor
    EXPAND IO_CURSOR_REMAINING rem0, cursor
    EXPAND IO_CURSOR_READ read_len, cursor, dst, 2
    EXPAND IO_CURSOR_POSITION pos1, cursor
    EXPAND IO_CURSOR_REMAINING rem1, cursor
    read0 = load dst+0 as u8
    read1 = load dst+1 as u8
    EXPAND IO_CURSOR_SEEK_START seek_pos, cursor, 1
    EXPAND IO_CURSOR_WRITE write_len, cursor, src, 4
    EXPAND IO_CURSOR_POSITION pos2, cursor
    EXPAND IO_CURSOR_SEEK_CURRENT seek_current_back, cursor, -2
    EXPAND IO_CURSOR_POSITION pos3, cursor
    EXPAND IO_CURSOR_SEEK_CURRENT seek_current_forward, cursor, 1
    EXPAND IO_CURSOR_SEEK_END seek_end_back, cursor, -1
    EXPAND IO_CURSOR_SEEK_END seek_end_forward, cursor, 2
    d1 = load data+1 as u8
    d2 = load data+2 as u8
    d3 = load data+3 as u8

    EXPAND IO_EMPTY_READ empty_len, dst, 4
    EXPAND IO_EMPTY_SEEK empty_pos

    take_cursor = stack_alloc IoCursor_SIZE
    take = stack_alloc IoTake_SIZE
    take_data = stack_alloc 4
    take_dst = stack_alloc 4
    store take_data+0, 1 as u8
    store take_data+1, 2 as u8
    store take_data+2, 3 as u8
    store take_data+3, 4 as u8
    EXPAND IO_CURSOR_NEW take_cursor, take_data, 4
    EXPAND IO_TAKE_NEW take, take_cursor, 2
    EXPAND IO_TAKE_LIMIT take_limit0, take
    EXPAND IO_TAKE_INTO_INNER take_inner, take
    EXPAND IO_TAKE_READ take_read_len, take, take_dst, 4
    EXPAND IO_TAKE_LIMIT take_limit1, take
    EXPAND IO_CURSOR_POSITION take_pos, take_cursor
    EXPAND IO_TAKE_READ take_read_len2, take, take_dst, 4
    take0 = load take_dst+0 as u8
    take1 = load take_dst+1 as u8

    repeat = stack_alloc IoRepeat_SIZE
    EXPAND IO_REPEAT_NEW repeat, 42
    EXPAND IO_REPEAT_READ repeat_len, repeat, dst, 3
    repeat0 = load dst+0 as u8
    repeat1 = load dst+1 as u8
    repeat2 = load dst+2 as u8

    EXPAND IO_SINK_WRITE sink_len, src, 2
    slice = stack_alloc IoSlice_SIZE
    copy_dst = stack_alloc 4
    EXPAND IO_SLICE_NEW slice, src, 2
    EXPAND IO_COPY_SLICE copy_len, copy_dst, slice
    copy0 = load copy_dst+0 as u8
    copy1 = load copy_dst+1 as u8

    ok_pos0 = eq pos0, 0
    ok_cursor_ptr = eq cursor_ptr, data
    ok_cursor_len = eq cursor_len, 4
    ok_cursor_empty = eq cursor_empty, 0
    ok_inner_ptr = eq inner_ptr, data
    ok_inner_len = eq inner_len, 4
    ok_cursor_slice_ptr = eq cursor_slice_ptr, data
    ok_cursor_slice_len = eq cursor_slice_len, 4
    ok_cursor_mut_ptr = eq cursor_mut_ptr, data
    ok_cursor_mut_len = eq cursor_mut_len, 4
    ok_rem0 = eq rem0, 4
    ok_read_len = eq read_len, 2
    ok_pos1 = eq pos1, 2
    ok_rem1 = eq rem1, 2
    ok_read0 = eq read0, 1
    ok_read1 = eq read1, 2
    ok_seek = eq seek_pos, 1
    ok_write_len = eq write_len, 3
    ok_pos2 = eq pos2, 4
    ok_seek_current_back = eq seek_current_back, 2
    ok_pos3 = eq pos3, 2
    ok_seek_current_forward = eq seek_current_forward, 3
    ok_seek_end_back = eq seek_end_back, 3
    ok_seek_end_forward = eq seek_end_forward, 6
    ok_d1 = eq d1, 90
    ok_d2 = eq d2, 91
    ok_d3 = eq d3, 0
    ok_empty_len = eq empty_len, 0
    ok_empty_pos = eq empty_pos, 0
    ok_take_limit0 = eq take_limit0, 2
    ok_take_inner = eq take_inner, take_cursor
    ok_take_read_len = eq take_read_len, 2
    ok_take_limit1 = eq take_limit1, 0
    ok_take_pos = eq take_pos, 2
    ok_take_read_len2 = eq take_read_len2, 0
    ok_take0 = eq take0, 1
    ok_take1 = eq take1, 2
    ok_repeat_len = eq repeat_len, 3
    ok_repeat0 = eq repeat0, 42
    ok_repeat1 = eq repeat1, 42
    ok_repeat2 = eq repeat2, 42
    ok_sink_len = eq sink_len, 2
    ok_copy_len = eq copy_len, 2
    ok_copy0 = eq copy0, 90
    ok_copy1 = eq copy1, 91
    ok01 = and ok_pos0, ok_cursor_ptr
    ok02 = and ok01, ok_cursor_len
    ok03 = and ok02, ok_cursor_empty
    ok04 = and ok03, ok_inner_ptr
    ok05 = and ok04, ok_inner_len
    ok06 = and ok05, ok_cursor_slice_ptr
    ok07 = and ok06, ok_cursor_slice_len
    ok08 = and ok07, ok_cursor_mut_ptr
    ok09 = and ok08, ok_cursor_mut_len
    ok10 = and ok09, ok_rem0
    ok11 = and ok10, ok_read_len
    ok12 = and ok11, ok_pos1
    ok13 = and ok12, ok_rem1
    ok14 = and ok13, ok_read0
    ok15 = and ok14, ok_read1
    ok16 = and ok15, ok_seek
    ok17 = and ok16, ok_write_len
    ok18 = and ok17, ok_pos2
    ok19 = and ok18, ok_seek_current_back
    ok20 = and ok19, ok_pos3
    ok21 = and ok20, ok_seek_current_forward
    ok22 = and ok21, ok_seek_end_back
    ok23 = and ok22, ok_seek_end_forward
    ok24 = and ok23, ok_d1
    ok25 = and ok24, ok_d2
    ok26 = and ok25, ok_d3
    ok27 = and ok26, ok_empty_len
    ok28 = and ok27, ok_empty_pos
    ok29 = and ok28, ok_take_limit0
    ok30 = and ok29, ok_take_inner
    ok31 = and ok30, ok_take_read_len
    ok32 = and ok31, ok_take_limit1
    ok33 = and ok32, ok_take_pos
    ok34 = and ok33, ok_take_read_len2
    ok35 = and ok34, ok_take0
    ok36 = and ok35, ok_take1
    ok37 = and ok36, ok_repeat_len
    ok38 = and ok37, ok_repeat0
    ok39 = and ok38, ok_repeat1
    ok40 = and ok39, ok_repeat2
    ok41 = and ok40, ok_sink_len
    ok42 = and ok41, ok_copy_len
    ok43 = and ok42, ok_copy0
    ok = and ok43, ok_copy1

    call @sa_assert_eq_i64(take_limit0, 2, 9981)
    call @sa_assert_eq_i64(ok_take_inner, 1, 9982)
    call @sa_assert_eq_i64(take_read_len, 2, 9983)
    call @sa_assert_eq_i64(take_limit1, 0, 9984)
    call @sa_assert_eq_i64(take_pos, 2, 9985)
    call @sa_assert_eq_i64(take_read_len2, 0, 9986)
    call @sa_assert_eq_i64(take0, 1, 9987)
    call @sa_assert_eq_i64(take1, 2, 9988)

    !pos0
    !cursor_ptr
    !cursor_len
    !cursor_empty
    !inner_ptr
    !inner_len
    !cursor_slice_ptr
    !cursor_slice_len
    !cursor_mut_ptr
    !cursor_mut_len
    !rem0
    !read_len
    !pos1
    !rem1
    !read0
    !read1
    !seek_pos
    !write_len
    !pos2
    !seek_current_back
    !pos3
    !seek_current_forward
    !seek_end_back
    !seek_end_forward
    !d1
    !d2
    !d3
    !empty_len
    !empty_pos
    !take_limit0
    !take_inner
    !take_read_len
    !take_limit1
    !take_pos
    !take_read_len2
    !take0
    !take1
    !repeat_len
    !repeat0
    !repeat1
    !repeat2
    !sink_len
    !copy_len
    !copy0
    !copy1
    !ok_pos0
    !ok_cursor_ptr
    !ok_cursor_len
    !ok_cursor_empty
    !ok_inner_ptr
    !ok_inner_len
    !ok_cursor_slice_ptr
    !ok_cursor_slice_len
    !ok_cursor_mut_ptr
    !ok_cursor_mut_len
    !ok_rem0
    !ok_read_len
    !ok_pos1
    !ok_rem1
    !ok_read0
    !ok_read1
    !ok_seek
    !ok_write_len
    !ok_pos2
    !ok_seek_current_back
    !ok_pos3
    !ok_seek_current_forward
    !ok_seek_end_back
    !ok_seek_end_forward
    !ok_d1
    !ok_d2
    !ok_d3
    !ok_empty_len
    !ok_empty_pos
    !ok_take_limit0
    !ok_take_inner
    !ok_take_read_len
    !ok_take_limit1
    !ok_take_pos
    !ok_take_read_len2
    !ok_take0
    !ok_take1
    !ok_repeat_len
    !ok_repeat0
    !ok_repeat1
    !ok_repeat2
    !ok_sink_len
    !ok_copy_len
    !ok_copy0
    !ok_copy1
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !ok28
    !ok29
    !ok30
    !ok31
    !ok32
    !ok33
    !ok34
    !ok35
    !ok36
    !ok37
    !ok38
    !ok39
    !ok40
    !ok41
    !ok42
    !ok43

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(998)

L_PASS:
    return 0
