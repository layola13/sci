@import "sa_std/sync/condvar.sa"
@import "sa_std/sync/mutex.sa"

@test "sa_std condvar wait_timeout_ms"():
L_ENTRY:
    EXPAND CONDVAR_NEW cond
    EXPAND MUTEX_NEW mutex
    EXPAND MUTEX_LOCK mutex
    EXPAND CONDVAR_WAIT_TIMEOUT_MS notified, cond, mutex, 1
    EXPAND MUTEX_UNLOCK mutex
    ok = eq notified, 0
    !notified
    br ok -> L_OK, L_FAIL
L_OK:
    !ok
    return 0
L_FAIL:
    !ok
    panic(10893)
