@import "sa_std/mem.sa"

@test "sa_std mem primitive layout macros"():
L_ENTRY:
    EXPAND MEM_SIZE_OF_BOOL size_bool
    EXPAND MEM_SIZE_OF_U8 size_u8
    EXPAND MEM_SIZE_OF_U16 size_u16
    EXPAND MEM_SIZE_OF_U32 size_u32
    EXPAND MEM_SIZE_OF_U64 size_u64
    EXPAND MEM_SIZE_OF_USIZE size_usize
    EXPAND MEM_SIZE_OF_I8 size_i8
    EXPAND MEM_SIZE_OF_I16 size_i16
    EXPAND MEM_SIZE_OF_I32 size_i32
    EXPAND MEM_SIZE_OF_I64 size_i64
    EXPAND MEM_SIZE_OF_ISIZE size_isize

    EXPAND MEM_ALIGN_OF_BOOL align_bool
    EXPAND MEM_ALIGN_OF_U8 align_u8
    EXPAND MEM_ALIGN_OF_U16 align_u16
    EXPAND MEM_ALIGN_OF_U32 align_u32
    EXPAND MEM_ALIGN_OF_U64 align_u64
    EXPAND MEM_ALIGN_OF_USIZE align_usize
    EXPAND MEM_ALIGN_OF_I8 align_i8
    EXPAND MEM_ALIGN_OF_I16 align_i16
    EXPAND MEM_ALIGN_OF_I32 align_i32
    EXPAND MEM_ALIGN_OF_I64 align_i64
    EXPAND MEM_ALIGN_OF_ISIZE align_isize

    ok_size_bool = eq size_bool, 1
    ok_size_u8 = eq size_u8, 1
    ok_size_u16 = eq size_u16, 2
    ok_size_u32 = eq size_u32, 4
    ok_size_u64 = eq size_u64, 8
    ok_size_usize = eq size_usize, 8
    ok_size_i8 = eq size_i8, 1
    ok_size_i16 = eq size_i16, 2
    ok_size_i32 = eq size_i32, 4
    ok_size_i64 = eq size_i64, 8
    ok_size_isize = eq size_isize, 8

    ok_align_bool = eq align_bool, 1
    ok_align_u8 = eq align_u8, 1
    ok_align_u16 = eq align_u16, 2
    ok_align_u32 = eq align_u32, 4
    ok_align_u64 = eq align_u64, 8
    ok_align_usize = eq align_usize, 8
    ok_align_i8 = eq align_i8, 1
    ok_align_i16 = eq align_i16, 2
    ok_align_i32 = eq align_i32, 4
    ok_align_i64 = eq align_i64, 8
    ok_align_isize = eq align_isize, 8

    ok01 = and ok_size_bool, ok_size_u8
    ok02 = and ok01, ok_size_u16
    ok03 = and ok02, ok_size_u32
    ok04 = and ok03, ok_size_u64
    ok05 = and ok04, ok_size_usize
    ok06 = and ok05, ok_size_i8
    ok07 = and ok06, ok_size_i16
    ok08 = and ok07, ok_size_i32
    ok09 = and ok08, ok_size_i64
    ok10 = and ok09, ok_size_isize
    ok11 = and ok10, ok_align_bool
    ok12 = and ok11, ok_align_u8
    ok13 = and ok12, ok_align_u16
    ok14 = and ok13, ok_align_u32
    ok15 = and ok14, ok_align_u64
    ok16 = and ok15, ok_align_usize
    ok17 = and ok16, ok_align_i8
    ok18 = and ok17, ok_align_i16
    ok19 = and ok18, ok_align_i32
    ok20 = and ok19, ok_align_i64
    ok = and ok20, ok_align_isize

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(930)

L_PASS:
    return 0

@test "sa_std mem maybe-uninit and manually-drop u64 macros"():
L_ENTRY:
    maybe = stack_alloc MaybeUninitU64_SIZE
    maybe_zero = stack_alloc MaybeUninitU64_SIZE
    manual = stack_alloc ManuallyDropU64_SIZE
    manual_drop = stack_alloc ManuallyDropU64_SIZE

    EXPAND MEM_NEEDS_DROP_PRIMITIVE needs_drop
    EXPAND MEM_FORGET_U64 123

    EXPAND MAYBE_UNINIT_U64_UNINIT maybe
    EXPAND MAYBE_UNINIT_U64_WRITE maybe, 55
    EXPAND MAYBE_UNINIT_U64_AS_PTR maybe_ptr, maybe
    EXPAND MAYBE_UNINIT_U64_AS_MUT_PTR maybe_mut_ptr, maybe
    store maybe_mut_ptr+0, 66 as u64
    EXPAND MAYBE_UNINIT_U64_ASSUME_INIT maybe_value, maybe
    EXPAND MAYBE_UNINIT_U64_ASSUME_INIT_READ maybe_read, maybe
    EXPAND MAYBE_UNINIT_U64_ZEROED maybe_zero
    EXPAND MAYBE_UNINIT_U64_ASSUME_INIT maybe_zero_value, maybe_zero
    EXPAND MAYBE_UNINIT_U64_NEW maybe, 77
    EXPAND MAYBE_UNINIT_U64_ASSUME_INIT maybe_new_value, maybe

    EXPAND MANUALLY_DROP_U64_NEW manual, 88
    EXPAND MANUALLY_DROP_U64_AS_PTR manual_ptr, manual
    EXPAND MANUALLY_DROP_U64_AS_MUT_PTR manual_mut_ptr, manual
    store manual_mut_ptr+0, 99 as u64
    EXPAND MANUALLY_DROP_U64_INTO_INNER manual_inner, manual
    EXPAND MANUALLY_DROP_U64_TAKE manual_taken, manual
    manual_after_take = load manual+ManuallyDropU64_value as u64
    EXPAND MANUALLY_DROP_U64_NEW manual_drop, 111
    EXPAND MANUALLY_DROP_U64_DROP manual_drop
    manual_after_drop = load manual_drop+ManuallyDropU64_value as u64

    ok_needs_drop = eq needs_drop, 0
    ok_maybe_ptr = eq maybe_ptr, maybe
    ok_maybe_mut_ptr = eq maybe_mut_ptr, maybe
    ok_maybe_value = eq maybe_value, 66
    ok_maybe_read = eq maybe_read, 66
    ok_maybe_zero = eq maybe_zero_value, 0
    ok_maybe_new = eq maybe_new_value, 77
    ok_manual_ptr = eq manual_ptr, manual
    ok_manual_mut_ptr = eq manual_mut_ptr, manual
    ok_manual_inner = eq manual_inner, 99
    ok_manual_taken = eq manual_taken, 99
    ok_manual_after_take = eq manual_after_take, 0
    ok_manual_after_drop = eq manual_after_drop, 0

    ok01 = and ok_needs_drop, ok_maybe_ptr
    ok02 = and ok01, ok_maybe_mut_ptr
    ok03 = and ok02, ok_maybe_value
    ok04 = and ok03, ok_maybe_read
    ok05 = and ok04, ok_maybe_zero
    ok06 = and ok05, ok_maybe_new
    ok07 = and ok06, ok_manual_ptr
    ok08 = and ok07, ok_manual_mut_ptr
    ok09 = and ok08, ok_manual_inner
    ok10 = and ok09, ok_manual_taken
    ok11 = and ok10, ok_manual_after_take
    ok = and ok11, ok_manual_after_drop

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(932)

L_PASS:
    return 0

@test "sa_std mem swap replace take macros"():
L_ENTRY:
    lhs = stack_alloc 8
    rhs = stack_alloc 8
    store lhs+0, 11 as u64
    store rhs+0, 22 as u64

    EXPAND MEM_SWAP_U64 lhs, rhs
    lhs_after_swap = load lhs+0 as u64
    rhs_after_swap = load rhs+0 as u64

    EXPAND MEM_REPLACE_U64 old_lhs, lhs, 33
    lhs_after_replace = load lhs+0 as u64

    EXPAND MEM_TAKE_U64 old_rhs, rhs
    rhs_after_take = load rhs+0 as u64

    ok_lhs_swap = eq lhs_after_swap, 22
    ok_rhs_swap = eq rhs_after_swap, 11
    ok_replace_old = eq old_lhs, 22
    ok_replace_new = eq lhs_after_replace, 33
    ok_take_old = eq old_rhs, 11
    ok_take_new = eq rhs_after_take, 0

    ok01 = and ok_lhs_swap, ok_rhs_swap
    ok02 = and ok01, ok_replace_old
    ok03 = and ok02, ok_replace_new
    ok04 = and ok03, ok_take_old
    ok = and ok04, ok_take_new

    br ok -> L_PASS, L_FAIL

L_FAIL:
    panic(931)

L_PASS:
    return 0
