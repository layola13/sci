@import "sa_std/process.sa"

@const TRUE_BIN = utf8:"/bin/true"
@const TRUE_ARG = utf8:"ignored"
@const SH_BIN = utf8:"/bin/sh"
@const SH_FLAG = utf8:"-c"
@const SLEEP_CMD = utf8:"sleep 5"
@const SLEEP_BIN = utf8:"/bin/sleep"
@const SLEEP_ARG = utf8:"5"
@const CUSTOM_ARG0 = utf8:"sa-custom-argv0"
@const ARG0_CMD = utf8:"printf '%s' \"$0\""
@const PGID_CMD = utf8:"test $(awk '{print $5}' /proc/$$/stat) = $$"
@const SID_CMD = utf8:"test $(awk '{print $6}' /proc/$$/stat) = $$"

#def TRUE_BIN_LEN = 9
#def TRUE_ARG_LEN = 7
#def TRUE_ARGV2_SIZE = 32
#def SH_BIN_LEN = 7
#def SH_FLAG_LEN = 2
#def SLEEP_CMD_LEN = 7
#def SLEEP_BIN_LEN = 10
#def SLEEP_ARG_LEN = 1
#def CUSTOM_ARG0_LEN = 15
#def ARG0_CMD_LEN = 16
#def PGID_CMD_LEN = 43
#def SID_CMD_LEN = 43
#def SH_ARGV3_SIZE = 48
#def SIG_CHECK_PROCESS = 0
#def SIG_KILL_PROCESS = 9

@test "sa_std process argv and run macros"():
L_ENTRY:
    EXPAND PROCESS_ID pid
    EXPAND PROCESS_PARENT_ID parent_pid
    argv = stack_alloc TRUE_ARGV2_SIZE
    argv0 = stack_alloc Slice_SIZE
    store argv0+Slice_ptr, &TRUE_BIN as ptr
    store argv0+Slice_len, TRUE_BIN_LEN as u64
    EXPAND PROCESS_ARGV_SET_SLICE argv, 0, argv0
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, TRUE_ARG, TRUE_ARG_LEN
    EXPAND PROCESS_ARGV_DATA arg0_ptr, argv, 0
    EXPAND PROCESS_ARGV_LEN arg0_len, argv, 0
    EXPAND PROCESS_ARGV_DATA arg1_ptr, argv, 1
    EXPAND PROCESS_ARGV_LEN arg1_len, argv, 1
    arg0_first = load arg0_ptr+0 as u8
    arg1_first = load arg1_ptr+0 as u8

    EXPAND PROCESS_RUN run_status, process, argv, 2
    EXPAND PROCESS_STATUS_IS_OK run_ok, run_status
    br run_ok -> L_WAIT, L_FAIL

L_WAIT:
    EXPAND PROCESS_WAIT wait_status, code, process
    EXPAND PROCESS_STATUS_IS_OK wait_ok, wait_status
    EXPAND PROCESS_EXIT_SUCCESS exit_ok, code
    EXPAND PROCESS_CLOSE close_status, process
    EXPAND PROCESS_STATUS_IS_OK close_ok, close_status

    ok_pid = ne pid, 0
    ok_parent_pid = ne parent_pid, 0
    ok_arg_len = eq arg0_len, TRUE_BIN_LEN
    ok_arg_first = eq arg0_first, 47
    ok_arg1_len = eq arg1_len, TRUE_ARG_LEN
    ok_arg1_first = eq arg1_first, 105
    ok00 = and ok_pid, ok_parent_pid
    ok01 = and ok00, ok_arg_len
    ok02 = and ok01, ok_arg_first
    ok03 = and ok02, ok_arg1_len
    ok04 = and ok03, ok_arg1_first
    ok05 = and ok04, wait_ok
    ok06 = and ok05, wait_ok
    ok07 = and ok06, exit_ok
    ok = and ok07, close_ok

    !pid
    !parent_pid
    !arg0_ptr
    !arg0_len
    !arg1_ptr
    !arg1_len
    !arg0_first
    !arg1_first
    !run_status
    !process
    !run_ok
    !wait_status
    !code
    !wait_ok
    !exit_ok
    !close_status
    !close_ok
    !ok_pid
    !ok_parent_pid
    !ok_arg_len
    !ok_arg_first
    !ok_arg1_len
    !ok_arg1_first
    !ok00
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07

    br ok -> L_PASS, L_FAIL_AFTER_WAIT

L_FAIL:
    !pid
    !parent_pid
    !arg0_ptr
    !arg0_len
    !arg1_ptr
    !arg1_len
    !arg0_first
    !arg1_first
    !run_status
    !process
    !run_ok
    panic(1001)

L_FAIL_AFTER_WAIT:
    !ok
    panic(1002)

L_PASS:
    !ok
    return 0

@test "sa_std process exit status and output wrapper macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV2_SIZE
    output = stack_alloc ProcessOutput_SIZE
    exit_status = stack_alloc ProcessExitStatus_SIZE
    argv0 = stack_alloc Slice_SIZE
    store argv0+Slice_ptr, &TRUE_BIN as ptr
    store argv0+Slice_len, TRUE_BIN_LEN as u64
    EXPAND PROCESS_ARGV_SET_SLICE argv, 0, argv0
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, TRUE_ARG, TRUE_ARG_LEN

    EXPAND PROCESS_EXIT_STATUS_NEW exit_status, 0
    EXPAND PROCESS_EXIT_STATUS_CODE exit_code0, exit_status
    EXPAND PROCESS_EXIT_STATUS_RAW exit_raw0, exit_status
    EXPAND PROCESS_EXIT_STATUS_SUCCESS exit_ok0, exit_status
    EXPAND PROCESS_EXIT_STATUS_SIGNAL exit_signal0, exit_status
    EXPAND PROCESS_EXIT_STATUS_COREDUMPED exit_core0, exit_status
    EXPAND PROCESS_EXIT_STATUS_STOPPED_SIGNAL exit_stopped0, exit_status
    EXPAND PROCESS_EXIT_STATUS_CONTINUED exit_continued0, exit_status

    EXPAND PROCESS_EXEC_CAPTURE_OUTPUT capture_status, output, argv, 2
    EXPAND PROCESS_STATUS_IS_OK capture_ok, capture_status
    br capture_ok -> L_CAPTURE_OK, L_FAIL

L_CAPTURE_OK:
    EXPAND PROCESS_OUTPUT_STATUS_PTR output_status_ptr, output
    EXPAND PROCESS_EXIT_STATUS_CODE output_code, output_status_ptr
    EXPAND PROCESS_EXIT_STATUS_SUCCESS output_exit_ok, output_status_ptr
    EXPAND PROCESS_OUTPUT_STDOUT_BUFFER stdout_buffer, output
    EXPAND PROCESS_OUTPUT_STDERR_BUFFER stderr_buffer, output
    EXPAND PROCESS_OUTPUT_STDOUT_DATA stdout_ptr, output
    EXPAND PROCESS_OUTPUT_STDERR_DATA stderr_ptr, output
    EXPAND PROCESS_OUTPUT_STDOUT_LEN stdout_len, output
    EXPAND PROCESS_OUTPUT_STDERR_LEN stderr_len, output
    EXPAND PROCESS_OUTPUT_FREE free_status, output
    EXPAND PROCESS_STATUS_IS_OK free_ok, free_status

    ok_exit_code0 = eq exit_code0, 0
    ok_exit_raw0 = eq exit_raw0, 0
    ok_exit_signal0 = eq exit_signal0, -1
    ok_exit_core0 = eq exit_core0, 0
    ok_exit_stopped0 = eq exit_stopped0, -1
    ok_exit_continued0 = eq exit_continued0, 0
    ok_output_code = eq output_code, 0
    ok_stdout_len = eq stdout_len, 0
    ok_stderr_len = eq stderr_len, 0
    ok_stdout_buffer = ne stdout_buffer, 0
    ok_stderr_buffer = ne stderr_buffer, 0

    ok01 = and ok_exit_code0, exit_ok0
    ok02 = and ok01, ok_exit_raw0
    ok03 = and ok02, ok_exit_signal0
    ok04 = and ok03, ok_exit_core0
    ok05 = and ok04, ok_exit_stopped0
    ok06 = and ok05, ok_exit_continued0
    ok07 = and ok06, capture_ok
    ok08 = and ok07, ok_output_code
    ok09 = and ok08, output_exit_ok
    ok10 = and ok09, ok_stdout_len
    ok11 = and ok10, ok_stderr_len
    ok12 = and ok11, ok_stdout_buffer
    ok13 = and ok12, ok_stderr_buffer
    ok = and ok13, free_ok

    !exit_code0
    !exit_raw0
    !exit_ok0
    !exit_signal0
    !exit_core0
    !exit_stopped0
    !exit_continued0
    !capture_status
    !capture_ok
    !output_status_ptr
    !output_code
    !output_exit_ok
    !stdout_buffer
    !stderr_buffer
    !stdout_ptr
    !stderr_ptr
    !stdout_len
    !stderr_len
    !free_status
    !free_ok
    !ok_exit_code0
    !ok_exit_raw0
    !ok_exit_signal0
    !ok_exit_core0
    !ok_exit_stopped0
    !ok_exit_continued0
    !ok_output_code
    !ok_stdout_len
    !ok_stderr_len
    !ok_stdout_buffer
    !ok_stderr_buffer
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13

    br ok -> L_PASS2, L_FAIL2

L_FAIL:
    !capture_status
    !capture_ok
    panic(1003)

L_FAIL2:
    !ok
    panic(1004)

L_PASS2:
    !ok
    return 0

@test "sa_std process command ext macros"():
L_ENTRY:
    argv = stack_alloc SH_ARGV3_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, SH_BIN, SH_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, SH_FLAG, SH_FLAG_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 2, ARG0_CMD, ARG0_CMD_LEN

    EXPAND PROCESS_RUN_ARG0 arg0_status, arg0_process, argv, 3, CUSTOM_ARG0, CUSTOM_ARG0_LEN
    arg0_status_ok = eq arg0_status, SA_PROCESS_OK
    arg0_process_ok = ne arg0_process, 0
    arg0_spawn_ok = and arg0_status_ok, arg0_process_ok
    br arg0_spawn_ok -> L_ARG0_WAIT, L_FAIL_ARG0_SPAWN

L_FAIL_ARG0_SPAWN:
    !arg0_spawn_ok
    !arg0_process_ok
    !arg0_status_ok
    !arg0_process
    !arg0_status
    panic(1012)

L_ARG0_WAIT:
    EXPAND PROCESS_WAIT arg0_wait_status, arg0_code, arg0_process
    arg0_wait_ok = eq arg0_wait_status, SA_PROCESS_OK
    arg0_code_ok = eq arg0_code, 0
    arg0_wait_all = and arg0_wait_ok, arg0_code_ok
    br arg0_wait_all -> L_ARG0_READ, L_FAIL_ARG0_WAIT

L_FAIL_ARG0_WAIT:
    !arg0_wait_all
    !arg0_code_ok
    !arg0_wait_ok
    !arg0_code
    !arg0_wait_status
    EXPAND PROCESS_CLOSE arg0_close_fail, arg0_process
    !arg0_close_fail
    !arg0_spawn_ok
    !arg0_process_ok
    !arg0_status_ok
    !arg0_process
    !arg0_status
    panic(1013)

L_ARG0_READ:
    arg0_buf = stack_alloc 32
    EXPAND PROCESS_READ_STDOUT arg0_read_status, arg0_read_len, arg0_process, arg0_buf, 32
    arg0_read_ok = eq arg0_read_status, SA_PROCESS_OK
    arg0_len_ok = eq arg0_read_len, CUSTOM_ARG0_LEN
    arg0_b0 = load arg0_buf+0 as u8
    arg0_b14 = load arg0_buf+14 as u8
    arg0_b0_ok = eq arg0_b0, 115
    arg0_b14_ok = eq arg0_b14, 48
    arg0_read01 = and arg0_read_ok, arg0_len_ok
    arg0_read02 = and arg0_read01, arg0_b0_ok
    arg0_read_all = and arg0_read02, arg0_b14_ok
    EXPAND PROCESS_CLOSE arg0_close_status, arg0_process
    arg0_close_ok = eq arg0_close_status, SA_PROCESS_OK
    arg0_all = and arg0_read_all, arg0_close_ok
    br arg0_all -> L_PGROUP_START, L_FAIL_ARG0_READ

L_FAIL_ARG0_READ:
    !arg0_all
    !arg0_close_ok
    !arg0_close_status
    !arg0_read_all
    !arg0_read02
    !arg0_read01
    !arg0_b14_ok
    !arg0_b0_ok
    !arg0_b14
    !arg0_b0
    !arg0_len_ok
    !arg0_read_ok
    !arg0_read_len
    !arg0_read_status
    !arg0_wait_all
    !arg0_code_ok
    !arg0_wait_ok
    !arg0_code
    !arg0_wait_status
    !arg0_spawn_ok
    !arg0_process_ok
    !arg0_status_ok
    !arg0_process
    !arg0_status
    panic(1014)

L_PGROUP_START:
    EXPAND PROCESS_ARGV_SET_CONST argv, 2, PGID_CMD, PGID_CMD_LEN
    EXPAND PROCESS_RUN_PROCESS_GROUP pg_status, pg_process, argv, 3, 0
    pg_status_ok = eq pg_status, SA_PROCESS_OK
    pg_process_ok = ne pg_process, 0
    pg_spawn_ok = and pg_status_ok, pg_process_ok
    br pg_spawn_ok -> L_PGROUP_WAIT, L_FAIL_PGROUP_SPAWN

L_FAIL_PGROUP_SPAWN:
    !pg_spawn_ok
    !pg_process_ok
    !pg_status_ok
    !pg_process
    !pg_status
    panic(1015)

L_PGROUP_WAIT:
    EXPAND PROCESS_WAIT pg_wait_status, pg_code, pg_process
    pg_wait_ok = eq pg_wait_status, SA_PROCESS_OK
    pg_code_ok = eq pg_code, 0
    pg_wait_all = and pg_wait_ok, pg_code_ok
    EXPAND PROCESS_CLOSE pg_close_status, pg_process
    pg_close_ok = eq pg_close_status, SA_PROCESS_OK
    pg_all = and pg_wait_all, pg_close_ok
    br pg_all -> L_SETSID_START, L_FAIL_PGROUP_WAIT

L_FAIL_PGROUP_WAIT:
    !pg_all
    !pg_close_ok
    !pg_close_status
    !pg_wait_all
    !pg_code_ok
    !pg_wait_ok
    !pg_code
    !pg_wait_status
    !pg_spawn_ok
    !pg_process_ok
    !pg_status_ok
    !pg_process
    !pg_status
    panic(1016)

L_SETSID_START:
    EXPAND PROCESS_ARGV_SET_CONST argv, 2, SID_CMD, SID_CMD_LEN
    EXPAND PROCESS_RUN_SETSID sid_status, sid_process, argv, 3
    sid_status_ok = eq sid_status, SA_PROCESS_OK
    sid_process_ok = ne sid_process, 0
    sid_spawn_ok = and sid_status_ok, sid_process_ok
    br sid_spawn_ok -> L_SETSID_WAIT, L_FAIL_SETSID_SPAWN

L_FAIL_SETSID_SPAWN:
    !sid_spawn_ok
    !sid_process_ok
    !sid_status_ok
    !sid_process
    !sid_status
    panic(1017)

L_SETSID_WAIT:
    EXPAND PROCESS_WAIT sid_wait_status, sid_code, sid_process
    sid_wait_ok = eq sid_wait_status, SA_PROCESS_OK
    sid_code_ok = eq sid_code, 0
    sid_wait_all = and sid_wait_ok, sid_code_ok
    EXPAND PROCESS_CLOSE sid_close_status, sid_process
    sid_close_ok = eq sid_close_status, SA_PROCESS_OK
    sid_all = and sid_wait_all, sid_close_ok
    br sid_all -> L_PASS_EXT, L_FAIL_SETSID_WAIT

L_FAIL_SETSID_WAIT:
    !sid_all
    !sid_close_ok
    !sid_close_status
    !sid_wait_all
    !sid_code_ok
    !sid_wait_ok
    !sid_code
    !sid_wait_status
    !sid_spawn_ok
    !sid_process_ok
    !sid_status_ok
    !sid_process
    !sid_status
    panic(1018)

L_PASS_EXT:
    !sid_all
    !sid_close_ok
    !sid_close_status
    !sid_wait_all
    !sid_code_ok
    !sid_wait_ok
    !sid_code
    !sid_wait_status
    !sid_spawn_ok
    !sid_process_ok
    !sid_status_ok
    !sid_process
    !sid_status
    !pg_all
    !pg_close_ok
    !pg_close_status
    !pg_wait_all
    !pg_code_ok
    !pg_wait_ok
    !pg_code
    !pg_wait_status
    !pg_spawn_ok
    !pg_process_ok
    !pg_status_ok
    !pg_process
    !pg_status
    !arg0_all
    !arg0_close_ok
    !arg0_close_status
    !arg0_read_all
    !arg0_read02
    !arg0_read01
    !arg0_b14_ok
    !arg0_b0_ok
    !arg0_b14
    !arg0_b0
    !arg0_read_len
    !arg0_read_status
    !arg0_wait_all
    !arg0_code_ok
    !arg0_wait_ok
    !arg0_code
    !arg0_wait_status
    !arg0_spawn_ok
    !arg0_process_ok
    !arg0_status_ok
    !arg0_process
    !arg0_status
    return 0

@test "sa_std process command ext spawn modes"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV2_SIZE
    dummy = stack_alloc 1
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, TRUE_BIN, TRUE_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, TRUE_ARG, TRUE_ARG_LEN

    EXPAND PROCESS_SPAWN_COMMAND_EXT spawn_status, process, argv, 2, dummy, 0, 0, dummy, 0, 0, 0, 0, 0
    spawn_status_ok = eq spawn_status, SA_PROCESS_OK
    process_ok = ne process, 0
    spawn_ok = and spawn_status_ok, process_ok
    br spawn_ok -> L_WAIT_SPAWN, L_FAIL_SPAWN_EXT

L_FAIL_SPAWN_EXT:
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1019)

L_WAIT_SPAWN:
    EXPAND PROCESS_WAIT wait_status, code, process
    wait_status_ok = eq wait_status, SA_PROCESS_OK
    code_ok = eq code, 0
    wait_ok = and wait_status_ok, code_ok
    EXPAND PROCESS_CLOSE close_status, process
    close_ok = eq close_status, SA_PROCESS_OK
    spawn_all = and wait_ok, close_ok
    br spawn_all -> L_STREAM_START, L_FAIL_WAIT_SPAWN

L_FAIL_WAIT_SPAWN:
    !spawn_all
    !close_ok
    !close_status
    !wait_ok
    !code_ok
    !wait_status_ok
    !code
    !wait_status
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1020)

L_STREAM_START:
    EXPAND PROCESS_SPAWN_STREAM_COMMAND_EXT stream_status, stream_process, stream_stdout, stream_stderr, argv, 2, dummy, 0, 0, dummy, 0, 0, 0, 0, 0
    stream_status_ok = eq stream_status, SA_PROCESS_OK
    stream_process_ok = ne stream_process, 0
    stream_stdout_ok = ne stream_stdout, 0
    stream_stderr_ok = ne stream_stderr, 0
    stream01 = and stream_status_ok, stream_process_ok
    stream02 = and stream01, stream_stdout_ok
    stream_ok = and stream02, stream_stderr_ok
    br stream_ok -> L_WAIT_STREAM, L_FAIL_STREAM_EXT

L_FAIL_STREAM_EXT:
    !stream_ok
    !stream02
    !stream01
    !stream_stderr_ok
    !stream_stdout_ok
    !stream_process_ok
    !stream_status_ok
    !stream_stderr
    !stream_stdout
    !stream_process
    !stream_status
    panic(1021)

L_WAIT_STREAM:
    EXPAND PROCESS_WAIT stream_wait_status, stream_code, stream_process
    stream_wait_status_ok = eq stream_wait_status, SA_PROCESS_OK
    stream_code_ok = eq stream_code, 0
    stream_wait_ok = and stream_wait_status_ok, stream_code_ok
    EXPAND PROCESS_CLOSE stream_close_process, stream_process
    EXPAND FS_CLOSE stream_close_stdout, stream_stdout
    EXPAND FS_CLOSE stream_close_stderr, stream_stderr
    stream_close_process_ok = eq stream_close_process, SA_PROCESS_OK
    stream_close_stdout_ok = eq stream_close_stdout, SA_PROCESS_OK
    stream_close_stderr_ok = eq stream_close_stderr, SA_PROCESS_OK
    stream_close01 = and stream_close_process_ok, stream_close_stdout_ok
    stream_close_ok = and stream_close01, stream_close_stderr_ok
    stream_all = and stream_wait_ok, stream_close_ok
    br stream_all -> L_PASS_SPAWN_EXT, L_FAIL_WAIT_STREAM

L_FAIL_WAIT_STREAM:
    !stream_all
    !stream_close_ok
    !stream_close01
    !stream_close_stderr_ok
    !stream_close_stdout_ok
    !stream_close_process_ok
    !stream_close_stderr
    !stream_close_stdout
    !stream_close_process
    !stream_wait_ok
    !stream_code_ok
    !stream_wait_status_ok
    !stream_code
    !stream_wait_status
    !stream_ok
    !stream02
    !stream01
    !stream_stderr_ok
    !stream_stdout_ok
    !stream_process_ok
    !stream_status_ok
    !stream_stderr
    !stream_stdout
    !stream_process
    !stream_status
    panic(1022)

L_PASS_SPAWN_EXT:
    !stream_all
    !stream_close_ok
    !stream_close01
    !stream_close_stderr_ok
    !stream_close_stdout_ok
    !stream_close_process_ok
    !stream_close_stderr
    !stream_close_stdout
    !stream_close_process
    !stream_wait_ok
    !stream_code_ok
    !stream_wait_status_ok
    !stream_code
    !stream_wait_status
    !stream_ok
    !stream02
    !stream01
    !stream_stderr_ok
    !stream_stdout_ok
    !stream_process_ok
    !stream_status_ok
    !stream_stderr
    !stream_stdout
    !stream_process
    !stream_status
    !spawn_all
    !close_ok
    !close_status
    !wait_ok
    !code_ok
    !wait_status_ok
    !code
    !wait_status
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    return 0

@test "sa_std process group signal macros"():
L_ENTRY:
    argv = stack_alloc TRUE_ARGV2_SIZE
    dummy = stack_alloc 1
    exit_status = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, SLEEP_BIN, SLEEP_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, SLEEP_ARG, SLEEP_ARG_LEN

    EXPAND PROCESS_SPAWN_COMMAND_EXT spawn_status, process, argv, 2, dummy, 0, 0, dummy, 0, 0, 0, 1, 0
    spawn_status_ok = eq spawn_status, SA_PROCESS_OK
    process_ok = ne process, 0
    spawn_ok = and spawn_status_ok, process_ok
    br spawn_ok -> L_GROUP_KILL, L_FAIL_GROUP_SPAWN

L_FAIL_GROUP_SPAWN:
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1023)

L_GROUP_KILL:
    EXPAND PROCESS_SEND_PROCESS_GROUP_SIGNAL group_kill_status, process, SIG_KILL_PROCESS
    group_kill_ok = eq group_kill_status, SA_PROCESS_OK
    br group_kill_ok -> L_GROUP_WAIT, L_FAIL_GROUP_KILL

L_FAIL_GROUP_KILL:
    !group_kill_ok
    !group_kill_status
    EXPAND PROCESS_KILL cleanup_kill_group, process
    EXPAND PROCESS_CLOSE cleanup_close_group, process
    !cleanup_kill_group
    !cleanup_close_group
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1025)

L_GROUP_WAIT:
    EXPAND PROCESS_WAIT_EXIT_STATUS wait_status, exit_status, process
    wait_ok = eq wait_status, SA_PROCESS_OK
    EXPAND PROCESS_EXIT_STATUS_RAW raw, exit_status
    EXPAND PROCESS_EXIT_STATUS_SIGNAL signal, exit_status
    raw_ok = ne raw, 0
    signal_ok = eq signal, SIG_KILL_PROCESS
    group_wait01 = and wait_ok, raw_ok
    group_wait_ok = and group_wait01, signal_ok
    EXPAND PROCESS_CLOSE close_status, process
    close_ok = eq close_status, SA_PROCESS_OK
    group_all = and group_wait_ok, close_ok
    br group_all -> L_PASS_GROUP_SIGNAL, L_FAIL_GROUP_WAIT

L_FAIL_GROUP_WAIT:
    !group_all
    !close_ok
    !close_status
    !group_wait_ok
    !group_wait01
    !signal_ok
    !raw_ok
    !signal
    !raw
    !wait_ok
    !wait_status
    !group_kill_ok
    !group_kill_status
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    panic(1026)

L_PASS_GROUP_SIGNAL:
    !group_all
    !close_ok
    !close_status
    !group_wait_ok
    !group_wait01
    !signal_ok
    !raw_ok
    !signal
    !raw
    !wait_ok
    !wait_status
    !group_kill_ok
    !group_kill_status
    !spawn_ok
    !process_ok
    !spawn_status_ok
    !process
    !spawn_status
    return 0

@test "sa_std process try_wait and kill macros"():
L_ENTRY:
    argv = stack_alloc SH_ARGV3_SIZE
    exit_status = stack_alloc ProcessExitStatus_SIZE
    EXPAND PROCESS_ARGV_SET_CONST argv, 0, SH_BIN, SH_BIN_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 1, SH_FLAG, SH_FLAG_LEN
    EXPAND PROCESS_ARGV_SET_CONST argv, 2, SLEEP_CMD, SLEEP_CMD_LEN

    EXPAND PROCESS_SPAWN spawn_status, process, argv, 3
    EXPAND PROCESS_STATUS_IS_OK spawn_ok, spawn_status
    process_ok = ne process, 0
    spawn_all_ok = and spawn_ok, process_ok
    br spawn_all_ok -> L_CHILD_ID, L_FAIL_SPAWN

L_FAIL_SPAWN:
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(1005)

L_CHILD_ID:
    EXPAND PROCESS_CHILD_ID child_id_status, child_pid, process
    EXPAND PROCESS_STATUS_IS_OK child_id_ok, child_id_status
    child_pid_ok = ne child_pid, 0
    child_id_all_ok = and child_id_ok, child_pid_ok
    br child_id_all_ok -> L_TRY_WAIT_PENDING, L_FAIL_CHILD_ID

L_FAIL_CHILD_ID:
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    EXPAND PROCESS_KILL cleanup_kill_status_child_id, process
    EXPAND PROCESS_CLOSE cleanup_close_status_child_id, process
    !cleanup_kill_status_child_id
    !cleanup_close_status_child_id
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(1010)

L_TRY_WAIT_PENDING:
    EXPAND PROCESS_TRY_WAIT try_status0, ready0, code0, process
    EXPAND PROCESS_STATUS_IS_OK try_ok0, try_status0
    ready0_ok = eq ready0, 0
    code0_ok = eq code0, 0
    pending_ok0 = and try_ok0, ready0_ok
    pending_ok = and pending_ok0, code0_ok
    br pending_ok -> L_SIGNAL_CHECK, L_FAIL_PENDING

L_FAIL_PENDING:
    !pending_ok
    !pending_ok0
    !code0_ok
    !ready0_ok
    !try_ok0
    !code0
    !ready0
    !try_status0
    EXPAND PROCESS_KILL cleanup_kill_status_a, process
    EXPAND PROCESS_CLOSE cleanup_close_status_a, process
    !cleanup_kill_status_a
    !cleanup_close_status_a
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(1006)

L_SIGNAL_CHECK:
    EXPAND PROCESS_SEND_SIGNAL signal_check_status, process, SIG_CHECK_PROCESS
    EXPAND PROCESS_STATUS_IS_OK signal_check_ok, signal_check_status
    br signal_check_ok -> L_KILL, L_FAIL_SIGNAL_CHECK

L_FAIL_SIGNAL_CHECK:
    !signal_check_ok
    !signal_check_status
    EXPAND PROCESS_KILL cleanup_kill_status_signal, process
    EXPAND PROCESS_CLOSE cleanup_close_status_signal, process
    !cleanup_kill_status_signal
    !cleanup_close_status_signal
    !pending_ok
    !pending_ok0
    !code0_ok
    !ready0_ok
    !try_ok0
    !code0
    !ready0
    !try_status0
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(1011)

L_KILL:
    EXPAND PROCESS_KILL kill_status, process
    EXPAND PROCESS_STATUS_IS_OK kill_ok, kill_status
    br kill_ok -> L_TRY_WAIT_READY, L_FAIL_KILL

L_FAIL_KILL:
    !kill_ok
    !kill_status
    EXPAND PROCESS_CLOSE cleanup_close_status_b, process
    !cleanup_close_status_b
    !signal_check_ok
    !signal_check_status
    !pending_ok
    !pending_ok0
    !code0_ok
    !ready0_ok
    !try_ok0
    !code0
    !ready0
    !try_status0
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    panic(1007)

L_TRY_WAIT_READY:
    EXPAND PROCESS_TRY_WAIT_EXIT_STATUS try_status1, ready1, exit_status, process
    EXPAND PROCESS_STATUS_IS_OK try_ok1, try_status1
    EXPAND PROCESS_EXIT_STATUS_CODE code1, exit_status
    EXPAND PROCESS_EXIT_STATUS_RAW raw1, exit_status
    EXPAND PROCESS_EXIT_STATUS_SUCCESS exit_success1, exit_status
    EXPAND PROCESS_EXIT_STATUS_SIGNAL signal1, exit_status
    EXPAND PROCESS_EXIT_STATUS_COREDUMPED core1, exit_status
    EXPAND PROCESS_EXIT_STATUS_STOPPED_SIGNAL stopped1, exit_status
    EXPAND PROCESS_EXIT_STATUS_CONTINUED continued1, exit_status
    ready1_ok = eq ready1, 1
    code1_nonzero = ne code1, 0
    raw1_nonzero = ne raw1, 0
    exit_success_false = eq exit_success1, 0
    signal1_ok = eq signal1, 9
    core1_ok = eq core1, 0
    stopped1_ok = eq stopped1, -1
    continued1_ok = eq continued1, 0
    ready_ok0 = and try_ok1, ready1_ok
    ready_ok1 = and ready_ok0, code1_nonzero
    ready_ok2 = and ready_ok1, raw1_nonzero
    ready_ok3 = and ready_ok2, exit_success_false
    ready_ok4 = and ready_ok3, signal1_ok
    ready_ok5 = and ready_ok4, core1_ok
    ready_ok6 = and ready_ok5, stopped1_ok
    ready_ok = and ready_ok6, continued1_ok
    EXPAND PROCESS_CLOSE close_status, process
    EXPAND PROCESS_STATUS_IS_OK close_ok, close_status
    ok0 = and spawn_all_ok, pending_ok
    ok1 = and ok0, child_id_all_ok
    ok1b = and ok1, signal_check_ok
    ok2 = and ok1b, kill_ok
    ok3 = and ok2, ready_ok
    ok = and ok3, close_ok
    !try_status1
    !try_ok1
    !ready1
    !code1
    !raw1
    !exit_success1
    !signal1
    !core1
    !stopped1
    !continued1
    !ready1_ok
    !code1_nonzero
    !raw1_nonzero
    !exit_success_false
    !signal1_ok
    !core1_ok
    !stopped1_ok
    !continued1_ok
    !ready_ok0
    !ready_ok1
    !ready_ok2
    !ready_ok3
    !ready_ok4
    !ready_ok5
    !ready_ok6
    !ready_ok
    !close_status
    !close_ok
    !ok0
    !ok1
    !ok1b
    !ok2
    !ok3
    !kill_ok
    !kill_status
    !signal_check_ok
    !signal_check_status
    !pending_ok
    !pending_ok0
    !code0_ok
    !ready0_ok
    !try_ok0
    !code0
    !ready0
    !try_status0
    !child_id_all_ok
    !child_pid_ok
    !child_id_ok
    !child_pid
    !child_id_status
    !spawn_all_ok
    !process_ok
    !spawn_ok
    !process
    !spawn_status
    br ok -> L_PASS3, L_FAIL_DONE

L_FAIL_DONE:
    !ok
    panic(1008)

L_PASS3:
    !ok
    return 0

@test "sa_std process abort macro surface"():
L_ENTRY:
    // PROCESS_ABORT is intentionally not invoked here because it terminates
    // the current process; runtime behavior is covered by the C fork smoke.
    abort_macro_available = add 1, 0
    br abort_macro_available -> L_PASS4, L_FAIL4

L_FAIL4:
    !abort_macro_available
    panic(1009)

L_PASS4:
    !abort_macro_available
    return 0
