    store be_ptr+1, 97 as u8
    store be_ptr+2, 0 as u8
    store be_ptr+3, 233 as u8
    store be_ptr+4, 216 as u8
    store be_ptr+5, 61 as u8
    store be_ptr+6, 222 as u8
    store be_ptr+7, 66 as u8
    store be_ptr+8, 0 as u8
    store be_ptr+9, 122 as u8
    EXPAND STR_FROM_PARTS be_bytes, be_ptr, 10
    odd_ptr = stack_alloc 3
