@test "sa_std string mutable byte macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS string, &MUT_BASE, 4
    EXPAND STR_FROM_PARTS suffix, &MUT_SUFFIX, 4
    EXPAND STR_FROM_PARTS pushed_expected, &MUT_PUSHED, 8
    EXPAND STR_FROM_PARTS insert_text, &MUT_INSERT, 3
    EXPAND STR_FROM_PARTS insert_expected, &MUT_AFTER_INSERT, 11
    EXPAND STR_FROM_PARTS replace_text, &MUT_REPLACE, 4
    EXPAND STR_FROM_PARTS replace_expected, &MUT_AFTER_REPLACE, 12
    EXPAND STR_FROM_PARTS split_left_expected, &MUT_SPLIT_LEFT, 8
    EXPAND STR_FROM_PARTS split_tail_expected, &MUT_SUFFIX, 4
    EXPAND STR_FROM_PARTS insert_byte_expected, &MUT_AFTER_INSERT_BYTE, 9

    EXPAND STRING_PUSH_STR string, suffix
    EXPAND STR_EQ pushed_eq, string, pushed_expected
    EXPAND STRING_PUSH string, 33
    EXPAND STRING_LEN len_after_push, string
    EXPAND STRING_POP pop_ok, pop_byte, string
    EXPAND STR_EQ pop_rest_eq, string, pushed_expected
    EXPAND STRING_TRY_INSERT_STR insert_ok, string, 4, insert_text
    EXPAND STR_EQ insert_eq, string, insert_expected
    EXPAND STRING_TRY_REPLACE_RANGE replace_ok, string, 4, 3, replace_text
    EXPAND STR_EQ replace_eq, string, replace_expected
    EXPAND STRING_TRY_SPLIT_OFF split_ok, split_tail, string, 8
    EXPAND STR_EQ split_left_eq, string, split_left_expected
    EXPAND STR_EQ split_tail_eq, split_tail, split_tail_expected
    EXPAND STRING_TRY_INSERT insert_byte_ok, string, 4, 45
    EXPAND STR_EQ insert_byte_eq, string, insert_byte_expected
    EXPAND STRING_TRUNCATE string, 4
