@test "sa_std string owned buffer ascii char macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS expected_push, &BUF_CHAR_EXPECTED, 2
    EXPAND STR_FROM_PARTS expected_insert, &BUF_INSERT_CHAR_EXPECTED, 3
    EXPAND STR_FROM_PARTS expected_alias, &BUF_INSERT_CHAR_ALIAS_EXPECTED, 4

    EXPAND STRING_BUF_NEW string_buf
    EXPAND STRING_BUF_TRY_PUSH_CHAR push_char_ok, string_buf, 114
    EXPAND STRING_BUF_TRY_PUSH_CHAR push_char_ok2, string_buf, 33
    EXPAND STRING_BUF_AS_STR after_push, string_buf
    EXPAND STR_EQ after_push_eq, after_push, expected_push
    EXPAND STRING_BUF_TRY_INSERT_CHAR insert_char_ok, string_buf, 2, 63
    EXPAND STRING_BUF_AS_STR after_insert, string_buf
    EXPAND STR_EQ after_insert_eq, after_insert, expected_insert
    EXPAND STRING_BUF_INSERT_CHAR insert_char_alias_ok, string_buf, 1, 45
    EXPAND STRING_BUF_AS_STR after_alias, string_buf
    EXPAND STR_EQ after_alias_eq, after_alias, expected_alias
    EXPAND STRING_BUF_TRY_PUSH_CHAR push_non_ascii_ok, string_buf, 233
    EXPAND STRING_BUF_TRY_INSERT_CHAR insert_non_ascii_ok, string_buf, 1, 233
    EXPAND STRING_BUF_LEN final_len, string_buf

    push_flag_ok = eq push_char_ok, 1
    push_flag2_ok = eq push_char_ok2, 1
    push_value_ok = eq after_push_eq, 1
    insert_flag_ok = eq insert_char_ok, 1
    insert_value_ok = eq after_insert_eq, 1
    alias_flag_ok = eq insert_char_alias_ok, 1
    alias_value_ok = eq after_alias_eq, 1
    push_non_ascii_flag_ok = eq push_non_ascii_ok, 0
    insert_non_ascii_flag_ok = eq insert_non_ascii_ok, 0
    final_len_ok = eq final_len, 4
    ok00 = and push_flag_ok, push_flag2_ok
    ok01 = and ok00, push_value_ok
    ok02 = and ok01, insert_flag_ok
    ok03 = and ok02, insert_value_ok
    ok04 = and ok03, alias_flag_ok
    ok05 = and ok04, alias_value_ok
    ok06 = and ok05, push_non_ascii_flag_ok
    ok07 = and ok06, insert_non_ascii_flag_ok
    ok = and ok07, final_len_ok
    !expected_push
    !expected_insert
    !expected_alias
    !push_char_ok
    !push_char_ok2
    !after_push
    !after_push_eq
    !insert_char_ok
    !after_insert
    !after_insert_eq
    !insert_char_alias_ok
    !after_alias
    !after_alias_eq
    !push_non_ascii_ok
    !insert_non_ascii_ok
    !final_len
    !push_flag_ok
    !push_flag2_ok
    !push_value_ok
    !insert_flag_ok
    !insert_value_ok
    !alias_flag_ok
    !alias_value_ok
    !push_non_ascii_flag_ok
    !insert_non_ascii_flag_ok
    !final_len_ok
    !ok00
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    EXPAND STRING_BUF_FREE string_buf
    br ok -> L_STRING_BUF_CHAR_OK, L_STRING_BUF_CHAR_FAIL

L_STRING_BUF_CHAR_FAIL:
    !ok
    panic(917)

L_STRING_BUF_CHAR_OK:
    !ok
    return

@test "sa_std string buffer remove char at byte macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS source, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STR_FROM_PARTS after_a_expected, &UTF8_AFTER_REMOVE_A, 7
    EXPAND STR_FROM_PARTS after_e_expected, &UTF8_AFTER_REMOVE_E, 6
    EXPAND STR_FROM_PARTS after_smile_expected, &UTF8_AFTER_REMOVE_SMILE, 4
    EXPAND STR_FROM_PARTS after_z_expected, &UTF8_AFTER_REMOVE_Z, 7

