    bad_first_value_ok = eq bad_first, 255
    ok01 = and from_mut_ok, from_ref_ok
    ok02 = and ok01, valid_flag_ok
    ok03 = and ok02, valid_value_ok
    ok04 = and ok03, valid_err_empty_ok
    ok05 = and ok04, bad_flag_ok
    ok06 = and ok05, bad_buf_empty_ok
    ok07 = and ok06, bad_err_len_ok
    ok08 = and ok07, bad_first_flag_ok
    ok = and ok08, bad_first_value_ok

    !from_mut_eq
    !source_mut_ptr
    !from_ref_eq
    !valid_ok
    !valid_eq
    !valid_err_len
    !bad_ok
    !bad_buf_len
    !bad_err_len
    !bad_first_ok
    !bad_first
    !from_mut_ok
    !from_ref_ok
    !valid_flag_ok
    !valid_value_ok
    !valid_err_empty_ok
    !bad_flag_ok
    !bad_buf_empty_ok
    !bad_err_len_ok
    !bad_first_flag_ok
    !bad_first_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !word_slice
    !from_mut_view
    !source_mut
    !from_ref_view
    !valid_view
    EXPAND VEC_FREE bad_err_vec
    EXPAND STRING_BUF_FREE bad_buf
    EXPAND VEC_FREE valid_err_vec
    EXPAND STRING_BUF_FREE valid_buf
    EXPAND STRING_BUF_FREE from_ref
    EXPAND STRING_BUF_FREE source
    EXPAND STRING_BUF_FREE from_mut
    br ok -> L_STRING_BUF_REF_CONV_OK, L_STRING_BUF_REF_CONV_FAIL

L_STRING_BUF_REF_CONV_FAIL:
    !ok
    panic(932)

L_STRING_BUF_REF_CONV_OK:
    !ok
    return
