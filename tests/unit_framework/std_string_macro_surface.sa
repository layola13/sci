@import "sa_std/string.sa"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"

@const WORD = utf8:"rust"
@const TITLE_WORD = utf8:"Rust"
@const PREFIX = utf8:"ru"
@const SUFFIX = utf8:"st"
@const INFIX = utf8:"us"
@const REPEATED = utf8:"ana"
@const MISS = utf8:"zz"
@const PATHISH = utf8:"a:b:c"
@const COLON = utf8:":"
@const PATH_LEFT = utf8:"a"
@const PATH_RIGHT = utf8:"b:c"
@const PATH_RLEFT = utf8:"a:b"
@const PATH_RRIGHT = utf8:"c"
@const MIXED_WORD = utf8:"RuSt"
@const SPACED_WORD = utf8:"  Rust  "
@const WORD_TRAILING = utf8:"Rust  "
@const WORD_LEADING = utf8:"  Rust"
@const JOIN_LEFT = utf8:"rust"
@const JOIN_RIGHT = utf8:"-std"
@const JOINED = utf8:"rust-std"
@const MUT_BASE = utf8:"rust"
@const MUT_SUFFIX = utf8:"-std"
@const MUT_PUSHED = utf8:"rust-std"
@const MUT_INSERT = utf8:"ace"
@const MUT_AFTER_INSERT = utf8:"rustace-std"
@const MUT_REPLACE = utf8:"lang"
@const MUT_AFTER_REPLACE = utf8:"rustlang-std"
@const MUT_SPLIT_LEFT = utf8:"rustlang"
@const MUT_AFTER_INSERT_BYTE = utf8:"rust-lang"
@const BUF_SUFFIX = utf8:"std"
@const BUF_EXPECTED = utf8:"rust-std"
@const BUF_EXTEND_WITHIN_EXPECTED = utf8:"rust-stdus"
@const BUF_EXTEND_WITHIN_ALIAS_EXPECTED = utf8:"rust-stdusr"
@const BUF_INSERT_BYTE_EXPECTED = utf8:"rust-std!"
@const BUF_INSERT_STR_EXPECTED = utf8:"rust-lang-std!"
@const BUF_REPLACE_EXPECTED = utf8:"rust-core-std!"
@const BUF_SPLIT_LEFT_EXPECTED = utf8:"rust-core"
@const BUF_SPLIT_TAIL_EXPECTED = utf8:"-std"
@const BUF_LANG = utf8:"lang-"
@const BUF_CORE = utf8:"core"
@const BUF_REPLACE_SOURCE = utf8:"a-b-a-b"
@const BUF_REPLACE_NEEDLE = utf8:"-"
@const BUF_REPLACE_WITH = utf8:"::"
@const BUF_REPLACE_ALL_EXPECTED = utf8:"a::b::a::b"
@const BUF_REPLACE_FIRST_EXPECTED = utf8:"a::b-a-b"
@const BUF_REPLACE_LAST_EXPECTED = utf8:"a-b-a::b"
@const BUF_REMOVE_MATCHES_EXPECTED = utf8:"abab"
@const BUF_REPLACE_EMPTY_EXPECTED = utf8:"a-b-a-b"
@const BUF_REPLACE_MULTI_SOURCE = utf8:"banana ana"
@const BUF_REPLACE_MULTI_NEEDLE = utf8:"ana"
@const BUF_REPLACE_MULTI_WITH = utf8:"*"
@const BUF_REPLACE_MULTI_EXPECTED = utf8:"b*na *"
@const BUF_REMOVE_MULTI_EXPECTED = utf8:"bna "
@const BUF_REPLACE_LONG_NEEDLE = utf8:"banana split"
@const BUF_CHAR_EXPECTED = utf8:"r!"
@const BUF_INSERT_CHAR_EXPECTED = utf8:"r!?"
@const BUF_INSERT_CHAR_ALIAS_EXPECTED = utf8:"r-!?"
@const LINES_TEXT = utf8:"alpha\nbeta\r\ngamma\n"
@const LINES_ALPHA = utf8:"alpha"
@const LINES_BETA = utf8:"beta"
@const LINES_GAMMA = utf8:"gamma"
@const LINES_NO_TRAIL = utf8:"one\ntwo"
@const LINES_ONE = utf8:"one"
@const LINES_TWO = utf8:"two"
@const SPLIT_TEXT = utf8:":a::b:"
@const SPLIT_A = utf8:"a"
@const SPLIT_B = utf8:"b"
@const UTF8_BOUNDARY_TEXT = utf8:"aé🙂z"
@const UTF8_A_E = utf8:"aé"
@const UTF8_E_ACUTE = utf8:"é"
@const UTF8_SMILE = utf8:"🙂"
@const UTF8_SMILE_Z = utf8:"🙂z"
@const UTF8_Z = utf8:"z"
@const UTF8_AFTER_REMOVE_A = utf8:"é🙂z"
@const UTF8_AFTER_REMOVE_E = utf8:"a🙂z"
@const UTF8_AFTER_REMOVE_SMILE = utf8:"aéz"
@const UTF8_AFTER_REMOVE_Z = utf8:"aé🙂"
@const UTF8_E_SMILE = utf8:"é🙂"
@const UTF8_A_Z = utf8:"az"
@const BUF_DRAIN_SOURCE = utf8:"rust-std"
@const BUF_DRAIN_REMOVED = utf8:"-"
@const BUF_DRAIN_REMAINING = utf8:"ruststd"

@vec_pop_if_is_99(value: u64) -> u64:
L_ENTRY:
    is_match = eq value, 99
    !value
    return is_match

@vec_pop_if_is_88(value: u64) -> u64:
L_ENTRY:
    is_match = eq value, 88
    !value
    return is_match

@vec_retain_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@vec_resize_with_42() -> u64:
L_ENTRY:
    return 42

@vec_dedup_by_same_tens(left: u64, right: u64) -> u64:
L_ENTRY:
    left_group = udiv left, 10
    right_group = udiv right, 10
    same = eq left_group, right_group
    !left_group
    !right_group
    !left
    !right
    return same

@vec_key_tens(value: u64) -> u64:
L_ENTRY:
    key = udiv value, 10
    !value
    return key

@vec_extract_if_gt_30(value: u64) -> u64:
L_ENTRY:
    take = ugt value, 30
    !value
    return take

@slice_partition_lt_30(value: u64) -> u64:
L_ENTRY:
    keep = ult value, 30
    !value
    return keep

@slice_sorted_le(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = ule left, right
    !left
    !right
    return ok

@slice_sorted_lt(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = ult left, right
    !left
    !right
    return ok

@slice_sorted_ge(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = uge left, right
    !left
    !right
    return ok

@slice_sorted_key_tens(value: u64) -> u64:
L_ENTRY:
    key = udiv value, 10
    !value
    return key

@slice_fill_with_77() -> u64:
L_ENTRY:
    return 77

@test "sa_std string convenience macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS word, &WORD, 4
    EXPAND STR_FROM_PARTS prefix, &PREFIX, 2
    EXPAND STR_FROM_PARTS suffix, &SUFFIX, 2
    EXPAND STR_FROM_PARTS infix, &INFIX, 2
    EXPAND STR_FROM_PARTS miss, &MISS, 2
    EXPAND STRING_LEN len, word
    EXPAND STR_AS_PTR as_ptr, word
    EXPAND STRING_AS_BYTES bytes, word
    EXPAND STRING_AS_STR str_view, word
    EXPAND STR_LEN bytes_len, bytes
    EXPAND STRING_LEN str_len, str_view
    EXPAND STRING_NEW new_empty
    EXPAND STR_EMPTY str_empty
    EXPAND STRING_IS_EMPTY new_empty_ok, new_empty
    EXPAND STR_IS_EMPTY str_empty_ok, str_empty
    EXPAND STR_STARTS_WITH starts_ok, word, prefix
    EXPAND STRING_ENDS_WITH ends_ok, word, suffix
    EXPAND STR_CONTAINS contains_ok, word, infix
    EXPAND STR_TRY_FIND find_ok, find_idx, word, infix
    EXPAND STRING_TRY_RFIND rfind_ok, rfind_idx, word, infix
    EXPAND STRING_CONTAINS contains_empty_ok, word, str_empty
    EXPAND STR_STARTS_WITH starts_miss, word, miss
    EXPAND STRING_ENDS_WITH ends_miss, word, miss
    EXPAND STR_CONTAINS contains_miss, word, miss
    EXPAND STR_TRY_FIND find_miss_ok, find_miss_idx, word, miss
    EXPAND STRING_TRY_RFIND rfind_miss_ok, rfind_miss_idx, word, miss
    EXPAND STR_TRY_STRIP_PREFIX strip_prefix_ok, strip_prefix_tail, word, prefix
    EXPAND STRING_TRY_STRIP_SUFFIX strip_suffix_ok, strip_suffix_head, word, suffix
    EXPAND STR_TRY_STRIP_PREFIX strip_prefix_miss_ok, strip_prefix_miss, word, miss
    EXPAND STRING_TRY_STRIP_SUFFIX strip_suffix_miss_ok, strip_suffix_miss, word, miss
    EXPAND STR_EQ strip_prefix_tail_eq, strip_prefix_tail, suffix
    EXPAND STR_EQ strip_suffix_head_eq, strip_suffix_head, prefix
    EXPAND STR_IS_EMPTY strip_prefix_miss_empty, strip_prefix_miss
    EXPAND STR_IS_EMPTY strip_suffix_miss_empty, strip_suffix_miss

    len_ok = eq len, 4
    ptr_ok = ne as_ptr, 0
    bytes_len_ok = eq bytes_len, 4
    str_len_ok = eq str_len, 4
    starts_match_ok = eq starts_ok, 1
    ends_match_ok = eq ends_ok, 1
    contains_match_ok = eq contains_ok, 1
    find_flag_ok = eq find_ok, 1
    find_idx_ok = eq find_idx, 1
    rfind_flag_ok = eq rfind_ok, 1
    rfind_idx_ok = eq rfind_idx, 1
    contains_empty_match_ok = eq contains_empty_ok, 1
    starts_miss_ok = eq starts_miss, 0
    ends_miss_ok = eq ends_miss, 0
    contains_miss_ok = eq contains_miss, 0
    find_miss_flag_ok = eq find_miss_ok, 0
    find_miss_idx_ok = eq find_miss_idx, 0
    rfind_miss_flag_ok = eq rfind_miss_ok, 0
    rfind_miss_idx_ok = eq rfind_miss_idx, 0
    strip_prefix_flag_ok = eq strip_prefix_ok, 1
    strip_suffix_flag_ok = eq strip_suffix_ok, 1
    strip_prefix_miss_flag_ok = eq strip_prefix_miss_ok, 0
    strip_suffix_miss_flag_ok = eq strip_suffix_miss_ok, 0
    strip_prefix_tail_ok = eq strip_prefix_tail_eq, 1
    strip_suffix_head_ok = eq strip_suffix_head_eq, 1
    strip_prefix_miss_empty_ok = eq strip_prefix_miss_empty, 1
    strip_suffix_miss_empty_ok = eq strip_suffix_miss_empty, 1
    ok01 = and len_ok, ptr_ok
    ok02 = and ok01, bytes_len_ok
    ok03 = and ok02, str_len_ok
    ok04 = and ok03, new_empty_ok
    ok05 = and ok04, str_empty_ok
    ok06 = and ok05, starts_match_ok
    ok07 = and ok06, ends_match_ok
    ok08 = and ok07, contains_match_ok
    ok09 = and ok08, find_flag_ok
    ok10 = and ok09, find_idx_ok
    ok11 = and ok10, rfind_flag_ok
    ok12 = and ok11, rfind_idx_ok
    ok13 = and ok12, contains_empty_match_ok
    ok14 = and ok13, starts_miss_ok
    ok15 = and ok14, ends_miss_ok
    ok16 = and ok15, contains_miss_ok
    ok17 = and ok16, find_miss_flag_ok
    ok18 = and ok17, find_miss_idx_ok
    ok19 = and ok18, rfind_miss_flag_ok
    ok20 = and ok19, rfind_miss_idx_ok
    ok21 = and ok20, strip_prefix_flag_ok
    ok22 = and ok21, strip_suffix_flag_ok
    ok23 = and ok22, strip_prefix_miss_flag_ok
    ok24 = and ok23, strip_suffix_miss_flag_ok
    ok25 = and ok24, strip_prefix_tail_ok
    ok26 = and ok25, strip_suffix_head_ok
    ok27 = and ok26, strip_prefix_miss_empty_ok
    ok = and ok27, strip_suffix_miss_empty_ok
    !len
    !as_ptr
    !bytes
    !str_view
    !bytes_len
    !str_len
    !new_empty_ok
    !str_empty_ok
    !starts_ok
    !ends_ok
    !contains_ok
    !find_ok
    !find_idx
    !rfind_ok
    !rfind_idx
    !contains_empty_ok
    !starts_miss
    !ends_miss
    !contains_miss
    !find_miss_ok
    !find_miss_idx
    !rfind_miss_ok
    !rfind_miss_idx
    !strip_prefix_ok
    !strip_prefix_tail
    !strip_suffix_ok
    !strip_suffix_head
    !strip_prefix_miss_ok
    !strip_prefix_miss
    !strip_suffix_miss_ok
    !strip_suffix_miss
    !strip_prefix_tail_eq
    !strip_suffix_head_eq
    !strip_prefix_miss_empty
    !strip_suffix_miss_empty
    !len_ok
    !ptr_ok
    !bytes_len_ok
    !str_len_ok
    !starts_match_ok
    !ends_match_ok
    !contains_match_ok
    !find_flag_ok
    !find_idx_ok
    !rfind_flag_ok
    !rfind_idx_ok
    !contains_empty_match_ok
    !starts_miss_ok
    !ends_miss_ok
    !contains_miss_ok
    !find_miss_flag_ok
    !find_miss_idx_ok
    !rfind_miss_flag_ok
    !rfind_miss_idx_ok
    !strip_prefix_flag_ok
    !strip_suffix_flag_ok
    !strip_prefix_miss_flag_ok
    !strip_suffix_miss_flag_ok
    !strip_prefix_tail_ok
    !strip_suffix_head_ok
    !strip_prefix_miss_empty_ok
    !strip_suffix_miss_empty_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    !ok10
    !ok11
    !ok12
    !ok13
    !ok14
    !ok15
    !ok16
    !ok17
    !ok18
    !ok19
    !ok20
    !ok21
    !ok22
    !ok23
    !ok24
    !ok25
    !ok26
    !ok27
    !word
    !prefix
    !suffix
    !infix
    !miss
    !new_empty
    !str_empty
    br ok -> L_OK, L_FAIL

L_FAIL:
    !ok
    panic(901)

L_OK:
    !ok
    return

@test "sa_std string concat macro"():
L_ENTRY:
    EXPAND STR_FROM_PARTS left, &JOIN_LEFT, 4
    EXPAND STR_FROM_PARTS right, &JOIN_RIGHT, 4
    EXPAND STR_FROM_PARTS expected, &JOINED, 8
    EXPAND STR_CONCAT joined, left, right
    EXPAND STR_LEN joined_len, joined
    EXPAND STR_EQ joined_eq, joined, expected
    len_ok = eq joined_len, 8
    eq_ok = eq joined_eq, 1
    ok = and len_ok, eq_ok
    !joined_len
    !joined_eq
    !len_ok
    !eq_ok
    !joined
    !expected
    !right
    !left
    br ok -> L_CONCAT_OK, L_CONCAT_FAIL

L_CONCAT_FAIL:
    !ok
    panic(905)

L_CONCAT_OK:
    !ok
    return

@test "sa_std string owned buffer capacity macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS left, &JOIN_LEFT, 4
    EXPAND STR_FROM_PARTS suffix, &BUF_SUFFIX, 3
    EXPAND STR_FROM_PARTS expected, &BUF_EXPECTED, 8

    EXPAND STRING_BUF_WITH_CAPACITY string_buf, 8
    EXPAND STRING_BUF_LEN initial_len, string_buf
    EXPAND STRING_BUF_CAPACITY initial_cap, string_buf
    EXPAND STRING_BUF_IS_EMPTY initial_empty, string_buf
    EXPAND STRING_BUF_PUSH_STR string_buf, left
    EXPAND STRING_BUF_PUSH_BYTE string_buf, 45
    EXPAND STRING_BUF_PUSH_STR string_buf, suffix
    EXPAND STRING_BUF_LEN pushed_len, string_buf
    EXPAND STRING_BUF_AS_STR pushed_view, string_buf
    EXPAND STR_EQ pushed_eq, pushed_view, expected
    EXPAND STRING_BUF_TRY_RESERVE reserve_ok, string_buf, 10
    EXPAND STRING_BUF_CAPACITY reserved_cap, string_buf
    EXPAND STRING_BUF_SHRINK_TO string_buf, 10
    EXPAND STRING_BUF_CAPACITY shrink_to_cap, string_buf
    EXPAND STRING_BUF_SHRINK_TO_FIT string_buf
    EXPAND STRING_BUF_CAPACITY shrink_fit_cap, string_buf
    EXPAND STRING_BUF_TRUNCATE string_buf, 4
    EXPAND STRING_BUF_LEN truncate_len, string_buf
    EXPAND STRING_BUF_CLEAR string_buf
    EXPAND STRING_BUF_LEN clear_len, string_buf

    initial_len_ok = eq initial_len, 0
    initial_cap_ok = uge initial_cap, 8
    initial_empty_ok = eq initial_empty, 1
    pushed_len_ok = eq pushed_len, 8
    pushed_eq_ok = eq pushed_eq, 1
    reserve_flag_ok = eq reserve_ok, 1
    reserved_cap_ok = uge reserved_cap, 18
    shrink_to_cap_ok = eq shrink_to_cap, 10
    shrink_fit_cap_ok = eq shrink_fit_cap, 8
    truncate_len_ok = eq truncate_len, 4
    clear_len_ok = eq clear_len, 0
    ok01 = and initial_len_ok, initial_cap_ok
    ok02 = and ok01, initial_empty_ok
    ok03 = and ok02, pushed_len_ok
    ok04 = and ok03, pushed_eq_ok
    ok05 = and ok04, reserve_flag_ok
    ok06 = and ok05, reserved_cap_ok
    ok07 = and ok06, shrink_to_cap_ok
    ok08 = and ok07, shrink_fit_cap_ok
    ok09 = and ok08, truncate_len_ok
    ok = and ok09, clear_len_ok
    !initial_len
    !initial_cap
    !initial_empty
    !pushed_len
    !pushed_view
    !pushed_eq
    !reserve_ok
    !reserved_cap
    !shrink_to_cap
    !shrink_fit_cap
    !truncate_len
    !clear_len
    !initial_len_ok
    !initial_cap_ok
    !initial_empty_ok
    !pushed_len_ok
    !pushed_eq_ok
    !reserve_flag_ok
    !reserved_cap_ok
    !shrink_to_cap_ok
    !shrink_fit_cap_ok
    !truncate_len_ok
    !clear_len_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    !ok06
    !ok07
    !ok08
    !ok09
    EXPAND STRING_BUF_FREE string_buf
    !left
    !suffix
    !expected
    br ok -> L_STRING_BUF_OK, L_STRING_BUF_FAIL

L_STRING_BUF_FAIL:
    !ok
    panic(906)

L_STRING_BUF_OK:
    !ok
    return

@test "sa_std string buffer extend_from_within macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS left, &JOIN_LEFT, 4
    EXPAND STR_FROM_PARTS suffix, &BUF_SUFFIX, 3
    EXPAND STR_FROM_PARTS expected, &BUF_EXTEND_WITHIN_EXPECTED, 10
    EXPAND STR_FROM_PARTS alias_expected, &BUF_EXTEND_WITHIN_ALIAS_EXPECTED, 11
    EXPAND STR_FROM_PARTS utf8_expected, &UTF8_BOUNDARY_TEXT, 8
    EXPAND STRING_BUF_WITH_CAPACITY string_buf, 8
    EXPAND STRING_BUF_PUSH_STR string_buf, left
    EXPAND STRING_BUF_PUSH_BYTE string_buf, 45
    EXPAND STRING_BUF_PUSH_STR string_buf, suffix
    EXPAND STRING_BUF_TRY_EXTEND_FROM_WITHIN extend_ok, string_buf, 1, 2
    EXPAND STRING_BUF_AS_STR after_extend, string_buf
    EXPAND STR_EQ after_extend_eq, after_extend, expected
    EXPAND STRING_BUF_EXTEND_FROM_WITHIN string_buf, 0, 1
    EXPAND STRING_BUF_AS_STR after_alias, string_buf
    EXPAND STR_EQ after_alias_eq, after_alias, alias_expected
    EXPAND STRING_BUF_TRY_EXTEND_FROM_WITHIN miss_ok, string_buf, 99, 1
    EXPAND STRING_BUF_AS_STR after_miss, string_buf
    EXPAND STR_EQ after_miss_eq, after_miss, alias_expected
    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED utf8_buf, utf8_expected
    EXPAND STRING_BUF_TRY_EXTEND_FROM_WITHIN boundary_miss_ok, utf8_buf, 2, 1
    EXPAND STRING_BUF_AS_STR after_boundary_miss, utf8_buf
    EXPAND STR_EQ after_boundary_miss_eq, after_boundary_miss, utf8_expected
    extend_flag_ok = eq extend_ok, 1
    after_extend_ok = eq after_extend_eq, 1
    after_alias_ok = eq after_alias_eq, 1
    miss_flag_ok = eq miss_ok, 0
    after_miss_ok = eq after_miss_eq, 1
    boundary_miss_flag_ok = eq boundary_miss_ok, 0
    boundary_miss_value_ok = eq after_boundary_miss_eq, 1
    ok01 = and extend_flag_ok, after_extend_ok
    ok02 = and ok01, after_alias_ok
    ok03 = and ok02, miss_flag_ok
    ok04 = and ok03, after_miss_ok
    ok05 = and ok04, boundary_miss_flag_ok
    ok = and ok05, boundary_miss_value_ok
    !left
    !suffix
    !expected
    !alias_expected
    !utf8_expected
    !extend_ok
    !after_extend
    !after_extend_eq
    !after_alias
    !after_alias_eq
    !miss_ok
    !after_miss
    !after_miss_eq
    !boundary_miss_ok
    !after_boundary_miss
    !after_boundary_miss_eq
    !extend_flag_ok
    !after_extend_ok
    !after_alias_ok
    !miss_flag_ok
    !after_miss_ok
    !boundary_miss_flag_ok
    !boundary_miss_value_ok
    !ok01
    !ok02
    !ok03
    !ok04
    !ok05
    EXPAND STRING_BUF_FREE utf8_buf
    EXPAND STRING_BUF_FREE string_buf
    br ok -> L_STRING_BUF_EFW_OK, L_STRING_BUF_EFW_FAIL

L_STRING_BUF_EFW_FAIL:
    !ok
    panic(911)

L_STRING_BUF_EFW_OK:
    !ok
    return

@test "sa_std string owned buffer mutation macros"():
L_ENTRY:
    EXPAND STR_FROM_PARTS left, &JOIN_LEFT, 4
    EXPAND STR_FROM_PARTS suffix, &BUF_SUFFIX, 3
    EXPAND STR_FROM_PARTS insert_text, &BUF_LANG, 5
    EXPAND STR_FROM_PARTS replace_text, &BUF_CORE, 4
    EXPAND STR_FROM_PARTS expected_after_byte, &BUF_INSERT_BYTE_EXPECTED, 9
    EXPAND STR_FROM_PARTS expected_after_insert, &BUF_INSERT_STR_EXPECTED, 14
    EXPAND STR_FROM_PARTS expected_after_replace, &BUF_REPLACE_EXPECTED, 14
    EXPAND STR_FROM_PARTS expected_split_left, &BUF_SPLIT_LEFT_EXPECTED, 9
    EXPAND STR_FROM_PARTS expected_split_tail, &BUF_SPLIT_TAIL_EXPECTED, 4

    EXPAND STRING_BUF_NEW string_buf
    EXPAND STRING_BUF_PUSH_STR string_buf, left
    EXPAND STRING_BUF_PUSH_BYTE string_buf, 45
    EXPAND STRING_BUF_PUSH_STR string_buf, suffix
    EXPAND STRING_BUF_TRY_INSERT_BYTE insert_byte_ok, string_buf, 8, 33
    EXPAND STRING_BUF_AS_STR after_byte, string_buf
    EXPAND STR_EQ after_byte_eq, after_byte, expected_after_byte
    EXPAND STRING_BUF_TRY_INSERT_STR insert_str_ok, string_buf, 5, insert_text
    EXPAND STRING_BUF_AS_STR after_insert, string_buf
    EXPAND STR_EQ after_insert_eq, after_insert, expected_after_insert
    EXPAND STRING_BUF_TRY_REPLACE_RANGE replace_ok, string_buf, 5, 4, replace_text
    EXPAND STRING_BUF_AS_STR after_replace, string_buf
    EXPAND STR_EQ after_replace_eq, after_replace, expected_after_replace
    EXPAND STRING_BUF_TRY_POP_BYTE pop_ok, pop_byte, string_buf
    EXPAND STRING_BUF_TRY_SPLIT_OFF split_ok, split_tail, string_buf, 9
    EXPAND STRING_BUF_AS_STR split_left, string_buf
    EXPAND STRING_BUF_AS_STR split_tail_view, split_tail
    EXPAND STR_EQ split_left_eq, split_left, expected_split_left
    EXPAND STR_EQ split_tail_eq, split_tail_view, expected_split_tail
    EXPAND STRING_BUF_TRY_INSERT_BYTE insert_miss_ok, string_buf, 99, 63
    EXPAND STRING_BUF_TRY_INSERT_STR insert_str_miss_ok, string_buf, 99, insert_text
    EXPAND STRING_BUF_TRY_REPLACE_RANGE replace_miss_ok, string_buf, 6, 99, replace_text
    EXPAND STRING_BUF_CLEAR string_buf
    EXPAND STRING_BUF_TRY_POP_BYTE pop_empty_ok, pop_empty_byte, string_buf
    EXPAND STRING_BUF_TRY_SPLIT_OFF split_empty_ok, split_empty_tail, string_buf, 0
    EXPAND STRING_BUF_LEN split_empty_tail_len, split_empty_tail

    insert_byte_flag_ok = eq insert_byte_ok, 1
    after_byte_ok = eq after_byte_eq, 1
    insert_str_flag_ok = eq insert_str_ok, 1
