    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED utf8_buf, utf8_source
    EXPAND STRING_BUF_TRY_DRAIN drain_ok, drained, utf8_buf, 1, 6
    EXPAND STRING_BUF_AS_STR drained_view, drained
    EXPAND STRING_BUF_AS_STR utf8_after, utf8_buf
    EXPAND STR_EQ drained_eq, drained_view, utf8_removed_expected
    EXPAND STR_EQ utf8_after_eq, utf8_after, utf8_remaining_expected

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED alias_buf, ascii_source
    EXPAND STRING_BUF_DRAIN alias_ok, alias_drained, alias_buf, 4, 1
    EXPAND STRING_BUF_AS_STR alias_drained_view, alias_drained
