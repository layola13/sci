    alias_value_ok = eq alias_eq, 1
    continuation_flag_ok = eq continuation_ok, 0
    continuation_cp_ok = eq continuation_cp, 0
    continuation_value_ok = eq continuation_eq, 1
    end_flag_ok = eq end_ok, 0
    end_cp_ok = eq end_cp, 0
    end_value_ok = eq end_eq, 1
