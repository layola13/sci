    EXPAND STRING_TRY_GET_SUFFIX suffix_smile_z_ok, suffix_smile_z, utf8_boundary, 3
    EXPAND STR_TRY_GET_SUFFIX suffix_z_ok, suffix_z, utf8_boundary, 7
    EXPAND STR_TRY_GET_RANGE_TO range_to_ae_ok, range_to_ae, utf8_boundary, 3
    EXPAND STRING_TRY_GET_RANGE_FROM range_from_smile_z_ok, range_from_smile_z, utf8_boundary, 3
    EXPAND STR_TRY_GET_RANGE_BETWEEN between_smile_ok, between_smile, utf8_boundary, 3, 7
    EXPAND STRING_TRY_GET_RANGE_BETWEEN between_bad_order_ok, between_bad_order, utf8_boundary, 7, 3
    EXPAND STR_TRY_SPLIT_AT_CHECKED split_checked_ok, split_checked_left, split_checked_right, utf8_boundary, 3
    EXPAND STRING_TRY_SPLIT_AT_CHECKED split_checked_bad_ok, split_checked_bad_left, split_checked_bad_right, utf8_boundary, 4
    EXPAND STR_EQ range_e_eq, range_e, utf8_e
    EXPAND STR_EQ range_smile_eq, range_smile, utf8_smile
    EXPAND STR_IS_EMPTY range_bad_start_empty, range_bad_start
    EXPAND STR_IS_EMPTY range_bad_end_empty, range_bad_end
    EXPAND STR_EQ prefix_ae_eq, prefix_ae, utf8_a_e
    EXPAND STR_EQ suffix_smile_z_eq, suffix_smile_z, utf8_smile_z
    EXPAND STR_EQ suffix_z_eq, suffix_z, utf8_z
    EXPAND STR_EQ range_to_ae_eq, range_to_ae, utf8_a_e
    EXPAND STR_EQ range_from_smile_z_eq, range_from_smile_z, utf8_smile_z
    EXPAND STR_EQ between_smile_eq, between_smile, utf8_smile
    EXPAND STR_IS_EMPTY between_bad_order_empty, between_bad_order
    EXPAND STR_EQ split_checked_left_eq, split_checked_left, utf8_a_e
    EXPAND STR_EQ split_checked_right_eq, split_checked_right, utf8_smile_z
    EXPAND STR_IS_EMPTY split_checked_bad_left_empty, split_checked_bad_left
    EXPAND STR_IS_EMPTY split_checked_bad_right_empty, split_checked_bad_right
    EXPAND STR_TRIM_ASCII trim_both, spaced
    EXPAND STR_TRIM_ASCII_START trim_start, leading
    EXPAND STR_TRIM_ASCII_END trim_end, trailing
    EXPAND STR_TRY_SPLIT_ONCE split_once_ok, split_once_left, split_once_right, pathish, colon
    EXPAND STRING_TRY_RSPLIT_ONCE rsplit_once_ok, rsplit_once_left, rsplit_once_right, pathish, colon
    EXPAND STR_TRY_SPLIT_ONCE split_once_miss_ok, split_once_miss_left, split_once_miss_right, pathish, miss
    EXPAND STR_EQ trim_both_eq, trim_both, title_word
    EXPAND STR_EQ trim_start_eq, trim_start, title_word
    EXPAND STR_EQ trim_end_eq, trim_end, title_word
    EXPAND STR_EQ split_once_left_eq, split_once_left, expected_left
    EXPAND STR_EQ split_once_right_eq, split_once_right, expected_right
    EXPAND STR_EQ rsplit_once_left_eq, rsplit_once_left, expected_rleft
    EXPAND STR_EQ rsplit_once_right_eq, rsplit_once_right, expected_rright
    EXPAND STR_IS_EMPTY split_once_miss_left_empty, split_once_miss_left
    EXPAND STR_IS_EMPTY split_once_miss_right_empty, split_once_miss_right

    ascii_ok = eq is_ascii, 1
    ascii_case_ok = eq ascii_case_eq, 1
    boundary0_ok = eq boundary0, 1
    boundary1_ok = eq boundary1, 1
    boundary2_ok = eq boundary2, 0
    boundary3_ok = eq boundary3, 1
