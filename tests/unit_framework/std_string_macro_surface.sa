    !first_before
    !first_after
    !content_eq
    !len_ok
    !first_before_ok
    !first_after_ok
    !content_ok
    !ok01
    !ok02
    !leaked
    br ok -> L_STRING_BUF_LEAK_OK, L_STRING_BUF_LEAK_FAIL

