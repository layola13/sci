    EXPAND STR_TRY_GET_RANGE range_e_ok, range_e, utf8_boundary, 1, 2
    EXPAND STRING_TRY_GET_RANGE range_smile_ok, range_smile, utf8_boundary, 3, 4
    EXPAND STR_TRY_GET_RANGE range_bad_start_ok, range_bad_start, utf8_boundary, 2, 1
