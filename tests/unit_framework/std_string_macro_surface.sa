    store le_ptr+3, 0 as u8
    store le_ptr+4, 61 as u8
    store le_ptr+5, 216 as u8
    store le_ptr+6, 66 as u8
    store le_ptr+7, 222 as u8
    store le_ptr+8, 122 as u8
    store le_ptr+9, 0 as u8
