    EXPAND STR_FROM_PARTS remove_multi_expected, &BUF_REMOVE_MULTI_EXPECTED, 4
    EXPAND STR_FROM_PARTS replace_long_needle, &BUF_REPLACE_LONG_NEEDLE, 12
    EXPAND STR_EMPTY empty_needle

    bad_ptr = stack_alloc 3
    store bad_ptr+0, 114 as u8
    bad_ptr_1 = ptr_add bad_ptr, 1
    store bad_ptr_1+0, 255 as u8
    bad_ptr_2 = ptr_add bad_ptr, 2
    store bad_ptr_2+0, 115 as u8
    EXPAND STR_FROM_PARTS bad_bytes, bad_ptr, 3

    EXPAND STRING_BUF_FROM_UTF8_UNCHECKED unchecked_buf, left
