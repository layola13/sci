    ok02 = and ok01, drain_remaining_ok
    ok03 = and ok02, alias_flag_ok
    ok04 = and ok03, alias_value_ok
    ok05 = and ok04, alias_remaining_ok
    ok06 = and ok05, miss_flag_ok
    ok07 = and ok06, miss_value_ok
    ok = and ok07, miss_remaining_ok
