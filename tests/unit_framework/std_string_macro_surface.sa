    !ascii_bad_empty_ok
    !utf8_full_flag_ok
    !utf8_full_value_ok
    !utf8_bad_flag_ok
    !utf8_bad_empty_ok
    !replace_value_ok
    !replace_first_flag_ok
    !replace_first_value_ok
