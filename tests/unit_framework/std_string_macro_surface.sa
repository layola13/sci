    EXPAND STRING_BUF_TRY_FROM_ASCII_CHARS invalid_from_ok, invalid_from_buf, invalid_ascii_slice
    EXPAND STRING_BUF_LEN invalid_from_len, invalid_from_buf
    EXPAND STRING_BUF_NEW invalid_extend_buf
    EXPAND STRING_BUF_TRY_EXTEND_ASCII_CHARS invalid_extend_ok, invalid_extend_buf, invalid_ascii_slice
    EXPAND STRING_BUF_LEN invalid_extend_len, invalid_extend_buf

    invalid_ascii_ref = stack_alloc 1
    invalid_ascii_refs_ptr = stack_alloc 8
    store invalid_ascii_ref+0, 200 as u8
    store invalid_ascii_refs_ptr+0, invalid_ascii_ref as ptr
    invalid_ascii_refs_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW invalid_ascii_refs_slice, invalid_ascii_refs_ptr, 1
    EXPAND STRING_BUF_TRY_FROM_ASCII_CHAR_REFS invalid_ref_from_ok, invalid_ref_from_buf, invalid_ascii_refs_slice
    EXPAND STRING_BUF_LEN invalid_ref_from_len, invalid_ref_from_buf
    EXPAND STRING_BUF_NEW invalid_ref_extend_buf
    EXPAND STRING_BUF_TRY_EXTEND_ASCII_CHAR_REFS invalid_ref_extend_ok, invalid_ref_extend_buf, invalid_ascii_refs_slice
    EXPAND STRING_BUF_LEN invalid_ref_extend_len, invalid_ref_extend_buf

    from_flag_ok = eq from_ok, 1
    from_value_ok = eq from_eq, 1
    extend_value_ok = eq extend_eq, 1
    ref_from_flag_ok = eq ref_from_ok, 1
    ref_from_value_ok = eq ref_from_eq, 1
    ref_extend_value_ok = eq ref_extend_eq, 1
    invalid_from_flag_ok = eq invalid_from_ok, 0
    invalid_from_empty_ok = eq invalid_from_len, 0
    invalid_extend_flag_ok = eq invalid_extend_ok, 0
    invalid_extend_empty_ok = eq invalid_extend_len, 0
    invalid_ref_from_flag_ok = eq invalid_ref_from_ok, 0
    invalid_ref_from_empty_ok = eq invalid_ref_from_len, 0
    invalid_ref_extend_flag_ok = eq invalid_ref_extend_ok, 0
    invalid_ref_extend_empty_ok = eq invalid_ref_extend_len, 0
    ok01 = and from_flag_ok, from_value_ok
    ok02 = and ok01, extend_value_ok
    ok03 = and ok02, ref_from_flag_ok
    ok04 = and ok03, ref_from_value_ok
    ok05 = and ok04, ref_extend_value_ok
    ok06 = and ok05, invalid_from_flag_ok
    ok07 = and ok06, invalid_from_empty_ok
    ok08 = and ok07, invalid_extend_flag_ok
    ok09 = and ok08, invalid_extend_empty_ok
    ok10 = and ok09, invalid_ref_from_flag_ok
    ok11 = and ok10, invalid_ref_from_empty_ok
    ok12 = and ok11, invalid_ref_extend_flag_ok
    ok = and ok12, invalid_ref_extend_empty_ok
    !from_ok
    !from_view
    !from_eq
    !extend_view
    !extend_eq
    !ref_from_ok
    !ref_from_view
    !ref_from_eq
    !ref_extend_view
    !ref_extend_eq
    !invalid_from_ok
    !invalid_from_len
    !invalid_extend_ok
    !invalid_extend_len
    !invalid_ref_from_ok
