    slice_data = alloc 16
    store slice_data+0, 44 as u64
    store slice_data+8, 55 as u64
    from_slice_view = alloc Slice_SIZE
    EXPAND SLICE_NEW from_slice_view, slice_data, 2
    EXPAND VEC_FROM_SLICE_U64 from_slice_vec, from_slice_view
    EXPAND VEC_FROM_MUT_SLICE_U64 from_mut_slice_vec, from_slice_view
    EXPAND VEC_FROM_ARRAY_U64 from_array_vec, from_slice_view
    EXPAND VEC_FROM_MUT_ARRAY_U64 from_mut_array_vec, from_slice_view

    EXPAND VEC_GET_MUT_PTR_U64 source_first_ptr, source, 0
    store source_first_ptr+0, 77 as u64
    EXPAND VEC_TRY_GET_U64 source_first_ok, source_first, source, 0
    EXPAND VEC_TRY_GET_U64 cloned_first_ok, cloned_first, cloned, 0
    EXPAND VEC_TRY_GET_U64 cloned_second_ok, cloned_second, cloned, 1
    EXPAND VEC_TRY_GET_U64 clone_from_first_ok, clone_from_first, clone_from_dst, 0
    EXPAND VEC_TRY_GET_U64 clone_from_third_ok, clone_from_third, clone_from_dst, 2
    EXPAND VEC_LEN clone_from_len, clone_from_dst
    EXPAND VEC_LEN from_slice_len, from_slice_vec
    EXPAND VEC_TRY_GET_U64 from_slice_first_ok, from_slice_first, from_slice_vec, 0
    EXPAND VEC_TRY_GET_U64 from_slice_second_ok, from_slice_second, from_slice_vec, 1
