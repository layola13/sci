@import "sa_std/string.sa"
@import "sa_std/vec.sa"
@import "sa_std/core/slice.sa"

@const WORD = utf8:"rust"
@const TITLE_WORD = utf8:"Rust"
@const PREFIX = utf8:"ru"
@const SUFFIX = utf8:"st"
@const INFIX = utf8:"us"
@const REPEATED = utf8:"ana"
@const MISS = utf8:"zz"
@const PATHISH = utf8:"a:b:c"
@const COLON = utf8:":"
@const PATH_LEFT = utf8:"a"
@const PATH_RIGHT = utf8:"b:c"
@const PATH_RLEFT = utf8:"a:b"
@const PATH_RRIGHT = utf8:"c"
