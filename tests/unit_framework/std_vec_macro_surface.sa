    remove_slot_value_ok = eq remove_slot, 66
    remove_miss_flag_ok = eq remove_miss_ok, 0
    remove_miss_value_ok = eq remove_miss, 0
    len_ok = eq len, 3
    len_after_resize_ok = eq len_after_resize, 5
    resize_fill1_flag_ok = eq resize_fill1_ok, 1
    resize_fill1_value_ok = eq resize_fill1, 123
    resize_fill2_flag_ok = eq resize_fill2_ok, 1
    resize_fill2_value_ok = eq resize_fill2, 123
    split_off_flag_ok = eq split_off_ok, 1
