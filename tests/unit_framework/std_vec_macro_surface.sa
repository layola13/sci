    ok06 = and ok05, vec_lower_30_idx_ok
    ok07 = and ok06, vec_upper_20_idx_ok
    ok08 = and ok07, vec_upper_4_idx_ok
    ok09 = and ok08, vec_eq20_start_ok
    ok10 = and ok09, vec_eq20_end_ok
    ok11 = and ok10, vec_eq30_start_ok
    ok = and ok11, vec_eq30_end_ok

    !vec_bs_hit_ok
    !vec_bs_hit_idx
    !vec_bs_miss_ok
    !vec_bs_miss_idx
    !vec_partition_idx
    !vec_lower_20_idx
    !vec_lower_30_idx
    !vec_upper_20_idx
    !vec_upper_4_idx
    !vec_eq20_start
    !vec_eq20_end
    !vec_eq30_start
    !vec_eq30_end
    !vec_bs_hit_flag_ok
    !vec_bs_hit_idx_ok
    !vec_bs_miss_flag_ok
    !vec_bs_miss_idx_ok
    !vec_partition_idx_ok
    !vec_lower_20_idx_ok
    !vec_lower_30_idx_ok
    !vec_upper_20_idx_ok
