    drain_flag_ok = eq drain_ok, 1
    vec_len_after_drain_ok = eq vec_len_after_drain, 3
    drained_len_ok = eq drained_len, 2
    vec_first_flag_ok = eq vec_first_ok, 1
    vec_first_value_ok = eq vec_first, 1
    vec_second_flag_ok = eq vec_second_ok, 1
    vec_second_value_ok = eq vec_second, 4
    vec_third_flag_ok = eq vec_third_ok, 1
    vec_third_value_ok = eq vec_third, 5
    drained_first_flag_ok = eq drained_first_ok, 1
    drained_first_value_ok = eq drained_first, 2
    drained_second_flag_ok = eq drained_second_ok, 1
    drained_second_value_ok = eq drained_second, 3
    drain_miss_flag_ok = eq drain_miss_ok, 0
    drain_miss_len_ok = eq drain_miss_len, 0
    splice_flag_ok = eq splice_ok, 1
    splice_vec_len_ok = eq splice_vec_len, 4
    spliced_len_ok = eq spliced_len, 2
    splice_first_flag_ok = eq splice_first_ok, 1
    splice_first_value_ok = eq splice_first, 10
    splice_second_flag_ok = eq splice_second_ok, 1
    splice_second_value_ok = eq splice_second, 77
    splice_third_flag_ok = eq splice_third_ok, 1
    splice_third_value_ok = eq splice_third, 88
    splice_fourth_flag_ok = eq splice_fourth_ok, 1
    splice_fourth_value_ok = eq splice_fourth, 40
    spliced_first_flag_ok = eq spliced_first_ok, 1
    spliced_first_value_ok = eq spliced_first, 20
    spliced_second_flag_ok = eq spliced_second_ok, 1
