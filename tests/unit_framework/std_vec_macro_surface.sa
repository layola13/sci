@const UTF8_A_E = utf8:"aé"
@const UTF8_E_ACUTE = utf8:"é"
@const UTF8_SMILE = utf8:"🙂"
@const UTF8_SMILE_Z = utf8:"🙂z"
@const UTF8_Z = utf8:"z"

@vec_pop_if_is_99(value: u64) -> u64:
L_ENTRY:
    is_match = eq value, 99
    !value
    return is_match

@vec_pop_if_is_88(value: u64) -> u64:
L_ENTRY:
    is_match = eq value, 88
    !value
    return is_match

@vec_retain_even(value: u64) -> u64:
L_ENTRY:
    rem = urem value, 2
    is_even = eq rem, 0
    !rem
    !value
    return is_even

@vec_retain_mut_add_ten_keep_original_odd(value_ptr: ptr) -> u64:
L_ENTRY:
    value = load value_ptr+0 as u64
    next_value = add value, 10
    store value_ptr+0, next_value as u64
    rem = urem value, 2
    keep = eq rem, 1
    !next_value
    !rem
    !value
    !value_ptr
    return keep

@vec_resize_with_42() -> u64:
L_ENTRY:
    return 42

@vec_from_fn_double(index: u64) -> u64:
L_ENTRY:
    value = mul index, 2
    !index
    return value

@vec_dedup_by_same_tens(left: u64, right: u64) -> u64:
L_ENTRY:
    left_group = udiv left, 10
    right_group = udiv right, 10
    same = eq left_group, right_group
    !left_group
    !right_group
    !left
    !right
    return same

@vec_key_tens(value: u64) -> u64:
L_ENTRY:
    key = udiv value, 10
    !value
    return key

@vec_extract_if_gt_30(value: u64) -> u64:
L_ENTRY:
    take = ugt value, 30
    !value
    return take

@const VEC_FN_PTR_FALSE_VT = vtable { call = @vec_fn_ptr_false }
@const VEC_FN_PTR_TRUE_VT = vtable { call = @vec_fn_ptr_true }

@vec_fn_ptr_false(value: u64) -> u64:
L_ENTRY:
    !value
    return 0

@vec_fn_ptr_true(value: u64) -> u64:
L_ENTRY:
    !value
    return 1

@slice_partition_lt_30(value: u64) -> u64:
L_ENTRY:
    keep = ult value, 30
    !value
    return keep

@slice_sorted_le(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = ule left, right
    !left
    !right
    return ok

@slice_sorted_lt(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = ult left, right
    !left
    !right
    return ok

@slice_sorted_ge(left: u64, right: u64) -> u64:
L_ENTRY:
    ok = uge left, right
    !left
    !right
    return ok

@slice_sorted_key_tens(value: u64) -> u64:
L_ENTRY:
    key = udiv value, 10
    !value
    return key

@slice_fill_with_77() -> u64:
L_ENTRY:
    return 77

@test "sa_std vec convenience macros"():
L_ENTRY:
    EXPAND VEC_WITH_CAPACITY_U64 vec, 2
    EXPAND VEC_PUSH_U64 vec, 44
    EXPAND VEC_PUSH_U64 vec, 55
    append_src_data = alloc 16
    store append_src_data+0, 66 as u64
    store append_src_data+8, 77 as u64
    append_src_slice = alloc Slice_SIZE
    EXPAND SLICE_NEW append_src_slice, append_src_data, 2
    EXPAND VEC_EXTEND_FROM_SLICE_U64 vec, append_src_slice
    EXPAND VEC_TRY_GET_U64 after_extend_ok, after_extend, vec, 3
    EXPAND VEC_TRY_EXTEND_FROM_WITHIN_U64 extend_within_ok, vec, 1, 2
    EXPAND VEC_TRY_GET_U64 extend_within_first_ok, extend_within_first, vec, 4
    EXPAND VEC_TRY_GET_U64 extend_within_second_ok, extend_within_second, vec, 5
    EXPAND VEC_TRY_EXTEND_FROM_WITHIN_U64 extend_within_miss_ok, vec, 9, 1
    EXPAND VEC_LEN len_after_extend_within, vec
    EXPAND VEC_EXTEND_FROM_WITHIN_U64 vec, 0, 1
    EXPAND VEC_TRY_GET_U64 extend_within_alias_ok, extend_within_alias, vec, 6
    EXPAND VEC_LEN len_after_extend_within_alias, vec
    EXPAND VEC_WITH_CAPACITY_U64 append_src_vec, 2
    EXPAND VEC_PUSH_U64 append_src_vec, 88
    EXPAND VEC_PUSH_U64 append_src_vec, 99
    EXPAND VEC_APPEND_U64 vec, append_src_vec
    EXPAND VEC_TRY_GET_U64 after_append_ok, after_append, vec, 8
    EXPAND VEC_LEN append_src_len_after, append_src_vec
    EXPAND VEC_TRY_POP_IF_U64 pop_if_miss_ok, pop_if_miss, vec, @vec_pop_if_is_88
    EXPAND VEC_LEN len_after_pop_if_miss, vec
    EXPAND VEC_TRY_POP_IF_U64 pop_if_hit_ok, pop_if_hit, vec, @vec_pop_if_is_99
    EXPAND VEC_LEN len_after_pop_if_hit, vec
    EXPAND VEC_POP_IF_U64 pop_if_alias_ok, pop_if_alias, vec, @vec_pop_if_is_88
    EXPAND VEC_LEN len_after_pop_if_alias, vec
    EXPAND VEC_WITH_CAPACITY_U64 pop_if_empty_vec, 0
    EXPAND VEC_TRY_POP_IF_U64 pop_if_empty_ok, pop_if_empty, pop_if_empty_vec, @vec_pop_if_is_99
    prefix_data = alloc 8
    suffix_data = alloc 8
    miss_prefix_data = alloc 8
    long_suffix_data = alloc 24
    store prefix_data+0, 44 as u64
    store suffix_data+0, 44 as u64
    store miss_prefix_data+0, 66 as u64
    store long_suffix_data+0, 44 as u64
    store long_suffix_data+8, 55 as u64
    store long_suffix_data+16, 66 as u64
    prefix = alloc Slice_SIZE
    suffix = alloc Slice_SIZE
    miss_prefix = alloc Slice_SIZE
    long_suffix = alloc Slice_SIZE
    EXPAND SLICE_NEW prefix, prefix_data, 1
    EXPAND SLICE_NEW suffix, suffix_data, 1
    EXPAND SLICE_NEW miss_prefix, miss_prefix_data, 1
    EXPAND SLICE_NEW long_suffix, long_suffix_data, 3
    EXPAND VEC_RESERVE_EXACT_U64 vec, 2
    EXPAND VEC_CAPACITY cap_exact, vec
    EXPAND VEC_RESERVE_U64 vec, 0
    EXPAND VEC_CAPACITY cap, vec
    EXPAND VEC_GET_U64 got, vec, 1
    EXPAND VEC_GET_U64 got_miss, vec, 99
    EXPAND VEC_GET_UNCHECKED got_unchecked, vec, 1
    EXPAND VEC_FRONT front, vec
    EXPAND VEC_BACK back, vec
    EXPAND VEC_TRY_FRONT_U64 front_try_ok, front_try, vec
    EXPAND VEC_TRY_BACK_U64 back_try_ok, back_try, vec
    EXPAND VEC_CONTAINS_U64 contains_55, vec, 55
    EXPAND VEC_CONTAINS_U64 contains_123, vec, 123
    EXPAND VEC_STARTS_WITH_U64 starts_ok, vec, prefix
    EXPAND VEC_ENDS_WITH_U64 ends_ok, vec, suffix
    EXPAND VEC_STARTS_WITH_U64 starts_miss, vec, miss_prefix
    EXPAND VEC_ENDS_WITH_U64 ends_long_miss, vec, long_suffix
    EXPAND VEC_TRY_STRIP_PREFIX_U64 strip_prefix_ok, strip_prefix_tail, vec, prefix
    EXPAND VEC_TRY_STRIP_SUFFIX_U64 strip_suffix_ok, strip_suffix_head, vec, suffix
    EXPAND VEC_TRY_STRIP_PREFIX_U64 strip_prefix_miss_ok, strip_prefix_miss, vec, miss_prefix
    EXPAND SLICE_GET_LEN strip_prefix_tail_len, strip_prefix_tail
    EXPAND SLICE_FIRST_U64 strip_prefix_tail_first, strip_prefix_tail
    EXPAND SLICE_GET_LEN strip_suffix_head_len, strip_suffix_head
    EXPAND SLICE_FIRST_U64 strip_suffix_head_first, strip_suffix_head
    EXPAND SLICE_IS_EMPTY strip_prefix_miss_empty, strip_prefix_miss
    EXPAND VEC_TRY_POP_U64 pop_ok, popped, vec
    EXPAND VEC_AS_PTR data_ptr, vec
    EXPAND VEC_AS_SLICE slice, vec
    EXPAND SLICE_GET_LEN slice_len, slice
    EXPAND VEC_TRY_SWAP_REMOVE_U64 swap_remove_ok, swap_removed, vec, 1
    EXPAND VEC_TRY_GET_U64 swap_slot_ok, swap_slot, vec, 1
    EXPAND VEC_TRY_SWAP_REMOVE_U64 swap_remove_miss_ok, swap_remove_miss, vec, 9
    EXPAND VEC_POP_U64 pop2_ok, popped2, vec
    EXPAND VEC_TRY_REMOVE_U64 remove_ok, removed, vec, 1
    EXPAND VEC_TRY_GET_U64 remove_slot_ok, remove_slot, vec, 1
    EXPAND VEC_TRY_REMOVE_U64 remove_miss_ok, remove_miss, vec, 9
    EXPAND VEC_LEN len, vec
    EXPAND VEC_RESIZE_U64 vec, 5, 123
    EXPAND VEC_LEN len_after_resize, vec
    EXPAND VEC_TRY_GET_U64 resize_fill1_ok, resize_fill1, vec, 3
    EXPAND VEC_TRY_GET_U64 resize_fill2_ok, resize_fill2, vec, 4
    EXPAND VEC_TRY_SPLIT_OFF_U64 split_off_ok, split_off_vec, vec, 2
    EXPAND VEC_LEN len_after_split_off, vec
    EXPAND VEC_LEN split_off_len, split_off_vec
    EXPAND VEC_TRY_GET_U64 split_off_first_ok, split_off_first, split_off_vec, 0
    EXPAND VEC_TRY_GET_U64 split_off_last_ok, split_off_last, split_off_vec, 2
    EXPAND VEC_TRY_SPLIT_OFF_U64 split_off_empty_ok, split_off_empty_vec, vec, 2
    EXPAND VEC_LEN len_after_empty_split_off, vec
    EXPAND VEC_LEN split_off_empty_len, split_off_empty_vec
    EXPAND VEC_TRY_SPLIT_OFF_U64 split_off_miss_ok, split_off_miss, vec, 9
    EXPAND VEC_TRY_FRONT_U64 front_after_ok, front_after, vec
    EXPAND VEC_TRY_BACK_U64 back_after_ok, back_after, vec

    got_ok = eq got, 55
    got_miss_ok = eq got_miss, 0
    got_unchecked_ok = eq got_unchecked, 55
    got_all = and got_ok, got_miss_ok
    got_all2 = and got_all, got_unchecked_ok
    after_extend_flag_ok = eq after_extend_ok, 1
    after_extend_value_ok = eq after_extend, 77
    extend_within_flag_ok = eq extend_within_ok, 1
    extend_within_first_flag_ok = eq extend_within_first_ok, 1
    extend_within_first_value_ok = eq extend_within_first, 55
    extend_within_second_flag_ok = eq extend_within_second_ok, 1
    extend_within_second_value_ok = eq extend_within_second, 66
    extend_within_miss_flag_ok = eq extend_within_miss_ok, 0
    len_after_extend_within_ok = eq len_after_extend_within, 6
    extend_within_alias_flag_ok = eq extend_within_alias_ok, 1
    extend_within_alias_value_ok = eq extend_within_alias, 44
    len_after_extend_within_alias_ok = eq len_after_extend_within_alias, 7
    after_append_flag_ok = eq after_append_ok, 1
    after_append_value_ok = eq after_append, 99
    append_src_len_after_ok = eq append_src_len_after, 0
    pop_if_miss_flag_ok = eq pop_if_miss_ok, 0
    pop_if_miss_value_ok = eq pop_if_miss, 0
    len_after_pop_if_miss_ok = eq len_after_pop_if_miss, 9
    pop_if_hit_flag_ok = eq pop_if_hit_ok, 1
    pop_if_hit_value_ok = eq pop_if_hit, 99
    len_after_pop_if_hit_ok = eq len_after_pop_if_hit, 8
    pop_if_alias_flag_ok = eq pop_if_alias_ok, 1
    pop_if_alias_value_ok = eq pop_if_alias, 88
    len_after_pop_if_alias_ok = eq len_after_pop_if_alias, 7
    pop_if_empty_flag_ok = eq pop_if_empty_ok, 0
    pop_if_empty_value_ok = eq pop_if_empty, 0
    cap_exact_ok = eq cap_exact, 9
    cap_ok = eq cap, 9
    front_ok = eq front, 44
    back_ok = eq back, 44
    front_try_flag_ok = eq front_try_ok, 1
    front_try_value_ok = eq front_try, 44
    back_try_flag_ok = eq back_try_ok, 1
    back_try_value_ok = eq back_try, 44
    contains_55_ok = eq contains_55, 1
    contains_123_ok = eq contains_123, 0
    starts_match_ok = eq starts_ok, 1
    ends_match_ok = eq ends_ok, 1
    starts_miss_ok = eq starts_miss, 0
    ends_long_miss_ok = eq ends_long_miss, 0
    strip_prefix_flag_ok = eq strip_prefix_ok, 1
    strip_suffix_flag_ok = eq strip_suffix_ok, 1
