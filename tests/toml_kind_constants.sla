// Regression test for the SLA-facing SA_TOML_KIND_* constants in
// sa_std/encoding/toml.sla: each constant is checked against the
// value sa_toml_kind actually writes into its out_kind parameter
// for a document holding a value of that kind.
//
// On a tree without toml.sla this file cannot even compile (the
// constants do not exist at any layer), which is what makes it a
// regression test for the constant face rather than for the runtime.

@import "sa_std/encoding/toml.sla"
@import "sa_std/status.sla"
@import "sa_std/string.sa"

@test "toml kind consts match sa_toml_kind out values"() {
    let doc: u64 = sa_toml_parse(STR_PTR("title = \"x\"\ncount = 42\nratio = 1.5\ndebug = true\nreleased = 2026-10-25T07:32:00Z\narr = [1, 2]\n[server]\nhost = \"h\"\n"), STR_LEN("title = \"x\"\ncount = 42\nratio = 1.5\ndebug = true\nreleased = 2026-10-25T07:32:00Z\narr = [1, 2]\n[server]\nhost = \"h\"\n"));
    if doc == 0 { panic(1201); };
    let k: u32 = 0;
    let s1: i32 = sa_toml_kind(doc, STR_PTR("title"), STR_LEN("title"), &k);
    if s1 != 0 { panic(1202); };
    if k == SA_TOML_KIND_STRING { } else { panic(1203); };
    let s2: i32 = sa_toml_kind(doc, STR_PTR("count"), STR_LEN("count"), &k);
    if s2 != 0 { panic(1204); };
    if k == SA_TOML_KIND_INTEGER { } else { panic(1205); };
    let s3: i32 = sa_toml_kind(doc, STR_PTR("ratio"), STR_LEN("ratio"), &k);
    if s3 != 0 { panic(1206); };
    if k == SA_TOML_KIND_FLOAT { } else { panic(1207); };
    let s4: i32 = sa_toml_kind(doc, STR_PTR("debug"), STR_LEN("debug"), &k);
    if s4 != 0 { panic(1208); };
    if k == SA_TOML_KIND_BOOL { } else { panic(1209); };
    let s5: i32 = sa_toml_kind(doc, STR_PTR("released"), STR_LEN("released"), &k);
    if s5 != 0 { panic(1210); };
    if k == SA_TOML_KIND_DATETIME { } else { panic(1211); };
    let s6: i32 = sa_toml_kind(doc, STR_PTR("arr"), STR_LEN("arr"), &k);
    if s6 != 0 { panic(1212); };
    if k == SA_TOML_KIND_ARRAY { } else { panic(1213); };
    let s7: i32 = sa_toml_kind(doc, STR_PTR("server"), STR_LEN("server"), &k);
    if s7 != 0 { panic(1214); };
    if k == SA_TOML_KIND_TABLE { } else { panic(1215); };
    let s8: i32 = sa_toml_kind(doc, STR_PTR(""), STR_LEN(""), &k);
    if s8 != 0 { panic(1216); };
    if k == SA_TOML_KIND_TABLE { } else { panic(1217); };
    let f: i32 = sa_toml_free(doc);
};

@test "missing path leaves SA_TOML_KIND_UNDEFINED and reports NOT_FOUND"() {
    let doc: u64 = sa_toml_parse(STR_PTR("a = 1\n"), STR_LEN("a = 1\n"));
    if doc == 0 { panic(1221); };
    let k: u32 = 77;
    let st: i32 = sa_toml_kind(doc, STR_PTR("missing"), STR_LEN("missing"), &k);
    if st == SA_STD_ERR_NOT_FOUND { } else { panic(1222); };
    if k == SA_TOML_KIND_UNDEFINED { } else { panic(1223); };
    let f: i32 = sa_toml_free(doc);
};

@test "toml kind predicates agree with sa_toml_kind"() {
    let doc: u64 = sa_toml_parse(STR_PTR("title = \"x\"\narr = [1, 2]\n[server]\nhost = \"h\"\n"), STR_LEN("title = \"x\"\narr = [1, 2]\n[server]\nhost = \"h\"\n"));
    if doc == 0 { panic(1231); };
    if sa_toml_is_string(doc, STR_PTR("title"), STR_LEN("title")) { } else { panic(1232); };
    if sa_toml_is_array(doc, STR_PTR("arr"), STR_LEN("arr")) { } else { panic(1233); };
    if sa_toml_is_table(doc, STR_PTR("server"), STR_LEN("server")) { } else { panic(1234); };
    if sa_toml_is_string(doc, STR_PTR("server"), STR_LEN("server")) { panic(1235); };
    if sa_toml_is_string(doc, STR_PTR("missing"), STR_LEN("missing")) { panic(1236); };
    let f: i32 = sa_toml_free(doc);
};
