// Loopback client tests for sa_std/dns.sla's UDP query client,
// run against the fixed-response stub in tests/dns_loopback_stub.py
// (UDP 127.0.0.1:5399). Use tests/run_dns_loopback_tests.sh, which
// starts the stub, runs this file, and stops the stub. No public
// DNS is involved: every answer comes from the stub's fixed zone
// (documented at the top of the stub).

@import "sa_std/dns.sla"

fn tb(text: ptr, text_len: u64) -> Vec<u8> {
    let arr: [u8; 128] = [0u8; 128];
    let dst: ptr = PTR_BYTE_ADD(&arr, 0);
    PTR_COPY_BYTES(dst, text, text_len);
    let out: Vec<u8> = Vec::new();
    let i: u64 = 0;
    while i < text_len {
        out.push(arr[i]);
        i = i + 1;
    }
    return out;
}

fn bytes_eq(a: Vec<u8>, b: Vec<u8>) -> bool {
    let n: u64 = len(a);
    if n != len(b) {
        return false;
    };
    let sa: Slice<u8> = VEC_AS_SLICE(a);
    let sb: Slice<u8> = VEC_AS_SLICE(b);
    let i: u64 = 0;
    while i < n {
        let x: u8 = 0;
        SLICE_GET(x, sa, i);
        let y: u8 = 0;
        SLICE_GET(y, sb, i);
        if x != y {
            return false;
        };
        i = i + 1;
    }
    return true;
}

fn stub_query(name: Vec<u8>, qtype: u16) -> DnsMessage {
    let server = tb(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    let r = dns_query(server, 5399, name, qtype, SA_DNS_CLASS_IN);
    match r {
        Ok(m) => {
            return m;
        },
        Err(e) => {
            panic(9000 + e);
        },
    };
}

fn first_answer(msg: DnsMessage, record_type: u16) -> DnsRecord {
    let recs = dns_records_of_type(msg, 0, record_type);
    if len(recs) != 1 {
        panic(9100);
    };
    let sl: Slice<DnsRecord> = VEC_AS_SLICE(recs);
    let rec = dns_empty_record();
    SLICE_GET(rec, sl, 0);
    return rec;
}

@test "loopback A answers"() {
    let msg = stub_query(tb(STR_PTR("example.test"), STR_LEN("example.test")), SA_DNS_TYPE_A);
    if msg.rcode != 0 { panic(4001); };
    if len(msg.answers) != 2 { panic(4002); };
    let recs = dns_records_of_type(msg, 0, SA_DNS_TYPE_A);
    let sl: Slice<DnsRecord> = VEC_AS_SLICE(recs);
    let r0 = dns_empty_record();
    SLICE_GET(r0, sl, 0);
    if r0.addr_v4 != 0x5db8d822 { panic(4003); };
    if r0.ttl != 300 { panic(4004); };
    if bytes_eq(r0.name, tb(STR_PTR("example.test"), STR_LEN("example.test"))) != true { panic(4005); };
    let r1 = dns_empty_record();
    SLICE_GET(r1, sl, 1);
    if r1.addr_v4 != 0x5db8d823 { panic(4006); };
}

@test "loopback AAAA answer"() {
    let msg = stub_query(tb(STR_PTR("example.test"), STR_LEN("example.test")), SA_DNS_TYPE_AAAA);
    let rec = first_answer(msg, SA_DNS_TYPE_AAAA);
    if len(rec.addr_v6) != 16 { panic(4101); };
    let want: Vec<u8> = Vec::new();
    let raw: [u8; 16] = [0x26, 0x06, 0x28, 0x00, 0x02, 0x20, 0x00, 0x01, 0x02, 0x48, 0x18, 0x93, 0x25, 0xc8, 0x19, 0x46];
    let i: u64 = 0;
    while i < 16 {
        want.push(raw[i]);
        i = i + 1;
    }
    if bytes_eq(rec.addr_v6, want) != true { panic(4102); };
}

@test "loopback MX answer"() {
    let msg = stub_query(tb(STR_PTR("example.test"), STR_LEN("example.test")), SA_DNS_TYPE_MX);
    let rec = first_answer(msg, SA_DNS_TYPE_MX);
    if rec.preference != 10 { panic(4201); };
    if bytes_eq(rec.target, tb(STR_PTR("mail.example.test"), STR_LEN("mail.example.test"))) != true { panic(4202); };
}

@test "loopback NS answers"() {
    let msg = stub_query(tb(STR_PTR("example.test"), STR_LEN("example.test")), SA_DNS_TYPE_NS);
    let recs = dns_records_of_type(msg, 0, SA_DNS_TYPE_NS);
    if len(recs) != 2 { panic(4301); };
    let sl: Slice<DnsRecord> = VEC_AS_SLICE(recs);
    let r0 = dns_empty_record();
    SLICE_GET(r0, sl, 0);
    if bytes_eq(r0.target, tb(STR_PTR("ns1.example.test"), STR_LEN("ns1.example.test"))) != true { panic(4302); };
    let r1 = dns_empty_record();
    SLICE_GET(r1, sl, 1);
    if bytes_eq(r1.target, tb(STR_PTR("ns2.example.test"), STR_LEN("ns2.example.test"))) != true { panic(4303); };
}

@test "loopback TXT answers"() {
    let msg = stub_query(tb(STR_PTR("example.test"), STR_LEN("example.test")), SA_DNS_TYPE_TXT);
    let recs = dns_records_of_type(msg, 0, SA_DNS_TYPE_TXT);
    if len(recs) != 2 { panic(4401); };
    let sl: Slice<DnsRecord> = VEC_AS_SLICE(recs);
    let r0 = dns_empty_record();
    SLICE_GET(r0, sl, 0);
    if len(r0.text) != 2 { panic(4402); };
    let tsl: Slice<Vec<u8>> = VEC_AS_SLICE(r0.text);
    let s0: Vec<u8> = Vec::new();
    SLICE_GET(s0, tsl, 0);
    if bytes_eq(s0, tb(STR_PTR("v=spf1 -all"), STR_LEN("v=spf1 -all"))) != true { panic(4403); };
    let s1: Vec<u8> = Vec::new();
    SLICE_GET(s1, tsl, 1);
    if bytes_eq(s1, tb(STR_PTR("hello"), STR_LEN("hello"))) != true { panic(4404); };
    let r1 = dns_empty_record();
    SLICE_GET(r1, sl, 1);
    if len(r1.text) != 1 { panic(4405); };
}

@test "loopback CNAME and SRV and PTR"() {
    let msg = stub_query(tb(STR_PTR("alias.example.test"), STR_LEN("alias.example.test")), SA_DNS_TYPE_CNAME);
    let rec = first_answer(msg, SA_DNS_TYPE_CNAME);
    if bytes_eq(rec.target, tb(STR_PTR("example.test"), STR_LEN("example.test"))) != true { panic(4501); };
    let msg2 = stub_query(tb(STR_PTR("_sip._udp.example.test"), STR_LEN("_sip._udp.example.test")), SA_DNS_TYPE_SRV);
    let srv = first_answer(msg2, SA_DNS_TYPE_SRV);
    if srv.priority != 10 { panic(4502); };
    if srv.weight != 5 { panic(4503); };
    if srv.port != 5060 { panic(4504); };
    if bytes_eq(srv.target, tb(STR_PTR("sip.example.test"), STR_LEN("sip.example.test"))) != true { panic(4505); };
    let msg3 = stub_query(dns_reverse_name_v4(0x5db8d822), SA_DNS_TYPE_PTR);
    let ptr_rec = first_answer(msg3, SA_DNS_TYPE_PTR);
    if bytes_eq(ptr_rec.target, tb(STR_PTR("example.test"), STR_LEN("example.test"))) != true { panic(4506); };
}

@test "loopback NXDOMAIN carries rcode and SOA authority"() {
    let msg = stub_query(tb(STR_PTR("missing.example.test"), STR_LEN("missing.example.test")), SA_DNS_TYPE_A);
    if msg.rcode != SA_DNS_RCODE_NONEXISTENT { panic(4601); };
    if len(msg.answers) != 0 { panic(4602); };
    if len(msg.authorities) != 1 { panic(4603); };
    let auth = dns_records_of_type(msg, 1, SA_DNS_TYPE_SOA);
    if len(auth) != 1 { panic(4604); };
    let sl: Slice<DnsRecord> = VEC_AS_SLICE(auth);
    let ra = dns_empty_record();
    SLICE_GET(ra, sl, 0);
    if len(ra.raw) != 63 { panic(4605); };
}

@test "loopback silent server times out as error"() {
    let server = tb(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    let name = tb(STR_PTR("example.test"), STR_LEN("example.test"));
    let r = dns_query(server, 5398, name, SA_DNS_TYPE_A, SA_DNS_CLASS_IN);
    match r {
        Ok(m) => {
            panic(4701);
        },
        Err(e) => {
            if e == SA_STD_OK { panic(4702); };
        },
    };
}
