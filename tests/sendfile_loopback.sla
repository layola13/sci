// Loopback test for sa_std_net_tcp_stream_send_file (sendfile(2),
// sa_std/net.sai, wave-3): a file written through the fs surface is
// sent over a loopback TCP pair and the received bytes must equal
// the file bytes exactly, including for an offset send. The Zig
// unit test in src/runtime/sa_std.zig covers the same surface at
// the ABI level; this file proves the SLA call shape.
//
// Run from the sa_plugin_sla repo root with SA_PLUGIN_DEV=1 and
// SA_STD_DIR pointed at this sci tree's sa_std:
//   sa test <sci>/tests/sendfile_loopback.sla
// The probe file is created in the working directory and removed
// at the end of the test.

@import "sa_std/net.sai"
@import "sa_std/fs.sai"
@import "sa_std/status.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

fn payload_byte(i: u64) -> u8 {
    return ((i * 31 + 7) & 255) as u8;
}

@test "sendfile loopback bytes match"() {
    // Stage the probe path ("cc_sendfile_probe_sla.bin", 25 bytes).
    // Explicit byte stores, not PTR_COPY_BYTES: that macro in an
    // @test body trips a SAB-direct defect (callee sa_mem_copy not
    // declared in test-body position; works inside regular fns) —
    // registered as REG-SAB-TESTBODY-MACRO with this line.
    let path_arr: [u8; 512] = [0u8; 512];
    path_arr[0] = 99; path_arr[1] = 99; path_arr[2] = 95; path_arr[3] = 115;
    path_arr[4] = 101; path_arr[5] = 110; path_arr[6] = 100; path_arr[7] = 102;
    path_arr[8] = 105; path_arr[9] = 108; path_arr[10] = 101; path_arr[11] = 95;
    path_arr[12] = 112; path_arr[13] = 114; path_arr[14] = 111; path_arr[15] = 98;
    path_arr[16] = 101; path_arr[17] = 95; path_arr[18] = 115; path_arr[19] = 108;
    path_arr[20] = 97; path_arr[21] = 46; path_arr[22] = 98; path_arr[23] = 105;
    path_arr[24] = 110;
    let path_ptr: ptr = PTR_BYTE_ADD(&path_arr, 0);
    let rm0: i32 = sa_std_fs_remove(path_ptr, 25);

    // Write a 5000-byte patterned file.
    let file: u64 = 0;
    let ost: i32 = sa_std_fs_open_write(path_ptr, 25, 1, &file);
    if ost != SA_STD_OK { panic(901); };
    let buf: [u8; 5000] = [0u8; 5000];
    let i: u64 = 0;
    while i < 5000 {
        buf[i] = payload_byte(i);
        i = i + 1;
    }
    let buf_ptr: ptr = PTR_BYTE_ADD(&buf, 0);
    let written: u64 = 0;
    let wst: i32 = sa_std_fs_file_write(file, buf_ptr, 5000, &written);
    if wst != SA_STD_OK { panic(902); };
    if written != 5000 { panic(903); };
    let cst0: i32 = sa_std_close(file);
    // sendfile needs a readable input: reopen for reading.
    let rst: i32 = sa_std_fs_open_read(path_ptr, 25, &file);
    if rst != SA_STD_OK { panic(904); };

    // Loopback pair in-process: listen on an ephemeral port,
    // connect (the handshake completes in the backlog), accept.
    let host_arr: [u8; 512] = [0u8; 512];
    host_arr[0] = 49; host_arr[1] = 50; host_arr[2] = 55; host_arr[3] = 46;
    host_arr[4] = 48; host_arr[5] = 46; host_arr[6] = 48; host_arr[7] = 46;
    host_arr[8] = 49;
    let host_ptr: ptr = PTR_BYTE_ADD(&host_arr, 0);
    let listener: u64 = 0;
    let bound: u32 = 0;
    let lst: i32 = sa_std_net_tcp_listen(host_ptr, 9, 0, &listener, &bound);
    if lst != SA_STD_OK { panic(905); };
    if bound == 0 { panic(906); };
    let client: u64 = 0;
    let cst: i32 = sa_std_net_tcp_connect(host_ptr, 9, bound, &client);
    if cst != SA_STD_OK { panic(907); };
    let tst: i32 = sa_std_net_tcp_stream_set_read_timeout(client, 5000000000);
    if tst != SA_STD_OK { panic(908); };
    let server_side: u64 = 0;
    let ast: i32 = sa_std_net_tcp_accept(listener, &server_side);
    if ast != SA_STD_OK { panic(909); };

    // Full send from offset 0; read back in chunks and verify.
    let sent: u64 = 0;
    let next_off: u64 = 0;
    let sst: i32 = sa_std_net_tcp_stream_send_file(server_side, file, 0, 5000, &sent, &next_off);
    if sst != SA_STD_OK { panic(910); };
    if sent != 5000 { panic(911); };
    if next_off != 5000 { panic(912); };
    let chunk: [u8; 1000] = [0u8; 1000];
    let chunk_ptr: ptr = PTR_BYTE_ADD(&chunk, 0);
    let total: u64 = 0;
    while total < 5000 {
        let want: u64 = 5000 - total;
        if want > 1000 {
            want = 1000;
        };
        let got: u64 = 0;
        let gst: i32 = sa_std_net_tcp_stream_read(client, chunk_ptr, want, &got);
        if gst != SA_STD_OK { panic(913); };
        if got == 0 { panic(914); };
        let k: u64 = 0;
        while k < got {
            if chunk[k] != payload_byte(total + k) { panic(915); };
            k = k + 1;
        }
        total = total + got;
    }

    // Offset send: bytes 100..200 of the file.
    let sst2: i32 = sa_std_net_tcp_stream_send_file(server_side, file, 100, 100, &sent, &next_off);
    if sst2 != SA_STD_OK { panic(916); };
    if sent != 100 { panic(917); };
    if next_off != 200 { panic(918); };
    let t2: u64 = 0;
    while t2 < 100 {
        let got2: u64 = 0;
        let gst2: i32 = sa_std_net_tcp_stream_read(client, chunk_ptr, 100 - t2, &got2);
        if gst2 != SA_STD_OK { panic(919); };
        if got2 == 0 { panic(920); };
        let k2: u64 = 0;
        while k2 < got2 {
            if chunk[k2] != payload_byte(100 + t2 + k2) { panic(921); };
            k2 = k2 + 1;
        }
        t2 = t2 + got2;
    }

    let cc1: i32 = sa_std_close(server_side);
    let cc2: i32 = sa_std_close(client);
    let cc3: i32 = sa_std_close(listener);
    let cc4: i32 = sa_std_close(file);
    let rm1: i32 = sa_std_fs_remove(path_ptr, 25);
    if rm1 != SA_STD_OK { panic(922); };
    println("SENDFILE_OK");
}
